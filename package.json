{
  "name": "lichborne",
  "version": "0.21.1",
  "description": "DragonRealms game client with a primary Lich integration focus.",
  "author": "Sekmeht and Binu",
  "license": "BSD-3-Clause",
  "main": "dist/main/main.js",
  "desktopName": "lichborne.desktop",
  "scripts": {
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node build-main.mjs",
    "build:renderer": "vite build",
    "start": "npm run build:main && npm run build:renderer && electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.lichborne.app",
    "productName": "Lichborne",
    "files": [
      "dist/main/main.js",
      "dist/main/preload.js",
      "dist/renderer/**/*",
      "!node_modules/better-sqlite3/{deps,src,binding.gyp}",
      "!node_modules/better-sqlite3/prebuilds/*",
      "node_modules/better-sqlite3/prebuilds/${platform}-${arch}.node"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "afterPack": "build/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "${productName}.${ext}",
      "syncDesktopName": true
    },
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "elanthia-online",
      "repo": "Lichborne",
      "releaseType": "draft"
    },
    "releaseInfo": {}
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.1",
    "highlight.js": "^11.11.1",
    "js-yaml": "^5.5.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-virtuoso": "^4.18.20",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
