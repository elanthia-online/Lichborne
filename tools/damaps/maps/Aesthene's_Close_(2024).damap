 "rooms": [
  {"id":1,"x":140,"y":140,"z":0,"title":"Aesthene's Close, Central Vault","descriptions":["Interspersed with painted almagarus flower tiles, glittering cobblestone flooring stretches across the cavernous hold.  A barrel vaulted ceiling adds more height to the already spacious chamber, its simple sloped arch curving between the stacked stone walls."],"exits":[{"to":2,"exit":"north","move":"north"},{"to":4,"exit":"east","move":"east"},{"to":5,"exit":"south","move":"south"},{"to":6,"exit":"west","move":"west"}],"aliases":["Central Vault"]},
  {"id":2,"x":140,"y":120,"z":0,"title":"Aesthene's Close, Northern Vault","descriptions":["Interspersed with painted dirdel flower tiles, glittering cobblestone flooring stretches across the cavernous hold.  A barrel vaulted ceiling adds more height to the already spacious chamber, its simple sloped arch curving between the stacked stone walls."],"exits":[{"to":3,"exit":"north","move":"north"},{"to":4,"exit":"southeast","move":"southeast"},{"to":1,"exit":"south","move":"south"},{"to":6,"exit":"southwest","move":"southwest"}],"aliases":["Northern Vault"]},
  {"id":3,"x":140,"y":100,"z":0,"title":"Aesthene's Close, The Vaults","descriptions":["Continuing to spiral in a slight incline, the gilded deobar planks are flanked by stacked stone walls.  Thin streamers of glittery silk hang from gaethzen sconces in graceful twists and loops."],"exits":[{"to":2,"exit":"south","move":"south"},{"to":7,"exit":"up","move":"up"}]},
  {"id":4,"x":160,"y":140,"z":0,"title":"Aesthene's Close, Eastern Vault","descriptions":["Interspersed with painted tamarind tree tiles, glittering cobblestone flooring stretches across the cavernous hold.  A barrel vaulted ceiling adds more height to the already spacious chamber, its simple sloped arch curving between the stacked stone walls."],"exits":[{"to":5,"exit":"southwest","move":"southwest"},{"to":1,"exit":"west","move":"west"},{"to":2,"exit":"northwest","move":"northwest"}],"aliases":["Eastern Vault"]},
  {"id":5,"x":140,"y":160,"z":0,"title":"Aesthene's Close, Southern Vault","descriptions":["Interspersed with painted horeb root tiles, glittering cobblestone flooring stretches across the cavernous hold.  A barrel vaulted ceiling adds more height to the already spacious chamber, its simple sloped arch curving between the stacked stone walls."],"exits":[{"to":1,"exit":"north","move":"north"},{"to":4,"exit":"northeast","move":"northeast"},{"to":6,"exit":"northwest","move":"northwest"}],"aliases":["Southern Vault"]},
  {"id":6,"x":120,"y":140,"z":0,"title":"Aesthene's Close, Western Vault","descriptions":["Interspersed with painted Elvish urn tiles, glittering cobblestone flooring stretches across the cavernous hold.  A barrel vaulted ceiling adds more height to the already spacious chamber, its simple sloped arch curving between the stacked stone walls."],"exits":[{"to":2,"exit":"northeast","move":"northeast"},{"to":1,"exit":"east","move":"east"},{"to":5,"exit":"southeast","move":"southeast"}],"aliases":["Western Vault"]},
  {"id":7,"x":140,"y":80,"z":0,"title":"Aesthene's Close, The Vaults","descriptions":["Enclosed by stacked stone walls, gilded deobar planks form a graceful spiraling ramp with a gentle incline.  Thin streamers of glittery silk hang from gaethzen sconces in festive swoops and swags."],"exits":[{"to":8,"exit":"up","move":"up"},{"to":3,"exit":"down","move":"down"}]},
  {"id":8,"x":140,"y":40,"z":0,"title":"Aesthene's Close, Crystal Chamber","descriptions":["The narrow, sloping sides of the vaulted ceiling create a mirror-like effect that amplifies the vivid colors that saturate the room's curved walls.  Constantly shifting in their prismatic dance, brilliant rainbows emerge from a massive, glittering crystal that is suspended in mid-air at the very center of the room.  Multiple open corridors branch away from the circular room, but an undulating, kaleidoscopic ward blocks access to all passageways except for the one to the north.  An ornately gilded ramp, located directly beneath the crystal, leads downwards into another area."],"exits":[{"to":9,"exit":"north","move":"north"},{"to":18,"exit":"go","move":"go prismatic portal"},{"to":19,"exit":"go","move":"go colorful portal"}],"color":"#FF00FF","aliases":["Timekeeper","portals"]},
  {"id":9,"x":140,"y":20,"z":0,"title":"Aesthene's Close, Corridor","descriptions":["Overlain with decorative wood slats, the stacked stone walls form a narrow passageway to traverse through.  Tiny glittering tiles are pieced together into a colorful mosaic floor, depicting a pattern of swirling orlog faces.  Flanked by gaethzen sconces, jewel-toned brocade tapestries bring a touch of softness to the long corridor."],"exits":[{"to":10,"exit":"north","move":"north"},{"to":8,"exit":"south","move":"south"}]},
  {"id":10,"x":140,"y":0,"z":0,"title":"Aesthene's Close, Chronoscape","descriptions":["Shifting rainbow hues pulse overhead, oscillating in a fluctuating random pattern amidst the shattered shards of a dark fathomless ceiling.  Fractured orlogs are jumbled together and form a floor of wreckage that drifts aimlessly above a bottomless void."],"exits":[{"to":11,"exit":"northeast","move":"northeast"},{"to":9,"exit":"south","move":"south"},{"to":17,"exit":"northwest","move":"northwest"}],"color":"#00FF00","aliases":["Chronoscape","lock1","one"]},
  {"id":11,"x":160,"y":-20,"z":0,"title":"Aesthene's Close, Chronoscape","descriptions":["Shifting red hues pulse overhead, oscillating in a fluctuating random pattern amidst the shattered shards of a dark fathomless ceiling.  Fractured orlogs are jumbled together and form a floor of wreckage that drifts aimlessly above a bottomless void."],"exits":[{"to":12,"exit":"northeast","move":"northeast"},{"to":10,"exit":"southwest","move":"southwest"}],"color":"#00FF00","aliases":["lock2","two"]},
