{
 "format": "damap",
 "version": 1,
 "id": "999",
 "name": "The Microcosm",
 "file": "Map999_Microcosm.xml",
 "rooms": [
  {"id":1,"x":20,"y":100,"z":0,"title":"Astral Plane, Pillar of Nightmares","descriptions":["Countless streams of steel-grey light writhe and hiss like snakes mere hand spans below you.  Every few moments, one of the energy streams explodes outward from the mass with incredible speed and twists wildly through the air before dissipating.  A jagged purple and black pillar rises from the serpentine mass and climbs up into the distant, flickering sky."],"exits":[{"to":8,"exit":"west","move":"","hidden":true},{"to":2,"exit":"east","move":"east"},{"to":10,"exit":"up","move":"up"},{"to":9,"exit":"down","move":"down"}],"aliases":["Rolagi","Tabelrem"]},
  {"id":2,"x":60,"y":100,"z":0,"title":"Astral Plane, Pillar of Tradition","descriptions":["Bright silvery-white light burns like the surface of a star a few hand spans beneath your feet.  Narrowly focused beams of light rise from the surface and gently sway in response to some unfelt wind.  A pillar of light, by all appearances simply an overly large beam, ascends into the flickering sky."],"exits":[{"to":1,"exit":"west","move":"west"},{"to":3,"exit":"east","move":"east"},{"to":10,"exit":"up","move":"up"},{"to":9,"exit":"down","move":"down"},{"to":28,"exit":"none","move":"focus Dor'na'torna"}],"aliases":["Auilusi","Dor'na'torna","Dornatorna"]},
  {"id":3,"x":100,"y":100,"z":0,"title":"Astral Plane, Pillar of Secrets","descriptions":["Heat rises from a still, black mass a few hand spans beneath your feet.  A constant crackling sound issues from the surface, often accompanied by rapidly expanding blooms of burning shadows.  A dull grey pillar emerges from the inky surface and blends into the dim, flickering sky a few dozen feet up."],"exits":[{"to":2,"exit":"west","move":"west"},{"to":4,"exit":"east","move":"east"},{"to":10,"exit":"up","move":"up"},{"to":9,"exit":"down","move":"down"},{"to":25,"exit":"none","move":"focus marendin"}],"aliases":["Marendin","Besoge"]},
  {"id":4,"x":140,"y":100,"z":0,"title":"Astral Plane, Pillar of Unity","descriptions":["Vortices of brightly colored energy, each a different hue, rapidly twirl a few hand spans beneath your feet.  Sprays of burning light are constantly ejected from the spinning energy, sending prismatic arcs flying through the sky.  A pillar of swirling light rises up into the flickering sky from the center of the vortices."],"exits":[{"to":3,"exit":"west","move":"west"},{"to":5,"exit":"east","move":"east"},{"to":10,"exit":"up","move":"up"},{"to":9,"exit":"down","move":"down"}]},
  {"id":5,"x":180,"y":100,"z":0,"title":"Astral Plane, Pillar of the Shrew","descriptions":["An almost blinding pillar of purple-tinged white light, resembling a lightning bolt frozen in mid-strike, emerges from the depths of a violently billowing cloud of shadows a few hand spans below you.  Bolts of light shoot out from the pillar and ground themselves into the black cloud."],"exits":[{"to":4,"exit":"west","move":"west"},{"to":6,"exit":"east","move":"east"},{"to":10,"exit":"up","move":"up"},{"to":9,"exit":"down","move":"down"},{"to":26,"exit":"none","move":"focus emalerje"}],"aliases":["Emalerje"]},
  {"id":6,"x":220,"y":100,"z":0,"title":"Astral Plane, Pillar of the Heavens","descriptions":["Burning white lights twist and flicker high above your head, creating the illusion of a brilliant night sky.  The same energy as the lights overhead flows smoothly along a wide congruent plane a few hand spans below your feet.  A slender pillar of blazing light joins the plane below to the heavens above and randomly discharges violent streams of energy."],"exits":[{"to":5,"exit":"west","move":"west"},{"to":7,"exit":"east","move":"east"},{"to":10,"exit":"up","move":"up"},{"to":9,"exit":"down","move":"down"}],"aliases":["Asharshpar'i","Asharshpari","Tamigen"]},
  {"id":7,"x":260,"y":100,"z":0,"title":"Astral Plane, Pillar of Introspection","descriptions":["A surface of cyan light ripples gently a few hand spans below your feet, creating the illusion of a luminescent ocean.  Brief-lived waves crash against a pillar of white light that rises from the depths, sending beams of sparkling light flying through the air."],"exits":[{"to":6,"exit":"west","move":"west"},{"to":8,"exit":"east","move":"east"},{"to":10,"exit":"up","move":"up"},{"to":9,"exit":"down","move":"down"},{"to":22,"exit":"none","move":"focus dinegavren"}],"aliases":["Dinegavren","Taniendar"]},
  {"id":8,"x":300,"y":100,"z":0,"title":"Astral Plane, Pillar of Fortune","descriptions":["A large source of golden light pulsates like the rhythm of a heart-beat a few hand spans below your feet.  Thin threads of energy rise from within the golden light and arrange themselves into seemingly random patterns in the sky.  The patterns eventually meet in a single spot, where they weave into a spun pillar that rises into the flickering sky."],"exits":[{"to":7,"exit":"west","move":"west"},{"to":1,"exit":"east","move":"","hidden":true},{"to":10,"exit":"up","move":"up"},{"to":9,"exit":"down","move":"down"},{"to":24,"exit":"none","move":"focus erekinzil"},{"to":27,"exit":"none","move":"focus mintais"}],"aliases":["Erekinzil","Mintais"]},
  {"id":9,"x":160,"y":140,"z":0,"title":"Astral Plane, Broken Pillar","descriptions":["A jungle of energy streams converge in the area, complicating both navigation and sight.  The landscape among the prolific energy streams feels almost insubstantial:  a deep chill fills the air and the eight pillars in the distance are vague, grey silhouettes.  A slowly twisting mass of streams creates the outline of a pillar in the center of the area."],"exits":[{"to":1,"exit":"north","move":"","hidden":true},{"to":2,"exit":"northeast","move":"","hidden":true},{"to":3,"exit":"east","move":"","hidden":true},{"to":4,"exit":"southeast","move":"","hidden":true},{"to":5,"exit":"south","move":"","hidden":true},{"to":6,"exit":"southwest","move":"","hidden":true},{"to":7,"exit":"west","move":"","hidden":true},{"to":8,"exit":"northwest","move":"","hidden":true}]},
  {"id":10,"x":160,"y":60,"z":0,"title":"Astral Plane, Pillar of Convergence","descriptions":["The main surface of a disc-shaped plane of seething silvery-white energy stretches in every direction from here.  Odd colors and disturbances in the surface of the disc appear as it curves downward toward eight pillars in the distance, each jutting out horizontally like the spokes of a wheel.  A stunted silvery-white pillar, standing only about ten feet high, is set in the center of the disc."],"exits":[{"to":5,"exit":"north","move":"","hidden":true},{"to":4,"exit":"northeast","move":"","hidden":true},{"to":3,"exit":"east","move":"","hidden":true},{"to":2,"exit":"southeast","move":"","hidden":true},{"to":1,"exit":"south","move":"","hidden":true},{"to":8,"exit":"southwest","move":"","hidden":true},{"to":7,"exit":"west","move":"","hidden":true},{"to":6,"exit":"northwest","move":"","hidden":true}]},
  {"id":22,"x":260,"y":40,"z":0,"title":"Astral Plane, Dinegavren Conduit","descriptions":["Buildings of irregular shape and size, each constructed from slick grey stones, dominate the landscape.  Narrow cobblestone streets and dirt alleys wend their way between the buildings and through thick fog banks.  Burning beams of light thread across the landscape indiscriminately, evaporating the fog they touch yet passing harmlessly through the structures."],"exits":[{"to":7,"exit":"none","move":"script apmove"},{"to":22,"exit":"none","move":"script apmove"}]},
  {"id":24,"x":300,"y":40,"z":0,"title":"Astral Plane, Erekinzil Conduit","descriptions":["A sandy expanse stretches out in every direction, littered with titanic, half-buried remains.  Bones made out of black, glassy material stick out from the ground in distressed poses, left unceremoniously where the corpses fell.  Arcs of burning silvery light discharge from one morbid pylon to the next, creating a crude maze of pathways.  The Microcosm is visible in the azure sky, its conduits blazing with heat and, shaped as they are, reminiscent of a nova."],"exits":[{"to":8,"exit":"none","move":"script apmove"},{"to":24,"exit":"none","move":"script apmove"}]},
  {"id":25,"x":100,"y":40,"z":0,"title":"Astral Plane, Marendin Conduit","descriptions":["Giant geometric solids wrought from black metal float in a cold, steel-grey void.  The metal islands are connected to each other by narrow bridges, creating a network of shapes that seems to go on forever in every direction.  Interconnected streams of burning energy sway around the void, passing harmlessly through the islands."],"exits":[{"to":25,"exit":"none","move":"script apmove"},{"to":3,"exit":"none","move":"script apmove"}]},
  {"id":26,"x":180,"y":40,"z":0,"title":"Astral Plane, Emalerje Conduit","descriptions":["Monoliths of featureless grey rock rise up from a flat plain covered with ruddy ash.  Each of the rocks is set at a right angle and precisely the same distance from the others, creating a uniform pattern that extends all the way to the horizon.  Streams of burning, white energy discharge from one monolith to the next in a seemingly random order."],"exits":[{"to":26,"exit":"none","move":"script apmove"},{"to":5,"exit":"none","move":"script apmove"}]},
  {"id":27,"x":300,"y":160,"z":0,"title":"Astral Plane, Mintais Conduit","descriptions":["Broken and barren land stretches out beneath an impossibly large, bloated sun.  Deep crevices slice through the ash-grey plain and jagged mountains rise to pierce the sky on the eastern horizon.  Interwoven beams of silvery-white light dance across the blasted landscape and seem to extrude more heat than the bloated sun."],"exits":[{"to":27,"exit":"none","move":"script apmove"},{"to":8,"exit":"none","move":"script apmove"}]},
  {"id":28,"x":60,"y":40,"z":0,"title":"Astral Plane, Dor'na'torna Conduit","descriptions":["A desolate steppe of mist-grey grass stretches to the horizon under the cold light of Xibar.  Though the air feels calm and the night sky is clear, the discolored grass whips and sways as though under assault by a storm.  An intricate web of burning light runs across the steppe, its fierce beams in constant motion."],"exits":[{"to":28,"exit":"none","move":"script apmove"},{"to":2,"exit":"none","move":"script apmove"}]}
 ],
 "labels": [
  {"text":"The Microcosm","x":20,"y":0,"z":0}
 ]
}
