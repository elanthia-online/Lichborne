 "file": "Fenvol's_Folly.xml",
 "rooms": [
  {"id":1,"x":20,"y":240,"z":0,"title":"","descriptions":[],"exits":[],"aliases":["loot","endloot","end loot]"],"linksTo":"[MT_Prize_Wings.xml"},
  {"id":2,"x":40,"y":240,"z":0,"title":"Fenvol's Folly, Portal Garden","descriptions":["Slightly overgrown plants spill out of raised beds showing signs of recent repair, with climbing vines already beginning to wander again.  A line of smooth stepping stones winds through the greenery toward a modest doorway set into the house beyond.  Five freestanding arches rise along the path, each draped in trailing plants and faintly etched script, their frames fitted with hanging lanterns that sway gently overhead."],"exits":[{"to":1,"exit":"go","move":"go colorful portal"},{"to":3,"exit":"east","move":""}]},
  {"id":3,"x":60,"y":240,"z":0,"title":"Fenvol's Folly, Garden Walk","descriptions":["A stretch of garden path opens beneath a broad-limbed tree, where a weathered bench swing hangs from the sturdy branches.  Nearby, a gently burbling fountain takes the shape of a sleeping shadowcat, its curled form supporting a shallow basin of water.  Clusters of vibrant hibiscuses in varied colors crowd the walkway, their rainbow of blooms layered thick among glossy leaves."],"exits":[{"to":2,"exit":"west","move":""},{"to":4,"exit":"east","move":""}]},
  {"id":4,"x":80,"y":240,"z":0,"title":"Fenvol's Folly, Modest Entrance","descriptions":["A neatly kept approach leads to a small riverstone manor, its exterior showing signs of recent maintenance and freshly trimmed flower pots.  White shutters frame clean windows, their hinges and fittings bright and unblemished.  A broad stone landing rests before the door, its surface even and clean.  Ornate lanterns flank the entryway, their polished metalwork depicting neat stacks of tiny tomes."],"exits":[{"to":3,"exit":"west","move":""},{"to":5,"exit":"go","move":"go iron-banded door"}]},
  {"id":5,"x":80,"y":220,"z":0,"title":"Fenvol's Folly, Tidy Foyer","descriptions":["The receiving hall features a floor laid in patterned stone, bordered by carved woodwork paneling.  A sweeping staircase rises along one side, with a ribbon stretched across the lower posts to restrict passage.  Gaethzen sconces are mounted on either side of the arched openings leading off in several directions, with a cozy parlor to the east, the master's study to the north, and a well-lit conservatory to the west, while a shadowed arch to the northwest opens to the library antechamber."],"exits":[{"to":4,"exit":"go","move":"go iron-banded door"},{"to":6,"exit":"north","move":""},{"to":8,"exit":"east","move":""},{"to":7,"exit":"west","move":""},{"to":9,"exit":"northwest","move":""}]},
  {"id":6,"x":80,"y":200,"z":0,"title":"Fenvol's Folly, The Master's Study","descriptions":["Bookshelves line the walls, their contents arranged in tight, orderly rows.  A broad ribbon-stripe desk occupies the center of the floor, its surface perfectly polished and free of smudges.  Tall windows span one wall, with an array of hanging lanterns set at varying heights arranged at regular intervals.  Along the remaining space, shelves display a collection of intricate devices, their mechanical components carefully arranged."],"exits":[{"to":5,"exit":"south","move":""}]},
  {"id":7,"x":60,"y":220,"z":0,"title":"Fenvol's Folly, Parlor","descriptions":["The modestly appointed space is arranged in a tidy layout, with an ivory settee positioned against one wall and a distressed sage-colored sideboard on the other, supporting a neatly arranged tray of refreshments.  A large riverstone hearth occupies most of the third wall, its roughly hewn mantle arranged with several stacks of hardbound books."],"exits":[{"to":9,"exit":"north","move":""},{"to":5,"exit":"east","move":""},{"to":10,"exit":"go","move":"go narrow door"}]},
  {"id":8,"x":100,"y":220,"z":0,"title":"Fenvol's Folly, Conservatory","descriptions":["Reinforced glass roofing shelters colorful vegetation as it fills raised planters, interspersed with several den-like pet crates placed among the foliage.  A hollowed tree occupies one corner, its interior carved into a cozy nest.  Tall windows line the perimeter, framed in sturdy supports and evenly spaced structural ribs, enclosing the room in nearly continuous panes."],"exits":[{"to":5,"exit":"west","move":""}]},
  {"id":9,"x":60,"y":200,"z":0,"title":"Fenvol's Folly, Library Antechamber","descriptions":["The elegant space is framed by woodwork traced in fine gold script, the carvings precise and continuous along the edges of the walls.  A masterfully painted portrait dominates one side, depicting a young woman with dark curls, bright silver eyes, and a warm, mischievous expression."],"exits":[{"to":5,"exit":"southeast","move":""},{"to":7,"exit":"south","move":""}]},
  {"id":10,"x":40,"y":220,"z":0,"title":"Fenvol's Folly, Hidden Stair","descriptions":["A short, narrow hallway leads to an equally cramped staircase that winds tightly upward.  The steps are worn smooth but clean, bordered by plain white walls set close on either side.  A single gaethzen lantern hangs in one corner, casting a contained glow that barely lights the space."],"exits":[{"to":7,"exit":"go","move":"go narrow door"}]}
 ],
 "labels": []
}
