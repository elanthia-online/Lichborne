{
 "format": "damap",
 "version": 1,
 "id": "6438",
 "name": "Guild Fest 445 (2023)",
 "file": "Guild_Fest-2023.xml",
 "rooms": [
  {"id":1,"x":490,"y":500,"z":0,"title":"Fairegrounds Clearing","descriptions":["A clearing of deep green grass with well-manicured paths provides a perfect setting for a day at the faire.  Tents and wagons are visible in the meadowlands to the west, while an inviting deeply shaded vale lies to the east."],"exits":[{"to":22,"exit":"north","move":"north"},{"to":19,"exit":"east","move":"east"},{"to":2,"exit":"west","move":"west"},{"to":29,"exit":"go","move":"go bracken arch"},{"to":230,"exit":"go","move":"go wooden wagon"},{"to":231,"exit":"go","move":"go linked wagons"}]},
  {"id":2,"x":270,"y":500,"z":0,"title":"Fairegrounds Meadow","descriptions":["The fragrance of freshly mown hay is prevalent as the deep green grass of the clearing gives way to the fields where the faire is set up and in full swing."],"exits":[{"to":1,"exit":"east","move":"east"},{"to":3,"exit":"northwest","move":"northwest"},{"to":48,"exit":"go","move":"go cake-shaped tent"},{"to":159,"exit":"go","move":"go umber tent"}],"color":"#FF0000"},
  {"id":3,"x":170,"y":400,"z":0,"title":"Fairegrounds Meadow","descriptions":["The hay is flattened for a nice walking surface here, only slightly marred by the wagon tracks of several merchants.  Dew collected in the ruts left by the wagons allows small bathing spots for the occasional bird."],"exits":[{"to":4,"exit":"northeast","move":"northeast"},{"to":2,"exit":"southeast","move":"southeast"},{"to":30,"exit":"go","move":"go ticket gate"},{"to":49,"exit":"go","move":"go octagonal building"}]},
  {"id":4,"x":310,"y":260,"z":0,"title":"Fairegrounds Meadow","descriptions":["The scent of hay is slightly dampened here, as it has been stamped down by the feet of the faire-goers.  A leaning fence festooned with ribbons and garlands provides an elegant boundary to the fields beyond."],"exits":[{"to":11,"exit":"north","move":"north"},{"to":26,"exit":"east","move":"east"},{"to":3,"exit":"southwest","move":"southwest"},{"to":5,"exit":"west","move":"west"},{"to":57,"exit":"go","move":"go brick shop"},{"to":156,"exit":"go","move":"go painted wagon"}]},
  {"id":5,"x":210,"y":260,"z":0,"title":"Fairegrounds, West Field","descriptions":["Decorated with colorful pennants and flower garlands, a large branch arch welcomes faire-goers to the west field.  This expansive tract of land is relatively flat, making it easy for merchants to set up their traveling shops in ways that will lure people into purchasing their wares."],"exits":[{"to":4,"exit":"east","move":"east"},{"to":6,"exit":"southwest","move":"southwest"},{"to":127,"exit":"go","move":"go large pavilion"},{"to":158,"exit":"go","move":"go azure wagon"},{"to":260,"exit":"go","move":"go white wagon"}]},
  {"id":6,"x":190,"y":280,"z":0,"title":"Fairegrounds, West Field","descriptions":["Waves of excited laughter drift over from the east, almost drowning out the mechanical drone of the Faeries' Wheel as it slowly rotates in place.  Periodically as the distant ride grinds to a stop, sounds of screeching metal are followed by nervous shrieks from people who are stuck in the top carriages swinging back and forth through the air."],"exits":[{"to":5,"exit":"northeast","move":"northeast"},{"to":7,"exit":"west","move":"west"},{"to":130,"exit":"go","move":"go black tent"},{"to":133,"exit":"go","move":"go run-down wagon"}]},
  {"id":7,"x":60,"y":280,"z":0,"title":"Fairegrounds, West Field","descriptions":["Hay strewn paths dissect the broad field, encouraging faire-goers to travel in directions that take them past areas set up by visiting merchants as well as other festival points of interest.  Despite all the traffic, a small patch of pink lady's slipper orchids manages to thrive and scent the air with their sweet perfume."],"exits":[{"to":6,"exit":"east","move":"east"},{"to":8,"exit":"southwest","move":"southwest"},{"to":10,"exit":"northwest","move":"northwest"},{"to":139,"exit":"go","move":"go black tent"},{"to":209,"exit":"go","move":"go elegant shop"},{"to":234,"exit":"go","move":"go cedar wagon"}]},
  {"id":8,"x":0,"y":340,"z":0,"title":"Fairegrounds, West Field","descriptions":["Along one side of the path, makeshift stalls stand ready, waiting to safely house the valuable animals of local farmers that will be competing for prizes in the nearby ring.  Across the way, merchants display their wares in an attempt to entice faire-goers into purchasing new treasures from them and away from spending time viewing the well-groomed beasts once they arrive."],"exits":[{"to":10,"exit":"north","move":"north"},{"to":7,"exit":"northeast","move":"northeast"},{"to":9,"exit":"northwest","move":"northwest"},{"to":149,"exit":"go","move":"go purple wagon"},{"to":235,"exit":"go","move":"go grey tent","hidden":true},{"to":210,"exit":"climb","move":"climb ladder"}]},
  {"id":9,"x":-60,"y":280,"z":0,"title":"Fairegrounds, West Field","descriptions":["A split rail fence decorated with colored ribbons encircles the main exhibition ring, protecting the animals during shows from any over eager spectators and their excitable children.  In between competitions, workers rake pea gravel covering the ground, leveling it and cleaning up any stinky presents left by the beasts.  The shops of traveling merchants border the area's perimeter attempting to lure in people passing by."],"exits":[{"to":10,"exit":"northeast","move":"northeast"},{"to":8,"exit":"southeast","move":"southeast"},{"to":147,"exit":"go","move":"go alpaca-felt yurt"},{"to":182,"exit":"go","move":"go colorful caravan"},{"to":183,"exit":"go","move":"go straw-thatch hut"},{"to":211,"exit":"go","move":"go canvas tent"},{"to":214,"exit":"go","move":"go oversized shrub"}]},
  {"id":10,"x":0,"y":220,"z":0,"title":"Fairegrounds, West Field","descriptions":["Created by an underground spring, a small, tranquil pool feeds the brook that runs northerly through the fairegrounds.  Apparently collected from other areas on the property, large, flat rocks look purposely stacked to form a border around the water's edge, making it easier for travelers to water their animals or just grab a quick drink on a hot day."],"exits":[{"to":7,"exit":"southeast","move":"southeast"},{"to":8,"exit":"south","move":"south"},{"to":9,"exit":"southwest","move":"southwest"},{"to":140,"exit":"go","move":"go canvas tent"},{"to":143,"exit":"go","move":"go silverwood shack"},{"to":228,"exit":"go","move":"go nook"}]},
  {"id":11,"x":310,"y":100,"z":0,"title":"Fairegrounds Meadow","descriptions":["Sounds of laughter drift across a brook from the northwest, enticing to even the most stoic of faire-goers.  Spanning the brook are several large stones that serve as a way to cross the running water easily."],"exits":[{"to":12,"exit":"east","move":"east"},{"to":4,"exit":"south","move":"south"},{"to":27,"exit":"go","move":"go brook"},{"to":124,"exit":"go","move":"go tattered tent"},{"to":125,"exit":"go","move":"go silvery tent"},{"to":154,"exit":"go","move":"go massive caravan"}],"aliases":["brook"]},
  {"id":12,"x":850,"y":100,"z":0,"title":"Fairegrounds Clearing","descriptions":["A mown grass clearing merges into a scythed hayfield, providing a level surface for the merchant tents and games.  Grasshoppers flick through the cut stalks, dancing to the rhythm of a distant troupe of merry-makers."],"exits":[{"to":13,"exit":"east","move":"east"},{"to":14,"exit":"south","move":"south"},{"to":11,"exit":"west","move":"west"},{"to":117,"exit":"go","move":"go huge wagon"},{"to":118,"exit":"go","move":"go azure tent"},{"to":121,"exit":"go","move":"go velvet tent"}]},
  {"id":13,"x":870,"y":100,"z":0,"title":"Fairegrounds, Ring Toss Game","descriptions":["At one corner of the field, a stack of cloth-draped wooden boxes rests atop a sturdy table.  Tiers of glass bottles cover the surface, forming a pyramid.  The barker stands beside the display, juggling wooden rings as he calls out to passers-by, enticing them to try their luck at the ring-toss game."],"exits":[{"to":12,"exit":"west","move":"west"}],"color":"#00FF00","aliases":["Ring Toss Game"]},
  {"id":14,"x":850,"y":260,"z":0,"title":"Fairegrounds Clearing","descriptions":["A gentle upslope leads from a stream-side willow grove to a rolling meadowland.  The beaten-down grass is strewn with hay, improving traction on the slippery, slanted path.  A cacophony of voices and smells accompany the sound of crunching hay beneath the feet of the revelers."],"exits":[{"to":12,"exit":"north","move":"north"},{"to":15,"exit":"east","move":"east"},{"to":17,"exit":"south","move":"south"},{"to":24,"exit":"west","move":"west"},{"to":113,"exit":"go","move":"go crimson yurt"},{"to":200,"exit":"go","move":"go box"},{"to":201,"exit":"go","move":"go drape"}]},
  {"id":15,"x":910,"y":260,"z":0,"title":"Fairegrounds Clearing","descriptions":["Near the brook a small clearing opens to the sky.  The fragrance of damp clover and wild mint mingles with a cornucopia of faire smells drifting through the air.  Shrieks of delight, barking merchants, and the sounds of laughing children travel the distance from the hayfield and speak of some child's mischief or glee."],"exits":[{"to":16,"exit":"northeast","move":"northeast"},{"to":14,"exit":"west","move":"west"},{"to":115,"exit":"go","move":"go leather tent"},{"to":242,"exit":"go","move":"go wooden wagon"},{"to":197,"exit":"go","move":"go wrecked caravans"}]},
  {"id":16,"x":950,"y":220,"z":0,"title":"Fairegrounds, Near Some Booths","descriptions":["A series of hastily constructed wooden shacks lean at all angles, supported only by their proximity to each other.  Before them, a barker cries out to passers-by, trying to tempt them into playing his game."],"exits":[{"to":15,"exit":"southwest","move":"southwest"}],"color":"#00FF00","aliases":["Three Frog Monte"]},
  {"id":17,"x":850,"y":440,"z":0,"title":"A Shaded Willow Copse","descriptions":["A copse of willow trees in this grassy vale provides shelter from the weather for the weary traveler.  Bubbling over smoothly polished rocks, a brook creates a rhythmic rhapsody which harmonizes with the tranquil surroundings.  A boulder with a concave center looks like a nice place to sit alongside the brook."],"exits":[{"to":14,"exit":"north","move":"north"},{"to":18,"exit":"east","move":"east"},{"to":19,"exit":"southwest","move":"southwest"},{"to":20,"exit":"west","move":"west"},{"to":95,"exit":"go","move":"go hide tent"},{"to":188,"exit":"go","move":"go golden rotunda"},{"to":152,"exit":"go","move":"go ironwood wagon"}]},
  {"id":18,"x":950,"y":440,"z":0,"title":"Muddy Streambank","descriptions":["A brook fairly bursting from its confines gurgles through the trees.  The banks have been churned into a muddy mess from the meandering faire-goers and from the children weaving around the makeshift gaming tables.  Paper lanterns hang from the branches of the willows just out of reach to provide a soft glow of lighting in the deep shadows."],"exits":[{"to":17,"exit":"west","move":"west"},{"to":171,"exit":"go","move":"go orange tent"},{"to":177,"exit":"go","move":"go tapestry tent"},{"to":179,"exit":"go","move":"go ramshackle booth"}]},
  {"id":19,"x":790,"y":500,"z":0,"title":"Fairegrounds Path","descriptions":["The path slopes gently downward from the west toward a shady vale.  Willow trees cluster to shade the lower grounds, but one large specimen stands out alone at the border of the meadow, providing cool relief and quiet."],"exits":[{"to":17,"exit":"northeast","move":"northeast"},{"to":1,"exit":"west","move":"west"},{"to":99,"exit":"go","move":"go canvas tent"},{"to":160,"exit":"go","move":"go purple tent"},{"to":187,"exit":"go","move":"go makeshift structure","hidden":true}]},
  {"id":20,"x":690,"y":440,"z":0,"title":"Fairegrounds Clearing","descriptions":["An arrangement of intersecting furrows in the once lush sod seem to be working their way easterly towards a stand of graceful willows.  A babbling brook flowing near the large, arching trees keeps them well fed and growing at a steady rate."],"exits":[{"to":24,"exit":"north","move":"north"},{"to":17,"exit":"east","move":"east"},{"to":21,"exit":"west","move":"west"},{"to":86,"exit":"go","move":"go long caravan"},{"to":92,"exit":"go","move":"go colorful wagon"},{"to":94,"exit":"go","move":"go white pavilion"}]},
  {"id":21,"x":600,"y":440,"z":0,"title":"Fairegrounds Clearing","descriptions":["The neatly manicured grass is showing signs of wear and tear from the occasional shoppers who happen to stroll by.  Increasing blotches of a brownish yellow hue give the once green sod an appearance similar to that of a threadbare carpet that needs to be replaced."],"exits":[{"to":20,"exit":"east","move":"east"},{"to":22,"exit":"west","move":"west"},{"to":107,"exit":"go","move":"go simple tent"},{"to":111,"exit":"go","move":"go driftwood wagon"}]},
  {"id":22,"x":490,"y":440,"z":0,"title":"Fairegrounds Clearing","descriptions":["This area of the clearing is a bit off the beaten path providing some quiet apart from the clamor of the milling crowds to the south.  The faint sound of an auctioneer's voice floats on the breeze, chanting of treasures for sale and urging prices even higher."],"exits":[{"to":21,"exit":"east","move":"east"},{"to":1,"exit":"south","move":"south"},{"to":23,"exit":"west","move":"west"},{"to":38,"exit":"go","move":"go canvas pavilion"},{"to":0,"exit":"go","move":"go colorful wagon"},{"to":103,"exit":"go","move":"go tarp-covered shop"}]},
  {"id":23,"x":430,"y":440,"z":0,"title":"Fairegrounds Clearing","descriptions":["A series of sandalwood caravans, spangled and beribboned, occupies most of the clearing.  Sounds of a large crowd murmuring in awe drifts from inside."],"exits":[{"to":22,"exit":"east","move":"east"},{"to":43,"exit":"go","move":"go sandalwood caravans"},{"to":185,"exit":"go","move":"go grey tent"},{"to":184,"exit":"go","move":"go canvas tent "}]},
  {"id":24,"x":690,"y":260,"z":0,"title":"Fairegrounds Clearing","descriptions":["Looking as if it once was attached to a roughly used farm wagon, a weathered buckboard bench now provides a quiet place where people can stop and take a break from the festival.  With faireground seating at a premium, some attendees seem anxious to look over the recent purchases they made while others just want to rest their tired feet."],"exits":[{"to":14,"exit":"east","move":"east"},{"to":20,"exit":"south","move":"south"},{"to":25,"exit":"west","move":"west"},{"to":76,"exit":"go","move":"go glowing portal"},{"to":85,"exit":"go","move":"go hide tent"},{"to":233,"exit":"go","move":"go brown tent"}]},
  {"id":25,"x":590,"y":260,"z":0,"title":"Fairegrounds Clearing","descriptions":["Songbirds chirp their lilting melodies from secret spots hidden amongst the wagons and tents set up for the festival.  Occasionally darting out from the shadows, the tiny winged creatures swoop down to snatch a tasty morsel from the ground that was dropped by someone passing by.  After gobbling down their snack, they fly off to find another spot to safely resume singing for their supper."],"exits":[{"to":24,"exit":"east","move":"east"},{"to":26,"exit":"west","move":"west"},{"to":72,"exit":"go","move":"go oak caravan"},{"to":74,"exit":"go","move":"go stone hut"},{"to":207,"exit":"go","move":"go white tent"},{"to":208,"exit":"go","move":"go log wagon"}]},
  {"id":26,"x":470,"y":260,"z":0,"title":"Fairegrounds Clearing","descriptions":["Foot traffic increases towards the west, compacting the hay laid to protect the soil from erosion.  The straw forms cushioned paths between each merchant's areas, adding traction and assisting in drainage for those times when the weather refuses to cooperate."],"exits":[{"to":25,"exit":"east","move":"east"},{"to":4,"exit":"west","move":"west"},{"to":63,"exit":"go","move":"go semicircular caravan"},{"to":68,"exit":"go","move":"go canvas tent"},{"to":227,"exit":"go","move":"go platinum tent"}]},
  {"id":27,"x":180,"y":100,"z":0,"title":"A Cleared Field","descriptions":["The mowed hayfield is decorated with ribbons and colorful paper lanterns.  To the north you see another long cleared field that appears to have been marked out with chalk and bright flags.  Large, moss-covered stones cross the brook to lead back to the fairegrounds."],"exits":[{"to":28,"exit":"north","move":"north"},{"to":11,"exit":"go","move":"go brook"},{"to":126,"exit":"go","move":"go red tent"},{"to":265,"exit":"go","move":"go adobe huts"}]},
  {"id":28,"x":180,"y":80,"z":0,"title":"A Cleared Field","descriptions":["The mowed field has piles of hay stacked all over.  Poles hung with colorful paper lanterns line the edge of the range.  Chalk lines have been put down and marked with numbered flags from one end of the clearing to the other."],"exits":[{"to":33,"exit":"north","move":"north"},{"to":27,"exit":"south","move":"south"},{"to":237,"exit":"go","move":"go striped tent"}],"color":"#00FF00","aliases":["catapult"]},
  {"id":29,"x":490,"y":520,"z":0,"title":"Fairegrounds Entrance","descriptions":["A woven bracken arch festooned with ivy and flowering vines serves as the entrance to the fairegrounds.  People are milling about the entrance hawking their wares while small children run to and fro playing games and singing.  An air of frivolity and joy surrounds everyone present at the occasion."],"exits":[{"to":1,"exit":"go","move":"go bracken arch"},{"to":32,"exit":"go","move":"go north road"}],"aliases":["Entrance"]},
  {"id":30,"x":150,"y":400,"z":0,"title":"Faeries' Wheel","descriptions":["The faeries' wheel towers over the faire, definitely one of the tallest structures to be seen.  The view from the top must be spectacular, a good place to see what other attractions await, or to snuggle with your sweetie."],"exits":[{"to":31,"exit":"go","move":"go carriage"},{"to":3,"exit":"go","move":"go exit gate"}],"color":"#00FF00","aliases":["Faeries' Wheel"]},
  {"id":31,"x":130,"y":400,"z":0,"title":"Faeries' Wheel, Carriage","descriptions":["Securely fastened in, you lean back, anticipating the trip to the top with some trepidation.  The view promises to be spectacular, and the wheel looks sturdily made, but it is very tall.  The faeries' wheel worker seems quite competent, however, setting you somewhat at ease."],"exits":[{"to":30,"exit":"out","move":"out"}]},
  {"id":32,"x":490,"y":560,"z":0,"title":"North Road, Farmlands","descriptions":["Row after row of tidily formed haystacks fill the field to one side of the road.  A fenced-in pasture borders the other side, and the hollow clonk of cowbells resounds as grazing cows occasionally amble over to the fence to peer at the stacks with interest."],"exits":[{"to":29,"exit":"go","move":"go field"},{"to":0,"exit":"southwest","move":""},{"to":0,"exit":"northeast","move":""}],"aliases":["Therenborough","Langenfirth","North Road","Road","Mistwood Forest"],"linksTo":"Map40_Langenfirth_to_Therenborough.xml"},
  {"id":33,"x":180,"y":60,"z":0,"title":"A Cleared Field","descriptions":["The mowed field has piles of hay stacked all over.  Poles hung with colorful paper lanterns line the edge of the range.  Chalk lines have been put down and marked with numbered flags from one end of the clearing to the other."],"exits":[{"to":34,"exit":"north","move":"north"},{"to":28,"exit":"south","move":"south"},{"to":205,"exit":"go","move":"go wide tent"},{"to":238,"exit":"go","move":"go glass-paneled greenhouse"}]},
  {"id":34,"x":180,"y":40,"z":0,"title":"A Cleared Field","descriptions":["The mowed field has piles of hay stacked all over.  Poles hung with colorful paper lanterns line the edge of the range.  Chalk lines have been put down and marked with numbered flags from one end of the clearing to the other."],"exits":[{"to":35,"exit":"north","move":"north"},{"to":33,"exit":"south","move":"south"},{"to":204,"exit":"go","move":"go wooden wagon"}]},
  {"id":35,"x":180,"y":20,"z":0,"title":"A Cleared Field","descriptions":["The mowed field has piles of hay stacked all over.  Poles hung with colorful paper lanterns line the edge of the range.  Chalk lines have been put down and marked with numbered flags from one end of the clearing to the other."],"exits":[{"to":36,"exit":"north","move":"north"},{"to":34,"exit":"south","move":"south"},{"to":203,"exit":"go","move":"go canvas tent"}]},
  {"id":36,"x":180,"y":0,"z":0,"title":"A Cleared Field","descriptions":["The mowed field has piles of hay stacked all over.  Poles hung with colorful paper lanterns line the edge of the range.  Chalk lines have been put down and marked with numbered flags from one end of the clearing to the other."],"exits":[{"to":37,"exit":"north","move":"north"},{"to":35,"exit":"south","move":"south"}]},
  {"id":37,"x":180,"y":-20,"z":0,"title":"A Cleared Field","descriptions":["The mowed field has piles of hay stacked all over.  Poles hung with colorful paper lanterns line the edge of the range.  Chalk lines have been put down and marked with numbered flags from one end of the clearing to the other."],"exits":[{"to":36,"exit":"south","move":"south"}]},
  {"id":38,"x":490,"y":420,"z":0,"title":"Imperial Pavilion, Reception Lounge","descriptions":["Lavish, burgundy brocades surround the spacious lounge with elegantly draping swags, each trimmed with golden satin tassels.  A trio of gaethzen orbs in filigreed holders dangle from velvet ribbons at the central peak, bathing the room in a soft glow.  Along the far wall are four curtains, beaded in crystals of vibrant emerald, sapphire, amber and ruby, each leading further into the spacious pavilion.  Clusters of plump cushions placed around the area facilitate a more comfortable wait for visiting patrons."],"exits":[{"to":22,"exit":"go","move":"go canvas flap"},{"to":39,"exit":"go","move":"go emerald curtain"},{"to":40,"exit":"go","move":"go sapphire curtain"},{"to":41,"exit":"go","move":"go amber curtain"},{"to":42,"exit":"go","move":"go ruby curtain"}],"color":"#00FF00","aliases":["Imperial Pavilion","alterations","waiting list"]},
  {"id":39,"x":470,"y":420,"z":0,"title":"Imperial Pavilion, Emerald Parlor","descriptions":["Swathes of emerald-green satin sweep from corner to corner, the shimmering fabric spiraled with strands of tiny gold beads and iridescent seed pearls.  Placed at the back of the room is an ornately carved workbench of polished mahogany.  Conveniently set near the work area is a pair of brocade upholstered stools."],"exits":[{"to":38,"exit":"go","move":"go emerald curtain"}],"aliases":["Emerald Parlor"]},
  {"id":40,"x":470,"y":400,"z":0,"title":"Imperial Pavilion, Sapphire Parlor","descriptions":["Swathes of sapphire-hued satin sweep from corner to corner, the shimmering fabric spiraled with strands of tiny gold beads and iridescent seed pearls.  Placed at the back of the room is an ornately carved workbench of polished teakwood.  Conveniently set near the work area is a pair of brocade upholstered stools."],"exits":[{"to":38,"exit":"go","move":"go sapphire curtain"}],"aliases":["Sapphire Parlor"]},
  {"id":41,"x":510,"y":400,"z":0,"title":"Imperial Pavilion, Amber Parlor","descriptions":["Swathes of honey-amber satin sweep from corner to corner, the shimmering fabric spiraled with strands of tiny gold beads and iridescent seed pearls.  Placed at the back of the room is an ornately carved workbench of polished maple.  Conveniently set near the work area is a pair of brocade upholstered stools."],"exits":[{"to":38,"exit":"go","move":"go amber curtain"}],"aliases":["Amber Parlor"]},
  {"id":42,"x":510,"y":420,"z":0,"title":"Imperial Pavilion, Ruby Parlor","descriptions":["Swathes of ruby-red satin sweep from corner to corner, the shimmering fabric spiraled with strands of tiny gold beads and iridescent seed pearls.  Placed at the back of the room is an ornately carved workbench of polished rosewood.  Conveniently set near the work area is a pair of brocade upholstered stools."],"exits":[{"to":38,"exit":"go","move":"go ruby curtain"}],"aliases":["Ruby Parlor"]},
  {"id":43,"x":390,"y":440,"z":0,"title":"Owirvald Auction Company, Display Room","descriptions":["Rich sandalwood covers the interior walls of this spacious caravan, its high-polished sheen reflecting the light from the various brass lanterns hung about the room.  A pair of glass-topped display tables flank the opal-beaded curtain leading into the main hall."],"exits":[{"to":23,"exit":"go","move":"go sandalwood door"},{"to":44,"exit":"go","move":"go opal-beaded curtain"}],"aliases":["Owirvald Auction Company","auction"]},
  {"id":44,"x":350,"y":440,"z":0,"title":"Owirvald Auction Company, Auction Floor","descriptions":["Rich sandalwood covers the interior walls of this spacious hall, its high-polished sheen reflecting the light from the various brass lanterns hung about the room.  Rows of leather-padded benches face the podium, offering a comfortable place to sit."],"exits":[{"to":45,"exit":"southeast","move":"southeast"},{"to":47,"exit":"south","move":"south"},{"to":46,"exit":"southwest","move":"southwest"},{"to":43,"exit":"go","move":"go opal-beaded curtain"}],"color":"#FF0000","aliases":["Auction Floor"]},
  {"id":45,"x":370,"y":460,"z":0,"title":"Owirvald Auction Company, Auction Floor","descriptions":["Rich sandalwood covers the interior walls of this spacious hall, its high-polished sheen reflecting the light from the various brass lanterns hung about the room.  Rows of leather-padded benches face the podium, offering a comfortable place to sit."],"exits":[{"to":44,"exit":"northwest","move":"northwest"},{"to":43,"exit":"go","move":"go opal-beaded curtain"}],"color":"#FF0000"},
  {"id":46,"x":330,"y":460,"z":0,"title":"Owirvald Auction Company, Auction Floor","descriptions":["Rich sandalwood covers the interior walls of this spacious hall, its high-polished sheen reflecting the light from the various brass lanterns hung about the room.  Rows of leather-padded benches face the podium, offering a comfortable place to sit."],"exits":[{"to":44,"exit":"northeast","move":"northeast"},{"to":43,"exit":"go","move":"go opal-beaded curtain"}],"color":"#FF0000"},
  {"id":47,"x":350,"y":460,"z":0,"title":"Owirvald Auction Company, Auction Floor","descriptions":["Rich sandalwood covers the interior walls of this spacious hall, its high-polished sheen reflecting the light from the various brass lanterns hung about the room.  Rows of leather-padded benches face the podium, offering a comfortable place to sit."],"exits":[{"to":44,"exit":"north","move":"north"},{"to":43,"exit":"go","move":"go opal-beaded curtain"}],"color":"#FF0000"},
  {"id":48,"x":250,"y":500,"z":0,"title":"Hunka's Delights, Pastries","descriptions":["On several stands rest a variety of mouth-watering baked confections.  The air mixes the rich scents of cinnamon, nutmeg, and cardamon, the tang of citron and lemon peel, a breath of almond paste and just a whiff of something peppery.  Underlying it all is the sweet scent of fresh-baked cakes."],"exits":[{"to":2,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Hunka's Delights"]},
  {"id":49,"x":170,"y":340,"z":0,"title":"The Essential Sects Shop, General Merchandise","descriptions":["Daylight streams through the domed ceiling above, illuminating the goods on display."],"exits":[{"to":53,"exit":"north","move":"north"},{"to":54,"exit":"northeast","move":"northeast"},{"to":55,"exit":"east","move":"east"},{"to":151,"exit":"southeast","move":"southeast"},{"to":50,"exit":"southwest","move":"southwest"},{"to":51,"exit":"west","move":"west"},{"to":52,"exit":"northwest","move":"northwest"},{"to":3,"exit":"go","move":"go elegant doorway"}],"color":"#FF0000","aliases":["The Essential Sects Shop","Essential Sects Shop"]},
  {"id":50,"x":150,"y":360,"z":0,"title":"The Essential Sects Shop, Discovery","descriptions":["Swirls of stars speckle the ceiling, gently caressing the four moons depicted from time immemorial."],"exits":[{"to":49,"exit":"northeast","move":"northeast"}],"color":"#FF0000"},
  {"id":51,"x":150,"y":340,"z":0,"title":"The Essential Sects Shop, Secrecy","descriptions":["A single guttering candle scatters flickering shadows amongst the displays while tiny specs of light shimmer in the myriad of mirrors on the inky walls."],"exits":[{"to":49,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":52,"x":150,"y":320,"z":0,"title":"The Essential Sects Shop, Spiritualism","descriptions":["Proudly displayed on the walls are the pelts of several particularly large game animals."],"exits":[{"to":49,"exit":"southeast","move":"southeast"}],"color":"#FF0000"},
  {"id":53,"x":170,"y":320,"z":0,"title":"The Essential Sects Shop, Uncertainty","descriptions":["An assortment of unglazed raku pieces rings the room.  Each is decorated with a unique pattern of swirls and grooves, with no two alike."],"exits":[{"to":49,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":54,"x":190,"y":320,"z":0,"title":"The Essential Sects Shop, Mystery","descriptions":["Subdued lighting mutes the otherwise colorful display of silks that decorate this portion of the shop."],"exits":[{"to":49,"exit":"southwest","move":"southwest"}],"color":"#FF0000"},
  {"id":55,"x":190,"y":340,"z":0,"title":"The Essential Sects Shop, Perfection","descriptions":["Everything in this section of the shop is unusually clean and orderly, with every item on display in its proper place."],"exits":[{"to":49,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":57,"x":337,"y":240,"z":0,"title":"Primp My Ride, Front Room","descriptions":["Divans line the walls around a large woven rug centered on the floor.  Crowds easily flow through three arches to other areas of the showroom.  A miniature caravan on a circle of tracks sits in one corner."],"exits":[{"to":59,"exit":"east","move":"east"},{"to":58,"exit":"west","move":"west"},{"to":4,"exit":"go","move":"go double doors"},{"to":60,"exit":"go","move":"go hallway"}],"color":"#FF0000","aliases":["Primp My Ride"]},
  {"id":58,"x":323,"y":240,"z":0,"title":"Primp My Ride, West Room","descriptions":["Oak stanchions with braided rope provide the guide for a walkway around the room.  The walls are covered with various forms of artwork, showcasing many styles.  Brass-fitted lanterns hang from the ceiling in strategic places to provide proper lighting to appreciate the artistry."],"exits":[{"to":57,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":59,"x":350,"y":240,"z":0,"title":"Primp My Ride, East Room","descriptions":["Stanchions with silver chains provide the guide for a walkway around the thickly carpeted room.  The walls are covered with various forms of artwork, showcasing many styles.  A caravan wheel, with a hub of brass and fitted with candles, hangs in the center of the room creating a chandelier that provides enough light to allow appreciation of the merchandise's workmanship."],"exits":[{"to":57,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":60,"x":337,"y":227,"z":0,"title":"Primp My Ride, North Room","descriptions":["Gold-plated stanchions with red velvet ropes provide the guide for a walkway around the thickly carpeted rooms.  The walls are covered with various forms of artwork, showcasing many styles.  A crystal chandelier that is tended to by a maid hangs in the center of the room to provide proper lighting to appreciate the artistry."],"exits":[{"to":57,"exit":"go","move":"go hallway"},{"to":61,"exit":"go","move":"go heavy curtain"}],"color":"#FF0000"},
  {"id":61,"x":337,"y":213,"z":0,"title":"Primp My Ride, Behind the Curtain","descriptions":["Unlike the rest of the shop, this room is cluttered with various samples of woods, fabrics and paint samples.  A desk with large books of order forms covering it has a chair on either side.  Pencil sketches of caravans have been pinned all over the curtain leading to the outer room."],"exits":[{"to":60,"exit":"go","move":"go heavy curtain"}],"color":"#FF0000"},
  {"id":63,"x":470,"y":220,"z":0,"title":"Hide and Seek, Entrance","descriptions":["Open hallways branch out in this large circular caravan, not unlike the spokes of a wheel.  Bright candles provide plenty of light to the area, illuminating the numerous and colorful variety of curtains that hang from the walls between the hallways.  The scent of incense hangs faintly in the air, tinged with jasmine and cinnamon."],"exits":[{"to":64,"exit":"north","move":"north"},{"to":65,"exit":"northeast","move":"northeast"},{"to":67,"exit":"west","move":"west"},{"to":66,"exit":"northwest","move":"northwest"},{"to":26,"exit":"go","move":"go caravan door"},{"to":181,"exit":"go","move":"go wide archway"},{"to":226,"exit":"go","move":"go narrow gap","hidden":true}],"color":"#FF0000","aliases":["Hide and Seek"]},
  {"id":64,"x":470,"y":200,"z":0,"title":"Hide and Seek, Hall of Moons","descriptions":["Large murals of the triple moons illuminating the night sky decorate this simple room, spanning each wall as one scene melds into the next.  Large gaethzen orbs hanging from the ceiling brightly showcase the wares below, illuminating every portion of the gently curving area."],"exits":[{"to":63,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":65,"x":490,"y":200,"z":0,"title":"Hide and Seek, Hall of the Holy","descriptions":["Large murals depicting the aspects of the Immortals decorate this simple room, spanning each wall as one scene melds into the next.  Large gaethzen orbs hanging from the ceiling brightly showcase the wares below, illuminating every portion of the gently curving area."],"exits":[{"to":63,"exit":"southwest","move":"southwest"}],"color":"#FF0000"},
  {"id":66,"x":450,"y":200,"z":0,"title":"Hide and Seek, Hall of Life","descriptions":["Large murals of rolling green hills dotted with healing herbs decorate this simple room, spanning each wall as one scene melds into the next.  Large gaethzen orbs hanging from the ceiling brightly showcase the wares below, illuminating every portion of the gently curving area."],"exits":[{"to":63,"exit":"southeast","move":"southeast"}],"color":"#FF0000"},
  {"id":67,"x":450,"y":220,"z":0,"title":"Hide and Seek, Hall of Elements","descriptions":["Large murals of fire, earth, air and water decorate this simple room, spanning each wall as one scene melds into the next.  Large gaethzen orbs hanging from the ceiling brightly showcase the wares below, illuminating every portion of the gently curving area."],"exits":[{"to":63,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":68,"x":430,"y":300,"z":0,"title":"Delightful Decor, Winter's Wonderland","descriptions":["Glittering glass icicles hang in a spiraling cascade at the center of the tent, amplifying the light cast by a series of candles within the cluster.  Assorted decorations for homes are stacked in neat piles in crates, baskets and barrels, and a counter holds still more of the items for sale."],"exits":[{"to":71,"exit":"north","move":"north"},{"to":69,"exit":"east","move":"east"},{"to":70,"exit":"west","move":"west"},{"to":26,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Delightful Decor"]},
  {"id":69,"x":450,"y":300,"z":0,"title":"Delightful Decor, Autumn's Array","descriptions":["Draped along the walls are vibrant swags of gold, orange, and brown, while a leaf-patterned rug lies in the middle of the small area.  Various decorations overflow from crates, barrels and baskets, while a sturdy oak counter is stacked with additional items for sale."],"exits":[{"to":68,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":70,"x":410,"y":300,"z":0,"title":"Delightful Decor, Spring Fling","descriptions":["A melange of sweet floral scents pervades the small room, as cut flowers vie with the mossy aroma of rich loam from bare root plants.  Delicate watercolor paintings of spring blossoms adorn the walls, while a plethora of items are neatly placed in crates, barrels and baskets."],"exits":[{"to":68,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":71,"x":430,"y":280,"z":0,"title":"Delightful Decor, Scenic Summer","descriptions":["Brightly painted, canvas panels with scenes of blooming flowers, trees and suns line the interior of the area, while vibrant ribbons cascade and spiral down a central pole supporting the tent.  Assorted decorations are neatly stacked within barrels, crates and baskets along the walls, while a sturdy oak counter holds still more of the items for sale."],"exits":[{"to":68,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":72,"x":570,"y":240,"z":0,"title":"Beppo's, Showroom","descriptions":["Multicolored silks drape the walls throughout the area, with plush golden pard rugs covering the floor.  In the back corner of the tent stand a couple of worktables covered in half-finished badges, some scrap metal and various stamping tools.  A small lantern overhead reveals a narrow path that wends its way past a counter and through the many displays, shelves and tables."],"exits":[{"to":73,"exit":"north","move":"north"},{"to":25,"exit":"go","move":"go oak door"}],"color":"#FF0000","aliases":["Beppo's","Beepo"]},
  {"id":73,"x":570,"y":220,"z":0,"title":"Beppo's, Back Room","descriptions":["Several colorful, wood shelves line the heavy canvas walls amid vibrant silks that drape from each corner of the small room.  Plush, golden pard rugs surround an array of elegant brocade pillows at the center of the room, providing a comfortable spot to rest for weary shoppers."],"exits":[{"to":72,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":74,"x":610,"y":240,"z":0,"title":"Fancybeards, Bearded Fantasy","descriptions":["Seemingly hewn from a solid piece of rock, the inside of the hut is smooth and slightly rounded, showing no hard edges.  Two counters are cut from the stone and draped with fine black velvet that matches the woven rug stretched across the floor.  Small oval windows show off perfectly clear glass panes.  An arched doorway leads back outside."],"exits":[{"to":75,"exit":"north","move":"north"},{"to":25,"exit":"go","move":"go arched doorway"}],"color":"#FF0000","aliases":["Fancybeards","Beards"]},
  {"id":75,"x":610,"y":220,"z":0,"title":"Fancybeards, Bearded Majesty","descriptions":["A wide counter is carved from the back wall, its edges curved inward.  To either side of the counter, also chiseled from the stone of the hut, are two shelves.  Plush white velvet covers all the surfaces, allowing the wares to be displayed without distraction.  Two large, round windows are sculpted into the side walls, their panes propped open to catch any stray breeze."],"exits":[{"to":74,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":76,"x":710,"y":200,"z":0,"title":"Mystical Machinations, Entryway","descriptions":["Tendrils of ice blue mist swirl in an hypnotic dance around a coruscating orb of dark cerulean light that hovers in the center of this chamber.  Walls of pearlescent white marble encase the strange building like a tomb, lending a feeling of solace and remoteness to this Enchanter's workshop."],"exits":[{"to":77,"exit":"north","move":"north"},{"to":79,"exit":"northeast","move":"northeast"},{"to":78,"exit":"east","move":"east"},{"to":80,"exit":"southeast","move":"southeast"},{"to":81,"exit":"south","move":"south"},{"to":82,"exit":"southwest","move":"southwest"},{"to":83,"exit":"west","move":"west"},{"to":84,"exit":"northwest","move":"northwest"},{"to":24,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Mystical Machinations"]},
  {"id":77,"x":710,"y":180,"z":0,"title":"Mystical Machinations, Merchandiser's Chamber","descriptions":["Embedded gems line the gold walls of this chamber, allowing any light that hits the wall, or the gems ensconced within it to sparkle with a blinding luminescence.  A few cushioned redwood chairs have been positioned, allowing visitors a place to sit.  The gentle sounds of coins clinking together drift through the room, creating a sort of background music."],"exits":[{"to":76,"exit":"south","move":"south"},{"to":161,"exit":"go","move":"go contract"}],"color":"#FF0000"},
  {"id":78,"x":730,"y":200,"z":0,"title":"Mystical Machinations, Healer's Chamber","descriptions":["A large crystalline pool inlaid with pattern of twining malachite vines dominates the chamber.  Bright gaethzen globes suspended from the sterile white marble ceiling reflect off the walls, illuminating the chamber with a severe glow that eradicates all nearby shadow."],"exits":[{"to":76,"exit":"west","move":"west"},{"to":163,"exit":"go","move":"go pool"}],"color":"#FF0000"},
  {"id":79,"x":730,"y":180,"z":0,"title":"Mystical Machinations, Justicar's Chamber","descriptions":["Golden tower shields adorn the cold white marble walls, lending a regal air to this chamber.  A single platinum silk tapestry cascades down from the ceiling, embroidered with the image of a faceless man bedecked in plate mail and holding a broadsword in his right hand and an olive laurel in his left.  Soft black velvet cushions lie strewn in a reverent circle beneath the tapestry."],"exits":[{"to":76,"exit":"southwest","move":"southwest"},{"to":162,"exit":"go","move":"go golden arch"}],"color":"#FF0000"},
  {"id":80,"x":730,"y":220,"z":0,"title":"Mystical Machinations, Hunter's Chamber","descriptions":["Verdant tapestries depicting the forest hunt sweep from the ceiling above, lending a semblance of the wilderness to the austere and sterile environment of this chamber.  Plush black velvet cushions are strewn causally around the chamber, offering a moment's rest."],"exits":[{"to":76,"exit":"northwest","move":"northwest"},{"to":164,"exit":"go","move":"go vines"}],"color":"#FF0000"},
  {"id":81,"x":710,"y":220,"z":0,"title":"Mystical Machinations, Minstrel's Chamber","descriptions":["Elegant tapestries of blue and gold cover the white marble walls of this chamber, filling it with scenes of minstrels performing for nobles, busking in the streets, or inspiring soldiers in battle.  A few cushioned oak chairs rest between the tapestries, providing visitors with a comfortable place to sit.  Gentle melodies from unseen musicians drift through the chamber, creating a sense of calm and restfulness."],"exits":[{"to":76,"exit":"north","move":"north"},{"to":165,"exit":"go","move":"go harpstring"}],"color":"#FF0000"},
  {"id":82,"x":690,"y":220,"z":0,"title":"Mystical Machinations, Seer's Chamber","descriptions":["Gaethzen globes shaded by veils of dusky crystal suffuse the chamber in a moody pall of midnight blue light, muting the severity of the white marble walls.  Strange motes of silver light float freely in the air, forming a chaotic display of the heavens' constellations that cycles in the ever-changing dance of Fate's tide."],"exits":[{"to":76,"exit":"northeast","move":"northeast"},{"to":166,"exit":"go","move":"go moongate"}],"color":"#FF0000"},
  {"id":83,"x":690,"y":200,"z":0,"title":"Mystical Machinations, Elemancer's Chamber","descriptions":["A symmetric oval of six silver stands rise from the floor, each one grasping a piece of colored crystal.  Strange motes of light flicker within their depths, stirring with essence of the elements.  Cushions of plush black velvet lie strewn within the circle of crystals, bathed in the ebb and flow of their luminous gaze."],"exits":[{"to":76,"exit":"east","move":"east"},{"to":167,"exit":"go","move":"go platform"}],"color":"#FF0000"},
  {"id":84,"x":690,"y":180,"z":0,"title":"Mystical Machinations, Hierophant's Chamber","descriptions":["Austere walls of pearlescent white marble have been draped with somber tapestries depicting the various stages of Life and Death -- the never-ending cycle the gods have bestowed upon mortals.  Pale silver taper candles rise elegantly from sconces in the floor, casting their crystalline glow over intricately woven prayer carpets and velvet cushions that circle a speckled granite altar in the center of the chamber."],"exits":[{"to":76,"exit":"southeast","move":"southeast"},{"to":168,"exit":"go","move":"go arch"}],"color":"#FF0000"},
  {"id":85,"x":730,"y":340,"z":0,"title":"Osgeth's, Entry","descriptions":["Colorful mixtures of paint spatter the sturdy leather walls of this square-shaped tent.  Set in the center of the room is a large wooden post that slants the roof, also covered in a variety of smears.  A small hanging lantern illuminates the room, which is fairly empty except for a small wooden table set out on the floor."],"exits":[{"to":24,"exit":"go","move":"go square flap"},{"to":255,"exit":"go","move":"go deerhide curtain"}],"color":"#FF0000","aliases":["Osgeth's","Osgeth"]},
  {"id":86,"x":690,"y":460,"z":0,"title":"Flowering Furniture","descriptions":["Outwardly curving, wooden walls enclose the caravan, helping to give the impression of space despite the scattering of furniture samples taking up most of the floor.  Grass-green paint lavishly coats the entire area.  Sconces set every few feet to make up for the lack of windows, each one molded into the shape of a rose.  An arched exit sits in the middle of one wall."],"exits":[{"to":90,"exit":"east","move":"east"},{"to":87,"exit":"west","move":"west"},{"to":20,"exit":"go","move":"go arched exit"}],"color":"#FF0000","aliases":["Flowering Furniture"]},
  {"id":87,"x":670,"y":460,"z":0,"title":"Flowering Furniture","descriptions":["Outwardly curving, wooden walls enclose the caravan, helping to give the impression of space despite the scattering of furniture samples taking up most of the floor.  Sunny-yellow paint lavishly coats the entire area, blending with the green that appears to the east.  Sconces set every few feet to make up for the lack of windows, each one molded into the shape of a lily."],"exits":[{"to":86,"exit":"east","move":"east"},{"to":88,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":88,"x":650,"y":460,"z":0,"title":"Flowering Furniture","descriptions":["Outwardly curving, wooden walls enclose the caravan, helping to give the impression of space despite the scattering of furniture samples taking up most of the floor.  Sunset-orange paint lavishly coats the entire area, blending with the yellow that appears to the east.  Sconces set every few feet to make up for the lack of windows, each one molded into the shape of a peony."],"exits":[{"to":87,"exit":"east","move":"east"},{"to":89,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":89,"x":630,"y":460,"z":0,"title":"Flowering Furniture","descriptions":["Outwardly curving, wooden walls enclose the caravan, helping to give the impression of space despite the huge tables taking up most of the floor.  Petal-purple paint lavishly coats the entire area, blending with the orange that appears to the east.  Sconces set every few feet to make up for the lack of windows, each one molded into the shape of a violet."],"exits":[{"to":88,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":90,"x":710,"y":460,"z":0,"title":"Flowering Furniture","descriptions":["Outwardly curving, wooden walls enclose the caravan, helping to give the impression of space despite the scattering of furniture samples taking up most of the floor.  Sky-blue paint lavishly coats the entire area, blending with the green that appears to the west.  Sconces set every few feet to make up for the lack of windows, each one molded into the shape of a daisy."],"exits":[{"to":91,"exit":"east","move":"east"},{"to":86,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":91,"x":730,"y":460,"z":0,"title":"Flowering Furniture, Waiting Area","descriptions":["Outwardly curving, wooden walls enclose the caravan, helping to give the impression of space despite the huge couch and table taking up most of the floor.  Rose-red paint lavishly coats the entire area, blending with the blue that appears to the west.  Sconces set every few feet to make up for the lack of windows, each one molded into the shape of a crocus."],"exits":[{"to":90,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":92,"x":670,"y":420,"z":0,"title":"Auntie Phanie's Phancies, Sales Floor","descriptions":["This area of the wagon's interior has been painted a cheery pink on the ceiling and walls interrupted only by a meringue-white door, while the floor has been covered in a vibrant carpet woven with a tart motif.  Streamers of ribbon, punctuated by bows at even intervals, hang from the crossbeams just above a long display counter and decorate all three of the tables that dominate the space.  Attendant Rosaya bustles about excitedly, making sure everything runs smoothly."],"exits":[{"to":93,"exit":"west","move":"west"},{"to":20,"exit":"go","move":"go meringue-white door"}],"color":"#FF0000","aliases":["Auntie Phanie's Phancies","Phanie's","Phanie"]},
  {"id":93,"x":650,"y":420,"z":0,"title":"Auntie Phanie's Phancies, Sitting Room","descriptions":["Framed simply and hung low on the blue walls are several paintings of baked goods.  Several plush couches are arranged around a low table decorated with several small bouquets of snowdrops.  Off to the side is a thick black curtain fringed with golden tassels."],"exits":[{"to":92,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":94,"x":710,"y":420,"z":0,"title":"The Foraging Emporium","descriptions":["Lightweight wooden trellises hung with a multitude of drying herbs line the walls of this high-ceilinged pavilion.  Large mirrors make the most of the available light, creating the illusion of a much larger space.  The pungent, woody smell of drying herbs pervades the area, along with the occasional sharp whiff of powerful alchemical reagents.  A portable stove littered with beakers, pots and pans is partially concealed by a folding screen."],"exits":[{"to":20,"exit":"go","move":"go exit flap"}],"color":"#FF0000","aliases":["The Foraging Emporium","Foraging Emporium"]},
  {"id":95,"x":850,"y":480,"z":0,"title":"The Wandering Woodsman","descriptions":["Made of only the best quality hides which have been tanned and oiled to near transparency, the resulting effect is a light and airy, though not especially warm, tent.  Several tables, racks and a burlap-padded mannequin are set up in a semicircle along the walls.  All of the furniture surrounds a coffee pot that is simmering on a warm brazier set up near the center."],"exits":[{"to":96,"exit":"west","move":"west"},{"to":17,"exit":"go","move":"go tent flap"},{"to":97,"exit":"go","move":"go door"}],"color":"#FF0000","aliases":["The Wandering Woodsman","Wandering Woodsman"]},
  {"id":96,"x":830,"y":480,"z":0,"title":"The Wandering Woodsman, Wardens Quarters","descriptions":["This portion of the tent is a bit darker with hides of a thicker, heavier variety.  Stone tables display some of the larger items beneath the more congruous racks and shelves that line the walls of the modestly-sized interior.  A large granite statue of a wolf stands guard at the flap."],"exits":[{"to":95,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":97,"x":870,"y":480,"z":0,"title":"The Wandering Woodsman, Back Room","descriptions":["More for work than show, the room features benches stationed on either side of a large, well-worn table.  A large basket rests atop the gouged and notched surface, next to a standalone sign.  The notice's elegant writing seems slightly out of place in the otherwise utilitarian room."],"exits":[{"to":95,"exit":"go","move":"go door"}],"color":"#FF0000"},
  {"id":99,"x":790,"y":520,"z":0,"title":"Empath Emporium, Entry","descriptions":["Heavy canvas drapes from poles firmly planted in the dirt, and the tent is sectioned off by rolled gauze curtains.  Despite the thick material, the space seems airy and open.  A table to the left of the entrance holds several colorful pouches, while a cot full of aprons rests against a side wall.  Woven rugs in various blue hues are scattered across the ground."],"exits":[{"to":101,"exit":"east","move":"east"},{"to":19,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Empath Emporium"]},
  {"id":100,"x":830,"y":520,"z":0,"title":"Empath Emporium, Armory","descriptions":["Cut and cured hides hang from the walls, adding substance to support the wares displayed here.  A large shield rack holding both metal shields and arm-worn leather shields stands in the far corner, its shadow dominating the rest of the area.  Nearby, leather mannequins wear assorted garments suitable for both on and off the hunting field."],"exits":[{"to":101,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":101,"x":810,"y":520,"z":0,"title":"Empath Emporium, Guildhalls","descriptions":["This section of the tent features a wardrobe, jewelry case, and shelf that border a sapphire blue rug woven with the crest of the Empaths' Guild.  A sling-backed blue canvas chair nestles into a corner, its matching footrest dominated by a very large grey cat.  Against an inner canvas wall, a free-standing oval mirror in a frame of rosewood stands ready for customers to view the effects of their purchases."],"exits":[{"to":100,"exit":"east","move":"east"},{"to":99,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":103,"x":510,"y":460,"z":0,"title":"Pyromaniacs' Corner, Salesroom","descriptions":["Disheveled apprentices with soot-caked fingers and hotheaded robe-clad customers elbow one another to make their way in this cramped stall.  In spite of the fact that there are plenty of openings in the tarp for the air to circulate, it is thoroughly choked with a pungent smoke that hangs over the wares."],"exits":[{"to":22,"exit":"go","move":"go exit"}],"color":"#FF0000","aliases":["Pyromaniacs' Corner"]},
  {"id":107,"x":600,"y":460,"z":0,"title":"Ties for Things, Singles","descriptions":["Supported by wide arches, the interior of the tent appears to be broken into several rooms.  A thin rug covers the floor, providing an uneven footing.  Several of the sales surfaces appear to be propped by bits of thin wood to keep them level."],"exits":[{"to":110,"exit":"southwest","move":"southwest"},{"to":108,"exit":"west","move":"west"},{"to":21,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Ties for Things"]},
  {"id":108,"x":580,"y":460,"z":0,"title":"Ties for Things, Doubles","descriptions":["Supported by wide arches, the interior of the tent appears to be broken into several rooms.  A thin rug covers the floor, providing an uneven footing.  Several of the sales surfaces appear to be propped by bits of thin wood to keep them level."],"exits":[{"to":107,"exit":"east","move":"east"},{"to":109,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":109,"x":560,"y":460,"z":0,"title":"Ties for Things, Specialty","descriptions":["Supported by wide arches, the interior of the tent appears to be broken into several rooms.  A thin rug covers the floor, providing an uneven footing.  Several of the sales surfaces appear to be propped by bits of thin wood to keep them level."],"exits":[{"to":108,"exit":"east","move":"east"},{"to":110,"exit":"southeast","move":"southeast"}],"color":"#FF0000"},
  {"id":110,"x":580,"y":480,"z":0,"title":"Ties for Things, Kaldaran Specialties","descriptions":["Supported by wide arches, the interior of the tent appears to be broken into several rooms.  A thin rug covers the floor, providing an uneven footing.  Several of the sales surfaces appear to be propped by bits of thin wood to keep them level."],"exits":[{"to":107,"exit":"northeast","move":"northeast"},{"to":109,"exit":"northwest","move":"northwest"}],"color":"#FF0000"},
  {"id":111,"x":600,"y":420,"z":0,"title":"Perpetual Blossoms of Mer'Kresh, Annex","descriptions":["Perpetual Blossoms is like an endless spring in Mer'Kresh.  Flowers bloom all about the room, and a gablefruit vine climbs across the walls, flourishing in the illumination of gaethzen orbs set in the ceiling above.  Large displays hold freshly cut blossoms and bouquets that fill the air with intoxicating scents.  Floral clerks discretely watch over the domain, gently tending flowers and customers alike with gracious smiles."],"exits":[{"to":112,"exit":"north","move":"north"},{"to":21,"exit":"go","move":"go driftwood door"}],"color":"#FF0000","aliases":["Perpetual Blossoms of Mer'Kresh"]},
  {"id":112,"x":600,"y":400,"z":0,"title":"Perpetual Blossoms of Mer'Kresh, Annex Showroom","descriptions":["Flowering vines of all color and size flourish under the light of the gaethzen orbs, creating a surrounding kaleidoscope of color punctuated with a variety of redolent scents.  Patrons browse through the various displays, cradling their purchases carefully as they wander throughout the small shop."],"exits":[{"to":111,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":113,"x":830,"y":280,"z":0,"title":"Gersvinda's Natural Studies, Studio","descriptions":["The lightweight golden-hued wood of the lattice roof is clearly visible, despite the dim lighting cast by several aromatic hanging lamps dangling from the ceiling.  Numerous stacks of paints, chalks and pastels are scattered atop most of the workspaces, along with half-finished charts and sketches of creatures.  The plank floor is muffled by several colorful rugs worked in botanical patterns, while a lacquered screen painted with vivid pink waterfowl blocks access to the living area.  Hung along the lattice walls, four silken ropes -- one red, one orange, one black and one golden -- display vibrantly colored anatomy charts."],"exits":[{"to":14,"exit":"go","move":"go exit flap"}],"color":"#FF0000","aliases":["Gersvinda's Natural Studies","Natural Studies"]},
  {"id":115,"x":870,"y":290,"z":0,"title":"Nahja's Knickknacks, Front Room","descriptions":["The smell of leather permeates the air within the windowless confines of the long tent walls.  The front area features a polished oak table adjacent to a velvet-draped counter.  Brightly burning lanterns manage to chase away the shadows and illuminate the merchandise.  Mossy green carpet runners lead the way further back into the tent while to the left hangs a dark brown curtain."],"exits":[{"to":116,"exit":"north","move":"north"},{"to":15,"exit":"go","move":"go tent flap"},{"to":246,"exit":"go","move":"go brown curtain"}],"color":"#FF0000","aliases":["Nahja's Knickknacks","Knickknacks"]},
  {"id":116,"x":870,"y":270,"z":0,"title":"Nahja's Knickknacks, Back Room","descriptions":["At the back of the tent, all available surfaces have been drafted into use as displays.  A makeshift shelf rests above an oak table, each one housing carefully arranged merchandise.  Even a rickety pine bench has been put to use with items for sale upon it rather than room for sitting.  A russet curtain blocks any attempts at further exploration."],"exits":[{"to":115,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":117,"x":870,"y":80,"z":0,"title":"Gemfire Mountains Leathercrafters, Sales Floor","descriptions":["Bright, colorful lanterns hang from the ceiling beams of this sturdy wagon, illuminating the carefully displayed merchandise arranged around the sales area.  A short maple work table fills one end of the wagon while a large shelf runs down one side.  Opposite the work table, an extravagantly carved doorway leads out of the wagon."],"exits":[{"to":12,"exit":"go","move":"go doorway"}],"color":"#FF0000","aliases":["Gemfire Mountains Leathercrafters","leathercrafters"]},
  {"id":118,"x":830,"y":80,"z":0,"title":"Inner Vision, Showroom","descriptions":["Elegantly draped, golden silks create a decorative valance that surrounds the interior of the heavy canvas tent.  A small chandelier encircled with gaethzen orbs hangs overhead, their multicolored hues casting rich tones across the large potted palms that line the area.  An ornately carved counter rests along one wall, displaying several trays of wares."],"exits":[{"to":120,"exit":"north","move":"north"},{"to":119,"exit":"west","move":"west"},{"to":12,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Inner Vision"]},
  {"id":119,"x":810,"y":80,"z":0,"title":"Inner Vision, Parlor","descriptions":["Luxurious silks of gold and burgundy drape the surrounding walls, showcasing a large vibrant tapestry.  Soft, alabaster-white snowbeast pelts scattered upon the floor soften the steps of the many shoppers who stop to enjoy a leisurely rest and a cool drink.  Hammered brass lanterns hang in each corner, emanating a muted golden hue through their amber glass panes.  Surrounded by a pair of comfortable armchairs, a thick, clay brazier burns warmly at the center of the room, its small wisps of smoke trailing up through a small hole in the peak of the canvas ceiling."],"exits":[{"to":118,"exit":"east","move":"east"},{"to":122,"exit":"go","move":"go narrow stairwell","hidden":true},{"to":259,"exit":"go","move":"go canvas archway"}],"color":"#FF0000"},
  {"id":120,"x":830,"y":60,"z":0,"title":"Inner Vision, Back Room","descriptions":["Hammered brass lanterns hung in each corner cast a soft, muted plum hue over the artistically painted, canvas panels of the small room.  A soft, woolen rug covers the floor in a woven pattern of crisscrossing ivy vines while a slender marble pedestal at the center of the room holds a small, brass incense burner.  Set against a far wall, a polished oak counter displays several trays of wares."],"exits":[{"to":118,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":121,"x":810,"y":140,"z":0,"title":"Marine Marvels, Showroom","descriptions":["Velvet drapes the tent's walls, replicating the ocean's hues, which show off the jewels displayed to their natural advantage.  Gaezthen spheres line the ceiling, each exuding a soft glow, while a bench placed near a mirror allows customers to rest and admire their new treasures."],"exits":[{"to":122,"exit":"north","move":"north"},{"to":123,"exit":"east","move":"east"},{"to":12,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Marine Marvels"]},
  {"id":122,"x":810,"y":120,"z":0,"title":"Marine Marvels, Back Room","descriptions":["Dazzling displays of colorful coral decorate the surrounding walls amid swathes of vibrant ocean-hued silks.  Gaethzen starfish hang overhead, highlighting the many wares available for purchase."],"exits":[{"to":121,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":123,"x":830,"y":140,"z":0,"title":"Marine Marvels, Fine Gems","descriptions":["The underwater theme is carried further throughout the shop with swathes of ocean-hued velvets draping the walls, mingled with clusters of tall iridescent taffeta sea fronds that rise from floor displays.  A large, dried pale-blue sea fan stands at the center of the small area, displaying a glistening array of ear jewelry, while a large dangling silver starfish and small gold chest overflow with additional pieces for purchase."],"exits":[{"to":121,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":124,"x":290,"y":80,"z":0,"title":"The Web of Fate","descriptions":["Various sized bottles bound with fraying strips of leather dangle haphazardly from the ceiling of the shack, their contents illuminated by a multitude of candles placed on every available surface.  The heat in the room is palpable, heavy in the air along with a strange scent of decay.  Bizarre artifacts, scrolls and bones fight for space with the candles on creaky wooden shelves."],"exits":[{"to":11,"exit":"go","move":"go flap"}],"color":"#FF0000","aliases":["The Web of Fate","Web of Fate"]},
  {"id":125,"x":330,"y":80,"z":0,"title":"The Bardic Journey, Foyer","descriptions":["The tent's ceiling comprises dark silks, scarlet ones rippling down to form the walls.  Scattered metallic threads and tiny red crystals, glistening in the lamplight, give the impression of fiery sparks wavering in the air.  A fountain in the center of the room adds the sound of falling water, the contrast only enhancing the effect."],"exits":[{"to":11,"exit":"go","move":"go tent flap"},{"to":247,"exit":"go","move":"go beribboned archway"},{"to":248,"exit":"go","move":"go draped doorway"},{"to":249,"exit":"go","move":"go dark curtain"}],"color":"#FF0000","aliases":["The Bardic Journey","Bardic Journey"]},
  {"id":126,"x":160,"y":100,"z":0,"title":"A Bright Red Tent, Gerkin's Apple Show","descriptions":["The fresh scent of fruit blossoms fills the tent's interior.  Wood carvings, depicting every type of apple in all different sizes, hang from every pole that supports the cloth roof.  A long table, displaying various types of apple-based culinary delights, is pushed off to one side."],"exits":[{"to":27,"exit":"go","move":"go tent flap"}],"color":"#00FF00"},
  {"id":127,"x":230,"y":240,"z":0,"title":"The Book Wyrm, Punny Presents","descriptions":["Bright pink paper lanterns are strung across the ceiling on cords of steelsilk, their bright hue contrasting with the pale grey walls and adding a pop of color to the busy space.  Tall piles of tote bags are spread out across a pair of tables at the center of the room, while a colorful arrangement of greeting cards are displayed on an iron stand.  Precariously stacked books frame the exit door, each chosen to balance the next and form a perfect arch."],"exits":[{"to":128,"exit":"north","move":"north"},{"to":5,"exit":"go","move":"go door"}],"color":"#FF0000","aliases":["The Book Wyrm","Book Wyrm"]},
  {"id":128,"x":230,"y":220,"z":0,"title":"The Book Wyrm, Draw It Out","descriptions":["White paper lanterns dangle in the corners of this room, glowing slightly from the candles hidden within them.  More candles illuminate a long counter that runs along one of the room's pale green walls, its surface covered in heaps of paper.  A writing desk in the center of the room is arranged with colorful drawing and writing utensils, while a tall iron stand in the back corner is strewn with coveralls, overalls, and smocks."],"exits":[{"to":129,"exit":"north","move":"north"},{"to":127,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":129,"x":230,"y":200,"z":0,"title":"The Book Wyrm, Pencil Me In","descriptions":["Paper lanterns strung across the ceiling cast light across the small room, illuminating everything with a soft glow.  Colorful bookcases line the walls, their shelves overladen with a disorganized assortment of books, journals, and folios.  In the back corner is a winding staircase that leads up to a recessed space above."],"exits":[{"to":128,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":130,"x":190,"y":240,"z":0,"title":"Arcayne Attyre, Clothiers","descriptions":["Patrons move about the shop, dressed in all manner of mystical attire, each browsing the selection of wares on display.  Four mannequins are placed around the area, each posed with a variety of items."],"exits":[{"to":132,"exit":"east","move":"east"},{"to":131,"exit":"west","move":"west"},{"to":6,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Arcayne Attyre"]},
  {"id":131,"x":170,"y":240,"z":0,"title":"Arcayne Attire, West Wing","descriptions":["Vibrant silks drape the walls of the small area, while several gaethzen stars illuminate the wares below.  An ornate candelabra displays a variety of hats and a nearby wardrobe holds additional garments for sale."],"exits":[{"to":130,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":132,"x":210,"y":240,"z":0,"title":"Arcayne Attire, East Wing","descriptions":["Dark silks drape the canvas walls of the area, while a variety of gaethzen ravens provide a bit of illumination to the four pillar busts on display.  Several patrons amble about, each trying on their purchases and admiring themselves in a nearby mirror."],"exits":[{"to":130,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":133,"x":130,"y":240,"z":0,"title":"Just In Case, Case Room","descriptions":["Simple wooden walls lean together, looking as if the merest breeze will send them toppling over.  Stretched across the ground is a dirty rug that might have been blue once, while two lopsided tables vie for room in the cramped area.  Dangling haphazardly are two shelves, one is cracked down the middle and inexpertly pieced back together."],"exits":[{"to":134,"exit":"south","move":"south"},{"to":6,"exit":"go","move":"go sloping door"}],"color":"#FF0000","aliases":["Just In Case"]},
  {"id":134,"x":130,"y":260,"z":0,"title":"Just In Case, Case Corner","descriptions":["Simple wooden walls lean together, looking as if the merest breeze will send them toppling over.  Stretched across the ground is a faded rug that might have been green once, while two lopsided tables vie for room in the cramped area.  Dangling haphazardly are two shelves, one appears to have been glued together from scrap woods."],"exits":[{"to":133,"exit":"north","move":"north"}],"color":"#FF0000"},
  {"id":139,"x":60,"y":300,"z":0,"title":"Abu Hassan Ali ibn Bekar's Fineries","descriptions":["A swirl of translucent fabrics, a hint of distant aromatic spices serve notice of the exotic goods in this tent.  Large stuffed pillows lie scattered about the floor.  They seem to animate in the flickering dance of a single torch, suspended in an iron brazier from above.  Abu Hassan sits immersed in his own finery, watching his clerks transact business."],"exits":[{"to":7,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Abu Hassan Ali ibn Bekar's Fineries"]},
  {"id":140,"x":-40,"y":180,"z":0,"title":"Merit Badges, Sales Floor","descriptions":["Neatly pressed, the folds of the tent appear to fall in exact lines creating an octagon shape on the inside of this neatly kept tent.  Two plain maple tables sit on a swept wool rug of river blue.  A tent flap stands open between them, held by a simple blue cord.  Across from the flap, a heavy curtain with a blue and gold compass rose stitched on it hangs across an opening."],"exits":[{"to":142,"exit":"east","move":"east"},{"to":141,"exit":"west","move":"west"},{"to":10,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Merit Badges"]},
  {"id":141,"x":-60,"y":180,"z":0,"title":"Merit Badges, Sales Floor","descriptions":["Neatly pressed, the folds of the tent appear to fall in exact lines creating an octagon shape on the inside of this neatly kept tent.  Two plain oak tables sit on a soft silk rug of dark gold."],"exits":[{"to":140,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":142,"x":-20,"y":180,"z":0,"title":"Merit Badges, Sales Floor","descriptions":["Neatly pressed, the folds of the tent appear to fall in exact lines creating an octagon shape on the inside of this neatly kept tent.  Two plain applewood tables sit on a heavy cotton rug of pale silver."],"exits":[{"to":140,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":143,"x":40,"y":180,"z":0,"title":"Getting Back to Basics, Carry It","descriptions":["Glossy walls are covered with a light polish to bring out the soft tones of the wood, while round windows are set evenly to catch any bit of light from outside.  A fringed burgundy rug extends across the floor ending just before the silverwood door that leads back out to the festival grounds.  Two racks are set up in the middle of the room to best display their wares."],"exits":[{"to":144,"exit":"north","move":"north"},{"to":146,"exit":"east","move":"east"},{"to":145,"exit":"west","move":"west"},{"to":10,"exit":"go","move":"go silverwood door"}],"color":"#FF0000","aliases":["Getting Back to Basics","Back to Basics"]},
  {"id":144,"x":40,"y":160,"z":0,"title":"Getting Back to Basics, Skin It","descriptions":["Glossy walls are covered with a light polish to bring out the soft tones of the wood, while round windows are set evenly to catch any bit of light from outside.  A lush green carpet extends across the floor and under some counters that are set side by side in the center of the area."],"exits":[{"to":143,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":145,"x":20,"y":180,"z":0,"title":"Getting Back to Basics, Additional Accessories","descriptions":["Glossy walls are covered with a light polish to bring out the soft tones of the wood, while round windows are set evenly to catch any bit of light from outside.  A soft orange carpet extends across the floor and under a pair of stands that are set in the middle of the area."],"exits":[{"to":143,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":146,"x":60,"y":180,"z":0,"title":"Getting Back to Basics, Magic It","descriptions":["Glossy walls are covered with a light polish to bring out the soft tones of the wood, while round windows are set evenly to catch any bit of light from outside.  A bright yellow carpet extends across the floor and under a set of gleaming tables that are placed in the center of the room."],"exits":[{"to":143,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":147,"x":-60,"y":320,"z":0,"title":"Akaterina's Cassocks, First Floor","descriptions":["In contrast to the exterior of the yurt, the interior is painted mostly in muted shades of cream and beige.  The understated colors serve to rivet the customers' attention on the dozens of clerical robes for sale -- some of which are displayed on mannequins and hangers, while others are folded tidily in a chest and a cabinet sitting together.  Ropes are visible among the felt covers, holding together the sturdy lattice walls with elaborate knots."],"exits":[{"to":148,"exit":"up","move":"up"},{"to":9,"exit":"go","move":"go felted door"}],"color":"#FF0000","aliases":["Akaterina's Cassocks","Cassocks"]},
  {"id":148,"x":-60,"y":340,"z":0,"title":"Akaterina's Cassocks, Second Floor","descriptions":["In this attic-like room, bent roof poles converge overhead to form a shallow crown.  The ceiling is decorated livelily with depictions of gold-yellow pandas capering across a snowy landscape of white felt.  A pair of polished wood closets face each other, and a lone armoire stands at a farther corner."],"exits":[{"to":147,"exit":"down","move":"down"}],"color":"#FF0000"},
  {"id":149,"x":20,"y":360,"z":0,"title":"Weather Beaters, Sunny Day Showroom","descriptions":["Sheared wool carpet in hues of pale beige gives the floor the appearance of a sandy beach, making it the perfect background for the colorful merchandise displayed throughout the wagon.  Large gaethzen spheres dangle from the ceiling like fiery suns blazing on a summer's day, washing the area in bright light.  Sago palms planted in embossed earthenware pots provide living sculptures, their graceful fronds freshening the air."],"exits":[{"to":150,"exit":"east","move":"east"},{"to":8,"exit":"go","move":"go arched door"}],"color":"#FF0000","aliases":["Weather Beaters"]},
  {"id":150,"x":40,"y":360,"z":0,"title":"Weather Beaters, Rainy Day Showroom","descriptions":["Glass panels built into the wagon's roof, allow light to filter through multi-hued blue gossamer, which drapes the room.  Tiny crystals stitched to the gauzy fabric sparkle like raindrops on a stormy day.  Darkened paper-mache clouds sway from wires bolted in the ceiling, as customers move about perusing merchandise for sale.  In the corner stands a fountain, surrounded by potted ferns that fill the air with the scent of dampened foliage."],"exits":[{"to":149,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":151,"x":190,"y":360,"z":0,"title":"The Essential Sects Shop, Unity","descriptions":["A tortoiseshell pattern covering the ceiling and walls clearly delineates this area of the shop.  A faint aroma of coffee and sizzling meat wafts through the air, though there is no readily apparent source."],"exits":[{"to":49,"exit":"northwest","move":"northwest"}],"color":"#FF0000"},
  {"id":152,"x":870,"y":420,"z":0,"title":"The Crystal Pilgrim, Interior","descriptions":["A stained-glass window at the front of this large wagon reflects the bright light of lanterns and the soft glow of dozens of candles.  A thick ironwood counter fills one end of the room, while two carved pedestals and a rack rests in the center with shelving running along both side walls.  Opposite the works of glass art at the front of the wagon, a carved ironwood door is set into the heavy rear wall, with a stand and table carved from the same in either corner beside the door."],"exits":[{"to":17,"exit":"go","move":"go door"}],"color":"#FF0000","aliases":["Crystal Pilgrim"]},
  {"id":154,"x":330,"y":120,"z":0,"title":"Natural Magic, Sales Floor","descriptions":["A braided rag carpet dyed a rich verdant green covers much of the dusty plank floor, and lush flowering swags haphazardly climb the knotty pine walls, lending the cramped interior a heady floral motif.  Several birch tables and a carved sandalwood rack are clustered opposite a whitewashed sideboard positioned within easy reach of a cushioned wicker sofa.  A tall bamboo screen separates one corner from the rest of the caravan."],"exits":[{"to":11,"exit":"go","move":"go round door"},{"to":155,"exit":"go","move":"go bamboo screen"}],"color":"#FF0000","aliases":["Natural Magic"]},
  {"id":155,"x":330,"y":140,"z":0,"title":"Natural Magic, Corner Nook","descriptions":["Sheer green fabric shot with vines of gold thread hangs in swags around the room, gleaming slightly under light shed from large, suspended lanterns.  Spanning one wall is a wide shelf, a birch table centered directly beneath it.  Nestled next to the table's left front leg, a ceramic urn is nearly overshadowed.  A carved willow display stand on the opposite side of the nook holds charms on a shallow top shelf and a jewelry case on the lower shelf."],"exits":[{"to":154,"exit":"go","move":"go bamboo screen"}],"color":"#FF0000"},
  {"id":156,"x":310,"y":280,"z":0,"title":"Tisk's Wagon, Front Room","descriptions":["The low ceiling of this room might cause trouble for tall folk, but for shorter Elanthians the effect is merely cozy. Scraps of leather, bits of metal and dust bunnies the size of largish weasels compete for space on the floor, the last sent into a swirling romp whenever anyone moves about. Busy figures can be seen moving energetically behind a gauzy blue curtain that divides the wagon into two halves."],"exits":[{"to":157,"exit":"go","move":"go blue curtain"},{"to":4,"exit":"go","move":"go small door"}],"color":"#FF0000","aliases":["Tisk's Wagon"]},
  {"id":157,"x":310,"y":300,"z":0,"title":"Tisk's Wagon, Back Room","descriptions":["The back room of the wagon is even more crowded and chaotic than the front. This is somewhat surprising, since there is less furniture here and fewer items for sale. Taking up the space which merchandise does not, several Gnomish shop attendants rush about in a continual frenzy, checking on customers, going out to check stock, removing fingerprints left behind by curious customers and bumping into just about everything that crosses their path. A gauzy blue curtain leads back to the front room."],"exits":[{"to":156,"exit":"go","move":"go blue curtain"}],"color":"#FF0000"},
  {"id":158,"x":210,"y":280,"z":0,"title":"Inner Illuminations, Sales Floor","descriptions":["The interior of the wagon is surprisingly spacious, with enough room at the center for a large silverwillow carving of a regal lion.  Eerie green light emanates from wall sconces in each corner of the room, bright enough to illuminate the items on the table or stand."],"exits":[{"to":5,"exit":"go","move":"go red door"}],"color":"#FF0000","aliases":["Inner Illuminations"]},
  {"id":159,"x":270,"y":480,"z":0,"title":"Sound the Hunt, Shop Floor","descriptions":["Forked oak support poles barely carry the weight from shaggy mammoth hides draped about the tent.  Towards the tent's center, a smoldering firepit surrounded by wet shale rock fills the air with an earthy steam.  Tables made from bone and steel surround the fire, displaying many items for sale.  In the corner, an alabaster stand exhibits simpler wares.  A leather flap embroidered with an orange flame leads deeper into the tent."],"exits":[{"to":2,"exit":"go","move":"go opening"},{"to":229,"exit":"go","move":"go leather flap"}],"color":"#FF0000","aliases":["Sound the Hunt"]},
  {"id":160,"x":770,"y":480,"z":0,"title":"The Mind's Eye","descriptions":["Lengths of rich purple velvet line the walls, draping out and away from the gaethzen lamp at the tent's apex to pool on the floor with careless abandon."],"exits":[{"to":19,"exit":"go","move":"go flap"}],"color":"#FF0000","aliases":["The Mind's Eye","Mind's Eye"]},
  {"id":161,"x":710,"y":160,"z":0,"title":"The Silver Mists","descriptions":["Silver mist flows all around, obscuring everything but a luminous ethereal orb floating eerily before you."],"exits":[{"to":77,"exit":"out","move":"out"}],"color":"#FF0000"},
  {"id":162,"x":750,"y":180,"z":0,"title":"The Silver Mists","descriptions":["Silver mist flows all around, obscuring everything but a luminous ethereal orb floating eerily before you."],"exits":[{"to":79,"exit":"out","move":"out"}],"color":"#FF0000"},
  {"id":163,"x":750,"y":200,"z":0,"title":"The Silver Mists","descriptions":["Silver mist flows all around, obscuring everything but a luminous ethereal orb floating eerily before you."],"exits":[{"to":78,"exit":"out","move":"out"}],"color":"#FF0000"},
  {"id":164,"x":750,"y":220,"z":0,"title":"The Silver Mists","descriptions":["Silver mist flows all around, obscuring everything but a luminous ethereal orb floating eerily before you."],"exits":[{"to":0,"exit":"out","move":"out"}],"color":"#FF0000"},
  {"id":165,"x":710,"y":240,"z":0,"title":"The Silver Mists","descriptions":["Silver mist flows all around, obscuring everything but a luminous ethereal orb floating eerily before you."],"exits":[{"to":81,"exit":"out","move":"out"}],"color":"#FF0000"},
  {"id":166,"x":670,"y":220,"z":0,"title":"The Silver Mists","descriptions":["Silver mist flows all around, obscuring everything but a luminous ethereal orb floating eerily before you."],"exits":[{"to":82,"exit":"out","move":"out"}],"color":"#FF0000"},
  {"id":167,"x":670,"y":200,"z":0,"title":"The Silver Mists","descriptions":["Silver mist flows all around, obscuring everything but a luminous ethereal orb floating eerily before you."],"exits":[{"to":83,"exit":"out","move":"out"}],"color":"#FF0000"},
  {"id":168,"x":670,"y":180,"z":0,"title":"The Silver Mists","descriptions":["Silver mist flows all around, obscuring everything but a luminous ethereal orb floating eerily before you."],"exits":[{"to":84,"exit":"out","move":"out"}],"color":"#FF0000"},
  {"id":171,"x":950,"y":420,"z":0,"title":"Bunglefoot's Tent, Entryway","descriptions":["The dirt floor has been trampled smooth by the many feet of Bungles's previous customers.  Lopsided cabinets hug the walls near the tent flap, while mismatched tables of various sizes are scattered randomly about.  A beaded curtain covers an entryway to the north.  Several lanterns carelessly hung from the ceiling cast dancing shadows on the merchandise."],"exits":[{"to":175,"exit":"east","move":"east"},{"to":176,"exit":"west","move":"west"},{"to":18,"exit":"go","move":"go tent flap"},{"to":172,"exit":"go","move":"go beaded curtain"},{"to":18,"exit":"go","move":"go flap"}],"color":"#FF0000","aliases":["Bunglefoot"]},
  {"id":172,"x":950,"y":400,"z":0,"title":"Bunglefoot's Tent, Weapon Racks","descriptions":["Elaborate wall sconces with long-tapered candles burning merrily are carefully secured to the tent's walls.  Prisms of color reflect from the curtain beads and cast dancing shadows on the merchandise.  Several intricately carved weapon racks are discreetly exhibited in one corner, displaying the artistic craftsmanship of the artisan."],"exits":[{"to":173,"exit":"east","move":"east"},{"to":174,"exit":"west","move":"west"},{"to":171,"exit":"go","move":"go beaded curtain"}],"color":"#FF0000"},
  {"id":173,"x":970,"y":400,"z":0,"title":"Bunglefoot's Tent, Boxes","descriptions":["Miniature boxes of all shapes and sizes grace a long table along the north wall of the tent.  An opened wardrobe holds small replicas of chests and footlockers carefully detailed in various kinds of woods.  A huge wooden candelabrum hangs from the center of the ceiling with elaborately carved mahogany wax catchers that encircle the base of each lit candle."],"exits":[{"to":172,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":174,"x":930,"y":400,"z":0,"title":"Bunglefoot's Tent, Wall Hangings","descriptions":["Colorful pictures in beautiful handcrafted wooden frames are hung meticulously from brass hooks fastened to the walls.  Tall freestanding ebony candleholders holding fat candles sit in each of the four corners, lighting the room warmly."],"exits":[{"to":172,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":175,"x":970,"y":420,"z":0,"title":"Bunglefoot's Tent, More Stuff","descriptions":["A crude piece of burlap fastened with gnarled pieces of rope creates a makeshift wall, which cuts this room in half.  Numerous crates, boxes and old trunks stacked randomly in a seemingly helter-skelter fashion almost obscure a small flap carelessly ripped in the crude divider.  Dripping candles casting multifarious shadows lean precariously atop several containers stacked in the corner."],"exits":[{"to":171,"exit":"west","move":"west"},{"to":180,"exit":"go","move":"go flap"}],"color":"#FF0000"},
  {"id":176,"x":930,"y":420,"z":0,"title":"Bunglefoot's Tent, Stuff","descriptions":["Overflowing shelves of all sizes are attached crookedly to the walls.  Thick pieces of rope secured haphazardly to flimsy hooks in the ceiling hold two baskets, one of reed and one of wicker, each filled to the brim with Bunglefoot's wares.  Burning torches sputter dangerously nearby, spewing puffs of dark smoke that lazily dance around the shadowy corners."],"exits":[{"to":171,"exit":"east","move":"east"},{"to":254,"exit":"go","move":"go shadowy corner"}],"color":"#FF0000"},
  {"id":177,"x":970,"y":460,"z":0,"title":"Altared Visions, Pilgrims' Tent","descriptions":["Brightly lit candles in heavy brass holders cast wavering shadows over a glass slab, a wooden chest and an opened crate filled with many types of clerical merchandise.  Hanging over the exit, secured with a pair of twined jute cords, is a silken flap bordered with golden fringe."],"exits":[{"to":178,"exit":"southeast","move":"southeast"},{"to":18,"exit":"go","move":"go flap"}],"color":"#FF0000","aliases":["Altared Visions"]},
  {"id":178,"x":990,"y":480,"z":0,"title":"Altared Visions, Backtent","descriptions":["This corner of the itinerant shop is largely barren except for the wares for sale, only illuminated by the vestiges of candlelight seeping from the main area.  A few pilgrims mill about, polishing their badges or clicking their prayer beads."],"exits":[{"to":177,"exit":"northwest","move":"northwest"}],"color":"#FF0000"},
  {"id":179,"x":930,"y":460,"z":0,"title":"Sister Seendra's Salvation Station","descriptions":["A pathetic tin roof suspended from four lengths of misshapen sandalwood provides limited respite from the elements.  Trampled yellowed grass spans the entire perimeter of the booth, providing a subtle indication of where the walls would be were this a classier establishment.  From a stuffed bird nailed to one of the posts hangs a string of sloppily-made meerschaum beads."],"exits":[{"to":18,"exit":"go","move":"go fairegrounds"}],"color":"#FF0000","aliases":["Sister Seendra's","Seendra's"]},
  {"id":180,"x":990,"y":420,"z":0,"title":"Bunglefoot's Tent, Hidey-Hole","descriptions":["The crude divider with its torn flap has been gaily decorated with colorfully stitched appliques in various hues. Tiny racks with hanging merchandise are neatly aligned between open chests storing additional wares. A beautiful mahogany wardrobe sits in one corner next to an elaborate glass case with an intricately carved oak countertop. Hand carved wooden candelabras holding brightly burning candles are carefully placed among the vendible items."],"exits":[{"to":175,"exit":"go","move":"go small flap"}],"color":"#FF0000"},
  {"id":181,"x":490,"y":220,"z":0,"title":"Hide and Seek, Hall of Trade","descriptions":["Large murals depicting traders leading caravans through long trade routes decorate this simple room, spanning each wall as one scene melds into the next. Large gaethzen orbs hanging from the ceiling brightly showcase the wares below, illuminating every portion of the gently curving area."],"exits":[{"to":63,"exit":"go","move":"go wide archway"}],"color":"#FF0000"},
  {"id":182,"x":-60,"y":240,"z":0,"title":"All Tressed Up, Beautifully Basic","descriptions":["A braided wool rug stretches across the polished oak floor, its muted blue hue adding a touch of softness to the room.  Warm light cast from flickering oil lanterns reflects off the ebony-framed mirrors lining the otherwise bare walls, highlighting a small stand and pair of tables arranged around the center of the room."],"exits":[{"to":9,"exit":"go","move":"go oak door"}],"color":"#FF0000","aliases":["All Tressed Up"]},
  {"id":183,"x":-40,"y":280,"z":0,"title":"Vocational Grace, Atelier of the Apprentice","descriptions":["The air is faintly kissed with the sugary smell of vanilla shortbread baking. Despite the ubiquity of the raw material piles constantly being moved about by workers, there is a sense of tidiness to this hut. Directing all the activity from atop her tall stool is the shop's apprentice, carefully positioned to block access to another room -- possibly that of the craftsmaster."],"exits":[{"to":9,"exit":"go","move":"go straw door"}],"color":"#FF0000","aliases":["Vocational Grace"]},
  {"id":184,"x":430,"y":460,"z":0,"title":"Sebastien's Fine Print, Showroom","descriptions":["Well-crafted canvas has been carefully stretched and securely tied to strong poles that rise overhead and stretch to the center of the tent. Indirect light from shielded lanterns casts a cheerful glow about the curtained area. Everything within the room has been arranged to precision."],"exits":[{"to":23,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Sebastien's Fine Print"]},
  {"id":185,"x":430,"y":420,"z":0,"title":"As the Caravan Turns, Inside the Tent","descriptions":["A simple wooden framework supports the heavy canvas covering that shelters this small space from the elements.  A rich carpet has been unrolled for customers to stand upon while browsing the few wares offered, but the tent otherwise lacks any sort of decoration."],"exits":[{"to":23,"exit":"go","move":"go canvas flap"}],"color":"#FF0000","aliases":["As the Caravan Turns","Caravan Turns"]},
  {"id":187,"x":750,"y":520,"z":1,"title":"King Fade's Back Alley Bazaar","descriptions":["Wind from outside wallops the stiff canvas, causing it to creak and complain against the wooden supports holding the heavy fabric taut and upright.  Broken cobble masquerades as the shop floor underfoot and just barely serves its purpose without accumulating too much unfavorable debris.  A few weapon racks display wares for purchase, and a stenciled notice sways near the exit flap to ensure all customers read the proprietor's caveat before they leave."],"exits":[{"to":19,"exit":"go","move":"go exit flap"}],"color":"#FF0000","aliases":["King Fade's Back Alley Bazaar","King Fade"]},
  {"id":188,"x":790,"y":400,"z":0,"title":"Besieged, Atrium","descriptions":["Suspended between jewel-toned pennants overhead, gaethzen siegery figurines illuminate the grand entry hall.  Eager contestants and spectators crowd around the silversteel directory at the center of the chamber, while colorful hallways lead to separate competition galleries."],"exits":[{"to":17,"exit":"go","move":"go golden doors"},{"to":189,"exit":"north","move":"north"},{"to":190,"exit":"northeast","move":"northeast"},{"to":191,"exit":"east","move":"east"},{"to":192,"exit":"southeast","move":"southeast"},{"to":193,"exit":"south","move":"south"},{"to":194,"exit":"southwest","move":"southwest"},{"to":195,"exit":"west","move":"west"},{"to":196,"exit":"northwest","move":"northwest"},{"to":17,"exit":"go","move":"go doors"}],"color":"#FF0000","aliases":["Besieged","Siegery"]},
  {"id":189,"x":790,"y":380,"z":0,"title":"Besieged, Sapphire Gallery","descriptions":["Suspended between jewel-toned pennants overhead, gaethzen siegery figurines illuminate the competition hall.  A large circle of intricately woven rush matting is partially buried into a low sapphire-embedded glaes platform at the center of the spacious arena."],"exits":[{"to":188,"exit":"south","move":"south"}],"color":"#FF0000","aliases":["Sapphire Gallery"]},
  {"id":190,"x":810,"y":380,"z":0,"title":"Besieged, Topaz Gallery","descriptions":["Suspended between jewel-toned pennants overhead, gaethzen siegery figurines illuminate the competition hall.  A large circle of intricately woven rush matting is partially buried into a low topaz-embedded gold platform at the center of the spacious arena."],"exits":[{"to":188,"exit":"southwest","move":"southwest"}],"color":"#FF0000","aliases":["Topaz Gallery"]},
  {"id":191,"x":810,"y":400,"z":0,"title":"Besieged, Amethyst Gallery","descriptions":["Suspended between jewel-toned pennants overhead, gaethzen siegery figurines illuminate the competition hall.  A large circle of intricately woven rush matting is partially buried into a low amethyst-embedded tyrium platform at the center of the spacious arena."],"exits":[{"to":188,"exit":"west","move":"west"}],"color":"#FF0000","aliases":["Amethyst Gallery"]},
  {"id":192,"x":811,"y":421,"z":0,"title":"Besieged, Pearl Gallery","descriptions":["Suspended between jewel-toned pennants overhead, gaethzen siegery figurines illuminate the competition hall.  A large circle of intricately woven rush matting is partially buried into a low pearl-embedded kiralan platform at the center of the spacious arena."],"exits":[{"to":188,"exit":"northwest","move":"northwest"}],"color":"#FF0000","aliases":["Pearl Gallery"]},
  {"id":193,"x":790,"y":421,"z":0,"title":"Besieged, Competition Supplies","descriptions":["Suspended between jewel-toned pennants overhead, gaethzen siegery figurines illuminate the spacious showroom.  Attentive shop clerks discreetly stand next to gold, silver, and bronze display tables of neatly organized merchandise."],"exits":[{"to":188,"exit":"north","move":"north"}],"color":"#FF0000"},
  {"id":194,"x":770,"y":420,"z":0,"title":"Besieged, Diamond Gallery","descriptions":["Suspended between jewel-toned pennants overhead, gaethzen siegery figurines illuminate the competition hall.  A large circle of intricately woven rush matting is partially buried into a low diamond-embedded uthamar platform at the center of the spacious arena."],"exits":[{"to":188,"exit":"northeast","move":"northeast"}],"color":"#FF0000","aliases":["Diamond Gallery"]},
  {"id":195,"x":770,"y":400,"z":0,"title":"Besieged, Emerald Gallery","descriptions":["Suspended between jewel-toned pennants overhead, gaethzen siegery figurines illuminate the competition hall.  A large circle of intricately woven rush matting is partially buried into a low emerald-embedded tel'athi platform at the center of the spacious arena."],"exits":[{"to":188,"exit":"east","move":"east"}],"color":"#FF0000","aliases":["Emerald Gallery"]},
  {"id":196,"x":770,"y":380,"z":0,"title":"Besieged, Ruby Gallery","descriptions":["Suspended between jewel-toned pennants overhead, gaethzen siegery figurines illuminate the competition hall.  A large circle of intricately woven rush matting is partially buried into a low ruby-embedded asini platform at the center of the spacious arena."],"exits":[{"to":188,"exit":"southeast","move":"southeast"}],"color":"#FF0000","aliases":["Ruby Gallery"]},
  {"id":197,"x":910,"y":220,"z":0,"title":"Illwind & Sons Lucky Disaster Salvage Co., Crushed Caravan","descriptions":["This caravan appears to have been smashed nearly in half by an enormous falling tree.  Its deck is bowed toward the center, and its roof would have been quite open to the air were it not for a canvas tarp covering the missing third.  Broad oval cross sections show concentric rings where an embedded trunk and branches were cut away sheer to the wooden walls in order to make room in the caravan's interior.  Some whimsical -- or cruel -- merchandiser has set up tree-shaped wooden displays artfully painted in tones of precious metals, including a spiraling gold tree, a sinuous silver tree, a bowed copper tree, a curly platinum tree, and a wavy palladium tree.  A small, framed piece of embroidery hangs upon a section of undamaged wall."],"exits":[{"to":15,"exit":"go","move":"go narrow door"},{"to":198,"exit":"northeast","move":"northeast"},{"to":199,"exit":"northwest","move":"northwest"}],"color":"#FF0000","aliases":["Illwind and Sons"]},
  {"id":198,"x":930,"y":200,"z":0,"title":"Illwind & Sons Lucky Disaster Salvage Co., Burnt Caravan","descriptions":["A heavy scent of charred wood and smoked meat fills the air, and the walls of this caravan are blackened and scorched.  Above, the wooden roof is entirely burned away, the opening covered by a canvas tarp that flaps and snaps whenever a wind comes up."],"exits":[{"to":199,"exit":"west","move":"west"},{"to":197,"exit":"southwest","move":"southwest"}],"color":"#FF0000"},
  {"id":199,"x":890,"y":200,"z":0,"title":"Illwind & Sons Lucky Disaster Salvage Co., Flooded Caravan","descriptions":["The floor and walls of this unfortunate caravan are horribly warped, the planking twisted and swelled into contorted shapes by extensive water damage.  Above, the ceiling and upper walls support a fantastic garden of molds and fungi.  A gap between this caravan and the next leads to a protected inner triangle between the three, but a chain is strung up to block the gap."],"exits":[{"to":198,"exit":"east","move":"east"},{"to":197,"exit":"southeast","move":"southeast"}],"color":"#FF0000"},
  {"id":200,"x":850,"y":240,"z":1,"title":"Discreet Deceptions","descriptions":["Jewel-encrusted oil lamps glow brightly along the interior of this cramped tent, where every available space is full of mismatched finery.  Behind a large ebonwood counter sits Jaymiane, an Elothean merchant whose eyes continually scan her merchandise, a row of wooden shelves standing behind her.  The thick perfume of incense fills the room, rising on a thin wisp of smoke coming from the mouth of a carved obsidian panther supporting a display table."],"exits":[{"to":14,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Discreet Deceptions"]},
  {"id":201,"x":810,"y":240,"z":1,"title":"A Darker Shade of Night","descriptions":["A tall ebony wardrobe sits in this small hollow across from some pillars draped in a dark, silky material.  Faceted crystal sconces hold dimly glowing candles that give enough steady shine so that one can comfortably view the merchandise.  All of the lights have been positioned on one side of the room, casting the opposite corner in shadow."],"exits":[{"to":14,"exit":"go","move":"go pillars"},{"to":202,"exit":"go","move":"go alcove"}],"color":"#FF0000","aliases":["A Darker Shade of Night","Darker Shade of Night"]},
  {"id":202,"x":790,"y":220,"z":1,"title":"A Darker Shade of Night, Shadows","descriptions":["Only the faintest candlelight filters through the hollow to this darkened corner.  Leaning at an angle against the wall, a broad ebony wardrobe houses several items for sale.  Iridescent chalk on the floor has been smudged by foot traffic but still adds an underlying glimmer to the shadows."],"exits":[{"to":201,"exit":"go","move":"go main floor"}],"color":"#FF0000"},
  {"id":203,"x":200,"y":20,"z":0,"title":"Loot N Flee, Main Room","descriptions":["Canvas walls enclosing the rough plank floors billow lightly in the wind, moving slightly in tune with the exterior weather.  Scattered around the cavernous tent are a number of wooden racks, each carved in a stylized representation of an object.  Hanging from the tentpoles overhead are polished lanterns that provide lighting to better see the wares displayed."],"exits":[{"to":35,"exit":"go","move":"go tent flap"},{"to":206,"exit":"north","move":"north"}],"color":"#FF0000","aliases":["Loot N Flee"]},
  {"id":204,"x":160,"y":40,"z":0,"title":"Affair Of The Art Annex, Salesfloor","descriptions":["Hanging from the wooden sides are numerous tapestries and other wall hangings.  A line of lamps dangle from the center of the wagon, illuminating the wares for the crowds of shoppers."],"exits":[{"to":34,"exit":"go","move":"go wooden door"}],"color":"#FF0000","aliases":["Affair Of The Art Annex","Art Annex"]},
  {"id":205,"x":160,"y":60,"z":0,"title":"Two Doors Guild Fest, Main Room","descriptions":["Wide aisles allow the customers to see all sides of the merchandise on display.  Doors in all shapes and sizes hang from the ceiling, each one lit with elaborate lighting to allow any imperfections to be seen by the discriminating clientele."],"exits":[{"to":33,"exit":"go","move":"go tent flap"}],"color":"#FF0000","aliases":["Two Doors Guild Fest"]},
  {"id":206,"x":200,"y":0,"z":0,"title":"Loot N Flee, Back Room","descriptions":["Tucked into this rear alcove are a few polished wood shelves, each displaying more refined merchandise than that set forth in the main room.  Elegant lamps shine from the tent poles, letting the customers peruse the wares at their leisure."],"exits":[{"to":203,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":207,"x":610,"y":280,"z":0,"title":"Skyward Bound, Showroom","descriptions":["Feathers painted all over the inside of the stall mimic the same feathers reproduced in silk that adorn the oversized wings on display.  Perched atop a puffy white cloud made of wool in the center of the room is a S'Kra maiden dressed in a dragon costume."],"exits":[{"to":25,"exit":"go","move":"go feathery flap"}],"color":"#FF0000","aliases":["Skyward Bound"]},
  {"id":208,"x":570,"y":280,"z":0,"title":"Slice and Dice, Showroom","descriptions":["Stacked, tongue and grooved logs form the wagon's solid walls, adding a faint pine scent that lingers in the air.  Hidden within the rafters of the pitched roof are gaethzen spheres, keeping the displayed merchandise well lit no matter the time of day outside.  Braided rugs add a homey touch to the space while muffling any creaks that emanate from the wide-planked floor as customers walk though the aisles perusing the items for sale."],"exits":[{"to":25,"exit":"go","move":"go pine door"}],"color":"#FF0000","aliases":["Slice and Dice"]},
  {"id":209,"x":60,"y":260,"z":0,"title":"Sheer Beauty,  Minerals of the Mines Room","descriptions":["Clean and inviting, this spacious beauty shop reflects a magical merging of nature's beauty and versatility.  Silverwillow wood flooring and gleaming pale white walls encompass the vast room.  The large mirror affixed to the wall allows the shoppers a place to admire their beauty.  A sizeable handmade tapestry on one wall depicts a beautiful garden, while white willow furniture pieces fill the room displaying a wide variety of cosmetics and supplies.  An intricately carved door leads outside while a flame-shaped arch leads to another room."],"exits":[{"to":7,"exit":"go","move":"go willow door"},{"to":262,"exit":"go","move":"go flame-shaped arch"}],"color":"#FF0000","aliases":["Sheer Beauty"]},
  {"id":210,"x":0,"y":360,"z":1,"title":"Pirate Hideaway","descriptions":["Strung from netting that covers the roof, precisely placed tzgaa orbs provide a dim lighting to this underground area.  Dirt walls secured by boards surround the stuffy area that is littered with several surfaces.  A grimy-looking Rakash pirate keeps a close watch over the scattered wares."],"exits":[{"to":8,"exit":"climb","move":"climb tall ladder"}],"color":"#FF0000","aliases":["Pirate Hideaway"]},
  {"id":211,"x":-80,"y":280,"z":0,"title":"A Faded Tent, Somka's Skin Stylings","descriptions":["Where once grass grew in abundance, the ground has been trampled into a muddy mess with withered stalks remaining.  A curved table carries the many tools, inks, dirty rags and other supplies used in the crafting of tattoos.  A pair of chairs sits next to the table, one reclined, while a trio of gaethzen globes hang directly above."],"exits":[{"to":212,"exit":"go","move":"go stitched curtain"},{"to":9,"exit":"go","move":"go flap"}],"color":"#FF0000","aliases":["Somka's Skin Stylings","Tattoos"]},
  {"id":212,"x":-100,"y":280,"z":0,"title":"A Faded Tent, Somka's Special Stylings","descriptions":["Wooden planks provide minimal coverage from the soggy ground beneath, and the overhead lighting thankfully illuminates the places where the boards have sunk into the mud.  From time to time, an exclamation fo pain or the clatter of dropped tools filters through the thick curtain.  Functional chairs sit next to a table with the tools of the trade."],"exits":[{"to":211,"exit":"go","move":"go stitched curtain"}],"color":"#FF0000"},
  {"id":214,"x":-130,"y":200,"z":1,"title":"Behind the Fairegrounds, Clearing","descriptions":["Though removed from the primary grounds, this small clearing is still close enough to hear the sounds of excited visitors making their way from one tent to another and barkers calling out wares for sale.  The trees surrounding the clearing are slightly wilted, whether from the heat or blight is unknowable at this distance.  A collection of drab structures and seedier patrons populates this secluded area.  Some of them periodically cock their head as if listening to something in the distance."],"exits":[{"to":215,"exit":"go","move":"go stone tunnel"},{"to":216,"exit":"go","move":"go leaning structure"},{"to":217,"exit":"go","move":"go cedar doorway"},{"to":218,"exit":"go","move":"go darkened entryway"},{"to":9,"exit":"go","move":"go oversized shrub"}],"color":"#FF0000","aliases":["Behind the Fairegrounds"]},
  {"id":215,"x":-130,"y":140,"z":1,"title":"In Plain Sight","descriptions":["Painted in pale beige, the rough-hewn stone walls have a mix of anatomical charts and tailoring patterns framed upon them.  The floor is covered in a deep taupe rug marred with darker spots surrounding a garish display flanked by two mannequins."],"exits":[{"to":214,"exit":"go","move":"go exit tunnel"},{"to":219,"exit":"go","move":"go trapdoor"}],"color":"#FF0000","aliases":["In Plain Sight"]},
  {"id":216,"x":-110,"y":180,"z":1,"title":"Monastery, Repurposed Shipments","descriptions":["Stacks of crates labeled 'Hide and Seek' are packed against the walls of this area, which is little more than a windowless storage room.  Wares are set out in a rather haphazard fashion, without much rhyme or reason to their organization.  A few torches illuminate the room, flickering and casting reddish light and shadows over the clutter."],"exits":[{"to":214,"exit":"go","move":"go small archway"}],"color":"#FF0000","aliases":["Repurposed Shipments"]},
  {"id":217,"x":-160,"y":220,"z":1,"title":"The Knife's Edge, Front Room","descriptions":["Crafted from burnished cedar, this small room has a just-built smell to it, and the plain boards making up the walls look as if they were freshly nailed.  Four standing braziers light the room, one placed in each corner and lit with a pale orange glow.  Crafted more for function than appearance, a narrow door leads into another area, while an alcove off to the side is blocked off by a simple white curtain."],"exits":[{"to":214,"exit":"go","move":"go open archway"},{"to":220,"exit":"go","move":"go white curtain"},{"to":221,"exit":"go","move":"go door"}],"color":"#FF0000","aliases":["The Knife's Edge","Knife's Edge"]},
  {"id":218,"x":-180,"y":200,"z":1,"title":"Visage of Obfuscation","descriptions":["The only decoration in this small, understated room are four columns that rise in each corner and meet in the center to form an arch at their apex.  Torches burn brightly on each column, facing inward and emitting plenty of light to display the wares below."],"exits":[{"to":214,"exit":"go","move":"go narrow door"}],"color":"#FF0000","aliases":["Visage of Obfuscation"]},
  {"id":219,"x":-110,"y":140,"z":1,"title":"In Plain Sight","descriptions":["An uneven stone floor and crumbling stone walls suggest the recent addition of this extension.  A single gaethzen orb hangs from a steelsilk cord, providing a modicum of illumination.  The smell of damp masonry fills the air, and the cramped room is largely taken over by the wares for sale."],"exits":[{"to":215,"exit":"go","move":"go trapdoor"}],"color":"#FF0000"},
  {"id":220,"x":-160,"y":240,"z":1,"title":"The Knife's Edge, Alcove","descriptions":["Cramped and with barely enough room for shoppers to move, this small alcove is packed full of boxes and crates.  Wares are spread out underneath a single lantern, which flickers in the windowless alcove.  A half-unrolled red carpet lines the floor, looking like it was accidentally placed, stopping just before a plain white curtain."],"exits":[{"to":217,"exit":"go","move":"go white curtain"}],"color":"#FF0000"},
  {"id":221,"x":-140,"y":220,"z":1,"title":"The Knife's Edge, Back Room","descriptions":["Set up with deliberate care, this storage area is carefully lined from wall to wall in lush red carpeting.  Several paintings cover the walls, each of them depicting a very abstract and random pattern of brushstrokes.  Gaethzen orbs decorate the ceiling in short rows, providing plenty of light, and a small door leads back to the front room."],"exits":[{"to":217,"exit":"go","move":"go door"}],"color":"#FF0000"},
  {"id":222,"x":790,"y":80,"z":0,"title":"Inner Vision, Dusty Cellar","descriptions":["The faint light from a rusted lantern upon a dusty, carved mahogany counter reveals the rough, crumbling walls that give the darkened room the appearance of having been dug in a hurry, with no regard for integrity.  The corpse of some creature lies upon the floor in a nearby corner as several insects scuttle away from the dessicated remains."],"exits":[{"to":119,"exit":"go","move":"go narrow stairwell"}],"color":"#FF0000"},
  {"id":223,"x":-130,"y":90,"z":1,"title":"A Dirty Shack, Tattoos","descriptions":["A broken window periodically slams against the wall of the decrepit hut, which looks like it was firmly abandoned until very recently.  Shining light down into the center of the one-room house is a dim and smudged gaethzen orb, which dangles from a chain.  Pinned up haphazardly on the walls, several stained sheets depicting tattoo artwork showcase symbols on otherwise plain paper."],"exits":[{"to":224,"exit":"go","move":"go decrepit door"}],"color":"#FF0000","aliases":["A Dirty Shack","Dirty Shack"]},
  {"id":224,"x":-130,"y":110,"z":1,"title":"Jeihrem's Barrow, Entrance","descriptions":["The still of night blankets the quiet fishing village, and the fishy scent of smoke from burning oil lanterns drifts through the air.  Most of the wooden buildings stand completely dark and abandoned, although a few are lit from the interior with the muted sound of conversation coming from within.  Racks of half-preserved fish stand drying on hooks, the cloying odor mingling with the smell from the lanterns."],"exits":[{"to":223,"exit":"go","move":"go decrepit hut"}],"aliases":["Jeihrem's Barrow"],"linksTo":"Map90f_Basalt_Isle.xml"},
  {"id":226,"x":490,"y":240,"z":0,"title":"Hide and Seek, Hall of Stealth","descriptions":["Large murals depicting city streets and shadowed alleys decorate the walls of this simple room, spanning each wall as one scene melds into the next.  Dim lanterns hanging from the ceiling subtly showcase the wares below, barely lighting the gently curving area."],"exits":[{"to":63,"exit":"go","move":"go wooden door"}],"color":"#FF0000"},
  {"id":227,"x":490,"y":280,"z":0,"title":"All the Gilded Loot, Containers Aplenty","descriptions":["The silk tent walls are covered in shiny painted copper, bronze, silver, gold, and platinum coins of all denominations.  In the center of the room, perfectly round tables with gleaming milled edges display a variety of wares."],"exits":[{"to":26,"exit":"go","move":"go platinum flap"}],"color":"#FF0000","aliases":["All the Gilded Loot","Gilded Loot"]},
  {"id":228,"x":0,"y":200,"z":1,"title":"Frieden's Fabulous Frivolities","descriptions":["Understated black velvet forms the walls of this small tent, the color matching the clothing of most of its customers.  Purple glowstone spheres are placed around the wares for sale, emitting a sickly yellow light.  Dominating the majority of one wall is a sign penned in a fanciful, scrolling hand."],"exits":[{"to":10,"exit":"go","move":"go exit flap"}],"color":"#FF0000","aliases":["Frieden's Fabulous Frivolities"]},
  {"id":229,"x":290,"y":480,"z":0,"title":"Sound the Hunt, Inner Shop Floor","descriptions":["The air grows warmer in this compact and more intimate part of the tent.  Small wisps of steam from the larger room cling to the still air.  An impressive battle scene adorns a large hide draped on the back wall, above a table draped with pelts offering several items for sale.  A leather flap embroidered with a warhorn leads back to the main tent."],"exits":[{"to":159,"exit":"go","move":"go leather flap"}],"color":"#FF0000"},
  {"id":230,"x":470,"y":520,"z":0,"title":"Wagon Interior, Jisi's Raffles","descriptions":["The curving walls of the wagon are painted with an elaborate pattern of blue and green waves, swirling in bright hues that easily reflect the light of the hanging lanterns.  A wide granite counter sits upon this side of a pure white curtain dividing the cabin's interior space into two rooms, preventing the casual peruser from seeing the cache of prizes beyond."],"exits":[{"to":1,"exit":"go","move":"go door"}],"color":"#00FF00","aliases":["raffle","Jisi"]},
  {"id":231,"x":510,"y":520,"z":0,"title":"Bank of Therenborough, Festival Branch","descriptions":["Though lacking the usual protections commonly found in other banks -- metal bars separating the tellers from visitors in particular, the imposing guardsmen crowded around the entrance leave little doubt that any business conducted here is secure and that any mischief would be dealt with quickly and harshly.  A small plank crosses the gap leading into the next wagon, and a notice tacked near the opening reads Exchanges this way.  Laughter, barkers and more sounds of the festival continue outside but are somewhat muted within the banking space."],"exits":[{"to":232,"exit":"east","move":"east"},{"to":1,"exit":"go","move":"go exit"}],"color":"#00FF00"},
  {"id":232,"x":530,"y":520,"z":0,"title":"Bank of Therenborough, Festival Exchange","descriptions":["A lone attendant sits behind a desk and is flanked by a trio of sentries on either side.  Atop the desk is a single, three-wicked candle that amply illuminates the cramped space.  The walls are bare wood save for a length of thick, dark hide that covers the wagon's only window."],"exits":[{"to":231,"exit":"west","move":"west"}],"color":"#00FF00"},
  {"id":233,"x":670,"y":280,"z":0,"title":"Stamped!","descriptions":["The inside of this tent is just large enough for the wooden counter that holds racks of wooden stamps for sale. A stool is stuck in one corner, the ground around it covered with wood chips and shavings."],"exits":[],"color":"#FF0000","aliases":["Stamped"]},
  {"id":234,"x":80,"y":300,"z":0,"title":"Crimson Crane Couriers, Traveling Showroom","descriptions":["Plush carmine carpeting, oiled cedar wall panels, and elegant gaethzen lanterns create an inviting atmosphere around the long display counter that runs the length of the wagon's showroom.  An apron-clad Elothean clerk attends to the sales floor, occasionally taking up work at printing presses and paper cutters behind the service counter when called upon to fill an order."],"exits":[{"to":7,"exit":"go","move":"go wagon door"}],"color":"#FF0000","aliases":["Crimson Crane Couriers"]},
  {"id":235,"x":-20,"y":360,"z":0,"title":"The Kindled Spirit","descriptions":["The interior of this austere tent consists solely of the furnishings necessary to display the merchant's wares.  The rich scent of tobacco permeates the area, giving hint to what lies within."],"exits":[{"to":8,"exit":"go","move":"go open flap"},{"to":264,"exit":"go","move":"go wooden screen"}],"color":"#FF0000","aliases":["The Kindled Spirit","Kindled Spirit"]},
  {"id":237,"x":200,"y":80,"z":0,"title":"Guildly Floors For Thought, Simple Pleasures","descriptions":["Plain canvas walls enclose the salesfloor, which displays a number of different floors set out on the trampled ground.  Shoppers mill about, inspecting the various offerings before purchasing."],"exits":[{"to":28,"exit":"go","move":"go striped flap"}],"color":"#FF0000","aliases":["Guildly Floors for Thought"]},
  {"id":238,"x":200,"y":60,"z":0,"title":"Juicy Loot, Fruit Hoops","descriptions":["Ornate leaded glass surrounds the area with decorative floral motifs, allowing the outside light to completely immerse the shop's interior.  A raised wooden path wends its way through landscaped gardens that display a variety of colorful mosses and exotic plants, each seaming to highlight the many items available for purchase."],"exits":[{"to":33,"exit":"go","move":"go glass door"}],"color":"#FF0000","aliases":["Juicy Loot"]},
  {"id":242,"x":940,"y":290,"z":0,"title":"The Great Outdoors, Front Room","descriptions":["Tanned furs, trophy antlers and partially completed longbows dangle from the ceiling of this small shop, giving off the potent aroma of the wilderness.  Across one wall is stretched the trophy pelt of a large white hiro bear, its head expertly mounted on a brass pole nearby.  A weathered Dwarven man sits behind the rough wooden counter, seemingly ignoring you as he peruses his hunting guide through his spectacles."],"exits":[{"to":244,"exit":"north","move":"north"},{"to":245,"exit":"east","move":"east"},{"to":243,"exit":"west","move":"west"},{"to":15,"exit":"go","move":"go oak door"}],"color":"#FF0000","aliases":["Great Outdoors"]},
  {"id":243,"x":920,"y":290,"z":0,"title":"The Great Outdoors, Accessories","descriptions":["Light blue walls feature a rustic mural of painted flowers, trees, and animals in various sizes, colors, and shapes.  The smell of wildflowers and trees permeates the air within the windowless confines of the room.  Mossy green rugs cover the wooden floor."],"exits":[{"to":242,"exit":"east","move":"east"}],"color":"#FF0000"},
  {"id":244,"x":940,"y":270,"z":0,"title":"The Great Outdoors, Attire","descriptions":["Large trees of various green hues painted onto the walls create an illusion of being in a dense forest, while birch, oak, willow, and greenheart mannequins display the vast array of outdoorsy fashions.  The smell of evergreen trees permeates the air within the windowless confines of the room."],"exits":[{"to":242,"exit":"south","move":"south"}],"color":"#FF0000"},
  {"id":245,"x":960,"y":290,"z":0,"title":"The Great Outdoors, Tools and Supplies","descriptions":["Tanned furs, trophy antlers, and maps adorn the walls of this small room, giving off the potent aroma of the wilderness.  Carved oak furniture polished to accentuate the grain of the wood is used to display multiple crafting tools."],"exits":[{"to":242,"exit":"west","move":"west"}],"color":"#FF0000"},
  {"id":246,"x":890,"y":290,"z":0,"title":"Nahja's Knickknacks, Alcove","descriptions":["Shadows dance upon the walls thanks to the single lantern providing flickering illumination.  A small square table takes up the majority of space in these cramped quarters."],"exits":[{"to":115,"exit":"go","move":"go curtain"}],"color":"#FF0000"},
  {"id":247,"x":330,"y":60,"z":0,"title":"The Bardic Journey, Lorekeepers' Luggage","descriptions":["The same dark silk ceiling and scarlet walls as in the foyer continue the overall fiery theme, though the lamps here are brighter, allowing a better view of the items on display. Adding to the overall effect, the set of bookshelves against the far wall appears as sheltered niches within a rock face, carefully crafted to fit the room's atmosphere."],"exits":[{"to":125,"exit":"go","move":"go beribboned archway"}],"color":"#FF0000"},
  {"id":248,"x":350,"y":80,"z":0,"title":"The Bardic Journey, Songsworn's Supplies","descriptions":["The same dark silk ceiling and scarlet walls as in the foyer continue the overall firey theme, though the lamps here are brighter, allowing a better view of the weapons and armor on display."],"exits":[{"to":125,"exit":"go","move":"go draped doorway"}],"color":"#FF0000"},
  {"id":249,"x":350,"y":60,"z":0,"title":"The Bardic Journey, Performers' Provisions","descriptions":["The same dark silk ceiling and scarlet walls as in the foyer continue the overall fiery theme, though the lamps here are brighter, allowing a better view of the items on display. Adding to the overall effect, the set of bookshelves against the far wall appears as sheltered niches within a rock face, carefully crafted to fit the room's atmosphere."],"exits":[{"to":125,"exit":"go","move":"go dark curtain"}],"color":"#FF0000"},
  {"id":254,"x":910,"y":420,"z":0,"title":"Bunglefoot's Tent, Shadowy Corner","descriptions":["This quiet, dark corner is all but consumed by rows of shelves attached precariously to the wall, heavy with their wares. Underfoot lies a neat woven rug, while overhead hangs a sign that spins slowly on a length of twine. Voices from buyers wandering around the rest of the tent seem muffled in this cozy nook."],"exits":[{"to":176,"exit":"go","move":"go shopping area"}],"color":"#FF0000"},
  {"id":255,"x":730,"y":320,"z":0,"title":"Osgeth's, Basic Paints","descriptions":["Scattered across the floor in a haphazard fashion, makeshift rugs made from various animal furs covers the floor of this large tent. Large bamboo posts form a crude framework for leather hide walls, and spatters of dried paint have been ground into almost every surface. Sitting near the center of the room is a bamboo table with a paint-spattered sign posted by it."],"exits":[{"to":85,"exit":"go","move":"go deerhide curtain"},{"to":256,"exit":"northwest","move":""},{"to":258,"exit":"northeast","move":""}],"color":"#FF0000"},
  {"id":256,"x":710,"y":300,"z":0,"title":"Osgeth's, Savage Paints","descriptions":["Smoldering with fire within its shallow bowl, a brazier set up near the corner of the room illuminates everything in a reddish hue. Thick paints spread over the rawhide walls crudely form the image of a Barbarian warrior, his arm raised to hurl a heavy wooden spear. In front of the painting is a small table, set out with a variety of paints."],"exits":[{"to":255,"exit":"southeast","move":""},{"to":257,"exit":"northeast","move":""}],"color":"#FF0000"},
  {"id":257,"x":730,"y":280,"z":0,"title":"Osgeth's, Berserker Paints","descriptions":["A solid framework of lashed bamboo poles supports the hide walls of the large circular tent, each tightly stretched skin sewn crudely to the others. Several small lanterns set into cunningly carved cast-iron frames throw madly dancing silhouettes on the wall, reminiscent of a raging battle. Sitting in the center of the room is a large crate spattered with muted colors."],"exits":[{"to":256,"exit":"southwest","move":""},{"to":258,"exit":"southeast","move":""}],"color":"#FF0000"},
  {"id":258,"x":750,"y":300,"z":0,"title":"Osgeth's, Plunderer Paints","descriptions":["The thick tent walls slope sharply downward from the ceiling, draped heavily over bamboo posts. Oil lamps hang on large cast-iron hooks over a large crate, eliminating most of the shadows from the room. Set up near the wall is a large table full of paintsticks."],"exits":[{"to":257,"exit":"northwest","move":""},{"to":255,"exit":"southwest","move":""}],"color":"#FF0000"},
  {"id":259,"x":810,"y":60,"z":0,"title":"Inner Vision, Dark Alcove","descriptions":["Several stacks of rough-hewn crates, barrels and chests provide little more than a narrow passage through this part of the shop, seemingly where supplies are stored. A soft, golden glow radiates from a brass oil lamp upon an ornately carved counter in a far corner."],"exits":[],"color":"#FF0000"},
  {"id":260,"x":250,"y":240,"z":0,"title":"The Mighty Mage, Showroom","descriptions":["An intricately detailed fanciful mural of two Warrior Mages casting spells and a scholarly-looking Moon Mage gazing at the moons through a polished telescope covers the entire wall of the wagon. Each mage is dressed in finely crafted robes stitched with etchings and symbols that represent the elements and heavens. A short shelf, rosewood wardrobe, and tall stand sit against one wall, while a blue curtain leads to a small alcove."],"exits":[{"to":261,"exit":"go","move":"go blue curtain"},{"to":5,"exit":"go","move":"go white door"}],"color":"#FF0000","aliases":["The Mighty Mage","Mighty Mage"]},
  {"id":261,"x":270,"y":240,"z":0,"title":"The Mighty Mage, Alcove","descriptions":["An intricately detailed fanciful mural of two Warrior Mages casting spells and a scholarly-looking Moon Mage gazing at the moons through a polished telescope covers the entire wall of the wagon. Each mage is dressed in finely crafted robes stitched with etchings and symbols that represent the elements and heavens. A large shelf and a sapphire-blue counter with a jewelry box and ring tree on it have been attached to the back wall of the small alcove, each holding their respective wares for sale."],"exits":[{"to":260,"exit":"go","move":"go blue curtain"}],"color":"#FF0000"},
  {"id":262,"x":60,"y":240,"z":0,"title":"Sheer Beauty, Fire and Ice Room","descriptions":["Small and inviting, this tiny room of the shop reflects a magical merging of nature's fire and ice.  Silverwillow wood flooring and gleaming pale white walls encompass the vast space.  The large mirror affixed to the wall allows shoppers a place to admire their beauty.  A sizeable tapestry on one wall depicts majestic volcanos and frozen mountaintops rising from a vast green landscape.  At the same time, white willow furniture pieces fill the room with a large display of cosmetics and beauty supplies.  A smooth arch leads back to the shop's main room, while a dark green screen with a forest design leads into another room."],"exits":[{"to":209,"exit":"go","move":"go flame-shaped arch"},{"to":263,"exit":"go","move":"go forest-green screen"}],"color":"#FF0000"},
  {"id":263,"x":60,"y":220,"z":0,"title":"Sheer Beauty,  Into the Woods Room","descriptions":["Quiet and relaxing, this tiny room of the shop reflects the magical stillness of a deep forest.  Silverwillow wood flooring and gleaming pale white walls encompass the room.  A large mirror affixed to the wall allows the shoppers a place to admire their beauty.  A sizeable tapestry on one wall depicts a peaceful and quiet forest, while willow furniture pieces fill the room with a display of cosmetics and beauty supplies.  A forest-green screen with a forest design leads into another room."],"exits":[{"to":262,"exit":"go","move":"go forest-green screen"}],"color":"#FF0000"},
  {"id":264,"x":-40,"y":360,"z":0,"title":"The Kindled Spirit, Lounge","descriptions":["A haze of smoke permeates the still air of the covered space.  Camel hair rugs blanket the ground surrounding a portable potbellied stove placed within a circle of high-backed leather chairs.  Off in the corner of the room is a narrow sideboard covered in whiskey bottles."],"exits":[{"to":235,"exit":"go","move":"go wooden screen"}]},
  {"id":265,"x":180,"y":120,"z":0,"title":"Risty Business, Long-term Investments","descriptions":["Windowless walls of adobe are adorned with tapestries depicting warriors in ritual combat, their vibrant colors bringing the scenes to life.  Dominating the room is a gnarled khor'vela altar that showcases an impressive array of ceremonial weapons, each one meticulously crafted and ornately decorated."],"exits":[{"to":266,"exit":"south","move":"south"},{"to":27,"exit":"go","move":"go jaguar hide"}],"color":"#FF0000","aliases":["Risty Business"]},
  {"id":266,"x":180,"y":140,"z":0,"title":"Risty Business, Short-term Investments","descriptions":["The subtle aroma of incense pervades this small annex.  Shelves lining the adobe walls display a variety of artifacts, such as obsidian-tipped arrowheads and intricately designed stone knives.  Torches illuminate an altar of pale driftwood, their flickering light seeming to animate the seaglass mosaic that adorns its surface."],"exits":[{"to":265,"exit":"north","move":"north"}],"color":"#FF0000"}
 ],
