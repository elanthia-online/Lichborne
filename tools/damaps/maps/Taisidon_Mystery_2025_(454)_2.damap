{
 "format": "damap",
 "version": 1,
 "id": "514q~1",
 "name": "Taisidon Mystery 2025 (454)",
 "file": "Taisidon_Mystery.xml",
 "rooms": [
  {"id":1,"x":940,"y":300,"z":0,"title":"A'baya Esplanade, Northern Conch Walkway","descriptions":["Criss-crossed above a macawood boardwalk, festive banners flutter against a gentle sea breeze.  Shoppers stroll down the walkway, gazing about at the different sights."],"exits":[{"to":402,"exit":"south","move":"south"}]},
  {"id":2,"x":920,"y":340,"z":0,"title":"Foyer","descriptions":["Subdued lighting illuminates the tasteful wooden paneling of the room while a bevy of overstuffed furniture provides comfortable seating for those contemplating weighty choices.  Thick plush carpets in a myriad of hues cover the floor, almost totally obscuring the pale wooden planks of the flooring.  Around the walls, a number of colored archways contain magical portals that, when open, allow access to the prize rooms beyond.  A large set of double doors allows access to rooms devoted to dispenser activities while a round opening leads to the area devoted to workshops for alterations.","Lighting illuminates the room which has carpets covering the floors.  A number of colored archways contain magic portals that, when open, allow access to the prize rooms beyond.  A set of double doors allows access to the dispensers while a round opening leads to the alteration area."],"exits":[{"to":0,"exit":"go","move":"go double doors"},{"to":0,"exit":"go","move":"go round opening"},{"to":0,"exit":"go","move":"go yellow portal"},{"to":0,"exit":"go","move":"go green portal"},{"to":0,"exit":"go","move":"go blue-tiled entrance"},{"to":0,"exit":"go","move":"go return portal"},{"to":0,"exit":"go","move":"go purple archway"},{"to":0,"exit":"go","move":"go red archway"},{"to":0,"exit":"go","move":"go return portal"}],"aliases":["end loot"],"linksTo":"MT_Prize_Wings.xml"},
  {"id":3,"x":540,"y":260,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, each heavy with mottled leaves in shades of black, purple, and green.  Pools of murky water collect in muddy hollows where broken stones lie partially buried.  The narrow path, half-swallowed by creeping ferns, winds through dense undergrowth without a clear destination."],"exits":[{"to":4,"exit":"north","move":"north"},{"to":21,"exit":"northeast","move":"northeast"},{"to":22,"exit":"east","move":"east"},{"to":53,"exit":"go","move":"go small gap"}]},
  {"id":4,"x":540,"y":240,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken branches lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination."],"exits":[{"to":5,"exit":"north","move":"north"},{"to":21,"exit":"east","move":"east"},{"to":3,"exit":"south","move":"south"}]},
  {"id":5,"x":540,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken stones lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination."],"exits":[{"to":13,"exit":"north","move":"north"},{"to":20,"exit":"east","move":"east"},{"to":4,"exit":"south","move":"south"}]},
  {"id":6,"x":780,"y":300,"z":0,"title":"Jalren'rae'Taisidon, Beach","descriptions":["A small grove of trees grows alongside the lagoon, their broad sweeping branches reaching low and laden with the deep purple phofe flowers.  These perfumed blossoms are so rare that they can only be found in this one location.  The dampness that hovers over this island clings to the petals, filling the air with an intoxicating haze."],"exits":[{"to":7,"exit":"northeast","move":"northeast"},{"to":401,"exit":"south","move":"south"},{"to":0,"exit":"go","move":"go makeshift shelter"}]},
  {"id":7,"x":800,"y":280,"z":0,"title":"Jalren'rae'Taisidon, Beach","descriptions":["Freed from the protective circle of the lagoon, the surface of the sea is deceptively tranquil.  A fallen palm tree lies in the surf, battered by the incessant lapping of the waves, while nearby, where the jungle creeps up to the beach, a small pile of oyster shells draws flies under a durian tree."],"exits":[{"to":8,"exit":"northeast","move":"northeast"},{"to":6,"exit":"southwest","move":"southwest"},{"to":403,"exit":"go","move":"go thin path"}]},
  {"id":8,"x":820,"y":260,"z":0,"title":"Jalren'rae'Taisidon, Rocky Beach","descriptions":["Tropical brush and vines creep over the rocky divide between beach and jungle, seeking light and room to put down roots.  As the beach curves towards some rocky cliffs to the north, the sea works at eroding the narrowing expanse, stealing a bit of sand with each gentle wave."],"exits":[{"to":7,"exit":"southwest","move":"southwest"},{"to":9,"exit":"northwest","move":"northwest"},{"to":65,"exit":"go","move":"go sea"}]},
  {"id":9,"x":800,"y":240,"z":0,"title":"Jalren'rae'Taisidon, Rocky Beach","descriptions":["As each wave washes up on the shore it slowly erodes the face of the beach, exposing more and more of the underlying rocky feet of the cliffs to the north.  Black volcanic rocks and pink coral fragments clutter the sandy expanse between the jungle and the surf."],"exits":[{"to":10,"exit":"northeast","move":"northeast"},{"to":8,"exit":"southeast","move":"southeast"}]},
  {"id":10,"x":820,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Rocky Beach","descriptions":["Rock formations rising out of the sand make the path from the lagoon to the cliffs circuitous.  Two large stones lean against each other in mute harmony, framing the sea in a natural arch.  At the edge of the jungle, spiny fruits litter the ground under durian trees, swelling and cracking in the heat, sending a cloying rot to mix with the scent of the sea."],"exits":[{"to":11,"exit":"north","move":"north"},{"to":9,"exit":"southwest","move":"southwest"},{"to":90,"exit":"go","move":"go sandy path"}]},
  {"id":11,"x":820,"y":200,"z":0,"title":"Jalren'rae'Taisidon, Rocky Beach","descriptions":["Waves surge forcefully across the narrowing beach crashing against the foot of the volcanic rock cliffs rising overhead before being sucked back into the sea.  The jungle edges forward in what little sand remains, exposed roots recoiling from the salty water while quickly tacking in place any soil blown by the wind.  A felled durian tree, serving as a home for a few industrious sand crabs, lies across the path to a rocky point that extends into the churning surf."],"exits":[{"to":12,"exit":"northeast","move":"northeast"},{"to":10,"exit":"south","move":"south"},{"to":114,"exit":"climb","move":"climb cliffs"}]},
  {"id":12,"x":840,"y":180,"z":0,"title":"Jalren'rae'Taisidon, Rocky Point","descriptions":["The rocky point serves to break the force of the waves and halt complete erosion of the beach to the south.  Angry water churns and thrashes against the craggy foundation of this stolid bastion, intermittently filling the air with salty spray.  A semi-circular ring of cliffs to the north and volcanic rock formations rising from the bottom of the sea provide a turbulent residence for beds of oysters, as well as a challenging dive into the surf for those in search of pearls."],"exits":[{"to":11,"exit":"southwest","move":"southwest"},{"to":0,"exit":"go","move":"go lined path"}],"aliases":["Rocky Point"]},
  {"id":13,"x":540,"y":200,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken branches lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination."],"exits":[{"to":14,"exit":"east","move":"east"},{"to":20,"exit":"southeast","move":"southeast"},{"to":5,"exit":"south","move":"south"}]},
  {"id":14,"x":560,"y":200,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken stones lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination."],"exits":[{"to":15,"exit":"east","move":"east"},{"to":20,"exit":"south","move":"south"},{"to":13,"exit":"west","move":"west"}]},
