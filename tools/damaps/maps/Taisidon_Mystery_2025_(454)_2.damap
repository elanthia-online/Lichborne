  {"id":16,"x":600,"y":200,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken stones lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination."],"exits":[{"to":17,"exit":"south","move":"south"},{"to":19,"exit":"southwest","move":"southwest"},{"to":15,"exit":"west","move":"west"}]},
  {"id":17,"x":600,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken branches lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination."],"exits":[{"to":16,"exit":"north","move":"north"},{"to":18,"exit":"south","move":"south"},{"to":19,"exit":"west","move":"west"}]},
  {"id":18,"x":600,"y":240,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken stones lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination."],"exits":[{"to":17,"exit":"north","move":"north"},{"to":25,"exit":"south","move":"south"},{"to":24,"exit":"west","move":"west"}]},
  {"id":19,"x":580,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken branches lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination.  A large heap of detritus has accumulated to one side, the mishmash of downed limbs vaguely resembling a ladder."],"exits":[{"to":15,"exit":"north","move":"north"},{"to":16,"exit":"northeast","move":"northeast"},{"to":17,"exit":"east","move":"east"}]},
  {"id":20,"x":560,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken branches lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination.  A large heap of detritus has accumulated to one side, the mishmash of downed limbs vaguely resembling a ladder."],"exits":[{"to":14,"exit":"north","move":"north"},{"to":5,"exit":"west","move":"west"},{"to":13,"exit":"northwest","move":"northwest"}]},
  {"id":21,"x":560,"y":240,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken branches lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination.  A large heap of detritus has accumulated to one side, the mishmash of downed limbs vaguely resembling a ladder."],"exits":[{"to":22,"exit":"south","move":"south"},{"to":3,"exit":"southwest","move":"southwest"},{"to":4,"exit":"west","move":"west"}]},
  {"id":22,"x":560,"y":260,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken branches lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination."],"exits":[{"to":21,"exit":"north","move":"north"},{"to":23,"exit":"east","move":"east"},{"to":3,"exit":"west","move":"west"}]},
  {"id":23,"x":580,"y":260,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken stones lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination."],"exits":[{"to":24,"exit":"north","move":"north"},{"to":25,"exit":"east","move":"east"},{"to":22,"exit":"west","move":"west"}]},
  {"id":24,"x":580,"y":240,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken branches lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination.  A large heap of detritus has accumulated to one side, the mishmash of downed limbs vaguely resembling a ladder."],"exits":[{"to":18,"exit":"east","move":"east"},{"to":25,"exit":"southeast","move":"southeast"},{"to":23,"exit":"south","move":"south"}]},
  {"id":25,"x":600,"y":260,"z":0,"title":"Jalren'rae'Taisidon, Gravevine Mire","descriptions":["Massive trees with sprawling buttress roots loom overhead, their tangled limbs draped in curtains of thorny vines, heavy with mottled leaves of black, purple, and green.  Pools of murky water collect in muddy hollows where broken branches lie partly buried.  The narrow path, half-swallowed by creeping ferns, winds through the dense undergrowth without a clear destination."],"exits":[{"to":18,"exit":"north","move":"north"},{"to":23,"exit":"west","move":"west"},{"to":24,"exit":"northwest","move":"northwest"}]},
  {"id":39,"x":740,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["A towering gate looms at a break in a sturdy bamboo wall, guarding entry into the village of Teil-Minavsel.  The jungle lies not far away, closing in to the north and east and blocking off passage except to the west, where a thin trail tracks into the tangled embrace of the forest."],"exits":[{"to":40,"exit":"west","move":"west"},{"to":0,"exit":"go","move":"go bamboo gate"},{"to":282,"exit":"go","move":"go shack"},{"to":400,"exit":"east","move":"east"}],"aliases":["Wilds"]},
  {"id":40,"x":720,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["An almost imperceptible trail winds between the tropical trees and thick underbrush.  The bamboo gates of a village can be seen not far to the east, while a group of low, but steep mountains looms out of the jungle to the northeast."],"exits":[{"to":39,"exit":"east","move":"east"},{"to":41,"exit":"northwest","move":"northwest"},{"to":284,"exit":"go","move":"go building"}]},
  {"id":41,"x":700,"y":300,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["The route bends sharply here, curving around a copse of thick, thorny bushes.  The air is alive with the screeching of rainbow-colored birds and the biting sting of tropical insects."],"exits":[{"to":40,"exit":"southeast","move":"southeast"},{"to":42,"exit":"southwest","move":"southwest"}]},
  {"id":42,"x":680,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["The path to the west becomes more difficult to traverse as clinging vines drape from the tree limbs overhead, meshing with the undergrowth.  Ruts in the loamy soil indicate someone has used a wagon to transport, or at least attempt to transport, items to and from the depths of the forest."],"exits":[{"to":41,"exit":"northeast","move":"northeast"},{"to":43,"exit":"west","move":"west"},{"to":80,"exit":"go","move":"go faint track"}]},
  {"id":43,"x":660,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["The ground is steep and slippery, a rugged climb upward to the northwest.  At the crescent of the slope lies the edge of a jungle.  No sight or sound of civilization pierces the humid silence of the advancing forest."],"exits":[{"to":42,"exit":"east","move":"east"},{"to":44,"exit":"northwest","move":"northwest"}]},
  {"id":44,"x":640,"y":300,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["Gaps in the foliage allow entry into the depths of the lush tropical forest to the west.  The jungle is dark, shady and foreboding, the mingled scents of swamp water and sweet nectar breathing from deep within."],"exits":[{"to":43,"exit":"southeast","move":"southeast"},{"to":45,"exit":"go","move":"go tendril-choked thicket"}]},
  {"id":45,"x":620,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Thicket","descriptions":["A forbidding fortress of winding tendrils wraps about tree trunks and locks them in a continuous mesh, defying all but the sharpest machetes.  Not a clue exists to direct one's course.  Danger lurks behind every bush for the weary traveler."],"exits":[{"to":46,"exit":"west","move":"west"},{"to":44,"exit":"go","move":"go gap"}],"color":"#008000","aliases":["Thicket"]},
  {"id":46,"x":600,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Thicket","descriptions":["A forbidding fortress of winding tendrils wraps about tree trunks and locks them in a continuous mesh, defying all but the sharpest machetes.  Even now, the twisting vines have begun the work of reclosing the gap just created."],"exits":[{"to":45,"exit":"east","move":"east"},{"to":47,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":47,"x":580,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Thicket","descriptions":["A forbidding fortress of winding tendrils wraps about tree trunks and locks them in a continuous mesh, defying all but the sharpest machetes.  Even now, the twisting vines have begun the work of reclosing the gap just created."],"exits":[{"to":46,"exit":"east","move":"east"},{"to":48,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":48,"x":560,"y":300,"z":0,"title":"Jalren'rae'Taisidon, Thicket","descriptions":["A forbidding fortress of winding tendrils wraps about tree trunks and locks them in a continuous mesh, defying all but the sharpest machetes.  Even now, the twisting vines have begun the work of reclosing the gap just created."],"exits":[{"to":47,"exit":"southeast","move":"southeast"},{"to":49,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":49,"x":540,"y":300,"z":0,"title":"Jalren'rae'Taisidon, Thicket","descriptions":["A forbidding fortress of winding tendrils wraps about tree trunks and locks them in a continuous mesh, defying all but the sharpest machetes.  Even now, the twisting vines have begun the work of reclosing the gap just created."],"exits":[{"to":48,"exit":"east","move":"east"},{"to":50,"exit":"southwest","move":"southwest"}],"color":"#008000"},
  {"id":50,"x":520,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Thicket","descriptions":["A forbidding fortress of winding tendrils wraps about tree trunks and locks them in a continuous mesh, defying all but the sharpest machetes.  Even now, the twisting vines have begun the work of reclosing the gap just created."],"exits":[{"to":49,"exit":"northeast","move":"northeast"},{"to":51,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":51,"x":520,"y":340,"z":0,"title":"Jalren'rae'Taisidon, Thicket","descriptions":["A forbidding fortress of winding tendrils wraps about tree trunks and locks them in a continuous mesh, defying all but the sharpest machetes.  Even now, the twisting vines have begun the work of reclosing the gap just created."],"exits":[{"to":50,"exit":"north","move":"north"},{"to":52,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":52,"x":500,"y":340,"z":0,"title":"Jalren'rae'Taisidon, Thicket","descriptions":["A forbidding fortress of winding tendrils wraps about tree trunks and locks them in a continuous mesh, defying all but the sharpest machetes.  Even now, the twisting vines have begun the work of reclosing the gap just created."],"exits":[{"to":51,"exit":"east","move":"east"},{"to":53,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":53,"x":480,"y":340,"z":0,"title":"Jalren'rae'Taisidon, Thicket","descriptions":["A forbidding fortress of winding tendrils wraps about tree trunks and locks them in a continuous mesh, defying all but the sharpest machetes.  Even now, the twisting vines have begun the work of reclosing the gap just created, except for a narrow braided archway holding open a sliver of space."],"exits":[{"to":52,"exit":"east","move":"east"},{"to":54,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":54,"x":460,"y":340,"z":0,"title":"Jalren'rae'Taisidon, Thicket","descriptions":["A forbidding fortress of winding tendrils wraps about tree trunks and locks them in a continuous mesh, defying all but the sharpest machetes.  Even now, the twisting vines have begun the work of reclosing the gap just created."],"exits":[{"to":53,"exit":"east","move":"east"},{"to":55,"exit":"go","move":"go heavy undergrowth"}],"color":"#008000"},
  {"id":55,"x":440,"y":340,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["Foliage rustles and sways on every side, the constant movement obviously caused by more than merely the breeze.  Ropy vines swag from tree to tree, their origin somewhere high in the canopy.  Thick underbrush impedes movement, except to the west where a huge, deep pit plunges down into the ground."],"exits":[{"to":54,"exit":"go","move":"go dense thicket"},{"to":123,"exit":"go","move":"swing north"},{"to":129,"exit":"go","move":"swing south"}],"color":"#FFBF00"},
  {"id":65,"x":860,"y":260,"z":0,"title":"Saendalen Sea, Near Shore","descriptions":["The water splashes playfully on the rocky beach, each ebb and flow grinding the stones against each other with a rasping sound.  A glint of a fish flashes in the wake of the waves, but quickly darts out of sight.  The small rocks shift underfoot as the water continues its constant advance and retreat upon the shore."],"exits":[{"to":66,"exit":"east","move":"east"},{"to":8,"exit":"go","move":"go rocky shore"}],"aliases":["Saendalen Sea","sea"]},
  {"id":66,"x":880,"y":260,"z":0,"title":"Saendalen Sea, Rocky Shelf","descriptions":["The depth of the water suddenly increases where the rock-littered shelf underfoot ends at a sharp demarcation, and the waves swell and dip before they break to the west.  To the east, the deep water is rougher."],"exits":[{"to":67,"exit":"north","move":"north"},{"to":68,"exit":"northeast","move":"northeast"},{"to":69,"exit":"east","move":"east"},{"to":65,"exit":"west","move":"west"}],"color":"#0000FF"},
  {"id":67,"x":880,"y":240,"z":0,"title":"Saendalen Sea, Near Cliff","descriptions":["The water is deep and cold, the currents swift.  A dangerous rock cliff cuts the inlet off from the rest of the open sea, but does little to shelter it from the rough seas."],"exits":[{"to":68,"exit":"east","move":"east"},{"to":69,"exit":"southeast","move":"southeast"},{"to":66,"exit":"south","move":"south"}],"color":"#0000FF"},
  {"id":68,"x":900,"y":240,"z":0,"title":"Saendalen Sea, Deep Water","descriptions":["The farther from shore, the rougher the surf.  Huge swells of saltwater sweep any flotsam great distances in a flash, all adrift in ceaseless motion.  The size of the waves prevents further progress out to sea."],"exits":[{"to":69,"exit":"south","move":"south"},{"to":66,"exit":"southwest","move":"southwest"},{"to":67,"exit":"west","move":"west"}],"color":"#0000FF"},
  {"id":69,"x":900,"y":260,"z":0,"title":"Saendalen Sea, Deep Water","descriptions":["The farther from shore, the rougher the surf.  Huge swells of saltwater sweep any flotsam great distances in a flash, all adrift in ceaseless motion.  The size of the waves prevents further progress out to sea."],"exits":[{"to":68,"exit":"north","move":"north"},{"to":66,"exit":"west","move":"west"},{"to":67,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":80,"x":680,"y":360,"z":0,"title":"Jalren'rae'Taisidon, Seord Telga","descriptions":["Cleared of most of the debris that litters the rest of the area, the forest floor is devoid of rubble.  Mosses, herbs and fungi grow in random patches upon the ground.  Large bromeliads and creepers spiral up the massive tree trunks, hugging the bark of the tightly on their way up into the canopy above."],"exits":[{"to":81,"exit":"south","move":"south"},{"to":84,"exit":"southwest","move":"southwest"},{"to":82,"exit":"west","move":"west"},{"to":42,"exit":"go","move":"go faint track"}],"color":"#008000"},
  {"id":81,"x":680,"y":400,"z":0,"title":"Jalren'rae'Taisidon, Seord Telga","descriptions":["Immense trees of various shapes give way to a small clearing.  Bits of paving stones are strewn about the ground, more thickly around the large obsidian pillar leaning dangerously towards collapse."],"exits":[{"to":80,"exit":"north","move":"north"},{"to":83,"exit":"west","move":"west"},{"to":84,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":82,"x":640,"y":360,"z":0,"title":"Jalren'rae'Taisidon, Seord Telga","descriptions":["Dense foliage crowds close around a narrow opening, concealing it under lush greens.  The area is very difficult to navigate with rubble neatly hidden under the epiphytes and massive indigenous ferns obscuring the ground, causing a potential hazard to anyone passing through."],"exits":[{"to":80,"exit":"east","move":"east"},{"to":84,"exit":"southeast","move":"southeast"},{"to":83,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":83,"x":640,"y":400,"z":0,"title":"Jalren'rae'Taisidon, Seord Telga","descriptions":["The smell of damp earth hangs heavy upon the air in this ancient forest.  Massive trees tower high above, seemingly standing guard over the flora and fauna that consider this rainforest home.  The dense foliage of the immense trees that flourish in this wilderness creates a massive canopy high above."],"exits":[{"to":82,"exit":"north","move":"north"},{"to":84,"exit":"northeast","move":"northeast"},{"to":81,"exit":"east","move":"east"},{"to":85,"exit":"climb","move":"climb gap"}],"color":"#008000"},
  {"id":84,"x":660,"y":380,"z":0,"title":"Jalren'rae'Taisidon, Seord Telga","descriptions":["Brambles and lianas entwine about an enormous, collapsed tree.  The surface of this once proud giant has become a home for an abundance of mosses and lichens that coat its surface.  Sporadic hoots and calls echo from high above in the canopy."],"exits":[{"to":80,"exit":"northeast","move":"northeast"},{"to":81,"exit":"southeast","move":"southeast"},{"to":83,"exit":"southwest","move":"southwest"},{"to":82,"exit":"northwest","move":"northwest"}],"color":"#008000","aliases":["Seord Telga"]},
  {"id":85,"x":600,"y":400,"z":0,"title":"Jalren'rae'Taisidon, Gam Telga","descriptions":["The trees crowd closely here, blocking passage to the north and east.  A narrow gap -- nearly obstructed by roots and bracken -- leads northeast, its destination lost in the dim and damp.  The ferns here grow nearly as tall as a Gor'Tog, sheltering dark pools of standing water."],"exits":[{"to":86,"exit":"south","move":"south"},{"to":89,"exit":"southwest","move":"southwest"},{"to":88,"exit":"west","move":"west"},{"to":83,"exit":"climb","move":"climb gap"}],"color":"#008000"},
  {"id":86,"x":600,"y":440,"z":0,"title":"Jalren'rae'Taisidon, Gam Telga","descriptions":["Numerous inexplicable sounds trickle through this area of the woods.  A tangle of dreary trees marks the end of the dense forest, constructing a natural barrier barring any further passage southward."],"exits":[{"to":85,"exit":"north","move":"north"},{"to":87,"exit":"west","move":"west"},{"to":89,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":87,"x":560,"y":440,"z":0,"title":"Jalren'rae'Taisidon, Gam Telga","descriptions":["The collapsing ruins of a massive stone wall mars the forest here, blocking passage to the west and south.  Vines and creepers besiege the once-proud edifice, their roots and tendrils slowly bringing the structure to the ground.  The trees beyond the wall are darker and denser than those here, their branches splayed high above like skeletal fingers."],"exits":[{"to":88,"exit":"north","move":"north"},{"to":89,"exit":"northeast","move":"northeast"},{"to":86,"exit":"east","move":"east"}],"color":"#008000"},
  {"id":88,"x":560,"y":400,"z":0,"title":"Jalren'rae'Taisidon, Gam Telga","descriptions":["The collapsed remains of a once glorious pillar lie in ruins, knocked over by some unknown force.  Fruit-bearing plants have flourished here amongst the rubble, growing from within any crack or crevice upon the surface of the weatherworn stone."],"exits":[{"to":85,"exit":"east","move":"east"},{"to":89,"exit":"southeast","move":"southeast"},{"to":87,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":89,"x":580,"y":420,"z":0,"title":"Jalren'rae'Taisidon, Gam Telga","descriptions":["Set into the forest floor is an enormous circular slab of stone.  Four large pillars, each carved of different gemstone, have been placed in the cardinal directions.  Towering high above, they seem to push the canopy asunder, allowing for a break in the dense foliage."],"exits":[{"to":85,"exit":"northeast","move":"northeast"},{"to":86,"exit":"southeast","move":"southeast"},{"to":87,"exit":"southwest","move":"southwest"},{"to":88,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":90,"x":740,"y":240,"z":0,"title":"Emberclaw Expedition, Bonfire Pit","descriptions":["Sand-worn driftwood benches and low stumps line the central bonfire, spaced to allow easy movement.  A tall bamboo palisade borders the area, draped with long fishnets in various stages of cleaning.  The steady murmur of waves drifts from the nearby beach, carrying the tang of salt on the breeze.  Off to one side rests a sculpted stone sea turtle, its central shell scute hollowed while the surrounding plates gleam with iridescent mother-of-pearl inlay."],"exits":[{"to":93,"exit":"southwest","move":"southwest"},{"to":91,"exit":"northwest","move":"northwest"},{"to":10,"exit":"go","move":"go sandy path"}],"aliases":["bonfire"]},
  {"id":91,"x":720,"y":220,"z":0,"title":"Emberclaw Expedition, Bonfire Pit","descriptions":["Driftwood logs are arranged at the edge of an enormous bonfire, each makeshift bench weathered by wind and sea.  A tall bamboo palisade forms a protective barrier with small lanterns hung at intervals along its length.  Clusters of colorful seaglass and large white shells are wired into flower-like patterns and woven into the fence with long vines."],"exits":[{"to":92,"exit":"southwest","move":"southwest"},{"to":90,"exit":"southeast","move":"southeast"}]},
  {"id":92,"x":700,"y":240,"z":0,"title":"Emberclaw Expedition, Food and Flame","descriptions":["Tucked against the base of the cliff with the bonfire close enough for light and warmth, the ground is compacted and level, while a small sail is suspended at a strategic angle to provide some shelter over the area.  A long bamboo table and a two-high row of salt-stained crates are set along the perimeter palisade, neatly displaying goods for sale."],"exits":[{"to":91,"exit":"southeast","move":"southeast"},{"to":93,"exit":"northeast","move":"northeast"}]},
  {"id":93,"x":720,"y":260,"z":0,"title":"Emberclaw Expedition, Bonfire Beverages","descriptions":["Tables fashioned from empty barrels are shaded by colorful canvas umbrellas.  A short bar is crafted from bamboo and covered by a palm frond awning, with a collection of empty glasses on the counter awaiting a fresh beverage.  Wide pathways between tables and the bar allow patrons easy access to the central bonfire."],"exits":[{"to":92,"exit":"northwest","move":"northwest"},{"to":90,"exit":"northeast","move":"northeast"}]},
  {"id":114,"x":800,"y":180,"z":0,"title":"Jalren'rae'Taisidon, Atop the Cliff","descriptions":["Just back from the ledge, jungle brush and swampbay trees quickly become a solid wall beyond which distant mountains tower in the haze.  To the east an open ring of cliffs rises over the churning water of the sea, while the way down the cliffs to the south descends to the beach.  Birds swoop and glide through the air.  Their cries echo off the rocky walls below and mingle with the sound of the crashing waves."],"exits":[{"to":115,"exit":"northwest","move":"northwest"},{"to":11,"exit":"climb","move":"climb cliffs"}]},
  {"id":115,"x":780,"y":160,"z":0,"title":"Jalren'rae'Taisidon, Atop the Cliff","descriptions":["The cliffs preside over the churning waters far below.  Insistent jungle vegetation struggles to overgrow the narrow path, and a salty tang fills the air as the wind sweeps clear the scent of rotting durian fruit."],"exits":[{"to":116,"exit":"northeast","move":"northeast"},{"to":114,"exit":"southeast","move":"southeast"}]},
  {"id":116,"x":800,"y":140,"z":0,"title":"Jalren'rae'Taisidon, Atop the Cliff","descriptions":["Cool wind blows in off the sea only to be stifled by the impenetrable heat of the jungle.  A ledge arches out over the water far below, forming a well-suited perch from which to attempt a perilous dive into the churning surf.  Beneath the roiling waves large rock formations serve as a home to colonies of oysters."],"exits":[{"to":117,"exit":"north","move":"north"},{"to":115,"exit":"southwest","move":"southwest"},{"to":120,"exit":"go","move":"go ledge","hidden":true}],"aliases":["pearl dive"]},
  {"id":117,"x":800,"y":120,"z":0,"title":"Jalren'rae'Taisidon, Atop the Cliff","descriptions":["The thick growth of the jungle prevents further progress to the north.  Off to the east, a column of rock has cracked and split away from the rest of the cliffs, forming a solitary natural tower looming over the churning water."],"exits":[{"to":116,"exit":"south","move":"south"},{"to":118,"exit":"go","move":"go rope bridge"}]},
  {"id":118,"x":800,"y":100,"z":0,"title":"Jalren'rae'Taisidon, Atop the Cliff","descriptions":["Separated from the main cliff by a wide crack, this lonely pillar of rock faces the sea.  Neither time nor distance has slowed the jungle from advancement, and seeds carried on the wind have taken root, filling almost every surface with vines and trees.  Discarded, empty oysters shells litter the ground."],"exits":[{"to":117,"exit":"go","move":"go rope bridge"},{"to":119,"exit":"climb","move":"climb ledge"}]},
  {"id":119,"x":820,"y":100,"z":0,"title":"Saendalan Sea, Below the Cliffs","descriptions":["Jagged rock formations pierce the churning water, appearing and vanishing again beneath the swelling waves as they crash violently against the cliffs.  Below the surface, the craggy stone sentinels spread into wide columns upon which beds of oysters have formed."],"exits":[{"to":0,"exit":"down","move":"down"},{"to":118,"exit":"climb","move":"climb towering cliffs"}]},
  {"id":120,"x":820,"y":140,"z":0,"title":"Saendalaen Sea, Oyster Bed","descriptions":["Pitted and jagged rocks are twisted and contorted into surreal shapes, creating a haven for creatures of the sea, including a hearty colony of oysters which cling to the craggy surfaces.  Overhead, the depth of the water creates a deep blue ceiling that contrasts with the shell-speckled sand floor."],"exits":[{"to":121,"exit":"up","move":"up"}],"aliases":["Oyster Bed"]},
  {"id":121,"x":820,"y":120,"z":0,"title":"Saendalan Sea, Beneath the Waves","descriptions":["Brownish-green sea kelp writhes towards the surface as it dances in the turbulent water among rock formations that rise from the bottom.  A current so strong it carries everything upward prevents exploring the oyster ledges below without a deeper dive."],"exits":[{"to":119,"exit":"up","move":"up"},{"to":0,"exit":"down","move":"down"}]},
  {"id":123,"x":440,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["A family of monkeys has claimed this territory for their own.  Chitters and chatters and screeches fill the air as they go about their business high in the branches.  The monkeys are not always visible, but the swaying of the branches and vines, to say nothing of the constant din, attest to their very active presence."],"exits":[{"to":55,"exit":"none","move":"swing south"},{"to":124,"exit":"none","move":"swing west"}],"color":"#FFBF00"},
  {"id":124,"x":420,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["One of the younger trees, its trunk not quite shoulder width, succumbed to some disease and fell over a number of years ago.  Saplings have sprung up all around the large hollow log, bushes have nestled up against it, and vines have overgrown it.  The small clearing created by its demise will probably be completely gone within another generation."],"exits":[{"to":123,"exit":"none","move":"swing east"},{"to":124,"exit":"none","move":"swing west"},{"to":130,"exit":"go","move":"go large log"}],"color":"#FFBF00"},
  {"id":125,"x":400,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["Dozens of tall trees stand sentinel at the edge of an immense pit, although whether they are set to mark it or to hide it is difficult to say.  Twining vines carry bright flowers up the trunks and across from branch to branch, splashes of red and yellow and orange against the deep emerald green of the foliage."],"exits":[{"to":124,"exit":"none","move":"swing east"},{"to":126,"exit":"none","move":"swing south"}],"color":"#FFBF00"},
  {"id":126,"x":400,"y":340,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["An enormous carved rock squats here in the jungle, overgrown with vines and creepers.  The vegetation has encroached upon it from all sides, except to the east of it where a colossal pit plunges into the ground."],"exits":[{"to":125,"exit":"none","move":"swing north"},{"to":127,"exit":"none","move":"swing south"}],"color":"#FFBF00"},
  {"id":127,"x":400,"y":360,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["Huge trees draped with vines soar up to the sky, their massive trunks as wide as two caravans standing side by side.  Younger trees and sprawling bushes hide the unevenness of the ground, filling in ruts and perching on hummocks, the leaves and branches blending into each other to form a dense mass."],"exits":[{"to":126,"exit":"none","move":"swing north"},{"to":128,"exit":"none","move":"swing east"}],"color":"#FFBF00"},
  {"id":128,"x":420,"y":360,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["Birds call back and forth from their nests high in the canopy and their perches on vines and branches.  Tiny little dark birds flitter from place to place, always ready to dart away if a predator appears.  Larger birds, gaudy in their plumage of blue and orange and yellow, and huge bills of black and yellow stripes, flap more leisurely from one perch to another, their caws and screeches ringing through the jungle."],"exits":[{"to":127,"exit":"none","move":"swing west"},{"to":129,"exit":"none","move":"swing east"}],"color":"#FFBF00"},
  {"id":129,"x":440,"y":360,"z":0,"title":"Jalren'rae'Taisidon, Wilds","descriptions":["Centuries of fallen leaves, vines, branches and flowers have formed a spongy mat underfoot, a decaying record of the life of the trees and plants.  A dense, earthy scent fills the air, the ghost of the ever-dying jungle lingering to haunt, for the jungle is ever-living as well, the cycle of growing and dying rolling on into the past and future."],"exits":[{"to":128,"exit":"none","move":"swing west"},{"to":55,"exit":"none","move":"swing north"}],"color":"#FFBF00"},
  {"id":130,"x":420,"y":300,"z":0,"title":"Jalren'rae'Taisidon, Swamp","descriptions":["Towering trees, draped with eerie shrouds of moss and protruding from the surface of shallow turbid water, creates an environment of treacherous verdant beauty.  A powerful stench from a rotting tangle of grass, plants and vines pervades the air.  This watery mire continues to the north."],"exits":[{"to":131,"exit":"north","move":"north"},{"to":124,"exit":"go","move":"go large log"}],"color":"#008000"},
  {"id":131,"x":420,"y":280,"z":0,"title":"Jalren'rae'Taisidon, Swamp","descriptions":["Traveling deeper into the quagmire, the water-logged maze of old trees teem with life.  Stinging swarms of mosquitos abound and powerful snapping turtles lie partially buried in the mud.  Poisonous snakes glide along the water searching for prey while stately egrets fly over the vegetation."],"exits":[{"to":132,"exit":"northeast","move":"northeast"},{"to":130,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":132,"x":440,"y":260,"z":0,"title":"Jalren'rae'Taisidon, Swamp","descriptions":["Rotting tree trunks alive with creepy, crawling, stinging insects jut out of the muck making travel even more difficult.  Just ahead, an impassable pool of quicksand bars any further progress.  Beyond it, a rock slab rises from the water."],"exits":[{"to":131,"exit":"southwest","move":"southwest"},{"to":133,"exit":"go","move":"go bridge"}],"color":"#008000"},
  {"id":133,"x":440,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Rock Slab","descriptions":["A jagged rock slab rises high above the brackish water.  From this vantage point, the entire swamp can be surveyed.  Far to the west, the outline of a steep mountain can be seen through the forest of trees."],"exits":[{"to":134,"exit":"west","move":"west"},{"to":132,"exit":"go","move":"go bridge"}],"color":"#008000"},
  {"id":134,"x":420,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Swamp","descriptions":["A copse of majestic mangrove trees stands above the swamp on tangled roots.  Rippling water, stained by the red of the tree bark, laps at its base.  Staring down at you from a high perch on a long leafy branch is a vivid green iguana.  Just to the north the high humpbacked outline of a hummock can be seen."],"exits":[{"to":135,"exit":"north","move":"north"},{"to":133,"exit":"east","move":"east"},{"to":136,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":135,"x":420,"y":200,"z":0,"title":"Jalren'rae'Taisidon, Hummock","descriptions":["Towering trees and vines create a jungle canopy above this small patch of dry land surrounded by murky water, while flowers and plants create a lush oasis in the midst of gloom.  A graveyard hush and stillness pervade this tiny sanctuary.  A primitive statue, remarkably free of mold and dirt, stands in a small clearing."],"exits":[{"to":134,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":136,"x":400,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Swamp","descriptions":["The sickening odor of death and decay pervades the air from a rotting, ravaged body floating in the foul water.  Its face is frozen in a grisly grimace of astonishment and agony.  Buzzards circle slowly overhead waiting patiently for their prize."],"exits":[{"to":134,"exit":"east","move":"east"},{"to":137,"exit":"southeast","move":"southeast"}],"color":"#008000"},
  {"id":137,"x":420,"y":240,"z":0,"title":"Jalren'rae'Taisidon, Swamp","descriptions":["In sharp contrast to the horror found to the northwest, an open watery area filled with riotous colors from a floating garden in bloom are a delight for the senses.  Ghost orchids, swamp lilies, and water hyacinths float on the surface and fill the air with their sweet perfume.  A beautiful zebra butterfly drifts over the flowers on its long, thin wings of gold and velvet black."],"exits":[{"to":138,"exit":"southwest","move":"southwest"},{"to":136,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":138,"x":400,"y":260,"z":0,"title":"Jalren'rae'Taisidon, Swamp","descriptions":["As the floating garden thins out, sunlight streaming through the leaves of the trees reflects on the black water.  A large bullfrog sits on a floating lily pad, croaking its song.  On a nearby mudflat, an alligator guards her nest from smaller predators.  Scavenger picked bones stick out of the mire."],"exits":[{"to":137,"exit":"northeast","move":"northeast"},{"to":139,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":139,"x":400,"y":280,"z":0,"title":"Jalren'rae'Taisidon, Swamp","descriptions":["Noxious water laps against stalks of sharp-bladed saw grass causing it to be brown, dry and brittle.  In the distance, as the water freshens, it shades to a lush emerald green.  The ground gently slopes upward as the dense growth begins to thin out.  Further south, the fetid ordor of the swamp begins to improve."],"exits":[{"to":138,"exit":"north","move":"north"},{"to":140,"exit":"go","move":"go river's edge"}],"color":"#008000"},
  {"id":140,"x":334,"y":280,"z":0,"title":"Jalren'rae'Taisidon, River's Edge","descriptions":["The swamp opens to a lush forest of poplar trees crowded with ravishing blooms of purple lupine.  A gentle grassy slope ends in a high embankment overlooking a winding river cutting through the green woodland.  To the north, a seemingly endless marshland stretches to the horizon."],"exits":[{"to":141,"exit":"southeast","move":"southeast"},{"to":139,"exit":"go","move":"go swamp"}],"color":"#008000"},
  {"id":141,"x":354,"y":300,"z":0,"title":"Jalren'rae'Taisidon, River's Edge","descriptions":["A clean refreshing breeze causes the leaves of the smooth, silvery aspen trees to tremble forebodingly.  Eerie silence envelopes the surrounding area broken only by the occasional sound of gurgling water or a rustling shrub.  In the distance, far to the west, a mist-shrouded, imposing mountain peak can be seen."],"exits":[{"to":142,"exit":"southwest","move":"southwest"},{"to":140,"exit":"northwest","move":"northwest"}],"color":"#008000","aliases":["guava tree"]},
  {"id":142,"x":334,"y":320,"z":0,"title":"Jalren'rae'Taisidon, River's Edge","descriptions":["The ground gently rises to a rounded hill ending in a steep cliff overlooking the water just ahead.  Thick, sturdy grapevines entwine the trees from the forest floor to the canopy of these highland woods.  A brilliantly colored humming bird forages among the vines, its tiny wings whirring as it hovers over a flower and dips its long, slender bill into the nectar."],"exits":[{"to":141,"exit":"northeast","move":"northeast"},{"to":143,"exit":"southeast","move":"southeast"}],"color":"#008000"},
  {"id":143,"x":354,"y":340,"z":0,"title":"Jalren'rae'Taisidon, River's Edge","descriptions":["Overlooking the water, the steep cliff offers a panoramic view of the sinuously curving river and surrounding wooded hills.  The edge is loose and unstable from constant exposure to wind and rain.  Below the churning water is littered with large razor-sharp rocks."],"exits":[{"to":144,"exit":"southwest","move":"southwest"},{"to":142,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":144,"x":334,"y":360,"z":0,"title":"Jalren'rae'Taisidon, River's Edge","descriptions":["The knoll gradually descends, creating a small valley filled with vine-covered weeping willows.  Luxuriant branches drape over the murmuring river, and to the south, sunlight dapples the water around the big sandbar that has formed in a cove at the foot of the knoll.","The knoll gradually descends, creating a small valley filled with vine-covered weeping willows.  Luxuriant branches drape over the murmuring river, and to the south, moonlight dapples the water around the big sandbar that has formed in a cove at the foot of the knoll."],"exits":[{"to":143,"exit":"northeast","move":"northeast"},{"to":145,"exit":"southeast","move":"southeast"},{"to":146,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":145,"x":354,"y":380,"z":0,"title":"Jalren'rae'Taisidon, River's Edge","descriptions":["Pointed stumps of aspens, with tooth marks in them, intermingle here and there with tall poplar trees.  Wild raspberries grow in the brush near their trunks.  A splash of color is visible on the facade of an immense boulder."],"exits":[{"to":147,"exit":"south","move":"south"},{"to":144,"exit":"northwest","move":"northwest"},{"to":150,"exit":"go","move":"go clearing"}],"color":"#008000"},
  {"id":146,"x":334,"y":380,"z":0,"title":"Jalren'rae'Taisidon, Sandbar","descriptions":["Sturdy trees covered with tough, supple vines ring this sheltered cove where the river has laid down a big sandbar.  The stumps that stand here and there are unmistakeable signs that this is the best place to make and launch a raft.  The surging waters of the river race by the cove, sweeping away anything or anyone unlucky enough to be caught in the current."],"exits":[{"to":144,"exit":"north","move":"north"}],"color":"#008000","aliases":["Sandbar"]},
  {"id":147,"x":354,"y":400,"z":0,"title":"Jalren'rae'Taisidon, River's Edge","descriptions":["An industrious beaver gnaws through trunk of an aspen tree with its sharp front teeth.  Pointed stumps can be seen in every direction.  Downed poplars litter the ground.  The end of a log can just be seen being dragged down the clear sliding pathway to the southwest."],"exits":[{"to":145,"exit":"north","move":"north"},{"to":148,"exit":"southwest","move":"southwest"}],"color":"#008000"},
  {"id":148,"x":334,"y":420,"z":0,"title":"Jalren'rae'Taisidon, River's Edge","descriptions":["The forest opens to a strand of shimmering quartz sand and fragmented shells ending in the gurgling water of the shallow, gravel-bottomed shoreline.  The remnants of a wrecked raft lie slowly bleaching in the sand.  The pathway continues to the southwest."],"exits":[{"to":147,"exit":"northeast","move":"northeast"},{"to":149,"exit":"southwest","move":"southwest"}],"color":"#008000"},
  {"id":149,"x":314,"y":440,"z":0,"title":"Jalren'rae'Taisidon, River's Edge","descriptions":["Dropped logs and saplings clutter the pristine white sand of this small beach.  In a sheltered cove, just off shore, a tireless beaver makes repairs to its lodge."],"exits":[{"to":148,"exit":"northeast","move":"northeast"},{"to":152,"exit":"go","move":"go narrow path"}],"color":"#008000"},
  {"id":150,"x":414,"y":420,"z":0,"title":"Jalren'rae'Taisidon, Clearing","descriptions":["The thick jungle vegetation suddenly gives way to a small clearing.  Someone has swept the ground clean of even the smallest pebble, and placed several fist-sized stones to form a path to a primitive hut made from branches, sticks, and fronds, and topped with a roof of broad, waxy leaves of the indigenous plants."],"exits":[{"to":145,"exit":"go","move":"go opening"},{"to":151,"exit":"go","move":"go primitive hut"},{"to":176,"exit":"go","move":"go dense overgrowth"}]},
  {"id":151,"x":414,"y":400,"z":0,"title":"Jalren'rae'Taisidon, Hermit's Home","descriptions":["Only the bare essentials are present in the hut.  A sleeping mat, a simple table, and a small cooking pot are the only major furnishings in the one-room dwelling.  A light breeze passes through the gaps in the make-shift walls and an occasional gust curls the corner of a woven grass sleeping mat."],"exits":[{"to":150,"exit":"out","move":"out"}],"aliases":["Hermit's Home"]},
  {"id":152,"x":194,"y":440,"z":0,"title":"Jalren'rae'Taisidon, River Bank","descriptions":["A narrow strip along the edge of the river extends to the northwest, but away from the river bank, a tangled green wall of vines and creepers blocks any penetration into the jungle itself.  Even the jungle dwellers must find the paths few and difficult."],"exits":[{"to":153,"exit":"northwest","move":"northwest"},{"to":149,"exit":"go","move":"go small beach"}]},
  {"id":153,"x":174,"y":420,"z":0,"title":"Jalren'rae'Taisidon, River Bank","descriptions":["The living green wall of jungle stands back a ways from the river here and to the southeast.  It guards its territory like a single giant creature forbidding all entrance, yet even so, animals coming to drink have worn a path down the bankside to the river."],"exits":[{"to":154,"exit":"north","move":"north"},{"to":152,"exit":"southeast","move":"southeast"},{"to":155,"exit":"northwest","move":"northwest"}]},
  {"id":154,"x":174,"y":400,"z":0,"title":"Corsair Lagoon, The South Beach","descriptions":["This small beach, like the one to the north of the gate, offers little more than a view of the lagoon and its enclosing walls.  But from this angle, it looks like some kind of trail runs along the top of the north crater wall."],"exits":[{"to":153,"exit":"south","move":"south"},{"to":264,"exit":"go","move":"go lagoon"}],"aliases":["Corsair Lagoon"]},
  {"id":155,"x":154,"y":400,"z":0,"title":"Jalren'rae'Taisidon, Esplanade","descriptions":["Several pilings have been sunk in the muck at the edge of the lagoon and the natives have constructed a walkway using them as support.  Depending on whether the pilings found solid ground or quicksand, this walkway overhangs the water at varying heights as it continues along the rim of the lagoon."],"exits":[{"to":153,"exit":"southeast","move":"southeast"},{"to":156,"exit":"northwest","move":"northwest"}]},
  {"id":156,"x":134,"y":380,"z":0,"title":"Jalren'rae'Taisidon, Esplanade","descriptions":["Bleached-white split logs, some cracked and peeling bark from their undersides, extend into the distance with only a rope rail between a dry passage and the wet lagoon.  Every so often the walkway emits a loud creak, as if it were loosing its battle to remain above the muck."],"exits":[{"to":157,"exit":"north","move":"north"},{"to":155,"exit":"southeast","move":"southeast"}]},
  {"id":157,"x":134,"y":360,"z":0,"title":"Jalren'rae'Taisidon, Esplanade","descriptions":["Sucked into the muck below, the pilings supporting this section of the Esplanade have sunk causing it to slant downward until it is only a few inches above the waves.  Every so often a good wave smacks the pilings and sends enough spray shooting over the walkway to drench the feet of anyone unwary enough to be caught in this spot."],"exits":[{"to":158,"exit":"north","move":"north"},{"to":156,"exit":"south","move":"south"}]},
  {"id":158,"x":134,"y":340,"z":0,"title":"Jalren'rae'Taisidon, Esplanade","descriptions":["As the walkway begins to slant upwards, the rim of the lagoon reveals several scraggly bushes clinging to the rocky side despite the heat.  Perched out of reach at the top of the ledge is a grelkhur bush loaded with dark green seed pods."],"exits":[{"to":159,"exit":"northeast","move":"northeast"},{"to":157,"exit":"south","move":"south"}]},
  {"id":159,"x":154,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Esplanade","descriptions":["The scent of the Lagoon grows strong here, as its water bakes in the tropical heat causing it to release the perfume particular to a jungle watering hole.  A few monkeys screech in the surrounding trees as they cavort around swinging through the few branches that overhang the lagoon.  A loud splash caused by a coconut hitting the water imposes a sudden but brief silence."],"exits":[{"to":160,"exit":"northeast","move":"northeast"},{"to":158,"exit":"southwest","move":"southwest"}]},
  {"id":160,"x":174,"y":300,"z":0,"title":"Jalren'rae'Taisidon, Esplanade","descriptions":["A huge pile of rocks jut quite a distance into the lagoon but the pilings supporting this walkway have been set on either side of the fall allowing passage above it.  From up here, it is almost possible to grab a branch extending over the lagoon from a tree on shore."],"exits":[{"to":161,"exit":"east","move":"east"},{"to":159,"exit":"southwest","move":"southwest"}]},
  {"id":161,"x":194,"y":300,"z":0,"title":"Jalren'rae'Taisidon, Esplanade","descriptions":["Slowly the esplanade begins to slant upwards, as if retreating from the waters beneath.  A sharp angle ahead hides the direction the walkway takes.  The sheer wall that forms this part of the rim looms over small beach where a few birds splash in shallow bowls in the sand."],"exits":[{"to":160,"exit":"west","move":"west"},{"to":162,"exit":"climb","move":"climb rim"}],"color":"#FFBF00"},
  {"id":162,"x":194,"y":240,"z":0,"title":"The Lagoon, Rim of the Crater","descriptions":["The rocky rim of the crater wall rises a few feet above the crashing waves.  A crude step leading down into the lagoon makes it clear that someone comes to the water's edge here, down a trail that ascends the rim of the lagoon and wends up into the jungle."],"exits":[{"to":163,"exit":"east","move":"east"},{"to":161,"exit":"climb","move":"climb wooden esplanade"},{"to":268,"exit":"go","move":"go crude step"}],"color":"#FFBF00"},
  {"id":163,"x":214,"y":240,"z":0,"title":"The Lagoon, Rim of the Crater","descriptions":["The rocky trail descends from the jungle's vines and undergrowth onto the rim of a volcanic crater, now cooled.  The ocean has filled the crater, broken at the western end, and formed a large circular lagoon."],"exits":[{"to":164,"exit":"east","move":"east"},{"to":162,"exit":"west","move":"west"}]},
  {"id":164,"x":234,"y":240,"z":0,"title":"The Lagoon, Rim of the Crater","descriptions":["The dense jungle growth appears to thin here at the beginning of a trail leading west.  The sound of surf can be heard from that direction, and an occasional breeze brings the smell of the ocean."],"exits":[{"to":163,"exit":"west","move":"west"},{"to":165,"exit":"climb","move":"climb rocky trail"}]},
  {"id":165,"x":254,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Mountain Trail","descriptions":["A rocky trail leads toward a small range of mountains in the west.  The gleaming water of the lagoon ripples softly in the distance as the fickle ocean breeze dances over its surface."],"exits":[{"to":166,"exit":"west","move":"west"},{"to":164,"exit":"climb","move":"climb lagoon's edge"}],"color":"#993300"},
  {"id":166,"x":234,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Mountain Trail","descriptions":["Small rocks line a pathway that curves slightly to the northwest, leading to a jagged mountain cliff.  In the distance towards the eastern horizon, a faint shimmer of reflected light reveals the presence of the ocean's enduring waves."],"exits":[{"to":165,"exit":"east","move":"east"},{"to":167,"exit":"northwest","move":"northwest"}],"color":"#993300"},
  {"id":167,"x":214,"y":200,"z":0,"title":"Jalren'rae'Taisidon, Mountain Trail","descriptions":["A large wall of rock rises to the west, looming imposingly over the faint uneven trail.  Valiantly struggling to thrive in the poor soil, a small tree stands beside the path.  The sapling's roots twine about a large boulder, trying to draw what nourishment it can from the poor soil."],"exits":[{"to":166,"exit":"southeast","move":"southeast"},{"to":168,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":168,"x":194,"y":200,"z":0,"title":"Jalren'rae'Taisidon, Mountain Trail","descriptions":["To the west, the base of the jagged cliff is covered by an intricate web of cracks and small ledges, adequate holds for a skilled climber."],"exits":[{"to":167,"exit":"east","move":"east"},{"to":169,"exit":"northwest","move":"northwest"},{"to":170,"exit":"go","move":"go mountain pass"}],"color":"#993300"},
  {"id":169,"x":174,"y":180,"z":0,"title":"Jalren'ra'Taisidon, Cliff Base","descriptions":["The dark earth of the path ends abruptly at the bottom of a sheer stone cliff.  Clouds of dust rise from the face as fickle breezes dislodge loose bits of rock."],"exits":[{"to":168,"exit":"southeast","move":"southeast"},{"to":177,"exit":"climb","move":"climb cliff"}],"color":"#993300"},
  {"id":170,"x":74,"y":200,"z":0,"title":"Jalren'rae'Taisidon, Pass","descriptions":["The trail wends its way through this gap between two snow-covered mountain peaks.  Faint patches of grassland can be seen to the southeast.  Littered with huge boulders, the trail begins to slope downward."],"exits":[{"to":171,"exit":"southeast","move":"southeast"},{"to":168,"exit":"go","move":"go narrow trail"}],"color":"#993300"},
  {"id":171,"x":94,"y":220,"z":0,"title":"Jalren'rae'Taisidon, Mountain Passage","descriptions":["A narrow trail littered with scree threads its way between several large boulders.  The loose gravel makes the footing very unstable, and the jagged-edged rocks surrounding the path would make a fall less than comfortable."],"exits":[{"to":170,"exit":"northwest","move":"northwest"},{"to":172,"exit":"down","move":"down"}],"color":"#993300"},
  {"id":172,"x":94,"y":240,"z":0,"title":"Jalren'rae'Taisidon, Mountain Passage","descriptions":["A leathery rustling sound can be heard below.  The trail becomes steeper and the footing more tenuous."],"exits":[{"to":173,"exit":"southwest","move":"southwest"},{"to":171,"exit":"up","move":"up"}],"color":"#993300"},
  {"id":173,"x":74,"y":260,"z":0,"title":"Jalren'rae'Taisidon, Mountain Passage","descriptions":["Gaps and holes in the rocks create lonely moaning sounds as the wind rushes through.  Unfamiliar sounds can be heard in the distance."],"exits":[{"to":172,"exit":"northeast","move":"northeast"},{"to":174,"exit":"down","move":"down"}],"color":"#993300"},
  {"id":174,"x":74,"y":280,"z":0,"title":"Jalren'rae'Taisidon, Overlook","descriptions":["A wide opening in the rocks offers a spectacular view of a lush valley.  Thick ebongrass tall enough to hide a halfling grows as far as the eye can see.  Tall, knobby khor'vela trees dot the landscape, some growing to astonishing heights.  The savannah is teeming with life.  Several groups of heitaks graze peacefully, seemingly unaware of nearby menacing shapes weaving intricate patterns in the grass."],"exits":[{"to":173,"exit":"up","move":"up"},{"to":175,"exit":"down","move":"down"}],"color":"#993300"},
  {"id":175,"x":74,"y":300,"z":0,"title":"Jalren'rae'Taisidon, Rock Ledge","descriptions":["The steep trail ends on a wide ledge allowing a panoramic view of the entire valley.  From this vantage point, the size of the savannah is clear.  Sheer cliffs stretching into the sky border the grassy plain on all sides.  On the horizon, barely visible, a thin trail snakes up to a large, sunny plateau."],"exits":[{"to":174,"exit":"up","move":"up"},{"to":180,"exit":"climb","move":"climb rock ledge"}],"color":"#993300","aliases":["Rock Ledge"]},
  {"id":176,"x":374,"y":420,"z":0,"title":"Jalren'rae'Taisidon, Jungle Overgrowth","descriptions":["The jungle, once teeming with activity and overflowing with a cacophony of sound, is still and silent.  The moist, dank air wraps itself around everything like a smothering blanket, and muffles the sounds of creaking leather and clanking metal.  Only one direction of travel offers a convenient path and the strikingly similar foliage only serves to confuse and hinder judgement."],"exits":[{"to":0,"exit":"north","move":"north"},{"to":0,"exit":"northeast","move":"northeast"},{"to":150,"exit":"east","move":"east"},{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"south","move":"south"},{"to":0,"exit":"southwest","move":"southwest"},{"to":0,"exit":"west","move":"west"},{"to":0,"exit":"northwest","move":"northwest"},{"to":150,"exit":"go","move":"go path"}]},
  {"id":177,"x":174,"y":160,"z":0,"title":"Cliff Face","descriptions":["Blotting out the light, the broken face of the cliff rises imposingly into the sky.  A fine web of cracks and ledges creates a pathway for an experienced climber to use."],"exits":[{"to":169,"exit":"climb","move":"climb down"},{"to":178,"exit":"climb","move":"climb up"}],"color":"#FFBF00"},
  {"id":178,"x":154,"y":160,"z":0,"title":"Jalren'rae'Taisidon, Cliff Top","descriptions":["From this vantage point, the shimmering depths of the ocean lie spread out to the east.  Snow-capped mountain peaks jut high into the sky as the mountain range blocks all passage westward.  A faint path leads northward, running perilously close to the jagged edge of a steep cliff."],"exits":[{"to":179,"exit":"northeast","move":"northeast"},{"to":177,"exit":"climb","move":"climb cliff"}],"color":"#993300"},
  {"id":179,"x":174,"y":140,"z":0,"title":"Jalren'rae'Taisidon, Mountain Path","descriptions":["The rocky trail twists and turns like a snake molting its skin, rising northward to a gap between two mountain peaks.  Tall trees rise beside the path, blanketing the mountain stone with a thick cushion of brown needles.  A haunting stillness fills the air, out of place in woods which normally should be teeming with wildlife."],"exits":[{"to":256,"exit":"northeast","move":"northeast"},{"to":178,"exit":"southwest","move":"southwest"}],"color":"#993300"},
  {"id":180,"x":74,"y":620,"z":0,"title":"Jalren'rae'Taisidon, Savannah","descriptions":["Steady winds buffet the tall black grass, sending ripples along the fields like waves in an ocean of pitch.  Several young khor'vela trees protrude from the inky grass, waving to and fro in the wind."],"exits":[{"to":182,"exit":"northeast","move":"northeast"},{"to":183,"exit":"east","move":"east"},{"to":181,"exit":"southeast","move":"southeast"},{"to":175,"exit":"climb","move":"climb rock ledge"}],"color":"#008000","aliases":["Savannah"]},
  {"id":181,"x":94,"y":640,"z":0,"title":"Jalren'rae'Taisidon, Trickling Stream","descriptions":["Rivulets of sparkling water cascade down the steep, cracked rock wall enclosing the valley.  The waters collect at the base of the cliff to form a small stream flowing to the east."],"exits":[{"to":183,"exit":"north","move":"north"},{"to":185,"exit":"northeast","move":"northeast"},{"to":184,"exit":"east","move":"east"},{"to":180,"exit":"northwest","move":"northwest"}],"color":"#008000","aliases":["Stream"]},
  {"id":182,"x":94,"y":600,"z":0,"title":"Jalren'rae'Taisidon, Savannah","descriptions":["Progress through the thick grass is difficult.  The wind whistles through a small, dark opening in the canyon wall to the northeast.  The plateau looms above the fog in the distance.  Gnarled trees and bushes can be discerned, barely visible in the fog."],"exits":[{"to":187,"exit":"north","move":"north"},{"to":188,"exit":"northeast","move":"northeast"},{"to":186,"exit":"east","move":"east"},{"to":185,"exit":"southeast","move":"southeast"},{"to":183,"exit":"south","move":"south"},{"to":180,"exit":"southwest","move":"southwest"}],"color":"#008000"},
  {"id":183,"x":94,"y":620,"z":0,"title":"Jalren'rae'Taisidon, Savannah","descriptions":["The largest khor'vela in this clump is half again as thick and nearly twice as tall as the rest of the trees.  It waves ponderously in the wind, too tall and too thin to put up much of a fight."],"exits":[{"to":182,"exit":"north","move":"north"},{"to":186,"exit":"northeast","move":"northeast"},{"to":185,"exit":"east","move":"east"},{"to":184,"exit":"southeast","move":"southeast"},{"to":181,"exit":"south","move":"south"},{"to":180,"exit":"west","move":"west"}],"color":"#008000","aliases":["savannah bulls"]},
  {"id":184,"x":114,"y":640,"z":0,"title":"Jalren'rae'Taisidon, Watering Hole","descriptions":["A small clearing in the dark grass opens to reveal a clear pool.  Protected from the winds by the surrounding grass, the water is serene and glassy.  Countless sets of tracks in the soggy soil surrounding the water indicate this is a popular watering hole.  A sun-bleached ribcage laying nearby indicates this is a popular dining spot as well."],"exits":[{"to":185,"exit":"north","move":"north"},{"to":181,"exit":"west","move":"west"},{"to":183,"exit":"northwest","move":"northwest"},{"to":200,"exit":"go","move":"go rocky trail"}],"aliases":["Watering Hole"]},
  {"id":185,"x":114,"y":620,"z":0,"title":"Jalren'rae'Taisidon, Savannah","descriptions":["The khor'vela trees tower high in the sky, swaying in the constant breeze.  Scraps of bark, shed like a snake's skin, lie strewn about the base of the trees which grow clumped together in clusters of three or four."],"exits":[{"to":186,"exit":"north","move":"north"},{"to":184,"exit":"south","move":"south"},{"to":181,"exit":"southwest","move":"southwest"},{"to":183,"exit":"west","move":"west"},{"to":182,"exit":"northwest","move":"northwest"}]},
  {"id":186,"x":114,"y":600,"z":0,"title":"Jalren'rae'Taisidon, Savannah","descriptions":["In the center of the wind-swept field of thick ebongrass, the leathery swishing of the blades combines with the whistling wind to mask all but the loudest of sounds."],"exits":[{"to":188,"exit":"north","move":"north"},{"to":185,"exit":"south","move":"south"},{"to":183,"exit":"southwest","move":"southwest"},{"to":182,"exit":"west","move":"west"},{"to":187,"exit":"northwest","move":"northwest"}]},
  {"id":187,"x":94,"y":580,"z":0,"title":"Jalren'rae'Taisidon, Savannah","descriptions":["A recent rockslide has deposited a large amount of rock and debris in a huge pile.  Unfortunately, from the look of the half-chewed leg poking out of the pile, a heitak was caught unaware by the avalanche and was crushed."],"exits":[{"to":188,"exit":"east","move":"east"},{"to":186,"exit":"southeast","move":"southeast"},{"to":182,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":188,"x":114,"y":580,"z":0,"title":"Jalren'rae'Taisidon, Cave Opening","descriptions":["A dark cave mars the otherwise unblemished surface of the cliffs.  Packs of flies settle and feed on the deep, blood-stained gouges in the dirt where carcasses have been dragged into the depths of the lair.  The foul stench of death permeates the area."],"exits":[{"to":186,"exit":"south","move":"south"},{"to":182,"exit":"southwest","move":"southwest"},{"to":187,"exit":"west","move":"west"},{"to":189,"exit":"go","move":"go dark cave"}],"color":"#993300","aliases":["desumos pride"]},
  {"id":189,"x":154,"y":560,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["Scattered with bones and ravaged carcasses, this is obviously the home of a predator.  The cave reeks of decaying meat, fresh blood, and a powerful mixture of dung and urine.  A low buzzing from the wings of hundreds of flies permeates the lair, pulsing as if the sound itself were alive."],"exits":[{"to":190,"exit":"northwest","move":"northwest"},{"to":188,"exit":"go","move":"go cave's mouth"},{"to":195,"exit":"go","move":"go crooked door"}],"color":"#993300","aliases":["Cave","skulls"]},
  {"id":190,"x":134,"y":540,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["Continuing along uneven, rocky footing, the cave narrows somewhat from the area immediately inside the entrance.  Although still not at all pleasant, the air here has more of a stale scent, with only a hint of the filth preceding it.  The walls are lined with an intricate network of cobwebs so dense that they almost seem to glow a dim grey."],"exits":[{"to":189,"exit":"southeast","move":"southeast"},{"to":191,"exit":"northwest","move":"northwest"}],"aliases":["cinnamon bears"]},
  {"id":191,"x":114,"y":520,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["Making the path seem an even tighter squeeze than it actually is, pointy stone projections jut from both sides.  A tiny pool of water fills a rut in the ground, presenting a fine opportunity for the unwary to turn an ankle.  An occasional drop from somewhere above splashes into it, but the source is not visible."],"exits":[{"to":192,"exit":"north","move":"north"},{"to":190,"exit":"southeast","move":"southeast"}]},
  {"id":192,"x":114,"y":500,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["The floor dips into a shallow bowl shape.  It isn't too steep to negotiate easily, but the center is uneven due to a pile of pebbles, sticks, and bones collected there.  A faint rustling can be heard, but the acoustics of the confined area make it difficult to pinpoint the direction it comes from."],"exits":[{"to":193,"exit":"north","move":"north"},{"to":191,"exit":"south","move":"south"}]},
  {"id":193,"x":114,"y":480,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["The ground is deeply scored in two parallel tracks with splotches of a brown substance between them.  Seemingly, something heavy was dragged through here.  A shiny object glints from within a pile of rubble."],"exits":[{"to":192,"exit":"south","move":"south"},{"to":194,"exit":"northwest","move":"northwest"}]},
  {"id":194,"x":94,"y":460,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["The cave dead-ends here, going no farther to the north.  Off to one side is a badly mangled breastplate amidst the remains of a warrior who clearly lost this battle.  A few flies buzz around, although there isn't much of the body left other than the bones."],"exits":[{"to":193,"exit":"southeast","move":"southeast"},{"to":286,"exit":"go","move":"go dark opening"}]},
  {"id":195,"x":154,"y":540,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["Based on several gouges in the walls and faint traces of ore visible within them, it looks like this place was mined sometime in past.  No substantial veins can be seen now, so perhaps there is nothing left worth extracting.  There are a few lengths of rotting timber near the opening leading off to the northeast, probably the remains of braces used to prevent cave-ins."],"exits":[{"to":196,"exit":"northeast","move":"northeast"},{"to":189,"exit":"go","move":"go crooked door"}],"aliases":["giant blade spiders"]},
  {"id":196,"x":174,"y":520,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["Treading through here disturbs a thick layer of dust, making breathing difficult.  Deep furrows lined with tiny stone chips mar the rock to the sides.  A broken pick-axe leans abandoned against one wall."],"exits":[{"to":197,"exit":"north","move":"north"},{"to":195,"exit":"southwest","move":"southwest"}]},
  {"id":197,"x":174,"y":500,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["An old wheelbarrow lies overturned beside a hole in the ground.  It's not clear whether the digger found what he was looking for or just gave up, but there isn't anything in there now except dirt.  Now and then, a bit of something can be heard falling to the ground, perhaps implying that this place isn't quite stable."],"exits":[{"to":198,"exit":"north","move":"north"},{"to":196,"exit":"south","move":"south"}]},
  {"id":198,"x":174,"y":480,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["From this point northward, it no longer resembles a mining area.  The passage appears to have been burrowed rather than carefully excavated.  Although it is fairly level, the ground feels slightly unsteady and seems to be vibrating slightly."],"exits":[{"to":199,"exit":"north","move":"north"},{"to":197,"exit":"south","move":"south"}]},
  {"id":199,"x":174,"y":460,"z":0,"title":"Jalren'rae'Taisidon, Cave","descriptions":["Hard-packed mounds of dirt close off any possible progress farther north.  Aside from that, everything here looks completely natural.  A faint rustling can be heard, but what is doing it and precisely where it's coming from are not obvious."],"exits":[{"to":198,"exit":"south","move":"south"}]},
  {"id":200,"x":134,"y":600,"z":0,"title":"Jalren'rae'Taisidon, Narrow Canyon","descriptions":["The canyon is relatively wide here, boasting a pleasant lawn of close-cropped grass on each side of a stream narrow enough to jump across.  A few sturdy trees along the slick rock walls yearn upward toward the sky, their widespread limbs sheltering dense bramble thickets."],"exits":[{"to":201,"exit":"south","move":"south"},{"to":184,"exit":"go","move":"go trail"}]},
  {"id":201,"x":134,"y":620,"z":0,"title":"Jalren'rae'Taisidon, Narrow Canyon","descriptions":["Shady and cool, a stream meanders its way along the bottom of this sheltered place.  The footing here is somewhat treacherous, the haphazardly mounded rocks, rubble and scree further slickened by algae and damp.  A few hardy plants cling to the margins of the stream, while mosses and lichens paint the rock walls with extravagant greens and greys of every hue."],"exits":[{"to":200,"exit":"north","move":"north"},{"to":202,"exit":"go","move":"go rocky trail"}],"aliases":["par'i heitak"]},
  {"id":202,"x":154,"y":580,"z":0,"title":"Jalren'rae'Taisidon, Savannah","descriptions":["The remains of a medium-sized par'i heitak lie in the center of a matted circle of gore-stained grass.  Large blue-backed flies swarm overhead, as if their meal has been disturbed by the sudden presence of intruders.  To the east, a wide break in the continuous sea of grass is visible."],"exits":[{"to":203,"exit":"east","move":"east"},{"to":204,"exit":"southeast","move":"southeast"},{"to":205,"exit":"south","move":"south"},{"to":201,"exit":"go","move":"go trail"}],"aliases":["mapha arzumos"]},
  {"id":203,"x":174,"y":580,"z":0,"title":"Jalren'rae'Taisidon, Chasm Edge","descriptions":["The fissure narrows slightly here to a half-dozen paces across.  Traces of a wispy fog can be seen drifting within the dark depths of the chasm.  Across the gap a khor'vela tree grows, twisted and deformed."],"exits":[{"to":204,"exit":"south","move":"south"},{"to":205,"exit":"southwest","move":"southwest"},{"to":202,"exit":"west","move":"west"},{"to":210,"exit":"go","move":"go rope bridge"}]},
  {"id":204,"x":174,"y":600,"z":0,"title":"Jalren'rae'Taisidon, Chasm Edge","descriptions":["A gaping chasm yawns mockingly at your feet.  The steeply sloping sides are studded profusely with jagged-edged outcroppings, several stained darkly with what appears to be dried blood.  Tendrils of mist caress the bloody rocks."],"exits":[{"to":203,"exit":"north","move":"north"},{"to":206,"exit":"south","move":"south"},{"to":207,"exit":"southwest","move":"southwest"},{"to":205,"exit":"west","move":"west"},{"to":202,"exit":"northwest","move":"northwest"}]},
  {"id":205,"x":154,"y":600,"z":0,"title":"Jalren'rae'Taisidon, Savannah","descriptions":["The distant plateau looms high above you, jutting out of a thick layer of fog.  The sides of the rocky mesa are steep and cluttered with craggy outcroppings.  The top of the plateau appears to be grass covered."],"exits":[{"to":202,"exit":"north","move":"north"},{"to":203,"exit":"northeast","move":"northeast"},{"to":204,"exit":"east","move":"east"},{"to":206,"exit":"southeast","move":"southeast"},{"to":207,"exit":"south","move":"south"}]},
  {"id":206,"x":174,"y":620,"z":0,"title":"Jalren'rae'Taisidon, Chasm Edge","descriptions":["Two sets of four evenly-spaced furrows are visible in the soil.  Beginning near the edge, the claw marks end rather abruptly at the lip of the chasm.  Bloody streaks on the rocks below contrast glaringly with a bleached white heitak skull lying on a flat outcrop nearby."],"exits":[{"to":204,"exit":"north","move":"north"},{"to":208,"exit":"south","move":"south"},{"to":209,"exit":"southwest","move":"southwest"},{"to":207,"exit":"west","move":"west"},{"to":205,"exit":"northwest","move":"northwest"}]},
  {"id":207,"x":154,"y":620,"z":0,"title":"Jalren'rae'Taisidon, Savannah","descriptions":["A cluster of several tiny khor'vela saplings surround a group of dead khor'vela trees.  A scorched and blackened stump at the center of the clump marks the site of a powerful lightning strike.  Bits and pieces of what was once a majestic khor'vela litter the ground."],"exits":[{"to":205,"exit":"north","move":"north"},{"to":204,"exit":"northeast","move":"northeast"},{"to":206,"exit":"east","move":"east"},{"to":208,"exit":"southeast","move":"southeast"},{"to":209,"exit":"south","move":"south"}]},
  {"id":208,"x":174,"y":640,"z":0,"title":"Jalren'rae'Taisidon, Pit Edge","descriptions":["The fissure opens into a massive pit filled to the rim with a viscous grey-green fog.  A steady howl echoes from the unseen depths, despite the air's deathly stillness.  Wispy tendrils of fog emerge from the chasm, dragging along the edge of the gaping sinkhole like unseeing hands reaching out to explore their surroundings before sinking back into the frothing mist."],"exits":[{"to":206,"exit":"north","move":"north"},{"to":209,"exit":"west","move":"west"},{"to":207,"exit":"northwest","move":"northwest"}],"aliases":["desumos pride"]},
  {"id":209,"x":154,"y":640,"z":0,"title":"Jalren'rae'Taisidon, Savannah","descriptions":["The high walls of the canyon block the strong winds and offer temporary relief from the constant gusts.  High, craggy cliffs leap skyward, pushing out of the flat ground in a knife-sharp line."],"exits":[{"to":207,"exit":"north","move":"north"},{"to":206,"exit":"northeast","move":"northeast"},{"to":208,"exit":"east","move":"east"}]},
  {"id":210,"x":194,"y":560,"z":0,"title":"Jalren'rae'Taisidon, Mist","descriptions":["The trees and grasses of the savannah give way to a blank, lifeless wasteland of fog.  The only remaining khor'vela tree on this side of the chasm has been mutated and warped into a gnarled shadow of its former glory.  A foreboding hill rises from the mist-covered ground, a path to its summit visible in the distance."],"exits":[{"to":211,"exit":"south","move":"south"},{"to":203,"exit":"go","move":"go rope bridge"}],"color":"#FFBF00"},
  {"id":211,"x":194,"y":580,"z":0,"title":"Jalren'rae'Taisidon, Mist","descriptions":["The mist from the pit seeps slowly over the recessed lip of the canyon, covering the ground in a sickly pallor.  Almost spongy in consistency, the fog preserves your footsteps momentarily before they are slowly devoured by the crawling mist as it obliterates any trace of passage."],"exits":[{"to":210,"exit":"north","move":"north"},{"to":212,"exit":"south","move":"south"}],"color":"#FFBF00"},
  {"id":212,"x":194,"y":600,"z":0,"title":"Jalren'rae'Taisidon, Mist","descriptions":["The mist completely obscures the ground and has totally eliminated the plant life on this side of the chasm.  Emanating from the giant pit to the west, the fog seems to be creeping slowly towards the towering plateau, ominously overlooking the valley floor."],"exits":[{"to":211,"exit":"north","move":"north"},{"to":213,"exit":"southeast","move":"southeast"}],"color":"#FFBF00"},
  {"id":213,"x":214,"y":620,"z":0,"title":"Jalren'rae'Taisidon, Mist","descriptions":["Glowing blue stones flank a winding path as it twists and turns up the hillside.  The mist collects in a swirling puddle at the base of the trail and sinuous tendrils snake slowly upwards, drawn by some unknown force."],"exits":[{"to":212,"exit":"northwest","move":"northwest"},{"to":214,"exit":"go","move":"go winding path"}],"color":"#FFBF00"},
  {"id":214,"x":234,"y":640,"z":0,"title":"Jalren'rae'Taisidon, Path","descriptions":["Treacherous and winding, the path is dangerously obscured by the dense vapor oozing its way toward the summit.  The stones lining the trail shine with an eerie light, adding a sickly blue tint to the pale grey-green color of the fog."],"exits":[{"to":215,"exit":"up","move":"up"},{"to":213,"exit":"go","move":"go winding path"}],"color":"#FFBF00"},
  {"id":215,"x":234,"y":620,"z":0,"title":"Jalren'rae'Taisidon, Path","descriptions":["From this vantage point, the savannah is once again visible.  The vibrant and living grasslands contrast sharply with the desolate, fog-shrouded plain on the east side of the fissure.  The true scope and size of the gaping pit that covers the southern portion of the valley can finally be seen from this altitude.  The center of the hole is filled with churning and swirling mist illuminated from deep within by a faint glow."],"exits":[{"to":216,"exit":"northeast","move":"northeast"},{"to":214,"exit":"down","move":"down"}]},
  {"id":216,"x":254,"y":600,"z":0,"title":"Jalren'rae'Taisidon, Path","descriptions":["Traversing the plateau once again, the path narrows sharply as it passes through a large gap in the stone of the mountain itself.  The gummy vapor clings to the slick interior walls of the passage, leaving wispy traces that slowly evaporate into nothingness."],"exits":[{"to":215,"exit":"southwest","move":"southwest"},{"to":217,"exit":"northwest","move":"northwest"}]},
  {"id":217,"x":234,"y":580,"z":0,"title":"Jalren'rae'Taisidon, Summit","descriptions":["Turning sharply, the path climbs to the top of the plateau and rises suddenly out of a sea of fog.  Thick mists give way grudgingly to scraggly greyish grass, which, in turn, gives way to healthy green grass.  Bright sunlight is visible to the east."],"exits":[{"to":216,"exit":"southeast","move":"southeast"},{"to":218,"exit":"climb","move":"climb grassy plateau"}],"aliases":["crude altar"]},
  {"id":218,"x":214,"y":560,"z":0,"title":"Jalren'rae'Taisidon, Grassy Plateau","descriptions":["A grassy plateau expands eastward from the summit of the gently sloping path.  Waves of green and golden grass bend softly in the wind and lend a slightly sweet aroma to the air.  In the distance, the pale meadow yields again to dark forms that rise against the sky."],"exits":[{"to":219,"exit":"east","move":"east"},{"to":217,"exit":"climb","move":"climb misty path"}]},
  {"id":219,"x":234,"y":560,"z":0,"title":"Jalren'rae'Taisidon, Grassy Plateau","descriptions":["A buzzard perched atop a silver-flecked rock that juts from the rippling grass pecks at the fleshy remains of a small meal.  It looks up occasionally to plaintively survey the broad plateau for intruders in its domain.  Flies and tiny insects hover just above the grass humming almost inaudibly."],"exits":[{"to":220,"exit":"east","move":"east"},{"to":218,"exit":"west","move":"west"}]},
  {"id":220,"x":254,"y":560,"z":0,"title":"Jalren'rae'Taisidon, Grassy Plateau","descriptions":["Dry witchgrass crackles with every movement, and insects hum in the pollen-thick air.  A low stone hut stands to the northeast, its weather-bleached thatch a pale cap to the mushroom-like structure.  The hut's plank door stands slightly ajar."],"exits":[{"to":221,"exit":"east","move":"east"},{"to":219,"exit":"west","move":"west"},{"to":222,"exit":"go","move":"go plank door"}]},
  {"id":221,"x":274,"y":560,"z":0,"title":"Jalren'rae'Taisidon, Grassy Plateau","descriptions":["A tall arch ornately carved with totems of the Immortals stands before a neatly pruned cemetery to the east.  A low granite wall embraces the clearing, diminishing behind a weed-choked hill that rises in the center of the enclosure.  Flowering hedges line the cobbled walkway leading to the entrance."],"exits":[{"to":220,"exit":"west","move":"west"},{"to":223,"exit":"go","move":"go tall arch"}]},
  {"id":222,"x":254,"y":540,"z":0,"title":"Jalren'rae'Taisidon, Stone Hut","descriptions":["The small hut is cool and dry, the air scented with sweet and musty smells.  Mice and insects chitter in the thatching above the sparsely furnished room.  The desiccated corpse of an elderly Elothean man slumps over a book atop a desk beside the plank door, an ivory scribing quill still in his shriveled hand.  On the wall hang several crumbling parchments."],"exits":[{"to":220,"exit":"go","move":"go plank door"}],"aliases":["Stone Hut","Bertoldt"]},
  {"id":223,"x":294,"y":560,"z":0,"title":"Jalren'rae'Taisidon, Kerwaith'lyba Burial Grounds","descriptions":["Monuments and crypts of polished marble line a neatly raked gravel trail that spirals inward toward the center of the clearing, where it vanishes into the tangled overgrowth that blankets the hill.  Raevelthorn wreaths and potted oleander surround a gilded mausoleum near the trail."],"exits":[{"to":224,"exit":"south","move":"south"},{"to":221,"exit":"go","move":"go tall arch"}]},
  {"id":224,"x":294,"y":600,"z":0,"title":"Jalren'rae'Taisidon, Kerwaith'lyba Burial Grounds","descriptions":["Lead urns neatly spaced between three headstones spill over with fragrant blossoms that frame the epitaphs carved in the smooth stone.  The green lawn dotted with stones slopes toward the hill where the grass yields to a dark tangle of vines."],"exits":[{"to":223,"exit":"north","move":"north"},{"to":225,"exit":"east","move":"east"}]},
  {"id":225,"x":334,"y":600,"z":0,"title":"Jalren'rae'Taisidon, Kerwaith'lyba Burial Grounds","descriptions":["The edge of the gravel path feathers at the grassline, where violets grow beyond their once carefully kept beds.  To the north, the trail fades further into taller grass.  Larger headstones lining the trail dwarf a small bronze marker sheltered by a blooming sjarta bush and spotted with creeping lichen."],"exits":[{"to":226,"exit":"north","move":"north"},{"to":224,"exit":"west","move":"west"}]},
  {"id":226,"x":334,"y":560,"z":0,"title":"Jalren'rae'Taisidon, Kerwaith'lyba Burial Grounds","descriptions":["Weather-smoothed headstones poke through the tall grass, some leaning toward each other like bent old men having quiet conversations.  Thorny vines grow around the stones and press against the thinning trail.  A loamy scent rises from the dark patches of soil dappled with green moss.  An iron gate lies rusted open on its side in the thick overgrowth, leaving little clue as to whether it was to keep visitors out or something else inside."],"exits":[{"to":225,"exit":"south","move":"south"},{"to":227,"exit":"west","move":"west"}]},
  {"id":227,"x":314,"y":560,"z":0,"title":"Jalren'rae'Taisidon, Kerwaith'lyba Burial Grounds","descriptions":["The ground slopes sharply beneath the tangled mesh of vines and weeds arching across the trail.  Rocks jut from the broken trail that ascends to the peak, where the shrubs and vines border a circular clearing.  A ring of tall grey stones at the top of the hill rises sharply against the wide sky."],"exits":[{"to":226,"exit":"east","move":"east"},{"to":228,"exit":"go","move":"go campsite"}]},
  {"id":228,"x":314,"y":540,"z":0,"title":"Campsite","descriptions":["Rocks and foliage have been cleared to make room for the large tent that someone has set up in this area.  The heavy canvas tarps, held in place by branches, are silvery from long exposure to the elements.  Near the tent, a firepit holds scattered bits of charred wood and scorched rocks as evidence that others have passed here before."],"exits":[{"to":227,"exit":"out","move":"out"},{"to":229,"exit":"go","move":"go canvas tent"}],"aliases":["Campsite"]},
  {"id":229,"x":334,"y":520,"z":0,"title":"Campsite, Tent","descriptions":["The main area of the shelter is spare but comfortable.  Gear is stacked neatly around its perimeter -- personal items and food requiring protection from the constant threat of mildew and marauding insects take up much of the space here.  The odors of canvas and tired adventurers blend with the overriding deep green scent of the tropics."],"exits":[{"to":230,"exit":"go","move":"go threadbare tarp"},{"to":228,"exit":"go","move":"go tent flap"},{"to":231,"exit":"go","move":"go red blanket"}],"aliases":["Tent"]},
  {"id":230,"x":334,"y":540,"z":0,"title":"Tent, Sleeping Quarters","descriptions":["Layers of palm fronds line the hard packed earthen floors, while bed-rolls are placed haphazardly about the room.  The cloying scent of citrus candles and moldering canvas hangs heavy in the oppressive heat of this small and dimly lit space."],"exits":[{"to":229,"exit":"go","move":"go threadbare tarp"}]},
  {"id":231,"x":314,"y":520,"z":0,"title":"Tent, Sleeping Quarters","descriptions":["Undefinable shapes move in slithery patterns over the dank canvas walls, while the distinctive *thwap* of large insects hitting the ceiling of the tent keep up a steady staccato rhythm.  Tidy cots, each hung with its own mosquito netting, line either side of the room.  Flickering candlelight from the many insect-repelling candles set about the room give off meager light and fill the air with their pungent aroma."],"exits":[{"to":229,"exit":"go","move":"go hanging blanket"}]},
  {"id":256,"x":194,"y":120,"z":0,"title":"Jalren'rae'Taisidon, Gash","descriptions":["A deep chasm breaks the rocky surface of the path in two.  The remains of a rope bridge hang forlornly against the far side of the gash, the connecting planks reaching nearly to the bottom of the chasm.  Several trees grow at haphazard angles over the chasm, some reaching almost to the other side."],"exits":[{"to":179,"exit":"southwest","move":"southwest"}],"color":"#993300"},
  {"id":256,"x":194,"y":120,"z":0,"title":"Jalren'rae'Taisidon, Gash","descriptions":["A deep chasm breaks the rocky surface of the path in two.  The remains of a rope bridge hang forlornly against the far side of the gash, the connecting planks reaching nearly to the bottom of the chasm.  Several trees grow at haphazard angles over the chasm, some reaching almost to the other side."],"exits":[{"to":179,"exit":"southwest","move":"southwest"},{"to":257,"exit":"go","move":"go fallen tree"}],"color":"#993300"},
  {"id":257,"x":194,"y":100,"z":0,"title":"Gash, Tree Trunk","descriptions":["The bottom of the gash is cloaked in smoky shadows that occasionally belch forth noxious fumes.  The length of the tree trunk stretches across the gash to the north.  The southern edge of the chasm is within easy reach."],"exits":[{"to":258,"exit":"north","move":"north"},{"to":256,"exit":"south","move":"south"}],"color":"#FFBF00"},
  {"id":258,"x":194,"y":80,"z":0,"title":"Gash, Tree Trunk","descriptions":["The bottom of the gash is cloaked in smoky shadows that occasionally belch forth noxious fumes.  The midway point of the tree trunk lies to the north."],"exits":[{"to":257,"exit":"south","move":"south"},{"to":259,"exit":"north","move":"north"}],"color":"#FFBF00"},
  {"id":259,"x":194,"y":60,"z":0,"title":"Gash, Tree Trunk","descriptions":["The bottom of the gash is cloaked in smoky shadows that occasionally belch forth noxious fumes.  The trunk of the tree sways slightly at the midway point, unsettled by the slightest gust of wind."],"exits":[{"to":258,"exit":"south","move":"south"},{"to":260,"exit":"north","move":"north"}],"color":"#FFBF00"},
  {"id":260,"x":194,"y":40,"z":0,"title":"Gash, Tree Trunk","descriptions":["The bottom of the gash is cloaked in smoky shadows that occasionally belch forth noxious fumes.  The midway point of the tree trunk lies to the south."],"exits":[{"to":259,"exit":"south","move":"south"},{"to":261,"exit":"north","move":"north"}],"color":"#FFBF00"},
  {"id":261,"x":180,"y":20,"z":0,"title":"Gash, Tree Trunk","descriptions":["The bottom of the gash is cloaked in smoky shadows that occasionally belch forth noxious fumes.  The length of the tree trunk stretches across the gash to the south.  The northern edge of the chasm is within easy reach."],"exits":[{"to":460,"exit":"north","move":"north"}],"color":"#008000"},
  {"id":263,"x":213,"y":0,"z":0,"title":"Gash","descriptions":["The sheer walls of the gash rise to either side, several hundred feet high.  Scores of dead bodies litter the ground, their armor and weapons rusted with age.  The remains of the rope bridge stretch up the side of stone walls."],"exits":[{"to":0,"exit":"climb","move":"climb rope bridge"},{"to":460,"exit":"climb","move":"climb bridge"}],"aliases":["Gash"]},
  {"id":264,"x":294,"y":300,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["A small beach nearby offers a place to rest and regroup at the foot of the South Tower, which rises from the narrow strip to the crater rim far, far overhead.  The wall of the lagoon curves smoothly southward and westward, declining as it approaches the open western side, like the rim of a bowl tilted toward the west."],"exits":[{"to":265,"exit":"north","move":"north"},{"to":271,"exit":"west","move":"west"},{"to":272,"exit":"northwest","move":"northwest"},{"to":154,"exit":"go","move":"go beach"}],"color":"#0000FF","aliases":["Lagoon","zombie piranhas"]},
  {"id":265,"x":294,"y":280,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["Although you are directly west of the water gate, the strong outflow from the river makes swimming up to the gate itself impossible.  The same currents that aided your passage into the lagoon bar that exit."],"exits":[{"to":266,"exit":"north","move":"north"},{"to":264,"exit":"south","move":"south"},{"to":271,"exit":"southwest","move":"southwest"},{"to":272,"exit":"west","move":"west"},{"to":267,"exit":"northwest","move":"northwest"},{"to":275,"exit":"down","move":"down"}],"color":"#0000FF"},
  {"id":266,"x":294,"y":260,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["A small strip of land lies at the base of the North Tower, which looms over the little beach like the upraised arm of a giant.  The wall of the lagoon curves smoothly northward and westward at the level of the giant's forearm, sloping down toward the open western side."],"exits":[{"to":265,"exit":"south","move":"south"},{"to":272,"exit":"southwest","move":"southwest"},{"to":267,"exit":"west","move":"west"}],"color":"#0000FF"},
  {"id":267,"x":274,"y":260,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["The high crater wall stretches east and west, shielding the lagoon against northerly storms.  The faintest ribbon of green lies upon the rim high above."],"exits":[{"to":266,"exit":"east","move":"east"},{"to":265,"exit":"southeast","move":"southeast"},{"to":272,"exit":"south","move":"south"},{"to":269,"exit":"southwest","move":"southwest"},{"to":268,"exit":"west","move":"west"},{"to":274,"exit":"down","move":"down"}],"color":"#0000FF"},
  {"id":268,"x":254,"y":260,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["Here at the lowest part of the crater wall, foam washes a slim crevice just above the waterline.  Scarring on the sides of the crevice shows that something was once wedged within, perhaps as a handhold or a step to help mount to the crater's rim."],"exits":[{"to":267,"exit":"east","move":"east"},{"to":272,"exit":"southeast","move":"southeast"},{"to":269,"exit":"south","move":"south"},{"to":162,"exit":"go","move":"go small crevice"}],"color":"#0000FF"},
  {"id":269,"x":254,"y":280,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["The water at the western end of the lagoon roils like the wrath of Drogor.  The waves crash through the gap, thrown through the narrow breach in the crater wall.  Foam spins high into the air as the surf roars against the rock to either side.  Maybe a shark or dolphin could make headway against that tide, but nothing with legs could do it."],"exits":[{"to":268,"exit":"north","move":"north"},{"to":267,"exit":"northeast","move":"northeast"},{"to":272,"exit":"east","move":"east"},{"to":271,"exit":"southeast","move":"southeast"},{"to":270,"exit":"south","move":"south"},{"to":277,"exit":"down","move":"down"}],"color":"#0000FF"},
  {"id":270,"x":254,"y":300,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["The crater wall rises high and straight from the water, curving to the north.  It may not be smooth as glass, but it is sheer enough to defeat any attempt, no matter how skillful, aided only by bare hands."],"exits":[{"to":269,"exit":"north","move":"north"},{"to":272,"exit":"northeast","move":"northeast"},{"to":271,"exit":"east","move":"east"}],"color":"#0000FF"},
  {"id":271,"x":274,"y":300,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["The forbiddingly high crater wall stretches east and west, a bastion that protects the lagoon against southerly storms.  Hardly a seam or crack mars the black surface, which looks almost polished, reflecting light deep into the water."],"exits":[{"to":272,"exit":"north","move":"north"},{"to":265,"exit":"northeast","move":"northeast"},{"to":264,"exit":"east","move":"east"},{"to":270,"exit":"west","move":"west"},{"to":269,"exit":"northwest","move":"northwest"},{"to":276,"exit":"down","move":"down"}],"color":"#0000FF"},
  {"id":272,"x":274,"y":280,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["Here in the center of the lagoon, shoved back and forth by wayward currents, one could appreciate the exactness of nature's architecture, if the waves left any time for contemplation.  These waves that exhaust and defeat the swimmer would scarcely bother a ship sheltered from the ocean storm in this generous harbor."],"exits":[{"to":267,"exit":"north","move":"north"},{"to":266,"exit":"northeast","move":"northeast"},{"to":265,"exit":"east","move":"east"},{"to":264,"exit":"southeast","move":"southeast"},{"to":271,"exit":"south","move":"south"},{"to":270,"exit":"southwest","move":"southwest"},{"to":269,"exit":"west","move":"west"},{"to":268,"exit":"northwest","move":"northwest"},{"to":273,"exit":"down","move":"down"}],"color":"#0000FF"},
  {"id":273,"x":274,"y":360,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["Currents sweep and swirl from every direction here at the heart of the lagoon.  A bird in a storm must feel the same helplessness before vast and impersonal powers that take no more notice of a man than of a minnow."],"exits":[{"to":274,"exit":"north","move":"north"},{"to":275,"exit":"east","move":"east"},{"to":276,"exit":"south","move":"south"},{"to":277,"exit":"west","move":"west"},{"to":272,"exit":"up","move":"up"}],"color":"#0000FF"},
  {"id":274,"x":274,"y":340,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["Oysters have colonized a crease or wrinkle in the bottom of the crater, patiently opening and closing in a unison of mindless feeding.  No doubt they hold their own mysteries within their unknown purpose, like a lustrous pearl inside a dark shell."],"exits":[{"to":275,"exit":"southeast","move":"southeast"},{"to":273,"exit":"south","move":"south"},{"to":277,"exit":"southwest","move":"southwest"},{"to":267,"exit":"up","move":"up"}],"color":"#0000FF"},
  {"id":275,"x":294,"y":360,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["The base of the towers and the lower grill waver dimly through the water to the east.  A few plants on the floor of the lagoon find an insecure hold in pockets of silt caught within the rubble."],"exits":[{"to":276,"exit":"southwest","move":"southwest"},{"to":273,"exit":"west","move":"west"},{"to":274,"exit":"northwest","move":"northwest"},{"to":265,"exit":"up","move":"up"},{"to":278,"exit":"down","move":"down"}],"color":"#0000FF"},
  {"id":276,"x":274,"y":380,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["Far below in the blue-green waters of the lagoon, some curious objects are just visible: a series of perfectly round boulders.  These frozen bubbles are a mute witness to the long-forgotten birth of the island in fire and smoke when it rose from the sea in layer upon layer of ash and lava."],"exits":[{"to":273,"exit":"north","move":"north"},{"to":275,"exit":"northeast","move":"northeast"},{"to":277,"exit":"south","move":"south"},{"to":277,"exit":"northwest","move":"northwest"},{"to":271,"exit":"up","move":"up"}],"color":"#0000FF"},
  {"id":277,"x":254,"y":360,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["Sea water surges through the gap in the crater rim, making any further westward movement impossible.  A swimmer beyond that gap would risk being battered to death against the crater walls by wave after crashing wave.  The salt water is cleaner, though, and the rubble on the bottom is clearly visible."],"exits":[{"to":274,"exit":"northeast","move":"northeast"},{"to":273,"exit":"east","move":"east"},{"to":276,"exit":"southeast","move":"southeast"},{"to":269,"exit":"up","move":"up"}],"color":"#0000FF"},
  {"id":278,"x":294,"y":420,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["Outside the grill, the strong flow of the river has scoured the bottom clean, and rocks fallen from the crater walls cover the basin floor.  Silt in the water makes it hard to see in any direction, and the current flows powerfully westward."],"exits":[{"to":279,"exit":"west","move":"west"},{"to":275,"exit":"up","move":"up"}],"color":"#0000FF"},
  {"id":279,"x":274,"y":420,"z":0,"title":"Corsair Lagoon, In the Lagoon","descriptions":["The force of the current is checked dramatically as tide and stream strive for mastery.  The ocean pushes its way toward shore one moment only to be pushed back by the river in the next.  The muddy flow from the river still clouds the water, obscuring vision in every direction."],"exits":[{"to":278,"exit":"east","move":"east"},{"to":273,"exit":"up","move":"up"}],"color":"#0000FF"},
  {"id":282,"x":740,"y":290,"z":0,"title":"Once Fine Cutlery, Front Room","descriptions":["Surrounded by walls covered with gouges and nicks, the dusty sales floor stretches across the room and is littered with broken cutlery and shattered flatware.  A few cabinets that likely once displayed the wares stand bare and empty, their doors either broken or left ajar."],"exits":[{"to":39,"exit":"go","move":"go door"},{"to":283,"exit":"go","move":"go hatch"}]},
  {"id":283,"x":750,"y":290,"z":0,"title":"Once Fine Cutlery, Storage","descriptions":["A minefield of glass and ceramic litters the floor as far as the eye can see.  A thin layer of dust rests atop the majority of the broken furniture, as though nothing has been disturbed for some time.  The faint smell of sulfur fills the room, drawing the eye towards several large scorch marks along the walls."],"exits":[{"to":282,"exit":"go","move":"go hatch"}]},
  {"id":284,"x":720,"y":290,"z":0,"title":"The Painted Barn, Tools and Trade","descriptions":["Pervaded with atrophy, the burned walls barely form any real barrier to keep out the elements.  As a result, mold has begun to grow along edges of the room, and a noxious odor wafts through the air.  Bits of metal and wood litter the floor, waiting to be claimed by the growing mold."],"exits":[{"to":40,"exit":"go","move":"go door"},{"to":285,"exit":"go","move":"go hatch"}]},
  {"id":285,"x":730,"y":290,"z":0,"title":"The Painted Barn, Tack and Gear","descriptions":["Mold spreads along the charred walls, giving the blackened wood a rotten, white and green hue in several spots.  Clearly once meant for the displaying of tools, empty and rusted hooks line the walls and overlook the littered floor."],"exits":[{"to":284,"exit":"go","move":"go hatch"}]},
  {"id":286,"x":94,"y":440,"z":0,"title":"Under the Mountain, Entrance Cave","descriptions":["Jumbled rocks and boulders block most of the light entering the narrow mouth of this cave.  A worn path threads between the obstructions further into the gloom."],"exits":[{"to":287,"exit":"northeast","move":"northeast"},{"to":291,"exit":"southeast","move":"southeast"},{"to":194,"exit":"go","move":"go dark opening"}],"color":"#993300"},
  {"id":287,"x":114,"y":420,"z":0,"title":"Under the Mountain, Passage","descriptions":["The passage widens slightly as it delves deeper into the mountain.  Jagged limestone stalactites loom above, like gnawed finger bones waiting for someone to snatch."],"exits":[{"to":288,"exit":"east","move":"east"},{"to":286,"exit":"southwest","move":"southwest"}],"color":"#993300"},
  {"id":288,"x":134,"y":420,"z":0,"title":"Under the Mountain, Passage","descriptions":["Twisting between some enormous boulders, the faint path winds its way deeper under ground.  Gaping voids in the ceiling show where the slabs originated from."],"exits":[{"to":289,"exit":"southeast","move":"southeast"},{"to":287,"exit":"west","move":"west"}],"color":"#993300"},
  {"id":289,"x":154,"y":440,"z":0,"title":"Under the Mountain, Passage","descriptions":["Long and narrow, this passage continues into the darkness leaving only glowing moss as the light source.  The sound of dripping water echoes against the granite walls and pebbles groan under foot.  Rank odors waft in the air and assail the senses."],"exits":[{"to":290,"exit":"south","move":"south"},{"to":288,"exit":"northwest","move":"northwest"}],"color":"#993300"},
  {"id":290,"x":154,"y":500,"z":0,"title":"Under the Mountain, Passage","descriptions":["The passage opens into a round, spacious room.  Sharp, glinting rock walls make an impenetrable cage were it not for the continuing passage."],"exits":[{"to":289,"exit":"north","move":"north"},{"to":291,"exit":"northwest","move":"northwest"}],"color":"#993300"},
  {"id":291,"x":114,"y":460,"z":0,"title":"Under the Mountain, Passage","descriptions":["Twisting like a snake, the corridor of rock leads further into the heart of the mountain.  The path is hardly wide enough for a gnome to tread and pointed rocks lie silently in wait of a flailing arm or leg.  Pebbles from the ceiling bounce against the rocks and land loudly on the ground."],"exits":[{"to":290,"exit":"southeast","move":"southeast"},{"to":286,"exit":"northwest","move":"northwest"}],"color":"#993300"},
  {"id":400,"x":760,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Pathway","descriptions":["A simple walkway skirts around sturdy stalks of bamboo that have been lashed together into walls, built to protect a seaside village.  To the east, the meandering path leads towards the beach, while shadowy trees lie to the west."],"exits":[{"to":401,"exit":"east","move":"east"},{"to":39,"exit":"west","move":"west"}]},
  {"id":401,"x":780,"y":320,"z":0,"title":"Jalren'rae'Taisidon, Beach","descriptions":["A stone launching ramp disrupts the wide sweep of silvery sand edging the crystal lagoon.  A village sprawls over the graceful slopes of the hills to the west, nestled against a backdrop of dense jungle.  The boards of its buildings are bleached and weathered from the constant battering of the sea winds."],"exits":[{"to":6,"exit":"north","move":"north"},{"to":400,"exit":"west","move":"west"}],"color":"#A6A3D9"},
  {"id":402,"x":940,"y":320,"z":0,"title":"A'baya Esplanade, Central Walkway","descriptions":["At the center of the busy shopping walkway, a beautiful ocean mosaic is pieced together with bits of shell and seaglass.  Festive gaethzen globes are hung from tall poles that are placed at even intervals along the macawood boardwalk."],"exits":[{"to":1,"exit":"north","move":"north"},{"to":403,"exit":"west","move":"west"},{"to":404,"exit":"east","move":"east"},{"to":0,"exit":"go","move":"go ocean-blue moongate"},{"to":2,"exit":"go","move":"go colorful portal"}],"aliases":["portal","exit"]},
  {"id":403,"x":840,"y":320,"z":0,"title":"A'baya Esplanade, Entrance","descriptions":["Criss-crossed above a macawood boardwalk, festive banners flutter against a gentle sea breeze.  Throngs of visitors amble towards the colorful stalls and pushcarts that gather along the pathway."],"exits":[{"to":402,"exit":"east","move":"east"}]},
  {"id":404,"x":1020,"y":320,"z":0,"title":"The Morada, Gangway","descriptions":["Bridging the gap over a deep blue sea, a polished ilomba ramp gently slopes upwards from the sandy shore to the Morada.  Opulent diamondwood railings with silver-gilt palm tree balusters protect passengers from unexpected routes of departure."],"exits":[{"to":402,"exit":"west","move":"west"}],"aliases":["Morada"]},
  {"id":460,"x":194,"y":0,"z":0,"title":"Jalren'rae'Taisidon, Gash","descriptions":["The resinous scent of crushed pine needles fills the air.  Fuzzy green branches, part of a tree which spans the large chasm to the south, partially block the rocky mountain path as it wends its way northward.  A small nest lies crumpled beneath one branch."],"exits":[{"to":261,"exit":"south","move":"south"},{"to":263,"exit":"climb","move":"climb bridge"},{"to":260,"exit":"go","move":"go fallen tree"}],"color":"#993300"},
  {"id":461,"x":780,"y":460,"z":0,"title":"The Morada, Morgue","descriptions":["Cold air circles the room and a thin layer of frost covers the steel cabinets that are lined up against the walls.  Placed in the upper corners of the room, large gaethzen lanterns emit a bright and steady light for optimal visibility."],"exits":[{"to":462,"exit":"up","move":"up"}]},
  {"id":462,"x":840,"y":460,"z":0,"title":"The Morada, Foredeck","descriptions":["Separating the polished ilomba deck from the sea, opulent diamondwood railings are decorated with miniature silver-gilt palm trees.  A tall mast rises up from the deck, standing with bast sails neatly furled."],"exits":[{"to":461,"exit":"down","move":"down"},{"to":463,"exit":"south","move":"aft"}]},
  {"id":463,"x":840,"y":500,"z":0,"title":"The Morada, Promenade","descriptions":["Opulent diamondwood railings decorated with miniature silver-gilt palm trees line the expansive deck.  Draped elegantly overhead, a crisp white awning provides shade for guests to stroll comfortably underneath."],"exits":[{"to":462,"exit":"none","move":"forward"},{"to":465,"exit":"none","move":"port"},{"to":466,"exit":"none","move":"starboard"},{"to":464,"exit":"up","move":"up"}]},
  {"id":464,"x":840,"y":540,"z":0,"title":"The Morada, Quarterdeck","descriptions":["An enormous main-mast towers above the polished ilomba decking at its forward edge.  Crafted into the shape of miniature palm trees, gaethzen lights are gaily strung about the raised deck."],"exits":[{"to":463,"exit":"down","move":"down"}]},
  {"id":465,"x":780,"y":500,"z":0,"title":"The Morada, Buffet","descriptions":["Flanking an ornate chef's carving station, two large diamondwood sideboards are heavily laden with platters of beautifully displayed food.  A crisp white awning protects any guests seated at the scattered silver-gilt tables from possible inclement weather."],"exits":[{"to":463,"exit":"none","move":"starboard"}]},
  {"id":466,"x":900,"y":500,"z":0,"title":"The Morada, Lounge","descriptions":["Opulent diamondwood railings transition into raised half-walls that serve to protect relaxing guests from potential wind gusts.  Providing ample seating, plush cerulean couches are scattered about the area and paired with silver-gilt side tables."],"exits":[{"to":463,"exit":"none","move":"port"},{"to":467,"exit":"none","move":"aft"}]},
  {"id":467,"x":900,"y":540,"z":0,"title":"The Morada, Bar","descriptions":["Placed in the center as a magnificent focal point, a large curving diamondwood bar is fully stocked with tiers of strong and exotic liqueurs.  Plush cerulean sofas are placed in cozy nooks that are discreetly attended to by sharply dressed waiters."],"exits":[{"to":466,"exit":"none","move":"forward"}]}
 ],
