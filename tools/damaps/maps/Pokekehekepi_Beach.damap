{
 "format": "damap",
 "version": 1,
 "id": "96",
 "name": "Pokekehekepi Beach",
 "file": "Map96_Pokekehekepi_Beach.xml",
 "rooms": [
  {"id":1,"x":0,"y":180,"z":0,"title":"Reshalia, Coastal Path","descriptions":["Low thorny shrubs grow in patches in the pale sandy soil.  The constant strong breeze from the east has bared their roots on the windward side, and created small hummocks to leeward."],"exits":[{"to":2,"exit":"east","move":"east"},{"to":3,"exit":"southwest","move":"southwest"}]},
  {"id":2,"x":20,"y":180,"z":0,"title":"Reshalia, Sand Dunes","descriptions":["Golden sand rises in tall dunes, pocked and swirled with scrubby sea grasses on their leeward sides.  A huge grey log, weathered by long years of wind and sand-scouring, lies tossed by some forgotten storm far from any forest."],"exits":[{"to":4,"exit":"east","move":"east"},{"to":1,"exit":"west","move":"west"}]},
  {"id":3,"x":-20,"y":200,"z":0,"title":"Reshalia, Coastal Path","descriptions":["To the east stretches a line of tall dunes, sheltering this relatively flat area from the worst of the storms and spray off the ocean.  A line of small, shallow ponds separated by dikes into squares stretches alongside the pathway, in various stages of evaporation.  In the very shallowest pool, salt crystals coat the edges and sparkle in the daylight like powdered diamonds."],"exits":[{"to":1,"exit":"northeast","move":"northeast"},{"to":0,"exit":"southwest","move":"southwest"}],"linksTo":"Map95_Reshalian_Coastal_Road.xml"},
  {"id":4,"x":40,"y":180,"z":0,"title":"Reshalia, Sand Dunes","descriptions":["Sea grasses to the west give way to pure sand to the east, humped and hillocked as the never-ending ocean wind constantly pushes it into new patterns.  The trail winds through the valleys between the dunes, changing its pathway as the dunes shift their locations."],"exits":[{"to":5,"exit":"east","move":"east"},{"to":2,"exit":"west","move":"west"}]},
  {"id":5,"x":60,"y":180,"z":0,"title":"Reshalia, Sand Dunes","descriptions":["The ocean must be almost within sight here -- the smell of salt and dead fish is carried on the breeze.  Low dunes only slightly taller than a Gor'Tog's head block the view in all directions, leaving only the sea birds wheeling in slow circles overhead with a clear perspective on the geography."],"exits":[{"to":6,"exit":"east","move":"east"},{"to":4,"exit":"west","move":"west"}]},
  {"id":6,"x":80,"y":180,"z":0,"title":"Pokekehekepi olpo'staho","descriptions":["Gleaming golden sand stretches out, seemingly endless under the glaring light of the daytime sun.","Glistening with a silver sheen, the sands stretch out into the darkness beyond the range of vision."],"exits":[{"to":7,"exit":"southeast","move":"southeast"},{"to":5,"exit":"west","move":"west"}]},
  {"id":7,"x":100,"y":200,"z":0,"title":"Pokekehekepi olpo'staho","descriptions":["Gleaming golden sand stretches out, seemingly endless under the glaring light of the daytime sun.  The southern horizon is dominated by the glistening expanse of an ocean.","Glistening with a silver sheen, the sands stretch out into the darkness beyond the range of vision."],"exits":[{"to":8,"exit":"northeast","move":"northeast"},{"to":6,"exit":"northwest","move":"northwest"}]},
