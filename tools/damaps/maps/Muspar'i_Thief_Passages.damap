  {"text":"Muspar'i","x":360,"y":320,"z":0},
  {"text":"Justice Offices","x":42,"y":284,"z":0},
  {"text":"Bank","x":147,"y":174,"z":0},
  {"text":"Gate Square","x":351,"y":334,"z":0}
 ]
}
