{
 "format": "damap",
 "version": 1,
 "id": "510",
 "name": "Su Helmas: Make Haste! 444",
 "file": "Su_Helmas_2023(444).xml",
 "rooms": [
  {"id":1,"x":200,"y":320,"z":0,"title":"Plaza, Central Area","descriptions":["Most of the encroaching sand has been cleared away, leaving the once-smooth paving stones exposed anew.  The air is heavy with dust and the acrid smell of hot rock and sand."],"exits":[{"to":3,"exit":"west","move":"west"},{"to":4,"exit":"north","move":"north"},{"to":5,"exit":"south","move":"south"},{"to":2,"exit":"east","move":"east"},{"to":82,"exit":"go","move":"go portal"}],"color":"#00FF00","aliases":["portal","Empath"]},
  {"id":2,"x":360,"y":320,"z":0,"title":"Plaza, Eastern Area","descriptions":["Piles of broken rock and sand snake across the otherwise barren stones of the plaza, the forerunners of the blasted surroundings ready to rebury the ruins under debris and dunes.  A wall of crumbling stone stands precariously around a dark hole, leading deeper into the temple."],"exits":[{"to":1,"exit":"west","move":"west"},{"to":76,"exit":"go","move":"go hole"}]},
  {"id":3,"x":100,"y":320,"z":0,"title":"Plaza, Western Area","descriptions":["Jumbled stones lie heaped in disordered piles where buildings once stood.  A few withered weeds sprout from cracks, struggling to survive in the blasted environment."],"exits":[{"to":1,"exit":"east","move":"east"},{"to":39,"exit":"none","move":"#put ask climber about access"},{"to":9,"exit":"none","move":"#put ask explorer about access"}],"color":"#00FF00","aliases":["ziggurat climber","climber","graveyard explorer","explorer"]},
  {"id":4,"x":200,"y":300,"z":0,"title":"Plaza, Northern Area","descriptions":["Partially cleared spaces vie with the aggressive sand that keeps trying to return the reclaimed concourse to dunes.  Paths lead to various stone buildings reclaimed from the desert."],"exits":[{"to":1,"exit":"south","move":"south"}],"color":"#FF0000","aliases":["dispenser","raffles"]},
  {"id":5,"x":200,"y":340,"z":0,"title":"Plaza, Southern Area","descriptions":["Piles of sand and rocks show where efforts at beating back the badlands have borne fruit.  The cleared areas include a couple of stone buildings which have been reclaimed for habitation from the wasteland."],"exits":[{"to":1,"exit":"north","move":"north"},{"to":6,"exit":"go","move":"go stone home"},{"to":7,"exit":"go","move":"go stone hut"},{"to":75,"exit":"go","move":"go stone building"},{"to":118,"exit":"go","move":"go stone house"}],"aliases":["mage"]},
  {"id":6,"x":150,"y":360,"z":0,"title":"Stone Home, Interior","descriptions":["Makeshift sconces line the walls, holding flickering candles that barely beat back the gloom.  Although the room has been cleared of most obstructions and debris, some still fill the corners."],"exits":[{"to":5,"exit":"go","move":"go makeshift door"}],"color":"#FF0000","aliases":["Stone Home","home"]},
  {"id":7,"x":220,"y":360,"z":0,"title":"Stone Hut, Interior","descriptions":["Broken boards and other debris are swept against the walls, clearing a space in the middle of the room.  A hastily assembled shelf holds a flickering lamp which sheds an irregular light throughout the building."],"exits":[{"to":5,"exit":"go","move":"go makeshift door"}],"color":"#FF0000","aliases":["Stone Hut","hut"]},
  {"id":9,"x":100,"y":480,"z":0,"title":"Desolate Field, Barren Path","descriptions":["Made up of dirt and rocks, the surrounding landscape is completely barren and free of life, as if all vegetation had been scoured away by an overwhelming force.  The ground is parched and dry, with spiderweb cracks running through the ground."],"exits":[{"to":10,"exit":"east","move":"east"},{"to":38,"exit":"go","move":"go crumbling gate"},{"to":3,"exit":"go","move":"go winding path;go winding path"}],"color":"#00FF00","aliases":["Field exit"]},
  {"id":10,"x":140,"y":480,"z":0,"title":"Desolate Field, Barren Path","descriptions":["A thin layer of dust saturates the stale air about one to two inches above the ground, making tiny whorls and spirals whenever disturbed.  The ground itself is completely bare and lifeless, dry as a long forgotten bone and comprised of compacted brown dirt."],"exits":[{"to":12,"exit":"south","move":"south"},{"to":9,"exit":"west","move":"west"},{"to":14,"exit":"northwest","move":"northwest"}]},
  {"id":11,"x":101,"y":460,"z":0,"title":"Desolate Field, Barren Path","descriptions":["The ground in the area is unnaturally flat and barren, though there is little indication of what caused the unnatural ground.  To the west, large boulders block the way, tall enough that it's impossible to see past the formations."],"exits":[{"to":14,"exit":"north","move":"north"},{"to":12,"exit":"southeast","move":"southeast"},{"to":9,"exit":"south","move":"south"}]},
  {"id":12,"x":140,"y":500,"z":0,"title":"Desolate Field, Barren Path","descriptions":["The ground in the area is a very deep brown that borders on black, as if the remnants of a blazing fire had sputtered out and then crumbled over the landscape during the eons of neglect.  The occasional small rock can be seen sunken into the dirt, but otherwise the area is flat and featureless."],"exits":[{"to":10,"exit":"north","move":"north"},{"to":13,"exit":"southeast","move":"southeast"},{"to":11,"exit":"northwest","move":"northwest"}]},
  {"id":13,"x":160,"y":520,"z":0,"title":"Edge of the Pit","descriptions":["The ground drops off to the east as a massive pit cuts through the desolate landscape like a hole into the world.  At the bottom, a mass graveyard is clearly visible, full of long forgotten skeletons that surround a massive white obelisk that stands tall in the center of the pit."],"exits":[{"to":12,"exit":"northwest","move":"northwest"},{"to":19,"exit":"climb","move":"climb winding ramp"}]},
  {"id":14,"x":101,"y":440,"z":0,"title":"Desolate Field, Barren Path","descriptions":["Loose rubble peppers the ground in scattered piles, cleared away in small paths that have little purpose.  Nothing grows in the area, and the normal signs of life are completely absent, with no animal tracks or insects in the dirt."],"exits":[{"to":15,"exit":"east","move":"east"},{"to":10,"exit":"southeast","move":"southeast"},{"to":11,"exit":"south","move":"south"}]},
  {"id":15,"x":140,"y":440,"z":0,"title":"Desolate Field, Barren Path","descriptions":["Buried halfway in the ground lies a lone skeleton, its spine and legs completely sunken into the hardened dirt and its ribs half sticking out of the ground.  Only its head is exposed, and its posture mimics the pose of a drowning man."],"exits":[{"to":16,"exit":"northeast","move":"northeast"},{"to":14,"exit":"west","move":"west"}]},
  {"id":16,"x":160,"y":420,"z":0,"title":"Desolate Field, Barren Path","descriptions":["The flat, dry ground holds little moisture, and it appears that any rain that falls simply runs off it without penetrating the surface.  Large boulders block most of the way north, though a trail wends through them, leading through the tangle of massive stones."],"exits":[{"to":17,"exit":"east","move":"east"},{"to":15,"exit":"southwest","move":"southwest"}]},
  {"id":17,"x":180,"y":420,"z":0,"title":"Desolate Field, Barren Path","descriptions":["Compact and barren ground makes up the landscape in the area, and the path continues between several massive boulders that are sunk partly into the ground.  The narrow path has a feeling of intense sterility, and an almost astringent taste lingers in the stale air."],"exits":[{"to":18,"exit":"southeast","move":"southeast"},{"to":16,"exit":"west","move":"west"}]},
  {"id":18,"x":200,"y":440,"z":0,"title":"Edge of the Pit","descriptions":["The desolate landscape suddenly drops off into a massive spiral-shaped pit, with extremely steep sides and forming a bowl-shaped basin.  At the bottom of the pit, numerous bleached white skeletons are visible, surrounding a massive obelisk that rises up in the center of the pit."],"exits":[{"to":17,"exit":"northwest","move":"northwest"},{"to":23,"exit":"climb","move":"climb winding ramp"}]},
  {"id":19,"x":200,"y":520,"z":0,"title":"Sunken Pit, Mass Graveyard","descriptions":["The bottom of the ramp is partly covered in bleached white skeletons, scattered here and there in macabre poses.  Several of the bodies still have bits of dried out flesh clinging to them, mummified over eons in the dry air."],"exits":[{"to":20,"exit":"north","move":"north"},{"to":28,"exit":"northeast","move":"northeast"},{"to":22,"exit":"east","move":"east"},{"to":21,"exit":"southeast","move":"southeast"},{"to":13,"exit":"climb","move":"climb winding ramp"}]},
  {"id":20,"x":200,"y":460,"z":0,"title":"Sunken Pit, Mass Graveyard","descriptions":["Numerous bare skeletons litter the ground in the area, both decay and rigor mortis having twisted them into macabre shapes.  Stray bones and skulls poke up from the compacted hard dirt, indicating that the pit has seen multiple uses over long periods of time."],"exits":[{"to":23,"exit":"northeast","move":"northeast"},{"to":28,"exit":"east","move":"east"},{"to":22,"exit":"southeast","move":"southeast"},{"to":19,"exit":"south","move":"south"}]},
  {"id":21,"x":260,"y":580,"z":0,"title":"Sunken Pit, Mass Graveyard","descriptions":["Discarded skeletons litter the bottom of the massive pit, most of them partly sunken into the thick dirt that makes up the ground in this desolate area.  Huddled into the stone wall are two corpses holding hands, indicating that not everyone may have been dead before they were thrown into the pit."],"exits":[{"to":22,"exit":"north","move":"north"},{"to":30,"exit":"northeast","move":"northeast"},{"to":27,"exit":"east","move":"east"},{"to":19,"exit":"northwest","move":"northwest"}]},
  {"id":22,"x":260,"y":520,"z":0,"title":"Sunken Pit, Obelisk","descriptions":["Rising high from the center of the sunken pit, the pure white obelisk stands starkly against the sky, made from some strange material that defies any weathering or vandalism.  Each of its four corners points exactly in a cardinal direction.  The southwestern face is visible here and is covered mostly in a cursive script of compact writing, though a little under a third of it is still blank."],"exits":[{"to":28,"exit":"north","move":"north"},{"to":30,"exit":"east","move":"east"},{"to":27,"exit":"southeast","move":"southeast"},{"to":21,"exit":"south","move":"south"},{"to":19,"exit":"west","move":"west"},{"to":20,"exit":"northwest","move":"northwest"}]},
  {"id":23,"x":260,"y":400,"z":0,"title":"Sunken Pit, Mass Graveyard","descriptions":["The lifeless ground is covered in a massive tangle of skeletons, bleached white and stripped of flesh after long exposure to the elements.  Many of the skeletons are splintered and cracked in numerous places, indicating massive trauma before the victims' deaths."],"exits":[{"to":24,"exit":"east","move":"east"},{"to":29,"exit":"southeast","move":"southeast"},{"to":28,"exit":"south","move":"south"},{"to":20,"exit":"southwest","move":"southwest"},{"to":18,"exit":"climb","move":"climb winding ramp"}]},
  {"id":24,"x":320,"y":400,"z":0,"title":"Sunken Pit, Mass Graveyard","descriptions":["Scraps of dark cloth still cling to several of the mummified corpses that litter the bottom of the pit, the numerous bodies dried out into empty, dry husks that give little indication to what races they were.  Though immobile and very long dead, the corpses still appear to stare forward blankly."],"exits":[{"to":25,"exit":"southeast","move":"southeast"},{"to":29,"exit":"south","move":"south"},{"to":28,"exit":"southwest","move":"southwest"},{"to":23,"exit":"west","move":"west"}]},
  {"id":25,"x":380,"y":460,"z":0,"title":"Sunken Pit, Mass Graveyard","descriptions":["Piles of bones stack up against the sheer edges of the pit, creating tangles that make it impossible to tell which bones belonged to what skeleton.  Clear and crisp paths between the piles of bone are the only indication that the area is not wholly abandoned."],"exits":[{"to":26,"exit":"south","move":"south"},{"to":30,"exit":"southwest","move":"southwest"},{"to":29,"exit":"west","move":"west"},{"to":24,"exit":"northwest","move":"northwest"}]},
  {"id":26,"x":380,"y":520,"z":0,"title":"Sunken Pit, Mass Graveyard","descriptions":["Relatively few skeletons lie at rest in this area compared to the rest of the pit, though the absence makes the few that remain all the more eerie, speaking of unfinished work in filling the pit.  Several of the skeletons are also not wholly bleached, indicating that they are at least somewhat newer than the rest of the pit."],"exits":[{"to":25,"exit":"north","move":"north"},{"to":27,"exit":"southwest","move":"southwest"},{"to":30,"exit":"west","move":"west"},{"to":29,"exit":"northwest","move":"northwest"}]},
  {"id":27,"x":320,"y":580,"z":0,"title":"Sunken Pit, Mass Graveyard","descriptions":["Hundreds of skeletonized corpses are piled up in careless and haphazard arrangements, a testament to the brutal efficiency of whoever presided over their deaths.  Mixed into the collection of bones are many animal bones, giving hints that the killing was quite indiscriminate."],"exits":[{"to":30,"exit":"north","move":"north"},{"to":26,"exit":"northeast","move":"northeast"},{"to":21,"exit":"west","move":"west"},{"to":22,"exit":"northwest","move":"northwest"},{"to":31,"exit":"climb","move":"climb winding ramp"}]},
  {"id":28,"x":260,"y":460,"z":0,"title":"Sunken Pit, Obelisk","descriptions":["Rising high from the center of the sunken pit, the pure white obelisk stands starkly against the sky, made from some strange material that defies any weathering or vandalism.  Each of its four corners points exactly in a cardinal direction.  The northwestern face is visible here, and numerous runes are carved onto its surface, filled in with a dark material that makes the lettering stand out."],"exits":[{"to":23,"exit":"north","move":"north"},{"to":24,"exit":"northeast","move":"northeast"},{"to":29,"exit":"east","move":"east"},{"to":22,"exit":"south","move":"south"},{"to":19,"exit":"southwest","move":"southwest"},{"to":20,"exit":"west","move":"west"}]},
  {"id":29,"x":320,"y":460,"z":0,"title":"Sunken Pit, Obelisk","descriptions":["Rising high from the center of the sunken pit, the pure white obelisk stands starkly against the sky, made from some strange material that defies any weathering or vandalism.  Each of its four corners points exactly in a cardinal direction.  The northeastern face is visible here, and numerous markings that represent celestial sigils cover its surface, each one filled with the powder of semi-precious gemstones."],"exits":[{"to":24,"exit":"north","move":"north"},{"to":25,"exit":"east","move":"east"},{"to":26,"exit":"southeast","move":"southeast"},{"to":30,"exit":"south","move":"south"},{"to":28,"exit":"west","move":"west"},{"to":23,"exit":"northwest","move":"northwest"}]},
  {"id":30,"x":320,"y":520,"z":0,"title":"Sunken Pit, Obelisk","descriptions":["Rising high from the center of the sunken pit, the pure white obelisk stands starkly against the sky, made from some strange material that defies any weathering or vandalism.  Each of its four corners points exactly in a cardinal direction.  The southeastern face is visible here, and appears to be completely blank, its stark white face piercing the sky like a fine white needle."],"exits":[{"to":29,"exit":"north","move":"north"},{"to":25,"exit":"northeast","move":"northeast"},{"to":26,"exit":"east","move":"east"},{"to":27,"exit":"south","move":"south"},{"to":21,"exit":"southwest","move":"southwest"},{"to":22,"exit":"west","move":"west"}]},
  {"id":31,"x":240,"y":600,"z":0,"title":"Edge of the Pit","descriptions":["The edge of a massive pit is clearly visible to the north, the sides of it straight vertical and the bottom of it filled with a massive number of bleached skeletons.  In the center of the pit, an enormous obelisk rises up high, standing starkly white against its darker surroundings."],"exits":[{"to":32,"exit":"south","move":"south"},{"to":27,"exit":"climb","move":"climb winding ramp"}]},
  {"id":32,"x":240,"y":620,"z":0,"title":"Desolate Field, Lifeless Trail","descriptions":["A massive collection of rocks and boulders completely block off any continuation of the shallow ravine to the east, easily filling the path past the top of the gorge.  A path to the north appears man-made, with numerous shovel marks still visible in the hard and compact dirt."],"exits":[{"to":31,"exit":"north","move":"north"},{"to":33,"exit":"west","move":"west"}]},
  {"id":33,"x":200,"y":620,"z":0,"title":"Desolate Field, Lifeless Trail","descriptions":["Powdery dirt and loose pebbles litter the ravine floor, making it obvious that moisture never stays around for long in this dry and desolate place.  Both the northern and southern walls are cracked and jagged, though erosion has blunted the sharpest of the edges."],"exits":[{"to":32,"exit":"east","move":"east"},{"to":34,"exit":"northwest","move":"northwest"}]},
  {"id":34,"x":180,"y":600,"z":0,"title":"Desolate Field, Lifeless Trail","descriptions":["The shallow ravine cuts through the sullen landscape like a meandering crack through brown rock, and its floor resembles an area where the dull landscape simply caved into it.  Tiny trails in the ground indicate where water flows when it rains, carving dry spiderwebs through the bare dirt."],"exits":[{"to":33,"exit":"southeast","move":"southeast"},{"to":35,"exit":"west","move":"west"}]},
  {"id":35,"x":140,"y":600,"z":0,"title":"Desolate Field, Lifeless Trail","descriptions":["The shallow ravine narrows to the east, while it widens to the west to accommodate a large rock formation in the center of the path.  Rising tall from the ground, the formation appears to have once been merely a part of the landscape, ancient water having carved the paths around it."],"exits":[{"to":34,"exit":"east","move":"east"},{"to":36,"exit":"west","move":"west"},{"to":37,"exit":"northwest","move":"northwest"}]},
  {"id":36,"x":120,"y":600,"z":0,"title":"Desolate Field, Lifeless Trail","descriptions":["The path cuts directly into the ravine wall, creating a narrow depression in the stone that marks the beginning of a cave.  However, it appears that whatever water flowed through this area was long gone before the formation could be finished, and the overhang is not enough to protect from the elements."],"exits":[{"to":37,"exit":"north","move":"north"},{"to":35,"exit":"east","move":"east"}]},
  {"id":37,"x":120,"y":580,"z":0,"title":"Desolate Field, Lifeless Trail","descriptions":["The walls of the ravine widen in this area to accommodate a large brown rock formation in the center of the depression.  Dry trails mark where runnels of water used to flow in the area, punctuated by small pebbles worn smooth and round."],"exits":[{"to":35,"exit":"southeast","move":"southeast"},{"to":36,"exit":"south","move":"south"},{"to":38,"exit":"northwest","move":"northwest"}]},
  {"id":38,"x":100,"y":560,"z":0,"title":"Desolate Field, Lifeless Trail","descriptions":["The narrow path sweeps south from the crumbling gate and lies within a shallow ravine, with all the signs of once having held a riverbed or wash.  Numerous brown pebbles line the now barren path, and it's clear that any water that falls is quickly funneled away by the sloping path."],"exits":[{"to":37,"exit":"southeast","move":"southeast"},{"to":9,"exit":"go","move":"go crumbling gate"}]},
  {"id":39,"x":100,"y":240,"z":0,"title":"Ziggurat, Lower Level","descriptions":["Tumbled stones litter the platform, refugees from higher on the structure.  A trail has been hacked out of the surrounding vegetation, allowing access further around the edifice.  The middle and upper platforms, covered with tangles of foliage, loom over the crude pathway."],"exits":[{"to":40,"exit":"north","move":"north"},{"to":54,"exit":"east","move":"east"},{"to":63,"exit":"climb","move":"climb staircase"},{"to":3,"exit":"go","move":"go shimmering portal;go shimmering portal","hidden":true}],"color":"#00FF00","aliases":["tower exit"]},
  {"id":40,"x":100,"y":180,"z":0,"title":"Ziggurat, Lower Level","descriptions":["A few blocks have fallen from the heights, providing obstacles for the path hewn from the jungle.  The upper platforms tower over this, the lowest terrace."],"exits":[{"to":41,"exit":"north","move":"north"},{"to":39,"exit":"south","move":"south"}]},
  {"id":41,"x":100,"y":140,"z":0,"title":"Ziggurat, Lower Level","descriptions":["Fallen stones litter the platform, refugees from higher on the edifice.  The middle and upper platforms, covered with trees and vines, loom over the twisty pathway."],"exits":[{"to":42,"exit":"north","move":"north"},{"to":40,"exit":"south","move":"south"}]},
  {"id":42,"x":100,"y":100,"z":0,"title":"Ziggurat, Lower Level","descriptions":["The ever-present jungle growth crowds in on the narrow path, threatening to once more reclaim it.  Puddles from prior rains stretch across the footpath, settling into the depressions in the stones of the pyramid."],"exits":[{"to":43,"exit":"north","move":"north"},{"to":41,"exit":"south","move":"south"}]},
  {"id":43,"x":100,"y":40,"z":0,"title":"Ziggurat, Lower Level","descriptions":["The middle and upper platforms, covered with foliage, rise over the trail cleared out of the surrounding vegetation.  The loud calls of insects and birds fill the area."],"exits":[{"to":44,"exit":"east","move":"east"},{"to":42,"exit":"south","move":"south"},{"to":60,"exit":"climb","move":"climb stone stairway"}]},
  {"id":44,"x":160,"y":40,"z":0,"title":"Ziggurat, Lower Level","descriptions":["Hewn from the surrounding undergrowth, a narrow footpath twists between fallen boulders that cover the platform.  The middle and upper platforms, covered with jungle vegetation, loom over the crude pathway."],"exits":[{"to":45,"exit":"east","move":"east"},{"to":43,"exit":"west","move":"west"}]},
  {"id":45,"x":200,"y":40,"z":0,"title":"Ziggurat, Lower Level","descriptions":["Some of the fallen stones have been cleared off to the side in the beginnings of attempts at archaeological work.  The two upper platforms, covered with tangles of vines, loom over the crude footpath winding between the boulders."],"exits":[{"to":46,"exit":"east","move":"east"},{"to":44,"exit":"west","move":"west"}]},
  {"id":46,"x":240,"y":40,"z":0,"title":"Ziggurat, Lower Level","descriptions":["A few blocks have fallen from the heights, providing obstacles for the path hewn from the jungle.  The upper levels soar in vertical stone walls above the lower level."],"exits":[{"to":47,"exit":"east","move":"east"},{"to":45,"exit":"west","move":"west"}]},
  {"id":47,"x":300,"y":40,"z":0,"title":"Ziggurat, Lower Level","descriptions":["Hewn from the surrounding flora, a crude pathway zigzags between jumbled rocks that cover the platform.  Some of the stones have been cleared off in the beginnings of attempts at archaeological work."],"exits":[{"to":48,"exit":"south","move":"south"},{"to":46,"exit":"west","move":"west"},{"to":57,"exit":"climb","move":"climb stairs"}]},
  {"id":48,"x":300,"y":100,"z":0,"title":"Ziggurat, Lower Level","descriptions":["The middle and upper platforms, covered with tangles of foliage, loom over the crude pathway.  Tumbled stones litter the platform, refugees from higher on the structure."],"exits":[{"to":47,"exit":"north","move":"north"},{"to":49,"exit":"south","move":"south"}]},
  {"id":49,"x":300,"y":140,"z":0,"title":"Ziggurat, Lower Level","descriptions":["Puddles from prior rains stretch across the footpath, settling into the depressions in the stones of the pyramid.  The ever-present jungle growth crowds in on the narrow path, threatening to once more reclaim it."],"exits":[{"to":48,"exit":"north","move":"north"},{"to":50,"exit":"south","move":"south"}]},
  {"id":50,"x":300,"y":180,"z":0,"title":"Ziggurat, Lower Level","descriptions":["The middle and upper platforms, covered with vines and trees, loom over the trail hacked out of the surrounding vegetation.  The constant calls of insects and birds fill the air."],"exits":[{"to":49,"exit":"north","move":"north"},{"to":51,"exit":"south","move":"south"}]},
  {"id":51,"x":300,"y":240,"z":0,"title":"Ziggurat, Lower Level","descriptions":["Hacked from the surrounding undergrowth, a narrow trace zigzags between fallen rocks that cover the platform.  Some of the stones have been cleared away to begin the process of excavation."],"exits":[{"to":50,"exit":"north","move":"north"},{"to":52,"exit":"west","move":"west"},{"to":55,"exit":"climb","move":"climb stone steps"}]},
  {"id":52,"x":240,"y":240,"z":0,"title":"Ziggurat, Lower Level","descriptions":["The two upper platforms, covered with tangles of vines, loom over the crude trail zigzagging between fallen stones.  Some of the stones have been cleared off to the side in the beginnings of attempts at archaeological work."],"exits":[{"to":51,"exit":"east","move":"east"},{"to":53,"exit":"west","move":"west"}]},
  {"id":53,"x":200,"y":240,"z":0,"title":"Ziggurat, Lower Level","descriptions":["The upper levels soar in vertical stone walls above the lower level.  A few blocks have fallen from the heights, providing obstacles for the path hewn from the jungle."],"exits":[{"to":52,"exit":"east","move":"east"},{"to":54,"exit":"west","move":"west"}]},
  {"id":54,"x":160,"y":240,"z":0,"title":"Ziggurat, Lower Level","descriptions":["Hewn from the surrounding flora, a crude pathway zigzags between jumbled rocks that cover the platform.  The upper platforms tower over this, the lowest terrace.  Some of the stones have been cleared off in the beginnings of attempts at archaeological work."],"exits":[{"to":53,"exit":"east","move":"east"},{"to":39,"exit":"west","move":"west"}]},
  {"id":55,"x":280,"y":220,"z":0,"title":"Ziggurat, Middle Level","descriptions":["Spreading out from the encircling trails, a large clearing fills the space between the steps and stairs moving between the levels.  A small pool of rainwater has formed in the depression between some of the stones of the floor."],"exits":[{"to":56,"exit":"north","move":"north"},{"to":65,"exit":"west","move":"west"},{"to":51,"exit":"climb","move":"climb stone steps"},{"to":66,"exit":"climb","move":"climb stone stairs"}]},
  {"id":56,"x":280,"y":140,"z":0,"title":"Ziggurat, Middle Level","descriptions":["A large stone block has fallen from the upper level, forcing the footpath to diverge around it.  Vines from the surrounding forest drape across the boulder, slowly swallowing it under a blanket of foliage."],"exits":[{"to":57,"exit":"north","move":"north"},{"to":55,"exit":"south","move":"south"}]},
  {"id":57,"x":280,"y":60,"z":0,"title":"Ziggurat, Middle Level","descriptions":["Most of the area is choked with undergrowth, leaving a clearing between the stairway and stairs as well as trails leading further around the ziggurat.  Pools from previous rains spread across the trail, settling into the depressions in the stones of the edifice."],"exits":[{"to":56,"exit":"south","move":"south"},{"to":58,"exit":"west","move":"west"},{"to":47,"exit":"climb","move":"climb stairs"},{"to":68,"exit":"climb","move":"cilmb stairway"}]},
  {"id":58,"x":220,"y":60,"z":0,"title":"Ziggurat, Middle Level","descriptions":["Vines trail from the surrounding jungle, further impeding progress around the ziggurat.  A few boulders have detached from the terrace, forcing the trail to veer around the openings in the platform."],"exits":[{"to":57,"exit":"east","move":"east"},{"to":59,"exit":"west","move":"west"}]},
  {"id":59,"x":180,"y":60,"z":0,"title":"Ziggurat, Middle Level","descriptions":["The area is filled with the sounds of birds calling and flitting amongst the trees.  A narrow footpath has been hacked out of the surrounding jungle, allowing access further around the pyramid."],"exits":[{"to":58,"exit":"east","move":"east"},{"to":60,"exit":"west","move":"west"}]},
  {"id":60,"x":120,"y":60,"z":0,"title":"Ziggurat, Middle Level","descriptions":["A small pool of rainwater has formed in the depression between some of the stones of the floor.  Spreading out from the encircling trails, a large clearing fills the space between the steps and stairs moving between the levels."],"exits":[{"to":59,"exit":"east","move":"east"},{"to":61,"exit":"south","move":"south"},{"to":43,"exit":"climb","move":"climb stone stairway"},{"to":70,"exit":"climb","move":"climb staircase"}]},
  {"id":61,"x":120,"y":120,"z":0,"title":"Ziggurat, Middle Level","descriptions":["Hewn from the surrounding jungle, a twisty trail snakes between the trunks of the lofty trees.  Rustles from the undergrowth indicate that the area is not uninhabited."],"exits":[{"to":60,"exit":"north","move":"north"},{"to":62,"exit":"south","move":"south"}]},
  {"id":62,"x":120,"y":160,"z":0,"title":"Ziggurat, Middle Level","descriptions":["Vines from the surrounding forest drape across a fallen boulder, slowly swallowing it under a blanket of foliage.  The trail snakes around the obstacle, making its way around the ziggurat."],"exits":[{"to":61,"exit":"north","move":"north"},{"to":63,"exit":"south","move":"south"}]},
  {"id":63,"x":120,"y":220,"z":0,"title":"Ziggurat, Middle Level","descriptions":["Puddles from previous downpours spread across the trail, settling into the depressions in the stones of the ziggurat.  Most of the area is choked with undergrowth, leaving a track between the steps and staircase as well as pathways leading further around the edifice."],"exits":[{"to":62,"exit":"north","move":"north"},{"to":64,"exit":"east","move":"east"},{"to":39,"exit":"climb","move":"climb staircase"},{"to":72,"exit":"climb","move":"climb steps"}]},
  {"id":64,"x":180,"y":220,"z":0,"title":"Ziggurat, Middle Level","descriptions":["A few rocks have dislodged from the platform, forcing the path to veer around the openings in the terrace floor.  Vines trail from the surrounding trees, further impeding progress around the pyramid."],"exits":[{"to":65,"exit":"east","move":"east"},{"to":63,"exit":"west","move":"west"}]},
  {"id":65,"x":220,"y":220,"z":0,"title":"Ziggurat, Middle Level","descriptions":["A narrow trail has been hacked out of the surrounding jungle, allowing access further around the edifice.  The air is filled with the sounds of avians calling and flitting amongst the trees."],"exits":[{"to":55,"exit":"east","move":"east"},{"to":64,"exit":"west","move":"west"}]},
  {"id":66,"x":260,"y":200,"z":0,"title":"Ziggurat, Top Level","descriptions":["Flattened foliage extends around the stairway and stairs, providing a bit of a break in the overgrown tangle of undergrowth."],"exits":[{"to":67,"exit":"north","move":"north"},{"to":73,"exit":"west","move":"west"},{"to":55,"exit":"climb","move":"climb stone stairs"},{"to":74,"exit":"climb","move":"climb stone stairway"}]},
  {"id":67,"x":260,"y":140,"z":0,"title":"Ziggurat, Top Level","descriptions":["A gaping hole reveals where a stone block has tumbled to a lower level.  A twisty game path winds among the shrubs, providing a way around the platform."],"exits":[{"to":68,"exit":"north","move":"north"},{"to":66,"exit":"south","move":"south"}]},
  {"id":68,"x":260,"y":80,"z":0,"title":"Ziggurat, Top Level","descriptions":["Although the stairway and staircase are cleared, little other progress has been made in stripping the foliage from the pyramid.  A twisty pathway snakes into the jungle, allowing access to the rest of the upper level."],"exits":[{"to":67,"exit":"south","move":"south"},{"to":69,"exit":"west","move":"west"},{"to":74,"exit":"climb","move":"climb staircase"},{"to":57,"exit":"climb","move":"climb stairway"}]},
  {"id":69,"x":200,"y":80,"z":0,"title":"Ziggurat, Top Level","descriptions":["Shrubs and vines almost completely choke out the narrow game trail.  The calls of birds echo from the lower platforms."],"exits":[{"to":68,"exit":"east","move":"east"},{"to":70,"exit":"west","move":"west"}]},
  {"id":70,"x":140,"y":80,"z":0,"title":"Ziggurat, Top Level","descriptions":["Broken and crushed vegetation extends around the staircase and steps, providing a bit of a break in the lush tangle of foliage."],"exits":[{"to":69,"exit":"east","move":"east"},{"to":71,"exit":"south","move":"south"},{"to":74,"exit":"climb","move":"climb stone steps"},{"to":60,"exit":"climb","move":"climb staricase"}]},
  {"id":71,"x":140,"y":140,"z":0,"title":"Ziggurat, Top Level","descriptions":["A lone sapling struggles to rise above the shrubs and vines congesting the platform's surface.  The narrow footpath diverts around the tree, its surface mostly trampled grass."],"exits":[{"to":70,"exit":"north","move":"north"},{"to":72,"exit":"south","move":"south"}]},
  {"id":72,"x":140,"y":200,"z":0,"title":"Ziggurat, Top Level","descriptions":["Although the steps and stairs are cleared, little other progress has been made in stripping the vegetation from the ziggurat.  A narrow game trail twists into the jungle, allowing access to the rest of the upper level."],"exits":[{"to":71,"exit":"north","move":"north"},{"to":73,"exit":"east","move":"east"},{"to":63,"exit":"climb","move":"climb steps"},{"to":74,"exit":"climb","move":"climb stone stairs"}]},
  {"id":73,"x":200,"y":200,"z":0,"title":"Ziggurat, Top Level","descriptions":["Little marks out the trail but trampled and broken shrubs.  Stone blocks stick up from the undergrowth at irregular intervals."],"exits":[{"to":66,"exit":"east","move":"east"},{"to":72,"exit":"west","move":"west"}]},
  {"id":74,"x":200,"y":140,"z":0,"title":"Ziggurat, Peak","descriptions":["Winds sweep across the stone platform at the top of the ziggurat, scouring it clean of dirt and debris.  The vista is of mostly unbroken jungle, only occasionally broken by the summits of other ziggurats rising above their own cloaks of jungle vegetation.  Some of the stones have begun to crumble under the onslaught of water and weather, but it remains safe enough for now."],"exits":[{"to":66,"exit":"climb","move":"climb stairway"},{"to":70,"exit":"climb","move":"climb steps"},{"to":72,"exit":"climb","move":"climb stairs"},{"to":72,"exit":"climb","move":"climb stone stairs"},{"to":68,"exit":"climb","move":"climb stone staircase"}]},
  {"id":75,"x":180,"y":360,"z":0,"title":"Stone Building, Interior","descriptions":["Dust and rubble are swept into the corners, testifying to a hasty effort to make the edifice habitable.  An occasional skittering sound comes from the shadows as the former denizens avoid the light cast by the flickering torches attached to the stone walls."],"exits":[{"to":5,"exit":"go","move":"go makeshift door"}],"color":"#FF0000","aliases":["Stone Building","building"]},
  {"id":76,"x":480,"y":320,"z":0,"title":"Antechamber Entrance","descriptions":["A smattering of lanterns hang from the vaulted ceiling of the crushingly tight corridor, giving precious little light to these dismal passageways.  Offering, no extra light, just a passage to the plaza , a charred hole is blasted in the back wall.  Wafts of dank and musty air come from a place beyond here, beckoning all who brave this place to keep moving in hopes of more space and cleaner air.  Along one wall recessed chambers are carved into the stone, forming a couple of shelves that each hold different oddities and artifacts."],"exits":[{"to":77,"exit":"east","move":"east"},{"to":2,"exit":"go","move":"go hole"}],"aliases":["Antechamber Entrance"]},
  {"id":77,"x":500,"y":320,"z":0,"title":"Corridor","descriptions":["A hand's width wider here than to the west, the ceiling is strung with numerous lanterns.  Black mold and slime fills the corners with moist and gooey muck.  Cracks rise along the stone walls.  Between a pair of doors, a portrait hangs on the cracked stone wall, nearly obscured by cobwebs.  Faint air currents cause the sticky mess of dusty spidersilk to flutter, though an occasional stronger gust causes the door's hinges to creak and moan."],"exits":[{"to":76,"exit":"west","move":"west"},{"to":78,"exit":"go","move":"go small door"},{"to":79,"exit":"go","move":"go wide door"}]},
  {"id":78,"x":500,"y":340,"z":0,"title":"Library","descriptions":["Quite roomy in comparison to the the cramped corridor, the smell of melting wax and musty paper encompasses the private area.  A massive two-tiered chandelier hangs from the domed ceiling, lighting the room with a soft flickering glow that casts distorted shadows over random surfaces.  Walls of bespoke shelving wrap around the circular room each is covered with rows of time-worn books, all neatly ordered and labeled despite being moldy and slightly warped.  Situated near the door, two cracked leather highback chairs face each other separated by a toppled table of marble. "],"exits":[{"to":77,"exit":"go","move":"go small door"}],"aliases":["Library"]},
  {"id":79,"x":500,"y":300,"z":0,"title":"Antechamber","descriptions":["Devoid of decoration, the door, walls, and even the ceiling and floors are a uniform, dingy white marble.  Four massive columns support the room in its center, making them the main focal point in the vast space.  Cleverly tucked in a corner behind a pillar, a silver and white damask curtain hangs in shreds, revealing rather than hiding a tiny alcove.  The east wall is nearly gone, deliberately knocked down in an unfinished attempt to expand the space."],"exits":[{"to":77,"exit":"go","move":"go wide door"},{"to":80,"exit":"go","move":"go mound"},{"to":81,"exit":"go","move":"go curtain"}],"aliases":["Antechamber"]},
  {"id":80,"x":460,"y":300,"z":0,"title":"Antechamber East","descriptions":["Unlike its western half, this room is lavishly decorated.  Gilded columns reach to the ceiling, framing roundels of the Thirteen.  Each deity's eyes are seemingly focused on a frieze depicting the various constellations that runs along the cornice surrounding the room.  Now dusty and threadbare, once plush chairs and sofas face a pair of buffet tables that stretch from one corner to the next.  Framed in intricately carved wood, a wide marble stairwell ascends into the structure."],"exits":[{"to":79,"exit":"east","move":"east"},{"to":85,"exit":"none","move":"none"}],"color":"#00FF00","aliases":["archaeologist","tower"]},
  {"id":81,"x":500,"y":280,"z":0,"title":"Alcove","descriptions":["A pair of enormous ceramic flower pots rest beside the remains of the curtain, displaying only layers of dust along their rims.  The only other feature is a bench that follows along the back wall.  Surrounded by piles of tattered fabric and matted down, the pitted surface offers precious little comfort.  A series of silver medallions are embedded deeply into the stone."],"exits":[{"to":79,"exit":"go","move":"go curtain"}],"aliases":["alcove"]},
  {"id":82,"x":180,"y":310,"z":0,"title":"The Crossing, Town Green Southeast","descriptions":["This tranquil corner of the Green has a small bower of entwined modwyn vines, laden with tempting, grape-like clusters.  A limestone bench and some sawed-off sections of trees that serve as rustic stools make up an open-air performance space, where bards, musicians and poets can demonstrate their talents."],"exits":[{"to":0,"exit":"north","move":""},{"to":0,"exit":"northwest","move":""},{"to":0,"exit":"west","move":""}],"linksTo":"Map1_Crossing.xml"},
  {"id":84,"x":440,"y":280,"z":0,"title":"Su Helmas, Corridor","descriptions":["Gouges mar the walls of the hallway, each one a long streak of three parallel lines like the claws of some gigantic creature.  Dark stains on the floor are the color of long-dried blood, a few with long trails of discoloration like something was dragged off while still bleeding.  The air is oppressive and still with a feeling of long-disuse."],"exits":[{"to":85,"exit":"east","move":"east"},{"to":90,"exit":"northwest","move":"northwest"}]},
  {"id":85,"x":460,"y":280,"z":0,"title":"Su Helmas, Corridor","descriptions":["Deep gloom hovers over the long, curved corridor, its dimly lit sandstone walls lined with niches and holes for the display of items.  Most of the recesses are empty, but a few might still reward diligent searches.  Tarnished brass sconces once held candles, but now only provide anchor points for the numerous spiderwebs that shroud the walls."],"exits":[{"to":86,"exit":"east","move":"east"},{"to":84,"exit":"west","move":"west"}]},
  {"id":86,"x":480,"y":280,"z":0,"title":"Su Helmas, Corridor","descriptions":["Shadows cloak the curvilinear sandstone walls of the hallway.  What appears to be just debris on the floor turns into bones of the various races scattered amongst decaying fabric bits.  A few of the bones display large teeth marks as if they were gnawed by giant scavengers."],"exits":[{"to":87,"exit":"northeast","move":"northeast"},{"to":85,"exit":"west","move":"west"}]},
  {"id":87,"x":500,"y":260,"z":0,"title":"Su Helmas, Corridor","descriptions":["Cloying scents of decaying flesh drift from a pile of bodies thrown haphazardly along the sandstone walls.  The rotting is so far advanced that it is impossible to tell what race they once were, but a few pieces of equipment still bear Imperial insignia."],"exits":[{"to":88,"exit":"northeast","move":"northeast"},{"to":86,"exit":"southwest","move":"southwest"}]},
  {"id":88,"x":520,"y":240,"z":0,"title":"Su Helmas, Corridor","descriptions":["Skittering sounds echo through the corridor as unseen creatures flee into the murky gloom.  Dust and detritus shroud the intricate brass inlay set into the sandstone floor, ending any hope of figuring out the overall design."],"exits":[{"to":89,"exit":"north","move":"north"},{"to":87,"exit":"southwest","move":"southwest"}]},
  {"id":89,"x":520,"y":220,"z":0,"title":"Su Helmas, Corridor","descriptions":["Curved sandstone walls end at a wooden doorway.  Brass accents are set into the darkened grain of the wood, marking out a curvilinear design that incorporates some unknown script into its sweeping curves.  Deeper shadows lurk beyond the doorway, from which the vague smell of decay occasionally drifts forth."],"exits":[{"to":88,"exit":"south","move":"south"},{"to":102,"exit":"go","move":"go doorway"},{"to":102,"exit":"go","move":"go door"}]},
  {"id":90,"x":420,"y":260,"z":0,"title":"Su Helmas, Corridor","descriptions":["Heaps of abandoned equipment lie moldering along the sandstone walls, so old and decayed that the least attempt to investigate them results in a pile of dust instead of any useful knowledge.  An all-pervasive gloom shrouds much of the corridor and provides a home for a myriad of scuttling creatures to lie in wait for their prey."],"exits":[{"to":84,"exit":"southeast","move":"southeast"},{"to":91,"exit":"northwest","move":"northwest"}]},
  {"id":91,"x":400,"y":240,"z":0,"title":"Su Helmas, Corridor","descriptions":["Propped against the sandstone wall is a seated skeleton, with a few scraps of purple fabric still clinging to the desiccated bones.  A tarnished brass amulet hangs on a leather cord from its neck, the markings on it long since lost to time.  One lone spider has colonized the carcass, turning the ribcage into a mass of webbing that reveals a few silk-bound insects still struggling to break free."],"exits":[{"to":92,"exit":"north","move":"north"},{"to":90,"exit":"southeast","move":"southeast"}]},
  {"id":92,"x":400,"y":220,"z":0,"title":"Su Helmas, Corridor","descriptions":["Something has caused the sandstone walls to be blackened and scarred, almost as if massive fires were once unleashed on this spot.  A faint, lingering scent of fire and brimstone still hangs in the air, turning the gloomy area into a reminder of some long-lost horrors.  The fiery cataclysm melted the brass inlay on the walls, which now lies pooled in irregular blotches on the floor."],"exits":[{"to":93,"exit":"north","move":"north"},{"to":91,"exit":"south","move":"south"}]},
  {"id":93,"x":400,"y":180,"z":0,"title":"Northwest Tower, Main Floor","descriptions":["A few blackened lanterns litter the ground, having fallen from the ceiling during the cataclysm that engulfed the building.  Soot-covered walls are further signs of the upheaval, which has completely destroyed whatever door once hung in the passage between the tower and the hallway."],"exits":[{"to":94,"exit":"north","move":"north"},{"to":101,"exit":"east","move":"east"},{"to":92,"exit":"south","move":"south"},{"to":99,"exit":"west","move":"west"}]},
  {"id":94,"x":400,"y":160,"z":0,"title":"Northwest Tower, Staircase","descriptions":["Clinging to the circular walls is a spiraling staircase that climbs upwards.  A large pile of melted brass lies in the center of the round floor, shards of partially melted glass poking up from the solidified flow of the metal.  A pile of desiccated bones lies in a great heap at the foot of the risers with a few broken weapons the only equipment still intact."],"exits":[{"to":93,"exit":"south","move":"south"},{"to":95,"exit":"up","move":"up"}]},
  {"id":95,"x":356,"y":140,"z":0,"title":"Northwest Tower, Staircase","descriptions":["Light filters in from above through the gaping hole in the ceiling.  Risers continue upwards around the walls until they end abruptly where the walls have crumpled as if under the impact of some large unknown creature.  Sandstone blocks and slabs have fallen into the chamber and clutter the floor."],"exits":[{"to":96,"exit":"south","move":"south"},{"to":94,"exit":"down","move":"down"}]},
  {"id":96,"x":356,"y":152,"z":0,"title":"Northwest Tower, Second Floor","descriptions":["Skeletons, still intact and wearing rusted chainmail, lie in a ragged line facing the corridor to the east.  Most have fallen as if they were fleeing, their backs to the hallway.  The empty eye sockets stare endlessly at the staircase, denied that safety for all eternity."],"exits":[{"to":95,"exit":"north","move":"north"},{"to":97,"exit":"east","move":"east"},{"to":98,"exit":"west","move":"west"}]},
  {"id":97,"x":368,"y":152,"z":0,"title":"Northwest Tower, Second Floor","descriptions":["Yawning holes gape in the walls above piles of sandstone blocks and other debris.  Three piles of bones lie in a rough circle around a strange diagram on the floor.  Closer examination of the pattern is not possible, as no mortal eye can fully grasp the details, but one corner trails away in a line of chalk that implies that the working was never completed properly."],"exits":[{"to":96,"exit":"south","move":"south"}]},
  {"id":98,"x":344,"y":152,"z":0,"title":"Northwest Tower, Second Floor","descriptions":["The corridor ends in a pile of collapsed sandstone blocks and slabs.  The interlocking stones completely fill the space from floor to ceiling, preventing further progress.  Along the base, two femurs clad in rusted plate stick out from under the pile."],"exits":[{"to":96,"exit":"south","move":"south"}]},
  {"id":99,"x":380,"y":160,"z":0,"title":"Northwest Tower, Main Floor","descriptions":["Swept bare of any debris, the empty chamber is devoid of any signs of what purpose it once provided.  A few brass hooks set high into the sandstone walls perhaps once displayed trophies or tapestries but if so, no trace of the decorations remains."],"exits":[{"to":100,"exit":"north","move":"north"},{"to":93,"exit":"south","move":"south"}]},
  {"id":100,"x":400,"y":140,"z":0,"title":"Northwest Tower, Main Floor","descriptions":["Smashed pots litter the ground with their contents long rotted away.  A few containers remain intact by the small stove fitted into a corner, but the contents are a dried and congealed mass that is impossible to identify.  One sturdy table lies upended near the corridor, its top scorched and scarred as if it served as a last minute but futile barricade."],"exits":[{"to":101,"exit":"east","move":"east"},{"to":99,"exit":"west","move":"west"}]},
  {"id":101,"x":420,"y":160,"z":0,"title":"Northwest Tower, Main Floor","descriptions":["Small alcoves line the walls of this chamber, many of them filled with burnt and tattered scroll scraps.  A few broken desks are shoved into the corners while their matching stools lie in pieces across the floor."],"exits":[{"to":100,"exit":"north","move":"north"},{"to":93,"exit":"south","move":"south"}]},
  {"id":102,"x":520,"y":180,"z":0,"title":"Northeast Tower, Main Floor","descriptions":["Rusting arrowheads stick out from the doorframe, their shafts and fletchings long since decayed away to nothingness.  The door and frame are amazingly intact, still sporting a delicate inlay of brass in a pattern that draws in the eye but refuses to resolve itself into a discernable pattern."],"exits":[{"to":105,"exit":"north","move":"north"},{"to":104,"exit":"east","move":"east"},{"to":103,"exit":"west","move":"west"},{"to":89,"exit":"go","move":"go door"}]},
  {"id":103,"x":500,"y":160,"z":0,"title":"Northeast Tower, Main Floor","descriptions":["Long gouges disfigure the slate slabs lining one wall, which still displays a few chalky smudges.  Charred pieces of wood litter the floor and are intermixed with bone shards and rusting metal bits.  A faint odor of decay overlays the pervasive smell of dust and disuse."],"exits":[{"to":106,"exit":"north","move":"north"},{"to":102,"exit":"south","move":"south"}]},
  {"id":104,"x":540,"y":160,"z":0,"title":"Northeast Tower, Main Floor","descriptions":["Shattered glass completely covers the floor with some spots having been melted into pools before solidifying.  Mixed with the debris are bits of rusting metal and scraps of parchment.  Whatever once furnished this room has vanished into hundreds of wooden fragments that lie in clumps throughout the mess.  Shattered shelves still cling to the walls."],"exits":[{"to":106,"exit":"north","move":"north"},{"to":102,"exit":"south","move":"south"}]},
  {"id":105,"x":480,"y":160,"z":0,"title":"Northeast Tower, Staircase","descriptions":["Clinging to the circular walls is a spiraling staircase that climbs upwards.  In places a wooden railing still hangs on to the inner edge of the risers, offering some protection to those attempting the climb.  Far overhead the dim shapes of the roofbeams can be made out."],"exits":[{"to":102,"exit":"south","move":"south"},{"to":107,"exit":"up","move":"up"}]},
  {"id":106,"x":520,"y":140,"z":0,"title":"Northeast Tower, Main Floor","descriptions":["Shoved against one wall near the doorway is a heap of simple cots jumbled together as if forming a barricade.  A few rotting bits of cloth still cling to the skeletons clustered near the stack, but nothing else remains of the long-dead owner's outfits."],"exits":[{"to":104,"exit":"east","move":"east"},{"to":103,"exit":"west","move":"west"}]},
  {"id":107,"x":480,"y":100,"z":0,"title":"Northeast Tower, Staircase","descriptions":["Clinging to the circular walls is a spiraling staircase that climbs upwards and descends downwards.  A semi-circular landing juts out from the open doorway on the south wall.  Far overhead the dim shapes of the roofbeams can be made out."],"exits":[{"to":108,"exit":"south","move":"south"},{"to":110,"exit":"up","move":"up"},{"to":105,"exit":"down","move":"down"}]},
  {"id":108,"x":520,"y":120,"z":0,"title":"Northeast Tower, Second Floor","descriptions":["One outer wall slab has cracked under extreme heat and reveals a gap that permits a narrow view of the outside.  The edges of the crevice are scorched and blackened with streaks of melted brass dripping down the walls from the destroyed inlay.  Bones from a skeleton lie scattered across the floor, with many of them crushed into powder."],"exits":[{"to":107,"exit":"north","move":"north"},{"to":116,"exit":"east","move":"east"},{"to":109,"exit":"west","move":"west"}]},
  {"id":109,"x":500,"y":100,"z":0,"title":"Northeast Tower, Second Floor","descriptions":["Sandstone walls are completely covered with inset niches designed to hold scrolls and books, yet nothing remains of their contents but layers of dust and heaps of scrap.  Any furnishings have long since been destroyed, contributing to the litter of wood chips and fragments on the slate floor."],"exits":[{"to":117,"exit":"north","move":"north"},{"to":108,"exit":"south","move":"south"}]},
  {"id":110,"x":480,"y":40,"z":0,"title":"Northeast Tower, Staircase","descriptions":["Clinging to the circular walls is a spiraling staircase that climbs upwards and descends downwards.  A semi-circular landing juts out from the open doorway on the south wall.  Overhead the roofbeams are charred and draped in cobwebs."],"exits":[{"to":112,"exit":"south","move":"south"},{"to":111,"exit":"up","move":"up"},{"to":107,"exit":"down","move":"down"}]},
  {"id":111,"x":480,"y":20,"z":0,"title":"Northeast Tower, Top of Tower","descriptions":["Emerging through the roof, the staircase ends at a small platform set on top of the tower.  A railing of sandstone blocks, carved into writhing figures with too many tentacles and mouths, prevents tumbling down the pitched roof into the ground below.  Centered into the middle of the floor is an inset circle of brass with purple enamel medallions set at irregular intervals."],"exits":[{"to":110,"exit":"down","move":"down"}]},
  {"id":112,"x":520,"y":60,"z":0,"title":"Northeast Tower, Third Floor","descriptions":["Contrasting with the rest of the tower, this chamber is devoid of decoration on plain sandstone walls or floor.  The wooden doorframe to the north is still intact and bears scratch marks much like those of the fingernails of someone being dragged against their will through the door to the stairwell."],"exits":[{"to":110,"exit":"north","move":"north"},{"to":113,"exit":"east","move":"east"},{"to":115,"exit":"west","move":"west"}]},
  {"id":113,"x":540,"y":40,"z":0,"title":"Northeast Tower, Third Floor","descriptions":["A narrow pathway runs down the center of the room, flanked on either side by metal bars set into the floor and extending to the ceiling.  Two poles from each cell have been roughly hacked away to allow the prisoners to escape."],"exits":[{"to":114,"exit":"north","move":"north"},{"to":112,"exit":"south","move":"south"}]},
  {"id":114,"x":520,"y":20,"z":0,"title":"Northeast Tower, Third Floor","descriptions":["A narrow pathway runs down the center of the room, flanked on either side by metal bars set into the floor and extending to the ceiling.  Although the doors are still shut and locked, something has bent the poles on the cells enough so that the prisoners could escape."],"exits":[{"to":113,"exit":"east","move":"east"},{"to":115,"exit":"west","move":"west"}]},
  {"id":115,"x":500,"y":40,"z":0,"title":"Northeast Tower, Third Floor","descriptions":["A narrow pathway runs down the center of the room, flanked on either side by metal bars set into the floor and extending to the ceiling.  The doors that once led into each cell are ripped off the hinges and lie on the floor, bent and mangled."],"exits":[{"to":114,"exit":"north","move":"north"},{"to":112,"exit":"south","move":"south"}]},
  {"id":116,"x":540,"y":100,"z":0,"title":"Northeast Tower, Second Floor","descriptions":["Concentric circles of inlaid brass radiate outwards from the center of the chamber.  A few blobs of wax still cling to floor around one ring, the only moveable objects in this room.  Designs of intertwined lines and circles done in brass and purple glass cover the buff sandstone walls, almost undamaged except for one spot that has been hacked out with some edged weapon."],"exits":[{"to":117,"exit":"north","move":"north"},{"to":108,"exit":"south","move":"south"}]},
  {"id":117,"x":520,"y":80,"z":0,"title":"Northeast Tower, Second Floor","descriptions":["Amazingly unscathed, a sturdy wooden desk stands in the middle of the room, its drawers open and empty.  Nothing else remains intact in the chamber, although a few broken shelves still cling to the walls.  Huddled in a corner is a slumped skeleton still wearing an intricate brass pendant around its neck."],"exits":[{"to":116,"exit":"east","move":"east"},{"to":109,"exit":"west","move":"west"}]},
  {"id":118,"x":255,"y":360,"z":0,"title":"Stone House, Interior","descriptions":["A single lantern casts a fitful light over the musty chamber.  Sand drifts in small rills on the stone floor, piling up in the corners."],"exits":[{"to":5,"exit":"go","move":"go makeshift door"}],"color":"#FF0000","aliases":["Stone House","house"]}
 ],
 "labels": [
  {"text":"Home","x":110,"y":350,"z":0},
  {"text":"Hut","x":210,"y":365,"z":0},
  {"text":"Ramp","x":200,"y":400,"z":0},
  {"text":"Ramp","x":260,"y":590,"z":0},
  {"text":"Gate","x":100,"y":520,"z":0},
