  {"id":575,"x":-840,"y":-300,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Riverhaven Room."],"exits":[{"to":562,"exit":"out","move":"out"}]},
  {"id":576,"x":-820,"y":-320,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Therenborough Room."],"exits":[{"to":562,"exit":"out","move":"out"}]},
  {"id":577,"x":-880,"y":-320,"z":0,"title":"Kirm Morzindu, Hall Of Champions","descriptions":["The West Wing of the Hall of Champions stretches off into the distance.  On the granite blocks of the outer wall, a marble half-column bears a gleaming brass lantern that lights the passageway.  Across from it, on the inner wall, green bunting with a gold fringe is draped above the entrances to the observation boxes."],"exits":[{"to":561,"exit":"east","move":"east"},{"to":578,"exit":"northwest","move":"northwest"},{"to":590,"exit":"go","move":"go birch door"},{"to":591,"exit":"go","move":"go oak door"}]},
  {"id":578,"x":-900,"y":-340,"z":0,"title":"Kirm Morzindu, Hall Of Champions","descriptions":["The West Wing of the Hall of Champions stretches off into the distance.  On the granite blocks of the outer wall, a marble half-column bears a gleaming brass lantern that lights the passageway.  Across from it, on the inner wall, green bunting with a gold fringe is draped above the entrances to the observation boxes."],"exits":[{"to":577,"exit":"southeast","move":"southeast"},{"to":579,"exit":"northwest","move":"northwest"},{"to":588,"exit":"go","move":"go birch door"},{"to":589,"exit":"go","move":"go oak door"}]},
  {"id":579,"x":-920,"y":-360,"z":0,"title":"Kirm Morzindu, Hall Of Champions","descriptions":["The West Wing of the Hall of Champions stretches off into the distance.  On the granite blocks of the outer wall, a half-column supports a marble basin beneath a spouting water fountain.  Across from it, on the inner wall, green bunting with a gold fringe is draped above the entrances to the observation boxes."],"exits":[{"to":578,"exit":"southeast","move":"southeast"},{"to":580,"exit":"northwest","move":"northwest"},{"to":586,"exit":"go","move":"go birch door"},{"to":587,"exit":"go","move":"go oak door"}]},
  {"id":580,"x":-940,"y":-380,"z":0,"title":"Kirm Morzindu, Hall Of Champions","descriptions":["The West Wing of the Hall of Champions stretches off into the distance.  On the granite blocks of the outer wall, a marble half-column bears a gleaming brass lantern that lights the passageway.  Across from it, on the inner wall, black bunting shot with silver threads is draped above the entrances to the observation boxes."],"exits":[{"to":579,"exit":"southeast","move":"southeast"},{"to":581,"exit":"northwest","move":"northwest"},{"to":584,"exit":"go","move":"go birch doo"},{"to":585,"exit":"go","move":"go oak door"}]},
  {"id":581,"x":-960,"y":-400,"z":0,"title":"Kirm Morzindu, Hall Of Champions","descriptions":["The West Wing of the Hall of Champions stretches off into the distance.  On the granite blocks of the outer wall, a marble half-column bears a gleaming brass lantern that lights the passageway.  Across from it, on the inner wall, black bunting shot with silver threads is draped above the entrances to the observation boxes."],"exits":[{"to":580,"exit":"southeast","move":"southeast"},{"to":582,"exit":"go","move":"go birch door"},{"to":583,"exit":"go","move":"go oak door"},{"to":566,"exit":"go","move":"go elevated walkway"}]},
  {"id":582,"x":-980,"y":-400,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Zaldi Taipa Room."],"exits":[{"to":581,"exit":"out","move":"out"}]},
  {"id":583,"x":-960,"y":-420,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Fayrin Room."],"exits":[{"to":581,"exit":"out","move":"out"}]},
  {"id":584,"x":-960,"y":-380,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Steelclaw Room."],"exits":[{"to":580,"exit":"out","move":"out"}]},
  {"id":585,"x":-920,"y":-380,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Shard Room."],"exits":[{"to":580,"exit":"out","move":"out"}]},
  {"id":586,"x":-940,"y":-360,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Dirge Room."],"exits":[{"to":579,"exit":"out","move":"out"}]},
  {"id":587,"x":-900,"y":-360,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Kaerna Room."],"exits":[{"to":579,"exit":"out","move":"out"}]},
  {"id":588,"x":-920,"y":-340,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words Room of the Clans."],"exits":[{"to":578,"exit":"out","move":"out"}]},
  {"id":589,"x":-880,"y":-340,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Arthe Dale Room."],"exits":[{"to":578,"exit":"out","move":"out"}]},
  {"id":590,"x":-900,"y":-320,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Leth Deriel Room."],"exits":[{"to":577,"exit":"out","move":"out"}]},
  {"id":591,"x":-880,"y":-300,"z":0,"title":"Kirm Morzindu, Observation Box","descriptions":["Walled on three sides and covered from the weather, the box commands an unobstructed view of the arena sands below.  Two banked stone benches extend from side to side to seat visitors.  Chiseled into the stone on the lintel are the words The Crossing Room."],"exits":[{"to":577,"exit":"out","move":"out"}]},
  {"id":592,"x":-940,"y":-440,"z":0,"title":"Kirm Morzindu, Equipment Room","descriptions":["Equipment of every sort almost fills the room where warriors and mages ready themselves for their contests.  Torchlight gleams on the burnished metal, and in the middle of it all, a large sign is fixed to the wall."],"exits":[{"to":595,"exit":"north","move":"north"},{"to":593,"exit":"east","move":"east"},{"to":594,"exit":"west","move":"west"},{"to":561,"exit":"out","move":"out"}],"aliases":["Equipment Room"]},
  {"id":593,"x":-920,"y":-440,"z":0,"title":"Kirm Morzindu, Temple Of Life","descriptions":["A fresco by a skilled artist covers one whole wall of this quiet room.  A long, polished table -- or perhaps it is an altar -- occupies the wall across from the painting.  The only other furniture in the room is a leather-cushioned chair."],"exits":[{"to":592,"exit":"west","move":"west"}],"aliases":["Temple Of Life"]},
  {"id":594,"x":-960,"y":-440,"z":0,"title":"Kirm Morzindu, Infirmary","descriptions":["Lanterns light the infirmary's whitewashed walls and a floor strewn with clean rushes.  A chest of medical supplies -- bandages, bottles, jars, and smaller boxes -- stands in the center of the room next to a big wooden tub."],"exits":[{"to":592,"exit":"east","move":"east"}],"color":"#00BF80","aliases":["Infirmary","Healer","Lindaius"]},
  {"id":595,"x":-940,"y":-460,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["Three large, adjoining rooms -- here and to the east and west -- provide access through the gate to the team competition areas of the arena.  Those thirsting to try their skill one-on-one head for the wings further east and west."],"exits":[{"to":596,"exit":"east","move":"east"},{"to":592,"exit":"south","move":"south"},{"to":597,"exit":"west","move":"west"},{"to":610,"exit":"go","move":"go large gate"}]},
  {"id":596,"x":-920,"y":-460,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["Sounds of booted feet echo from the stone walls as the corridor angles, following the curve of the arena outside.  To the northeast lie entrances to single combat areas, while the gate leads to those parts of the field reserved for team competition."],"exits":[{"to":603,"exit":"northeast","move":"northeast"},{"to":595,"exit":"west","move":"west"},{"to":613,"exit":"go","move":"go large gate"}]},
  {"id":597,"x":-960,"y":-460,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The contestants divide here, beneath torches high on the vaulted walls whose light flickers on boisterous or reluctant faces.  Those in singles matches head for the northwest corridor under the observation stands.  Those relying on their comrades-in-arms head through the gate for the team areas."],"exits":[{"to":595,"exit":"east","move":"east"},{"to":598,"exit":"northwest","move":"northwest"},{"to":608,"exit":"go","move":"go large gate"}]},
  {"id":598,"x":-980,"y":-480,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The roar of the crowd and the clash of metal echo down a long, stone-walled corridor beneath the observation boxes.  Along its dim recesses, the Kirmblars, the famous Blood Guard, invite the daring or foolhardy to compete in single combat and conduct them to their place of trial on the arena sands outside."],"exits":[{"to":597,"exit":"southeast","move":"southeast"},{"to":599,"exit":"northwest","move":"northwest"}]},
  {"id":599,"x":-1000,"y":-500,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The roar of the crowd and the clash of metal echo down a long, stone-walled corridor beneath the observation boxes.  Along its dim recesses, the Kirmblars, the famous Blood Guard, invite the daring or foolhardy to compete in single combat and conduct them to their place of trial on the arena sands outside."],"exits":[{"to":598,"exit":"southeast","move":"southeast"},{"to":600,"exit":"northwest","move":"northwest"}]},
  {"id":600,"x":-1020,"y":-520,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The roar of the crowd and the clash of metal echo down a long, stone-walled corridor beneath the observation boxes.  Along its dim recesses, the Kirmblars, the famous Blood Guard, invite the daring or foolhardy to compete in single combat and conduct them to their place of trial on the arena sands outside."],"exits":[{"to":599,"exit":"southeast","move":"southeast"},{"to":601,"exit":"northwest","move":"northwest"}]},
  {"id":601,"x":-1040,"y":-540,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The roar of the crowd and the clash of metal echo down a long, stone-walled corridor beneath the observation boxes.  Along its dim recesses, the Kirmblars, the famous Blood Guard, invite the daring or foolhardy to compete in single combat and conduct them to their place of trial on the arena sands outside."],"exits":[{"to":600,"exit":"southeast","move":"southeast"},{"to":602,"exit":"northwest","move":"northwest"}]},
  {"id":602,"x":-1060,"y":-560,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The roar of the crowd and the clash of metal echo down a long, stone-walled corridor beneath the observation boxes.  Along its dim recesses, the Kirmblars, the famous Blood Guard, invite the daring or foolhardy to compete in single combat and conduct them to their place of trial on the arena sands outside."],"exits":[{"to":601,"exit":"southeast","move":"southeast"}]},
  {"id":603,"x":-900,"y":-480,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The roar of the crowd and the clash of metal echo down a long, stone-walled corridor beneath the observation boxes.  Along its dim recesses, the Kirmblars, the famous Blood Guard, invite the daring or foolhardy to compete in single combat and conduct them to their place of trial on the arena sands outside."],"exits":[{"to":604,"exit":"northeast","move":"northeast"},{"to":596,"exit":"southwest","move":"southwest"}]},
  {"id":604,"x":-880,"y":-500,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The roar of the crowd and the clash of metal echo down a long, stone-walled corridor beneath the observation boxes.  Along its dim recesses, the Kirmblars, the famous Blood Guard, invite the daring or foolhardy to compete in single combat and conduct them to their place of trial on the arena sands outside."],"exits":[{"to":605,"exit":"northeast","move":"northeast"},{"to":603,"exit":"southwest","move":"southwest"}]},
  {"id":605,"x":-860,"y":-520,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The roar of the crowd and the clash of metal echo down a long, stone-walled corridor beneath the observation boxes.  Along its dim recesses, the Kirmblars, the famous Blood Guard, invite the daring or foolhardy to compete in single combat and conduct them to their place of trial on the arena sands outside."],"exits":[{"to":606,"exit":"northeast","move":"northeast"},{"to":604,"exit":"southwest","move":"southwest"}]},
  {"id":606,"x":-840,"y":-540,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The roar of the crowd and the clash of metal echo down a long, stone-walled corridor beneath the observation boxes.  Along its dim recesses, the Kirmblars, the famous Blood Guard, invite the daring or foolhardy to compete in single combat and conduct them to their place of trial on the arena sands outside."],"exits":[{"to":607,"exit":"northeast","move":"northeast"},{"to":605,"exit":"southwest","move":"southwest"}]},
  {"id":607,"x":-820,"y":-560,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["The roar of the crowd and the clash of metal echo down a long, stone-walled corridor beneath the observation boxes.  Along its dim recesses, the Kirmblars, the famous Blood Guard, invite the daring or foolhardy to compete in single combat and conduct them to their place of trial on the arena sands outside."],"exits":[{"to":606,"exit":"southwest","move":"southwest"}]},
  {"id":608,"x":-960,"y":-480,"z":0,"title":"Kirm Morzindu, Aleth Feas","descriptions":["Torches illuminate an expanse of hard-packed sand surrounded by a high fence.  From out of the darkness come the cheers and curses of the crowd, invisible but noisy in the stands above."],"exits":[{"to":609,"exit":"north","move":"north"},{"to":597,"exit":"out","move":"out"}]},
  {"id":609,"x":-960,"y":-500,"z":0,"title":"Kirm Morzindu, Aleth Feas","descriptions":["Torches illuminate an expanse of hard-packed sand surrounded by a high fence.  From out of the darkness come the cheers and curses of the crowd, invisible but noisy in the stands above."],"exits":[{"to":608,"exit":"south","move":"south"}]},
  {"id":610,"x":-940,"y":-480,"z":0,"title":"Kirm Morzindu, Aleth Feas","descriptions":["Torches illuminate an expanse of hard-packed sand surrounded by a high fence.  From out of the darkness come the cheers and curses of the crowd, invisible but noisy in the stands above."],"exits":[{"to":595,"exit":"out","move":"out"},{"to":611,"exit":"north","move":"north"}]},
  {"id":611,"x":-940,"y":-500,"z":0,"title":"Kirm Morzindu, Aleth Feas","descriptions":["Torches illuminate an expanse of hard-packed sand surrounded by a high fence.  From out of the darkness come the cheers and curses of the crowd, invisible but noisy in the stands above."],"exits":[{"to":612,"exit":"north","move":"north"},{"to":610,"exit":"south","move":"south"},{"to":616,"exit":"up","move":"up"},{"to":615,"exit":"down","move":"down"}]},
  {"id":612,"x":-940,"y":-540,"z":0,"title":"Kirm Morzindu, Aleth Feas","descriptions":["Torches illuminate an expanse of hard-packed sand surrounded by a high fence.  From out of the darkness come the cheers and curses of the crowd, invisible but noisy in the stands above."],"exits":[{"to":611,"exit":"south","move":"south"},{"to":615,"exit":"up","move":"up"},{"to":616,"exit":"down","move":"down"}]},
  {"id":613,"x":-920,"y":-480,"z":0,"title":"Kirm Morzindu, Hall Of Battle","descriptions":["Torches illuminate an expanse of hard-packed sand surrounded by a high fence.  From out of the darkness come the cheers and curses of the crowd, invisible but noisy in the stands above."],"exits":[{"to":596,"exit":"out","move":"out"},{"to":614,"exit":"north","move":"north"}]},
  {"id":614,"x":-920,"y":-500,"z":0,"title":"Kirm Morzindu, Aleth Feas","descriptions":["Torches illuminate an expanse of hard-packed sand surrounded by a high fence.  From out of the darkness come the cheers and curses of the crowd, invisible but noisy in the stands above."],"exits":[{"to":613,"exit":"south","move":"south"}]},
  {"id":615,"x":-960,"y":-520,"z":0,"title":"Kirm Morzindu, Aleth Feas","descriptions":["Torches illuminate an expanse of hard-packed sand surrounded by a high fence.  From out of the darkness come the cheers and curses of the crowd, invisible but noisy in the stands above."],"exits":[{"to":611,"exit":"up","move":"up"},{"to":612,"exit":"down","move":"down"}]},
  {"id":616,"x":-920,"y":-520,"z":0,"title":"Kirm Morzindu, Aleth Feas","descriptions":["Torches illuminate an expanse of hard-packed sand surrounded by a high fence.  From out of the darkness come the cheers and curses of the crowd, invisible but noisy in the stands above."],"exits":[{"to":612,"exit":"up","move":"up"},{"to":611,"exit":"down","move":"down"}]},
  {"id":617,"x":-680,"y":-280,"z":1,"title":"Shard, Smuggler's Bridge","descriptions":["Tall drooping trees form a protective circle around this tiny riverbank cove.  Although it is deserted now, scorched pits in the sand mark old campfires screened by the trees from the walls of Shard.  Looking at the river, the reason for the campsite becomes obvious--a row of abandoned stone pilings stretches out into the river, providing a way across besides the heavily guarded North Gate."],"exits":[{"to":66,"exit":"east","move":"east"},{"to":0,"exit":"south","move":"south"}],"aliases":["Thief"],"linksTo":"Map67a_Shard_Thief.xml"},
  {"id":618,"x":-440,"y":100,"z":1,"title":"Fang Cove, Fate's Fortune Lane","descriptions":["A towering marble archway opens a gap in the wall to the north and separates the ongoing construction and somewhat more refined completed structures of Fate's Fortune Lane from the crude structures and makeshift walkway along the beach.  The entrance to a squat, wide bungalow sits in opposition to the arch, and the sheltering cliffs of Fang's Peak rise up from behind it.  To either side of the arch, cobblestones of different shapes and sizes have been laid out to form the wide Fate's Fortune Lane."],"exits":[{"to":0,"exit":"north","move":"north"},{"to":0,"exit":"east","move":"east"},{"to":0,"exit":"west","move":"west"},{"to":44,"exit":"go","move":"go exit portal"}],"linksTo":"Map150_Fang_Cove.xml"},
  {"id":619,"x":-513,"y":-370,"z":0,"title":"Eastern Fields, Roadway","descriptions":["A low, soft mist slowly crawls across the ground, reducing visibility to only a few paces in any direction.  The sound of swiftly moving water disrupts the unearthly calm, though the resounding echoes make it impossible to determine its source.  Faint silhouettes of tall giants with menacingly long arms, hands and claws play at the edges of the fog before resolving into the benign forms of gnarled trees."],"exits":[{"to":620,"exit":"southeast","move":"southeast"},{"to":635,"exit":"northwest","move":"northwest"}]},
  {"id":620,"x":-503,"y":-360,"z":0,"title":"Eastern Fields, Roadway","descriptions":["The blackened lower branches of the few remaining trees along the fence are evidence of a fire that swept across much of this stretch of the winding road in the recent past.  Where old life once dominated, new life in the form of smaller shrubs and tall grasses has already taken root and started to conceal the farmlands' wounds."],"exits":[{"to":621,"exit":"south","move":"south"},{"to":619,"exit":"northwest","move":"northwest"}]},
  {"id":621,"x":-503,"y":-330,"z":0,"title":"Eastern Fields, Roadway","descriptions":["A curious and unsettling silence hangs heavily over the fog-shrouded countryside.  What little light there is succeeds only in creating eerie phantoms that dance wildly in the lingering mists.  A single oak, tall and majestic, crowns the summit and remains unmarred by the fiery devastation afflicting surrounding areas.  A series of deep marks are clawed into the bark of the tree.","A great vista of fog-shrouded, abandoned and charred fields stretches out in all directions from this elevated rise in the road.  A single oak, tall and majestic, crowns the summit and remains unmarred by the devastation of the lower areas.  Though the whole region is in ruins, the fields to the west are the most damaged.  Though untouched by the fire, deep marks are clawed into the bark of the tree."],"exits":[{"to":620,"exit":"north","move":"north"},{"to":630,"exit":"northeast","move":"northeast"},{"to":626,"exit":"southwest","move":"southwest"},{"to":622,"exit":"northwest","move":"northwest"}]},
  {"id":622,"x":-513,"y":-340,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["Thick, heavy fog obscures much of the damage from the fire that raged across the farmlands.  Numerous charred wooden stakes rise up out of the ground at even intervals and would appear to be the remains of a young orchard that was blackened into ruins in its infancy."],"exits":[{"to":625,"exit":"north","move":"north"},{"to":621,"exit":"southeast","move":"southeast"},{"to":624,"exit":"west","move":"west"},{"to":623,"exit":"northwest","move":"northwest"}]},
  {"id":623,"x":-523,"y":-350,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["Thick, heavy fog obscures much of the damage from the fire that raged across the farmlands.  The remains of a blackened fence that once protected the young orchard from wildlife emerge from the shrouding mists in the form of charred posts every few paces."],"exits":[{"to":625,"exit":"east","move":"east"},{"to":622,"exit":"southeast","move":"southeast"},{"to":624,"exit":"south","move":"south"}]},
  {"id":624,"x":-523,"y":-340,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["Thick, heavy fog obscures much of the damage from the fire that raged across the farmlands.  The lingering scent of charred wood mingles with the thick, water-saturated air.  Even with the surroundings fallen into a ruined, lifeless mess, a passing animal's scent is strong in the area."],"exits":[{"to":623,"exit":"north","move":"north"},{"to":625,"exit":"northeast","move":"northeast"},{"to":622,"exit":"east","move":"east"}]},
  {"id":625,"x":-513,"y":-350,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["Badly leaning, the remains of a wooden tool shed emerge from the shifting fogs that obscure the view.  The door is noticeably missing, though its hinges still hang in their rightful places.  Though the sounds of the night's creatures are hauntingly absent, dark shadows dance ominously within the slow-moving murk obscuring the view."],"exits":[{"to":622,"exit":"south","move":"south"},{"to":624,"exit":"southwest","move":"southwest"},{"to":623,"exit":"west","move":"west"}]},
  {"id":626,"x":-513,"y":-320,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["Though not as elevated as the hill at the farm's center, these fields are artificially raised above other areas to allow for better drainage during the rainy seasons.  Countless cracks snake their way across the scorched grounds, a sign of just how hot the fires were burning when they swept through.  The heavy mists, while prevalent elsewhere in the distance, fail to crest the upraised cropland."],"exits":[{"to":621,"exit":"northeast","move":"northeast"},{"to":628,"exit":"south","move":"south"},{"to":627,"exit":"southwest","move":"southwest"},{"to":629,"exit":"west","move":"west"}]},
  {"id":627,"x":-523,"y":-310,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["A narrow crevice runs at a tangent to the base of the raised field and is fed by a series of smaller grooves sloping down from the end of each row.  Deep gouges in the soil, however, show that little rainfall has a chance to make it to the drainage ditch before being soaked up by the parched ground.  A stone's throw away, the line of charred trees gives way to living foliage once more."],"exits":[{"to":629,"exit":"north","move":"north"},{"to":626,"exit":"northeast","move":"northeast"},{"to":628,"exit":"east","move":"east"}]},
  {"id":628,"x":-513,"y":-310,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["Narrowly spaced rows run from east to west, sloping downward in either direction from their peak in the center.  Blackened pieces of thin but strong wire encircle charred wooden poles and are all that remain of the supports used to keep overburdened vines and stalks from snapping under their own weight.  A nearby line of trees marks one boundary to the fiery devastation, though the underbrush is noticeably absent."],"exits":[{"to":626,"exit":"north","move":"north"},{"to":627,"exit":"west","move":"west"},{"to":629,"exit":"northwest","move":"northwest"}]},
  {"id":629,"x":-523,"y":-320,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["Clinging to the gulley between fields, errant tendrils of mist stretch to reach the raised field.  Though none visibly succeed in making the climb, the air is heavy with the fog's moisture, causing the topsoil to be soggy.  Tiny patches of green can be seen as new grasses try to make their living in the wounded earth.  A series of hoof prints near one such clumping mark the curiosity of a small animal -- a deer or goat, perhaps."],"exits":[{"to":626,"exit":"east","move":"east"},{"to":628,"exit":"southeast","move":"southeast"},{"to":627,"exit":"south","move":"south"}]},
  {"id":630,"x":-493,"y":-340,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["The ground rises sharply to the southwest, and a tall oak tree is visible above the thick fogs that hug the ground of the hill's base.  The mount is barren at its base, a sign that new life has yet to take root after the damage of the fires.  The roar of rushing water can clearly be heard to the northeast."],"exits":[{"to":633,"exit":"north","move":"north"},{"to":632,"exit":"northeast","move":"northeast"},{"to":631,"exit":"east","move":"east"},{"to":621,"exit":"southwest","move":"southwest"}]},
  {"id":631,"x":-483,"y":-340,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["Clinging to the ground, a light mist nearly obscures the makeshift bridge leading to the unburned farmhouse to the north.  The smell of charred wood lingers, though little evidence of the tall trees of the farm's elder orchard remains."],"exits":[{"to":632,"exit":"north","move":"north"},{"to":630,"exit":"west","move":"west"},{"to":633,"exit":"northwest","move":"northwest"}]},
  {"id":632,"x":-483,"y":-350,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["Stacks of metal buckets line the bank of the creek, many of them heavily rusted from being exposed to the harsh elements for an extended period.  A wooden sign has been staked into the ground near an abandoned farmhouse.  Vandals have broken the windows of the structure and knocked the door from its hinges.  A natural bridge of steppingstones reaches across the swiftly moving water to the blackened banks of the western side, and a rickety temporary bridge crosses to the south."],"exits":[{"to":631,"exit":"south","move":"south"},{"to":630,"exit":"southwest","move":"southwest"},{"to":633,"exit":"west","move":"west"},{"to":634,"exit":"go","move":"go abandoned farmhouse"}]},
  {"id":633,"x":-493,"y":-350,"z":0,"title":"Derbycrop's Farmlands, Burned Fields","descriptions":["A natural bridge of large steppingstones links one bank to the other across a wide, swiftly moving creek to the east.  Though the ground is devoid of life on this side, the stream was enough to halt the advance of the fire.  All that remain of the efforts to save the farm are rusted metal pails, abandoned as the inferno forced those fighting the blaze to surrender their hold on this side of the stream."],"exits":[{"to":632,"exit":"east","move":"east"},{"to":631,"exit":"southeast","move":"southeast"},{"to":630,"exit":"south","move":"south"}]},
  {"id":634,"x":-466,"y":-350,"z":0,"title":"Derbycrop's Farmhouse, Living Area","descriptions":["Abandoned trinkets and other family relics still sit upon their shelves, untouched by the chaos outside except for the thick coating of dust and smoke stains.  Children's toys and clothes hanging in a closet can be seen in a nearby, doorless room, and the kitchen's furnishings lie in another room on the opposite side of the living area.  A bedroll rests in one corner and shows signs of recent use while a spinning wheel sits in front of a heavy oak mantelpiece in another."],"exits":[{"to":632,"exit":"out","move":"out"}]},
  {"id":635,"x":-523,"y":-380,"z":0,"title":"Eastern Fields, Roadway","descriptions":["Open fields of golden grains stretch out into the distance on either side of the narrow road.  Seldom are the hearty stalks stationary, as even the slightest of breezes causes them to ripple in vast waves.  Vibrant, contrasting colors dot the fields as wildflowers and other colorful foliage stake their claim to the now-untended fields.  The smell and feel of moisture is heavy in the air."],"exits":[{"to":619,"exit":"southeast","move":"southeast"},{"to":224,"exit":"go","move":"go gateway"}]},
  {"id":636,"x":-280,"y":200,"z":0,"title":"Prairie, Sunbeam Circle","descriptions":["Thick as molasses, a wide fringe of shadowy grass naturally creates privacy for the rustic neighborhood.  Large homesteads encircle the main dirt road, each structure separated by bountiful tracts of land and plenty of fresh open air.  The darkness of night emphasizes every crisp sound from the wild beyond the houses.","Thick and dense, a wide fringe of golden brown grass naturally creates privacy for the rustic neighborhood.  Large homesteads encircle the main dirt road, each structure separated by bountiful tracts of land and plenty of fresh open air.  Undertones of pleasant conversation waft from an open window nearby, along with the enticing aroma of a hearty home-cooked meal."],"exits":[{"to":637,"exit":"northeast","move":"northeast"},{"to":642,"exit":"east","move":"east"},{"to":639,"exit":"northwest","move":"northwest"},{"to":38,"exit":"go","move":"go wooden gate"}],"color":"#00FFFF","aliases":["Sunbeam Circle"]},
  {"id":637,"x":-260,"y":180,"z":0,"title":"Sunbeam Circle, Campfire","descriptions":["Glowing embers inside the communal hearth fight the blackness, managing to persevere through the night.  Chilly breezes kick up the ash surrounding the fire pit's bricks and send the flakes skyward like backwards snow.  Candlelight flickers inside the nearby houses to match the stars above, at least in spirit.","Wisps of smoke rise from the embers of the communal hearth in the center of the small neighborhood.  Ash mixes with dirt around the fire pit's bricks and clings to passersby like fond memories.  Children from the nearby homes occasionally test their mettle against the rising flames, at least until parental reprimands end their mischievous games."],"exits":[{"to":640,"exit":"northeast","move":"northeast"},{"to":641,"exit":"east","move":"east"},{"to":642,"exit":"southeast","move":"southeast"},{"to":636,"exit":"southwest","move":"southwest"},{"to":639,"exit":"west","move":"west"},{"to":638,"exit":"northwest","move":"northwest"}],"aliases":["Sunbeam Circle","Campfire"]},
  {"id":638,"x":-280,"y":160,"z":0,"title":"Prairie, Sunbeam Circle","descriptions":["Stray bits of hay carpet the dirt pathway, looking like tendrils of aether against a void of blackness.  A host of nighttime sounds drifts through the neighborhood, the typical people noises replaced by the nocturnal animal songs and insect rhythms.  The darkness offers a respite for the farmers and their kin, who will wake up to continue the daily grind at the first hint of dawn.","Stray bits of hay carpet the dirt pathway to mask the muddy patches and fill in the furrows from carts and horseshoes.  A host of busy sounds drifts through the neighborhood as if carried on the backs of the many insects floating from tree to tree.  There is never a dull moment for the farmers and their kin with the abundance of work required to maintain a comfortable living."],"exits":[{"to":640,"exit":"east","move":"east"},{"to":637,"exit":"southeast","move":"southeast"},{"to":639,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":639,"x":-300,"y":180,"z":0,"title":"Prairie, Sunbeam Circle","descriptions":["Dark grasses border the path, nearly indistinguishable from the dirt.  A few tree stumps among the wavy stalks serve as perfect seats for neighbors to relax and watch the theater of stars.  Night brings calm to the circle, though the flora still sways in a restless dance upon the breeze.","Golden grasses border the dirt path, with some stalks managing to survive the trampling of hooves and feet.  Neighbors move around the area at a relaxed pace to ensure the day is enjoyed to its fullest.  A few tree stumps, relieved of their burdensome trunks, stick out like sore thumbs from the wavy wash of sun-bleached flora."],"exits":[{"to":638,"exit":"northeast","move":"northeast"},{"to":637,"exit":"east","move":"east"},{"to":636,"exit":"southeast","move":"southeast"}],"color":"#00FFFF"},
  {"id":640,"x":-240,"y":160,"z":0,"title":"Prairie, Sunbeam Circle","descriptions":["Waves of tall grass shudder like kite strings dangling from the night sky.  Barn owls hoot in the distance, and it's not hard to imagine rodents cowering at the warning.  Though normally a focal point of activity during the day, the community well stands unbothered at the edge of the dirt path.","Pollen gilds the tall grass like gold leaf, brightened even more by the effervescent daylight.  Friendly dogs whip up and down the dirt path, frolicking between houses and letting children chase their tails.  Shallow, muddy puddles surround the community well as a result of repeated usage and leaky buckets."],"exits":[{"to":641,"exit":"southeast","move":"southeast"},{"to":637,"exit":"southwest","move":"southwest"},{"to":638,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":641,"x":-220,"y":180,"z":0,"title":"Prairie, Sunbeam Circle","descriptions":["Blue cornflowers appear as tiny soldiers infiltrating the confines of one resident's modest garden.  Visible in the lamplight from a nearby homestead, chalk dust outlines a rudimentary hopscotch course for use by the neighborhood's children when boredom strikes.  Creaking tree branches and whispering leaves accompany the hummed lullabies gliding through opened windows.","Blue cornflowers spread color and cheer from the confines of one resident's modest garden.  Chalk dust in the middle of the dirt path outlines a rudimentary hopscotch course for use by the neighborhood's children when boredom strikes.  Creaking porch floorboards and clapping barn doors accompany the hummed tunes and whistled melodies of people passing by."],"exits":[{"to":642,"exit":"southwest","move":"southwest"},{"to":637,"exit":"west","move":"west"},{"to":640,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":642,"x":-240,"y":200,"z":0,"title":"Prairie, Sunbeam Circle","descriptions":["A wooden door stands ajar, though the premises are no doubt under the strict watch of a diligent tomcat on the prowl for nocturnal trespassers.  The main road is mostly clear of the usual wagons and wheelbarrows save for the occasional weary traveler or nighttime delivery.  Beyond the homesteads, the dark sky seems to stretch forever above the expanse of grain and grass.","A fat tomcat reclines in the shade of a red wooden door, keeping a nonchalant yet vigilant eye on the barn for any rodent trespassers.  Wagons and wheelbarrows occasionally clatter by and leave distinctive ruts in the hay-covered dirt path.  Energetic children often scurry along the road to run errands for their parents or continue games of tag or hide-and-seek with their mates."],"exits":[{"to":641,"exit":"northeast","move":"northeast"},{"to":636,"exit":"west","move":"west"},{"to":637,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":643,"x":-120,"y":-880,"z":0,"title":"Dragon's Spine, Path","descriptions":["Stone steps provide entrance and exit for an icy paradise.  A faint pathway follows a ledge, snaking by caverns on one side and a steep drop-off on the other, with everything sparkling from a pristine coating of snow."],"exits":[{"to":644,"exit":"north","move":"north"},{"to":164,"exit":"go","move":"go step"},{"to":646,"exit":"go","move":"go cavern"}]},
  {"id":644,"x":-120,"y":-893,"z":0,"title":"Dragon's Spine, Path","descriptions":["The ledge is wide enough that the snow-covered path curves around a fallen tree, its branches encrusted with ice crystals.  Snow and ice crunch underfoot, but the mountain wind quickly erases almost every trace that anything or anyone has been through here."],"exits":[{"to":645,"exit":"north","move":"north"},{"to":643,"exit":"south","move":"south"},{"to":647,"exit":"go","move":"go cavern"}]},
  {"id":645,"x":-120,"y":-907,"z":0,"title":"Dragon's Spine, Path","descriptions":["Fallen branches and other debris from above litter the path as it widens into a small grove of ice-covered pine trees.  Their needles shiver in the wind, causing an odd rattling sound like bones clicking together.  Occasionally, a branch will creak and ice will fall to the ground below, echoing in the frosty air like lunatic fae laughter."],"exits":[{"to":644,"exit":"south","move":"south"},{"to":648,"exit":"go","move":"go cavern"},{"to":650,"exit":"go","move":"go grove"}]},
  {"id":646,"x":-107,"y":-880,"z":0,"title":"Frostweaver's Den","descriptions":["Snow-filled beds of carved rock make comfortable sleeping areas for the icy inhabitants.  Slabs of ice form decorative mirrors, with swirls of snowflakes along their edges.  Wind blows through the crevices and entrances to this wide open home of the Frostweavers."],"exits":[{"to":647,"exit":"north","move":"north"},{"to":643,"exit":"out","move":"out"}]},
  {"id":647,"x":-107,"y":-893,"z":0,"title":"Frostweaver's Den","descriptions":["Blood has pooled and quickly freezes at your feet as wicked ladies dance among the snow and ice.  Eerie laughter fills the air and echoes along the cavern - a curious mingling of hysterical giggles and shrill screams."],"exits":[{"to":648,"exit":"north","move":"north"},{"to":646,"exit":"south","move":"south"},{"to":644,"exit":"out","move":"out"}]},
  {"id":648,"x":-107,"y":-907,"z":0,"title":"Frostweaver's Den","descriptions":["Ice-covered bones are piled in a corner where even mice fear to tread.  Snow dances in circles across the cold ground, blown by the whistling wind, while hunters shiver as they make their way through the caverns."],"exits":[{"to":649,"exit":"east","move":"east"},{"to":647,"exit":"south","move":"south"},{"to":645,"exit":"out","move":"out"}]},
  {"id":649,"x":-93,"y":-907,"z":0,"title":"Frostweaver's Den","descriptions":["This tiny alcove, barely lit by small phosphorescent stones, is covered from ceiling to floor in faint images of maiden warriors.  Each of the blue-painted warriors holds a sword in her hand, plunged deeply into her opponent's chest."],"exits":[{"to":648,"exit":"west","move":"west"}]},
  {"id":650,"x":-120,"y":-920,"z":0,"title":"Dragon's Spine, Grove","descriptions":["The path ends here, among tall, stark pine trees covered with ice and snow.  Drifts of delicate cold crystals form a ghostly landscape against the trunks of the outer trees, while only a few paces in, the ground is barely covered at all.  In the snow that exists, faint footprints lead off in different directions."],"exits":[{"to":651,"exit":"north","move":"north"},{"to":654,"exit":"northeast","move":"northeast"},{"to":645,"exit":"south","move":"south"},{"to":653,"exit":"northwest","move":"northwest"}],"color":"#008000"},
  {"id":651,"x":-120,"y":-933,"z":0,"title":"Dragon's Spine, Grove","descriptions":["Towering pine trees lend a dark, brooding cast to the night.  Claw marks mar their trunks, and some have gashes so deep, it almost appears that the frozen sap is all that holds the tree upright.","Towering pine trees block most of the light, casting a greenish-blue tinge over everything below them.  Claw marks mar their trunks, and some have gashes so deep, it almost appears that the frozen sap is all that holds the tree upright."],"exits":[{"to":652,"exit":"north","move":"north"},{"to":650,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":652,"x":-120,"y":-947,"z":0,"title":"Dragon's Spine, Grove","descriptions":["The trees thin out slightly here, giving opportunity for shafts of moonlight to fall between them and turn the snow into a patchwork of cool blue-green expanses broken by glittering patches that refract to every color of the rainbow.  The shadows that remain seem darker and more ominous by comparison.","The trees thin out slightly here, giving opportunity for shafts of light to fall between them and turn the snow into a patchwork of cool blue-green expanses broken by glittering patches that refract to every color of the rainbow.  The shadows that remain seem darker and more ominous by comparison."],"exits":[{"to":651,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":653,"x":-133,"y":-933,"z":0,"title":"Dragon's Spine, Grove","descriptions":["Abruptly, the grove ends with one tree standing precariously on the edge of the cliff.  Some of its roots have become exposed as time erodes away the cliff face, leaving it dangerously close to becoming the next victim of gravity."],"exits":[{"to":650,"exit":"southeast","move":"southeast"}],"color":"#008000"},
  {"id":654,"x":-107,"y":-933,"z":0,"title":"Dragon's Spine, Grove","descriptions":["A break in the trees reveals a cave entrance nearly covered in ice.  Someone has taken the time to break the ice, enabling even a Gor'Tog to enter.  The chips of ice surrounding the cave have become quite slippery, as several outlines in the snow show."],"exits":[{"to":650,"exit":"southwest","move":"southwest"},{"to":655,"exit":"go","move":"go cave"}],"color":"#008000"},
  {"id":655,"x":-107,"y":-947,"z":0,"title":"Natty's Cave","descriptions":["As your eyes adjust to the dim light within this cave, a wave of warmth rolls over you.  It emanates from a fire pit encircled by large, rough stones.  A few Gnomes, trappers judging by their garments of snowbeast hides, huddle around the fire, their cheeks reddened from standing so close to the flames.  Various skins and pelts are piled by type along the walls, almost covering a large keg that has seen better days."],"exits":[{"to":654,"exit":"out","move":"out"},{"to":703,"exit":"go","move":"go candle-lit alcove"}],"color":"#00FF00","aliases":["Natty","Premium Bundles"]},
  {"id":656,"x":-480,"y":-400,"z":0,"title":"Almalne Alolan, Golden Field","descriptions":["Tall grasses hold a golden tone as they sway and rustle with any breeze.  Tiny red and purple hollyhocks dare to poke their heads between the stalks, their bright colors a striking contrast to the otherwise monochrome field.  A heavy gate stands between the field and the nearby road."],"exits":[{"to":657,"exit":"north","move":"north"},{"to":109,"exit":"go","move":"go heavy gate"}],"aliases":["Almalne Alolan","prereni"]},
  {"id":657,"x":-480,"y":-420,"z":0,"title":"Almalne Alolan, Golden Field","descriptions":["Meadow thistles attempt to gain a hold against the tall stalks of grass, their stems and leaves covered in tiny but sharp thorns.  Topping the prickling plants are the fuzzy purple heads of the flowers.  A trail winds through the field, branching off toward a stream in one direction and a grove of trees in another."],"exits":[{"to":658,"exit":"north","move":"north"},{"to":659,"exit":"east","move":"east"},{"to":656,"exit":"south","move":"south"}]},
  {"id":658,"x":-480,"y":-440,"z":0,"title":"Almalne Alolan, Briar Bramble","descriptions":["The grass gives way to the tangled briar bramble that grows unchecked along the line of Ilithic apple trees.  Buds of pale pink and fully bloomed roses spot the deep green with their delicate hues.  An occasional rustle or the sound of birdsong comes from within the bushes where many an animal probably makes its home."],"exits":[{"to":657,"exit":"south","move":"south"},{"to":664,"exit":"go","move":"go briar bramble"}],"aliases":["Briar Bramble"]},
  {"id":659,"x":-460,"y":-420,"z":0,"title":"Almalne Alolan, Quiet Stream","descriptions":["The soft sounds of the stream disturb the quiet of the field, its banks giving a home to thick, soft moss sprinkled with drops of water and tiny blue sweet pea flowers.  Large stones are set in an almost even row across the water, their surfaces shiny and damp."],"exits":[{"to":657,"exit":"west","move":"west"},{"to":660,"exit":"go","move":"go large stones"}]},
  {"id":660,"x":-440,"y":-440,"z":0,"title":"Almalne Alolan, Quiet Stream","descriptions":["The tinkling of the water past the stones in the stream creates a musical counterpoint to the soft rustling of the grasses.  A golden raspberry bush grows beside the water, its branches untrimmed as it stretches from side to side threatening the faint path that leads north."],"exits":[{"to":662,"exit":"south","move":"south"},{"to":659,"exit":"go","move":"go stream"},{"to":661,"exit":"go","move":"go faint path"}]},
  {"id":661,"x":-420,"y":-440,"z":0,"title":"Almalne Alolan, Orchard Edge","descriptions":["Blocked from getting a day's worth of sunlight by the stately row of Ilithic apple trees, the grass at the edge of the field grows low to the ground.  A path winds back southward, showing brown through the green and gold of the grass."],"exits":[{"to":663,"exit":"north","move":"north"},{"to":660,"exit":"go","move":"go path"}]},
  {"id":662,"x":-440,"y":-420,"z":0,"title":"Almalne Alolan, Quiet Stream","descriptions":["A tangled golden raspberry bush makes its home here, almost completely blocking access to the stream that runs past to the west.  Poking through the stems of the wild plant are a few pale pink trilliums.  The grass is shorter here, threatening to tangled the ankles of anyone who passes through carelessly."],"exits":[{"to":660,"exit":"north","move":"north"}]},
  {"id":663,"x":-420,"y":-460,"z":0,"title":"Almalne Alolan, In the Trees","descriptions":["A strange silence seems to rule for a moment under the branches of these ancient Ilithic apple trees, only to be broken by the high pitched call of one squirrel to another.  Untrimmed for uncountable years, the tree limbs have tangled together into what appears to be an impenetrable maze."],"exits":[{"to":661,"exit":"south","move":"south"},{"to":679,"exit":"go","move":"go passage"}]},
  {"id":664,"x":-460,"y":-460,"z":0,"title":"Almalne Alolan, Orchard Edge","descriptions":["Ancient Ilithic apple trees stretch their heavy, twisting branches toward the sky.  The thick trunks stand in straight lines, showing that this was once an orchard, likely long abandoned.  Leaves and sticks create a carpet of noise, which threatens to crunch with any movement across them.  A faint trail winds through a briar patch to the nearby field."],"exits":[{"to":665,"exit":"north","move":"north"},{"to":666,"exit":"west","move":"west"},{"to":658,"exit":"go","move":"go faint trail"}]},
  {"id":665,"x":-460,"y":-480,"z":0,"title":"Almalne Alolan, Ancient Tree","descriptions":["Larger than its nearby brethren, a huge twisting Ilithic apple tree towers over its neighbors.  Sprouting from the trunk are branches that droop to the ground due to their great weight, blocking the way past.  High in the branches, mostly hidden from below, a structure can just be made out."],"exits":[{"to":664,"exit":"south","move":"south"}],"aliases":["Ancient Tree"]},
  {"id":666,"x":-480,"y":-460,"z":0,"title":"Almalne Alolan, Fallen Tree","descriptions":["One of the Ilithic apple trees has succumbed to nature and fallen to the ground, half of its branches broken and lost under its bulk.  Smaller plants have started to take root upon the decaying tree, a living display of new growth taking the place of old."],"exits":[{"to":664,"exit":"east","move":"east"},{"to":667,"exit":"climb","move":"climb apple tree"}]},
  {"id":667,"x":-500,"y":-460,"z":0,"title":"Almalne Alolan, Fallen Tree","descriptions":["Many smaller plants have taken advantage of the fallen apple tree and its nourishing decay to grow upon the trunk.  Standing out with their bright, fiery hues is a grouping of Ilithic irises.  A small nest can be made out in one of the higher branches that hasn't broken off."],"exits":[{"to":668,"exit":"north","move":"north"},{"to":669,"exit":"south","move":"south"},{"to":666,"exit":"climb","move":"climb apple tree"}]},
  {"id":668,"x":-500,"y":-480,"z":0,"title":"Almalne Alolan, New Growth","descriptions":["Newer trees have started growing here near the edge of the grove, their size, while still large, is smaller than their neighbors to the east.  A single sapling grows out of line, its height not even that to rival a Gor'Tog, and its branches remain thin as they strive to grow to match the other trees."],"exits":[{"to":667,"exit":"south","move":"south"}],"aliases":["New Growth"]},
  {"id":669,"x":-500,"y":-440,"z":0,"title":"Almalne Alolan, Under the Branches","descriptions":["Once in a while a bird calls out to break the silence of the grove, unseen from some perch among the branches of the stately Ilithic apple trees.  Game trails wind through the debris on the ground, showing where animals make their way through the orchard."],"exits":[{"to":667,"exit":"north","move":"north"}]},
  {"id":670,"x":-540,"y":-180,"z":0,"title":"Crystal Shore, Pier","descriptions":["The crystalline pier soars ethereally over the still lake, as if straining for the pristine white walls that define the city of Shard.  Every pearly imperfection in the surface scatters the daylight into prismatic splays.  An elderly fisherman whiles away the last of his days in his usual perch at the end.  Gaethzen orbs dot the adjacent copperleaf trees as if seeking refuge amongst the tinkling leaves."],"exits":[{"to":559,"exit":"go","move":"go lake shore"}],"aliases":["Crystal Shore","Pier"]},
  {"id":671,"x":-600,"y":-480,"z":0,"title":"Almalne Alolan, Grassy Road","descriptions":["Winding through farmland, the ruts show the rich brown dirt under the strands of green grass.  Growing between the golden grain fields and the road are alyssum bushes, their dense branches bearing clusters of white flowers.  An ornate wrought iron gate is set into a break in the bushes."],"exits":[{"to":110,"exit":"east","move":"east"},{"to":672,"exit":"west","move":"west"},{"to":681,"exit":"go","move":"go iron gate"}],"color":"#00FFFF","aliases":["Almalne Alolan"]},
  {"id":672,"x":-610,"y":-480,"z":0,"title":"Almalne Alolan, Grassy Road","descriptions":["Azalea bushes flourish along the sides of the road as the grain fields give way to rows of Ilithic apple tree saplings.  Their branches are spindly and many of them are no higher than a Gor'Tog is tall.  Positioned on one side of the road is a fancy wrought iron gate."],"exits":[{"to":671,"exit":"east","move":"east"},{"to":673,"exit":"west","move":"west"},{"to":749,"exit":"go","move":"go iron gate"}],"color":"#00FFFF"},
  {"id":673,"x":-620,"y":-480,"z":0,"title":"Almalne Alolan, Grassy Road","descriptions":["Saplings give way to older apple trees, some of their branches gnarled and entwined with those of the tree next to them.  The grass is sparser but still holding onto a rich green hue as it follows the track through the orchard.  A faint pathway leads away from an elaborately carved wooden gate."],"exits":[{"to":672,"exit":"east","move":"east"},{"to":674,"exit":"west","move":"west"},{"to":750,"exit":"go","move":"go wooden gate"}],"color":"#00FFFF"},
  {"id":674,"x":-630,"y":-480,"z":0,"title":"Almalne Alolan, Grassy Road","descriptions":["Mature Ilithic apple trees form stately lines along each side of the road, their branches thick with age.  Making their home near the base of one tree is a patch of forest violets showing off their bright hues.  Lavishly carved, a wooden gate stands at the end of a path."],"exits":[{"to":673,"exit":"east","move":"east"},{"to":675,"exit":"west","move":"west"},{"to":751,"exit":"go","move":"go wooden gate"}],"color":"#00FFFF"},
  {"id":675,"x":-640,"y":-480,"z":0,"title":"Almalne Alolan, Grassy Road","descriptions":["Ancient and twisted, the trees along this part of the road all seem to have different personalities due to their varied shapes.  One hunches over to the side, while another sends branches to sweep the ground almost blocking the lane.  Placed between two of these monoliths is a delicately carved wooden gate."],"exits":[{"to":674,"exit":"east","move":"east"},{"to":676,"exit":"west","move":"west"},{"to":752,"exit":"go","move":"go carved gate"}],"color":"#00FFFF"},
  {"id":676,"x":-650,"y":-480,"z":0,"title":"Almalne Alolan, Grassy Road","descriptions":["The lines of Ilithic apple trees thin out and are smaller than their towering neighbors to the east allowing patches of monkshood to grow among the grasses.  They bloom in a multitude of colors, one patch showing white, another purple and a third yellow.  Set to one side of the roadway is a gracefully carved wooden gate."],"exits":[{"to":675,"exit":"east","move":"east"},{"to":677,"exit":"west","move":"west"},{"to":753,"exit":"go","move":"go wooden gate"}],"color":"#00FFFF"},
  {"id":677,"x":-660,"y":-480,"z":0,"title":"Almalne Alolan, Grassy Road","descriptions":["Giving way to fields again, the orchard's edge is planted with wood roses that display petals a shade of pink that is tipped with lavender.  Dense grasses threaten to hide the road itself, their shades of green richly hued.  A gate of artfully wrought iron stands between two of the bushes."],"exits":[{"to":676,"exit":"east","move":"east"},{"to":678,"exit":"west","move":"west"},{"to":754,"exit":"go","move":"go gate"}],"color":"#00FFFF"},
  {"id":678,"x":-670,"y":-480,"z":0,"title":"Almalne Alolan, Grassy Road","descriptions":["Nestled under the shade of a lone Ilithic apple tree is an arrangement of beehives, their denizens roly-poly bumblebees.  A constant parade of buzzing creatures travel seemingly aimless paths to and from their artificial homes.  Located nearby is a finely wrought iron gate."],"exits":[{"to":677,"exit":"east","move":"east"},{"to":755,"exit":"go","move":"go iron gate"}],"color":"#00FFFF"},
  {"id":679,"x":-440,"y":-480,"z":0,"title":"Almalne Alolan, Behind the Branches","descriptions":["Tangled into what appears to be an impenetrable maze, the branches of the giant Ilithic apple trees seem to block the way west.  A layer of twigs and dead leaves are scattered upon the ground, save for where an animal of some sort must have been digging, leaving a small hole near the roots of one tree."],"exits":[{"to":680,"exit":"east","move":"east"},{"to":663,"exit":"go","move":"go passage"}]},
  {"id":680,"x":-420,"y":-480,"z":0,"title":"Almalne Alolan, Forest Violets","descriptions":["Towering in the distance to the west is a single massive Ilithic apple tree, just barely visible between the branches of its smaller brethren.  The ground is clear enough here to allow for small clusters of forest violets to poke their heads up, adding highlights of color to the drab orchard floor."],"exits":[{"to":679,"exit":"west","move":"west"}]},
  {"id":681,"x":-600,"y":-492,"z":0,"title":"Almalne Alolan, Farmland","descriptions":["A circle of trimmed grass stands out against the lush gold of the fields around it, allowing a scattering of tiny daisies to grow and dabble the bright green with white.  Standing at the edge of the grass and leading back to the roadway is an ornate wrought iron gate."],"exits":[{"to":671,"exit":"go","move":"go iron gate"}],"color":"#00FFFF"},
  {"id":682,"x":500,"y":-500,"z":0,"title":"Soul of Maelshyve, The Sowing","descriptions":["The path stretches to the southwest, hanging in space, extending from a lake of midnight-blue sludge.  High above, an upside-down church soars amidst a large moor spreading over the sky.  The flickering image of three altars can be seen juxtaposed with the church, impossible to focus on as they shift in the dense ashen fog.  Underfoot, twisted bone and sinew are rimmed with splashes of radiant color from bizarre and unidentifiable flowers, rapidly blossoming and decaying in a perverse cycle of life and death.  The air is filled with a pungent and sickening aroma, making it nearly impossible to draw a full breath as the heady pollen tickles the senses, unraveling the distinction between memory and now.","The path stretches to the southwest, extending from a lake of midnight-blue sludge.  High above, an upside-down church hangs amongst a large moor spreading over the sky.  Strange flowers fill the air with a pungent and sickening aroma, making it hard to breathe."],"exits":[{"to":0,"exit":"southwest","move":"southwest"},{"to":408,"exit":"go","move":"go midnight-blue sludge"}],"aliases":["Soul of Maelshyve","Sowing"],"linksTo":"Map501_Soul_of_Maelshyve.xml"},
  {"id":683,"x":-700,"y":-340,"z":0,"title":"Steelclaw Clan, Farmstead","descriptions":["The uneven pathway terminates here, broken cobblestones and overgrown weeds a sign of years of neglect.  The adjacent field is a wild mess of tall grass, flowers, and saplings, the land being slowly reclaimed by nature.  Several crumbling buildings stand at the end of the road, long since abandoned."],"exits":[{"to":684,"exit":"go","move":"go henhouse"},{"to":75,"exit":"go","move":"go winding path"},{"to":75,"exit":"go","move":"go path"},{"to":689,"exit":"go","move":"go drainage ditch"},{"to":695,"exit":"go","move":"go cobblestone path"}]},
  {"id":684,"x":-720,"y":-340,"z":0,"title":"Steelclaw Clan, Henhouse Entrance","descriptions":["The low ceiling is intended to provide the birds with a sense of security, fallen roosting bars and shelves in disarray.  A line of broken nesting boxes line the walls. The ground is caked with moldy straw and wood shavings, scattered with chicken bones."],"exits":[{"to":685,"exit":"north","move":"north"},{"to":683,"exit":"go","move":"go doorway"},{"to":683,"exit":"go","move":"go door"}]},
  {"id":685,"x":-720,"y":-360,"z":0,"title":"Steelclaw Clan, Henhouse Broken Run","descriptions":["A section of wall here has been torn open, claw and tooth marks telling a vivid story along the broken wood boards.  A mess of feathers and chicken bones are concentrated here, and the nesting boxes and roosting structures nearby are smashed to splinters.  Further ahead, the lack of windows envelopes the end of the coop in darkness, which periodically flickers with yellow eyes and rumbling growls."],"exits":[{"to":686,"exit":"north","move":"north"},{"to":684,"exit":"south","move":"south"},{"to":687,"exit":"west","move":"west"}]},
  {"id":686,"x":-720,"y":-380,"z":0,"title":"Steelclaw Clan, Henhouse Utility Access","descriptions":["Deep in shadow, the henhouse terminates here, a small access door to the outside covered by fallen support beams and debris.  Padded footfalls scamper along the shadows, growls and barks calling out in challenge."],"exits":[{"to":685,"exit":"south","move":"south"}]},
  {"id":687,"x":-740,"y":-360,"z":0,"title":"Steelclaw Clan, Henhouse Yard","descriptions":["A low awning stretches to a small fence, designed to keep the chickens confined, but little of either structure remains beyond mouldering wood and rotten crossbeams.  The thicker grass and weed growth here is testament to previous inhabitants, the muddy soil now crisscrossed with paw prints.  To the north, the remains of a small shed can be seen just beyond the henhouse."],"exits":[{"to":688,"exit":"north","move":"north"},{"to":685,"exit":"east","move":"east"}]},
  {"id":688,"x":-740,"y":-380,"z":0,"title":"Steelclaw Clan, Henhouse Toolshed","descriptions":["Nearly completely collapsed, the toolshed is now nothing more than a haphazard pile of wood.  The remains of a few smashed barrels and rusty tools are all that can be identified within, and though the surrounding yard is rung by broken fence, the north end of the coop is partially obscured by the foliage.  The entire exterior wall of the henhouse is lined with claw marks."],"exits":[{"to":687,"exit":"south","move":"south"}]},
  {"id":689,"x":-750,"y":-318,"z":0,"title":"Steelclaw Clan, Flooded Field","descriptions":["Carried along a wide furrow, the muddy water cuts into the neighboring field, the tall embankment blocked by reeds.  The scent of old vegetation is tinged with the even more unpleasant and unmistakable smell of rotting flesh.  Stirring the reeds, the breeze does little to clear the persistent cloud of insects."],"exits":[{"to":690,"exit":"south","move":"south"},{"to":694,"exit":"west","move":"west"},{"to":683,"exit":"go","move":"go muddy gap"}]},
  {"id":690,"x":-750,"y":-298,"z":0,"title":"Steelclaw Clan, Reed Thicket","descriptions":["Splintered and partially buried in muck, the planks lining the canal have become infiltrated with thick clumps of reeds, scouringrush, clover, and cress.  The muddy water is covered in a thin film of green scum, hiding unblinking frog eyes and cautious turtles peaking through the surface foliage."],"exits":[{"to":689,"exit":"north","move":"north"},{"to":691,"exit":"south","move":"south"},{"to":693,"exit":"west","move":"west"}]},
  {"id":691,"x":-750,"y":-278,"z":0,"title":"Steelclaw Clan, Dried Brush","descriptions":["Slightly elevated, the ditch is largely dried, the surrounding soil cracked.  Brown and dead, the nearby undergrowth rustles in the breeze.  Bits of dried scutes line the rough dirt, exposed rocks, and dead trees, along with several conical teeth and the occasional webbed toe."],"exits":[{"to":690,"exit":"north","move":"north"},{"to":692,"exit":"west","move":"west"}]},
  {"id":692,"x":-770,"y":-278,"z":0,"title":"Steelclaw Clan, Irrigation Ditch","descriptions":["Lined with pitch coated wood planks, the wide canal looks well constructed.  Ankle-deep muddy water pools in small eddies as it slowly flows down the field.  Rotting bits of plant matter swirl around mossy stones, and a thin layer of flies and water skimmers flit atop the surface.  Tall reeds growing at the edges of the ditch limit visibility of the surrounding fields."],"exits":[{"to":693,"exit":"north","move":"north"},{"to":691,"exit":"east","move":"east"}]},
  {"id":693,"x":-770,"y":-298,"z":0,"title":"Steelclaw Clan, Irrigation Ditch","descriptions":["Some of the planks lining the canal show signs of wear, slightly splintering at the joinery.  The muddy water flows faster as a series of terraced fields draws water into downhill levels.  Each stepwise decline appears worse for wear.  The reeds grow haphazardly, revealing glimpses of the adjacent overgrown fields."],"exits":[{"to":694,"exit":"north","move":"north"},{"to":690,"exit":"east","move":"east"},{"to":692,"exit":"south","move":"south"}]},
  {"id":694,"x":-770,"y":-318,"z":0,"title":"Steelclaw Clan, Flooded Field","descriptions":["Caked with dead wood, mud, and reeds, a large obstruction plugs the canal, flooding the terrace with sludge.  Small and large animal bones are lodged in the blockage, as well as large mottled scales and long yellowed conical teeth.  Though hidden, the occasional frog loudly croaks."],"exits":[{"to":689,"exit":"east","move":"east"},{"to":693,"exit":"south","move":"south"}]},
  {"id":695,"x":-780,"y":-180,"z":0,"title":"Abandoned Farmhouse, Entry","descriptions":["Warped stairs ascend to a wide porch which spans the exterior of the home.  Broken windows peer into musty darkness, echoing with feminine whispers.  A half collapsed dormer exposes the second floor to the elements, and the ground is littered with broken slate tiles fallen from the roof.  White paint peels from the siding, and clinging vines cover the walls.  The front door has been boarded shut, crisscrossed with thick planks."],"exits":[{"to":696,"exit":"east","move":"east"},{"to":683,"exit":"go","move":"go cobblestone path"}]},
  {"id":696,"x":-760,"y":-180,"z":0,"title":"Abandoned Farmhouse, Collapsed Porch","descriptions":["Several support posts have splintered or been cut, resulting in a barrier of debris choked through with vines.  A rafter has gouged a wide hole through the farmhouse wall, creating a small entry into the structure.  Flickers of movement can be seen inside, and loud whispering echoes from within the home."],"exits":[{"to":697,"exit":"north","move":"north"},{"to":695,"exit":"west","move":"west"}]},
  {"id":697,"x":-760,"y":-200,"z":0,"title":"Abandoned Farmhouse, Living Room","descriptions":["Centered in the west wall, a wide fireplace displays a number of cracked hearthstones.  Several broken windows lined with glass fragments or boards limit the view outside.  The wreckage of furniture is scattered around the room, scraps of cloth and stuffing, splintered wood and iron nails littering the ground.  A single wooden chair sits facing the fireplace, entirely clean of dust and debris.  A narrow stairwell leads upstairs."],"exits":[{"to":696,"exit":"south","move":"south"},{"to":698,"exit":"west","move":"west"},{"to":700,"exit":"up","move":"up"}]},
  {"id":698,"x":-780,"y":-200,"z":0,"title":"Abandoned Farmhouse, Kitchen","descriptions":["A long oak table serves as the central focus of the kitchen area, and an elegant and functional slate counter forms a neat corner, lined with destroyed drawers and cabinets.  Rusted knives and forks are scattered across the floor, and several large cast iron skillets and copper pots hang from ceiling hooks.  A child's drawing decorates a nearly destroyed ice chest, a singular gouge cutting across the colorful image of a family holding hands.  A narrow stairwell leads to the basement."],"exits":[{"to":697,"exit":"east","move":"east"},{"to":699,"exit":"down","move":"down"}]},
  {"id":699,"x":-800,"y":-180,"z":0,"title":"Abandoned Farmhouse, Root Cellar","descriptions":["The air has a significant chill, and the ground is little more than hard packed bare earth scattered with straw.  The rough stone walls are lined with wooden shelves and bins in various states of disrepair, covered in shattered glass jars and desiccated vegetables.  Several large bones are piled in a corner, snapped and riddled with teeth marks."],"exits":[{"to":698,"exit":"up","move":"up"}]},
  {"id":700,"x":-760,"y":-220,"z":0,"title":"Abandoned Farmhouse, Second Floor Landing","descriptions":["A broken and splintered railing affords an uninterrupted view of the living room downstairs.  A shattered full length mirror hangs at a slant, creating an impression of a large open space.  Several doors are boarded shut, though the one at the end of the hallway is torn free and lies lodged part way into the wall."],"exits":[{"to":701,"exit":"west","move":"west"},{"to":702,"exit":"up","move":"up"},{"to":697,"exit":"down","move":"down"}]},
  {"id":701,"x":-780,"y":-220,"z":0,"title":"Abandoned Farmhouse, Bedroom","descriptions":["The far wall features two destroyed windows, their frames hacked to pieces, exposing the room to the elements.  Near the entrance are the crumbled remains of a large bed, exposure and time leaving little more than moldy down and fabric around a splintered frame.  From a caved in chest of drawers lies tattered clothing strewn across the floor, and a wire mobile strung with colorful glass and pieces of crystal hangs from the ceiling."],"exits":[{"to":700,"exit":"east","move":"east"}]},
  {"id":702,"x":-760,"y":-240,"z":0,"title":"Abandoned Farmhouse, Attic","descriptions":["Boxes and bundles of memorabilia, tools, and unfinished furniture line the walls.  The thick wooden rafters are starting to show signs of splintering, and a significant collapse around a dormer has resulted in a portion of the roof to be entirely open to the elements.  A small wooden doll is tucked into the ceiling.  A narrow frame opens to a thin ladder which leads to the landing below."],"exits":[{"to":700,"exit":"down","move":"down"}]},
  {"id":703,"x":-90,"y":-940,"z":0,"title":"A Warmly Lit Alcove, Skin Art By Mothaki","descriptions":["The small alcove's roughly carved walls glint like diamonds as the illuminating candlelight reflects from the light layer of frost covering the stone.  Shallow holes in the walls above work tables and near a pair of chairs hold larger torches to ensure proper lighting for those working in the cramped space."],"exits":[{"to":655,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Skin Art By Mothaki","tattoo"]},
  {"id":704,"x":-580,"y":-720,"z":0,"title":"House of the Silk Strings, Courtyard","descriptions":["Nestled amongst the quiet woodland surroundings, a stately stone and cedar villa adjoins the courtyard here, its eaves hung with fluttering silk banners dyed in striking amaranthine and platinum hues.  Nearby, a pushcart loaded with crates rests patiently to the side of the basalt-paved path that leads northwest.","Nestled amongst the quiet woodland surroundings, a stately stone and cedar villa adjoins the courtyard here, its darkened eaves hung with silk banners that flutter softly in the nighttime air.  Nearby, a deserted pushcart rests to the side of the basalt-paved path that leads northwest."],"exits":[{"to":705,"exit":"northwest","move":"northwest"},{"to":119,"exit":"go","move":"go cedar gates"},{"to":743,"exit":"go","move":"go villa"}]},
  {"id":705,"x":-600,"y":-740,"z":0,"title":"House of the Silk Strings, Workshop Row","descriptions":["A venerable wooden structure borders the shady path, its tile roof gently curved to shelter a deep wraparound veranda.  Beneath the timeworn eaves, two Elothean workers are spooling silk thread with uncanny speed and grace from a large vat of water on which floats countless tiny white cocoons.","A single lantern sways gently from the timeworn eaves of the venerable wooden structure that borders the otherwise pitch dark wooded path.  A large metal vat on the veranda sits emptied and idle for the evening, softly reflecting the meager available light from its burnished surface."],"exits":[{"to":706,"exit":"north","move":"north"},{"to":704,"exit":"southeast","move":"southeast"}]},
  {"id":706,"x":-600,"y":-760,"z":0,"title":"House of the Silk Strings, Workshop Row","descriptions":["A low stand of plum trees borders the path opposite a pair of long, tile-roofed wooden workshops.  Although the buildings are tightly shuttered, the occasional passage of an Eloth worker through one of the sliding doors provides a brief glimpse of the enormous, intricate looms housed within.","A low stand of plum trees borders the path opposite a pair of long, tile-roofed wooden workshops that are tightly shuttered for the evening."],"exits":[{"to":705,"exit":"south","move":"south"},{"to":707,"exit":"northwest","move":"northwest"}]},
  {"id":707,"x":-620,"y":-780,"z":0,"title":"House of the Silk Strings, By the Lotus Pond","descriptions":["The basalt cobblestone path stretches onward beneath a soaring canopy of cedar, spruce, and the occasional redwood.  Through the dense foliage to the north, the occasional glimpse of a sea of white can be caught from the clearing downhill.","A soaring canopy of cedar, spruce, and redwood blocks out most of the sky, deepening the nighttime darkness that envelops the path.  The tranquil sound of frogs and chirping insects drifts through the shadowy foliage from somewhere to the north."],"exits":[{"to":706,"exit":"southeast","move":"southeast"},{"to":708,"exit":"northwest","move":"northwest"}]},
  {"id":708,"x":-640,"y":-800,"z":0,"title":"House of the Silk Strings, By the Lotus Pond","descriptions":["Flagstones set into the loamy banks underfoot mark the intended entrance into the lotus pond.  A steady stream of Elothean harvesters stop to lash up the lower hems of their garments before wading into the peaceful waters, while others emerge back onto the shore with leaf-laden baskets in tow.","The waters of the lotus pond lap gently against several broad flagstones set into the loamy banks underfoot.  A neat stack of reed baskets has been secured to the trunk of a nearby pine for the night."],"exits":[{"to":709,"exit":"northeast","move":"northeast"},{"to":707,"exit":"southeast","move":"southeast"},{"to":737,"exit":"go","move":"go pond"}]},
  {"id":709,"x":-620,"y":-820,"z":0,"title":"House of the Silk Strings, By the Lotus Pond","descriptions":["A silverwillow grows on the shore beside the path, its long branches draped languidly into the shallows of the lotus pond.  Dragonflies skim the emerald water below, darting amongst the curtain of leaves.","A silverwillow grows on the shore beside the path, its long branches draped languidly into the waters below as if to enjoy a quiet nighttime dip in the lotus pond."],"exits":[{"to":710,"exit":"north","move":"north"},{"to":708,"exit":"southwest","move":"southwest"}]},
  {"id":710,"x":-620,"y":-840,"z":0,"title":"House of the Silk Strings, Beneath the Storehouse","descriptions":["The cobbled path terminates here at the steeply rising face of a wooded bluff.  Undaunted by the incline, a massive two-tiered storehouse clings to the slope, achieving a whimsically defiant effect with its opulent facade and precarious perch."],"exits":[{"to":709,"exit":"south","move":"south"},{"to":711,"exit":"go","move":"go storehouse"}]},
  {"id":711,"x":-620,"y":-860,"z":0,"title":"Kiora'ylen Storehouse, Entrance","descriptions":["From just inside its great sliding doors, a scene of abject chaos unfolds across what must have been a once-grand textile storehouse.  Collapsed shelves, shattered crates, and tangled bolts of cloth stretch far to the north, where the building's vast first tier ends beneath the distant edge of its second."],"exits":[{"to":712,"exit":"north","move":"north"},{"to":716,"exit":"northeast","move":"northeast"},{"to":715,"exit":"east","move":"east"},{"to":710,"exit":"go","move":"go doors"}]},
  {"id":712,"x":-620,"y":-880,"z":0,"title":"Kiora'ylen Storehouse, Storage","descriptions":["An enormous collapsed textile rack has completely blocked passage north.  The ubiquitous piles of fabric debris are less of an obstacle, although they do make footing uncertain in places."],"exits":[{"to":711,"exit":"south","move":"south"},{"to":713,"exit":"southwest","move":"southwest"},{"to":714,"exit":"west","move":"west"}]},
  {"id":713,"x":-640,"y":-860,"z":0,"title":"Kiora'ylen Storehouse, Storage","descriptions":["Obliterated by unknown forces, a large array of shelving rods sits in a splintered heap.  Hundreds of conical spools of raw silk are gathered in undignified piles on the storeroom floor around the remains."],"exits":[{"to":714,"exit":"north","move":"north"},{"to":712,"exit":"northeast","move":"northeast"}]},
  {"id":714,"x":-640,"y":-880,"z":0,"title":"Kiora'ylen Storehouse, Storage","descriptions":["Long rows of storage shelves are in various states of ruin here, their erstwhile cargo spewed into a colorful jumble of silk on the storehouse floor.  It is difficult to pick a navigable path around the wreckage."],"exits":[{"to":712,"exit":"east","move":"east"},{"to":713,"exit":"south","move":"south"},{"to":719,"exit":"climb","move":"climb shelf"}]},
  {"id":715,"x":-600,"y":-860,"z":0,"title":"Kiora'ylen Storehouse, Shipping","descriptions":["Inexplicably windswept and smeared, a large chalkboard mounted to the eastern wall is now barely identifiable as a shipping schedule.  Scraps of fabric mill about the drafty, unfurnished room."],"exits":[{"to":716,"exit":"north","move":"north"},{"to":711,"exit":"west","move":"west"}]},
  {"id":716,"x":-600,"y":-880,"z":0,"title":"Kiora'ylen Storehouse, Shipping","descriptions":["An upturned wheelbarrow has pinned down a torn length of floral print silk brocade, but the rest of its former load is nowhere to be seen.  Other bits of lightweight detritus have accumulated at the corners of the large room."],"exits":[{"to":715,"exit":"south","move":"south"},{"to":711,"exit":"southwest","move":"southwest"},{"to":717,"exit":"go","move":"go door frame"}]},
  {"id":717,"x":-600,"y":-900,"z":0,"title":"Kiora'ylen Storehouse, Packing Floor","descriptions":["A long spool of Elothean lace is roughly strung around the area in a tangled zigzag, looking much like a shroud of cobwebs over the haphazard stacks of packing crates."],"exits":[{"to":718,"exit":"west","move":"west"},{"to":720,"exit":"northwest","move":"northwest"},{"to":716,"exit":"go","move":"go door frame"}]},
  {"id":718,"x":-620,"y":-900,"z":0,"title":"Kiora'ylen Storehouse, Packing Floor","descriptions":["Overturned tables, packing crates, and textile racks clutter the workspace in disarray.  An oddly persistent draft sweeps through the area, accompanied by the soft rustle of windswept fabric."],"exits":[{"to":720,"exit":"north","move":"north"},{"to":717,"exit":"east","move":"east"},{"to":719,"exit":"west","move":"west"}]},
  {"id":719,"x":-640,"y":-900,"z":0,"title":"Kiora'ylen Storehouse, Packing Floor","descriptions":["Someone or something has cleanly sliced through several of the heavy cedar support beams here, resulting in a roof collapse at the northwestern end of the room.  A draft blows in through the impassible rubble."],"exits":[{"to":720,"exit":"northeast","move":"northeast"},{"to":718,"exit":"east","move":"east"},{"to":714,"exit":"climb","move":"climb shelf"}]},
  {"id":720,"x":-620,"y":-920,"z":0,"title":"Kiora'ylen Storehouse, Packing Floor","descriptions":["Any signs of this drafty area's original purpose have long since been reduced to miscellaneous debris.  The wood-paneled northern wall rises several yards overhead to meet the edge of the storehouse's second tier, where a sheet of torn crimson cloth can be seen flapping from the guard railing above."],"exits":[{"to":721,"exit":"east","move":"east"},{"to":717,"exit":"southeast","move":"southeast"},{"to":718,"exit":"south","move":"south"},{"to":719,"exit":"southwest","move":"southwest"}]},
  {"id":721,"x":-600,"y":-920,"z":0,"title":"Kiora'ylen Storehouse, Lower Level Landing","descriptions":["A pile of wreckage has accumulated at the base of the cedar plank ramp that connects the two tiers of the storehouse, apparently having tumbled unceremoniously down the wooden incline.  Across the room, a collection of scales, measuring boards, and other implements of quality control is in a similar state of ravaged neglect."],"exits":[{"to":720,"exit":"west","move":"west"},{"to":722,"exit":"go","move":"go ramp"}]},
  {"id":722,"x":-560,"y":-860,"z":0,"title":"Kiora'ylen Storehouse, Upper Level Landing","descriptions":["Snagged on the second tier guardrail, a sheet of torn crimson cloth flaps futilely from its captive position.  Movement is occasionally detectable far below, but from this distance it is difficult to tell if it's more billowing fabric or something else entirely."],"exits":[{"to":723,"exit":"north","move":"north"},{"to":726,"exit":"east","move":"east"},{"to":721,"exit":"go","move":"go ramp"}]},
  {"id":723,"x":-560,"y":-880,"z":0,"title":"Kiora'ylen Storehouse, Workspace","descriptions":["More demolished furniture and snippets of loose cloth garnish this unremarkable corridor.  An occasional draft sweeps through, carrying new scraps in and old scraps out, perpetuating the decay."],"exits":[{"to":724,"exit":"north","move":"north"},{"to":728,"exit":"northeast","move":"northeast"},{"to":727,"exit":"east","move":"east"},{"to":722,"exit":"south","move":"south"}]},
  {"id":724,"x":-560,"y":-900,"z":0,"title":"Kiora'ylen Storehouse, Workspace","descriptions":["Broken glass mingles with discarded scraps of fabric along the western wall of this neglected workspace, where a long cutting table sits empty and disused beneath a row of shattered windows.  The doorway at the northern end of the room is nearly obstructed by the rubble."],"exits":[{"to":725,"exit":"north","move":"north"},{"to":728,"exit":"east","move":"east"},{"to":723,"exit":"south","move":"south"}]},
  {"id":725,"x":-560,"y":-920,"z":0,"title":"Kiora'ylen Storehouse, Barricaded Corridor","descriptions":["Aside from a single lantern flickering at the center of the room, everything in this narrow hallway has been divided and pushed up against the two exits.  To the north, a towering stack of packing crates poses a formidable barricade, and to the south, a long table and some overturned lockers have almost, but not quite, managed to block the doorway."],"exits":[{"to":724,"exit":"south","move":"south"},{"to":730,"exit":"go","move":"go gap"}]},
  {"id":726,"x":-540,"y":-860,"z":0,"title":"Kiora'ylen Storehouse, Red Dye Room","descriptions":["A thin layer of Elothean-red mineral powder coats every visible surface of this derelict dye chamber.  The color is especially pronounced where the chalky pigment has collected in the cracks and corners of the hardwood flooring."],"exits":[{"to":727,"exit":"north","move":"north"},{"to":722,"exit":"west","move":"west"}]},
  {"id":727,"x":-540,"y":-880,"z":0,"title":"Kiora'ylen Storehouse, Blue Dye Room","descriptions":["Baskets of dried etrana blossoms flank the large copper dyeing vat that dominates the center of the workspace here.  Most of the woven vessels have long since tipped and spilled, their deep blue contents left to scatter to the furthest dusty corners of the room."],"exits":[{"to":728,"exit":"north","move":"north"},{"to":726,"exit":"south","move":"south"},{"to":723,"exit":"west","move":"west"}]},
  {"id":728,"x":-540,"y":-900,"z":0,"title":"Kiora'ylen Storehouse, Green Dye Room","descriptions":["Errant fabric scraps litter the sparse workroom.  Near the eastern wall, a prominent jade-hued stain spreads outward from a capsized copper dyeing vat."],"exits":[{"to":729,"exit":"north","move":"north"},{"to":727,"exit":"south","move":"south"},{"to":723,"exit":"southwest","move":"southwest"},{"to":724,"exit":"west","move":"west"}]},
  {"id":729,"x":-540,"y":-920,"z":0,"title":"Kiora'ylen Storehouse, Purple Dye Room","descriptions":["Deep purple liquid is congealing in a large copper vat at the center of the room, developing a rather noticeable stench in the process.  The color of the stagnant ooze is a far cry from the attractive amaranthine and royal purple hues sported by the shredded skeins of silk suspended on nearby drying lines."],"exits":[{"to":728,"exit":"south","move":"south"}]},
  {"id":730,"x":-560,"y":-960,"z":0,"title":"Kiora'ylen Storehouse, Supply Room","descriptions":["A puddle of dried wax sealant is crusted to the floor beneath a tall supply shelf on the northern wall, and the lingering scent of bleach emanates from the mostly-broken bottles contained therein.  At the opposite end of the room, several large crates have been stacked to create a makeshift barricade across one of the exits."],"exits":[{"to":732,"exit":"east","move":"east"},{"to":731,"exit":"southeast","move":"southeast"},{"to":733,"exit":"west","move":"west"},{"to":725,"exit":"go","move":"go gap"}]},
  {"id":731,"x":-540,"y":-940,"z":0,"title":"Kiora'ylen Storehouse, Supply Room","descriptions":["An intricately shelved assortment of embroidery thread has been reduced to a massive psychedelic snarl on the supply room floor.  Although it's suffered a noticeable slash, the shesegri design chart mounted to the eastern wall has apparently fared the destructive conditions of the storehouse far better."],"exits":[{"to":732,"exit":"north","move":"north"},{"to":730,"exit":"northwest","move":"northwest"}]},
  {"id":732,"x":-540,"y":-960,"z":0,"title":"Kiora'ylen Storehouse, Supply Room","descriptions":["A jumble of pins and needles carpets the hardwood floor here.  Scissors, clothes irons, and other heavier sewing tools have, for the most part, managed to hold their positions on the room's supply shelves and wall-mounted peg racks."],"exits":[{"to":731,"exit":"south","move":"south"},{"to":730,"exit":"west","move":"west"}]},
  {"id":733,"x":-580,"y":-960,"z":0,"title":"Kiora'ylen Storehouse, Supply Room","descriptions":["Another expanse of fabric scraps covers the floor here, shards of glass mixed in with the debris.  Broken windows along the western wall allow the occasional gust of wind inside to stir the derangement."],"exits":[{"to":735,"exit":"north","move":"north"},{"to":734,"exit":"northeast","move":"northeast"},{"to":730,"exit":"east","move":"east"},{"to":736,"exit":"south","move":"south"}]},
  {"id":734,"x":-560,"y":-980,"z":0,"title":"Kiora'ylen Storehouse, Argosy","descriptions":["A line of resplendent tapestries along the northern wall has been neatly severed, showing only the slightest hint of fraying at the diagonal slash that runs along the hangings' new bottom hems."],"exits":[{"to":733,"exit":"southwest","move":"southwest"},{"to":735,"exit":"west","move":"west"}]},
  {"id":735,"x":-580,"y":-980,"z":0,"title":"Kiora'ylen Storehouse, Argosy","descriptions":["Fallen kimono-clad mannequins lie among smashed chests expelling fine brocades and damask-woven silks, indicating that this back corner of the storehouse once functioned as a storage vault.  A single dress form has maintained an upright position, but its bejeweled silk samite robe has been slashed to miserable shreds."],"exits":[{"to":734,"exit":"east","move":"east"},{"to":733,"exit":"south","move":"south"}]},
  {"id":736,"x":-580,"y":-940,"z":0,"title":"Kiora'ylen Storehouse, Records Room","descriptions":["Only a few old fashion catalogs and inventory ledgers are recognizable amongst the massive piles of inscrutable paperwork that clutter every inch of this ravaged room.  Colorful cloth scraps, blown in from other parts of the storehouse, have joined the mess."],"exits":[{"to":733,"exit":"north","move":"north"}]},
  {"id":737,"x":-600,"y":-800,"z":0,"title":"House of the Silk Strings, Lotus Pond","descriptions":["Snowy white lotus blossoms blanket the emerald water of this placid woodland pond.  A narrow path through the vegetation has been cleared along the shallows of the pool, and various Elothean workers are using the wading space to carefully harvest lotus leaves.","Lotus blossoms, closed for the night, blanket the surface of the darkened pond."],"exits":[{"to":738,"exit":"northeast","move":"northeast"},{"to":741,"exit":"southeast","move":"southeast"},{"to":708,"exit":"go","move":"go shoreline"}],"color":"#0000FF"},
  {"id":738,"x":-580,"y":-820,"z":0,"title":"House of the Silk Strings, Lotus Pond","descriptions":["The thick layer of soft white lotus blossoms sways gently to the soporific rhythm of the pond's underwater currents.","Lotus blossoms, closed for the night, blanket the surface of the darkened pond."],"exits":[{"to":739,"exit":"southeast","move":"southeast"},{"to":737,"exit":"southwest","move":"southwest"}],"color":"#0000FF"},
  {"id":739,"x":-560,"y":-800,"z":0,"title":"House of the Silk Strings, Lotus Pond","descriptions":["The sea of botanic white that dominates the rest of the pond blends softly into a contrasting bed of lotus blossoms at this quiet end of the pool.  Distinctly colored blooms surround a mossy stone marker rising stoically from the jewel-toned water below.","Lotus blossoms, closed for the night, blanket the surface of the darkened pond, while a mossy stone marker quietly stands watch in the still water."],"exits":[{"to":741,"exit":"southwest","move":"southwest"},{"to":738,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":741,"x":-580,"y":-780,"z":0,"title":"House of the Silk Strings, Lotus Pond","descriptions":["The rich greens of the pond and its aquatic foliage blend with the floral expanse of lotus-white to create a captivating dichromatic gardenscape, occasionally broken by the flash of a goldfish swimming amongst the underwater stalks.","Lotus blossoms, closed for the night, blanket the surface of the darkened pond."],"exits":[{"to":739,"exit":"northeast","move":"northeast"},{"to":737,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":742,"x":0,"y":0,"z":0,"title":"","descriptions":[],"exits":[],"color":"#0000FF"},
  {"id":743,"x":-560,"y":-740,"z":0,"title":"House of the Silk Strings, Foyer","descriptions":["The entire north wall of the villa's grand foyer is glass, affording a picturesque view of the cottage-speckled weald behind the building.  Overhead, a diamondique chandelier provides soft illumination, while a heavy silk runner atop the hardwood floor guides arriving visitors toward a pair of hallways situated at opposite ends of the room."],"exits":[{"to":745,"exit":"east","move":"east"},{"to":744,"exit":"west","move":"west"},{"to":704,"exit":"out","move":"out"}]},
  {"id":744,"x":-580,"y":-740,"z":0,"title":"House of the Silk Strings, Tearoom","descriptions":["Tall windows with curtains tied back invite the available starlight into this spacious lounge, which manages to offer an intimate and cozy atmosphere despite its size.  Numerous candlelit tables ring a small stage at the center of the room, where a sultry Elothean lyrist croons for dining patrons from suppertime through the late hours of the night, enthralling listeners with both charm and skill."],"exits":[{"to":743,"exit":"east","move":"east"}]},
  {"id":745,"x":-540,"y":-740,"z":0,"title":"House of the Silk Strings, Business Office","descriptions":["With tall picture windows and exposed cedar beams, this large office space exemplifies simple, rustic elegance.  Two neat rows of desks, manned by various clerks and bookkeepers, flank a golden silk tapestry suspended from the rafters."],"exits":[{"to":743,"exit":"west","move":"west"}]},
  {"id":746,"x":100,"y":-960,"z":0,"title":"Chyolvea Tayeu'a, Laboratory","descriptions":["Several large marble tables fill the room, each with the partially dissected corpse of an insectoid creature resting on top.  Each cadaver is slightly blurred by the protective spell which keeps decay, rodents, and unauthorized researchers at bay.  Half-finished drawings, obviously diagrams of various insect species, clutter the walls."],"exits":[{"to":523,"exit":"go","move":"go arch"},{"to":747,"exit":"north","move":"north"}]},
  {"id":747,"x":100,"y":-980,"z":0,"title":"Chyolvea Tayeu'a, Laboratory","descriptions":["Red mineral streaks in the stone walls give this end of the lab a close, suffocating feel.  The floor is spotlessly, painfully clean -- someone spends a lot of time on their knees with a scrub brush and a pail of water here.  Iron fixtures hold conventional torches, illuminating a flat bed of stone that lies in the exact center of the room."],"exits":[{"to":746,"exit":"south","move":"south"},{"to":748,"exit":"go","move":"touch orb;go egress"}]},
  {"id":748,"x":100,"y":-1000,"z":0,"title":"Vykathi Hive, Upper Air Tunnels","descriptions":["The floor of this chamber has been leveled, cleared, and even polished to a high luster.  Angular, precise markings in searing orange and deep blue-black proliferate on the floor, the walls, and even the larger stalactites above, but are organized into orderly columns and somehow do not give the impression of scribbled chaos."],"exits":[{"to":0,"exit":"northeast","move":"northeast"},{"to":0,"exit":"east","move":"east"},{"to":0,"exit":"north","move":"north"},{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"south","move":"south"},{"to":0,"exit":"southwest","move":"southwest"},{"to":0,"exit":"west","move":"west"},{"to":0,"exit":"northwest","move":"northwest"},{"to":0,"exit":"go","move":"touch orb;go egress"}]},
  {"id":749,"x":-610,"y":-492,"z":0,"title":"Almalne Alolan, Sapling Orchard","descriptions":["Delicate trunks and slender branches stretch out from the multitude of Ilithic apple saplings that are planted in neat rows.  Soft, green grasses grow unchecked around their roots as if competing with the small trees.  Separating the orchard from the road is a fancy wrought iron gate."],"exits":[{"to":672,"exit":"go","move":"go iron gate"}],"color":"#00FFFF"},
  {"id":750,"x":-620,"y":-492,"z":0,"title":"Almalne Alolan, Small Clearing","descriptions":["Gnarled and yet somehow still graceful, the mature Ilithic apple trees circle a small clearing full of bright blue cornflowers.  Soft grasses grow across the open space and back into the roots of the trees.  Leading away from the glade is a faint pathway that ends in an elaborately carved wooden gate."],"exits":[{"to":673,"exit":"go","move":"go wooden gate"}],"color":"#00FFFF"},
  {"id":751,"x":-630,"y":-492,"z":0,"title":"Almalne Alolan, Amid the Trees","descriptions":["Branches stretch and wind together overhead, the old trees having long ago grown together despite the spaces between their large trunks.  Patches of grass and pink-spotted white foxgloves sprout forth from the detritus between the roots.  Standing guard at the end of a short path is a wooden gate."],"exits":[{"to":674,"exit":"go","move":"go wooden gate"}],"color":"#00FFFF"},
  {"id":752,"x":-640,"y":-492,"z":0,"title":"Almalne Alolan, Under an Ancient Ilithic Apple Tree","descriptions":["A colossus even against the ancient trees around it, the venerable tree's trunk is contorted by hundreds of years of weather.  Huge branches stretch out as if to shelter the space below it, a single branch curves down to rest against the ground and is covered by soft mosses.  Set between two nearby trees is a delicately carved wooden gate."],"exits":[{"to":675,"exit":"go","move":"go carved gate"}],"color":"#00FFFF"},
  {"id":753,"x":-650,"y":-492,"z":0,"title":"Almalne Alolan, By the Stream","descriptions":["Meandering through the trees is a stream of crystal clear water that trickles away from a small pond.  Growing along one edge are pale pink lotus flowers streaked with white while deeper in the hidden spring a few waterlilies show off dark pink petals.  Lush moss flourishes upon the bark of the adjacent trees.  A gracefully carved wooden gate leads back to the lane."],"exits":[{"to":676,"exit":"go","move":"go wooden gate"}],"color":"#00FFFF"},
  {"id":754,"x":-660,"y":-492,"z":0,"title":"Almalne Alolan, Flowering Fields","descriptions":["Neatly furrowed rows of dirt run in north to south lines around a squared patch of ankle-high grass.  Planted along the top of each mound are a rainbow of irises, their colors ranging from deep reds and brilliant oranges to soft blues and intense purples.  At the edge of a grassy pathway stands a gate of artfully wrought iron."],"exits":[{"to":677,"exit":"go","move":"go gate"}],"color":"#00FFFF"},
  {"id":755,"x":-670,"y":-492,"z":0,"title":"Almalne Alolan, Among the Blooms","descriptions":["The farmland here has been allowed to become a field of wildflowers.  Blue forget-me-nots, brilliant orange poppies, white larkspurs, and miniature sunflowers blend together in a riot of hues amidst the backdrop of dark green grasses.  Flitting from flower to flower, rotund bumblebees create a humming buzz.  Placed at the edge of the myriad of blooms is a finely wrought iron gate."],"exits":[{"to":678,"exit":"go","move":"go iron gate"}],"color":"#00FFFF"},
  {"id":756,"x":-250,"y":-760,"z":0,"title":"Stone Inn, Central Room","descriptions":["Wagon-wheel chandeliers, fitted with gaethzen lights, hang from the high, arched ceiling beams.  A glass counter containing hand-held foods faces the entrance while displays of other merchandise are placed nearby.  Stairs along the west wall climb upwards, and a small opening along the northeast wall leads deeper into the building."],"exits":[{"to":139,"exit":"out","move":"out"},{"to":757,"exit":"climb","move":"climb wooden staircase"},{"to":761,"exit":"go","move":"go opening"}],"color":"#FF0000"},
  {"id":757,"x":-250,"y":-750,"z":0,"title":"Stone Inn, Upper Hallway","descriptions":["The north side of the carpeted hallway consists of large panes of glass that provide a breathtaking view of the Dragon Spine Mountains in the distance while a series of doors on either side lead to guest rooms for the inn's weary patrons."],"exits":[{"to":756,"exit":"climb","move":"climb wooden staircase"},{"to":758,"exit":"go","move":"go ironwood door"},{"to":759,"exit":"go","move":"go silverwillow door"},{"to":760,"exit":"go","move":"go goldenoak door"}]},
  {"id":758,"x":-260,"y":-740,"z":0,"title":"Stone Inn, Ironwood Room","descriptions":["A grand tapestry hangs over the mantle along the dark grain of the polished wood walls, while rich burgundy curtains, draped with gold satin cords, hang across a nearby window.  The massive ironwood sleigh bed, with ornately carved accents, is covered with opulent damask bedding and adorned with several matching, tasseled pillows providing comfort to any weary traveler.  A sweet, intoxicating scent fills the room from the lotus blossom bouquet, arranged in a clay vase, on a nightstand near the bed."],"exits":[{"to":757,"exit":"go","move":"go ironwood door"}],"color":"#00FFFF"},
  {"id":759,"x":-250,"y":-740,"z":0,"title":"Stone Inn, Silverwillow Room","descriptions":["Vibrant teal silk lines the walls, combining with the plush ivory carpet that covers the polished wood floors of the spacious room.  An oversized, canopied silverwillow bed stands against one wall, covered with a floral comforter and plump pillows, both edged with ivory eyelet lace.  On the other side of the room, a satin settee invites a comfortable rest next to an ornate pedestal holding a wing-swept raven statue."],"exits":[{"to":757,"exit":"go","move":"go silverwillow door"}],"color":"#00FFFF"},
  {"id":760,"x":-240,"y":-740,"z":0,"title":"Stone Inn, Goldenoak Room","descriptions":["Rich tones of gold, russet orange, and brown envelop the room with a warm ambiance.  Sweeping gilded brocades drape a large, half-round window beside a broad, potted palm.  Across the room, an oil painting overlooks a small nightstand tucked next to an ornately carved four-poster bed that is swathed in an opulent silk comforter and an array of plump pillows."],"exits":[{"to":757,"exit":"go","move":"go goldenoak door"}],"color":"#00FFFF"},
  {"id":761,"x":-240,"y":-760,"z":0,"title":"Stone Inn, Northeast Hallway","descriptions":["A large stuffed snowbeast is positioned between the two doors at the end of this hallway, as if guarding them from unwanted intruders.  The ferocious specimen appears to be lunging forward with claws extended, making it difficult to discern the image on each door.  A thick rug extends along the length of the hallway, but the lack of illumination makes it hard to tell if anyone has used this area recently."],"exits":[{"to":762,"exit":"go","move":"go wooden door"},{"to":763,"exit":"go","move":"go wood-framed opening"},{"to":756,"exit":"go","move":"go shop"}]},
  {"id":762,"x":-230,"y":-770,"z":0,"title":"Stone Inn, Dappled Camel Locker Room","descriptions":["Bamboo poles line the perimeter of this room, creating the appearance of a hut.  Polished pea gravel covers the floor, and a thatched roof completes the scene.  Two doors sit opposite each other while a row of open lockers have been attached to one wall."],"exits":[{"to":764,"exit":"go","move":"go bamboo door"},{"to":761,"exit":"go","move":"go wooden door"}]},
  {"id":763,"x":-230,"y":-750,"z":0,"title":"Stone Inn, Shaggy Dromedary Locker Room","descriptions":["Bamboo poles line the perimeter of this room, creating the appearance of a hut.  Polished pea gravel covers the floor, and a thatched roof completes the scene.  Two exits sit opposite each other while a row of open lockers have been attached to one wall."],"exits":[{"to":764,"exit":"go","move":"go bamboo door"},{"to":761,"exit":"go","move":"go wood-framed opening"}]},
  {"id":764,"x":-220,"y":-760,"z":0,"title":"Stone Inn, Lounge","descriptions":["An elaborately detailed mosaic surrounds the area with a vibrant backdrop of folks basking beneath a golden sun, while others appear to picnic under broad, multi-colored umbrellas.  Several bamboo lounge chairs rest beside a rattan serving cart, and the natural sandstone floors emulate a sandy beach that slopes towards a refreshing pool."],"exits":[{"to":762,"exit":"go","move":"go second bamboo hut"},{"to":763,"exit":"go","move":"go bamboo hut"},{"to":765,"exit":"go","move":"go sauna"},{"to":766,"exit":"go","move":"go pool"}]},
  {"id":765,"x":-210,"y":-770,"z":0,"title":"Stone Inn, Sauna","descriptions":["A column of steam rises from a large wrought-iron brazier that dominates the center of this octagonal room of white stone.  Slatted ironwood benches have been placed around the brazier to provide seating for clients wishing to relax or converse.  Occasionally, an attendant can be seen through the steam, making sure that everything is in its proper place."],"exits":[{"to":764,"exit":"go","move":"go ironwood door"}],"color":"#FF0000"},
  {"id":766,"x":-210,"y":-750,"z":0,"title":"Stone Inn, Pool","descriptions":["Snow-white marble encloses the pool of crystal-clear water, while the surrounding walls are detailed with an intricate mosaic of the open sea.  Opposite the shore, tiny vibrant tiles meld into a picturesque scene of rolling, azure blue waves capped in frothy white.  Along the far wall, a majestic galleon set with full sails journeys across the rippled waters, beneath a gleaming sunset of crimson hues on a distant horizon."],"exits":[{"to":764,"exit":"go","move":"go lounge"}]},
  {"id":767,"x":-270,"y":-760,"z":0,"title":"Marachek's Oak, Caravan Warehouse","descriptions":["The length of the warehouse has been roped off, preventing visitors from wandering into the nearby workspace.  Carpenters and blacksmiths move about the warehouse, applying their trades amongst several unfinished caravans.  Multiple displays of caravan customization adorn the eastern and western partition of this area."],"exits":[{"to":526,"exit":"west","move":"west"},{"to":768,"exit":"go","move":"go dark curtain"}],"color":"#FF0000"},
  {"id":768,"x":-270,"y":-750,"z":0,"title":"Caravan Warehouse, Curtained Corner","descriptions":["This curtained area contains only two easels resting against the walls and a leather sign.  The distant sounds from the rest of the warehouse are muffled by the thick curtain."],"exits":[{"to":767,"exit":"out","move":"out"}],"color":"#FF0000"}
 ],
