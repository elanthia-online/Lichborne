{
 "format": "damap",
 "version": 1,
 "id": "34",
 "name": "Mistwood Forest",
 "file": "Map34_Mistwood_Forest.xml",
 "includes": [
  "Map34a_Rossman's_Landing.xml"
 ],
 "rooms": [
  {"id":1,"x":0,"y":130,"z":0,"title":"Mistwood Forest, Northwest Road","descriptions":["Almost as wide as a Gor'Tog is tall, a lightning-blasted stump is all that remains of a once-mighty mistwood tree.  The charred wood, crackled by heat, is split into jagged spikes that tower above the fallen branches.  Blueberry bushes cluster around its base, thriving in the ashes.  To the northwest, the forest gives way to fields of wheat and barley surrounding a palisaded wooden fort."],"exits":[{"to":4,"exit":"east","move":"east"},{"to":2,"exit":"northwest","move":"northwest"}],"color":"#008000","aliases":["RTT20","RT-MF-GF"]},
  {"id":2,"x":-20,"y":110,"z":0,"title":"Mistwood Forest, Northwest Road","descriptions":["Fields of grain, all green and gold, sway in the light breeze.  Ditches line both sides of the road to provide irrigation and discourage travelers from straying off the track as they make their way to or from the riverside keep."],"exits":[{"to":1,"exit":"southeast","move":"southeast"},{"to":3,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":3,"x":-40,"y":110,"z":0,"title":"Rossman's Landing, Southeast Gate","descriptions":["A wooden palisade, about twice the height of an Elf, rises above the fields around the town.  Pacing back and forth on a walkway, a guard is visible through the palisade's arrow slits, while others man the gates.  A series of shallow trenches filled with sharpened wooden stakes surround the town, offering further defense against attack."],"exits":[{"to":2,"exit":"east","move":"east"},{"to":166,"exit":"go","move":"go gate"}],"color":"#008000","aliases":["gate to Rossman's Landing"]},
  {"id":4,"x":40,"y":130,"z":0,"title":"Mistwood Forest, Northwest Road","descriptions":["Grey-barked branches of mistwood trees arch over the packed earth road to provide some measure of protection from wind and weather.  Wide furled leaves catch rainwater and hold it until the sun's heat releases it as a gentle mist, giving the tree its name.  Prized by carpenters, the dark wood features subtle veins of green and silver when properly aged and polished."],"exits":[{"to":5,"exit":"southeast","move":"southeast"},{"to":1,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":5,"x":60,"y":150,"z":0,"title":"Mistwood Forest, Small Clearing","descriptions":["Three paths through the forest come together in this small clearing bordered by bluebells and cowslips.  A gnarled hawthorn tree grows alone in the center of the open space, spreading its dark limbs protectively over a weathered gravestone."],"exits":[{"to":10,"exit":"northeast","move":"northeast"},{"to":6,"exit":"south","move":"south"},{"to":4,"exit":"northwest","move":"northwest"}],"color":"#008000","aliases":["marker"]},
  {"id":6,"x":60,"y":170,"z":0,"title":"Mistwood Forest, Shadowed Thicket","descriptions":["Pink lady's slipper orchids and deep red trillium are but two of the flowers that grow in the shadowed corners of the forest, thriving in the dappled green light that filters through the leaves.  Paw marks in the soft dirt of the trail superimpose the cloven-hoofed tracks of the local deer."],"exits":[{"to":5,"exit":"north","move":"north"},{"to":7,"exit":"southeast","move":"southeast"}],"color":"#008000"},
  {"id":7,"x":80,"y":190,"z":0,"title":"Mistwood Forest, Forest's Edge","descriptions":["Soft-edged shadows pool beneath the low shrubs at the edge of the forest.  The path winds back and forth as it traverses the thicket, obeying the instincts of generations of deer as they follow the sound of rushing water that heralds a nearby river to the south."],"exits":[{"to":8,"exit":"south","move":"south"},{"to":6,"exit":"northwest","move":"northwest"}],"color":"#008000","aliases":["RTT21","RT-MF-SM"]},
  {"id":8,"x":80,"y":210,"z":0,"title":"Jantspyre River, North Bank","descriptions":["Boggy soil squishes underfoot as the ground slopes down toward the rolling waters of the Jantspyre River.  To the north, the path disappears into the dim shadows of Mistwood Forest, fading quickly from view."],"exits":[{"to":7,"exit":"go","move":"go path"},{"to":9,"exit":"go","move":"go bank"}],"color":"#008000"},
  {"id":9,"x":80,"y":230,"z":0,"title":"Jantspyre River, In the Water","descriptions":["A wide, sandy ramp flows up from the north bank of the creek, certainly shallow enough to allow you to scramble out of the water.  Clusters of pale birch trees lean out over the banks, their silvery bark peeling away from the wood in curling strips.  To the southeast, a brook branches off from the main waterway, leaving the river flowing more gently as it continues to the west.","A wide, sandy ramp flows up from the north bank of the creek, certainly shallow enough to allow you to scramble out of the water.  Clusters of pale birch trees lean out over the banks, their silvery bark peeling away from the wood in curling strips.  Dappled sunlight filters through the trees' green leaves to sparkle against the water's surface.  To the southeast, a brook branches off from the main waterway, leaving the river flowing more gently as it continues to the west."],"exits":[{"to":161,"exit":"northeast","move":"swim northeast"},{"to":16,"exit":"southeast","move":"swim southeast"},{"to":11,"exit":"west","move":"swim west"},{"to":8,"exit":"go","move":"go ramp"}],"color":"#0000FF","aliases":["Jantspyre River"]},
  {"id":10,"x":80,"y":130,"z":0,"title":"Mistwood Forest, Narrow Trail","descriptions":["The road wends its way back and forth through the trees.  Little more than a dirt track bordered by curseweed and other thorny shrubs, its rutted surface is shadowed by overhanging branches.  The silence is broken from time to time by low growls or the chirping of unseen birds."],"exits":[{"to":5,"exit":"southwest","move":"southwest"},{"to":23,"exit":"go","move":"go thicket"}],"color":"#008000","aliases":["RTT19","RT-MFG-MF"]},
  {"id":11,"x":60,"y":230,"z":0,"title":"Jantspyre River, In the Water","descriptions":["Deep grooves etched into the rocky bank mark the passage of years as the water gouges wide, rippling channels beneath the overhanging rock.  Branches and logs floating down the river catch on the sides of the creekbed, causing them to swing around with almost lethal force before the momentum jars them free.  A traveler attempting to ford the stream must be wary of such hazards."],"exits":[{"to":9,"exit":"east","move":"swim east"},{"to":12,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":12,"x":40,"y":250,"z":0,"title":"Jantspyre River, In the Water","descriptions":["Long and low, a lichen-streaked grey boulder rises from the current.  Lumpy ridges along the top resemble nothing more than two hands crossed on the breast of a massive corpse laid out at a funeral, giving rise to the original name of Giant's Pyre River."],"exits":[{"to":11,"exit":"northeast","move":"swim northeast"},{"to":13,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":13,"x":20,"y":270,"z":0,"title":"Jantspyre River, In the Water","descriptions":["The water surges with renewed energy as it passes the end of a long, low rock in the river, swirling around as opposing currents meet.  Half-sunken logs shift and groan as the current pounds against them in an ongoing battle to dislodge the obstructions in the river's path."],"exits":[{"to":12,"exit":"northeast","move":"swim northeast"},{"to":14,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":14,"x":0,"y":270,"z":0,"title":"Jantspyre River, In the Water","descriptions":["Crystal clear water tumbles, icy cold, over the rounded pebbles of the streambed.  Spray slicks the dark grey rocks on either side.  The current pushes you toward the south bank where, despite the wet surface, an agile climber could probably scramble out of the water.  Just downstream, the creek flows over a pile of logs tumbled higgledy-piggledy like some giant's jackstraws."],"exits":[{"to":13,"exit":"east","move":"swim east"},{"to":15,"exit":"go","move":"go bank"}],"color":"#0000FF"},
  {"id":15,"x":0,"y":290,"z":0,"title":"Jantspyre River, South Bank","descriptions":["The forest gives way to the banks of a swift-flowing river.  No bridge crosses the water, and the far bank is too steep to clamber out."],"exits":[{"to":0,"exit":"southwest","move":"southwest"},{"to":14,"exit":"go","move":"go bank"}],"aliases":["Riverhaven"],"linksTo":"Map33a_Road_to_Therenborough.xml"},
  {"id":16,"x":100,"y":250,"z":0,"title":"Butternut Creek, In the Water","descriptions":["Whirling eddies catch the light as the narrow creek nears its end, becoming nothing more than another tributary of the rapid waters of the Jantspyre River.  Silver-scaled minnows dart from shadow to dappled shadow as they feed on small bits of greenery caught between the rounded pebbles of the creek-bed, ever wary of the larger trout."],"exits":[{"to":17,"exit":"south","move":"swim south"},{"to":9,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF","aliases":["Butternut Creek"]},
  {"id":17,"x":100,"y":270,"z":0,"title":"Butternut Creek, In the Water","descriptions":["The creek widens into a shallow pool edged by overhanging butternut trees.  Water burbles quietly as it flows, peaceful and serene, the gentle murmur broken from time to time by the chirr of crickets and the hoarse croak of a bullfrog, punctuated by an occasional splash."],"exits":[{"to":16,"exit":"north","move":"swim north"},{"to":18,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":18,"x":120,"y":290,"z":0,"title":"Butternut Creek, In the Water","descriptions":["Deer tracks mark the banks of the creek, impressed in the soft mud by the animals that drink from the stream.  The gentle creatures are not the only drinkers, however -- tufts of fur caught on brush and the footprints in the mud point to large cats and some other, two-legged visitor."],"exits":[{"to":19,"exit":"east","move":"swim east"},{"to":17,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":19,"x":140,"y":290,"z":0,"title":"Butternut Creek, In the Water","descriptions":["Flowing water has undercut the creek bank, making it impossible to climb out.  Mottled brown crayfish crawl across the pebbles at the bottom of the stream, their claws waving aimlessly as they go about their daily search for food amidst the swaying green water weeds."],"exits":[{"to":20,"exit":"southeast","move":"swim southeast"},{"to":18,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":20,"x":160,"y":310,"z":0,"title":"Butternut Creek, In the Water","descriptions":["Burbling gaily, water tumbles down the stream, catching up fallen twigs and leaves to swirl them in the current.  Canted butternut trees lean over the bank, cloaking the creek in dappled shadows and faint hints of starlight.","Burbling gaily, water tumbles down the stream, catching up fallen twigs and leaves to swirl them in the current.  Canted butternut trees lean over the bank, cloaking the creek in dappled shadows and dancing, green-tinged rays of light."],"exits":[{"to":21,"exit":"east","move":"swim east"},{"to":19,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":21,"x":180,"y":310,"z":0,"title":"Butternut Creek, Beaver Dam","descriptions":["Fallen logs sprawl from bank to bank, piled high with branches and mud daub to dam the water beyond, forming a wide pool.  Shallow sluices along the top channel the excess water, allowing it to tumble in sparkling streams and continue burbling down the creek, while leaving the beaver's den snug and dry."],"exits":[{"to":20,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":23,"x":140,"y":70,"z":0,"title":"Mistwood Forest, Wild Rose Thicket","descriptions":["Pale pink roses blossom against thorny green leaves, growing in profusion in the dense thicket.  The trail twists and turns, following the hoofprints of countless generations of deer.  An intense fragrance perfumes the air, but all the roses in the world can't conceal the sickly-sweet stench of rotting meat that underlies it."],"exits":[{"to":25,"exit":"northeast","move":"northeast"},{"to":26,"exit":"east","move":"east"},{"to":24,"exit":"south","move":"south"},{"to":10,"exit":"go","move":"go forest"}]},
  {"id":24,"x":140,"y":110,"z":0,"title":"Mistwood Forest, Wild Rose Thicket","descriptions":["Pale pink roses blossom against thorny green leaves, growing in profusion in the dense thicket.  The trail twists and turns, following the hoofprints of countless generations of deer.  An intense fragrance perfumes the air, but all the roses in the world can't conceal the sickly-sweet stench of rotting meat that underlies it."],"exits":[{"to":23,"exit":"northeast","move":"northeast"}]},
  {"id":25,"x":140,"y":30,"z":0,"title":"Mistwood Forest, Wild Rose Thicket","descriptions":["Pale pink roses blossom against thorny green leaves, growing in profusion in the dense thicket.  The trail twists and turns, following the hoofprints of countless generations of deer.  An intense fragrance perfumes the air, but all the roses in the world can't conceal the sickly-sweet stench of rotting meat that underlies it."],"exits":[{"to":23,"exit":"east","move":"east"}]},
