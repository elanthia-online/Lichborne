 "rooms": [
  {"id":1,"x":220,"y":280,"z":0,"title":"Cavern of Fire, Stalagmite Maze","descriptions":["The air feels thick and heavy with humidity as the heat bakes away what moisture seeps from the cavern's rocky walls.  Stalagmites jut up from the floor, forcing travelers to make their way through a confusing maze of passages that twist and turn, some rising, some falling, some doubling back upon themselves.  The haze of smoke, lit by a faint glow emanating from hairline cracks in the walls, makes the cavern even more disorienting."],"exits":[{"to":4,"exit":"east","move":"east"},{"to":2,"exit":"north","move":"north"},{"to":3,"exit":"west","move":"west"},{"to":14,"exit":"climb","move":"climb ladder"}]},
