{
 "format": "damap",
 "version": 1,
 "id": "50",
 "name": "Segoltha River",
 "file": "Map50_Segoltha_River.xml",
 "rooms": [
  {"id":1,"x":260,"y":100,"z":0,"title":"Riverbank Trail","descriptions":["The sounds of the city fade slightly into the background, muffled by the steep slope of the riverbank that lines the trail.  The path follows the river, edging along the slippery slope that is littered with old bottles, broken wood and dead fish."],"exits":[{"to":2,"exit":"west","move":"west"},{"to":8,"exit":"climb","move":"climb steep slope"}]},
  {"id":2,"x":240,"y":100,"z":0,"title":"Riverbank Trail","descriptions":["The fading sounds of the city to the north are overpowered by the constant rushing and reverberation of the river below.  The stench of dead fish is intense along the refuse-littered slope."],"exits":[{"to":1,"exit":"east","move":"east"},{"to":3,"exit":"west","move":"west"}]},
  {"id":3,"x":220,"y":100,"z":0,"title":"Riverbank Trail","descriptions":["To the west, piles of debris and junk block any possible passage.  The riverbank to the north is too steep to climb, as evidenced by the bits of torn cloth and slide marks that mar the muddy surface.  Below is the Selgotha river, its murky depths slightly calmer in this spot as the westward rushing currents slow to navigate the city-built embankment."],"exits":[{"to":2,"exit":"east","move":"east"},{"to":4,"exit":"go","move":"dive river"}]},
  {"id":4,"x":200,"y":120,"z":0,"title":"Segoltha River, North Bank","descriptions":["Swiftly rushing water cascades over a rocky riverbed, channeling towards treacherous rapids that block further progress downstream.  A small defile in the river bank allows a quick scramble up to safety."],"exits":[{"to":5,"exit":"west","move":"swim west"},{"to":3,"exit":"climb","move":"climb bank"}],"color":"#000080"},
  {"id":5,"x":180,"y":120,"z":0,"title":"Segoltha River, North Bank","descriptions":["Hugging the river bank, the swirling waters surge against the slick banks.  Undercurrents seethe beneath the surface, seeking to drag the unwary down into the river's heart."],"exits":[{"to":4,"exit":"east","move":"swim east"},{"to":6,"exit":"west","move":"swim west"}],"color":"#000080"},
  {"id":6,"x":160,"y":120,"z":0,"title":"Segoltha River, North Bank","descriptions":["Surging currents batter against the mud banks, undercutting them and adding their silt to the muddy waters that comprise the Segoltha.  Whirling eddies mark the surface, hiding the treacherous undertow."],"exits":[{"to":5,"exit":"east","move":"swim east"},{"to":7,"exit":"west","move":"swim west"}],"color":"#000080"},
  {"id":7,"x":140,"y":120,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":32,"exit":"north","move":"swim north"},{"to":7,"exit":"northeast","move":"swim northeast"},{"to":6,"exit":"east","move":"swim east"},{"to":7,"exit":"southeast","move":"swim southeast"},{"to":9,"exit":"south","move":"swim south"},{"to":9,"exit":"southwest","move":"swim southwest"},{"to":7,"exit":"west","move":"swim west"},{"to":32,"exit":"northwest","move":"swim northwest"}],"color":"#000080"},
  {"id":8,"x":280,"y":100,"z":0,"title":"The Crossing, Haven's End","descriptions":["This is the end of the road - literally.  All to the north and west, this dead end is surrounded by a weed-choked vacant lot, a remnant of some ancient farmer's croft or field that was incorporated into the Crossing early on in its evolution.  The dark, rich bank of the Segoltha River rises steeply to the south, a difficult climb due to the slick and precipitous slope."],"exits":[{"to":0,"exit":"east","move":"east"}],"aliases":["Crossing","NE"],"linksTo":"Map1_Crossing.xml"},
  {"id":9,"x":140,"y":140,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":7,"exit":"north","move":"swim north"},{"to":10,"exit":"south","move":"swim south"},{"to":9,"exit":"northeast","move":"swim northeast"},{"to":9,"exit":"east","move":"swim east"},{"to":9,"exit":"southeast","move":"swim southeast"},{"to":10,"exit":"southwest","move":"swim southwest"},{"to":9,"exit":"west","move":"swim west"},{"to":7,"exit":"northwest","move":"swim northwest"}],"color":"#010165"},
  {"id":10,"x":140,"y":160,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":11,"exit":"south","move":"swim south"},{"to":9,"exit":"north","move":"swim north"},{"to":10,"exit":"northeast","move":"swim northeast"},{"to":9,"exit":"northwest","move":"swim northwest"},{"to":10,"exit":"east","move":"swim east"},{"to":10,"exit":"west","move":"swim west"},{"to":10,"exit":"southeast","move":"swim southeast"},{"to":11,"exit":"southwest","move":"swim southwest"}],"color":"#010165"},
  {"id":11,"x":140,"y":180,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":11,"exit":"northeast","move":"swim northeast"},{"to":10,"exit":"north","move":"swim north"},{"to":12,"exit":"south","move":"swim south"},{"to":10,"exit":"northwest","move":"swim northwest"},{"to":11,"exit":"east","move":"swim east"},{"to":11,"exit":"west","move":"swim west"},{"to":11,"exit":"southeast","move":"swim southeast"},{"to":12,"exit":"southwest","move":"swim southwest"}],"color":"#010165"},
  {"id":12,"x":140,"y":200,"z":0,"title":"Segoltha River, Near the Boulder","descriptions":["Rising majestically above the rushing water, a massive rock outcropping emerges from the muddy river in the distance.  Forming a small islet in the watercourse, the top is crowned by a colossal tree."],"exits":[{"to":13,"exit":"south","move":"swim south"},{"to":11,"exit":"north","move":"swim north"},{"to":12,"exit":"northeast","move":"swim northeast"},{"to":11,"exit":"northwest","move":"swim northwest"},{"to":12,"exit":"east","move":"swim east"},{"to":12,"exit":"west","move":"swim west"},{"to":12,"exit":"southeast","move":"swim southeast"},{"to":13,"exit":"southwest","move":"swim southwest"}],"color":"#000080"},
  {"id":13,"x":140,"y":220,"z":0,"title":"Segoltha River, Near the Boulder","descriptions":["Towering over the river's surface, the looming bulk of the rocky island creates a sheltered area in the churning currents of the river.  Silt has been deposited in the refuge, forming a small muddy shoreline.  Mud gives way to drier sand of a bank that hugs the edge of the rock."],"exits":[{"to":13,"exit":"northeast","move":"swim northeast"},{"to":14,"exit":"south","move":"swim south"},{"to":12,"exit":"north","move":"swim north"},{"to":12,"exit":"northwest","move":"swim northwest"},{"to":13,"exit":"east","move":"swim east"},{"to":13,"exit":"southeast","move":"swim southeast"},{"to":37,"exit":"go","move":"go shoreline"}],"color":"#000080"},
  {"id":14,"x":140,"y":240,"z":0,"title":"Segoltha River, Near the Boulder","descriptions":["Scattered driftwood piled along the muddy shore testifies to the power of the river, each pile deposited high above the current waterline by vanished floods.  Tiny tracks of unknown animals spread a delicate tracery across the mud and sand."],"exits":[{"to":15,"exit":"south","move":"swim south"},{"to":13,"exit":"north","move":"swim north"},{"to":14,"exit":"northeast","move":"swim northeast"},{"to":14,"exit":"east","move":"swim east"},{"to":14,"exit":"southeast","move":"swim southeast"},{"to":15,"exit":"southwest","move":"swim southwest"},{"to":38,"exit":"go","move":"go shore"}],"color":"#000080"},
  {"id":15,"x":140,"y":260,"z":0,"title":"Segoltha River, Near the Boulder","descriptions":["Rising majestically above the rushing water, a massive rock outcropping emerges from the muddy river in the distance.  Forming a small islet in the watercourse, the top is crowned by a colossal tree."],"exits":[{"to":14,"exit":"north","move":"swim north"},{"to":16,"exit":"south","move":"swim south"},{"to":15,"exit":"northeast","move":"swim northeast"},{"to":15,"exit":"east","move":"swim east"},{"to":15,"exit":"southeast","move":"swim southeast"},{"to":16,"exit":"southwest","move":"swim southwest"},{"to":15,"exit":"west","move":"swim west"},{"to":14,"exit":"northwest","move":"swim northwest"}],"color":"#000080"},
  {"id":16,"x":140,"y":280,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":15,"exit":"north","move":"swim north"},{"to":17,"exit":"south","move":"swim south"},{"to":16,"exit":"northeast","move":"swim northeast"},{"to":16,"exit":"east","move":"swim east"},{"to":16,"exit":"southeast","move":"swim southeast"},{"to":17,"exit":"southwest","move":"swim southwest"},{"to":16,"exit":"west","move":"swim west"},{"to":15,"exit":"northwest","move":"swim northwest"}],"color":"#010165"},
  {"id":17,"x":140,"y":300,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":16,"exit":"north","move":"swim north"},{"to":18,"exit":"south","move":"swim south"},{"to":17,"exit":"northeast","move":"swim northeast"},{"to":17,"exit":"east","move":"swim east"},{"to":17,"exit":"southeast","move":"swim southeast"},{"to":18,"exit":"southwest","move":"swim southwest"},{"to":17,"exit":"west","move":"swim west"},{"to":16,"exit":"northwest","move":"swim northwest"}],"color":"#010165"},
  {"id":18,"x":140,"y":320,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":17,"exit":"north","move":"swim north"},{"to":19,"exit":"south","move":"swim south"},{"to":18,"exit":"northeast","move":"swim northeast"},{"to":18,"exit":"east","move":"swim east"},{"to":18,"exit":"southeast","move":"swim southeast"},{"to":19,"exit":"southwest","move":"swim southwest"},{"to":18,"exit":"west","move":"swim west"},{"to":17,"exit":"northwest","move":"swim northwest"}],"color":"#010165"},
  {"id":19,"x":140,"y":340,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":18,"exit":"north","move":"swim north"},{"to":20,"exit":"south","move":"swim south"},{"to":19,"exit":"northeast","move":"swim northeast"},{"to":19,"exit":"east","move":"swim east"},{"to":19,"exit":"southeast","move":"swim southeast"},{"to":20,"exit":"southwest","move":"swim southwest"},{"to":19,"exit":"west","move":"swim west"},{"to":18,"exit":"northwest","move":"swim northwest"}],"color":"#010165"},
  {"id":20,"x":140,"y":360,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":19,"exit":"north","move":"swim north"},{"to":21,"exit":"south","move":"swim south"},{"to":20,"exit":"northeast","move":"swim northeast"},{"to":20,"exit":"east","move":"swim east"},{"to":20,"exit":"southeast","move":"swim southeast"},{"to":21,"exit":"southwest","move":"swim southwest"},{"to":20,"exit":"west","move":"swim west"},{"to":19,"exit":"northwest","move":"swim northwest"}],"color":"#010165"},
  {"id":21,"x":140,"y":380,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":20,"exit":"north","move":"swim north"},{"to":22,"exit":"south","move":"swim south"},{"to":21,"exit":"northeast","move":"swim northeast"},{"to":21,"exit":"east","move":"swim east"},{"to":21,"exit":"southeast","move":"swim southeast"},{"to":22,"exit":"southwest","move":"swim southwest"},{"to":21,"exit":"west","move":"swim west"},{"to":20,"exit":"northwest","move":"swim northwest"}],"color":"#010165"},
  {"id":22,"x":140,"y":400,"z":0,"title":"Segoltha River, Near the South Bank","descriptions":["Distant treetops show above the swirling water, shrouded in mist and haze.  The seething waves are heavy with silt and debris carried downstream from distant mountains.  Little eddies on the river's surface conceal dangerous currents below."],"exits":[{"to":22,"exit":"west","move":"swim west"},{"to":21,"exit":"north","move":"swim north"},{"to":21,"exit":"northwest","move":"swim northwest"},{"to":22,"exit":"northeast","move":"swim northeast"},{"to":22,"exit":"east","move":"swim east"},{"to":23,"exit":"southeast","move":"swim southeast"},{"to":23,"exit":"south","move":"swim south"}],"color":"#000080"},
  {"id":23,"x":140,"y":420,"z":0,"title":"Segoltha River, South Bank","descriptions":["Sheltered by the ruined bulk of a stranded ship, the current here is gentle compared to the rushing cataract in the middle of the river.  The protection of the hulk allows sand to accumulate, creating a small beach along the south shore.  Debris from the wrecked ship litters the bank with boards and timbers weathered from the elements."],"exits":[{"to":22,"exit":"north","move":"swim north"},{"to":31,"exit":"east","move":"swim east"},{"to":25,"exit":"southeast","move":"swim southeast"},{"to":24,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":24,"x":140,"y":440,"z":0,"title":"Fisherman's Trail, Near the Wreck","descriptions":["In the tiny cove, the bulk of a wrecked ship lies beached along the shore to the west.  Lying on its side, it is an easy scramble up a pile of debris to the main deck.  Near the shore, a small firepit, surrounded by stumps, is filled with half-burned wood and ashes.  Snapped fishing lines and rusted hooks litter the ground, testifying to the normal usage of the cove."],"exits":[{"to":25,"exit":"east","move":"east"},{"to":23,"exit":"north","move":"north"},{"to":31,"exit":"northeast","move":"northeast"},{"to":42,"exit":"go","move":"go shipwreck"}]},
  {"id":25,"x":160,"y":440,"z":0,"title":"Fisherman's Trail, River Bank","descriptions":["Muddy riverbank gives way to a grassy path, as a footpath slopes down to the shore.  The call of shorebirds echoes through the area, mixed with the sounds of buzzing insects and scurrying rodents in the underbrush."],"exits":[{"to":31,"exit":"north","move":"north"},{"to":26,"exit":"east","move":"east"},{"to":24,"exit":"west","move":"west"},{"to":23,"exit":"northwest","move":"northwest"}]},
  {"id":26,"x":180,"y":440,"z":0,"title":"Fisherman's Trail, Footpath","descriptions":["The vegetation grows thickly here, fertilized by the steady stream of birds and wildlife attracted to the nearby river.  To the west, the riverbank subsides into a more gradual slope, easing entrance into the water for animals and fishermen alike.  Here however, the man-made bank drops off treacherously, its slippery slope inviting the sounds of the river to permeate the area."],"exits":[{"to":27,"exit":"east","move":"east"},{"to":25,"exit":"west","move":"west"}]},
  {"id":27,"x":200,"y":440,"z":0,"title":"Fisherman's Trail, Footpath","descriptions":["The tree-lined trail winds an erratic route along the riverbank, eternally muddy and smelling of fish.  The bank drops off steeply into the river below, a deadly climb for anyone foolish enough to try."],"exits":[{"to":28,"exit":"east","move":"east"},{"to":26,"exit":"west","move":"west"}]},
  {"id":28,"x":220,"y":440,"z":0,"title":"Fisherman's Trail, Footpath","descriptions":["The path continues along a slight slope as it winds its way beside the river.  Large rocks and mossy boulders make the way a bit more treacherous, and the shadows cast by the large trees to the south cause the area to stay quite moist.  The blaring of a ferry's horn can be heard occasionally, far in the distance."],"exits":[{"to":29,"exit":"east","move":"east"},{"to":27,"exit":"west","move":"west"}]},
  {"id":29,"x":240,"y":440,"z":0,"title":"Fisherman's Trail, Footpath","descriptions":["The well-worn path winds its way erratically between and around the few hardy bushes and shrubs that cling to the perpetually muddy riverbank.  Sparse vegetation interspersed with forgotten whiskey bottles and broken fishing poles lines the edges of the beaten track between the river to the west and the trail running southeast to the trade route."],"exits":[{"to":28,"exit":"west","move":"west"},{"to":30,"exit":"go","move":"go small trail"}]},
  {"id":30,"x":260,"y":460,"z":0,"title":"Southern Trade Route, Segoltha Plain","descriptions":["Sparse grass, weeds and a few hardy shrubs grow along this flat stretch of land that lies between the river bluffs and the nearby woodland.  The angry floods sweep away most of the vegetation, and each time the waters subside, life must begin here anew.  To the northeast lie the outskirts of Chelsea Overlook, a small community overlooking the south bank of the Segoltha."],"exits":[{"to":0,"exit":"north","move":"north"},{"to":0,"exit":"northeast","move":"northeast"},{"to":0,"exit":"south","move":"south"},{"to":29,"exit":"go","move":"go footpath"}],"aliases":["STR1","South"],"linksTo":"Map60_STR1.xml"},
  {"id":31,"x":160,"y":420,"z":0,"title":"Segoltha River, South Bank","descriptions":["Tenacious reeds and rushes cling to the riverbed, holding fast while surrounded by the swift current.  Sand and mud mix along the curving shore of this sheltered cove.  Although there are scattered trees along the riverbank, the forest is thin enough to allow passage up the bank and into the forest."],"exits":[{"to":25,"exit":"south","move":"swim south"},{"to":24,"exit":"southwest","move":"swim southwest"},{"to":23,"exit":"west","move":"swim west"},{"to":22,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":32,"x":140,"y":100,"z":0,"title":"Segoltha River, Midstream","descriptions":["Twisting currents of silt-laden water surge just below the river's surface.  A churning, heaving mass of dirty brown waves, the torrent of water stretches as far as the eye can see."],"exits":[{"to":33,"exit":"north","move":"swim north"},{"to":33,"exit":"northeast","move":"swim northeast"},{"to":32,"exit":"east","move":"swim east"},{"to":32,"exit":"southeast","move":"swim southeast"},{"to":7,"exit":"south","move":"swim south"},{"to":7,"exit":"southwest","move":"swim southwest"},{"to":32,"exit":"west","move":"swim west"},{"to":33,"exit":"northwest","move":"swim northwest"}],"color":"#010165"},
  {"id":33,"x":140,"y":80,"z":0,"title":"Segoltha River, North Bank","descriptions":["Swirling eddies seethe underneath the dirty brown river lapping against the muddy bank.  At the water's edge, a minuscule shelf of mud hugs the slick slope."],"exits":[{"to":33,"exit":"east","move":"swim east"},{"to":33,"exit":"southeast","move":"swim southeast"},{"to":32,"exit":"south","move":"swim south"},{"to":32,"exit":"southwest","move":"swim southwest"},{"to":33,"exit":"west","move":"swim west"},{"to":34,"exit":"climb","move":"climb riverbank"}],"color":"#000080"},
  {"id":34,"x":140,"y":60,"z":0,"title":"Tiger Clan, Riverbank","descriptions":["The trees in this area give way to a gently sloping riverbank.  Tufts of grass bravely peek through the sand in thick brownish clumps, adding a bit of traction on the perpetually muddy slope.  A slightly worn trail leads down the bank towards the murky river below."],"exits":[{"to":35,"exit":"northwest","move":"northwest"},{"to":33,"exit":"climb","move":"climb riverbank"}]},
  {"id":35,"x":120,"y":40,"z":0,"title":"Tiger Clan, Grassy Trail","descriptions":["Along a trail lined with willows, the smells of soggy grass, dead fish and peat moss permeate the atmosphere.  The bubbling and splashing of the nearby river overpower the usual sounds of the night, the looming trees giving cover to all manner of creatures within the depths of their shadows.","Along a trail lined with willows, the smells of soggy grass, dead fish and peat moss permeate the atmosphere.  The bubbling and splashing of the nearby river overpower the usual sounds of the wilderness, causing the shadowed areas of the trees and tall grasses to seem almost menacing in their silence.","Along a trail lined with willows, the smells of soggy grass, dead fish and peat moss permeate the atmosphere.  The bubbling and splashing of the nearby river overpower the usual sounds of the night, the looming trees giving cover to all manner of creatures within the depths of their shadows."],"exits":[{"to":34,"exit":"southeast","move":"southeast"},{"to":36,"exit":"go","move":"go tall grass"}]},
  {"id":36,"x":100,"y":20,"z":0,"title":"Tiger Clan Home, Old Mill","descriptions":["An old mill looks over the shoreline of the Segoltha River, its massive waterwheel splashing and churning the river's deep water.  Tall grasses and willows grow abundantly around the mill grounds.","An old mill looks over the shoreline of the Segoltha River, its massive waterwheel splashing and churning the river's deep water.  Tall grasses and willows grow abundantly around the mill grounds.  Village women stand in groups collecting bundles of willow wands and grass."],"exits":[{"to":0,"exit":"northeast","move":"northeast"}],"aliases":["Tiger Clan","NW"],"linksTo":"Map4a_Tiger_Clan.xml"},
  {"id":37,"x":120,"y":220,"z":0,"title":"Segoltha River, Sandbar","descriptions":["Secluded and safely out of reach of the swift-moving river, plants and animals seem to thrive here as evidenced by the extremely lush environs.  Young moss-covered trees are scattered haphazardly about, their strong roots taking advantage of the ideal conditions."],"exits":[{"to":38,"exit":"south","move":"south"},{"to":13,"exit":"none","move":"dive river"}],"aliases":["Sandbar"]},
  {"id":38,"x":120,"y":240,"z":0,"title":"Segoltha River, Sandbar","descriptions":["This little island is lush and teeming with life, but the sound of the rushing river engulfs even the most persistent of birds and insects.  A huge boulder takes up most of this area, rising from the sand like a miniature mountain."],"exits":[{"to":37,"exit":"north","move":"north"},{"to":14,"exit":"none","move":"dive river"},{"to":39,"exit":"climb","move":"climb huge boulder"}]},
  {"id":39,"x":100,"y":240,"z":0,"title":"Boulder, Base of Tree","descriptions":["The large rock is clean and worn smooth by years of harsh weather and flooded banks, its only adornment a massive pine tree, seemingly growing out of the rock face itself.  A long, thick rope dangles from one of the massive branches above."],"exits":[{"to":38,"exit":"climb","move":"climb huge boulder"},{"to":40,"exit":"climb","move":"climb pine tree"}]},
  {"id":40,"x":100,"y":220,"z":0,"title":"A Massive Pine Tree, Platform","descriptions":["Crude yet serviceable, a narrow platform has been built into the larger tree limbs.  A rocking chair sits precariously at one end, facing the panoramic view.  The tree continues to rise impossibly far above, providing ample shade while discouraging further exploration into its extensive heights.  One particularly narrow branch appears to lead further up -- but it would probably take a monkey to navigate it."],"exits":[{"to":39,"exit":"climb","move":"climb pine tree"},{"to":41,"exit":"climb","move":"climb narrow branch"},{"to":0,"exit":"none","move":"rt jump dangling rope"}],"aliases":["Massive Pine Tree","Pine Tree","Platform"]},
  {"id":41,"x":100,"y":200,"z":0,"title":"A Massive Pine Tree, Upper Branch","descriptions":["The night sky is overwhelming in its closeness, the darkness like a blanket to anyone who is brave enough to venture upon the treetops.  The branch sways delicately in the breeze that sometimes whisks through the treetops.  The overpowering sound of falling pine needles, rustling vines and leaves emphasizes the isolation of the surroundings, the muffled sound of the rushing river a soothing background noise.  A flash of city lights sparkles in the distance.","High up in the tree, hidden from the ground below by a layer of lichen and thickly intertwined vines is this somewhat precarious perch.  The branch, its leaves trembling perilously, sways delicately in the breeze that sometimes rustles through the treetops.  The view of the river is spectacular, its rushing water sparkling and swirling with a life of its own."],"exits":[{"to":40,"exit":"climb","move":"climb large branch"}]},
  {"id":42,"x":120,"y":440,"z":0,"title":"Wreck, Near the Bow","descriptions":["The one remaining mast juts upward from the ruined deck, leaning at an angle as it rises above the surrounding forest.  Missing planks on the deck make the footing treacherous, and the gaps provide glimpses into the sand- and muck-filled holds below.  Anything of value has long since been stripped from the ship, leaving only weathered wood and scraps of rope and canvas."],"exits":[{"to":43,"exit":"north","move":"north"},{"to":45,"exit":"south","move":"south"},{"to":24,"exit":"go","move":"go shore"},{"to":46,"exit":"climb","move":"climb wooden mast"}],"aliases":["Shipwreck","Wreck"]},
  {"id":43,"x":120,"y":420,"z":0,"title":"Wreck, Near the Stern","descriptions":["Protruding from the tilted decking, the shattered remnant of the mainmast dominates the area.  Little remains of the cordage and spars that once graced the mast except some bits and pieces of wood scattered about the deck."],"exits":[{"to":44,"exit":"north","move":"north"},{"to":42,"exit":"south","move":"south"}]},
  {"id":44,"x":120,"y":400,"z":0,"title":"Wreck, Stern","descriptions":["Decking ends abruptly above the swirling water of the river as the stern of the ship drops off into the muddy brown waters of the Segoltha.  Broken planks and timbers give mute testimony to the power of the river.  Little remains of the name once emblazoned on the stern, only the faded letters CK and FI."],"exits":[{"to":43,"exit":"south","move":"south"}]},
  {"id":45,"x":120,"y":460,"z":0,"title":"Wreck, Bow","descriptions":["Directly below the bow, a large, gaping hole opens in the hull, vivid testimony to the reason the ship lies beached on the shore.  Mud and muck spills from the breach, from which weeds and vines clinging to the dirt climb up the exposed wood surface.  Little remains of the rigging and tackle, just bits and pieces of rope scattered on the planks of the deck.  The stump of a bowsprit points at the surrounding forest."],"exits":[{"to":42,"exit":"north","move":"north"}]},
  {"id":46,"x":100,"y":440,"z":0,"title":"Wreck, Mast","descriptions":["Only half the crow's nest remains, little more than a platform with rickety railings dangling precipitously above the forest canopy.  Rotten wood makes the footing dangerous, and holes in the decking give glimpses of the sheer drop to the wreck below.  Not far above the lookout post, the mast breaks off, trailing bits of rope and tackle that undulate in the slightest breeze.  Precarious handholds on the mast permit climbing back down to the wreck below."],"exits":[{"to":42,"exit":"climb","move":"climb wooden mast"}]}
 ],
