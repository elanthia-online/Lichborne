{
 "format": "damap",
 "version": 1,
 "id": "91a",
 "name": "Cavern of Glass",
 "file": "Map91a_Cavern_of_Glass.xml",
 "rooms": [
  {"id":1,"x":140,"y":220,"z":0,"title":"Urrem'tier's Temple, Under the Interior","descriptions":["The scraping noises are louder now and seem to come from all around.  An arched doorway is cut into the black rock that leads off into an endless tunnel.  Torches are placed over the doorway to help light the way through the darkness."],"exits":[{"to":2,"exit":"go","move":"go arched doorway"}]},
  {"id":2,"x":140,"y":200,"z":0,"title":"Under the Temple, Urrem'tier's Tunnel","descriptions":["Darkness permeates the cave with the only light coming from some source to the north of the tunnel.  Trickling noises seem to come from behind the walls as well as an unfamiliar hissing sound coming from somewhere within."],"exits":[{"to":3,"exit":"north","move":"north"}]},
  {"id":3,"x":140,"y":180,"z":0,"title":"Aldauth's Lair, Cavern of Glass","descriptions":["Shadows flicker on every wall possibly coming from the torches reflecting off of the black crystal walls.  Tunnels branch off in many directions and show no signs of ending.  An unfamiliar sound, possibly hissing, is enough to make hair stand on end."],"exits":[{"to":16,"exit":"north","move":"north"},{"to":12,"exit":"northeast","move":"northeast"},{"to":4,"exit":"northwest","move":"northwest"},{"to":2,"exit":"south","move":"south"}]},
  {"id":4,"x":80,"y":120,"z":0,"title":"Aldauth's Lair, Cavern of Glass","descriptions":["Shadows flicker on every wall possibly coming from the torches reflecting off of the black crystal walls.  Tunnels branch off in many directions and show no signs of ending.  An unfamiliar sound, possibly hissing, is enough to make hair stand on end."],"exits":[{"to":5,"exit":"north","move":"north"},{"to":5,"exit":"east","move":"east"},{"to":3,"exit":"southeast","move":"southeast"},{"to":21,"exit":"southwest","move":"southwest"}]},
  {"id":5,"x":80,"y":100,"z":0,"title":"Cavern of Glass, Eylhaar's Grotto","descriptions":["Formations of marbled white and black glass make up the interior of the grotto.  Less eerie here, light seems to filter in from cracks in the ceiling, giving an indication the exit is near.  The tunnel narrows down to an entrance leading north back towards safety."],"exits":[{"to":6,"exit":"north","move":"north"},{"to":4,"exit":"south","move":"south"}]},
  {"id":6,"x":80,"y":80,"z":0,"title":"Cavern of Glass, Eylhaar's Grotto","descriptions":["An almost eerie quiet fills this part of the cavern.  No sounds seem to filter through except for the occasional echo of a footstep nearby.  Carved images in the cavern walls depict scenes of death in a more natural state."],"exits":[{"to":8,"exit":"northeast","move":"northeast"},{"to":5,"exit":"south","move":"south"},{"to":7,"exit":"northwest","move":"northwest"}]},
  {"id":7,"x":60,"y":60,"z":0,"title":"Cavern of Glass, Eylhaar's Grotto","descriptions":["An almost eerie quiet fills this part of the cavern.  No sounds seem to filter through except for the occasional echo of a footstep nearby.  Carved images in the cavern walls depict scenes of death in a more natural state."],"exits":[{"to":6,"exit":"southeast","move":"southeast"},{"to":8,"exit":"west","move":"west"}]},
  {"id":8,"x":40,"y":60,"z":0,"title":"Cavern of Glass, Eylhaar's Grotto","descriptions":["An almost eerie quiet fills this part of the cavern.  No sounds seem to filter through except for the occasional echo of a footstep nearby.  Carved images in the cavern walls depict scenes of death in a more natural state."],"exits":[{"to":9,"exit":"northeast","move":"northeast"},{"to":7,"exit":"east","move":"east"},{"to":6,"exit":"southwest","move":"southwest"}]},
  {"id":9,"x":60,"y":40,"z":0,"title":"Cavern of Glass, Eylhaar's Grotto","descriptions":["An almost eerie quiet fills this part of the cavern.  No sounds seem to filter through except for the occasional echo of a footstep nearby.  Carved images in the cavern walls depict scenes of death in a more natural state."],"exits":[{"to":8,"exit":"southwest","move":"southwest"},{"to":10,"exit":"northwest","move":"northwest"}]},
  {"id":10,"x":40,"y":20,"z":0,"title":"Cavern of Glass, Eylhaar's Grotto","descriptions":["An almost eerie quiet fills this part of the cavern.  No sounds seem to filter through except for the occasional echo of a footstep nearby.  Carved images in the cavern walls depict scenes of death in a more natural state."],"exits":[{"to":9,"exit":"southeast","move":"southeast"},{"to":11,"exit":"west","move":"west"}]},
  {"id":11,"x":20,"y":20,"z":0,"title":"Cavern of Glass, Shrine to Eylhaar","descriptions":["The obvious end of the tunnel is a shrine to the goddess Eylhaar.  A featureless statue, somewhat feminine in nature but with a hint of masculinity, stands next to a gnarled doorway.  The feeling of death hangs in the air, but is one of a more peaceful, natural death.  The walls themselves are etched with memorials of those who have died and may be buried here."],"exits":[{"to":10,"exit":"east","move":"east"},{"to":23,"exit":"go","move":"go gnarled doorway"}]},
  {"id":12,"x":180,"y":140,"z":0,"title":"Aldauth's Lair, Cavern of Glass","descriptions":["Shadows flicker on every wall possibly coming from the torches reflecting off of the black crystal walls.  Tunnels branch off in many directions and show no signs of ending.  An unfamiliar sound, possibly hissing, is enough to make hair stand on end."],"exits":[{"to":13,"exit":"east","move":"east"},{"to":19,"exit":"southeast","move":"southeast"},{"to":3,"exit":"southwest","move":"southwest"},{"to":14,"exit":"northwest","move":"northwest"}]},
