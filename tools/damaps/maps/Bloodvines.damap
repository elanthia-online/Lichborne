 "id": "132",
 "name": "Bloodvines",
 "file": "Map132_Bloodvines.xml",
 "rooms": [
  {"id":1,"x":0,"y":0,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Stunted and withered stalks of wheat are strangled by thick greenish-brown vines armed with cruel thorns.  Running parallel to the weathered stone wall at the edge of the field, a broad swathe of bare, scorched earth cuts across the untended rows.  The scent of smoke lingers unpleasantly in the night air."],"exits":[{"to":9,"exit":"go","move":""},{"to":2,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":2,"x":-20,"y":0,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Stunted and withered stalks of wheat are strangled by thick greenish-brown vines armed with cruel thorns.  Running parallel to the weathered stone wall at the edge of the field, a broad swathe of bare, scorched earth cuts across the untended rows.  The scent of smoke lingers unpleasantly in the night air."],"exits":[{"to":1,"exit":"go","move":""},{"to":3,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":3,"x":-40,"y":0,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Stunted and withered stalks of wheat are strangled by thick greenish-brown vines armed with cruel thorns.  Running parallel to the weathered stone wall at the edge of the field, a broad swathe of bare, scorched earth cuts across the untended rows.  The scent of smoke lingers unpleasantly in the night air."],"exits":[{"to":4,"exit":"go","move":""},{"to":2,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":4,"x":-40,"y":-20,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Several forlorn stalks of wheat still stand, seemingly huddled against the wall for protection against the voracious vines blanketing the rest of the field.  Occasionally something rustles through the greenery, causing the vines to seem to move with a life of their own."],"exits":[{"to":5,"exit":"go","move":""},{"to":12,"exit":"go","move":""},{"to":3,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":5,"x":-40,"y":-40,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Bled dry of life and color, a sickly silverwillow tree glimpsed over the crumbling wall is pierced by the red thorns of the thick green vines coiled about it.  The weight of the vines is slowly pulling the tree down.  More vines spill from over the wall into the field, and no sign of the original crops remains."],"exits":[{"to":6,"exit":"go","move":""},{"to":4,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":6,"x":-20,"y":-40,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Withered amethyst bloom vines hang limply against the stone wall, nearly engulfed by the rapacious thorny green vines.  Stretching toward the sky, a few hardy weeds stubbornly struggle to survive the engulfing tangle of vines.  Over the wall, the shadowy silhouette of Asketi's Mount blots out a large portion of the night sky."],"exits":[{"to":7,"exit":"go","move":""},{"to":5,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":7,"x":0,"y":-40,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Withered amethyst bloom vines hang limply against the stone wall, nearly engulfed by the rapacious thorny green vines.  Stretching toward the sky, a few hardy weeds stubbornly struggle to survive the engulfing tangle of vines.  Over the wall, the shadowy silhouette of Asketi's Mount blots out a large portion of the night sky."],"exits":[{"to":8,"exit":"go","move":""},{"to":6,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":8,"x":20,"y":-40,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Curving west, the rock wall separates what's left of the field from the road and the edge of the forest.  Beneath a reddish-brown stain on the wall, a steel-bladed scythe lies forgotten and rusting in the grasp of the greenery.  Only patches of packed and scorched earth are bare of the omnipresent vines."],"exits":[{"to":10,"exit":"go","move":""},{"to":7,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":9,"x":20,"y":0,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["A gate constructed from mismatched planks of wood is firmly wedged shut where two stone walls bordering the field converge.  The walls are pocked with deep gouges and blackened with streaks of soot.  Remnants of burnt vegetation crunch underfoot, although hints of green skirt the scorched tract to the north and west."],"exits":[{"to":10,"exit":"go","move":""},{"to":1,"exit":"go","move":""},{"to":0,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":10,"x":20,"y":-20,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Untidy sheaves of wheat, out of reach of the meager protection offered by the stone wall, lean against one another while weeds spring up around their bases.  A narrow strip of packed earth runs between the tangle of thorny vines and the wall.  Thready runners stretch across the bare ground, greedily reaching for the untouched greenery."],"exits":[{"to":8,"exit":"go","move":""},{"to":9,"exit":"go","move":""},{"to":11,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":11,"x":0,"y":-20,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Curling away from the scorched strip of land to the south, the thorny vines form a tangled mat overwhelming the scattered clumps of withered wheat pushing up through the invasive vegetation.  Crops already engulfed slowly rot into mulch, fertilizing the vines and adding their aroma to the ashy scent hanging over the field."],"exits":[{"to":10,"exit":"go","move":""},{"to":12,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":12,"x":-20,"y":-20,"z":0,"title":"Vela'Tohr Outskirts, An Abandoned Field","descriptions":["Curling away from the scorched strip of land to the south, the thorny vines form a tangled mat overwhelming the scattered clumps of withered wheat pushing up through the invasive vegetation.  Crops already engulfed slowly rot into mulch, fertilizing the vines and adding their aroma to the ashy scent hanging over the field."],"exits":[{"to":11,"exit":"go","move":""},{"to":4,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":50,"x":40,"y":0,"z":0,"title":"Pilgrimage Trail, Vela'Tohr Valley","descriptions":["Yellowing grass along the rutted track is slowly losing its battle with mortality.  Clumps of weeds skirt the stone wall enclosing a field with scarcely a break for the gate.  Towards the north, a dark line of trees is visible in the distance."],"exits":[{"to":0,"exit":"go","move":""},{"to":0,"exit":"go","move":""},{"to":9,"exit":"go","move":""}],"color":"#FFFFFF","linksTo":"Map129_Pilgramage_Trail.xml"}
 ],
 "labels": [
  {"text":"New Label","x":150,"y":20,"z":0}
 ]
}
