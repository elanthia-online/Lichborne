 "rooms": [
  {"id":1,"x":40,"y":120,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":3,"exit":"go","move":""},{"to":2,"exit":"go","move":""},{"to":20,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":2,"x":20,"y":100,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":1,"exit":"go","move":""},{"to":21,"exit":"go","move":""}],"color":"#FFFFFF"},
