  {"id":101,"x":680,"y":-310,"z":0,"title":"Pokekehekepi ghedo","descriptions":["Glistening with a silver sheen, the sands stretch out into the darkness beyond the range of vision.","Gleaming golden sand stretches out, seemingly endless under the glaring light of the daytime sun.  Looming up around this little dune valley are the great korgi, casting shadows over the smaller dunes."],"exits":[{"to":100,"exit":"east","move":"east"},{"to":124,"exit":"south","move":"south"},{"to":123,"exit":"west","move":"west"},{"to":108,"exit":"northwest","move":"northwest"}]},
