  {"id":93,"x":780,"y":-190,"z":0,"title":"Pokekehekepi, Beachhead","descriptions":["Glittering like flowing gold, the beach runs into the ocean and disappears under the luminous waves."],"exits":[{"to":91,"exit":"northwest","move":"northwest"},{"to":245,"exit":"go","move":"go halasa selhin"}],"color":"#0000FF","aliases":["Halasa Selhin","Beach"]},
