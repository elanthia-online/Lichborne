  {"id":175,"x":320,"y":-580,"z":0,"title":"Pokekehekepi korgi","descriptions":["Dark shadows hide the peaks and valleys within the sands, making the korgi appear as an almost regal mountain, except for the occasional grumbling shift of its surface.","Great mounds of fine golden sand make up the huge swells of the korgi.  Constantly changing, as if a living organism, the dune lords shift periodically, and their surfaces slide uncontrollably as new hills and valleys appear."],"exits":[{"to":176,"exit":"east","move":"east"}],"color":"#00FF00"},
  {"id":176,"x":340,"y":-580,"z":0,"title":"Pokekehekepi korgi","descriptions":["Dark shadows hide the peaks and valleys within the sands, making the korgi appear as an almost regal mountain, except for the occasional grumbling shift of its surface.","Great mounds of fine golden sand make up the huge swells of the korgi.  Constantly changing, as if a living organism, the dune lords shift periodically, and their surfaces slide uncontrollably as new hills and valleys appear."],"exits":[{"to":179,"exit":"northeast","move":"northeast"},{"to":177,"exit":"southeast","move":"southeast"},{"to":175,"exit":"west","move":"west"},{"to":183,"exit":"northwest","move":"northwest"}]},
