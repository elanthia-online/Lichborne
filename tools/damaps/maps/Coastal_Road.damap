  {"id":242,"x":680,"y":-580,"z":0,"title":"Pokekehekepi korgi","descriptions":["Dark shadows hide the peaks and valleys within the sands, making the korgi appear as an almost regal mountain, except for the occasional grumbling shift of its surface.","Great mounds of fine golden sand make up the huge swells of the korgi.  Constantly changing, as if a living organism, the dune lords shift periodically, and their surfaces slide uncontrollably as new hills and valleys appear."],"exits":[{"to":247,"exit":"north","move":"north"},{"to":246,"exit":"east","move":"east"},{"to":241,"exit":"south","move":"south"}]},
  {"id":243,"x":660,"y":-600,"z":0,"title":"Pokekehekepi korgi","descriptions":["Dark shadows hide the peaks and valleys within the sands, making the korgi appear as an almost regal mountain, except for the occasional grumbling shift of its surface.","Great mounds of fine golden sand make up the huge swells of the korgi.  Constantly changing, as if a living organism, the dune lords shift periodically, and their surfaces slide uncontrollably as new hills and valleys appear."],"exits":[{"to":247,"exit":"east","move":"east"},{"to":233,"exit":"southwest","move":"southwest"}]},
  {"id":244,"x":840,"y":-410,"z":0,"title":"Shell Shrine","descriptions":["Long, curving protrusions jut out from between the shells that make up the walls here, wickedly sharp and waiting for someone careless enough to stumble over the simple altar nestled in the sand floor.  Dark husks of now dead malchata stand a quiet vigil in the recesses opposite the shrine entrance, their bodies somehow preserved from reverting back into sand."],"exits":[{"to":120,"exit":"out","move":"out"}],"color":"#A6A3D9","aliases":["Shell Shrine","Drogor"]},
  {"id":245,"x":780,"y":-150,"z":0,"title":"The Halasa Selhin, Main Deck","descriptions":["After years of varnishing, the main deck of the Halasa Selhin glistens like a becalmed sea.  Holding the crisp yards of her mainsail, the mainmast rises skyward to a dizzying height with the sweeping length of the boom spreading her canvas skirt to the wind.  Brightly colored pennants flutter from the halyards."],"exits":[{"to":93,"exit":"go","move":"go pokekehekepi"}],"linksTo":"Map998_Transports.xml"},
  {"id":246,"x":720,"y":-580,"z":0,"title":"Pokekehekepi korgi","descriptions":["Dark shadows hide the peaks and valleys within the sands, making the korgi appear as an almost regal mountain, except for the occasional grumbling shift of its surface.","Great mounds of fine golden sand make up the huge swells of the korgi.  Constantly changing, as if a living organism, the dune lords shift periodically, and their surfaces slide uncontrollably as new hills and valleys appear."],"exits":[{"to":248,"exit":"north","move":"north"},{"to":242,"exit":"west","move":"west"}]},
  {"id":247,"x":680,"y":-600,"z":0,"title":"Pokekehekepi korgi","descriptions":["Dark shadows hide the peaks and valleys within the sands, making the korgi appear as an almost regal mountain, except for the occasional grumbling shift of its surface.","Great mounds of fine golden sand make up the huge swells of the korgi.  Constantly changing, as if a living organism, the dune lords shift periodically, and their surfaces slide uncontrollably as new hills and valleys appear."],"exits":[{"to":242,"exit":"south","move":"south"},{"to":243,"exit":"west","move":"west"}]},
  {"id":248,"x":720,"y":-600,"z":0,"title":"Pokekehekepi korgi","descriptions":["Dark shadows hide the peaks and valleys within the sands, making the korgi appear as an almost regal mountain, except for the occasional grumbling shift of its surface.","Great mounds of fine golden sand make up the huge swells of the korgi.  Constantly changing, as if a living organism, the dune lords shift periodically, and their surfaces slide uncontrollably as new hills and valleys appear."],"exits":[{"to":246,"exit":"south","move":"south"},{"to":249,"exit":"northwest","move":"northwest"}]},
  {"id":249,"x":700,"y":-620,"z":0,"title":"Pokekehekepi korgi","descriptions":["Dark shadows hide the peaks and valleys within the sands, making the korgi appear as an almost regal mountain, except for the occasional grumbling shift of its surface.","Great mounds of fine golden sand make up the huge swells of the korgi.  Constantly changing, as if a living organism, the dune lords shift periodically, and their surfaces slide uncontrollably as new hills and valleys appear."],"exits":[{"to":248,"exit":"southeast","move":"southeast"},{"to":152,"exit":"west","move":"west","hidden":true}]},
  {"id":250,"x":380,"y":-400,"z":0,"title":"Poho-dapi'botuk","descriptions":["Crevices in the walls reveal a pale green substance abundant within the central coil.  It almost appears fleshy, and it gives off a faint odor of rot."],"exits":[{"to":252,"exit":"northeast","move":"northeast"},{"to":254,"exit":"southeast","move":"southeast"},{"to":251,"exit":"west","move":"west"}],"aliases":["Green Substance 5"]},
  {"id":251,"x":320,"y":-400,"z":0,"title":"Peltaph'staho","descriptions":["The walls to the east gradually become more broken, and a faint stench wafts in from that direction.  Visible just a short distance south are several glossy white objects."],"exits":[{"to":250,"exit":"east","move":"east"},{"to":289,"exit":"south","move":"south"},{"to":300,"exit":"west","move":"west"}]},
  {"id":252,"x":400,"y":-420,"z":0,"title":"Poho-dapi'botuk","descriptions":["Crevices in the walls reveal a pale green substance abundant within the central coil.  It almost appears fleshy, and it gives off a faint odor of rot."],"exits":[{"to":253,"exit":"northeast","move":"northeast"},{"to":250,"exit":"southwest","move":"southwest"}],"aliases":["Green Substance 6"]},
  {"id":253,"x":420,"y":-440,"z":0,"title":"Poho-dapi'botuk","descriptions":["Patches of blue lichen dot the smooth walls of this narrow corridor, their soft glow creating harsh shadows throughout the emptiness of open air and along the ground."],"exits":[{"to":314,"exit":"north","move":"north"},{"to":252,"exit":"southwest","move":"southwest"}]},
  {"id":254,"x":400,"y":-380,"z":0,"title":"Poho-dapi'botuk","descriptions":["Crevices in the walls reveal a pale green substance abundant within the central coil.  It almost appears fleshy, and it gives off a faint odor of rot."],"exits":[{"to":255,"exit":"east","move":"east"},{"to":250,"exit":"northwest","move":"northwest"}],"aliases":["Green Substance 4"]},
  {"id":255,"x":420,"y":-380,"z":0,"title":"Poho-dapi'botuk","descriptions":["Crevices in the walls reveal a pale green substance abundant within the central coil.  It almost appears fleshy, and it gives off a faint odor of rot."],"exits":[{"to":256,"exit":"northeast","move":"northeast"},{"to":254,"exit":"west","move":"west"}],"aliases":["Green Substance 3"]},
  {"id":256,"x":440,"y":-400,"z":0,"title":"Poho-dapi'botuk","descriptions":["Crevices in the walls reveal a pale green substance abundant within the central coil.  It almost appears fleshy, and it gives off a faint odor of rot."],"exits":[{"to":257,"exit":"northeast","move":"northeast"},{"to":255,"exit":"southwest","move":"southwest"},{"to":259,"exit":"northwest","move":"northwest"}],"aliases":["Green Substance"]},
  {"id":257,"x":460,"y":-420,"z":0,"title":"Peltaph'staho","descriptions":["Several round pockets appear at various heights along the sloped and curving walls, each filled with a different type of fungus.  Most appear to be partially or completely dried, as if for storage."],"exits":[{"to":258,"exit":"east","move":"east"},{"to":256,"exit":"southwest","move":"southwest"}],"aliases":["Dried Fungus"]},
  {"id":258,"x":480,"y":-420,"z":0,"title":"Peltaph'staho","descriptions":["The outer ring winds off to the north and south, while another branch turns towards the heart of the caverns."],"exits":[{"to":328,"exit":"north","move":"north"},{"to":262,"exit":"south","move":"south"},{"to":257,"exit":"west","move":"west"}]},
  {"id":259,"x":420,"y":-420,"z":0,"title":"Poho-dapi'botuk","descriptions":["Crevices in the walls reveal a pale green substance abundant within the central coil.  It almost appears fleshy, and it gives off a faint odor of rot."],"exits":[{"to":256,"exit":"southeast","move":"southeast"},{"to":260,"exit":"southwest","move":"southwest"}],"aliases":["Green Substance 2"]},
  {"id":260,"x":400,"y":-400,"z":0,"title":"Poho-dapi'botuk","descriptions":["Spiraling outward from a central point in the floor, various colors and shapes of fungus grow in family clusters.  Whether it is food or put to some other peculiar purpose is difficult to determine, but various species of the strange beetle population wander through the garden."],"exits":[{"to":259,"exit":"northeast","move":"northeast"},{"to":261,"exit":"east","move":"east"}]},
  {"id":261,"x":420,"y":-400,"z":0,"title":"Poho-dapi'botuk","descriptions":["Cold blue light emanates from the strange fungus cultivated within the corridors, almost like the light of Xibar.  Short, wide-bodied worker insects constantly scoot to and fro, cleaning up the sand that spills in from above."],"exits":[{"to":260,"exit":"west","move":"west"}]},
  {"id":262,"x":480,"y":-400,"z":0,"title":"Peltaph'staho","descriptions":["Great bulbs of parti-colored fungus rise up along the corridor walls, some dwarfing their neighbors by an armspan or more, and disappearing into the shadows overhead.  Milling on and between them is a great assortment of shelled creatures, some simple and round, others with elegantly curving horns and long, whip-like antennae.  Watching over them all is one of the armored warklin, safely tucked into a wall recess."],"exits":[{"to":258,"exit":"north","move":"north"},{"to":267,"exit":"south","move":"south"},{"to":263,"exit":"west","move":"west"}]},
  {"id":263,"x":460,"y":-400,"z":0,"title":"Peltaph'staho","descriptions":["Curiously clean, these paths lead through various chambers of this insect nest.  Sand from the dune sea is meticulously returned to the surface by the indefatigable beetle colony."],"exits":[{"to":262,"exit":"east","move":"east"},{"to":264,"exit":"southwest","move":"southwest"}]},
  {"id":264,"x":440,"y":-380,"z":0,"title":"Peltaph'staho","descriptions":["Carved into the floor by an unknown artist is a rough outline of a scarab, complete with serrations and antennae.  What purpose it serves here is a mystery."],"exits":[{"to":263,"exit":"northeast","move":"northeast"},{"to":265,"exit":"south","move":"south"}],"aliases":["Scarab Outline"]},
  {"id":265,"x":440,"y":-360,"z":0,"title":"Peltaph'staho","descriptions":["The pervasive bluish glow found throughout the caverns takes on a greenish cast here.  Visible in the packed earth of the walls and floor is a vein of copper-colored metal, surrounded by abundant fungal growth."],"exits":[{"to":264,"exit":"north","move":"north"},{"to":266,"exit":"east","move":"east"},{"to":268,"exit":"southeast","move":"southeast"}]},
  {"id":266,"x":460,"y":-360,"z":0,"title":"Peltaph'staho","descriptions":["Clouds of water vapor drift a few feet above the cavern floor, partially obscuring the ground, where a few sharply pointed stalagmites reach up through the haze like bony fingers."],"exits":[{"to":267,"exit":"northeast","move":"northeast"},{"to":265,"exit":"west","move":"west"}]},
  {"id":267,"x":480,"y":-380,"z":0,"title":"Peltaph'staho","descriptions":["Periodically one of the large beetles clambers across the floor carrying anything from pieces of fungus, to what look like eggs."],"exits":[{"to":262,"exit":"north","move":"north"},{"to":266,"exit":"southwest","move":"southwest"}]},
  {"id":268,"x":460,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["Several corridors branch out of this junction and wind through the world below the dune sea.  As with any colony, the workers scurry along tirelessly, watched over by larger, able-bodied guardians."],"exits":[{"to":269,"exit":"south","move":"south"},{"to":270,"exit":"southwest","move":"southwest"},{"to":265,"exit":"northwest","move":"northwest"}]},
  {"id":269,"x":460,"y":-320,"z":0,"title":"Peltaph'staho","descriptions":["Strange curvature marks the walls along this passage, both smooth and jagged in various places.  Some of the cuts almost look as though they were made intentionally in striation."],"exits":[{"to":268,"exit":"north","move":"north"},{"to":275,"exit":"southwest","move":"southwest"}]},
  {"id":270,"x":440,"y":-320,"z":0,"title":"Peltaph'staho","descriptions":["The ground here has been tilled and cultivated, creating rows of turf for the all-important fungus to thrive on.  Pieces of carrion, old mushrooms, and clothing have been tucked into the furrows of dirt, creating a bit of a stink."],"exits":[{"to":271,"exit":"north","move":"north"},{"to":268,"exit":"northeast","move":"northeast"},{"to":275,"exit":"south","move":"south"},{"to":274,"exit":"west","move":"west"}]},
  {"id":271,"x":440,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["The ground here has been tilled and cultivated, creating rows of turf for the all-important fungus to thrive on.  Pieces of carrion, old mushrooms, and clothing have been tucked into the furrows of dirt, creating a bit of a stink."],"exits":[{"to":270,"exit":"south","move":"south"},{"to":272,"exit":"west","move":"west"}]},
  {"id":272,"x":420,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["The ground here has been tilled and cultivated, creating rows of turf for the all-important fungus to thrive on.  Pieces of carrion, old mushrooms, and clothing have been tucked into the furrows of dirt, creating a bit of a stink."],"exits":[{"to":271,"exit":"east","move":"east"},{"to":273,"exit":"west","move":"west"}]},
  {"id":273,"x":400,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["The floor here is littered with pebbles and grit from what looks like a partial cave-in.  The walls are craggy and split, and moist with some kind of clear fluid."],"exits":[{"to":272,"exit":"east","move":"east"},{"to":274,"exit":"southeast","move":"southeast"},{"to":276,"exit":"southwest","move":"southwest"}],"color":"#C0C0C0","aliases":["Disease Wall"]},
  {"id":274,"x":420,"y":-320,"z":0,"title":"Peltaph'staho","descriptions":["Growing on a dark patch of soft earth sits a cluster of tightly bunched mushrooms.  Their caps are almost perfect domes, supported by graceful, arm-length stalks.  Even in the colored light of the cavern, the mushrooms appear ghostly white, and seem to breathe with calm rhythm."],"exits":[{"to":270,"exit":"east","move":"east"},{"to":275,"exit":"southeast","move":"southeast"},{"to":273,"exit":"northwest","move":"northwest"}],"aliases":["Mushrooms"]},
  {"id":275,"x":440,"y":-300,"z":0,"title":"Peltaph'staho","descriptions":["Intersecting passages form a small nexus here where colored striations are visible in the walls.  Layers of minerals have solidified in trickle-down streams creating an intricate interlace pattern across the walls and floor."],"exits":[{"to":270,"exit":"north","move":"north"},{"to":269,"exit":"northeast","move":"northeast"},{"to":274,"exit":"northwest","move":"northwest"}],"color":"#FF8000"},
  {"id":276,"x":380,"y":-320,"z":0,"title":"Peltaph'staho","descriptions":["Pale, hair-like strands of mycelium form a delicate web covering the walls along the corridor.  Between the ghostly white fibers and the dark crevices, shiny iridescent shells glisten as their respective owners navigate the tiny maze."],"exits":[{"to":273,"exit":"northeast","move":"northeast"},{"to":277,"exit":"southwest","move":"southwest"}],"aliases":["Web"]},
  {"id":277,"x":360,"y":-300,"z":0,"title":"Peltaph'staho","descriptions":["Great bulbs of parti-colored fungus rise up along the corridor walls, some dwarfing their neighbors by an armspan or more, and disappearing into the shadows overhead.  Milling on and between them is a great assortment of shelled creatures, some simple and round, others with elegantly curving horns and long, whip-like antennae.  Watching over them all is one of the armored warklin, safely tucked into a wall recess."],"exits":[{"to":276,"exit":"northeast","move":"northeast"},{"to":278,"exit":"west","move":"west"}]},
  {"id":278,"x":340,"y":-300,"z":0,"title":"Peltaph'staho","descriptions":["Winding aimlessly, this long corridor stretches into the glowing blue light visible to the north, and into darkness to the east."],"exits":[{"to":279,"exit":"north","move":"north"},{"to":277,"exit":"east","move":"east"}]},
  {"id":279,"x":340,"y":-320,"z":0,"title":"Peltaph'staho","descriptions":["This cavern passage is polluted with deadfall from the surface world.  Constantly working to redistribute mess are a variety of beetles, ranging in size from a handbreadth, to certain varieties of surface cattle.  As always, the ever-watchful eyes of the warklin peer down from the shadowed alcoves high overhead"],"exits":[{"to":282,"exit":"north","move":"north"},{"to":281,"exit":"northeast","move":"northeast"},{"to":278,"exit":"south","move":"south"},{"to":280,"exit":"west","move":"west"}]},
  {"id":280,"x":320,"y":-320,"z":0,"title":"Peltaph'staho","descriptions":["Damp, musty air circulates slowly through the hallway, whistling quietly through the crevices in the walls all around."],"exits":[{"to":284,"exit":"north","move":"north"},{"to":279,"exit":"east","move":"east"},{"to":285,"exit":"northwest","move":"northwest"}]},
  {"id":281,"x":360,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["The cavern floor here gives way to a bed of soft loam and decaying peat, where many colorful strains of subterranean fungus thrive, giving off an unusual blend of colored light and humid warmth.  Squirming on the ground like so many blind maggots are the infant young of the warklin species, mixed together without concern for their given subspecies within the family group."],"exits":[{"to":279,"exit":"southwest","move":"southwest"},{"to":282,"exit":"west","move":"west"}]},
  {"id":282,"x":340,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["The cavern floor here gives way to a bed of soft loam and decaying peat, where many colorful strains of subterranean fungus thrive, giving off an unusual blend of colored light and humid warmth.  Squirming on the ground like so many blind maggots are the infant young of the warklin species, mixed together without concern for their given subspecies within the family group."],"exits":[{"to":283,"exit":"northeast","move":"northeast"},{"to":281,"exit":"east","move":"east"},{"to":279,"exit":"south","move":"south"},{"to":284,"exit":"west","move":"west"}]},
  {"id":283,"x":360,"y":-360,"z":0,"title":"Peltaph'staho","descriptions":["The central part of the floor here has collapsed out long enough ago that the edges have softened with erosion.  Accumulated around the southwestern rim of the pit is a pile of assorted waste material, ranging from unused mushroom caps, to broken shell armor, and even a few select parts of people who've been unfortunate enough to die here."],"exits":[{"to":282,"exit":"southwest","move":"southwest"}]},
  {"id":284,"x":320,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["The cavern floor here gives way to a bed of soft loam and decaying peat, where many colorful strains of subterranean fungus thrive, giving off an unusual blend of colored light and humid warmth.  Squirming on the ground like so many blind maggots are the infant young of the warklin species, mixed together without concern for their given subspecies within the family group."],"exits":[{"to":286,"exit":"north","move":"north"},{"to":282,"exit":"east","move":"east"},{"to":280,"exit":"south","move":"south"}]},
  {"id":285,"x":300,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["Wormholes of varying sizes allow these caverns to ventilate somewhat, as well as allowing the multitudes of small-bodied creatures access to virtually everything."],"exits":[{"to":286,"exit":"northeast","move":"northeast"},{"to":280,"exit":"southeast","move":"southeast"},{"to":287,"exit":"west","move":"west"}]},
  {"id":286,"x":320,"y":-360,"z":0,"title":"Peltaph'staho","descriptions":["The cavern floor here gives way to a bed of soft loam and decaying peat, where many colorful strains of subterranean fungus thrive, giving off an unusual blend of colored light and humid warmth.  Squirming on the ground like so many blind maggots are the infant young of the warklin species, mixed together without concern for their given subspecies within the family group."],"exits":[{"to":289,"exit":"north","move":"north"},{"to":284,"exit":"south","move":"south"},{"to":285,"exit":"southwest","move":"southwest"}]},
  {"id":287,"x":280,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["Curiously clean, these paths lead through various chambers of this insect nest.  Sand from the dune sea is meticulously returned to the surface by the indefatigable beetle colony."],"exits":[{"to":285,"exit":"east","move":"east"},{"to":288,"exit":"southwest","move":"southwest"}]},
  {"id":288,"x":260,"y":-320,"z":0,"title":"Peltaph'staho","descriptions":["Several varieties of beetle mill about along the walls and floor, causing a faint, chaotic clicking noise as their shells rattle against one another."],"exits":[{"to":287,"exit":"northeast","move":"northeast"},{"to":290,"exit":"west","move":"west"}]},
  {"id":289,"x":320,"y":-380,"z":0,"title":"Peltaph'staho","descriptions":["The cavern floor here gives way to a bed of soft loam and decaying peat, where many colorful strains of subterranean fungus thrive, giving off an unusual blend of colored light and humid warmth.  Squirming on the ground like so many blind maggots are the infant young of the warklin species, mixed together without concern for their given subspecies within the family group."],"exits":[{"to":251,"exit":"north","move":"north"},{"to":286,"exit":"south","move":"south"}]},
  {"id":290,"x":240,"y":-320,"z":0,"title":"Peltaph'staho","descriptions":["Long strands of the wispy mycelium drape the cavern walls, dotted with small buttons of newly spawned mushrooms."],"exits":[{"to":294,"exit":"north","move":"north"},{"to":288,"exit":"east","move":"east"},{"to":291,"exit":"southwest","move":"southwest"}]},
  {"id":291,"x":220,"y":-300,"z":0,"title":"Peltahp'staho","descriptions":["Pinched into this corner is a mound of earth shaped into a ramp angled up towards the dark shadows of the ceiling.  Bits of luminous mycelium hang in what appear to be intentionally cultivated curtains, giving off a soft glow."],"exits":[{"to":292,"exit":"north","move":"north"},{"to":290,"exit":"northeast","move":"northeast"},{"to":78,"exit":"go","move":"go ramp","hidden":true}],"color":"#008080"},
  {"id":292,"x":220,"y":-320,"z":0,"title":"Peltaph'staho","descriptions":["The westernmost ring of these caverns spans into the darkness north, and south into a narrow chamber."],"exits":[{"to":293,"exit":"north","move":"north"},{"to":291,"exit":"south","move":"south"}]},
  {"id":293,"x":220,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["Small pockets honeycomb the walls here, each with a carefully placed honey-colored egg nested within.  Water vapor seeps up through the floor, keeping the chamber cool and moist for the young warklin.  Iridescent shelled warklin drones constantly renew the supply of fungus, carrying old decaying bulbs out and returning with fresh ones while a few larvae soak in moisture that's accumulated in shallow pools on the floor as well."],"exits":[{"to":295,"exit":"north","move":"north"},{"to":294,"exit":"east","move":"east"},{"to":292,"exit":"south","move":"south"}]},
  {"id":294,"x":240,"y":-340,"z":0,"title":"Peltaph'staho","descriptions":["Small pockets honeycomb the walls here, each with a carefully placed crimson egg nested within.  Water vapor seeps up through the floor, keeping the chamber cool and moist for the young warklin.  Iridescent shelled warklin drones constantly renew the supply of fungus, carrying old decaying bulbs out and returning with fresh ones while a few larvae soak in moisture that's accumulated in shallow pools on the floor as well."],"exits":[{"to":298,"exit":"northeast","move":"northeast"},{"to":290,"exit":"south","move":"south"},{"to":293,"exit":"west","move":"west"}]},
  {"id":295,"x":220,"y":-360,"z":0,"title":"Peltaph'staho","descriptions":["Small pockets honeycomb the walls here, each with a carefully placed ebony-colored egg nested within.  Water vapor seeps up through the floor, keeping the chamber cool and moist for the young warklin.  Iridescent shelled warklin drones constantly renew the supply of fungus, carrying old decaying bulbs out and returning with fresh ones while a few larvae soak in moisture that's accumulated in shallow pools on the floor as well."],"exits":[{"to":296,"exit":"northeast","move":"northeast"},{"to":293,"exit":"south","move":"south"}]},
  {"id":296,"x":240,"y":-380,"z":0,"title":"Peltaph'staho","descriptions":["Small pockets honeycomb the walls here, each with a carefully placed dun-colored egg nested within.  Water vapor seeps up through the floor, keeping the chamber cool and moist for the young warklin.  Iridescent shelled warklin drones constantly renew the supply of fungus, carrying old decaying bulbs out and returning with fresh ones while a few larvae soak in moisture that's accumulated in shallow pools on the floor as well."],"exits":[{"to":297,"exit":"east","move":"east"},{"to":295,"exit":"southwest","move":"southwest"}]},
  {"id":297,"x":260,"y":-380,"z":0,"title":"Peltaph'staho","descriptions":["Small pockets honeycomb the walls here, each with a carefully placed jade-colored egg nested within.  Water vapor seeps up through the floor, keeping the chamber cool and moist for the young warklin.  Iridescent shelled warklin drones constantly renew the supply of fungus, carrying old decaying bulbs out and returning with fresh ones while a few larvae soak in moisture that's accumulated in shallow pools on the floor as well."],"exits":[{"to":300,"exit":"northeast","move":"northeast"},{"to":298,"exit":"south","move":"south"},{"to":296,"exit":"west","move":"west"}]},
  {"id":298,"x":260,"y":-360,"z":0,"title":"Peltaph'staho","descriptions":["Small pockets honeycomb the walls here, each with a carefully placed speckled egg nested within.  Water vapor seeps up through the floor, keeping the chamber cool and moist for the young warklin.  Iridescent shelled warklin drones constantly renew the supply of fungus, carrying old decaying bulbs out and returning with fresh ones while a few larvae soak in moisture that's accumulated in shallow pools on the floor as well."],"exits":[{"to":297,"exit":"north","move":"north"},{"to":299,"exit":"east","move":"east"},{"to":294,"exit":"southwest","move":"southwest"}]},
  {"id":299,"x":280,"y":-360,"z":0,"title":"Peltaph'staho","descriptions":["The central part of the floor here has collapsed out long enough ago that the edges have softened with erosion.  Accumulated around the western rim of the pit is a pile of assorted waste material, ranging from unused mushroom caps, to broken shell armor, and even a few select parts of people who've been unfortunate enough to die here."],"exits":[{"to":298,"exit":"west","move":"west"}]},
  {"id":300,"x":280,"y":-400,"z":0,"title":"Peltaph'staho","descriptions":["The floor here is littered with pebbles and grit from what looks like a partial cave-in.  The walls are craggy and split, and moist with some kind of clear fluid."],"exits":[{"to":301,"exit":"northeast","move":"northeast"},{"to":251,"exit":"east","move":"east"},{"to":297,"exit":"southwest","move":"southwest"},{"to":302,"exit":"northwest","move":"northwest"}],"color":"#C0C0C0","aliases":["Disease Wall 2"]},
  {"id":301,"x":300,"y":-420,"z":0,"title":"Peltaph'staho","descriptions":["The floor here is littered with pebbles and grit from what looks like a partial cave-in.  The walls are craggy and split, and moist with some kind of clear fluid."],"exits":[{"to":303,"exit":"north","move":"north"},{"to":300,"exit":"southwest","move":"southwest"}],"color":"#C0C0C0","aliases":["Disease Wall 3"]},
  {"id":302,"x":260,"y":-420,"z":0,"title":"Peltaph'staho","descriptions":["Periodically one of the large beetles clambers across the floor carrying anything from pieces of fungus, to what look like eggs."],"exits":[{"to":306,"exit":"north","move":"north"},{"to":300,"exit":"southeast","move":"southeast"}]},
  {"id":303,"x":300,"y":-440,"z":0,"title":"Peltaph'staho","descriptions":["Several columns of earth stretch up to the shadowy depths overhead, their surfaces covered with tiny globes of phosphorescent fungus."],"exits":[{"to":304,"exit":"north","move":"north"},{"to":301,"exit":"south","move":"south"}],"aliases":["Colums 2"]},
  {"id":304,"x":300,"y":-460,"z":0,"title":"Peltaph'staho","descriptions":["Intersecting passages form a small nexus here where colored striations are visible in the walls.  Layers of minerals have solidified on the walls in trickle-down streams creating a brilliant pattern."],"exits":[{"to":309,"exit":"north","move":"north"},{"to":310,"exit":"northeast","move":"northeast"},{"to":303,"exit":"south","move":"south"},{"to":305,"exit":"west","move":"west"}]},
  {"id":305,"x":280,"y":-460,"z":0,"title":"Peltaph'staho","descriptions":["Several columns of earth stretch up to the shadowy depths overhead, their surfaces covered with tiny globes of phosphorescent fungus."],"exits":[{"to":307,"exit":"north","move":"north"},{"to":304,"exit":"east","move":"east"},{"to":306,"exit":"southwest","move":"southwest"}],"aliases":["Columns"]},
  {"id":306,"x":260,"y":-440,"z":0,"title":"Peltaph'staho","descriptions":["Long strands of the wispy mycelium drape the cavern walls, dotted with small buttons of newly spawned mushrooms."],"exits":[{"to":305,"exit":"northeast","move":"northeast"},{"to":302,"exit":"south","move":"south"}]},
  {"id":307,"x":280,"y":-480,"z":0,"title":"Peltaph'staho","descriptions":["The westernmost ring of these caverns spans into the darkness south, and north into a narrow chamber."],"exits":[{"to":308,"exit":"north","move":"north"},{"to":305,"exit":"south","move":"south"}]},
  {"id":308,"x":280,"y":-500,"z":0,"title":"Peltaph'staho","descriptions":["Pinched into this corner is a mound of earth shaped into a ramp angled up towards the dark shadows of the ceiling."],"exits":[{"to":309,"exit":"southeast","move":"southeast"},{"to":307,"exit":"south","move":"south"},{"to":156,"exit":"go","move":"go ramp","hidden":true}],"color":"#800080"},
  {"id":309,"x":300,"y":-480,"z":0,"title":"Peltaph'staho","descriptions":["The pervasive bluish glow found throughout the caverns takes on a greenish cast here.  Visible in the packed earth of the walls and floor is a vein of copper-colored metal, surrounded by abundant fungal growth."],"exits":[{"to":310,"exit":"east","move":"east"},{"to":304,"exit":"south","move":"south"},{"to":308,"exit":"northwest","move":"northwest"}]},
  {"id":310,"x":320,"y":-480,"z":0,"title":"Peltaph'staho","descriptions":["Several varieties of beetle mill about along the walls and floor, causing a faint, chaotic clicking noise as their shells rattle against one another."],"exits":[{"to":311,"exit":"southeast","move":"southeast"},{"to":304,"exit":"southwest","move":"southwest"},{"to":309,"exit":"west","move":"west"}]},
  {"id":311,"x":340,"y":-460,"z":0,"title":"Peltaph'staho","descriptions":["Shadows hang like curtains over the walls of these chilly corridors, shrouding everything in a gloomy mantle.  The calm is occasionally interrupted by the lumbering form of dark-shelled insects."],"exits":[{"to":312,"exit":"northeast","move":"northeast"},{"to":310,"exit":"northwest","move":"northwest"}]},
  {"id":312,"x":360,"y":-480,"z":0,"title":"Peltaph'staho","descriptions":["Pale, hair-like strands of mycelium form a delicate web covering the walls along the corridor.  Between the ghostly white fibers and the dark crevices, shiny iridescent shells glisten as their respective owners navigate the tiny maze."],"exits":[{"to":315,"exit":"northeast","move":"northeast"},{"to":313,"exit":"east","move":"east"},{"to":311,"exit":"southwest","move":"southwest"}],"aliases":["Web 2"]},
  {"id":313,"x":420,"y":-480,"z":0,"title":"Poho-dapi'botuk","descriptions":["The cavern here takes on slightly different feel, as though something was paying particular attention to the goings-on here.  Conspicuous by their absence are the smaller beetles common in the outer tunnels."],"exits":[{"to":314,"exit":"south","move":"south"},{"to":312,"exit":"west","move":"west"}]},
  {"id":314,"x":420,"y":-460,"z":0,"title":"Poho-dapi'botuk","descriptions":["Patches of blue lichen dot the smooth walls of this narrow corridor, their soft glow creating harsh shadows throughout the emptiness of open air and along the ground."],"exits":[{"to":313,"exit":"north","move":"north"},{"to":253,"exit":"south","move":"south"}]},
  {"id":315,"x":380,"y":-500,"z":0,"title":"Peltaph'staho","descriptions":["Curiously clean, these paths lead through various chambers of this insect nest.  Sand from the dune sea is meticulously returned to the surface by the indefatigable beetle colony."],"exits":[{"to":316,"exit":"east","move":"east"},{"to":312,"exit":"southwest","move":"southwest"}]},
  {"id":316,"x":400,"y":-500,"z":0,"title":"Peltaph'staho","descriptions":["Wormholes of varying sizes allow these caverns to ventilate somewhat, as well as allowing the multitudes of small-bodied creatures access to virtually everything."],"exits":[{"to":317,"exit":"east","move":"east"},{"to":315,"exit":"west","move":"west"}]},
  {"id":317,"x":420,"y":-500,"z":0,"title":"Peltaph'staho","descriptions":["Damp, musty air circulates slowly through the hallway, whistling quietly through the crevices in the walls all around."],"exits":[{"to":318,"exit":"east","move":"east"},{"to":316,"exit":"west","move":"west"}]},
  {"id":318,"x":440,"y":-500,"z":0,"title":"Peltaph'staho","descriptions":["Strange curvature marks the walls along this passage, both smooth and jagged in various places.  Some of the cuts almost look as though they were made intentionally in striation."],"exits":[{"to":320,"exit":"east","move":"east"},{"to":319,"exit":"south","move":"south"},{"to":317,"exit":"west","move":"west"}]},
  {"id":319,"x":440,"y":-480,"z":0,"title":"Peltaph'staho","descriptions":["Several columns of earth stretch up to the shadowy depths overhead, their surfaces covered with tiny globes of phosphorescent fungus."],"exits":[{"to":318,"exit":"north","move":"north"},{"to":324,"exit":"east","move":"east"},{"to":326,"exit":"southeast","move":"southeast"}],"aliases":["Columns 3"]},
  {"id":320,"x":460,"y":-500,"z":0,"title":"Peltaph'staho","descriptions":["Winding aimlessly, this long corridor stretches into the glowing blue light visible to the northeast, and into darkness to the west."],"exits":[{"to":321,"exit":"northeast","move":"northeast"},{"to":318,"exit":"west","move":"west"}]},
  {"id":321,"x":480,"y":-520,"z":0,"title":"Peltaph'staho","descriptions":["The phosphorescent glow of fungus lends a chilly air to these winding corridors.  Occasionally a rumble echoes through the walls, sending the smaller insects scurrying to maintain the singular cleanliness of this strange habitat."],"exits":[{"to":322,"exit":"east","move":"east"},{"to":320,"exit":"southwest","move":"southwest"}]},
  {"id":322,"x":500,"y":-520,"z":0,"title":"Peltaph'staho","descriptions":["Pinched into this corner is a mound of earth shaped into a ramp angled up towards the dark shadows of the ceiling."],"exits":[{"to":323,"exit":"southwest","move":"southwest"},{"to":321,"exit":"west","move":"west"},{"to":145,"exit":"go","move":"go ramp","hidden":true}],"color":"#800000"},
  {"id":323,"x":480,"y":-500,"z":0,"title":"Peltaph'staho","descriptions":["Several corridors branch out of this junction and wind through the world below the dune sea.  As with any colony, the workers scurry along tirelessly, watched over by larger, able-bodied guardians."],"exits":[{"to":322,"exit":"northeast","move":"northeast"},{"to":325,"exit":"south","move":"south"},{"to":324,"exit":"southwest","move":"southwest"}]},
  {"id":324,"x":460,"y":-480,"z":0,"title":"Peltaph'staho","descriptions":["Growing on a dark patch of soft earth sits a cluster of tightly bunched mushrooms.  Their caps are almost perfect domes, supported by graceful, arm-length stalks.  Even in the colored light of the cavern, the mushrooms appear ghostly white, and seem to breathe with calm rhythm."],"exits":[{"to":323,"exit":"northeast","move":"northeast"},{"to":319,"exit":"west","move":"west"}]},
  {"id":325,"x":480,"y":-480,"z":0,"title":"Peltaph'staho","descriptions":["The outer ring winds off to the north and south, while another branch turns towards the heart of the caverns."],"exits":[{"to":323,"exit":"north","move":"north"},{"to":327,"exit":"southeast","move":"southeast"},{"to":326,"exit":"southwest","move":"southwest"}]},
  {"id":326,"x":460,"y":-460,"z":0,"title":"Peltaph'staho","descriptions":["Various sharp protrusions angle out awkwardly from the floor, making the path somewhat difficult to follow."],"exits":[{"to":325,"exit":"northeast","move":"northeast"},{"to":319,"exit":"northwest","move":"northwest"}]},
  {"id":327,"x":500,"y":-460,"z":0,"title":"Peltaph'staho","descriptions":["Long strands of the wispy mycelium drape the cavern walls, dotted with small buttons of newly spawned mushrooms."],"exits":[{"to":328,"exit":"southwest","move":"southwest"},{"to":325,"exit":"northwest","move":"northwest"}],"aliases":["Mushrooms"]},
  {"id":328,"x":480,"y":-440,"z":0,"title":"Peltaph'staho","descriptions":["Periodically one of the large beetles clambers across the floor carrying anything from pieces of fungus, to what look like eggs."],"exits":[{"to":327,"exit":"northeast","move":"northeast"},{"to":258,"exit":"south","move":"south"}]},
  {"id":329,"x":600,"y":-20,"z":0,"title":"Reshalia, Boulder","descriptions":["The dark grey boulder is bare of any dirt or vegetation, and the sharp edges on the pits and pockmarks covering it discourage more movement than absolutely necessary."],"exits":[{"to":64,"exit":"climb","move":"climb boulder"}]}
 ],
 "labels": [
  {"text":"Warklin Hatchery","x":230,"y":-310,"z":0},
  {"text":"Retan Dolomars","x":530,"y":-620,"z":0},
  {"text":"S'sugi Malchatas","x":520,"y":-630,"z":0},
