{
 "format": "damap",
 "version": 1,
 "id": "140",
 "name": "Temple of the North Wind: Catacombs",
 "file": "Map140_Catacombs.xml",
 "rooms": [
  {"id":1,"x":320,"y":200,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Ascending into shadows above, a staircase follows the walls of the circular chamber.  A low bier covered with black silk stands centered beneath the well formed by the spiraling stairs.  Fitful light cast by lanterns flanking the arch to the north does little to alleviate the darkness closing all around."],"exits":[{"to":2,"exit":"go","move":""},{"to":5,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":2,"x":320,"y":180,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Pillars of blue-black granite line the white plastered walls, supporting an arching ceiling painted an exquisite shade of cerulean.  Outlined by silvery stars embedded in the ceiling, a dark adder writhes against the blue background, its silver-gilt fangs exposed in mute threat."],"exits":[{"to":3,"exit":"go","move":""},{"to":1,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":3,"x":320,"y":160,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Contrasting sharply with the white plastered walls, blue-black granite pillars support an arching ceiling painted a dark shade of crimson.  Delineated by smoky crystal shards inlaid in the ceiling, a wild-eyed black unicorn is portrayed in mid-curvet, a vivid depiction of coiled violence preparing to unleash a devastating kick."],"exits":[{"to":4,"exit":"go","move":""},{"to":2,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":4,"x":320,"y":140,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Smooth, white plaster covers the wall space between pillars of blue-black granite.  Overhead, the vaulted ceiling is painted to resemble a stormy sky.  A tall statue of Asketi stands guard over a carved granite arch.  Framed by a tangle of disheveled hair, the grim-faced goddess glares malevolently at all who approach.  In her hands is a blued steel scythe, the honed edge glittering in the dim light."],"exits":[{"to":3,"exit":"go","move":""},{"to":7,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":5,"x":320,"y":220,"z":0,"title":"Temple of the North Wind, Secret Staircase","descriptions":["Featureless black granite walls are polished perfectly so that their smooth curves gleam like a dull mirror.  Four silver sconces set equidistant around the circular chamber provide excellent light.  Shallow steps run along the walls, gradually spiraling downward in a great winding arc.  In the center of the chamber a gaping pit descends into the bedrock.  A silken net hangs from a system of ropes and pulleys affixed by the top of the steps."],"exits":[{"to":0,"exit":"go","move":""},{"to":1,"exit":"go","move":""}],"color":"#FFFFFF","linksTo":"Map138_Asketis_Mount.xml"},
  {"id":7,"x":320,"y":120,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Polished walls of black granite shine with a reflective gloss.  Carved adders wrap an arch with stony coils, basking in the icy currents of air swirling through small holes cut in the ceiling.  A moaning dirge whispers through the tunnels, rising to a shriek then fading back to near inaudibility with no discernible rhythm or meaning."],"exits":[{"to":8,"exit":"go","move":""},{"to":9,"exit":"go","move":""},{"to":4,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":8,"x":320,"y":100,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Polished granite walls taper up to a curved triangular point from which a silvery globe is suspended.  Beneath the globe is a narrow marble catafalque, upon which rest skeletal remains wrapped in a tattered winding-sheet.  A chill enfolds the area within its icy grasp, mercifully choking off any stench of decay."],"exits":[{"to":7,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":9,"x":300,"y":120,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Hewn from the mountain itself, polished black granite walls shine with such a high gloss that reflections are seen with almost crystal clarity.  Small shafts cut into the ceiling exhale frigid streams of air.  Faint whispers tease at the edge of hearing, distorted by the echoing length of the passage."],"exits":[{"to":10,"exit":"go","move":""},{"to":7,"exit":"go","move":""},{"to":11,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":10,"x":300,"y":100,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Polished granite walls taper up to a curved triangular point from which a silvery globe is suspended.  Beneath the globe is a narrow marble catafalque, upon which rest skeletal remains wrapped in a tattered winding-sheet.  A chill enfolds the area within its icy grasp, mercifully choking off any stench of decay."],"exits":[{"to":9,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":11,"x":280,"y":120,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["The passage here is chill and damp, smelling faintly of snow.  Close to the ceiling, the glossy black walls are lightly starred with frost.  Icy air blows intermittently through shafts cut into the roof, carrying the occasional snowflake.  The cadences of these drafts hold a vague suggestion of a wild, almost musical piping."],"exits":[{"to":12,"exit":"go","move":""},{"to":9,"exit":"go","move":""},{"to":13,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":12,"x":280,"y":100,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Polished granite walls taper up to a curved triangular point from which a silvery globe is suspended.  Beneath the globe is a narrow marble catafalque, upon which rest skeletal remains wrapped in a tattered winding-sheet.  A chill enfolds the area within its icy grasp, mercifully choking off any stench of decay."],"exits":[{"to":11,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":13,"x":260,"y":120,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["A broad circular staircase leads further down into the catacombs.  Grey stone forms a low barrier around the edge of the pit ringed by the steps.  Frayed hemp fibers are caught in the weathered iron rings embedded in the wall."],"exits":[{"to":11,"exit":"go","move":""},{"to":14,"exit":"go","move":""},{"to":24,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":14,"x":240,"y":120,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Deep recesses in the walls rise from floor to ceiling in this corner of the catacombs.  Bodies wrapped in fine wool are interred within these stone shelves.  Chill winds whistle through the shafts cut in the ceiling, skirling a wild lament for the dead."],"exits":[{"to":13,"exit":"go","move":""},{"to":15,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":15,"x":240,"y":140,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Polished walls of black granite are lined with hollowed-out niches rising tier above tier, like berths in a ship, from floor to ceiling.  Bodies wrapped in fine wool are interred within these horizontal recesses.  Several are inaccessible from the floor, leaving one to wonder how they were chiseled out of the hard rock."],"exits":[{"to":14,"exit":"go","move":""},{"to":16,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":16,"x":240,"y":160,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Hewn from the mountain itself, polished black granite walls shine with such a high gloss that reflections are seen with almost crystal clarity.  Small shafts cut into the ceiling exhale frigid streams of air.  A moaning dirge whispers through the tunnels, rising to a shriek then fading back to near inaudibility with no discernible rhythm or meaning."],"exits":[{"to":15,"exit":"go","move":""},{"to":17,"exit":"go","move":""},{"to":19,"exit":"go","move":""},{"to":18,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":17,"x":260,"y":160,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Polished granite walls taper up to a curved triangular point from which a silvery globe is suspended.  Beneath the globe is a narrow marble catafalque, upon which rest skeletal remains wrapped in a tattered winding-sheet.  A chill enfolds the area within its icy grasp, mercifully choking off any stench of decay."],"exits":[{"to":16,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":18,"x":220,"y":160,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Polished granite walls taper up to a curved triangular point from which a silvery globe is suspended.  Beneath the globe is a narrow marble catafalque, upon which rest skeletal remains wrapped in a tattered winding-sheet.  A chill enfolds the area within its icy grasp, mercifully choking off any stench of decay."],"exits":[{"to":16,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":19,"x":240,"y":180,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Four colossal columns of polished black granite support a vaulted ceiling.  Each is inscribed with prayers for the dead.  Alabaster inlay highlights a representation of the constellation known as the Adder etched on the floor.  The surrounding stone exudes an icy chill much like a brazier gives off heat."],"exits":[{"to":16,"exit":"go","move":""},{"to":20,"exit":"go","move":""},{"to":22,"exit":"go","move":""},{"to":21,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":20,"x":260,"y":180,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Twin sarcophagi rest in the center of the chamber.  A broad recess houses a bas-relief of two male Dwarves dressed in priestly robes.  A strong resemblance between the pair suggests a family relationship.  Veils of scented smoke drift up from a shallow bowl placed on the ledge beneath the carving."],"exits":[{"to":23,"exit":"go","move":""},{"to":19,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":21,"x":220,"y":180,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Polished granite walls taper up to a curved triangular point from which a silvery globe is suspended.  Beneath the globe is a narrow marble catafalque, upon which rest skeletal remains wrapped in a tattered winding-sheet.  A chill enfolds the area within its icy grasp, mercifully choking off any stench of decay."],"exits":[{"to":19,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":22,"x":240,"y":200,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Polished walls of black granite are lined with hollowed-out niches rising tier above tier, like berths in a ship, from floor to ceiling.  Bodies wrapped in fine wool are interred within these horizontal recesses.  Several are inaccessible from the floor, leaving one to wonder how they were chiseled out of the hard rock."],"exits":[{"to":19,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":23,"x":260,"y":200,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Alive with statuary carved from the living earth itself, a great menagerie of animals stands watch over the tomb.  Life-sized sculptures of arzumos and leucros, giant serpents and scorpions seem to move in the flickering shadows, their gaze fixed in stony silence upon a plain sarcophagus covered with a flat marble slab."],"exits":[{"to":20,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":24,"x":260,"y":80,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Solid granite has been hewn away to form this spacious antechamber.  The dark walls are decorated with worn bas-reliefs, all covered with a layer of frost.  An occasional draft of frigid air swirls down the staircase, accompanied by a faint moaning whisper.  Lit candles flicker with shifts in the air current, causing the light pooling on the floor to dance frenetically before settling back into a steady glow."],"exits":[{"to":25,"exit":"go","move":""},{"to":13,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":25,"x":240,"y":100,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Devoid of the familiar sights and sounds of the lands above, these subterranean chambers are ominously quiet.  Sepulchral recesses line the walls, chiseled into the mountain granite.  Each are filled with corpses in varying stages of decay.  Water drips slowly from the ceiling, covering the bodies in a thin veil of ice."],"exits":[{"to":24,"exit":"go","move":""},{"to":26,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":26,"x":220,"y":100,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Dripping water echoes eerily through these subterranean chambers.  Shadowy niches, hollowed out of the mountain granite, line the walls from floor to ceiling.  Bodies in various phases of decomposition fill the shallow alcoves.  A thin layer of frost covers the stone and corpses indiscriminately, glittering in the dim light cast by earthenware lamps placed within small recesses carved from the walls."],"exits":[{"to":27,"exit":"go","move":""},{"to":25,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":27,"x":220,"y":80,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Faint yet steady, the persistent sound of dripping water echoes in the cold stone passages.  Narrow recesses are carved from the walls, filled with the remains of the dead.  Thin veils of ice cover the bodies with a final burial shroud.  The air, chill and stale, seems to grow heavier with each passing moment."],"exits":[{"to":29,"exit":"go","move":""},{"to":26,"exit":"go","move":""},{"to":28,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":28,"x":200,"y":80,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Blue marble tiles, rectangles of ancient stone cut and placed with perfect symmetry, line the walls around and the ceiling above.  Shallow gutters score each side of the chamber while a series of drainage holes are visible overhead.  Placed within a semicircular recess carved in the wall, a pale stone casket gleams with a mantle of frost."],"exits":[{"to":27,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":29,"x":220,"y":60,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Oppressive silence fills these subterranean chambers, broken only by the faint sound of dripping water.  Untold numbers of corpses fill the sepulchral recesses lining the walls.  Cold and barren, the catacombs are devoid of the sense of light and life present above ground even during a winter's night."],"exits":[{"to":31,"exit":"go","move":""},{"to":30,"exit":"go","move":""},{"to":27,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":30,"x":240,"y":60,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Large tiles of golden marble interlock with scarcely visible seams along the walls and floor.  The scale of the stonework lends this alcove a sense of majesty requiring reverence.  Shallow gutters score each side of the chamber floor, while a series of drainage holes are visible in the ceiling overhead.  Placed within a semicircular recess carved in the wall, a pale stone casket gleams with a mantle of frost."],"exits":[{"to":29,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":31,"x":220,"y":40,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Dripping water echoes eerily through these subterranean chambers.  Shadowy niches, hollowed out of the mountain granite, line the walls from floor to ceiling.  Bodies in various phases of decomposition fill the shallow alcoves.  A thin layer of frost covers the stone and corpses indiscriminately, glittering in the dim light cast by earthenware lamps placed within small recesses carved from the walls."],"exits":[{"to":33,"exit":"go","move":""},{"to":32,"exit":"go","move":""},{"to":29,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":32,"x":240,"y":40,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Illumination from the passage beyond bathes the walls with a pearlescent gleam, glinting along the edges of the polished dove-grey marble tiles.  Shallow gutters score each side of the chamber while a series of drainage holes are visible in the ceiling overhead.  Placed within a semicircular recess carved in the wall is a pale stone casket."],"exits":[{"to":31,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":33,"x":220,"y":20,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Winding serpentinely back and forth, frost-covered stairs lure one deeper into the catacombs.  Stale air wafts up from the subterranean passages below, carrying with it a hint of ice and decay.  The darkness of the tunnel is broken by a single lantern, which casts wavering shadows over the bone-filled niches lining the walls."],"exits":[{"to":35,"exit":"go","move":""},{"to":31,"exit":"go","move":""},{"to":34,"exit":"go","move":""},{"to":39,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":34,"x":200,"y":20,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Snowy marble tiles line the walls, gleaming beneath an opalescent veil of ice.  Shallow gutters score each side of the chamber while a series of drainage holes are visible in the ceiling overhead.  Placed within a semicircular recess carved in the wall, a pale stone casket gleams with a mantle of frost."],"exits":[{"to":33,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":35,"x":220,"y":0,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Ornate pillars carved from the mountain itself frame vertical alcoves lining both sides of the passage.  Skeletons are propped up within each, gazing sightlessly upon all who trespass within these halls of the dead.  One alcove is empty but for a dark silhouette traced by frost against the stone, leaving no clue as to where the previous occupant now resides."],"exits":[{"to":37,"exit":"go","move":""},{"to":36,"exit":"go","move":""},{"to":33,"exit":"go","move":""},{"to":38,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":36,"x":240,"y":-20,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Polished black granite flecked with silvery mica encloses this alcove in bleakest midnight and stars.  A subtle draft of frigid air swirls through the chamber.  Covered with a thick layer of frost, a low casket rests upon the floor."],"exits":[{"to":35,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":37,"x":220,"y":-20,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Walls thickly coated with frost soar up to a vaulted ceiling.  Coiled adders of polished copper are laid into the floor, forming a visual barrier before the entry.  Centered in the chamber is a green marble catafalque, upon which rest fleshless remains wrapped in a rotting cerement.  The faint scent of sweet spices and bitter incense lingers in the air, despite the nose-numbing cold."],"exits":[{"to":35,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":38,"x":200,"y":-20,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Dense shadows creep in along every surface, disturbed by the flickering of faint illumination reflecting off the patches of ice covering the walls and floor.  Shallow gutters score each side of the chamber while icicles clog most of the drainage holes in the ceiling overhead.  A translucent curtain of ice seals a large, semi-circular recess."],"exits":[{"to":35,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":39,"x":160,"y":80,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["A narrow winding staircase has been chiseled into the heavy rock.  Twisting around a corner, it spirals up into darkness.  Utilizing all available space for burial, bone-filled niches line the walls of the stairwell.  A thin layer of frost covers the rough granite floor."],"exits":[{"to":40,"exit":"go","move":""},{"to":33,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":40,"x":160,"y":100,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["The warren of close-set corridors snakes deeper into the mountain.  Slender icicles stream from the soot-blackened ceiling, rippling gold in the candlelight.  The floors lit by the flickering glow are smooth stone starred with frost."],"exits":[{"to":39,"exit":"go","move":""},{"to":41,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":41,"x":160,"y":120,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Delicate frost spreads across the walls like an opalescent veil, drifting down to cover the fleshless remains of the dead interred within the niches.  Tall candelabra are spaced along the length of the corridor.  Some thoughtful soul has lit a few of the tapers, although shadows still cling like cobwebs in the corners."],"exits":[{"to":40,"exit":"go","move":""},{"to":42,"exit":"go","move":""},{"to":44,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":42,"x":180,"y":140,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Broken here and there by shallow horizontal alcoves, the catacomb walls are sheathed in curtains of glistening ice.  A jumble of bones fills each niche completely.  Formed by slow seeping moisture, which freezes over time, new sheets of ice will eventually form a final burial shroud for the remains."],"exits":[{"to":43,"exit":"go","move":""},{"to":41,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":43,"x":200,"y":160,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Numerous alcoves filled with remains of souls long deceased line the walls.  Dark shadows behind curtains of ice descending from the ceiling indicate more bones are sealed within frozen stone.  Frozen pools fill the depressions in the uneven floor."],"exits":[{"to":42,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":44,"x":140,"y":140,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Panes of ice sheathe the stone walls from floor to ceiling, sealing most of the niches rising tier above tier.  Jagged edges frame one long recess half-filled with stacks of bones sorted by size.  A grinning skull peeks out from a fan of curved ribs, strangely reminiscent of a coy young woman's flirtations."],"exits":[{"to":41,"exit":"go","move":""},{"to":45,"exit":"go","move":""},{"to":47,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":45,"x":160,"y":160,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Broken here and there by shallow horizontal alcoves, the catacomb walls are sheathed in curtains of glistening ice.  A jumble of bones fills each niche completely.  Formed by slow seeping moisture, which freezes over time, new sheets of ice will eventually form a final burial shroud for the remains."],"exits":[{"to":46,"exit":"go","move":""},{"to":44,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":46,"x":180,"y":180,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Scores of corpses have been haphazardly crammed into the deep recesses lining the walls.  Ice fills most of the niches, spilling out of the openings in glistening waves of dirty white.  The tunnel terminates at a wall, coated lightly with frost and carved with a bas-relief depicting Asketi astride a snorting unicorn."],"exits":[{"to":45,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":47,"x":120,"y":160,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Skeletal fingers of ice reach down from the ceiling, dripping spatters of water onto the intricate mosaic covering the floor.  Wisps of smoke drift from beeswax candles, scenting the air with a hint of honey at odds with the eternal cold of stone and ice enfolding the catacombs.  Rough-hewn steps spiral down into darkness."],"exits":[{"to":44,"exit":"go","move":""},{"to":48,"exit":"go","move":""},{"to":54,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":48,"x":140,"y":180,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Twisting and turning, the claustrophobic burial hallway is filled with grim reminders of its purpose.  Bones spill from niches crammed full of fleshless remains.  Stacks of femurs placed against the wall are mortared with ice.  Silence weighs heavy in the frigid air as if intent on smothering all signs of life that dare intrude in this place of the dead."],"exits":[{"to":49,"exit":"go","move":""},{"to":47,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":49,"x":140,"y":200,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Countless skeletons have been crammed tightly into the narrow niches lining the walls.  More bones lie along the walls, methodically sorted by size and type into geometrical designs that rise halfway to the ceiling.  A row of vacant-eyed skulls sits atop the macabre wainscotting.  Frost coats everything with a dusting of glittering white."],"exits":[{"to":48,"exit":"go","move":""},{"to":50,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":50,"x":160,"y":220,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Like a garland of death, a swag of skulls is draped over a simple arch framed by ribs stacked to form tapering columns.  The deep recesses of the ossuary are filled with yellowing bones.  Flickering light emanates from an oil lamp placed upon a skeletal pyramid, lending a golden sheen to the frost-covered remains.  Chill silence spreads over the crypt like a pall."],"exits":[{"to":49,"exit":"go","move":""},{"to":51,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":51,"x":180,"y":220,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Massive columns of black granite covered with serpentine markings brace the high ceiling overhead.  An arch fringed with icicles pierces the frozen western wall, while more tombs are visible to the north and south."],"exits":[{"to":52,"exit":"go","move":""},{"to":53,"exit":"go","move":""},{"to":50,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":52,"x":180,"y":200,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Granite pillars encircle a low dais upon which rest skeletal remains clad in the rotting remnants of sumptuous robes.  Gigantic statues of wind hounds crouch between the pillars, leaving only one opening at the foot of the dais through which to view the bones unobstructed.  Worn by countless visitors over the ages, a shallow trench stretches across the floor from the arch to the bier."],"exits":[{"to":51,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":53,"x":180,"y":240,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Sheathed in ice, stark black granite walls devoid of any ornamentation press in.  Surrounded by the crisp scent of frost and stale air, the warmth of the sun and the kiss of rain seem naught but a distant dream.  The sarcophagus in the center of the tomb is empty and unsealed, an icy vacancy waiting patiently for a tenant."],"exits":[{"to":51,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":54,"x":80,"y":200,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Faint streaks of golden lamplight play over granite walls obscured by sheer curtains of frost and shadow.  Burial niches contain an overflowing abundance of bones sheathed in ice.  Skulls, femurs, finger-bones and vertebrae litter the floor and make for treacherous footing.  Through some acoustic trick, the curvature of the rough-hewn steps magnifies even the slightest of sounds, generating echoes that reverberate eerily through the stone tunnels."],"exits":[{"to":55,"exit":"go","move":""},{"to":47,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":55,"x":80,"y":220,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Centuries of burial have filled every nook and cranny of the ossuary with the grim relics of the dead.  One wall is decorated with curving rows of vertebrae forming stylized waves broken here and there by yellowing scapulae, grotesquely reminiscent of dorsal fins clearing the ocean's surface."],"exits":[{"to":54,"exit":"go","move":""},{"to":56,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":56,"x":80,"y":240,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Gleaming like faint stars on the dank floor, a translucent layer of frost spreads across the stone and up along the walls.  Rectangular slabs of ivory marble seal the tombs carved out of the mountain granite.  Strung together to form macabre ribbons, ribs and arm bones cover the spaces between the individual graves."],"exits":[{"to":55,"exit":"go","move":""},{"to":57,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":57,"x":100,"y":260,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Lit by small lamps placed within recesses carved from the walls, the narrow corridor stretches between the tombs.  Wavering shadows emphasize the hollow eye sockets of the articulated skeletons affixed to the wall and give a sense of subtle movement when glimpsed peripherally."],"exits":[{"to":60,"exit":"go","move":""},{"to":58,"exit":"go","move":""},{"to":56,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":58,"x":120,"y":280,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Dense frost covers every surface in this section of the catacombs, save for one place on the floor close to a large jumble of bones.  An irregular patch of black granite shows starkly amidst the filmy white glaze.  Sibilant whispers echo through the tunnel, a multitude of muted voices wailing in mournful discord."],"exits":[{"to":61,"exit":"go","move":""},{"to":59,"exit":"go","move":""},{"to":57,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":59,"x":140,"y":300,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Upright sarcophagi line the walls, blanketed with a final burial shroud of frost and soot.  The omnipresent rime of ice bears silent witness to the sheer number of years the caskets have resided here.  Wind whistles through a rusting portcullis, as if playing a quiet dirge for the dead."],"exits":[{"to":62,"exit":"go","move":""},{"to":58,"exit":"go","move":""},{"to":63,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":60,"x":120,"y":240,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Jaw bones and femurs form skeletal arrows radiating out from an alcove hewn from the back wall.  Stacks of bones line the other two walls, capped by rows of skulls angled to gaze eternally upon the sarcophagus resting within the niche."],"exits":[{"to":57,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":61,"x":140,"y":260,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Thousands of bones arrayed in decorative patterns conceal the walls of the tomb.  Framed by curving ribs, an arched alcove serves as the final resting place for a skeletal figure clad in hooded black robes.  At the foot of the skeleton, a trio of skulls stare balefully at the opening leading back to the catacombs."],"exits":[{"to":58,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":62,"x":160,"y":280,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Constructed from ice-fused humanoid bones, an immense adder coils about the perimeter of the room.  Hanging from a chain, a skull serves as a grisly lantern with weak light emanating through its vacant eye sockets.  Beneath the macabre chandelier, a trio of sarcophagi rests upon a low dais.  An inconstant breeze whispers through the alcove, chilling the air even colder here than in the outer room."],"exits":[{"to":59,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":63,"x":120,"y":300,"z":0,"title":"Temple of the North Wind, Catacombs","descriptions":["Wisps of mist rise up to the coffered ceiling of carved granite, riding gusts of frigid air rising from the yawning pit in the center of the floor.  Flickering lamps placed in shallow recesses provide scant illumination, giving life to the shifting shadows as the light reflects off the swirling vapors and ice-slicked walls.  A moaning whisper soars to a cacophonous scream as the cold wind rushes up from the depths, only to fade again to a nearly inaudible murmur."],"exits":[{"to":64,"exit":"go","move":""},{"to":59,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":64,"x":100,"y":300,"z":0,"title":"Adder's Nest, Dark Shaft","descriptions":["Flickering light from the opening above is diffused by swirling vapors, faintly illuminating the great black shaft plunging deep into the earth.  Huge stones have been set into the curving walls as steps, circling down and down into the bowels of the mountain."],"exits":[],"color":"#FFFFFF","linksTo":"Map139_Adders_Nest.xml"}
 ],
 "labels": [
  {"text":"Icy Blue Ghast","x":10,"y":260,"z":0},
  {"text":"Icy Blue Ghast","x":110,"y":30,"z":0},
  {"text":"Icy Blue Ghast","x":240,"y":210,"z":0}
 ]
}
