  {"text":"To Rossmans and","x":-30,"y":-40,"z":0},
  {"text":"Road to Theren","x":-20,"y":-30,"z":0},
  {"text":"Riverhaven","x":50,"y":30,"z":0},
  {"text":"Stamina","x":-52,"y":-81,"z":0},
  {"text":"Black Bears","x":-140,"y":-470,"z":0},
  {"text":"Meadow Rams","x":-140,"y":-460,"z":0},
  {"text":"Ogres","x":-250,"y":-240,"z":0},
  {"text":"Undead Gerbils","x":-250,"y":-370,"z":0},
