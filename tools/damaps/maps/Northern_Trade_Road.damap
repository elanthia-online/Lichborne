  {"id":52,"x":680,"y":250,"z":0,"title":"The Marsh, In The Water","descriptions":["The darkness about you is absolute.  Discerning the objects about requires they be inches from your face.  Feeling your way about you touch fur, then realize it is cold wet moss.  Something bumps into you causing you to jump back ready to defend yourself, then realize you've walked into a tree.  Out of the corner of your eye you think you see something move, then realize it's just your mind playing tricks on you in the absence of vision.","Struggling against the suction of the mud, simply walking becomes a challenge of balance and agility.  Thick growths of reeds tower about you making it difficult to maintain a direction as you slog your way through the knee-deep water.  Ripples in the water announce your presence with each step you take."],"exits":[{"to":46,"exit":"north","move":"north","hidden":true},{"to":18,"exit":"northeast","move":"northeast","hidden":true},{"to":50,"exit":"east","move":"east","hidden":true},{"to":25,"exit":"southeast","move":"southeast","hidden":true},{"to":52,"exit":"south","move":"south","hidden":true},{"to":28,"exit":"southwest","move":"southwest","hidden":true},{"to":51,"exit":"west","move":"west"},{"to":53,"exit":"northwest","move":"northwest","hidden":true}],"aliases":["Shack"]},
  {"id":53,"x":450,"y":260,"z":0,"title":"The Marsh, In The Water","descriptions":["The darkness about you is absolute.  Discerning the objects about requires they be inches from your face.  Feeling your way about you touch fur, then realize it is cold wet moss.  Something bumps into you causing you to jump back ready to defend yourself, then realize you've walked into a tree.  Out of the corner of your eye you think you see something move, then realize it's just your mind playing tricks on you in the absence of vision."],"exits":[{"to":18,"exit":"north","move":"north","hidden":true},{"to":13,"exit":"northeast","move":"northeast","hidden":true},{"to":22,"exit":"east","move":"east","hidden":true},{"to":15,"exit":"southeast","move":"southeast","hidden":true},{"to":54,"exit":"south","move":"south","hidden":true},{"to":32,"exit":"southwest","move":"southwest","hidden":true},{"to":55,"exit":"west","move":"west","hidden":true},{"to":33,"exit":"northwest","move":"northwest","hidden":true}]},
