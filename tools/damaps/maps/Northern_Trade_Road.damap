  {"id":55,"x":510,"y":260,"z":0,"title":"The Marsh, In The Water","descriptions":["The darkness about you is absolute.  Discerning the objects about requires they be inches from your face.  Feeling your way about you touch fur, then realize it is cold wet moss.  Something bumps into you causing you to jump back ready to defend yourself, then realize you've walked into a tree.  Out of the corner of your eye you think you see something move, then realize it's just your mind playing tricks on you in the absence of vision."],"exits":[{"to":33,"exit":"north","move":"north","hidden":true},{"to":24,"exit":"northeast","move":"northeast","hidden":true},{"to":30,"exit":"east","move":"east","hidden":true},{"to":18,"exit":"southeast","move":"southeast","hidden":true},{"to":36,"exit":"south","move":"south","hidden":true},{"to":41,"exit":"southwest","move":"southwest","hidden":true},{"to":56,"exit":"west","move":"west","hidden":true},{"to":63,"exit":"northwest","move":"northwest","hidden":true}]},
