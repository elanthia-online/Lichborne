{
 "format": "damap",
 "version": 1,
 "id": "3a",
 "name": "Temple Hill",
 "file": "Map3a_Temple_Hill.xml",
 "rooms": [
  {"id":1,"x":20,"y":0,"z":0,"title":"Mycthengelde, Flatlands","descriptions":["The path winds through a thick grove of trees running north and south along the walls of The Crossing.  The pleasant smell of flowers mixed with damp earth permeates the air, and birds sing cheerfully from their homes in the foliage.  Directly south, the trees part to reveal a grassy expanse stretching towards a low series of hills."],"exits":[{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"west","move":"west"},{"to":2,"exit":"go","move":"go pill"}],"linksTo":"Map4_Crossing_WestGate.xml"},
  {"id":2,"x":20,"y":40,"z":0,"title":"Temple Hill, Neighborhood Entrance","descriptions":["A pair of stone pillars mark the edge of the neighborhood named Temple Hill.  A freshly graded, crushed-stone street carries traffic south into the heart of the community.  Running along one side of the lane, a low stone wall, cut with a prominent wrought iron gate, borders the grounds of Temple Hill Manor.  Across the street are a row of neat stone cottages."],"exits":[{"to":3,"exit":"south","move":"south"},{"to":1,"exit":"go","move":"go pill"},{"to":21,"exit":"go","move":"go gate"}]},
  {"id":3,"x":20,"y":60,"z":0,"title":"Temple Hill, Temple Hill Lane","descriptions":["The crushed stone of the lane leads between several stone cottages, winding its way deeper into the district.  Young locust trees have been planted along both sides of the road in the hopes that with the passage of time they will shade the way."],"exits":[{"to":2,"exit":"north","move":"north"},{"to":4,"exit":"east","move":"east"},{"to":22,"exit":"south","move":"south"}]},
  {"id":4,"x":40,"y":60,"z":0,"title":"Temple Hill Lane, Salvage Stoneworks","descriptions":["With lights dimmed for the night, somber cottages stand across from a large industrial workshop that dominates the south side of the lane.  Just visible in the weak light behind the large building is a chute leading down from a quarry that lifts strange vertical shadows into the night sky."],"exits":[{"to":5,"exit":"southeast","move":"southeast"},{"to":3,"exit":"west","move":"west"},{"to":19,"exit":"climb","move":"climb chute"}]},
  {"id":5,"x":60,"y":80,"z":0,"title":"Temple Hill, Temple Hill Lane","descriptions":["Dark iron lanterns hung from tall poles glow softly against the darkness of night.  A scattering of pots and vases leave shadows against the somber walls of the homes."],"exits":[{"to":6,"exit":"east","move":"east"},{"to":7,"exit":"south","move":"south"},{"to":4,"exit":"northwest","move":"northwest"}]},
  {"id":6,"x":80,"y":80,"z":0,"title":"Temple Hill, Temple Hill Lane","descriptions":["Lawns and gardens stretch out alongside stone cottages that stand in rows along the lane.  Small trees and plantings decorate the well-tended lawns, but none are of any immense size.  Evidently, the temple rubble provides better building material than soil for planting."],"exits":[{"to":9,"exit":"east","move":"east"},{"to":5,"exit":"west","move":"west"}]},
  {"id":7,"x":60,"y":100,"z":0,"title":"Temple Hill, Memorial Park","descriptions":["Grass surrounds a small reflecting pool in this wooded park at the top of the hill.  Strategically placed low stone benches surround the pool, allowing peaceful contemplation of life.  Roses twine along a fence that separates the park from the quarry to the east."],"exits":[{"to":5,"exit":"north","move":"north"},{"to":8,"exit":"east","move":"east"}]},
  {"id":8,"x":80,"y":100,"z":0,"title":"Temple Hill, Memorial Park","descriptions":["Jagged stone makes a staggered path through this restful park.  Tall trees reach out to the sky and give homes to squirrels, rabbits and a variety of birds.  A lone stone bench, flanked on each side by a pot of fragrant flowers, offers a place for quiet reflection."],"exits":[{"to":7,"exit":"west","move":"west"},{"to":16,"exit":"go","move":"go path"}]},
  {"id":9,"x":100,"y":80,"z":0,"title":"Temple Hill, Temple Hill Lane","descriptions":["Brightly lit stone cottages throw light almost everywhere on the darkened street except for one rubble-strewn lot, leaving it in the shadows.  An unusually sturdy fence, immediately noticeable even in the dim light, surrounds the area."],"exits":[{"to":10,"exit":"southeast","move":"southeast"},{"to":6,"exit":"west","move":"west"}]},
  {"id":10,"x":120,"y":100,"z":0,"title":"Temple Hill, Temple Hill Lane","descriptions":["Stolid cottages stand in the darkness of the crushed stone street bending around the hill.  A cluster of lighted windows are visible downhill, backed by the shadowy mass of the city wall and the lights of the Crossing twinkling in the inky darkness beyond."],"exits":[{"to":11,"exit":"east","move":"east"},{"to":12,"exit":"south","move":"south"},{"to":9,"exit":"northwest","move":"northwest"}]},
  {"id":11,"x":140,"y":100,"z":0,"title":"Temple Hill, Battle Bell Court","descriptions":["Snuggled between trees, hills, and the city wall, the tranquil court rests quietly in the night.  Graceful cottages cluster around a huge iron bell hung from a decorative stone tower.  Candles carefully placed within the tower lend a soft warm glow to the bell within."],"exits":[{"to":10,"exit":"west","move":"west"}]},
  {"id":12,"x":120,"y":120,"z":0,"title":"Temple Hill, Temple Hill Lane","descriptions":["Carefully arranged cottages surround a stone pedestal topped by a glass case.  The many lights of the Crossing glisten to the east, while a thoughtfully placed lantern highlights a bronze plaque and the contents of the glass case."],"exits":[{"to":10,"exit":"north","move":"north"},{"to":13,"exit":"south","move":"south"}]},
  {"id":13,"x":120,"y":140,"z":0,"title":"Temple Hill, Temple Hill Lane","descriptions":["Scents of cedar and pine drift upon the air, perhaps from the fires of the nearby homes.  Soft rustlings of night creatures mingle with faint owl hoots and form a serene melody.  To the east, the twinkling lights of Crossing contrast with the closer black bulk of the city wall."],"exits":[{"to":12,"exit":"north","move":"north"},{"to":15,"exit":"west","move":"west"},{"to":14,"exit":"go","move":"go path"}]},
  {"id":14,"x":120,"y":160,"z":0,"title":"Temple Hill, Captain's Court","descriptions":["A small pond in the middle of this quiet, restful court sports tiny boats upon its surface.  Outdoor lanterns from the surrounding cottages give a nice, soft glow to the surrounding shrubs and flowers.  Taller trees loom to the south as an occasional sleepy birdcall sounds in the darkness."],"exits":[{"to":13,"exit":"go","move":"go path"}]},
  {"id":15,"x":100,"y":140,"z":0,"title":"Temple Hill, Hero's March","descriptions":["The low, yellowish vegetation of the lane gives way to deeper greens and larger shrubs, partially masking the gentle slope to the south.  One young lunat tree seems to be thriving, although it still stands only about as tall as a Gor'Tog."],"exits":[{"to":13,"exit":"east","move":"east"},{"to":16,"exit":"northwest","move":"northwest"}]},
  {"id":16,"x":80,"y":120,"z":0,"title":"Temple Hill, Hero's March","descriptions":["The stately manors constructed high on Temple Hill enjoy a broad view of the Mycthengelde Flatlands and the roofs of the Crossing.  The dense city lights of the Crossing create a dull glow overhead that contrasts notably with the scattered cottage lights along Finch Cottage Path down beyond a narrow stone path."],"exits":[{"to":15,"exit":"southeast","move":"southeast"},{"to":17,"exit":"southwest","move":"southwest"},{"to":8,"exit":"go","move":"go path"}]},
  {"id":17,"x":60,"y":140,"z":0,"title":"Temple Hill, Hero's March","descriptions":["Cheery glows emanate from the windows of stone cabins lining Hero's March, echoed by a small glimmer of lights from the Crossing to the east.  A scattering of cabin lights twinkle to the south through the thick undergrowth."],"exits":[{"to":16,"exit":"northeast","move":"northeast"},{"to":18,"exit":"west","move":"west"}]},
  {"id":18,"x":40,"y":140,"z":0,"title":"Temple Hill, Hero's March","descriptions":["A heavy cast iron sundial is centered in the middle of the crushed stone path, a low dark shape in the dimness.  Occasional gleams of light like bright gold shine from cottage windows or doors.  Nearly invisible in the shadows between two cottages, a grassy path winds uphill."],"exits":[{"to":17,"exit":"east","move":"east"},{"to":26,"exit":"south","move":"south"},{"to":25,"exit":"west","move":"west"},{"to":7,"exit":"go","move":"go path"}]},
  {"id":19,"x":40,"y":80,"z":0,"title":"Temple Hill, Salvage Quarry","descriptions":["Piles of stone and pieces of machinery stand silently in the darkness.  Along the west edge of the quarry the dust of the day's work has settled upon the machines in a thick layer opposite piles of sorted material.  A cliff stands to the south, forming a tall backdrop to the scene."],"exits":[{"to":20,"exit":"climb","move":"climb cliff"},{"to":4,"exit":"climb","move":"climb chute"}]},
  {"id":20,"x":40,"y":100,"z":0,"title":"Temple Hill, Salvage Quarry","descriptions":["Tall stone faces loom above three sides of the quarry, standing stark in the night.  Occasionally small stones slide down from the treacherous rock walls, echoing loudly as they reach the bottom and bounce over a low cliff."],"exits":[{"to":7,"exit":"climb","move":"climb face"},{"to":19,"exit":"climb","move":"climb cliff"}]},
  {"id":21,"x":0,"y":40,"z":0,"title":"Temple Hill Manor, Grounds","descriptions":["Framed by a low stone wall pierced with a wrought iron gate, a grand lawn stretches out along three sides of Temple Hill Manor to gracefully encompass the elegant abode.  Low plantings form dark hummocks on the lawn, and young trees throw thin dark shadows across the front of the manor.  Two bronze statues set on stone pedestals hold places of honor on the great lawn."],"exits":[{"to":2,"exit":"go","move":"go gate"}]},
  {"id":22,"x":20,"y":80,"z":0,"title":"Temple Hill, Hero's March","descriptions":["The taller vegetation of the Mycthengelde Flatlands grows close against the hill below this stretch of Hero's March.  Darkness and shadows create an illusion that the Mycthengelde treetops are but an extension of Temple Hill.  Stone cottages cluster along the dark gravel of the street, their windows throwing a welcome light on the comforting scene."],"exits":[{"to":3,"exit":"north","move":"north"},{"to":23,"exit":"southwest","move":"southwest"}]},
  {"id":23,"x":-20,"y":100,"z":0,"title":"Temple Hill, Hero's March","descriptions":["Low plantings form lines and odd geometric figures on the lawns that surround the gaily lit stone cottages.  A few raised beds sport taller varieties of vegetation that draw thick shadows around them in the embrace of the night."],"exits":[{"to":22,"exit":"northeast","move":"northeast"},{"to":24,"exit":"southeast","move":"southeast"}]},
  {"id":24,"x":0,"y":120,"z":0,"title":"Temple Hill, Hero's March","descriptions":["A broad view of the Mycthengelde Flatlands looms emptily to the west, fading into the dark night.  Pristine cottages face a tall marble fountain whose surface is lit by carefully placed lamps.  Thick shrubs and pale flowers rustle in the breeze and send fragrant scents into the air."],"exits":[{"to":25,"exit":"southeast","move":"southeast"},{"to":23,"exit":"northwest","move":"northwest"}]},
  {"id":25,"x":20,"y":140,"z":0,"title":"Temple Hill, Hero's March","descriptions":["Colorful cottages line the crushed rock street and enjoy a panoramic view of the Mycthengelde Flatlands.  Young trees, freshly planted, lift up their scrawny limbs to the sky.  One such tree enjoys a ragtag doll hanging haphazardly from its highest point."],"exits":[{"to":18,"exit":"east","move":"east"},{"to":24,"exit":"northwest","move":"northwest"}]},
  {"id":26,"x":40,"y":160,"z":0,"title":"Temple Hill, Finch Cottage Path","descriptions":["Finch Cottage Path represents a drastic change from Temple Hill proper.  The soil is old and deep here, and vegetation flourishes.  Care was taken when building the cottages to leave as many of the original plants as possible.  The occasional ruffle of feathers reveals the presence of a flock of birds roosting for the night in the thick shrubbery of the area."],"exits":[{"to":18,"exit":"north","move":"north"},{"to":27,"exit":"southeast","move":"southeast"}]},
  {"id":27,"x":60,"y":180,"z":0,"title":"Temple Hill, Finch Cottage Path","descriptions":["Soft breezes carry over a wide tan circle of crushed stone and slip into the surrounding wyndwood trees, producing a soothing music of rustling leaves as they pass.  Snug cottages tuck themselves beneath the tangled tree limbs that lean in over the circle.  A platform birdfeeder on a tall pole in the middle of the circle stands lonesome in the night, waiting for birds to arrive with the dawn."],"exits":[{"to":28,"exit":"east","move":"east"},{"to":29,"exit":"southwest","move":"southwest"},{"to":26,"exit":"northwest","move":"northwest"}]},
  {"id":28,"x":80,"y":180,"z":0,"title":"Temple Hill, Pine Finch Circle","descriptions":["The path ends in a dim grove of trees with scattered lights originating from a small circle of cottages centered about a tall cedar platform birdfeeder.  The cottages are nestled beneath the canopies of tall old trees and almost disappear into shadows of the trees behind luxuriant stands of low plants.  Soft, irregular sounds disclose the presence of birds hidden for the night in the thick undergrowth."],"exits":[{"to":27,"exit":"west","move":"west"}]},
  {"id":29,"x":40,"y":200,"z":0,"title":"Temple Hill, Finch Cottage Path","descriptions":["Lunat trees loom tall and shadowy over the path meandering between the warmly lit cottages snugly situated in thick stands of shrubs.  The tree-lined path continues to the south, while a smaller path branches off to the northwest.  The dense shrubbery emits an occasional drowsy chirp that hints at the notable avian population of the area."],"exits":[{"to":27,"exit":"northeast","move":"northeast"},{"to":31,"exit":"south","move":"south"},{"to":30,"exit":"northwest","move":"northwest"}]},
  {"id":30,"x":20,"y":180,"z":0,"title":"Temple Hill, Goldfinch Circle","descriptions":["The path dead-ends into a cozy circle of homes throwing warm light through their windows into a small clearing.  Cottages nearly disappear in thick growths of native plants and the landscaping gathers odd shadows in the dim light.  A cedar platform birdfeeder stands on a tall pole in the middle of the clearing, bereft of winged visitors by night."],"exits":[{"to":29,"exit":"southeast","move":"southeast"}]},
  {"id":31,"x":40,"y":220,"z":0,"title":"Temple Hill, Finch Cottage Path","descriptions":["The graceful path winds among cheerily lit stone cottages nestled in thickets of vegetation.  One notable oak stands paternally near the path, a tall feeder hanging from its branches just visible in the dim light thrown out by the homes."],"exits":[{"to":29,"exit":"north","move":"north"},{"to":32,"exit":"east","move":"east"},{"to":33,"exit":"southwest","move":"southwest"}]},
  {"id":32,"x":60,"y":220,"z":0,"title":"Temple Hill, House Finch Circle","descriptions":["Tall shrubs and heavy vegetation grow in lush profusion around cozy stone cottages set in a rough circle.  Light from the cabin windows coalesces upon a large birdfeeder on a tall pole -- evidently the local entertainment."],"exits":[{"to":31,"exit":"west","move":"west"}]},
  {"id":33,"x":20,"y":240,"z":0,"title":"Temple Hill, Finch Cottage Path","descriptions":["Lunat trees cast long shadows over the path that narrows as it continues toward the southwest, slipping between cozy cottages pleasantly located in stands of tended vegetation.  A faint sound from the surrounding undergrowth provides evidence of the noteworthy number of birds found in the neighborhood."],"exits":[{"to":31,"exit":"northeast","move":"northeast"},{"to":34,"exit":"southwest","move":"southwest"}]},
  {"id":34,"x":0,"y":260,"z":0,"title":"Temple Hill, Finch Cottage Grounds","descriptions":["Tall shrubbery dominates the landscaping around Finch Cottage, appearing denser in the dark.  Occasionally, rustling sounds and the rare sleepy birdcalls can be heard coming from the bushes.  A long feeder hangs in front of one window, waiting for birds to arrive with the dawn."],"exits":[{"to":33,"exit":"northeast","move":"northeast"}]}
 ],
 "labels": [
  {"text":"Temple Hill","x":110,"y":170,"z":0}
 ]
}
