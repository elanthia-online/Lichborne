 "name": "Belarritaco Bay",
 "file": "Map107a_Belarritaco_Bay.xml",
 "rooms": [
  {"id":1,"x":400,"y":280,"z":0,"title":"The Galley Sanegazat","descriptions":["The galley, like its twin, carries passengers and cargo, but it can easily become a war galley.  Brackets for catapults and a reinforced prow for mounting a ram show its military use, part of the reason why the rowers are trained and willing volunteers for this hard service."],"exits":[{"to":3,"exit":"go","move":"go m'riss dock"},{"to":4,"exit":"go","move":"go mer'kresh dock"}]},
  {"id":2,"x":200,"y":280,"z":0,"title":"The Galley Cercorim","descriptions":["Passengers and cargo crowd the deck of the sleek, black galley.  Below, visible through the large opening amidships, sit the tanned and muscular rowers, one shift at the oars while the other rests.  The exhorter sits in the stern behind his drum, ready to speed or slacken the rhythm as needed."],"exits":[{"to":3,"exit":"go","move":"go m'riss dock"},{"to":4,"exit":"go","move":"go mer'kresh dock"}]},
  {"id":3,"x":300,"y":400,"z":0,"title":"Belarritaco Bay, The Galley Dock","descriptions":["The wide, stout, wooden dock, protected on both sides by rope bumpers, is laden with passengers and goods waiting transport to Mer'Kresh.  Stevedores stand by the galley gangplank or move sacks, crates and barrels to and from the shore."],"exits":[{"to":0,"exit":"north","move":"north"}],"linksTo":"Map108_M'Riss.xml"},
  {"id":4,"x":300,"y":150,"z":0,"title":"Mer'Kresh, The Galley Dock","descriptions":["The stone dock, a happy union of usefulness and beauty, rises from the water on fluted columns softened by layers of moss.  Its carved stanchions and painted posts define an area both comfortable for waiting passengers and spacious for cargo."],"exits":[{"to":0,"exit":"southwest","move":"southwest"}],"linksTo":"Map107_Mer'Kresh.xml"}
 ],
 "labels": [
