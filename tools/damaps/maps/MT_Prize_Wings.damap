  {"id":32,"x":240,"y":160,"z":0,"title":"Green Suite, Lime Hall","descriptions":["Coats of bright lime-green paint cover the plaster walls of this well-lit room, giving an upbeat feel to the area.  The hanging light fixtures allow for ample illumination of the prizes spread out for consideration.","Lime-colored plastered walls surround the prizes spread out for consideration in this area."],"exits":[{"to":42,"exit":"south","move":"south"},{"to":31,"exit":"west","move":"west"}],"color":"#FF0000","aliases":["lime hall"]},
  {"id":33,"x":160,"y":120,"z":0,"title":"Green Suite, Avocado Chamber","descriptions":["Gaethzen spheres suspended overhead cast a warm light across the rich avocado-hued plaster walls.  The abundance of light spotlights the many prizes available for selection.","Gaethzen spheres overhead cast warm light on the avocado-hued walls and the prizes available for selection."],"exits":[{"to":35,"exit":"northeast","move":"northeast"},{"to":29,"exit":"south","move":"south"},{"to":34,"exit":"northwest","move":"northwest"}],"color":"#FF0000","aliases":["avocado chamber"]},
  {"id":34,"x":140,"y":100,"z":0,"title":"Green Suite, Malachite Niche","descriptions":["Painted white trim accents the rich malachite-hued plastered walls that form this secluded alcove.  Spread out under the overhead lights are all the prizes awaiting consideration.","White trim accents the malachite-hued walls while overhead lights illuminate the prizes awaiting consideration."],"exits":[{"to":33,"exit":"southeast","move":"southeast"}],"color":"#FF0000","aliases":["malachite niche"]},
  {"id":35,"x":180,"y":100,"z":0,"title":"Green Suite, Pickle-Green Cubicle","descriptions":["Except for the pickle-hued walls, the room is bare of adornment.  Simple gaethzen globes hanging from the ceiling provide light.  The lack of ornamentation focuses attention on the prizes on display.","Unadorned except for the pickled-hued walls, the lack of ornamentation highlights the prizes on display."],"exits":[{"to":33,"exit":"southwest","move":"southwest"}],"color":"#FF0000","aliases":["pickle-green cubicle","pickle green cubicle"]},
