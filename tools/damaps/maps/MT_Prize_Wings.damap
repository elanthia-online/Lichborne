 "rooms": [
  {"id":1,"x":60,"y":160,"z":0,"title":"Foyer","descriptions":["Subdued lighting illuminates the tasteful wooden paneling of the room while a bevy of overstuffed furniture provides comfortable seating for those contemplating weighty choices.  Thick plush carpets in a myriad of hues cover the floor, almost totally obscuring the pale wooden planks of the flooring.  Around the walls, a number of colored archways contain magical portals that, when open, allow access to the prize rooms beyond.  A large set of double doors allows access to rooms devoted to dispenser activities while a round opening leads to the area devoted to workshops for alterations.","Lighting illuminates the room which has carpets covering the floors.  A number of colored archways contain magic portals that, when open, allow access to the prize rooms beyond.  A set of double doors allows access to the dispensers while a round opening leads to the alteration area."],"exits":[{"to":2,"exit":"go","move":"go double doors"},{"to":3,"exit":"go","move":"go round opening"},{"to":10,"exit":"go","move":"go yellow portal"},{"to":28,"exit":"go","move":"go green portal"},{"to":7,"exit":"go","move":"go blue-tiled entrance"},{"to":999,"exit":"go","move":"go return portal"},{"to":49,"exit":"go","move":"go purple archway"},{"to":1000,"exit":"go","move":"go red archway"}],"color":"#FF00FF","aliases":["Foyer"]},
  {"id":2,"x":40,"y":140,"z":0,"title":"Dispenser Hall","descriptions":["Centered in the middle of the floor, a luxurious carpet covers the polished wooden floor underneath a cut-crystal chandelier.  Oak paneling covers the walls while pale ecru plaster coats the spaces between the coffered ceiling.  A few leather armchairs provide seating for those needing time to contemplate their choices.","A thick carpet covers the floor of the oak-paneled room."],"exits":[{"to":1,"exit":"go","move":"go double doors"}],"color":"#00FF00","aliases":["Dispenser Hall","raffles"]},
  {"id":3,"x":60,"y":120,"z":0,"title":"Alteration Suite, Lobby","descriptions":["Elegantly carved and upholstered furniture adds the perfect touch to the sophisticated but understated luxury of this well-appointed waiting area.  A polished diamondwood buffet displaying a range of snacks is set against one wall while the chairs and sofas are grouped together to allow for quiet conversation between waiting patrons.","A diamondwood buffet sets out snacks while chairs and sofas provide seating for the waiting patrons."],"exits":[{"to":1,"exit":"go","move":"go round opening"},{"to":4,"exit":"go","move":"go glittery curtain"},{"to":5,"exit":"go","move":"go ivy-colored curtain"},{"to":6,"exit":"go","move":"go shadowy curtain"}],"color":"#00FF00","aliases":["alteration suite","alterations"]},
  {"id":4,"x":40,"y":120,"z":0,"title":"Alteration suite, Garish Workroom","descriptions":["Pale pastel pink walls provide a light contrast with the dark purple-tinged floor of gloomwood planks.  Against one wall, a purple-painted table provides ample working space for any project.","Pale pink walls contrast with the gloomwood planks of the floor.  A purple-painted table provides working space."],"exits":[{"to":3,"exit":"go","move":"go glittery curtain"}],"aliases":["garish workroom"]},
  {"id":5,"x":40,"y":100,"z":0,"title":"Alteration Suite, Nemorous Workroom","descriptions":["Painted murals depicting a forest scene cover the walls while a deeply plush carpet designed like fallen leaves covers the floor.  A worktable crafted with logs and rough-hewn planks provides a working surface.","Murals of woodland scenes cover the walls while a table provides working space."],"exits":[{"to":3,"exit":"go","move":"go ivy-colored curtain"}],"aliases":["nemorous workroom"]},
  {"id":6,"x":60,"y":100,"z":0,"title":"Alteration Suite, Tenebrous Workroom","descriptions":["Swathes of dark grey fabric cover the walls, mostly hiding the somber black paint and matching trim.  Wrought iron standing candleholders rest near the black table that serves as a working surface for projects.","Swathes of somber fabric cover the walls and a black table serves as a work surface."],"exits":[{"to":3,"exit":"go","move":"go shadowy curtain"}],"aliases":["tenebrous workroom"]},
  {"id":7,"x":-80,"y":160,"z":0,"title":"Blue Suite, Royal-Blue Hall","descriptions":["Plain plastered walls have been painted a deep royal-blue hue and trimmed with narrow white baseboards.  Subtle indirect lighting of the displayed prizes is provided by gaezthen globes dangling from the coffered ceiling.","Royal-blue walls trimmed with white baseboards surround the displayed prizes in the room."],"exits":[{"to":8,"exit":"southeast","move":"southeast"},{"to":1,"exit":"go","move":"go blue-tiled entrance"}],"color":"#FF0000","aliases":["blue suite","royal-blue hall"]},
  {"id":8,"x":-60,"y":180,"z":0,"title":"Blue Suite, Ocean-Blue Hall","descriptions":["Plain plastered walls have been painted a pale ocean-blue hue and trimmed with narrow white baseboards.  Subtle indirect lighting of the displayed prizes is provided by gaezthen globes dangling from the coffered ceiling.","Ocean-blue walls trimmed with white baseboards surround the displayed prizes in the room."],"exits":[{"to":9,"exit":"southeast","move":"southeast"},{"to":7,"exit":"northwest","move":"northwest"},{"to":44,"exit":"west","move":"west"}],"color":"#FF0000","aliases":["ocean-blue hall"]},
  {"id":9,"x":-40,"y":200,"z":0,"title":"Blue Suite, Turquoise Hall","descriptions":["Plain plastered walls have been painted a bright turquoise hue and trimmed with narrow white baseboards.  Subtle indirect lighting of the displayed prizes is provided by gaezthen globes dangling from the coffered ceiling.","Turquoise-hued walls trimmed with white baseboards surround the displayed prizes in the room."],"exits":[{"to":8,"exit":"northwest","move":"northwest"},{"to":45,"exit":"east","move":"east"},{"to":46,"exit":"southeast","move":"southeast"}],"color":"#FF0000","aliases":["turquoise hall"]},
