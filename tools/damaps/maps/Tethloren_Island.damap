{
 "format": "damap",
 "version": 1,
 "id": "99a",
 "name": "Tethloren Island",
 "file": "Map99a_Tethloren_Island.xml",
 "rooms": [
  {"id":1,"x":20,"y":140,"z":0,"title":"Mooring Rock, Tethloren Island in Cha'walkas","descriptions":["Halasa Temple is a short swim due east from the mooring rock.  Waves splash and curl over the dark rocks, and the spray drenches the area with dampness.  The mist swirls thickest near the temple."],"exits":[{"to":2,"exit":"east","move":"east"}]},
  {"id":2,"x":60,"y":140,"z":0,"title":"Cha'walkas, Water","descriptions":["To the east, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":13,"exit":"northeast","move":"swim northeast"},{"to":6,"exit":"east","move":"swim east"},{"to":3,"exit":"southeast","move":"swim southeast"},{"to":1,"exit":"go","move":"go rock"}],"color":"#0000FF"},
  {"id":3,"x":100,"y":180,"z":0,"title":"Cha'walkas, Water","descriptions":["To the northeast, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":6,"exit":"north","move":"swim north"},{"to":5,"exit":"east","move":"swim east"},{"to":4,"exit":"southeast","move":"swim southeast"},{"to":2,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":4,"x":140,"y":220,"z":0,"title":"Cha'walkas, Water","descriptions":["To the north, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":5,"exit":"north","move":"swim north"},{"to":12,"exit":"east","move":"swim east"},{"to":21,"exit":"southeast","move":"swim southeast"},{"to":3,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":5,"x":140,"y":180,"z":0,"title":"Tethloren, Tidepool","descriptions":["A drop in the level of rock underfoot keeps this section of Tethloren's bordering shore underwater in a deep pool.  The waves swell here in a rocking rising and falling motion and lap gently at the base of Halasa Temple just to the north."],"exits":[{"to":12,"exit":"southeast","move":"swim southeast"},{"to":4,"exit":"south","move":"swim south"},{"to":3,"exit":"west","move":"swim west"},{"to":6,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":6,"x":100,"y":140,"z":0,"title":"Tethloren, Tidepool","descriptions":["Black craggy rock juts upwards, the crevices and hollowed basins filled with glittery black sand.  Urchins and tiny gold and black mottled fish dart amongst the bowls and hollows that hold water, even at the lowest tide.  Waves churn rhythmically, the salty spew of foam clinging to the dark, wet rocks."],"exits":[{"to":7,"exit":"northeast","move":"swim northeast"},{"to":5,"exit":"southeast","move":"swim southeast"},{"to":3,"exit":"south","move":"swim south"},{"to":2,"exit":"west","move":"swim west"},{"to":22,"exit":"climb","move":"climb steps"}],"color":"#0000FF"},
  {"id":7,"x":140,"y":100,"z":0,"title":"Tethloren, Tidepool","descriptions":["Black craggy rock juts upwards, the crevices and hollowed basins filled with glittery black sand.  Seaweed clings to the bowls and hollows that hold water, even at the lowest tide.  Waves churn rhythmically, the salty spew of foam clinging to the dark, wet rocks."],"exits":[{"to":8,"exit":"northeast","move":"northeast"},{"to":6,"exit":"southwest","move":"southwest"},{"to":13,"exit":"west","move":"west"}],"color":"#0000FF"},
  {"id":8,"x":180,"y":60,"z":0,"title":"Tethloren, Tidepool","descriptions":["Black craggy rock juts upwards, the crevices and hollowed basins filled with glittery black sand.  A large orange starfish hides in a deep crevice that holds water, even at the lowest tide.  Waves churn rhythmically, the salty spew of foam clinging to the dark, wet rocks."],"exits":[{"to":15,"exit":"north","move":"north"},{"to":16,"exit":"east","move":"east"},{"to":9,"exit":"southeast","move":"southeast"},{"to":7,"exit":"southwest","move":"southwest"},{"to":14,"exit":"west","move":"west"}],"color":"#0000FF"},
  {"id":9,"x":220,"y":100,"z":0,"title":"Tethloren, Tidepool","descriptions":["A large boulder rises to the southeast, breaking the waves that slosh against it.  Bits of smaller cracked and battered rock form the solid surface underfoot, some larger pieces jutting upwards.  The many crevices and hollows hold water, even at the lowest tide.  Waves churn rhythmically over the rocky tidepools, bringing new fish and treasures to populate the sheltered pools."],"exits":[{"to":17,"exit":"east","move":"east"},{"to":10,"exit":"southeast","move":"southeast"},{"to":8,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":10,"x":260,"y":140,"z":0,"title":"Tethloren, Tidepool","descriptions":["A single large boulder a short distance southeast of Tethloren breaks and softens the waves that slosh against it.  Within the sharp surfaces of the basalt that lines the lake floor, salt water fishes and creatures hide in the hollows and crevices of the many tidepools."],"exits":[{"to":17,"exit":"north","move":"north"},{"to":18,"exit":"east","move":"east"},{"to":19,"exit":"south","move":"south"},{"to":11,"exit":"southwest","move":"southwest"},{"to":9,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":11,"x":220,"y":180,"z":0,"title":"Tethloren, Tidepool","descriptions":["Black craggy rock juts upwards, the crevices and hollowed basins filled with glittery black sand.  Bits of broken shell lie wedged in the cracks and mottled fish dart amongst the bowls and hollows that hold water, even at the lowest tide.  Waves churn rhythmically, the salty spew of foam clinging to the dark, wet rocks."],"exits":[{"to":10,"exit":"northeast","move":"northeast"},{"to":19,"exit":"east","move":"east"},{"to":20,"exit":"south","move":"south"},{"to":12,"exit":"southwest","move":"southwest"}],"color":"#0000FF"},
  {"id":12,"x":180,"y":220,"z":0,"title":"Tethloren, Tidepool","descriptions":["Black craggy rock juts upwards to form low barriers to break the waves and hollows to collect pools of water that remain even at low tide.  The clean salty water sparkles against the dark wet basalt flecked with foam.  Rhythmic waves create the whispering shush long associated with Peri'el's song of sleep to still the beast of the World Dragon itself."],"exits":[{"to":11,"exit":"northeast","move":"swim northeast"},{"to":20,"exit":"east","move":"swim east"},{"to":21,"exit":"south","move":"swim south"},{"to":4,"exit":"west","move":"swim west"},{"to":5,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":13,"x":100,"y":100,"z":0,"title":"Cha'walkas, Water","descriptions":["To the east, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":14,"exit":"northeast","move":"swim northeast"},{"to":7,"exit":"east","move":"swim east"},{"to":2,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":14,"x":140,"y":60,"z":0,"title":"Cha'walkas, Water","descriptions":["To the east, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":15,"exit":"northeast","move":"northeast"},{"to":8,"exit":"east","move":"east"},{"to":13,"exit":"southwest","move":"southwest"}],"color":"#0000FF"},
  {"id":15,"x":180,"y":20,"z":0,"title":"Cha'walkas, Water","descriptions":["To the south, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":16,"exit":"southeast","move":"southeast"},{"to":8,"exit":"south","move":"south"},{"to":14,"exit":"southwest","move":"southwest"}],"color":"#0000FF"},
  {"id":16,"x":220,"y":60,"z":0,"title":"Cha'walkas, Water","descriptions":["To the south, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":17,"exit":"southeast","move":"southeast"},{"to":8,"exit":"west","move":"west"},{"to":15,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":17,"x":260,"y":100,"z":0,"title":"Cha'walkas, Water","descriptions":["To the southwest, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":18,"exit":"southeast","move":"southeast"},{"to":10,"exit":"south","move":"south"},{"to":9,"exit":"west","move":"west"},{"to":16,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":18,"x":300,"y":140,"z":0,"title":"Cha'walkas, Water","descriptions":["To the west, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":19,"exit":"southwest","move":"southwest"},{"to":10,"exit":"west","move":"west"},{"to":17,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":19,"x":260,"y":180,"z":0,"title":"Cha'walkas, Water","descriptions":["To the west, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":10,"exit":"north","move":"north"},{"to":18,"exit":"northeast","move":"northeast"},{"to":20,"exit":"southwest","move":"southwest"},{"to":11,"exit":"west","move":"west"}],"color":"#0000FF"},
  {"id":20,"x":220,"y":220,"z":0,"title":"Cha'walkas, Water","descriptions":["To the northwest, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":11,"exit":"north","move":"north"},{"to":19,"exit":"northeast","move":"northeast"},{"to":21,"exit":"southwest","move":"southwest"},{"to":12,"exit":"west","move":"west"}],"color":"#0000FF"},
  {"id":21,"x":180,"y":260,"z":0,"title":"Cha'walkas, Water","descriptions":["To the north, Tethloren island, barely large enough to contain a white-spired temple, rises from the misty water.  The thick cloud hugs the surface of the salty water, making it difficult to distinguish where mist ends and water begins."],"exits":[{"to":12,"exit":"north","move":"north"},{"to":20,"exit":"northeast","move":"northeast"},{"to":4,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":22,"x":160,"y":160,"z":0,"title":"Halasa Temple, West Porch","descriptions":["The dark basalt that forms the bedrock of Tethloren is leveled, smoothed, and polished to form the floor of the temple.  Without walls, the sacred spot is open to the elements and its high arching ceiling provides little shelter from a howling storm.  Everything here is solid and indestructable, however, and the interlocking obsidian and white quartz stones that form the columns supporting the roof show no sign of mortal construct."],"exits":[{"to":25,"exit":"northeast","move":"northeast"},{"to":26,"exit":"east","move":"east"},{"to":23,"exit":"southeast","move":"southeast"},{"to":6,"exit":"down","move":"down"}]},
  {"id":23,"x":180,"y":180,"z":0,"title":"Halasa Temple, South Porch","descriptions":["The black polished floor reflects the image of a large, azurite carving of a dolphin as it emerges upwards from the surface of the stone.  Tendrils and wisps of cloudy mist cling to the columns and swirl through the temple and finally drift southwards out over the waves to blanket the surface of the lake."],"exits":[{"to":26,"exit":"north","move":"north"},{"to":24,"exit":"northeast","move":"northeast"},{"to":22,"exit":"northwest","move":"northwest"},{"to":30,"exit":"climb","move":"climb nautilus stairway"}],"color":"#A6A3D9","aliases":["Shrine4-12","Eluned"]},
  {"id":24,"x":200,"y":160,"z":0,"title":"Halasa Temple, East Porch","descriptions":["The floor of the eastern porch is inlaid with the image of a huge shark, pearly grey shale forming its body and fins.  Real sharks' teeth, thousands of them, some as large as a Halfling's head, line its open mouth.  The toothy section stretches three paces along the floor, the razor sharp triangles angled upwards to catch at unwary feet."],"exits":[{"to":23,"exit":"southwest","move":"southwest"},{"to":26,"exit":"west","move":"west"},{"to":25,"exit":"northwest","move":"northwest"}]},
  {"id":25,"x":180,"y":140,"z":0,"title":"Halasa Temple, North Porch","descriptions":["The floor of the temple's northern wing is inlaid with a magnificent albatross -- shells, pebbles and smooth pieces of glass form the shape, feathers and details of Lemicus in her symbolic form.  As the open sea air gusts through the temple and fingers of mist twine about the columns, one can imagine flying aloft with the great bird among the clouds."],"exits":[{"to":24,"exit":"southeast","move":"southeast"},{"to":26,"exit":"south","move":"south"},{"to":22,"exit":"southwest","move":"southwest"},{"to":32,"exit":"climb","move":"climb nautilus stairway"}],"color":"#A6A3D9","aliases":["Shrine4-13","Lemicus"]},
  {"id":26,"x":180,"y":160,"z":0,"title":"Halasa Temple, Inner Chamber","descriptions":["White quartz columns spring upwards like trees to the incised arches of the ceiling two stories overhead.  Cut into the perfectly smooth dark floor is a large jagged hole that sloshes with water and spouts a trickling stream of white cloudy mist.  The trails of mist drift upwards and out, circling in slow spirals until they find Cha'walkas, and drift on out over the lake."],"exits":[{"to":25,"exit":"north","move":"north"},{"to":24,"exit":"east","move":"east"},{"to":23,"exit":"south","move":"south"},{"to":22,"exit":"west","move":"west"},{"to":27,"exit":"go","move":"go jagged hole"}]},
  {"id":27,"x":80,"y":60,"z":0,"title":"Halasa Temple, Pools","descriptions":["Beneath the floor of the temple is a dim cavernous area where several pools of sea water dot the darkness among the craggy rocks.  A constant mist fills the air along with a sweet memorable scent unique to this place."],"exits":[{"to":28,"exit":"go","move":"go shell-lined pool"},{"to":29,"exit":"go","move":"go black pool"},{"to":26,"exit":"go","move":"go jagged hole"},{"to":41,"exit":"go","move":"go misty pool"}]},
  {"id":28,"x":60,"y":60,"z":0,"title":"Halasa Temple, A Shell-lined Pool","descriptions":["The salty water soothes and calms the spirit as well as the body.  A variety of pale-colored smooth shells decorate the bottom and sides of the pool and reflect the dim light shimmering through the water."],"exits":[{"to":27,"exit":"out","move":"out"}],"color":"#0000FF"},
  {"id":29,"x":80,"y":40,"z":0,"title":"Halasa Temple, A Pool of Black Water","descriptions":["The water appears black, as no light penetrates it, nor are the bottom or sides of the pool visible.  The cold briny water sloshes gently among the rocks, the scent invigorating and refreshing."],"exits":[{"to":27,"exit":"climb","move":"climb rocky ledge"}],"color":"#0000FF"},
  {"id":30,"x":180,"y":200,"z":0,"title":"Halasa Temple","descriptions":["This enclosed chamber is a safe harbor, sturdily protected from the wind and weather, unlike the lower levels of the temple.  A small arching window to the south looks out over Cha'walkas, its shape a miniature replica of the pointed arches of the walls and ceiling.  An altar placed in the center of the room is unadorned but for a low dish of incense that burns with a faint pleasant scent."],"exits":[{"to":31,"exit":"northeast","move":"northeast"},{"to":33,"exit":"northwest","move":"northwest"},{"to":23,"exit":"climb","move":"climb nautilus stairway"}],"color":"#A6A3D9","aliases":["Shrine4-11","Halasa Temple"]},
  {"id":31,"x":220,"y":160,"z":0,"title":"Halasa Temple","descriptions":["This large square chamber contains nothing but four milky-white quartz benches arranged at the cardinal direction points.  A blackened brass lantern hangs from the ceiling high overhead and burns with forty blood-red candles to light the windowless room."],"exits":[{"to":30,"exit":"southwest","move":"southwest"},{"to":32,"exit":"northwest","move":"northwest"},{"to":34,"exit":"climb","move":"climb nautilus stairway"}]},
  {"id":32,"x":180,"y":120,"z":0,"title":"Halasa Temple","descriptions":["This enclosed chamber is a safe harbor, sturdily protected from the wind and weather, unlike the lower levels of the temple.  A small arching window to the north looks out over Cha'walkas, its shape a miniature replica of the pointed arches of the walls and ceiling.  A large silver bowl rests in the center of the room -- otherwise the room is bare."],"exits":[{"to":31,"exit":"southeast","move":"southeast"},{"to":33,"exit":"southwest","move":"southwest"},{"to":25,"exit":"climb","move":"climb nautilus stairway"}]},
  {"id":33,"x":140,"y":160,"z":0,"title":"Halasa Temple","descriptions":["A small circular window reveals the view to the west.  The stone walls and floor are covered with tapestries that soften sound, and comfortable cushions for visitors and worshipers to rest upon, or even sleep upon.  Not all pilgrims choose to make the return journey across Cha'walkas the same day.  The cadence of the lake waves splashing on the rocks below is constant and lulling, a backdrop of sound that soothes and reassures."],"exits":[{"to":32,"exit":"northeast","move":"northeast"},{"to":30,"exit":"southeast","move":"southeast"}]},
  {"id":34,"x":300,"y":100,"z":0,"title":"Halasa Temple","descriptions":["This very small room with a low slanting roof serves as an antechamber.  Without ornament or color, a single candle casts small shadows against the smooth walls and floor."],"exits":[{"to":35,"exit":"west","move":"west"},{"to":31,"exit":"climb","move":"climb nautilus stairway"}]},
  {"id":35,"x":280,"y":100,"z":0,"title":"Halasa Temple, Beneath the Spire","descriptions":["This octagonal room provides a panoramic view of the lake and island from the exact center of Surlaenis.  The floor is a single piece of anloral stone, or at least fitted so seamlessly that its joinings are invisible.  Overhead an octagonal, hollow spire rises many stories above.  A staircase spirals up the interior of the tower, winding to an impossible height."],"exits":[{"to":34,"exit":"east","move":"east"},{"to":36,"exit":"up","move":"up"}]},
  {"id":36,"x":280,"y":80,"z":0,"title":"Halasa Temple, Spire Interior","descriptions":["The stairs cantilevered to the walls of the spire wind up in treacherous, dizzying turns.  The interior surface, inlaid with uncountable pearls, swirls in subtle patterns of color and size.  A blue-white light reflects off the many sea-gems, giving the whole of one's ascent or descent a feeling of moving in a cloudy mist."],"exits":[{"to":37,"exit":"up","move":"up"},{"to":35,"exit":"down","move":"down"}]},
  {"id":37,"x":280,"y":60,"z":0,"title":"Halasa Temple, Spire Interior","descriptions":["This point is halfway up the tower.  Below, the octagonal floor of the temple shimmers with the bluish light associated with anloral.  The pearls that line the surface of the spire thin, and are embedded like raindrops that sift down from above.  The smooth quartz of the spire's construction is visible, allowing the light to softly penetrate the crystalline structure."],"exits":[{"to":38,"exit":"up","move":"up"},{"to":36,"exit":"down","move":"down"}]},
  {"id":38,"x":280,"y":40,"z":0,"title":"Halasa Temple, Spire Interior","descriptions":["The spire narrows as the stairs wind in tighter turns above.  A slit in the walls of the spire looks westward towards the rising hills and Selhin Dava, and on clear days the outlines of the Sentinels rise against the sky."],"exits":[{"to":39,"exit":"up","move":"up"},{"to":37,"exit":"down","move":"down"}]},
  {"id":39,"x":280,"y":20,"z":0,"title":"Halasa Temple, Spire Interior","descriptions":["A platform suspended below the top of the spire supports a silvered ladder that rises to the very peak above.  Despite the sturdy construction, the wooden slats sway with each step.  The watery sounds of the lake drift upwards and echo gently all around -- the slush of wave against rock is clear and close."],"exits":[{"to":40,"exit":"up","move":"up"},{"to":38,"exit":"down","move":"down"}]},
  {"id":40,"x":280,"y":0,"z":0,"title":"Halasa Temple, Spire Interior","descriptions":["The peak of the spire houses a flame that burns with a penetrating light, but is without heat or apparent source.  A basket woven of seaweed holds this heatless fire that radiates as a beacon atop the temple, the light so intense that a direct gaze at it is impossible to maintain.  A silver bell hangs by a silken rope and seems to hum a gentle tone as the light strikes its polished curves."],"exits":[{"to":39,"exit":"down","move":"down"}],"color":"#00FF00","aliases":["Bell"]},
  {"id":41,"x":100,"y":60,"z":0,"title":"Halasa Temple, Misty Pool","descriptions":["The water is shockingly warm, and a softly-scented cloudy mist rises thickly from the surface.  Gentle eddies swirl through the water to relax and sooth the tired and injured bodies that seek contemplation and quiet."],"exits":[{"to":27,"exit":"out","move":"out"}],"color":"#0000FF"}
 ],
 "labels": []
}
