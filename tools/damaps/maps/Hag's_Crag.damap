{
 "format": "damap",
 "version": 1,
 "id": "137",
 "name": "Hag's Crag",
 "file": "Map137_Hags_Crag.xml",
 "rooms": [
  {"id":1,"x":-20,"y":20,"z":0,"title":"Hag's Crag, Vela'Tohr Overlook","descriptions":["Narrow shelves and dark fissures riddle the jagged cliffs looming above, offering temporary relief for those who dare the ascent of the towering mountain.  Although the stone rises sheer here and offers no holds, an icy crevice that has opened in the mountain wall invites any would-be climbers to explore.  Strong winds buffet even the most tenacious traveler, threatening to remove all in its path in order to restore the sterile beauty of frozen stone."],"exits":[{"to":0,"exit":"go","move":""},{"to":0,"exit":"go","move":""},{"to":0,"exit":"go","move":""},{"to":2,"exit":"go","move":""}],"color":"#FFFFFF","linksTo":"Map136_VelaTohr_Overlook.xml"},
  {"id":2,"x":0,"y":0,"z":0,"title":"Hag's Crag, Glacial Precipice","descriptions":["Rocks and boulders slick with hoarfrost have made their home on a small shelf and partially obscure an icy crevice that leads to the overlook below.  Scant, unidentifiable vegetation -- blighted leaves entombed in a frosty glaze -- huddle against the leeward side of some of the larger boulders."],"exits":[{"to":3,"exit":"go","move":""},{"to":1,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":3,"x":20,"y":0,"z":0,"title":"Hag's Crag, Glacial Precipice","descriptions":["Piercing winds have carved out a small sheltered area where remnants from previous travelers are scattered carelessly among the rock shards and sharp pebbles.  Shattered ice axes, rusted pitons, and broken crampons comprise most of the abandoned refuse discarded in disorganized ice-covered heaps."],"exits":[{"to":4,"exit":"go","move":""},{"to":2,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":4,"x":40,"y":-20,"z":0,"title":"Hag's Crag, Glacial Precipice","descriptions":["Overhead is a small icy ledge with frost-covered outcroppings and jagged edges.  Long icicles encrusted with dirt and pebbles grimly hang from its outer rim like the cuspidated upper fangs of a huge openmouthed creature."],"exits":[{"to":3,"exit":"go","move":""},{"to":5,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":5,"x":40,"y":-40,"z":0,"title":"Hag's Crag, Steep Cliff","descriptions":["Above an icy ledge is a slippery slope peppered with jagged notches.  Occasional branches and sticks, protruding from the sides of the steep cliff, offer additional handholds to tempt those who dare climb it."],"exits":[{"to":6,"exit":"go","move":""},{"to":4,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":6,"x":40,"y":-60,"z":0,"title":"Hag's Crag, Cliff Ledge","descriptions":["A small ledge offers minimal protection to the slippery slope beneath it.  Chunks of rock and stone are covered with hoarfrost, their sharp jagged surfaces hiding deceivingly under the white icy blanket."],"exits":[{"to":7,"exit":"go","move":""},{"to":5,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":7,"x":20,"y":-60,"z":0,"title":"Hag's Crag, Cliff Ledge","descriptions":["Nature's hand has carved out a steep escarpment that leads upwards.  Wind-filled tempests and natural elements have eroded and shaped it lovingly -- a harsh testament to the power they wield."],"exits":[{"to":6,"exit":"go","move":""},{"to":8,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":8,"x":20,"y":-80,"z":0,"title":"Hag's Crag, Widow's Respite","descriptions":["Stunted evergreens with oddly shaped limbs guard a steep escarpment like hunchbacked Dwarven sentries protecting a forbidden pathway.  The deformed limbs are covered with withered, bent needles that are frozen solid, snapping easily with the slightest touch."],"exits":[{"to":9,"exit":"go","move":""},{"to":7,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":9,"x":20,"y":-100,"z":0,"title":"Hag's Crag, Widow's Respite","descriptions":["Huge boulders, glazed with thick crusts of white frost, butt up against the cliffside like broken snowmen left by a child's play.  Other small rocks and pebbles litter the ground, runoff from the steep cliffs towering above."],"exits":[{"to":10,"exit":"go","move":""},{"to":8,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":10,"x":40,"y":-120,"z":0,"title":"Hag's Crag, Widow's Respite","descriptions":["The cold bitter winds are turbulent, echoing loudly throughout the area with a ghostly lament.  Occasional gusts are filled with icy particles and tiny sharp stone fragments that tear at clothes and exposed skin."],"exits":[{"to":17,"exit":"go","move":""},{"to":11,"exit":"go","move":""},{"to":9,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":11,"x":60,"y":-100,"z":0,"title":"Hag's Crag, Widow's Respite","descriptions":["Dozens of deep tracks left by unidentifiable animals in the now-frozen ground are filled with ice and rubble, making the terrain rugged and treacherous.  Frost-covered rock slivers and chipped stone shards abundantly litter the area, covering some of the deep depressions."],"exits":[{"to":12,"exit":"go","move":""},{"to":10,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":12,"x":80,"y":-100,"z":0,"title":"Hag's Crag, Widow's Respite","descriptions":["A deep firepit has been hacked into the frozen earth.  It is protected from the howling mountain winds by a circlet of small craggy rocks.  Grouped close to the firepit are huge tree trunks that have been cut in half lengthwise to provide crude, uncomfortable benches."],"exits":[{"to":13,"exit":"go","move":""},{"to":11,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":13,"x":100,"y":-120,"z":0,"title":"Hag's Crag, Widow's Respite","descriptions":["A recent rockslide covered in ice and snow provides a formidable barrier to the northeast.  Splintered rocks and stones, runoff from the towering mountain looming above, cover the ground."],"exits":[{"to":12,"exit":"go","move":""},{"to":14,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":14,"x":100,"y":-140,"z":0,"title":"Hag's Crag, Widow's Claw","descriptions":["Huge boulders and large rocks slick with ice send smaller stones and jagged rubble tumbling down a rockslide to the southwest.  Ferocious winds surge through cracks and crannies, emitting a perpetual howl that echoes eerily off the cliffside."],"exits":[{"to":15,"exit":"go","move":""},{"to":13,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":15,"x":100,"y":-160,"z":0,"title":"Hag's Crag, Shallow Cave","descriptions":["Shrouded in frost and ice, the bones of some creature gleam pale against the dark stone.  There is no sign of what brought death to this desolate place, but the splintered remains indicate that it was no peaceful ending.  Fresh air enters the cave from a vertical crack, carrying with it a crisp chill that fogs the breath.  Incongruous in this natural setting, a carved granite door at the back of the cave leads into the unknown depths of the mountain."],"exits":[{"to":16,"exit":"go","move":""},{"to":14,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":16,"x":80,"y":-160,"z":0,"title":"Adder's Nest, Frozen Tunnels","descriptions":["Imposing walls of stone sheathed in ice leech the very warmth from the air.  Sounds are muffled by the thick blanket of frost covering the floor and echoes die quickly in the close confines of the tunnel.  Sculpted from the mountain, frost-coated pillars glitter in the pale blue light shed by a glowing crystal embedded in the carved granite door."],"exits":[{"to":0,"exit":"go","move":""},{"to":15,"exit":"go","move":""}],"color":"#FFFFFF","linksTo":"Map139_Adders_Nest.xml"},
  {"id":17,"x":40,"y":-140,"z":0,"title":"Hag's Crag, Sheer Ascent","descriptions":["Looming upwards as far as the eye can see is Asketi's Mountain, its icy top hidden by vaporous white clouds.  The mountain walls, made even more difficult with ice and snow, seemingly dare climbers to attempt an ascent."],"exits":[{"to":10,"exit":"go","move":""},{"to":18,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":18,"x":40,"y":-160,"z":0,"title":"Hag's Crag, Cliff Face","descriptions":["Shrieking winds hurtle ice and snow, seeking to hammer all living things into oblivion or freeze them where they stand.  Finding a safe way up the mountainside becomes increasingly difficult, as the granite is slick with ice.  Scarred with deep gouges left by sharp climbing implements, a steep cliff offers a way downwards."],"exits":[{"to":17,"exit":"go","move":""},{"to":19,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":19,"x":40,"y":-180,"z":0,"title":"Hag's Crag, Broad Ledge","descriptions":["A broad ledge offers a brief respite from climbing, with minimal protection from the elements.  The wind howls continuously, hammering against the sleek rock and whistling despondently as it funnels its way down the steep mountainside."],"exits":[{"to":20,"exit":"go","move":""},{"to":18,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":20,"x":60,"y":-180,"z":0,"title":"Hag's Crag, Broad Ledge","descriptions":["Encrusted with ice and snow, a sheer granite cliff towers above.  Heavy with moisture, vaporous clouds encircle the area like ghostly fogbanks upon a churning sea, hindering movement and making travel hazardous."],"exits":[{"to":19,"exit":"go","move":""},{"to":21,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":21,"x":140,"y":-180,"z":0,"title":"Asketi's Mount, Treacherous Cliff","descriptions":["Dense clouds obscure the view below, while an incredibly steep cliff soars out of sight into the icy mists overhead.  At eye level are slippery mountain walls, marred with craggy holes left by pitons and gouges left by ice axes.  Whistling winds rush down from the summit, trailing plumes of frost crystals that threaten to freeze the breath in one's lungs."],"exits":[{"to":22,"exit":"go","move":""},{"to":20,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":22,"x":240,"y":-180,"z":0,"title":"Asketi's Mount, Summit","descriptions":["Plunging downwards in a near-vertical drop, a sheer granite cliff forms the southern face of the mountain's summit.  Thin, wispy clouds writhe about the summit, sometimes taking the form of ground-hugging fog and other times swirling through the wild currents of wind like ghoulish apparitions.","Plunging downwards in a near-vertical drop, a sheer granite cliff forms the southern face of the mountain's summit.  To the north, like a spear thrust into the heart of a large beast, the mountain reaches higher and higher to pierce the very heavens.  Serpentine columns sculpted into the hard rock spiral about a massive structure carved into the solid rock of the mountaintop."],"exits":[{"to":0,"exit":"go","move":""},{"to":0,"exit":"go","move":""},{"to":0,"exit":"go","move":""},{"to":21,"exit":"go","move":""}],"color":"#FFFFFF","linksTo":"Map138_Asketis_Mount.xml"}
 ],
 "labels": [
  {"text":"Keep Climbing UP or DOWN","x":70,"y":-200,"z":0}
 ]
}
