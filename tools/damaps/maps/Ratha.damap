  {"id":751,"x":518,"y":161,"z":0,"title":"Ehhrsk Highway","descriptions":["Green lichen growing on the walls glows with an eerie light, providing a small amount of illumination.  The darkness makes one part of the tunnels look the same as the rest.  A faint reek of sewage fills the air, but the area is clean of everything but a few cobwebs."],"exits":[{"to":750,"exit":"northeast","move":"northeast"},{"to":747,"exit":"southwest","move":"southwest"},{"to":755,"exit":"northwest","move":"northwest"}]},
