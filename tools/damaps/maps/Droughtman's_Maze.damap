{
 "format": "damap",
 "version": 1,
 "id": "505",
 "name": "Droughtman's Maze",
 "file": "Droughtman's_Maze.xml",
 "rooms": [
  {"id":1,"x":340,"y":220,"z":0,"title":"Droughtman's Maze, Grand Hall","descriptions":["Suspended between jewel-toned pennants overhead, ornate oil lanterns softly illuminate the grand entry hall of Droughtman's Maze.  Eager contestants crowd the mahogany registration desk at the center of the chamber, while a gold-carpeted staircase dominates the northern wall, providing access to the observation deck."],"exits":[{"to":4,"exit":"go","move":"go narrow hallway"},{"to":7,"exit":"climb","move":"climb gold-carpeted staircase"},{"to":2,"exit":"go","move":"go colorful portal"}],"aliases":["Grand Hall","Spieler"]},
  {"id":2,"x":360,"y":220,"z":0,"title":"Foyer","descriptions":["Subdued lighting illuminates the tasteful wooden paneling of the room while a bevy of overstuffed furniture provides comfortable seating for those contemplating weighty choices.  Thick plush carpets in a myriad of hues cover the floor, almost totally obscuring the pale wooden planks of the flooring.  Around the walls, a number of colored archways contain magical portals that, when open, allow access to the prize rooms beyond.  A large set of double doors allows access to rooms devoted to dispenser activities while a round opening leads to the area devoted to workshops for alterations.","Lighting illuminates the room which has carpets covering the floors.  A number of colored archways contain magic portals that, when open, allow access to the prize rooms beyond.  A set of double doors allows access to the dispensers while a round opening leads to the alteration area."],"exits":[],"aliases":["loot","endloot","end loot"],"linksTo":"MT_Prize_Wings.xml"},
  {"id":4,"x":360,"y":240,"z":0,"title":"Droughtman's Maze, Recovery Room","descriptions":["The noise from the cheering spectators, although muffled, can still be heard echoing off the walls of this comfortably cooled room."],"exits":[{"to":1,"exit":"out","move":""}],"color":"#00FF00"},
  {"id":5,"x":340,"y":120,"z":0,"title":"Droughtman's Maze, Contestant's Box","descriptions":["This appears to be a preparation room for the maze contestants.  Aside from the signage posted along its western wall, the room is completely bare and devoid of any furniture or decoration."],"exits":[{"to":0,"exit":"go","move":"go door"}],"color":"#00FF00"},
  {"id":6,"x":320,"y":220,"z":0,"title":"Droughtman's Maze, Winner's Circle","descriptions":["The air in this room carries a hint of peach and vanilla.  A celebratory tune, a lively march, can be heard faintly from an unknown source, almost as if a complete orchestra were nearby, saluting not only the winner but all the contestants as well."],"exits":[{"to":1,"exit":"go","move":"go silver oval;go silver oval"}],"color":"#00FF00"},
  {"id":7,"x":340,"y":180,"z":0,"title":"Droughtman's Maze, The Opal Lounge","descriptions":["The lighting here is dim, but not enough to obscure the opalescent wallpaper.  Couches and upholstered chairs in every shade of the rainbow are scattered around the room in groups, surrounding tables set with food.  A bar occupies one wall, which is hung with a mirror that only magnifies the maelstrom of color in the room.  One has to wonder, is the decor an attempt at opulence, or is it intended to induce patrons to drink more, just to blunt their senses?"],"exits":[{"to":8,"exit":"east","move":"east"},{"to":13,"exit":"west","move":"west"},{"to":1,"exit":"climb","move":"climb gold-carpeted staircase"}]},
  {"id":8,"x":380,"y":180,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":9,"exit":"east","move":"east"},{"to":7,"exit":"west","move":"west"},{"to":18,"exit":"go","move":"go doorway"}]},
  {"id":9,"x":440,"y":180,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":10,"exit":"east","move":"east"},{"to":8,"exit":"west","move":"west"},{"to":19,"exit":"go","move":"go doorway"}]},
  {"id":10,"x":500,"y":180,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":11,"exit":"northeast","move":"northeast"},{"to":9,"exit":"west","move":"west"},{"to":20,"exit":"go","move":"go doorway"}]},
  {"id":11,"x":540,"y":140,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":12,"exit":"northeast","move":"northeast"},{"to":10,"exit":"southwest","move":"southwest"},{"to":21,"exit":"go","move":"go doorway"}]},
  {"id":12,"x":580,"y":100,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":11,"exit":"southwest","move":"southwest"},{"to":22,"exit":"go","move":"go doorway"}]},
  {"id":13,"x":300,"y":180,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":7,"exit":"east","move":"east"},{"to":14,"exit":"west","move":"west"},{"to":23,"exit":"go","move":"go doorway"}]},
  {"id":14,"x":240,"y":180,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":13,"exit":"east","move":"east"},{"to":15,"exit":"west","move":"west"},{"to":24,"exit":"go","move":"go doorway"}]},
  {"id":15,"x":180,"y":180,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":14,"exit":"east","move":"east"},{"to":16,"exit":"northwest","move":"northwest"},{"to":25,"exit":"go","move":"go doorway"}]},
  {"id":16,"x":140,"y":140,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":15,"exit":"southeast","move":"southeast"},{"to":17,"exit":"northwest","move":"northwest"},{"to":26,"exit":"go","move":"go doorway"}]},
  {"id":17,"x":100,"y":100,"z":0,"title":"Droughtman's Maze, Observation Deck","descriptions":["Light seems to follow you as you move about, allowing you to see what's in front of you but very little of what's beyond.  A slight odor of peaches is prevalent throughout the hallway."],"exits":[{"to":16,"exit":"southeast","move":"southeast"},{"to":27,"exit":"go","move":"go doorway"}]},
  {"id":18,"x":380,"y":160,"z":0,"title":"Droughtman's Maze, The Diamond Room","descriptions":["White marble walls speckled with tiny diamonds enclose a formidable sitting room.  Hanging from the ceiling, a large crystal chandelier bears an array of lit candles, giving off a glorious light reflected through the crystals.  Nestled against the far wall is a plump white sofa, offering comfortable seating to view the ongoing show through the large window on the opposite wall."],"exits":[{"to":8,"exit":"go","move":"go doorway"}],"aliases":["Diamond Room"]},
  {"id":19,"x":440,"y":160,"z":0,"title":"Droughtman's Maze, The Ruby Room","descriptions":["Stretching the length of one wall, a large heart-shaped window framed by sheer red curtains looks down on the maze.  Tiered redwood tables topped by a multitude of lit red candles are scattered throughout the room.  Large floor cushions lie around the room to give comfort to those spectators who might wish to relax."],"exits":[{"to":9,"exit":"go","move":"go doorway"}],"aliases":["Ruby Room"]},
  {"id":20,"x":500,"y":160,"z":0,"title":"Droughtman's Maze, The Emerald Room","descriptions":["Twining around the room, iron ivy vines have been arranged with dark green candles resting precariously upon upturned leaves.  Small wooden trunks topped with emerald green cushions offer firm but comfortable seating.  Upon the wall is a wide window bordered with green-tinted stained glass panels and framed with a soft green moss, which fills the room with a pleasant, earthy aroma."],"exits":[{"to":10,"exit":"go","move":"go doorway"}],"aliases":["Emerald Room"]},
  {"id":21,"x":560,"y":140,"z":0,"title":"Droughtman's Maze, The Sapphire Room","descriptions":["A large replica of Xibar hangs from the ceiling and rotates slowly, refracting and reflecting the light from surrounding oil lamps so that the room is awash in various shades of blue.  Blue velvet chairs are arranged in various locations around the room, next to small ironwood tables set with small blue votive candleholders."],"exits":[{"to":11,"exit":"go","move":"go doorway"}],"aliases":["Sapphire Room"]},
  {"id":22,"x":600,"y":100,"z":0,"title":"Droughtman's Maze, The Amethyst Room","descriptions":["Regally stiff, this room bears no knick-knacks or superfluous decoration.  Standing on each side of a large observation window are two pedestals on which two plain oil lamps glow brightly.  A large solitary purple couch stands at the center of the room between two pale purple marble tables."],"exits":[{"to":12,"exit":"go","move":"go doorway"}],"aliases":["Amethyst Room"]},
  {"id":23,"x":300,"y":160,"z":0,"title":"Droughtman's Maze, The Black Pearl Room","descriptions":["Dangling from the low ceiling, a black crystal chandelier bearing carved candles illuminates the room.  Sheer curtains, tied neatly at each side with satin ribbons, frame a slightly tinted window.  Plush black silk pillows surround a black ebonwood table in the center of the room."],"exits":[{"to":13,"exit":"go","move":"go doorway"}],"aliases":["Black Pearl Room"]},
  {"id":24,"x":240,"y":160,"z":0,"title":"Droughtman's Maze, The Moonstone Room","descriptions":["Iridescent walls surround a large circular table of milky quartz set in the center of the moonstone-tiled floor.  One entire wall has been replaced with a large window with opaque designs bordering the edges like frost on a winter-chilled pane.  Simple bentwood silver-birch chairs are turned at an angle to the window, to permit both conversation and a clear view."],"exits":[{"to":14,"exit":"go","move":"go doorway"}],"aliases":["Moonstone Room"]},
  {"id":25,"x":180,"y":160,"z":0,"title":"Droughtman's Maze, The Citrine Room","descriptions":["Resting in each corner of this vibrant room are wicker tables laden with yellow and orange candles in various sizes.  Painted upon the wall opposite the observation window is a mural of a rising sun.  Scattered throughout the room are large wicker chairs, each topped with a plush orange or yellow cushion, which provide seating for spectators."],"exits":[{"to":15,"exit":"go","move":"go doorway"}],"aliases":["Citrine Room"]},
  {"id":26,"x":120,"y":140,"z":0,"title":"Droughtman's Maze, The Aquamarine Room","descriptions":["Light blue walls, expertly painted with softly blended swirls of white and blue, give the impression of a room immersed in a soft, cool mist.  Aquamarine-tinted cut-crystal lamps hang from the walls.  Plush sky-blue sofas are arranged in staggered rows and elevated on risers to provide each seated spectator with a clear view out of a large oval window."],"exits":[{"to":16,"exit":"go","move":"go doorway"}],"aliases":["Aquamarine Room"]},
  {"id":27,"x":80,"y":100,"z":0,"title":"Droughtman's Maze, The Peridot Room","descriptions":["Chairs with cushions in lemon- or lime-green are set about the room, each with its own yellow-and-green-striped glass table.  Splotches of brilliant yellow and splatters of light green paint decorate the walls in abstract patterns.  The light aroma of fresh vanilla drifts from incense holders placed evenly below the observation window."],"exits":[{"to":17,"exit":"go","move":"go doorway"}],"aliases":["Peridot Room"]},
  {"id":28,"x":320,"y":240,"z":0,"title":"The Strand, Sandy Path","descriptions":["Following the roadside along the Oxenwaithe's bank, you are struck by the quiet beauty of the place.  Taking pause to breathe in the crisp, clean air, you reflect on your surroundings.  Sand, sparkling as if mixed with diamond dust, pours into deep blue undulating waters.  A lush copse of trees spreads to the north, while to the southeast, a series of delightful small buildings is set back from the river's edge."],"exits":[{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"northwest","move":"northwest"},{"to":1,"exit":"none","move":"ask spieler about treasure"}],"aliases":["Crossing","exit"],"linksTo":"Map1_Crossing.xml"},
  {"id":29,"x":340,"y":80,"z":0,"title":"Droughtman's Compound, Center of Maze","descriptions":["The walls of the maze are constructed of smooth black marble with web-like veins of gold and silver that stand out boldly against the dark background.  The floors are covered with iron grating allowing for more than adequate drainage of any fluids which might be spilled within the confines of the labyrinth.  Several flickering torches are placed in gold trimmed sconces spaced evenly along the passage walls."],"exits":[{"to":6,"exit":"go","move":"go golden arch","hidden":true}],"color":"#00FF00"}
 ],
