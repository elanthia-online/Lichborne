  {"id":6,"x":60,"y":-134,"z":0,"title":"Dunes of Despair, Sand Valley","descriptions":["Loose sand occasionally avalanches down the steep incline on one side of the shallow valley, collecting treacherously at the bottom.  A gentle slope rises to the next dune's crest, the combination of shifting sand and desert wind keeping the slope smooth and curved.  "],"exits":[{"to":5,"exit":"northeast","move":"northeast","hidden":true},{"to":1,"exit":"north","move":"north","hidden":true},{"to":2,"exit":"southwest","move":"southwest","hidden":true},{"to":4,"exit":"south","move":"south"}],"color":"#FFFF00"},
  {"id":7,"x":110,"y":-140,"z":0,"title":"Dunes of Despair, Sand Valley","descriptions":["Night translates the tan sands of the dunes into a rippled surface of dark grey shadows and serpentine humps.  The horizon vanishes in the obscuring darkness.","Loose sand occasionally avalanches down the steep incline on one side of the shallow valley, collecting treacherously at the bottom.  A gentle slope rises to the next dune's crest, the combination of shifting sand and desert wind keeping the slope smooth and curved."],"exits":[{"to":5,"exit":"north","move":"north"},{"to":3,"exit":"east","move":"east","hidden":true},{"to":8,"exit":"southwest","move":"southwest"},{"to":10,"exit":"west","move":"west","hidden":true}],"color":"#FFFF00"},
  {"id":8,"x":90,"y":-120,"z":0,"title":"Dunes of Despair, Sand Valley","descriptions":["Night translates the tan sands of the dunes into a rippled surface of dark grey shadows and serpentine humps.  The horizon vanishes in the obscuring darkness.","Loose sand occasionally avalanches down the steep incline on one side of the shallow valley, collecting treacherously at the bottom.  A gentle slope rises to the next dune's crest, the combination of shifting sand and desert wind keeping the slope smooth and curved."],"exits":[{"to":7,"exit":"northeast","move":"northeast"},{"to":10,"exit":"southeast","move":"southeast","hidden":true},{"to":9,"exit":"south","move":"south"},{"to":4,"exit":"west","move":"west","hidden":true}],"color":"#FFFF00"},
