  {"id":1,"x":20,"y":-54,"z":0,"title":"Dunes of Despair, Sand Valley","descriptions":["Loose sand occasionally avalanches down the steep incline on one side of the shallow valley, collecting treacherously at the bottom.  A gentle slope rises to the next dune's crest, the combination of shifting sand and desert wind keeping the slope smooth and curved."],"exits":[{"to":2,"exit":"northeast","move":"northeast"},{"to":5,"exit":"southwest","move":"southwest"},{"to":4,"exit":"west","move":"west","hidden":true},{"to":6,"exit":"east","move":"east","hidden":true},{"to":390,"exit":"go","move":"go trail"}],"color":"#FFFF00","aliases":["Adult Armadillos"]},
