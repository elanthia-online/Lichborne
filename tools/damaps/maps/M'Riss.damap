  {"id":400,"x":180,"y":-60,"z":0,"title":"Dunes of Despair, High Dunes","descriptions":["An endless expanse of featureless waste stretches in all directions.  In the distance, the desert floor merges with the sky in a hazy, shimmering blur.  The steady breeze whips a spray of fine sand into the air, stinging open eyes.","The dim illumination of the night reveals a sea of gentle dunes rippling into the distance.  Shadowed troughs and highlighted dune crests mingle teasingly across the desert bed, relieving its otherwise stark emptiness."],"exits":[{"to":401,"exit":"north","move":"north","hidden":true},{"to":401,"exit":"northeast","move":"northeast"},{"to":399,"exit":"southwest","move":"southwest"},{"to":398,"exit":"northwest","move":"northwest","hidden":true}],"color":"#A020F0"},
  {"id":401,"x":200,"y":-80,"z":0,"title":"Dunes of Despair, High Dunes","descriptions":["An endless expanse of featureless waste stretches in all directions.  In the distance, the desert floor merges with the sky in a hazy, shimmering blur.  The steady breeze whips a spray of fine sand into the air, stinging open eyes.","The dim illumination of the night reveals a sea of gentle dunes rippling into the distance.  Shadowed troughs and highlighted dune crests mingle teasingly across the desert bed, relieving its otherwise stark emptiness."],"exits":[{"to":397,"exit":"north","move":"north","hidden":true},{"to":402,"exit":"northeast","move":"northeast"},{"to":400,"exit":"southeast","move":"southwest","hidden":true},{"to":400,"exit":"southwest","move":"southwest"}],"color":"#A020F0"},
  {"id":402,"x":220,"y":-100,"z":0,"title":"Dunes of Despair, High Dunes","descriptions":["An endless expanse of featureless waste stretches in all directions.  In the distance, the desert floor merges with the sky in a hazy, shimmering blur.  The steady breeze whips a spray of fine sand into the air, stinging open eyes.","The dim illumination of the night reveals a sea of gentle dunes rippling into the distance.  Shadowed troughs and highlighted dune crests mingle teasingly across the desert bed, relieving its otherwise stark emptiness."],"exits":[{"to":399,"exit":"north","move":"north","hidden":true},{"to":397,"exit":"northeast","move":"northeast"},{"to":400,"exit":"south","move":"southwest","hidden":true},{"to":401,"exit":"southwest","move":"southwest"},{"to":12,"exit":"go","move":"go trail"}],"color":"#A020F0"},
  {"id":403,"x":60,"y":-220,"z":0,"title":"Tavayon, Lake Bed","descriptions":["Hardened by hundreds of years under the intense heat of the sun, the vast expanse of silt is marred by an endless network of salt-encrusted cracks that form a kaleidoscope of geometric shapes.  Jagged cliffs ring the dry lake bed, broken only by a faint trail leading northward and a towering plateau looming to the south."],"exits":[{"to":408,"exit":"east","move":"east"},{"to":409,"exit":"southeast","move":"southeast"},{"to":404,"exit":"southwest","move":"southwest"},{"to":380,"exit":"go","move":"go trail"},{"to":415,"exit":"climb","move":"climb plateau"}],"color":"#00FF00","aliases":["Premium Juvies"]},
  {"id":404,"x":40,"y":-200,"z":0,"title":"Tavayon, Lake Bed","descriptions":["Hardened by hundreds of years under the intense heat of the sun, the vast expanse of silt is marred by an endless network of salt-encrusted cracks that form a kaleidoscope of geometric shapes.  Jagged cliffs ring the dry lake bed and a towering plateau looms to the east."],"exits":[{"to":403,"exit":"northeast","move":"northeast"},{"to":405,"exit":"southeast","move":"southeast"}],"color":"#00FF00"},
  {"id":405,"x":60,"y":-180,"z":0,"title":"Tavayon, Lake Bed","descriptions":["Hardened by hundreds of years under the intense heat of the sun, the vast expanse of silt is marred by an endless network of salt-encrusted cracks that form a kaleidoscope of geometric shapes.  Jagged cliffs ring the dry lake bed and a towering plateau looms to the north."],"exits":[{"to":409,"exit":"northeast","move":"northeast"},{"to":406,"exit":"east","move":"east"},{"to":404,"exit":"northwest","move":"northwest"},{"to":417,"exit":"climb","move":"climb plateau"}],"color":"#00FF00"},
  {"id":406,"x":100,"y":-180,"z":0,"title":"Tavayon, Lake Bed","descriptions":["Hardened by hundreds of years under the intense heat of the sun, the vast expanse of silt is marred by an endless network of salt-encrusted cracks that form a kaleidoscope of geometric shapes.  Jagged cliffs ring the dry lake bed and a deep crater lies to the north, though passage is obstructed by numerous spires of obsidian that jut high into the air."],"exits":[{"to":407,"exit":"northeast","move":"northeast"},{"to":405,"exit":"west","move":"west"},{"to":409,"exit":"northwest","move":"northwest"}],"color":"#00FF00"},
  {"id":407,"x":120,"y":-200,"z":0,"title":"Tavayon, Lake Bed","descriptions":["Hardened by hundreds of years under the intense heat of the sun, the vast expanse of silt is marred by an endless network of salt-encrusted cracks that form a kaleidoscope of geometric shapes.  Jagged cliffs ring the dry lake bed and a deep crater lies to the west, though passage is obstructed by numerous spires of obsidian that jut high into the air."],"exits":[{"to":406,"exit":"southwest","move":"southwest"},{"to":408,"exit":"northwest","move":"northwest"}],"color":"#00FF00"},
  {"id":408,"x":100,"y":-220,"z":0,"title":"Tavayon, Lake Bed","descriptions":["Hardened by hundreds of years under the intense heat of the sun, the vast expanse of silt is marred by an endless network of salt-encrusted cracks that form a kaleidoscope of geometric shapes.  Jagged cliffs ring the dry lake bed and a deep crater lies to the south, which is surrounded by numerous spires of obsidian that jut high into the air."],"exits":[{"to":407,"exit":"southeast","move":"southeast"},{"to":409,"exit":"southwest","move":"southwest"},{"to":403,"exit":"west","move":"west"},{"to":410,"exit":"go","move":"go pass"}],"color":"#00FF00"},
  {"id":409,"x":80,"y":-200,"z":0,"title":"Tavayon, Lake Bed","descriptions":["Hardened by hundreds of years under the intense heat of the sun, the vast expanse of silt is marred by an endless network of salt-encrusted cracks that form a kaleidoscope of geometric shapes.  Jagged cliffs ring the dry lake bed and a towering plateau looms to the west.  A deep crater lies to the east, though passage is obstructed by numerous spires of obsidian that jut high into the air."],"exits":[{"to":408,"exit":"northeast","move":"northeast"},{"to":406,"exit":"southeast","move":"southeast"},{"to":405,"exit":"southwest","move":"southwest"},{"to":403,"exit":"northwest","move":"northwest"}],"color":"#00FF00"},
  {"id":410,"x":160,"y":-220,"z":0,"title":"Tavayon, Water's Edge","descriptions":["Numerous spires of obsidian jut around the rim of the crater and smaller fragments speckle the terrain, ranging from mere pebbles to colossal boulders taller than a Gor'Tog.  Meager plant life struggles to eke out an existence in this bleak landscape, growing marginally more abundant as it approaches a brackish oasis to the south."],"exits":[{"to":411,"exit":"southeast","move":"southeast"},{"to":412,"exit":"south","move":"south"},{"to":413,"exit":"southwest","move":"southwest"},{"to":408,"exit":"go","move":"go pass"}],"color":"#A020F0","aliases":["Premium Elders"]},
  {"id":411,"x":180,"y":-200,"z":0,"title":"Tavayon, Water's Edge","descriptions":["Numerous spires of obsidian jut around the rim of the crater and smaller fragments speckle the terrain, ranging from mere pebbles to colossal boulders taller than a Gor'Tog.  Meager plant life struggles to eke out an existence in this bleak landscape, growing marginally more abundant as it approaches a brackish oasis to the west."],"exits":[{"to":414,"exit":"southwest","move":"southwest"},{"to":412,"exit":"west","move":"west"},{"to":410,"exit":"northwest","move":"northwest"}],"color":"#A020F0"},
  {"id":412,"x":160,"y":-200,"z":0,"title":"Tavayon, Oasis","descriptions":["Shallow, brackish water offers life to the wretched plants that sprout around the shore.  Several salt-encrusted chunks of obsidian spike up through the surface of the water."],"exits":[{"to":410,"exit":"north","move":"north"},{"to":411,"exit":"east","move":"east"},{"to":414,"exit":"south","move":"south"},{"to":413,"exit":"west","move":"west"}],"color":"#A020F0"},
  {"id":413,"x":140,"y":-200,"z":0,"title":"Tavayon, Tumulus","descriptions":["Numerous spires of obsidian jut around the rim of the crater and smaller fragments speckle the terrain, ranging from mere pebbles to colossal boulders taller than a Gor'Tog.  Meager plant life struggles to eke out an existence in this bleak landscape, growing marginally more abundant as it approaches a brackish oasis to the east."],"exits":[{"to":410,"exit":"northeast","move":"northeast"},{"to":412,"exit":"east","move":"east"},{"to":414,"exit":"southeast","move":"southeast"}],"color":"#A020F0"},
  {"id":414,"x":160,"y":-180,"z":0,"title":"Tavayon, Water's Edge","descriptions":["Numerous spires of obsidian jut around the rim of the crater and smaller fragments speckle the terrain, ranging from mere pebbles to colossal boulders taller than a Gor'Tog.  Meager plant life struggles to eke out an existence in this bleak landscape, growing marginally more abundant as it approaches a brackish oasis to the north."],"exits":[{"to":412,"exit":"north","move":"north"},{"to":411,"exit":"northeast","move":"northeast"},{"to":413,"exit":"northwest","move":"northwest"}],"color":"#A020F0"},
  {"id":415,"x":220,"y":-240,"z":0,"title":"Tavayon, Plateau","descriptions":["Towering over the lake bed below, the ground here is mostly free of salt and speckled with sagebrush.  The edge of the rock cuts in here somewhat, offering a possible descent down the face of the plateau."],"exits":[{"to":418,"exit":"southeast","move":"southeast"},{"to":416,"exit":"southwest","move":"southwest"},{"to":403,"exit":"climb","move":"climb plateau"}],"color":"#FFFF00"},
  {"id":416,"x":200,"y":-220,"z":0,"title":"Tavayon, Plateau","descriptions":["Towering over the lake bed below, the ground here is mostly free of salt and speckled with sagebrush.  A lone tree leans over the edge of the plateau, its withered roots exposed through crumbling dirt."],"exits":[{"to":415,"exit":"northeast","move":"northeast"},{"to":417,"exit":"southeast","move":"southeast"}],"color":"#FFFF00"},
  {"id":417,"x":220,"y":-200,"z":0,"title":"Tavayon, Plateau","descriptions":["Towering over the lake bed below, the ground here is mostly free of salt and speckled with sagebrush.  The edge of the rock cuts in here somewhat, offering a possible descent down the face of the plateau."],"exits":[{"to":418,"exit":"northeast","move":"northeast"},{"to":416,"exit":"northwest","move":"northwest"},{"to":405,"exit":"climb","move":"climb plateau"}],"color":"#FFFF00"},
  {"id":418,"x":240,"y":-220,"z":0,"title":"Tavayon, Plateau","descriptions":["Towering over the lake bed below, the ground here is mostly free of salt and speckled with sagebrush.  Visible to the east is a deep crater in the lake bed ringed by obsidian spires."],"exits":[{"to":417,"exit":"southwest","move":"southwest"},{"to":415,"exit":"northwest","move":"northwest"}],"color":"#FFFF00"},
  {"id":419,"x":-240,"y":120,"z":0,"title":"The West Face, A Narrow Channel","descriptions":["The channel bears signs of having been at least improved, if not created, by intention.  In some places, small steps have been hacked in the rock, but either the project was unfinished or it was intended for some creature whose limbs are hard to imagine."],"exits":[{"to":420,"exit":"climb","move":"climb down"},{"to":279,"exit":"climb","move":"climb up"}],"color":"#FFFFFF"},
  {"id":420,"x":-240,"y":140,"z":0,"title":"The West Face, A Rocky Ledge","descriptions":["Midway up the cliff face juts a rocky ledge, only a few feet wide and perhaps ten or twelve feet long.  Above it, a narrow channel carved into the rock leads upwards out of sight.  Further to the east, a much steeper and natural-looking crevice in the rock leads downward to the river bank."],"exits":[{"to":421,"exit":"east","move":"east"},{"to":419,"exit":"climb","move":"climb up"}],"color":"#FFFFFF"},
  {"id":421,"x":-220,"y":140,"z":0,"title":"The West Face, A Rocky Ledge","descriptions":["Midway up the cliff face juts a rocky ledge, only a few feet wide and perhaps ten or twelve feet long.  Below it, a narrow crevice in the rock leads downward to the river bank.  Further to the west, a channel in the cliff face leads upward out of sight."],"exits":[{"to":420,"exit":"west","move":"west"}],"color":"#FFFFFF"}
 ],
