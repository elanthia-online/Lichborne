  {"id":17,"x":270,"y":-120,"z":0,"title":"Dunes of Despair, Sand Valley","descriptions":["Loose sand occasionally avalanches down the steep incline on one side of the shallow valley, collecting treacherously at the bottom.  A gentle slope rises to the next dune's crest, the combination of shifting sand and desert wind keeping the slope smooth and curved."],"exits":[{"to":12,"exit":"northeast","move":"northeast"},{"to":16,"exit":"south","move":"south"},{"to":14,"exit":"southwest","move":"southwest","hidden":true},{"to":13,"exit":"north","move":"north","hidden":true}]},
  {"id":18,"x":-100,"y":-180,"z":0,"title":"Dunes of Despair, Dune Crest","descriptions":["Night translates the tan sands of the dunes into a rippled surface of dark grey shadows and serpentine humps.  The horizon vanishes in the obscuring darkness.","The dune slopes down to the west and east, providing a precarious perch.  Waves of unrelenting heat roll off the unending dunes of sand, blurring the horizon."],"exits":[{"to":19,"exit":"northeast","move":"northeast"},{"to":23,"exit":"southwest","move":"southwest"},{"to":22,"exit":"south","move":"south","hidden":true},{"to":23,"exit":"north","move":"north","hidden":true}]},
  {"id":19,"x":-80,"y":-200,"z":0,"title":"Dunes of Despair, Dune Crest","descriptions":["Night translates the tan sands of the dunes into a rippled surface of dark grey shadows and serpentine humps.  The horizon vanishes in the obscuring darkness.","The dune slopes down to the west and east, providing a precarious perch.  Waves of unrelenting heat roll off the unending dunes of sand, blurring the horizon."],"exits":[{"to":18,"exit":"southwest","move":"southwest"},{"to":20,"exit":"north","move":"north"},{"to":20,"exit":"northeast","move":"northeast","hidden":true},{"to":18,"exit":"south","move":"south","hidden":true}]},
  {"id":20,"x":-140,"y":-100,"z":0,"title":"Dunes of Despair, Dune Crest","descriptions":["Night translates the tan sands of the dunes into a rippled surface of dark grey shadows and serpentine humps.  The horizon vanishes in the obscuring darkness.","The dune slopes down to the west and east, providing a precarious perch.  Waves of unrelenting heat roll off the unending dunes of sand, blurring the horizon."],"exits":[{"to":19,"exit":"south","move":"south"},{"to":21,"exit":"north","move":"north"},{"to":24,"exit":"southwest","move":"southwest"},{"to":18,"exit":"northeast","move":"northeast","hidden":true}]},
  {"id":21,"x":-140,"y":-120,"z":0,"title":"Dunes of Despair, Dune Crest","descriptions":["Night translates the tan sands of the dunes into a rippled surface of dark grey shadows and serpentine humps.  The horizon vanishes in the obscuring darkness.","The dune slopes down to the west and east, providing a precarious perch.  Waves of unrelenting heat roll off the unending dunes of sand, blurring the horizon."],"exits":[{"to":22,"exit":"northeast","move":"northeast"},{"to":20,"exit":"south","move":"south"},{"to":25,"exit":"down","move":"down"},{"to":23,"exit":"north","move":"north","hidden":true},{"to":18,"exit":"southwest","move":"southwest","hidden":true}]},
