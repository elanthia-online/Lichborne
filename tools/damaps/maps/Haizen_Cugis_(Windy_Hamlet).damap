 offering no shelter or comfort to lost travelers."],"exits":[{"to":70,"exit":"north","move":"rt north","hidden":true},{"to":72,"exit":"northeast","move":"rt northeast","hidden":true},{"to":72,"exit":"east","move":"rt east"},{"to":70,"exit":"southeast","move":"rt southeast","hidden":true},{"to":72,"exit":"south","move":"rt south","hidden":true},{"to":70,"exit":"southwest","move":"rt southwest","hidden":true},{"to":70,"exit":"west","move":"rt west"},{"to":70,"exit":"northwest","move":"rt northwest","hidden":true}]},
