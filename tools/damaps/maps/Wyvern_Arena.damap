{
 "format": "damap",
 "version": 1,
 "id": "997",
 "name": "Wyvern Arena",
 "file": "Wyvern_Arena.xml",
 "rooms": [
  {"id":1,"x":20,"y":20,"z":0,"title":"Wyvern Arena, Spectator's Perch","descriptions":["Numerous lacquered cedar benches are arranged in tiers, affording a fine view of the arena below.  A mesh screen has been placed in front of the benches to protect the spectators, while scarred stone walls protect this spot from the elements."],"exits":[{"to":2,"exit":"go","move":"go arch"}],"aliases":["Spectator's Perch","EXIT portal","portal"]},
  {"id":2,"x":20,"y":40,"z":0,"title":"Wyvern Arena, Triage Area","descriptions":["The cold stone floor of this room slopes slightly toward a rough metal trough, allowing for good drainage and easy cleaning.  Heavy wrought iron cots are arranged at intervals along the back wall.  Standing sentinel over each cot, large brass lamps provide excellent lighting for the healers and attendants."],"exits":[{"to":3,"exit":"west","move":"west"},{"to":1,"exit":"go","move":"go arch"},{"to":4,"exit":"go","move":"go ramp"}],"color":"#00FFFF","aliases":["Triage Area"]},
  {"id":3,"x":0,"y":40,"z":0,"title":"Wyvern Arena, Alcove","descriptions":["This tiny alcove is dominated by a rough-hewn granite statue of a proud wolverine standing guard over a simple cedar altar.  The floor is strewn with fresh evergreen boughs, their dense, verdant needles hushing the area and lending the air a sharp, crisp scent."],"exits":[{"to":2,"exit":"east","move":"east"}],"aliases":["Alcove"]},
  {"id":4,"x":40,"y":40,"z":0,"title":"Wyvern Arena, Red Corner","descriptions":["Several blood splatters down the wall are framed on either side by a series of bloody hand prints.  Drag marks line the sand, and irregular dark droplets follow the trail back towards the triage area."],"exits":[{"to":5,"exit":"north","move":"north"},{"to":6,"exit":"northeast","move":"northeast"},{"to":7,"exit":"east","move":"east"},{"to":2,"exit":"go","move":"go ramp"}],"aliases":["Red Corner"]},
  {"id":5,"x":40,"y":0,"z":0,"title":"Wyvern Arena, Yellow Corner","descriptions":["Niches carved in the chilled stone walls provide storage for those no longer with the living.  The arena attendants place the bodies in the niches out of way of further harm until they can be dragged out.  Tiny dried trickles of unidentifiable fluids trail down from recess, the only remnant of the departed."],"exits":[{"to":8,"exit":"east","move":"east"},{"to":6,"exit":"southeast","move":"southeast"},{"to":4,"exit":"south","move":"south"}],"aliases":["Yellow Corner"]},
  {"id":6,"x":60,"y":20,"z":0,"title":"Wyvern Arena, Centerfield","descriptions":["Light from evenly placed wall torches illuminates the the dirty white sand of the stadium floor, which is packed rather hard in places.  The cloying smells of blood and sweat mingle in the air, hanging thick and making the arena smell rather musty.  Clouds of sand roll across the arena like a low fog, added to frequently by the fierce battles."],"exits":[{"to":8,"exit":"northeast","move":"northeast"},{"to":7,"exit":"southeast","move":"southeast"},{"to":4,"exit":"southwest","move":"southwest"},{"to":5,"exit":"northwest","move":"northwest"}],"aliases":["Centerfield"]},
  {"id":7,"x":80,"y":40,"z":0,"title":"Wyvern Arena, Blue Corner","descriptions":["Impaled in the wall is the massive blade of a sword, snapped off like the tooth of a large predator.  Several scorch marks line the wall leading to a massive mark still bearing the silhouette of the victim of an attack where his body protected the wall from damage."],"exits":[{"to":8,"exit":"north","move":"north"},{"to":4,"exit":"west","move":"west"},{"to":6,"exit":"northwest","move":"northwest"}],"aliases":["Blue Corner"]},
  {"id":8,"x":80,"y":0,"z":0,"title":"Wyvern Arena, Green Corner","descriptions":["An iron portcullis blocks a dark tunnel leading deep within the walls.  Howls and screeches drift across the sands from the doorway, mingling with the sounds of the spectators.  Swarms of gnats fly thick in the air like angry black clouds, occasionally darting to the walls to feast on the blood of the recently dead."],"exits":[{"to":7,"exit":"south","move":"south"},{"to":6,"exit":"southwest","move":"southwest"},{"to":5,"exit":"west","move":"west"}],"aliases":["Green Corner"]}
 ],
 "labels": []
}
