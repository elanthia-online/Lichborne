{
 "format": "damap",
 "version": 1,
 "id": "31",
 "name": "Riverhaven East Gate",
 "file": "Map31_Riverhaven_East_Gate.xml",
 "includes": [
  "Map31a_Zaulfung.xml"
 ],
 "rooms": [
  {"id":1,"x":0,"y":-60,"z":0,"title":"Riverhaven, River Road East","descriptions":["The town wall curves down to the river and extends out into it with the heavily-fortified Eastern Tower rising above to keep watch and to control the river traffic.  A small path passes beneath the tower's shadow and through a narrow gate, wandering along the barren riverbank and out of town.  A few boats are pulled up along the shore or bob gently in the current, tied to the many poles used to control river traffic."],"exits":[{"to":0,"exit":"north","move":"north"},{"to":0,"exit":"west","move":"west"},{"to":2,"exit":"go","move":"go gate"}],"aliases":["Riverhaven"],"linksTo":"Map30_Riverhaven.xml"},
  {"id":2,"x":40,"y":-120,"z":0,"title":"Riverhaven, Stone Bridge","descriptions":["The lanes outside the eastern gate of Riverhaven are crowded with the bustle of street peddlers and merchant wagons coming and going in a great rush to sell their wares.  Beggars line the paved road, aware that the more influential and wealthy folks use this gate.  They hover, hands extended, hoping that a moment of kindness and charity might befall them.  A stone bridge that once provided passage across the river is now little more than a crumbling stone pier used by some local fishermen."],"exits":[{"to":3,"exit":"northeast","move":"northeast"},{"to":40,"exit":"go","move":"go boggy path"},{"to":1,"exit":"go","move":"go east gate"},{"to":79,"exit":"none","move":"dive river"}],"color":"#A6A3D9","aliases":["Drogor","Kraelyst start point","travel start point"]},
  {"id":3,"x":60,"y":-140,"z":0,"title":"Riverhaven Road, South Road","descriptions":["The dirt surface of the South Road is trampled and wide at this point from the heavy traffic of merchant wagons and travelers.  Following the natural cut through the foothills, the road continues northward and dips out of sight.  A faint moisture hangs in the air from the Faldesu river directly to the south.  The eastern gate of Riverhaven can be seen off to the southwest."],"exits":[{"to":4,"exit":"north","move":"north"},{"to":2,"exit":"southwest","move":"southwest"},{"to":127,"exit":"go","move":"go iron gates"}]},
  {"id":4,"x":60,"y":-160,"z":0,"title":"Riverhaven Road, South Road","descriptions":["A grove of trees grows between the road and Riverhaven's defensive wall just to the west.  A large tent is nestled within the grove.  Several smaller tents have been added as extension to the back of the larger one, hiding in back of it like children peeking out from behind their mother.  A tall guard tower looms above the treetops with a silhouetted figure pacing its perimeter, surveying the surrounding area with an ever watchful eye."],"exits":[{"to":5,"exit":"northeast","move":"northeast"},{"to":3,"exit":"south","move":"south"},{"to":77,"exit":"go","move":"go large tent"}],"color":"#C2B280","aliases":["Ranger grove","Ranger tent","large tent","RTT10","RT-HEG-ZS"]},
  {"id":5,"x":80,"y":-180,"z":0,"title":"Riverhaven Road, The Cemetery","descriptions":["Cresting the top of the hill, the town's cemetery is plainly in view from here.  A small metal gate leads inside the fenced-in area, apparently rusted closed.  A few dead flowers placed on some of the graves are a gloomy contrast to those plots that are well-maintained and freshly flowered by the occupants' family and friends.  The road dips down into the plains to the northeast and heads southward toward the town of Riverhaven."],"exits":[{"to":6,"exit":"northeast","move":"northeast"},{"to":4,"exit":"southwest","move":"southwest"},{"to":101,"exit":"go","move":"go dirt trail"}]},
  {"id":6,"x":100,"y":-200,"z":0,"title":"Riverhaven Road, The Foothills","descriptions":["Although not always in sight, the road winds its way northeast through the small hills, its destination the plains ahead.  A few ancient trees stand about like scouts for the forest creeping down the large mountains far off to the north.  Glancing southwest, an iron fence can be seen where the road heads over a hilltop."],"exits":[{"to":7,"exit":"north","move":"north"},{"to":5,"exit":"southwest","move":"southwest"},{"to":63,"exit":"go","move":"go small footpath"}]},
  {"id":7,"x":100,"y":-220,"z":0,"title":"Riverhaven Road, The Foothills","descriptions":["The road weaves through a gathering of large round boulders as it heads down into the plains which, judging from the number of burrow holes in the area, have become home for a family of ground squirrels.  To the south, the road meanders its way up and through some small foothills.  Although there can be little doubt that this route was well-traveled at one time, it shows only moderate signs of recent use."],"exits":[{"to":8,"exit":"northeast","move":"northeast"},{"to":6,"exit":"south","move":"south"}],"color":"#C2B280","aliases":["RTT09","RT-HEG-HNG"]},
  {"id":8,"x":120,"y":-240,"z":0,"title":"Riverhaven Road, The Foothills","descriptions":["The route wanders at a slight incline from the foothills above to the plains below and to the north.  An old, unrepaired rut from a wagon wheel cuts deeply into the dirt surface of the road, providing a home for a family of black beetles."],"exits":[{"to":9,"exit":"north","move":"north"},{"to":7,"exit":"southwest","move":"southwest"}]},
  {"id":9,"x":120,"y":-260,"z":0,"title":"The Northeast Wilds, The Road","descriptions":["Various trails converge from the plains to form a road that leads up into the foothills to the southwest.  Thick brush covers the plains in the east, as it works its way toward a marsh in the distant southeast. The wind whips about you here as it tries to escape from the open land and over the hills.  The broad route continues north along the brush."],"exits":[{"to":10,"exit":"north","move":"north"},{"to":8,"exit":"south","move":"south"}]},
  {"id":10,"x":120,"y":-280,"z":0,"title":"The Northeast Wilds, Plains Path","descriptions":["A sweet, pleasant smell drifts up from the weeds and brush that border the road.  Rustling movements can be seen in the growth as the lesser creatures of Elanthia scurry further into hiding.  Far off in the distance to the west and northwest the plains are dotted with flocks of sheep, sometimes surrounding a squat sheepherder's shack.  A small trail can be seen here heading off to the east."],"exits":[{"to":9,"exit":"south","move":"south"},{"to":11,"exit":"go","move":"go small trail"}]},
  {"id":11,"x":180,"y":-280,"z":0,"title":"Northeast Wilds, Deer Trail","descriptions":["The narrow trail, forged by generations of wandering wildlife, wends its way to the south through thick, chest-high brush.  It is quieter here than to the north, where the unmistakable and unrelenting cries of ravens fill the air."],"exits":[{"to":12,"exit":"south","move":"south"},{"to":10,"exit":"go","move":"go small trail"}]},
  {"id":12,"x":180,"y":-260,"z":0,"title":"Northeast Wilds, Deer Trail","descriptions":["Bushes rustle at your passing, driving birds and lizards into panic-stricken flight.  Every movement produces an incredible amount of noise that would drive away every sensible deer for miles.  However, it may attract more predatory creatures."],"exits":[{"to":11,"exit":"north","move":"north"},{"to":13,"exit":"southwest","move":"southwest"}]},
  {"id":13,"x":160,"y":-240,"z":0,"title":"Northeast Wilds, Deer Trail","descriptions":["The meandering trail takes the path of least resistance through the thick brush rather than proceeding in a straight line from origin to destination.  The soil, not especially rich, is carpeted by fallen, decomposing fronds.  A loud buzz heralds the departure of a fat bumblebee.","The meandering trail takes the path of least resistance through the thick brush rather than proceeding in a straight line from origin to destination.  Moonlight gleams on a damp, rotting carpet of fallen fronds as fireflies flicker dimly off in the distance."],"exits":[{"to":12,"exit":"northeast","move":"northeast"},{"to":14,"exit":"south","move":"south"}]},
  {"id":14,"x":160,"y":-220,"z":0,"title":"Northeast Wilds, Deer Trail","descriptions":["The narrow trail is barely discernible as it twists through the dense scrub.  Every bend and crook has some purpose known only to the instincts of the animals that forged the path.  Nearby bladebrush fronds bristle menacingly, keeping animals and adventurers at bay."],"exits":[{"to":13,"exit":"north","move":"north"},{"to":15,"exit":"southeast","move":"southeast"}]},
  {"id":15,"x":180,"y":-200,"z":0,"title":"Northeast Wilds, Deer Trail","descriptions":["The trail bends sharply here to avoid an intimidating cluster of bladebrush.  In the corner of your eye you catch the bright glimmer of sunlight reflecting off water to the southeast.","The trail bends sharply here.  The profile of an intimidating cluster of bladebrush can be seen against the starry backdrop of the night sky."],"exits":[{"to":16,"exit":"east","move":"east"},{"to":25,"exit":"west","move":"west"},{"to":14,"exit":"northwest","move":"northwest"}]},
  {"id":16,"x":200,"y":-200,"z":0,"title":"Northeast Wilds, Path","descriptions":["This east-west path cuts directly through the dense brush, too straight and regular to be the work of animals.  A wooden stake with a red ribbon tied around it serves to mark the junction of the path and the twisting deer trail."],"exits":[{"to":17,"exit":"east","move":"east"},{"to":15,"exit":"west","move":"west"}]},
  {"id":17,"x":220,"y":-200,"z":0,"title":"Northeast Wilds, Path","descriptions":["A gnarled tree has been uprooted and dragged to one side of the path.  A few eager weeds, or possibly just ugly flowers, are already emerging from the dirt-filled place where the tree so recently stood."],"exits":[{"to":18,"exit":"east","move":"east"},{"to":16,"exit":"west","move":"west"}]},
  {"id":18,"x":300,"y":-200,"z":0,"title":"Northeast Wilds, Path","descriptions":["Tough, hardy bushes with thick leaves and nasty thorns scrabble toward the pathway, but fall short by several handlengths.  The fresh markings of a well-applied machete or axe have cut a ruthless path through the brush, much to the woe of the plants that would cling to the flesh of passersby foolish enough to push through too quickly."],"exits":[{"to":19,"exit":"southeast","move":"southeast"},{"to":17,"exit":"west","move":"west"}]},
  {"id":19,"x":320,"y":-180,"z":0,"title":"Northeast Wilds, Path","descriptions":["The path follows the southern shore of a small stagnant pond completely overgrown with an unwholesome yellow scum.  A stand of gnarled trees has been felled and their roots and branches stripped, leaving a stack of logs to one side.  It looks as if some large animal has been digging by the woodpile recently."],"exits":[{"to":20,"exit":"east","move":"east"},{"to":18,"exit":"northwest","move":"northwest"}]},
  {"id":20,"x":360,"y":-180,"z":0,"title":"Zaulfung, Clearing","descriptions":["A mighty stench, the bouquet of the Zaulfung, wafts in over the waist-deep brush to the south.  The swamp itself, like a black stain on Elanthia's green robes, is visible beyond the scrub.  A natural clearing opens up to the northeast, while a wide manmade path strikes eastward."],"exits":[{"to":24,"exit":"north","move":"north"},{"to":21,"exit":"northeast","move":"northeast"},{"to":19,"exit":"west","move":"west"}]},
  {"id":21,"x":380,"y":-200,"z":0,"title":"Zaulfung, Clearing","descriptions":["Thick bushes with barbed finger-length thorns serve as a boundary for this clearing.  A few have been cleared away, allowing access to a lunat pierwalk leading south to a chickee out over the swamp.  Bees flit between the bright yellow flowers, their pollination a welcome activity unhindered by the wicked barbs.","Thick bushes with barbed finger-length thorns serve as a boundary for this clearing.  A few have been cleared away, allowing access to a lunat pierwalk leading south to a chickee out over the swamp.  The bright wood of the pierwalk shines starkly in the gloom of the night."],"exits":[{"to":23,"exit":"north","move":"north"},{"to":22,"exit":"northeast","move":"northeast"},{"to":20,"exit":"southwest","move":"southwest"},{"to":24,"exit":"west","move":"west"},{"to":38,"exit":"go","move":"go pierwalk"}]},
  {"id":22,"x":400,"y":-220,"z":0,"title":"Zaulfung, Clearing","descriptions":["Four logs have been arranged in a square around a large fire pit to provide seating for a dozen or more.  An iron cauldron rests beside the pit, now filled with rainwater and serving as a breeding ground for mosquitos, as if the expanse of swamp weren't large enough for the omnipresent pests."],"exits":[{"to":21,"exit":"southwest","move":"southwest"},{"to":23,"exit":"west","move":"west"}]},
  {"id":23,"x":380,"y":-220,"z":0,"title":"Zaulfung, Clearing","descriptions":["A shallow trench directs rainwater to the southeast rather than letting it flow downhill into the fire pit.  A pair of tulvora trees, intertwined as if locked in either loving embrace or deadly combat, occupy this corner of the clearing.  Their fragrant leaves not only serve to repel damaging insects, but nearly cover the stench of the swamp."],"exits":[{"to":22,"exit":"east","move":"east"},{"to":21,"exit":"south","move":"south"},{"to":24,"exit":"southwest","move":"southwest"}]},
  {"id":24,"x":360,"y":-200,"z":0,"title":"Zaulfung, Clearing","descriptions":["The damp ground bears the tracks of hundreds of hooves as well as the lighter marks of a boobrie's passing.  The dried-out husk of a boar lies half-buried in the mud, its corpse trampled by its brethren.  A scattering of bloodstained grey feathers indicates that the boar did not die peacefully."],"exits":[{"to":23,"exit":"northeast","move":"northeast"},{"to":21,"exit":"east","move":"east"},{"to":20,"exit":"south","move":"south"}],"aliases":["Wild Boars"]},
  {"id":25,"x":160,"y":-200,"z":0,"title":"Zaulfung, Standing Stones","descriptions":["This curiously circular clearing looks as if all its vegetation was blasted away centuries ago in an arcane duel.  A pair of imposing standing stones, one grey and smooth, the other blackened and charred, face each other across the clearing.  To the east and southeast are narrow gaps leading through the otherwise impenetrable scrub, while the path to the southwest is a broken tangle of exposed roots.","This circular clearing is dominated by the presence of two imposing standing stones, silent sentinels of an ancient power.  A shadow deeper than the night reaches across the clearing from the south, while at the north end the stark grey stone looms pale and ghostlike."],"exits":[{"to":15,"exit":"east","move":"east"},{"to":36,"exit":"southeast","move":"southeast"},{"to":26,"exit":"southwest","move":"southwest"}],"aliases":["Standing Stones","Warding Stones"]},
  {"id":26,"x":140,"y":-180,"z":0,"title":"Zaulfung, Boar Trail","descriptions":["The bare dirt of the trail is extremely uneven thanks to the digging of boars and the crisscrossing of thick, tough bladebrush roots.  Extra care must be taken to avoid spraining an ankle."],"exits":[{"to":25,"exit":"northeast","move":"northeast"},{"to":27,"exit":"south","move":"south"}]},
  {"id":27,"x":140,"y":-160,"z":0,"title":"Zaulfung, Boar Trail","descriptions":["The path is wide enough here for a full-sized carriage, though it would undoubtedly break an axle on the rough and broken ground.  A column of ants marches purposefully across the trail."],"exits":[{"to":26,"exit":"north","move":"north"},{"to":28,"exit":"southeast","move":"southeast"}]},
  {"id":28,"x":160,"y":-140,"z":0,"title":"Zaulfung, Boar Trail","descriptions":["The path is made treacherous by roots as big around as a barbarian's bicep.  If it is supposed to be leading somewhere in particular, it's taking neither the most direct nor the easiest route.  It opens up into a marshy clearing to the south and meanders northwest to drier ground.  A large spider pauses its work to regard you dispassionately from its web in a nearby scrub pine."],"exits":[{"to":29,"exit":"south","move":"south"},{"to":27,"exit":"northwest","move":"northwest"}]},
  {"id":29,"x":160,"y":-120,"z":0,"title":"Zaulfung, Marsh","descriptions":["The tangle of scrub to the north gives way to more open terrain here, where the vegetation is too thin to hold back the cold wind.  A rough trail twists haphazardly northward, apparently the work of a half-mad boar or a drunken band of Gor'Tog rangers."],"exits":[{"to":30,"exit":"east","move":"east"},{"to":33,"exit":"south","move":"south"},{"to":28,"exit":"go","move":"go boar trail"}]},
  {"id":30,"x":200,"y":-120,"z":0,"title":"Zaulfung, Marsh","descriptions":["Through a curtain of dead Vilt stalks, you can see a weed-choked pond to the east.  A pair of baleful orange eyes stares at you from the center of the pond, the only part of some unspeakable creature not submerged in the noisome water."],"exits":[{"to":31,"exit":"south","move":"south"},{"to":29,"exit":"west","move":"west"}]},
  {"id":31,"x":200,"y":-100,"z":0,"title":"Zaulfung, Marsh","descriptions":["Each step leaves a deep impression in the boggy earth.  Not surprisingly, a pair of boots are stuck in the mud here.  The ground looks a bit drier and more solid to the west, but softer and muddier to the south.  Beyond the pond to the east, there is no promise of drier ground."],"exits":[{"to":30,"exit":"north","move":"north"},{"to":32,"exit":"south","move":"south"},{"to":33,"exit":"west","move":"west"},{"to":165,"exit":"go","move":"go swampy mire"}],"color":"#C2B280","aliases":["RTT11","RT-ZS-HEG"]},
  {"id":32,"x":200,"y":-60,"z":0,"title":"Zaulfung, Marsh","descriptions":["The Zaulfung stretches out endlessly to your east, though there are no notable landmarks to guide your passage through the treacherous swamp.  A lone Troiliff flower grows here among the more common grasses and weeds."],"exits":[{"to":31,"exit":"north","move":"north"},{"to":85,"exit":"go","move":"go faint trail"}]},
  {"id":33,"x":160,"y":-100,"z":0,"title":"Zaulfung, Marsh","descriptions":["The open marsh offers no shelter from the surprisingly cold and bitter eastern wind.  It blows through the brush to the west and bears the boggy stench of the forbidding Zaulfung, the devil swamp.  To the southeast, a tall cypress stands like a lone sentry watching over the region."],"exits":[{"to":29,"exit":"north","move":"north"},{"to":31,"exit":"east","move":"east"},{"to":34,"exit":"southeast","move":"southeast"}]},
  {"id":34,"x":180,"y":-60,"z":0,"title":"Zaulfung, Cypress","descriptions":["A solitary cypress stands here, casting its shadow over the marsh and towering over the area like no other tree within sight.  The boughs are hung with Maiden's Tress, which fortunately seems to be dormant in the cold."],"exits":[{"to":33,"exit":"northwest","move":"northwest"},{"to":35,"exit":"climb","move":"climb cypress tree"}]},
  {"id":35,"x":160,"y":-60,"z":0,"title":"Zaulfung, High Perch","descriptions":["Heavy branches laden with moss and Maiden's Tress provide a gloomy shade above the marshy ground.  Thick slats of pine, stained by weather and age, make the floor of what might have once been a hunter's blind.  The Zaulfung, a region of weed-choked ponds and boggy marshland, stretches out to the eastern horizon.","Furtive movements in the distant shadows catch your eye, but dark tangles of moss against the darker night leave little to be seen.  The platform provides a place to rest, but no shelter from the cold wind or the eerie nocturnal noises of the swamp."],"exits":[{"to":34,"exit":"down","move":"down"}]},
  {"id":36,"x":180,"y":-180,"z":0,"title":"Zaulfung, Deer Trail","descriptions":["Countless deer have left deep tracks in the soft soil en route to a watering hole to the southeast.  However, their prints are somewhat eroded, as if the trail has been recently abandoned.  A northwesterly breeze carries with it a whiff of decay."],"exits":[{"to":37,"exit":"southeast","move":"southeast"},{"to":25,"exit":"northwest","move":"northwest"},{"to":36,"exit":"go","move":"go thick brush"}]},
  {"id":37,"x":200,"y":-160,"z":0,"title":"Zaulfung, Watering Hole","descriptions":["This watering hole is the final destination of the trail.  Final seems to be the operative word for the unlucky deer, several days dead, which lies rotting on the shore.  Even without the stench and the flies, one look at the fouled water is enough to discourage you from lingering for a drink."],"exits":[{"to":36,"exit":"northwest","move":"northwest"}]},
  {"id":38,"x":440,"y":-200,"z":0,"title":"Zaulfung, Chickee","descriptions":["Overturned crates, smashed alchemical equipment, and bones not yet bleached by the sun lay amidst the debris strewn about this wide platform which rises from the mire below on stout ironwood pilings.  A strange sigil the color of dried blood has been painted in the center of the chickee.","This platform, rising from the mire below on stout ironwood pilings, is faintly illuminated by a luminescent sigil painted on the stout boards.  Its eerie glow outlines the silhouettes of several smashed crates and glints off hundreds of shards of broken glass."],"exits":[{"to":39,"exit":"down","move":"down"},{"to":21,"exit":"go","move":"go pierwalk"}],"aliases":["Swamp Trolls"]},
  {"id":39,"x":480,"y":-100,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":109,"exit":"northeast","move":"northeast","hidden":true},{"to":81,"exit":"southeast","move":"southeast"},{"to":111,"exit":"southwest","move":"southwest","hidden":true},{"to":108,"exit":"northwest","move":"northwest"},{"to":38,"exit":"up","move":"up"}]},
  {"id":40,"x":-80,"y":-120,"z":0,"title":"Pejek Bog, A Narrow Path","descriptions":["A low fog obscures the features of the ground not far from the path.  Ferns and clumps of grasses raise their heads above it here and there, indicating areas where it may be safe to stand.  The wide expanses of mist make the path seem the more inviting means of traveling through this section of the bog.  Soft rustling noises mingle with gurgles and the slow steady drip, drip, drip of water as it falls into puddles below the mist.","Low banks of vapor swirling along the ground pick up the faintest trace of moon or starlight, lending a ghostly glow to the darkest night.  The low-lying fog banks define the path by leaving it dark as it winds through the eerie glow."],"exits":[{"to":41,"exit":"northeast","move":"northeast"},{"to":2,"exit":"go","move":"go boggy path"}]},
  {"id":41,"x":-60,"y":-140,"z":0,"title":"Pejek Bog, A Narrow Path","descriptions":["Warm moist air rises from the bog no matter what the season.  Along with the mist that wafts from the ground, a peculiar scent lingers as well.  The mingled odors of rotting leaves and stagnant water blend with something faintly metallic."],"exits":[{"to":42,"exit":"east","move":"east"},{"to":40,"exit":"southwest","move":"southwest"}]},
  {"id":42,"x":-40,"y":-140,"z":0,"title":"Pejek Bog, A Fork In The Path","descriptions":["Here the path leads in three different directions, each shadowed with a faint mist.  The murky water of the bog is glimpsed through sickly yellow grass and there is no indication if one path is better then the next.","Here the path leads in three different directions, each shadowed with a faint mist.  The murky water of the bog is glimpsed through sickly yellow grass, and there is no indication if one path is better than the next.","Here the path leads in three different directions, each obstructed with a faintly glowing mist.  The murky water of the bog is glimpsed through sickly yellow grass, and there is no indication if one path is better than the next."],"exits":[{"to":43,"exit":"north","move":"north"},{"to":41,"exit":"west","move":"west"},{"to":47,"exit":"northwest","move":"northwest"}]},
  {"id":43,"x":-40,"y":-160,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Pale golden grass grows thick along the ground, surrounding large clay-bottomed puddles.  The water is filled with silt, which makes seeing the bottom of the pools difficult.  Soft rustling sounds arise from the grass as breezes touch it, interspersed with the croaking of what sounds like thousands of frogs."],"exits":[{"to":44,"exit":"north","move":"north"},{"to":42,"exit":"south","move":"south"}],"aliases":["Frogs"]},
  {"id":44,"x":-40,"y":-180,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["A trio of deep parallel grooves interrupts the normal sporadic pattern of grass tufts and puddles.  Something heavy must have been dragged through the swamp at some point in the past.  The grooves look almost like the marks of a giant clawed foot swiping across the bog."],"exits":[{"to":45,"exit":"northeast","move":"northeast"},{"to":43,"exit":"south","move":"south"},{"to":46,"exit":"northwest","move":"northwest"}]},
  {"id":45,"x":-20,"y":-200,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Sickly looking grasses and vile-scented puddles stretch out on all sides as far as the eye can see.  No tree or rise in the land's elevation breaks the monotony.  Sunk almost entirely below the surface of the bog, a discolored stone which may have once been white is just visible amongst the grasses."],"exits":[{"to":44,"exit":"southwest","move":"southwest"},{"to":46,"exit":"west","move":"west"}]},
  {"id":46,"x":-60,"y":-200,"z":0,"title":"Pejek Bog, Beside A Bubbling Pool","descriptions":["Carried on the breeze, the air is scented with a sickly-sweet metallic tinge.  Discolored water thick with reddish-brown clots of mud bubbles up from the bog and flows outward in slow, rippling waves.  The resemblance to a bleeding wound is almost eerie.","Carried on the breeze, a sickly-sweet metallic tinge tinges the air.  Discolored water thick with reddish-brown clots of mud bubbles up from the bog and flows outward in slow, rippling waves.  The resemblance to a bleeding wound is almost eerie."],"exits":[{"to":44,"exit":"southeast","move":"southeast"},{"to":45,"exit":"east","move":"east"}]},
  {"id":47,"x":-80,"y":-180,"z":0,"title":"Pejek Bog, Beside A Foundation","descriptions":["Not far from the path, an oblong depression surrounded by stone is all that remains of someone's cottage.  Coppery water has filled the depression, and a few sickly lilies bloom near the center.  A blackened stump leans toward the water where a tree once shaded the dooryard."],"exits":[{"to":42,"exit":"southeast","move":"southeast"},{"to":48,"exit":"northwest","move":"northwest"}]},
  {"id":48,"x":-100,"y":-200,"z":0,"title":"Pejek Bog, A Twisting Path","descriptions":["The ground surrounding this stretch of path is slightly drier than in many areas of the swamp.  The mist is not as thick here, though the grass that grows here still carries a sickly yellow tinge.  A low stone wall nearby provides a relatively dry place to sit.","The ground surrounding this stretch of path is slightly drier than in many areas of the swamp.  Fortunately, the mist is not as thick here, though the grass that grows still carries a sickly yellow tinge.  A low stone wall nearby provides a relatively dry place to sit."],"exits":[{"to":49,"exit":"northeast","move":"northeast"},{"to":47,"exit":"southeast","move":"southeast"},{"to":50,"exit":"north","move":"north"}]},
  {"id":49,"x":-80,"y":-220,"z":0,"title":"Pejek Bog, A Twisting Path","descriptions":["The slight rise in the level of the land has left the ground here almost entirely dry.  A single pine tree grows a short distance from the path, twisted and bent nearly double, yet apparently still alive and growing.","The slight rise in the level of the land has left the ground here almost entirely dry.  A single pine tree thrives a short distance from the path, twisted and bent nearly double, yet apparently still alive and growing."],"exits":[{"to":48,"exit":"southwest","move":"southwest"},{"to":50,"exit":"northwest","move":"northwest"}]},
  {"id":50,"x":-100,"y":-240,"z":0,"title":"Pejek Bog, Beside A Brook","descriptions":["Rust-colored water flows sluggishly past the end of the nearly overgrown path.  The current is barely enough to move the sediment at the bottom.  If it were not for the steady progress of the occasional blade of grass floating along, it would hardly be noticeable at all.  Occasionally, a soft splashing sound reveals the presence of some small creature jumping into or out of the water, though the tendrils of mist that creep across the surface conceal just what might be lying beneath.","The path fades away to nothing at the water's edge.  Soft splashing sounds indicate where the water flows, likely the movements of tiny bog-dwellers searching for a nighttime meal.  Tendrils of dark mist creep across the surface and, along with the darkness, conceal what might be lying beneath."],"exits":[{"to":49,"exit":"southeast","move":"southeast"},{"to":51,"exit":"climb","move":"climb bank"},{"to":48,"exit":"south","move":"south"}]},
  {"id":51,"x":-120,"y":-260,"z":0,"title":"Pejek Bog, Following A Brook","descriptions":["The sediment on the bottom of this small body of water is reddish-brown, and quite thick.  Any movement of the surface of the water causes waves of an unpleasant metallic odor to rise.","The sediment on the bottom of this small body of water is reddish-brown and quite thick.  Any movement of the surface of the water causes waves of an unpleasant metallic odor to rise."],"exits":[{"to":53,"exit":"northeast","move":"swim northeast"},{"to":52,"exit":"southwest","move":"swim southwest"},{"to":50,"exit":"climb","move":"climb bank"}],"color":"#0000FF","aliases":["Vipers"]},
  {"id":52,"x":-140,"y":-240,"z":0,"title":"Pejek Bog, Following A Brook","descriptions":["Thick as gravy and almost as brown, the current of the brook fades away to almost nothing as the sodden ground absorbs the water, without leaving any clear path for it to follow.","Thick as gravy and almost as brown, the current of the brook fades away to almost nothing as the sodden ground absorbs the water without leaving any clear path for it to follow."],"exits":[{"to":51,"exit":"northeast","move":"swim northeast"},{"to":59,"exit":"go","move":"go western bank"}],"color":"#0000FF"},
  {"id":53,"x":-100,"y":-280,"z":0,"title":"Pejek Bog, Following A Brook","descriptions":["Thick silt lines the creek bed and tints the water reddish.  Beneath the surface, slick stones make walking a dangerous venture.  Occasionally, something moves just beneath the sediment, causing dark clouds to fill the water above it.","Thick silt lines the creek bed and tints the water reddish.  Beneath the surface, slick stones make walking a dangerous venture.  Occasionally, something moves just beneath the sediment, causing dark clouds to fill the water."],"exits":[{"to":54,"exit":"northeast","move":"swim northeast"},{"to":51,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":54,"x":-80,"y":-300,"z":0,"title":"Pejek Bog, A Shallow Pool","descriptions":["Dried grasses line the edges of this pool, drooping over the water without quite touching the surface.  The water is extremely murky, which makes seeing the bottom nearly impossible.  The air carries a constant odor of something rotting, though exactly from what is not apparent."],"exits":[{"to":53,"exit":"southwest","move":"swim southwest"},{"to":55,"exit":"northwest","move":"swim northwest"},{"to":131,"exit":"go","move":"go elaborate dam"}],"color":"#0000FF"},
  {"id":55,"x":-100,"y":-320,"z":0,"title":"Pejek Bog, A Shallow Pool","descriptions":["Tall bushes with spiked branches line the edge of the water, creating a hiding place for tiny creatures that swim or fly between the vicious thorns."],"exits":[{"to":58,"exit":"northeast","move":"swim northeast"},{"to":54,"exit":"southeast","move":"swim southeast"},{"to":56,"exit":"northwest","move":"swim northwest"},{"to":57,"exit":"north","move":"swim north"}],"color":"#0000FF"},
  {"id":56,"x":-120,"y":-340,"z":0,"title":"Pejek Bog, A Shallow Pool","descriptions":["A low stone wall lies partially submerged in the stinking water.  Pale mortar still clings in the spaces between many of the stones.  A line of discoloration shows the high-water mark, nearly a foot above where the waterline now is.","Partially submerged in the stinking water is a low stone wall.  Pale mortar still clings in the spaces between many of the stones.  A line of discoloration shows the high-water mark, nearly a foot above where the waterline is now."],"exits":[{"to":57,"exit":"northeast","move":"swim northeast"},{"to":55,"exit":"southeast","move":"swim southeast"},{"to":58,"exit":"east","move":"swim east"}],"color":"#0000FF"},
  {"id":57,"x":-100,"y":-360,"z":0,"title":"Pejek Bog, A Shallow Pool","descriptions":["Brownish algae swirls along the surface of the water, obscuring everything below it.  Dried grasses rustle softly in every passing breeze.","Brownish algae swirl along the surface of the water, obscuring everything below it.  Dried grasses rustle softly in every passing breeze."],"exits":[{"to":58,"exit":"southeast","move":"swim southeast"},{"to":56,"exit":"southwest","move":"swim southwest"},{"to":55,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":58,"x":-80,"y":-340,"z":0,"title":"Pejek Bog, A Shallow Pool","descriptions":["The water here is unusually clear, revealing the bottom of the pool.  Instead of a muddle of roots and muck, it consists of a neatly ordered pattern of squared-off stones laid end to end.  With the exception of being under water and tilted at an angle, it is almost smooth enough to be a dance floor.","The water here is unusually clear.  Instead of a muddle of roots and muck, it consists of a neatly ordered pattern of squared-off stones laid end to end.  With the exception of being under water and tilted at an angle, it is almost smooth enough to be a dance floor."],"exits":[{"to":55,"exit":"southwest","move":"swim southwest"},{"to":57,"exit":"northwest","move":"swim northwest"},{"to":56,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":59,"x":-160,"y":-220,"z":0,"title":"Pejek Bog, The Deep Muck","descriptions":["Pools of water are so prevalent amongst the clumps of nearly dead grass, it appears swimming might be easier than walking.  Nearby, a small stump lies overturned, the bare roots exposed and vulnerable in the cool, misty air."],"exits":[{"to":60,"exit":"northwest","move":"northwest"},{"to":52,"exit":"go","move":"go bank"}]},
  {"id":60,"x":-180,"y":-240,"z":0,"title":"Pejek Bog, Gate","descriptions":["Standing tall in the muck, a rusted wrought-iron fence rises high above the soaked ground.  Though time has taken its toll on the metal, it is still quite sturdy.","Standing tall in the muck, a rusted wrought-iron fence rises high above the soaked ground.  Though time has taken its toll on the metal, it is still quite sturdy.  The gatekeeper's shack next to the boundary crouches low to the ground like a hunchbacked ogre, with a rickety ladder angled against the side as if for support rather than utility."],"exits":[{"to":59,"exit":"southeast","move":"southeast"},{"to":61,"exit":"south","move":"south"},{"to":62,"exit":"go","move":"go shack"},{"to":135,"exit":"go","move":"go whitewashed gate"}],"aliases":["Unyns"]},
  {"id":61,"x":-180,"y":-220,"z":0,"title":"Pejek Bog, Beside The Fence","descriptions":["Muck and mud pool around the fence, neither side looking in better condition then the other.  Why the fence is here in the first place is anyone's guess.","Muck and mud pool around the fence, neither side looking in better condition than the other.  Why the fence is here in the first place is anyone's guess."],"exits":[{"to":60,"exit":"north","move":"north"}]},
  {"id":62,"x":-180,"y":-260,"z":0,"title":"Pejek Bog, Inside The Gatehouse","descriptions":["Though it is hardly cozy, this little shack provides shelter from the worst of the weather outside.  Simple stick furnishings line the walls, appearing ready to serve as firewood if need be.  There doesn't seem to be anything that shows a trace of the gatekeeper's personality within this small space."],"exits":[{"to":60,"exit":"go","move":"go door"}]},
  {"id":63,"x":40,"y":-200,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["A scattering of pines dot the rolling, grassy landscape.  To the side of the path, a pair of skeletal boulders lie heaped against one another, their foundations settled deeply into the damp earth."],"exits":[{"to":64,"exit":"northeast","move":"northeast"},{"to":6,"exit":"go","move":"go small footpath"}],"color":"#00FFFF"},
  {"id":64,"x":50,"y":-210,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["Loblolly pines clamber down from a hill to the south.  Ramrod-straight and rugged, they lend a touch of somber dark green to all seasons."],"exits":[{"to":65,"exit":"east","move":"east"},{"to":63,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":65,"x":60,"y":-210,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["The path meanders between several pairs of loblolly pines, standing stiffly at attention as though an appointed honor guard.  Small bird nests decorate the high branches of the closest trees."],"exits":[{"to":66,"exit":"northeast","move":"northeast"},{"to":64,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":66,"x":70,"y":-220,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["A rich darkness huddles among the deep places within a grove of concolor firs and loblolly pines.  Sets of yellow eyes stare out, unwinking and without sound."],"exits":[{"to":67,"exit":"north","move":"north"},{"to":65,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":67,"x":70,"y":-240,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["Brown and burnt orange pine needles crunch softly underfoot.  Occasional birdsong floats upon the air, as fresh and pure as morning on winter's first day."],"exits":[{"to":66,"exit":"south","move":"south"},{"to":68,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":68,"x":60,"y":-250,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["Unseen creatures skitter back and forth on pine branches overhead, the only evidence of their passage the occasional, sharp rustle of disturbed leaves."],"exits":[{"to":67,"exit":"southeast","move":"southeast"},{"to":69,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":69,"x":50,"y":-250,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["The press of pine and fir trees squeezes both sides of the path.  Piles of red clay lie in small heaps nearby, apparently the tailings of a small creature's burrow."],"exits":[{"to":68,"exit":"east","move":"east"},{"to":70,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":70,"x":40,"y":-240,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["A blasted sycamore tree lies stretched out alongside the path.  Its blackened trunk is a husk of fungus-encrusted bark, long since rotted out.  Other sycamores dot the landscape, stern and forbidding."],"exits":[{"to":69,"exit":"northeast","move":"northeast"},{"to":71,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":71,"x":30,"y":-240,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["The path swings wide around a glade of tall fir trees.  Small creatures occasionally dart into view to stare from under the trees' protective shadow."],"exits":[{"to":70,"exit":"east","move":"east"},{"to":72,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":72,"x":20,"y":-250,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["Firs and honey pines envelop the landscape.  A towering stillness mantles the woods, with only the push of breeze through treetops filling the silence."],"exits":[{"to":73,"exit":"north","move":"north"},{"to":71,"exit":"southeast","move":"southeast"}],"color":"#00FFFF"},
  {"id":73,"x":20,"y":-260,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["The path tops a small promentory crest, providing an excellent view of the surrounding pine woods.  Elegant and sturdy, they form a permanant green cloak across this portion of the foothills."],"exits":[{"to":74,"exit":"northeast","move":"northeast"},{"to":72,"exit":"south","move":"south"}],"color":"#00FFFF"},
  {"id":74,"x":30,"y":-270,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["A storm has partially desolated this woodland area, leaving some trees standing, and easily uprooting others as though with a slap of giant hand.  Fallen logs lie decorated with plate-sized shaggy mushrooms.  They gleam luridly in sapphire and gold, offsetting the uniformity of grey tree bark and dark green needles."],"exits":[{"to":75,"exit":"east","move":"east"},{"to":73,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":75,"x":40,"y":-270,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["A giant fir lies toppled across the path, surrounded by a coterie of pine saplings. The tree's roots hang high like frozen tentacles twenty feet off the ground, caked with large stones and rubbish."],"exits":[{"to":76,"exit":"northeast","move":"northeast"},{"to":74,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":76,"x":50,"y":-280,"z":0,"title":"Northeast Wilds, Piedmont","descriptions":["A blasted patriarch of a sycamore stands alone in a burned-out field of charcoal and ashes.  The sycamore's black, leafless branches seem to grasp at the air, clattering against one another with every gust of wind."],"exits":[{"to":75,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":77,"x":40,"y":-160,"z":0,"title":"Riverhaven, Ranger's Guild","descriptions":["Finely crafted torch lamps stand in each corner of this large tent.  They, along with the other furniture appear oddly out of place in this rustic setting.  Carpets, two and three deep, cover the dirt floor.  Journeywoman Ievia stands before you, smiling broadly."],"exits":[{"to":4,"exit":"out","move":"out"},{"to":78,"exit":"go","move":"go arch"}],"color":"#FF8000","aliases":["GL Ranger","Ievia","RS Ranger"]},
  {"id":78,"x":20,"y":-160,"z":0,"title":"Riverhaven, Ranger's Guild","descriptions":["Ferns, small trees and plants have been used to build a living wall around this area set aside just for Rangers and their guests."],"exits":[{"to":77,"exit":"go","move":"go arch"}]},
  {"id":79,"x":80,"y":-60,"z":0,"title":"Faldesu River, North Bank","descriptions":["The Riverhaven town wall stretches out into the waters a short distance upriver from a crumbling stone bridge.  An orange glow rises above the dark wall from the torches and lamps of the town along with the low buzz of voices muffled by the night.  Several small fishing boats bob in the sheltered part of the river near the town wall, silently awaiting their masters.","The Riverhaven town wall stretches out into the waters a short distance upriver from a crumbling stone bridge.  The sounds of pleading beggars and creaking merchant wagons grate against the peaceful sounds of the rolling river.  Small fishing boats bob in the sheltered cove formed by the town wall, their weather-wary owners busy on the bank mending nets and patching sail."],"exits":[{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"south","move":"south"},{"to":0,"exit":"southwest","move":"southwest"},{"to":2,"exit":"climb","move":"climb stone bridge"}],"aliases":["Faldesu River"],"linksTo":"Map14c_Faldesu.xml"},
  {"id":80,"x":520,"y":-40,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":39,"exit":"northeast","move":"northeast","hidden":true},{"to":82,"exit":"southeast","move":"southeast"},{"to":83,"exit":"southwest","move":"southwest","hidden":true},{"to":81,"exit":"northwest","move":"northwest"}]},
  {"id":81,"x":500,"y":-60,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":108,"exit":"northeast","move":"northeast","hidden":true},{"to":80,"exit":"southeast","move":"southeast"},{"to":110,"exit":"southwest","move":"southwest","hidden":true},{"to":39,"exit":"northwest","move":"northwest"}]},
  {"id":82,"x":540,"y":-20,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":81,"exit":"northeast","move":"northeast","hidden":true},{"to":83,"exit":"southeast","move":"southeast"},{"to":109,"exit":"southwest","move":"southwest","hidden":true},{"to":80,"exit":"northwest","move":"northwest"}]},
  {"id":83,"x":560,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":80,"exit":"northeast","move":"northeast","hidden":true},{"to":84,"exit":"east","move":"east"},{"to":111,"exit":"southeast","move":"southeast"},{"to":108,"exit":"southwest","move":"southwest","hidden":true},{"to":82,"exit":"northwest","move":"northwest"}]},
  {"id":84,"x":580,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":124,"exit":"north","move":"north","hidden":true},{"to":112,"exit":"east","move":"east"},{"to":115,"exit":"south","move":"south","hidden":true},{"to":83,"exit":"west","move":"west"}]},
  {"id":85,"x":200,"y":-40,"z":0,"title":"Zaulfung, Swamp","descriptions":["All here is mire and misery.  It is difficult to tell where the pond ends and the land begins, for walking in either produces the same squishy result.  The disquieting squelch of some untold creature stalking through the swamp makes you long for drier ground."],"exits":[{"to":86,"exit":"east","move":"east"}]},
  {"id":86,"x":220,"y":-40,"z":0,"title":"Zaulfung, Swamp","descriptions":["While most swamps are home to hundreds of species of plants, birds, and reptiles, this one is lacking in vitality and variety.  One could paint this swamp in three colors: grey, grey-brown, and grey-green. Even the birdsong is monotonous and melancholy."],"exits":[{"to":87,"exit":"east","move":"east"},{"to":85,"exit":"west","move":"west"}]},
  {"id":87,"x":300,"y":-40,"z":0,"title":"Zaulfung, Swamp","descriptions":["An abundance of standing water makes this a fine and fitting home for mosquitoes and weeds, but little else.  The ground to the west is higher and drier, though a double row of Vilt stalks to the north indicates a causeway between two ponds."],"exits":[{"to":88,"exit":"north","move":"north"},{"to":86,"exit":"west","move":"west"}]},
  {"id":88,"x":300,"y":-60,"z":0,"title":"Zaulfung, Swamp","descriptions":["This would be a land bridge between two ponds, if only it weren't half a foot underwater.  It doesn't seem to be a natural formation, though why any builder would bother in this reeking morass is anyone's guess.  The causeway, demarcated by dead Vilt stalks, rises slightly as it progresses to the northeast."],"exits":[{"to":89,"exit":"northeast","move":"northeast"},{"to":87,"exit":"south","move":"south"}]},
  {"id":89,"x":320,"y":-100,"z":0,"title":"Zaulfung, Swamp","descriptions":["Mud, your constant companion, squelches in your boots, is caked on your clothing and matted in your hair.  The only escape from it is to wash it off with fetid pond water, an unpalatable prospect.  The mud continues to the north but seems less pervasive to the northwest, while the southwest route is flooded but passable."],"exits":[{"to":90,"exit":"north","move":"north"},{"to":88,"exit":"southwest","move":"southwest"},{"to":91,"exit":"northwest","move":"northwest"},{"to":96,"exit":"go","move":"go curving path"}]},
  {"id":90,"x":320,"y":-120,"z":0,"title":"Zaulfung, Swamp","descriptions":["Stinking mud and sullen water surround this dismal point on three sides.  A fish leaps out of what looked like a mere mud puddle, the slap of displaced water echoing heavily.  To the northwest, across a corner of the pond, the land rises triumpantly from the morass only to be crowded by dense brush."],"exits":[{"to":89,"exit":"south","move":"south"},{"to":91,"exit":"west","move":"west"}]},
  {"id":91,"x":300,"y":-120,"z":0,"title":"Zaulfung, Swamp","descriptions":["An unnerving wail breaks out suddenly.  It takes a moment to realize it's not a banshee, just a sudden gust of wind, colder than it should be.  This whole area feels quite chill, as if something had leached out all the warmth."],"exits":[{"to":92,"exit":"north","move":"north"},{"to":90,"exit":"east","move":"east"},{"to":89,"exit":"southeast","move":"southeast"},{"to":93,"exit":"go","move":"go brush"}],"aliases":["Spiny Dyrachis"]},
  {"id":92,"x":300,"y":-160,"z":0,"title":"Zaulfung, Swamp","descriptions":["This narrow patch of dry ground has the appearance of gradually losing a battle on two fronts.  It is sinking slowly into the encroaching bog, while a conquering army of briars marches inch by inch, year by year, to close off the remaining space.  There are no apparent trails through the brush."],"exits":[{"to":91,"exit":"south","move":"south"},{"to":36,"exit":"go","move":"go thick brush"}]},
  {"id":93,"x":220,"y":-140,"z":0,"title":"Zaulfung, Dense Thicket","descriptions":["Tall brittle bushes, sickly-grey and leafless, intertwine with an overgrowth of savage thorn-vine, leaving little room for unencumbered passage.  Bent and broken branches, heavily laden with old insect cocoons, arch and weave into a thick canopy above, effectively blocking out light."],"exits":[{"to":94,"exit":"south","move":"south"},{"to":91,"exit":"out","move":"out"}]},
  {"id":94,"x":220,"y":-120,"z":0,"title":"Zaulfung, Dense Thicket","descriptions":["A thousand thorns rip at your clothing and tear at your flesh.  A family of spiders has created a bower of glistening, sticky webs strung between the branches and thorns of this dense thicket.  The dull stench of rot and decay rises from the molding and mildewed leaves beneath your feet."],"exits":[{"to":93,"exit":"north","move":"north"},{"to":95,"exit":"south","move":"south"}]},
  {"id":95,"x":220,"y":-100,"z":0,"title":"Zaulfung, Thicket Clearing","descriptions":["The brittle fingers of greyed and dying brush reach toward you imploringly from all sides.  A ring of broken and yellow bones forms a formidable barrier around a gaping hole in the earth.  A faint rustling interspersed with long periods of silence warns you of foreign eyes watching, and waiting."],"exits":[{"to":94,"exit":"north","move":"north"}],"color":"#A6A3D9","aliases":["Shrine2-03","Urrem'tier","Thicket Clearing"]},
  {"id":96,"x":360,"y":-40,"z":0,"title":"Zaulfung, Swamp","descriptions":[],"exits":[{"to":97,"exit":"southeast","move":"southeast"},{"to":89,"exit":"go","move":"go path"},{"to":98,"exit":"south","move":"south"},{"to":0,"exit":"southwest","move":"southwest"},{"to":0,"exit":"north","move":"north"},{"to":0,"exit":"northeast","move":"northeast"},{"to":0,"exit":"west","move":"west"}]},
  {"id":97,"x":380,"y":-20,"z":0,"title":"Zaulfung, Swamp","descriptions":[],"exits":[{"to":98,"exit":"west","move":"west"},{"to":99,"exit":"north","move":"north"},{"to":96,"exit":"northwest","move":"northwest"},{"to":0,"exit":"northeast","move":"northeast"},{"to":0,"exit":"south","move":"south"},{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"southwest","move":"southwest"},{"to":318,"exit":"climb","move":"climb sickly tree"}]},
  {"id":98,"x":360,"y":-20,"z":0,"title":"Zaulfung, Swamp","descriptions":[],"exits":[{"to":96,"exit":"north","move":"north"},{"to":97,"exit":"east","move":"east"},{"to":99,"exit":"northeast","move":"northeast"},{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"south","move":"south"},{"to":0,"exit":"southwest","move":"southwest"},{"to":0,"exit":"west","move":"west"},{"to":0,"exit":"northwest","move":"northwest"}]},
  {"id":99,"x":380,"y":-40,"z":0,"title":"Zaulfung, Swamp","descriptions":[],"exits":[{"to":98,"exit":"southwest","move":"southwest"},{"to":97,"exit":"south","move":"south"},{"to":96,"exit":"west","move":"west"},{"to":0,"exit":"north","move":"north"},{"to":0,"exit":"northeast","move":"northeast"},{"to":0,"exit":"east","move":"east"},{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"northwest","move":"northwest"}]},
  {"id":101,"x":80,"y":-160,"z":0,"title":"Riverhaven Road, Blackthorn Grove","descriptions":["A dirt trail winds steadily through the lightly-wooded area below Riverhaven's cemetery.  Tall grasses, overgrown and going to seed, sway and bend in the slight breeze, as if bowing to anyone or anything that makes its way along the path.  "],"exits":[{"to":102,"exit":"east","move":"east"},{"to":5,"exit":"up","move":"up"}]},
  {"id":102,"x":100,"y":-160,"z":0,"title":"Riverhaven Road, Blackthorn Grove","descriptions":["Bright pink flowers dot the tall grasses which grow along the side of the trail.  Butterflies flutter from hedge to hedge and disappear with the trail between the trunks of giant blackthorn trees to the east."],"exits":[{"to":101,"exit":"west","move":"west"},{"to":103,"exit":"go","move":"go blackthorn trees"}]},
  {"id":103,"x":120,"y":-160,"z":0,"title":"Riverhaven Road, Blackthorn Grove","descriptions":["Heavily shaded by the tall canopy of blackthorn trees, the grove is eerily quiet.  Though scant grasses mark the boundary of the trees, the remainder of the area is paved with tiny chips of white granite.  In the center of the grove stands a small mausoleum, with marble pillars flanking great iron doors."],"exits":[{"to":102,"exit":"west","move":"west"},{"to":104,"exit":"go","move":"go small mausoleum"}]},
  {"id":104,"x":120,"y":-140,"z":0,"title":"Blackthorn Grove, Mausoleum","descriptions":["Rows of carved columns supporting a vaulted ceiling make up this compact yet navigable main corridor.  Quartz steps lead from the entryway to the floor, and shallow alcoves stand off to either side of the entrance.  Before you, at the opposite end of an ornate stone coffin, stands a grand marble font beyond a wrought-iron gate.  The room exudes a comfortable chill."],"exits":[{"to":103,"exit":"out","move":"out"},{"to":105,"exit":"go","move":"go west alcove"},{"to":106,"exit":"go","move":"go east alcove"},{"to":107,"exit":"go","move":"go wrought-iron gate"}]},
  {"id":105,"x":100,"y":-140,"z":0,"title":"Mausoleum, West Alcove","descriptions":["Hanging between three gleaming torches set high on the wall is a pair of thick, dark tapestries which drape from ceiling to floor.  Two tiny sarcophagi lie in state in the middle of the alcove, each crowned with a dried floral arrangement."],"exits":[{"to":104,"exit":"out","move":"out"}]},
  {"id":106,"x":140,"y":-140,"z":0,"title":"Mausoleum, East Alcove","descriptions":["Three etched glass portraits set in high-arched windows reflect the small amount of light provided by burning torcheres.  As light passes over each portrait, the images dance with a kind of surreal, prismatic glow."],"exits":[{"to":104,"exit":"out","move":"out"}]},
  {"id":107,"x":120,"y":-120,"z":0,"title":"Mausoleum, Alcove of the Font","descriptions":["Quartz steps lead from the floor of the mausoleum to the alcove in which sits this grand marble font.  The font once housed a perpetual flame, but is now dormant.  A large piece of glass has been meticulously fitted to it as a cover.  To either side stand identical marble altars."],"exits":[{"to":104,"exit":"down","move":"down"}],"color":"#00FF00"},
  {"id":108,"x":460,"y":-120,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":83,"exit":"northeast","move":"northeast","hidden":true},{"to":39,"exit":"southeast","move":"southeast"},{"to":82,"exit":"southwest","move":"southwest","hidden":true},{"to":109,"exit":"northwest","move":"northwest"}]},
  {"id":109,"x":440,"y":-140,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":82,"exit":"northeast","move":"northeast","hidden":true},{"to":108,"exit":"southeast","move":"southeast"},{"to":39,"exit":"southwest","move":"southwest","hidden":true},{"to":110,"exit":"northwest","move":"northwest"}]},
  {"id":110,"x":420,"y":-160,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":81,"exit":"northeast","move":"northeast","hidden":true},{"to":109,"exit":"southeast","move":"southeast"},{"to":80,"exit":"southwest","move":"southwest","hidden":true},{"to":111,"exit":"northwest","move":"northwest"}]},
  {"id":111,"x":400,"y":-180,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":39,"exit":"northeast","move":"northeast","hidden":true},{"to":110,"exit":"southeast","move":"southeast"},{"to":81,"exit":"southwest","move":"southwest","hidden":true},{"to":83,"exit":"northwest","move":"northwest"}]},
  {"id":112,"x":600,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":125,"exit":"north","move":"north","hidden":true},{"to":113,"exit":"east","move":"east"},{"to":116,"exit":"south","move":"south","hidden":true},{"to":84,"exit":"west","move":"west"}]},
  {"id":113,"x":620,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":126,"exit":"north","move":"north","hidden":true},{"to":114,"exit":"east","move":"east"},{"to":117,"exit":"south","move":"south","hidden":true},{"to":112,"exit":"west","move":"west"}]},
  {"id":114,"x":640,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":125,"exit":"north","move":"north","hidden":true},{"to":115,"exit":"east","move":"east"},{"to":118,"exit":"south","move":"south","hidden":true},{"to":113,"exit":"west","move":"west"}]},
  {"id":115,"x":660,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":84,"exit":"north","move":"north","hidden":true},{"to":116,"exit":"east","move":"east"},{"to":119,"exit":"south","move":"south","hidden":true},{"to":114,"exit":"west","move":"west"}]},
  {"id":116,"x":680,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":112,"exit":"north","move":"north","hidden":true},{"to":117,"exit":"east","move":"east"},{"to":120,"exit":"south","move":"south","hidden":true},{"to":115,"exit":"west","move":"west"}]},
  {"id":117,"x":700,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":113,"exit":"north","move":"north","hidden":true},{"to":118,"exit":"east","move":"east"},{"to":121,"exit":"south","move":"south","hidden":true},{"to":116,"exit":"west","move":"west"}]},
  {"id":118,"x":720,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":114,"exit":"north","move":"north","hidden":true},{"to":119,"exit":"east","move":"east"},{"to":122,"exit":"south","move":"south","hidden":true},{"to":117,"exit":"west","move":"west"}]},
  {"id":119,"x":740,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":115,"exit":"north","move":"north","hidden":true},{"to":120,"exit":"east","move":"east"},{"to":123,"exit":"south","move":"south","hidden":true},{"to":118,"exit":"west","move":"west"}]},
  {"id":120,"x":760,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":116,"exit":"north","move":"north","hidden":true},{"to":121,"exit":"east","move":"east"},{"to":124,"exit":"south","move":"south","hidden":true},{"to":119,"exit":"west","move":"west"}]},
  {"id":121,"x":780,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":117,"exit":"north","move":"north","hidden":true},{"to":122,"exit":"east","move":"east"},{"to":125,"exit":"south","move":"south","hidden":true},{"to":120,"exit":"west","move":"west"}]},
  {"id":122,"x":800,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":118,"exit":"north","move":"north","hidden":true},{"to":123,"exit":"east","move":"east"},{"to":126,"exit":"south","move":"south","hidden":true},{"to":121,"exit":"west","move":"west"}]},
  {"id":123,"x":820,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":119,"exit":"north","move":"north","hidden":true},{"to":124,"exit":"east","move":"east"},{"to":114,"exit":"south","move":"south","hidden":true},{"to":122,"exit":"west","move":"west"}]},
  {"id":124,"x":860,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":120,"exit":"north","move":"north","hidden":true},{"to":125,"exit":"east","move":"east"},{"to":84,"exit":"south","move":"south","hidden":true},{"to":123,"exit":"west","move":"west"}]},
  {"id":125,"x":880,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":121,"exit":"north","move":"north","hidden":true},{"to":126,"exit":"east","move":"east"},{"to":112,"exit":"south","move":"south","hidden":true},{"to":124,"exit":"west","move":"west"}]},
  {"id":126,"x":900,"y":0,"z":0,"title":"Zaulfung, Trackless Swamp","descriptions":["Knee-deep brackish water conceals the treacherous slippery mud beneath."],"exits":[{"to":122,"exit":"north","move":"north","hidden":true},{"to":113,"exit":"south","move":"south","hidden":true},{"to":125,"exit":"west","move":"west"}]},
  {"id":127,"x":80,"y":-120,"z":0,"title":"Order of the Dragon Shield, Grounds","descriptions":["Sprawling trees dot the vast, well-manicured grounds.  Along the white gravel path that winds its way to the Order house's grand double doors, beds of seasonal blooms encircle a stately central fountain.  In the distance, a picket fence borders off a small garden, while the opposing lawn bears a hedged area large enough to host a variety of functions.","Sprawling trees dot the vast, well-manicured grounds, lit only by the soft candlelight from the nearby windows.  Along the white gravel path that winds its way through the darkness to the Order house's grand double doors, a hulking mass is poised amid a stately central fountain, encircled by a bedding of seasonal blooms that sway and taunt from their shadowy cover.  In the distance, a fence borders off a small garden, while the opposing lawn bears a hedged area large enough to host a variety of functions."],"exits":[{"to":3,"exit":"go","move":"go iron gates"},{"to":128,"exit":"go","move":"go double doors"}],"aliases":["Order of the Dragon Shield","ODS"]},
  {"id":128,"x":100,"y":-100,"z":0,"title":"Order of the Dragon Shield, Lobby","descriptions":["Rich tapestries hung upon the off-white walls offset the dark marbled floors of the spacious lobby.  Dominating the room overhead is a stained-glass dome which complements the broad, arched windows that overlook the grounds.  Ornate candelabras cast a soft glow over the glass display case resting against a far wall and the elegant sofas provided for relaxation.  Tucked into a corner near a sweeping staircase, a comfortable chair sits near a small oaken table, cordoned off from the rest of the area."],"exits":[{"to":129,"exit":"east","move":"east"},{"to":127,"exit":"go","move":"go double doors"},{"to":130,"exit":"go","move":"go darkened archway"}]},
  {"id":129,"x":120,"y":-100,"z":0,"title":"Order of the Dragon Shield, Grand Banquet Hall","descriptions":["Golden chandeliers hang from ornate medallions at measured intervals along the grand vaulted ceiling, bathing the room in a soft candlelit glow.  Satin brocade drapes swept back with clusters of fresh flowers, cascade elegantly down the beamed dragonwood walls along the edges of the polished hardwood dance floor.  Comfortable couches, each accompanied by a small oval table, dot the corners of the large room while soft music drifts from behind a silk screen."],"exits":[{"to":128,"exit":"west","move":"west"}],"aliases":["Grand Banquet Hall","Banquet Hall"]},
  {"id":130,"x":80,"y":-100,"z":0,"title":"Order of the Dragon Shield, The Tankard","descriptions":["Thick oak beams frame the rough, white plastered walls which display a variety of weapons and mounted beast heads, while a gleaming suit of armor stands sentinel beside a nearby archway.  Wooden trestle tables, surrounded by banded barrel chairs, overlook the grounds through a grand arched window and provide ample seating for those visiting the inviting pub to enjoy a refreshing drink and hearty meal.  Redolent scents from the long bar mingle with the faint smell of fire-roasted fare that wafts through the air from the grand river rock fireplace."],"exits":[{"to":128,"exit":"go","move":"go archway"}],"aliases":["Tankard"]},
  {"id":131,"x":-40,"y":-320,"z":0,"title":"Pejek Bog, Stagnant Pool","descriptions":["Held in place by an elaborate dam of twigs, debris and larger lengths of timber, the water has stagnated and allowed dark green mosses to flourish amid the reeds and other water grasses.  Buzzing swarms of winged insects compete for territory in the air with little care given to their avian predators.  A fist-sized patch of red fungus clings to the decaying remnants of a tree's trunk."],"exits":[{"to":132,"exit":"northeast","move":"northeast"},{"to":133,"exit":"east","move":"east"},{"to":134,"exit":"southeast","move":"southeast"},{"to":54,"exit":"go","move":"go elaborate dam"}],"color":"#0000FF"},
  {"id":132,"x":-20,"y":-340,"z":0,"title":"Pejek Bog, Stagnant Pool","descriptions":["The muddy shore, such as it is, hosts thicker patches of grass and wild growths of various vines that have felled many of the aged trees.  Hoof and paw prints from countless members of the local wildlife overlap one another to create a dizzying array of maze-like trails, each preserved by the stillness of the bog's water."],"exits":[{"to":133,"exit":"southeast","move":"southeast"},{"to":134,"exit":"south","move":"south"},{"to":131,"exit":"southwest","move":"southwest"}],"color":"#0000FF"},
  {"id":133,"x":0,"y":-320,"z":0,"title":"Pejek Bog, Stagnant Pool","descriptions":["The sickly sweet stench of decay teases at the edge of the stagnated water's unpleasant odor.  A stillness of sound and life is only occasionally breached by a swarm of buzzing insects temporarily disturbed by a stealthy attacker."],"exits":[{"to":134,"exit":"southwest","move":"southwest"},{"to":131,"exit":"west","move":"west"},{"to":132,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":134,"x":-20,"y":-300,"z":0,"title":"Pejek Bog, Stagnant Pool","descriptions":["A large clumping of red clay juts from the still water.  Rust-colored tendrils snake through the stagnant pool, often following barely concealed footprints of man and beast alike that lead away from the mound.  Resembling a sponge, the porous surface is densely pitted with small holes and a low, steady buzz comes from within."],"exits":[{"to":132,"exit":"north","move":"north"},{"to":133,"exit":"northeast","move":"northeast"},{"to":131,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":135,"x":-200,"y":-260,"z":0,"title":"Pejek Bog, Gate","descriptions":["A pair of large tree stumps sits beside the fence, which frames a wide expanse of mud that may once have been a road.  The broken trees' remaining branches reach toward the sky, bereft of leaves or any other signs of life."],"exits":[{"to":136,"exit":"south","move":"south"},{"to":140,"exit":"southwest","move":"southwest"},{"to":139,"exit":"west","move":"west"},{"to":60,"exit":"go","move":"go whitewashed gate"}]},
  {"id":136,"x":-200,"y":-240,"z":0,"title":"Pejek Bog, Beside The Fence","descriptions":["The fence extends as far as the eye can see to the north and to the south.  The land visible through the railings doesn't really seem any different from what is on this side."],"exits":[{"to":135,"exit":"north","move":"north"},{"to":137,"exit":"south","move":"south"},{"to":140,"exit":"west","move":"west"}]},
  {"id":137,"x":-200,"y":-220,"z":0,"title":"Pejek Bog, Beside The Fence","descriptions":["The fence shows years of use but is still sturdy in its stature.  Grasses along the fence line are stained a reddish-brown, perhaps from the rust-colored muck that also calls this area home."],"exits":[{"to":136,"exit":"north","move":"north"},{"to":138,"exit":"south","move":"south"},{"to":141,"exit":"southwest","move":"southwest"},{"to":140,"exit":"northwest","move":"northwest"}]},
  {"id":138,"x":-200,"y":-200,"z":0,"title":"Pejek Bog, Beside The Fence","descriptions":["Rusty flakes peel away from the fence poles and collect in the spindly grasses and mossy conglomerations.  Pudding-like dollops of mud settle on the nearby peat like cowpats in a bleak pasture."],"exits":[{"to":137,"exit":"north","move":"north"},{"to":141,"exit":"west","move":"west"}]},
  {"id":139,"x":-220,"y":-260,"z":0,"title":"Pejek Bog, A Muddy Thoroughfare","descriptions":["This broad expanse of mud is edged with puddles and clumps of the ever-present yellowed grass that grows throughout the bog.  The view to either side is more of the same, with strands of mist floating low across the ground in patches."],"exits":[{"to":135,"exit":"east","move":"east"},{"to":140,"exit":"south","move":"south"},{"to":142,"exit":"west","move":"west"}]},
  {"id":140,"x":-220,"y":-240,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Grey-green algae coats the water in a thick, goopy layer above inches of murky, likely diseased liquid.  Only the most intrepid swamp grass grows visibly aside from the primitive plant life.  The bog's mobile inhabitants must wade through an unsettling amount of decomposing organisms in order to reach desired destinations."],"exits":[{"to":139,"exit":"north","move":"north"},{"to":135,"exit":"northeast","move":"northeast"},{"to":136,"exit":"east","move":"east"},{"to":137,"exit":"southeast","move":"southeast"}]},
  {"id":141,"x":-220,"y":-200,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["A single marble pillar rests on the ground in three pieces.  The stone is thicker around than any two Gor'Togs standing face to face.  Simple lines were carved into sides at some point in the past, but now the ornamentation is all discolored and stained by the muck."],"exits":[{"to":137,"exit":"northeast","move":"northeast"},{"to":138,"exit":"east","move":"east"},{"to":163,"exit":"west","move":"west"}]},
  {"id":142,"x":-240,"y":-260,"z":0,"title":"Pejek Bog, A Muddy Thoroughfare","descriptions":["A large tree leans drunkenly by the edge of the path near a blackened stump.  Its form can easily be made out because of the faintly luminescent lichen which covers it.  It rises eerily from the mist, pointing off toward the east."],"exits":[{"to":143,"exit":"north","move":"north"},{"to":139,"exit":"east","move":"east"},{"to":148,"exit":"west","move":"west"},{"to":149,"exit":"northwest","move":"northwest"}]},
  {"id":143,"x":-240,"y":-280,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Just north of a large blackened stump, the swamp quickly regains its claim on the land.  The muddy ground carries the impressions of various footprints from travelers who have passed on by this muck-ridden expanse."],"exits":[{"to":144,"exit":"northeast","move":"northeast"},{"to":142,"exit":"south","move":"south"},{"to":148,"exit":"southwest","move":"southwest"},{"to":149,"exit":"west","move":"west"}]},
  {"id":144,"x":-220,"y":-300,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["A badly stained skeleton of some large creature rests half-buried in the muck adjacent to a small stone pillar.  The skull itself is gone, making identification difficult, but the shape of the bones that remain resemble those from a yak or a large mule.  The orange tint to the bones attests to time spent beneath the water and mud."],"exits":[{"to":145,"exit":"north","move":"north"},{"to":143,"exit":"southwest","move":"southwest"},{"to":147,"exit":"northwest","move":"northwest"}]},
  {"id":145,"x":-220,"y":-320,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Rustling noises from breezes through the dried grasses create an almost soothing undertone of sound.  The scent rising from the muck is strong enough to keep even a tired hunter awake."],"exits":[{"to":146,"exit":"north","move":"north"},{"to":144,"exit":"south","move":"south"},{"to":147,"exit":"west","move":"west"}]},
  {"id":146,"x":-220,"y":-340,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["A wide expanse of reddish-brown water stretches off to the north.  The liquid is warm enough to steam in the normally cool air of the swamp.  Slime-covered stones extend a short way into the water, the row carefully stacked together to form what must have once been a pleasant spot for fishing."],"exits":[{"to":145,"exit":"south","move":"south"},{"to":147,"exit":"southwest","move":"southwest"}]},
  {"id":147,"x":-240,"y":-320,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Each footfall through the mire creates uncouth slopping noises from the abundance of mud and muck below the turbid water.  Peat tannins tinge the liquid a characteristic brown, incidentally a color that matches nearly every plant and alga in the vicinity."],"exits":[{"to":146,"exit":"northeast","move":"northeast"},{"to":145,"exit":"east","move":"east"},{"to":144,"exit":"southeast","move":"southeast"}]},
  {"id":148,"x":-260,"y":-260,"z":0,"title":"Pejek Bog, A Muddy Thoroughfare","descriptions":["Yellowish grass encroaches on the edges of the sodden roadway.  The mud along the thoroughfare matches the surrounding clumps of brown weeds, making it difficult to tell just where the bog begins and the roadway ends.  Numerous footprints in the muck show where people and creatures have slogged through."],"exits":[{"to":149,"exit":"north","move":"north"},{"to":143,"exit":"northeast","move":"northeast"},{"to":142,"exit":"east","move":"east"},{"to":150,"exit":"west","move":"west"}]},
  {"id":149,"x":-260,"y":-280,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Broken branches jut from the quagmire at all angles, disturbingly resembling fingers worming through the shallows attempting to scratch and prod passersby.  Filthy moss creeps up the bark of rotting stumps and felled logs from the murky liquid below."],"exits":[{"to":143,"exit":"east","move":"east"},{"to":142,"exit":"southeast","move":"southeast"},{"to":148,"exit":"south","move":"south"}]},
  {"id":150,"x":-280,"y":-260,"z":0,"title":"Pejek Bog, Stairs To Nowhere","descriptions":["A wide flight of marble stairs rests at the end of the thoroughfare.  Consisting of three broad slabs of pale yellowish marble, they are intricately carved across the front of each riser.  Time has worn away some of the detail, but various aspects of the gods can still be made out in places.  There is nothing else around to explain why the steps are here or to what they once led."],"exits":[{"to":148,"exit":"east","move":"east"},{"to":158,"exit":"south","move":"south"},{"to":151,"exit":"northwest","move":"northwest"}]},
  {"id":151,"x":-300,"y":-280,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Every breeze creates soft rustling noises from the dried grasses which grow in clumps among the puddles.  A faint metallic odor wafts up from the mud."],"exits":[{"to":152,"exit":"north","move":"north"},{"to":150,"exit":"southeast","move":"southeast"}]},
  {"id":152,"x":-300,"y":-300,"z":0,"title":"Pejek Bog, A Green Patch","descriptions":["A subtle variation in the ground's angle has caused all of the water to drain from a large circular patch of land.  The grass that grows everywhere in the bog is not present within this drier area.  Instead, an intensely green moss covers the ground thickly, leaving no spot bare."],"exits":[{"to":154,"exit":"north","move":"north"},{"to":153,"exit":"northeast","move":"northeast"},{"to":151,"exit":"south","move":"south"},{"to":155,"exit":"northwest","move":"northwest"}]},
  {"id":153,"x":-280,"y":-320,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Reddish-brown mud is dotted with clumps of dead and dying grass.  The dripping of water is a constant undertone to the soft rustle of the grasses in the breeze.  Every now and then, something larger splashes into a nearby puddle, creating a diversion from the otherwise lulling palette of sounds."],"exits":[{"to":152,"exit":"southwest","move":"southwest"},{"to":155,"exit":"west","move":"west"},{"to":154,"exit":"northwest","move":"northwest"}]},
  {"id":154,"x":-300,"y":-340,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Tendrils of mist swirl over the ground's surface like pale snakes, following every current of the passing air.  The fog seems to muffle the normal sounds of the bog, leaving this unremarkable section of swamp feeling very isolated."],"exits":[{"to":156,"exit":"north","move":"north"},{"to":157,"exit":"east","move":"east"},{"to":153,"exit":"southeast","move":"southeast"},{"to":152,"exit":"south","move":"south"},{"to":155,"exit":"southwest","move":"southwest"}]},
  {"id":155,"x":-320,"y":-320,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Submerged in the muck, a huge monolith of black granite looms overhead.  It is surrounded by a wide channel of water that looks quite unhealthy.  Bubbles rise to the surface constantly, and the stench of dead and rotting flesh arising from the liquid is almost unbearable."],"exits":[{"to":154,"exit":"northeast","move":"northeast"},{"to":153,"exit":"east","move":"east"},{"to":152,"exit":"southeast","move":"southeast"}]},
  {"id":156,"x":-300,"y":-360,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Sunken almost below the water level, the muck that passes for dirt in this part of the swamp is broken only by the occasional small hummock of oddly browned grasses."],"exits":[{"to":157,"exit":"southeast","move":"southeast"},{"to":154,"exit":"south","move":"south"}]},
  {"id":157,"x":-280,"y":-340,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["A small hillock of almost-dried grasses rises above the reddish-brown water.  Wisps of steam waft about on almost imperceptible breezes, carrying the scent of brackish water mingled with rotting vegetation.  Night darkens everything but a few stones covered in luminescent light-green lichen."],"exits":[{"to":154,"exit":"west","move":"west"},{"to":156,"exit":"northwest","move":"northwest"}]},
  {"id":158,"x":-280,"y":-240,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["The ground here is quite muddy with very little plant life left standing.  There are footprints in the mire, ranging from the delicate crosshatch of water birds to deep ruts where something large and heavy slid in the muck."],"exits":[{"to":150,"exit":"north","move":"north"},{"to":159,"exit":"south","move":"south"},{"to":160,"exit":"southwest","move":"southwest"}]},
  {"id":159,"x":-280,"y":-220,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Darkness shadows the dried grasses that stretch far into the distance.  Splotches of water and clumps of grass leave the vast expanse of the bog with the appearance of a marshy wasteland."],"exits":[{"to":158,"exit":"north","move":"north"},{"to":161,"exit":"southwest","move":"southwest"},{"to":160,"exit":"west","move":"west"}]},
  {"id":160,"x":-300,"y":-220,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Surrounded by the dried brown grasses and reddish-brown puddles, a single rosebush grows.  The dusky green of the leaves and pale pink of the blooms stand in contrast to the normal palette of bog colors.  It appears to be the only such plant around, leaving the mystery of its existence an unanswered question."],"exits":[{"to":158,"exit":"northeast","move":"northeast"},{"to":159,"exit":"east","move":"east"},{"to":161,"exit":"south","move":"south"}]},
  {"id":161,"x":-300,"y":-200,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["A large square section of ground is oddly blackened, as if it had been burned.  The air carries a faint scent of smoke, though everything is wet and nothing appears to have been on fire recently."],"exits":[{"to":160,"exit":"north","move":"north"},{"to":159,"exit":"northeast","move":"northeast"},{"to":162,"exit":"east","move":"east"}]},
  {"id":162,"x":-280,"y":-200,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["The return of the dried grass to the color palette is a welcome relief after the surrounding areas.  Even the air is relatively free of the bog's vile odors."],"exits":[{"to":164,"exit":"northeast","move":"northeast"},{"to":163,"exit":"east","move":"east"},{"to":161,"exit":"west","move":"west"}]},
  {"id":163,"x":-240,"y":-200,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Extra water in the mix makes this patch of ground exceptionally soft.  Almost no grass grows, leaving the soil exposed.  Its texture and appearance is approximately that of clotted blood, and the stench is nearly the same as well."],"exits":[{"to":141,"exit":"east","move":"east"},{"to":162,"exit":"west","move":"west"},{"to":164,"exit":"northwest","move":"northwest"}]},
  {"id":164,"x":-260,"y":-220,"z":0,"title":"Pejek Bog, Wandering The Muck","descriptions":["Chunks of peat swollen with fetid water float like buoys between nests of brown grass and twigs.  Occasionally, movement under the surface churns the thin film of moss accumulated atop the bog.  The liquid barely ripples, so laden with debris and detritus it can hardly move."],"exits":[{"to":163,"exit":"southeast","move":"southeast"},{"to":162,"exit":"southwest","move":"southwest"}]},
  {"id":165,"x":130,"y":0,"z":0,"title":"Zaulfung, Mire","descriptions":["Blackened weeds poke up through the bog, clogging the terrain further still.  The area is still and quiet and the pools of stagnant water fetid.  No birds or wild animal calls can be heard, and a thick foggy haze clings near to the ground."],"exits":[{"to":166,"exit":"east","move":"east"},{"to":171,"exit":"southeast","move":"southeast"},{"to":172,"exit":"south","move":"south"},{"to":31,"exit":"go","move":"go marsh"}]},
  {"id":166,"x":150,"y":0,"z":0,"title":"Zaulfung, Mire","descriptions":["Faint whispers of the dried, dead reeds rustling in a short-lived breeze creep over the lifeless mire.  The stinking gloop is ever present and squelches grotesquely underfoot.  A dark silhouette is visible on a mound far to the south."],"exits":[{"to":167,"exit":"east","move":"east"},{"to":170,"exit":"southeast","move":"southeast"},{"to":171,"exit":"south","move":"south"},{"to":172,"exit":"southwest","move":"southwest"},{"to":165,"exit":"west","move":"west"}]},
  {"id":167,"x":170,"y":0,"z":0,"title":"Zaulfung, Mire","descriptions":["A great wall of reeds rises defiantly from the swamp, reaching well overhead.  Washes of color are visible through the occasional gap, and a heady fragrance permeates the air."],"exits":[{"to":168,"exit":"east","move":"east"},{"to":169,"exit":"southeast","move":"southeast"},{"to":170,"exit":"south","move":"south"},{"to":171,"exit":"southwest","move":"southwest"},{"to":166,"exit":"west","move":"west"}]},
  {"id":168,"x":190,"y":0,"z":0,"title":"Zaulfung, Mire","descriptions":["Peculiar amphibians occasionally peek out from behind patches of reeds, leaping into the sludge and swimming frantically for shelter elsewhere at any movement that disturbs the swampy quietness.  A dark object rises towards the sky far to the southwest."],"exits":[{"to":169,"exit":"south","move":"south"},{"to":170,"exit":"southwest","move":"southwest"},{"to":167,"exit":"west","move":"west"}]},
  {"id":169,"x":190,"y":20,"z":0,"title":"Zaulfung, Mire","descriptions":["A small feeder of seemingly fresh water trickles into the area from the east, though a source of fresh water within the Zaulfung's reach is a rare commodity indeed.  The water mixes in a swirl with the polluted sludge common to the region, ruining any value it had.  Occasional bits of unidentifiable flotsam and jetsam drift lazily past."],"exits":[{"to":168,"exit":"north","move":"north"},{"to":173,"exit":"south","move":"south"},{"to":174,"exit":"southwest","move":"southwest"},{"to":170,"exit":"west","move":"west"},{"to":167,"exit":"northwest","move":"northwest"}]},
  {"id":170,"x":170,"y":20,"z":0,"title":"Zaulfung, Mushroom Well","descriptions":["This small pocket vale is walled to the north and south by tall reeds that block some of the sludge that otherwise would overrun it.  The ground here is teeming with a veritable kaliedoscope of colored mushrooms in every stage of growth.  A peculiar greenish haze drifts along the caps of some of more mature mushrooms."],"exits":[{"to":167,"exit":"north","move":"north"},{"to":168,"exit":"northeast","move":"northeast"},{"to":169,"exit":"east","move":"east"},{"to":173,"exit":"southeast","move":"southeast"},{"to":174,"exit":"south","move":"south"},{"to":175,"exit":"southwest","move":"southwest"},{"to":171,"exit":"west","move":"west"},{"to":166,"exit":"northwest","move":"northwest"}]},
  {"id":171,"x":150,"y":20,"z":0,"title":"Zaulfung, Mire","descriptions":["Stinking goo gurgles and slops with even the faintest movement.  Putrid smells from something long buried escape as small bubbles rise up and burst through the disturbed mush.  A stone marker is partially visible."],"exits":[{"to":166,"exit":"north","move":"north"},{"to":167,"exit":"northeast","move":"northeast"},{"to":170,"exit":"east","move":"east"},{"to":174,"exit":"southeast","move":"southeast"},{"to":175,"exit":"south","move":"south"},{"to":176,"exit":"southwest","move":"southwest"},{"to":172,"exit":"west","move":"west"},{"to":165,"exit":"northwest","move":"northwest"}]},
  {"id":172,"x":130,"y":20,"z":0,"title":"Zaulfung, Mire","descriptions":["To call the ground solid would be inaccurate, but the loose bog thickens to resemble something closer to dried out oatmeal.  Blackened weeds occasionally peek up from the dense fog of noxious swampy gas hugging the ground."],"exits":[{"to":165,"exit":"north","move":"north"},{"to":166,"exit":"northeast","move":"northeast"},{"to":171,"exit":"east","move":"east"},{"to":175,"exit":"southeast","move":"southeast"},{"to":176,"exit":"south","move":"south"}]},
  {"id":173,"x":190,"y":40,"z":0,"title":"Zaulfung, Mire","descriptions":["A cloud of insects, one of the few signs of life in the area, hovers above a deteriorating length of bone that reaches skyward from the blackened sludge.  When a rare breeze swirls through, a faintly sweet odor mingles with the mire's noisome odors."],"exits":[{"to":169,"exit":"north","move":"north"},{"to":189,"exit":"southwest","move":"southwest"},{"to":174,"exit":"west","move":"west"},{"to":170,"exit":"northwest","move":"northwest"},{"to":0,"exit":"go","move":"go slope"},{"to":192,"exit":"go","move":"go downward slope"}]},
  {"id":174,"x":170,"y":40,"z":0,"title":"Zaulfung, Mire","descriptions":["A great wall of reeds rises defiantly from the swamp, reaching well overhead.  Washes of color are visible through the occasional gap, and a heady fragrance permeates the air."],"exits":[{"to":170,"exit":"north","move":"north"},{"to":169,"exit":"northeast","move":"northeast"},{"to":173,"exit":"east","move":"east"},{"to":189,"exit":"south","move":"south"},{"to":190,"exit":"southwest","move":"southwest"},{"to":175,"exit":"west","move":"west"},{"to":171,"exit":"northwest","move":"northwest"}]},
  {"id":175,"x":150,"y":40,"z":0,"title":"Zaulfung, Mire","descriptions":["Black, filthy sludge burbles atop the loose ground, forming a partial moat around a mound that rises to the south.  In the open expanse, light from the heavens above is muted considerably by the thick haze roiling over the ground as it fails to ascend the mound."],"exits":[{"to":171,"exit":"north","move":"north"},{"to":170,"exit":"northeast","move":"northeast"},{"to":174,"exit":"east","move":"east"},{"to":189,"exit":"southeast","move":"southeast"},{"to":190,"exit":"south","move":"south"},{"to":191,"exit":"southwest","move":"southwest"},{"to":176,"exit":"west","move":"west"},{"to":172,"exit":"northwest","move":"northwest"}]},
  {"id":176,"x":130,"y":40,"z":0,"title":"Zaulfung, Mire","descriptions":["Stinking goo gurgles and slops with even the faintest movement.  Putrid smells from something long buried escape as small bubbles rise up and burst through the disturbed mush.  A stone marker is partially visible."],"exits":[{"to":172,"exit":"north","move":"north"},{"to":171,"exit":"northeast","move":"northeast"},{"to":175,"exit":"east","move":"east"},{"to":190,"exit":"southeast","move":"southeast"},{"to":191,"exit":"south","move":"south"}]},
  {"id":189,"x":170,"y":60,"z":0,"title":"Zaulfung, Mire","descriptions":["The bog here slides away from a mound rising in the west.  Spear-like weeds push up from the loose ground near a pile of bone-littered compost, waving quietly at nothing as the burbling muck disturbs their long-dead stalks."],"exits":[{"to":174,"exit":"north","move":"north"},{"to":173,"exit":"northeast","move":"northeast"},{"to":190,"exit":"west","move":"west"},{"to":175,"exit":"northwest","move":"northwest"}]},
  {"id":190,"x":150,"y":60,"z":0,"title":"Zaulfung, Monolith","descriptions":["Standing stolidly amongst wiry brown reeds, a stone monolith defies the erosion rampant in the swamp.  From the vantage of this mound, much of the surrounding area can be viewed, though there is little to see."],"exits":[{"to":175,"exit":"north","move":"north"},{"to":174,"exit":"northeast","move":"northeast"},{"to":189,"exit":"east","move":"east"},{"to":191,"exit":"west","move":"west"},{"to":176,"exit":"northwest","move":"northwest"}]},
  {"id":191,"x":130,"y":60,"z":0,"title":"Zaulfung, Mire","descriptions":["In a patch of relatively stable ground, a single footprint remains forever visible as the mire refuses to reclaim it.  Or, perhaps, it's fresh from someone or something recently passing through.  Nearby, another mark looks as if something was dragged over the surface -- the blackened reeds are flattened along the path."],"exits":[{"to":176,"exit":"north","move":"north"},{"to":175,"exit":"northeast","move":"northeast"},{"to":190,"exit":"east","move":"east"}]},
  {"id":192,"x":222,"y":60,"z":0,"title":"Zaulfung, Deep Mire","descriptions":["Though the surface muck looks level, the ground noticeably slopes downwards toward the east.  Dried husks of long-dead plants struggle to remain above the devouring sludge of the mire.  Wriggling worms appear in the muck from time to time as they squirm aimlessly over one another, but they remain densely clumped and disappear again entirely below the surface."],"exits":[{"to":193,"exit":"northeast","move":"northeast"},{"to":200,"exit":"east","move":"east"},{"to":199,"exit":"southeast","move":"southeast"},{"to":173,"exit":"go","move":"go slope"},{"to":173,"exit":"go","move":"go upward slope"}]},
  {"id":193,"x":242,"y":40,"z":0,"title":"Zaulfung, Deep Mire","descriptions":["Knee-deep brackish water conceals the trecherously slippery mud below.  Silent stillness blankets the featureless area.  Absolutely nothing stands out in this desolate stretch of the Zaulfung."],"exits":[{"to":194,"exit":"northeast","move":"northeast"},{"to":195,"exit":"east","move":"east"},{"to":200,"exit":"southeast","move":"southeast"},{"to":199,"exit":"south","move":"south"},{"to":192,"exit":"southwest","move":"southwest"}]},
  {"id":194,"x":262,"y":20,"z":0,"title":"Zaulfung, Deep Mire","descriptions":["The putrid stench of decay fights for dominance with the fetid odor of stagnant water here.  A thick blanket of blighted, mostly dead moss clings to the surface -- whatever nutrients sustained it have long since been depleted.  A trio of structures loom to the south, as if protecting something between them, but at this distance it's hard to make out."],"exits":[{"to":195,"exit":"southeast","move":"southeast"},{"to":200,"exit":"south","move":"south"},{"to":193,"exit":"southwest","move":"southwest"}]},
  {"id":195,"x":282,"y":40,"z":0,"title":"Zaulfung, Deep Mire","descriptions":["Knee-deep brackish water conceals the trecherously slippery mud below.  In the swampy stillness, the incessent drone of buzzing, swarming insects nearby sounds like the bustling, people-filled streets of a busy city.  Thick, gnarled vines long devoid of life appear as if they were coiled and dragged here intentionally -- quite some time ago judging by their half-submerged state."],"exits":[{"to":196,"exit":"southeast","move":"southeast"},{"to":197,"exit":"south","move":"south"},{"to":200,"exit":"southwest","move":"southwest"},{"to":193,"exit":"west","move":"west"},{"to":194,"exit":"northwest","move":"northwest"}]},
  {"id":196,"x":302,"y":60,"z":0,"title":"Zaulfung, Deep Mire","descriptions":["A dense ball of tiny midges perpetually swarms here.  Whether drawn to something beneath the swampy goop prevalent here or some other compulsion can't be known, but their persistence is unquestionable.  Beneath the mass, the sludge is covered by countless numbers of their miniscule corpses piled atop one another -- their dance ended only by their death."],"exits":[{"to":197,"exit":"southwest","move":"southwest"},{"to":200,"exit":"west","move":"west"},{"to":195,"exit":"northwest","move":"northwest"}]},
  {"id":197,"x":282,"y":80,"z":0,"title":"Zaulfung, Deep Mire","descriptions":["Ominous squelching pierces the murky silence as something moves through the brackish, knee-deep water.  Disturbingly, even with the lack of plant-life or other obstructions, the sound's source remains a mystery -- no beasts or other moving forms larger than the occasional gnat can be seen."],"exits":[{"to":195,"exit":"north","move":"north"},{"to":196,"exit":"northeast","move":"northeast"},{"to":198,"exit":"southwest","move":"southwest"},{"to":199,"exit":"west","move":"west"},{"to":200,"exit":"northwest","move":"northwest"}]},
  {"id":198,"x":262,"y":100,"z":0,"title":"Zaulfung, Deep Mire","descriptions":["Knee-deep brackish water conceals the trecherously slippery mud below.  From time to time, a tolling bell rings out from somewhere to the south and is quickly followed by excited shouting, but whatever activity is happening remains elusively beyond the Zaulfung's blighted grasp."],"exits":[{"to":200,"exit":"north","move":"north"},{"to":197,"exit":"northeast","move":"northeast"},{"to":199,"exit":"northwest","move":"northwest"}]},
  {"id":199,"x":242,"y":80,"z":0,"title":"Zaulfung, Deep Mire","descriptions":["Bubbles rise to the surface of the swampy sludge, causing it to bulge grotesquely before popping and releasing noxious, stomach-churning fumes.  Curiously, they seem to move about, slowly, in a counter-clockwise direction.  Ghostly silhouettes to the northeast cast ominous shadows that chase the bubbles as the day progresses."],"exits":[{"to":193,"exit":"north","move":"north"},{"to":200,"exit":"northeast","move":"northeast"},{"to":197,"exit":"east","move":"east"},{"to":198,"exit":"southeast","move":"southeast"},{"to":192,"exit":"northwest","move":"northwest"}]},
  {"id":200,"x":262,"y":60,"z":0,"title":"Zaulfung, Deep Mire","descriptions":["A trio of dead willow trees rise from the swamp.  The leaves and many of the branches have long since been reclaimed by the muck, but the ghostly silhouettes that remain resemble wild banshees with upraised arms clawing towards the heavens."],"exits":[{"to":194,"exit":"north","move":"north"},{"to":195,"exit":"northeast","move":"northeast"},{"to":196,"exit":"east","move":"east"},{"to":197,"exit":"southeast","move":"southeast"},{"to":198,"exit":"south","move":"south"},{"to":199,"exit":"southwest","move":"southwest"},{"to":192,"exit":"west","move":"west"},{"to":193,"exit":"northwest","move":"northwest"}]},
  {"id":201,"x":580,"y":-200,"z":0,"title":"Zaulfung, Crooked Treetop","descriptions":["Feeble branches are all that stand between yourself and a perilous fall to the marsh below.  From this altitude you are afforded a vantage of the swamp stretching out to the east and west, divided by a thick wall of scraggly brush that seems to rise around this very tree.  A single sturdy branch appears to bridge this gap, heading eastward."],"exits":[{"to":202,"exit":"east","move":"east"},{"to":321,"exit":"down","move":"down"}]},
  {"id":202,"x":600,"y":-200,"z":0,"title":"Zaulfung, Crooked Treetop","descriptions":["Feeble branches are all that stand between yourself and a perilous fall to the marsh below.  From this altitude you are afforded a vantage of the swamp stretching out to the east and west, divided by a thick wall of scraggly brush that seems to rise around this very tree.  A single sturdy branch appears to bridge this gap, heading westward."],"exits":[{"to":201,"exit":"west","move":"west"},{"to":203,"exit":"down","move":"down"}],"aliases":["Treetop"]},
  {"id":203,"x":680,"y":-200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["An expanse of deep swamp and thick, tangled foliage stretches out to the east.  The shrubbery is much more dense here than to the west, and knobby trees twisted by the foul waters rise up like wicked claws draped with creeper vines, creating a canopy of shade to incubate the stagnating, muddy water."],"exits":[{"to":208,"exit":"southeast","move":"swim southeast"},{"to":204,"exit":"northwest","move":"swim northwest"},{"to":202,"exit":"climb","move":"climb sickly tree"}],"color":"#0000FF"},
  {"id":204,"x":660,"y":-260,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Withered and sickly-looking creeper vines dangle from the canopy of claw-like branches above, resembling lifeless snakes that have met the somber touch of Eylhaar, asphyxiated by the noxious fumes burbling from the murky waters below."],"exits":[{"to":205,"exit":"northeast","move":"swim northeast"},{"to":203,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":205,"x":680,"y":-280,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A nearby tree lies half sunken into the marsh, severed from a trunk that has been splintered beyond recognition by some unknown act of nature -- or perhaps the unnatural forces that laid waste to this region."],"exits":[{"to":209,"exit":"east","move":"swim east"},{"to":206,"exit":"southeast","move":"swim southeast"},{"to":204,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":206,"x":700,"y":-260,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A large, clawed footprint has been preserved in a raised portion of the mud here, a foreboding sign to travelers who dare disturb the eerie sense of peace that pervades this sickly wilderness."],"exits":[{"to":209,"exit":"northeast","move":"swim northeast"},{"to":207,"exit":"southeast","move":"swim southeast"},{"to":205,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":207,"x":720,"y":-200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A disgusting slurping noise constantly plagues your ears as bubbles rise to the surface of the swamp only to burst and release their noxious fumes into the air.  The looming foliage seems to draw in closer, the canopy above growing more confining as the gasses begin to take their toll."],"exits":[{"to":311,"exit":"east","move":"swim east"},{"to":310,"exit":"southeast","move":"swim southeast"},{"to":208,"exit":"southwest","move":"swim southwest"},{"to":206,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":208,"x":700,"y":-180,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick, tangled brush flourishes over this murky swamp, obscured by a lazy black mist that constantly rolls up from the sludge underfoot.  The sickly gas tendrils writhe through the air, incorporating themselves with the sky above like a thick shawl of shadow."],"exits":[{"to":207,"exit":"northeast","move":"swim northeast"},{"to":302,"exit":"south","move":"swim south"},{"to":203,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":209,"x":720,"y":-280,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The squawk of a vulture echoes above the canopy of tainted trees, a sign of Aldauth's eternal grip on the tilted balance of life in this swamp."],"exits":[{"to":215,"exit":"northeast","move":"swim northeast"},{"to":206,"exit":"southwest","move":"swim southwest"},{"to":205,"exit":"west","move":"swim west"},{"to":210,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":210,"x":700,"y":-300,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The faint scent of fresh air teases you, stirring from a gap in the thick canopy above the swamp.  The respite offered by the pale breeze is quite welcome, its worth to your lungs like a single diamond chip amidst a pile of coal."],"exits":[{"to":214,"exit":"northeast","move":"swim northeast"},{"to":215,"exit":"east","move":"swim east"},{"to":209,"exit":"southeast","move":"swim southeast"},{"to":211,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":211,"x":660,"y":-300,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The air is stagnant, laden with the brackish vapor seeping from the festering greenish-black waters of the Zaulfung.  It is unlikely that even a fresh coastal breeze buoyed upon Lemicus' wings could rid the swamp of the stench, the war of time already lost in saving this befouled wetland."],"exits":[{"to":212,"exit":"north","move":"swim north"},{"to":210,"exit":"east","move":"swim east"}],"color":"#0000FF"},
  {"id":212,"x":660,"y":-340,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single branch has splintered off a nearby tree, now slowly sinking into the murky quagmire below.  It reaches up like a wretched claw, grasping for what futile semblance of life it had attained in this foul garden."],"exits":[{"to":213,"exit":"northeast","move":"swim northeast"},{"to":211,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":213,"x":680,"y":-360,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A choking pall of putrid vapor drifts through the swamp, held prisoner by the canopy of tormented foliage above.  The gas weaves a monstrous miasma of death and destruction, one that no living creature should be subjected to.  It is a ghastly wonder what morbid fate could have created a place as horrid as this."],"exits":[{"to":214,"exit":"southeast","move":"swim southeast"},{"to":212,"exit":"southwest","move":"swim southwest"},{"to":216,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":214,"x":720,"y":-320,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick reeds jut upward from the murky waters, forming a small burrow for the harmless creatures of the region.  The omnipresent canopy surrounding most of the swamp breaks here, allowing the fumes to drift upward into the sky, escaping the festering quagmire."],"exits":[{"to":222,"exit":"east","move":"swim east"},{"to":215,"exit":"southeast","move":"swim southeast"},{"to":210,"exit":"southwest","move":"swim southwest"},{"to":213,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":215,"x":740,"y":-300,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The miasma grows thicker, the noxious stench becoming almost too much to bear.  Each step is laborious and fatiguing, the knee-high muddy water making movement much slower than on dry land."],"exits":[{"to":315,"exit":"south","move":"swim south"},{"to":209,"exit":"southwest","move":"swim southwest"},{"to":210,"exit":"west","move":"swim west"},{"to":214,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":216,"x":660,"y":-380,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The brush grows denser here, thick tangles of foliage rising right out of the muddy waters, flourishing despite the deathly fumes that coil and swath every semblance of the living, threatening to wring the life from every last pore."],"exits":[{"to":217,"exit":"northeast","move":"swim northeast"},{"to":213,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":217,"x":680,"y":-400,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick tangles of thorny brambles cover what little land is elevated enough not to be drowned by the brackish mud, blocking the path on the easiest of routes and making it necessary to trudge through the muck and mire."],"exits":[{"to":218,"exit":"south","move":"swim south"},{"to":216,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":218,"x":680,"y":-380,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick reeds jut upward from the murky waters, forming a small burrow for the harmless creatures of the region.  The omnipresent canopy surrounding most of the swamp breaks here, allowing the fumes to drift upward into the sky, escaping the festering quagmire."],"exits":[{"to":217,"exit":"north","move":"swim north"},{"to":219,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":219,"x":700,"y":-360,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The miasma grows thicker, the noxious stench becoming almost too much to bear.  Each step is laborious and fatiguing, the knee-high muddy water making movement much slower than on dry land."],"exits":[{"to":220,"exit":"east","move":"swim east"},{"to":218,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":220,"x":740,"y":-360,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Putrid fumes rising from the swamp coalesce into a heavy blanket of black fog that flows all through the surrounding air, held in by the ceiling of twisted branches and vines above."],"exits":[{"to":223,"exit":"northeast","move":"swim northeast"},{"to":221,"exit":"southeast","move":"swim southeast"},{"to":219,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":221,"x":780,"y":-340,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The subtle, constant slurp of the mire is shattered by the distant throaty cry of a buzzard.  Scanning the trees above, nothing resembling a semblance of life is visible, yet the sound remains imprinted into your mind."],"exits":[{"to":230,"exit":"southeast","move":"swim southeast"},{"to":222,"exit":"southwest","move":"swim southwest"},{"to":220,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":222,"x":760,"y":-320,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A sickly-looking tree bends in despair beneath an unseen burden, its withered leaves dipping down into the thick, swampy path.  The canopy of trees above seems healthier, but the leaves have taken on a brackish green color that doesn't bode well for their destiny."],"exits":[{"to":221,"exit":"northeast","move":"swim northeast"},{"to":316,"exit":"southeast","move":"swim southeast"},{"to":214,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":223,"x":760,"y":-380,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Withered and sickly-looking creeper vines dangle from the canopy of claw-like branches above, resembling lifeless snakes that have met the somber touch of Eylhaar, asphyxiated by the noxious fumes burbling from the murky waters below."],"exits":[{"to":224,"exit":"east","move":"swim east"},{"to":220,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":224,"x":800,"y":-380,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A looming blanket of black fog drifts lazily through the air, obscuring the sky and incubating the swamp's noxious gasses in the cramped space beneath the canopy of twisted trees above."],"exits":[{"to":225,"exit":"northeast","move":"swim northeast"},{"to":229,"exit":"southeast","move":"swim southeast"},{"to":223,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":225,"x":860,"y":-440,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A large, clawed footprint has been preserved in a raised portion of the mud here, a foreboding sign to travelers who dare disturb the eerie sense of peace that pervades over this sickly wilderness."],"exits":[{"to":226,"exit":"south","move":"swim south"},{"to":224,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":226,"x":860,"y":-380,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A disgusting slurping noise constantly plagues your ears as bubbles rise to the surface of the swamp only to burst and release their noxious fumes into the air.  The looming foliage seems to draw in closer, the canopy above growing more confining as the gasses begin to take their toll."],"exits":[{"to":225,"exit":"north","move":"swim north"},{"to":227,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":227,"x":880,"y":-360,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A nearby tree lies half sunken into the marsh, severed from a trunk that has been splintered beyond recognition by some unknown act of nature -- or perhaps the unnatural forces that laid waste to this region."],"exits":[{"to":243,"exit":"southeast","move":"swim southeast"},{"to":228,"exit":"southwest","move":"swim southwest"},{"to":226,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":228,"x":860,"y":-340,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Dense thorny foliage obscures most of the structure that stretches out directly to the south, sculpted into the vague form of a jackal's hindquarters, sinking beneath the swamp's rancid surface.  A rigid stone tail rises from amidst the dense vegetation, decidedly not of mammal inspiration to those who created the strange monument."],"exits":[{"to":227,"exit":"northeast","move":"swim northeast"},{"to":232,"exit":"southeast","move":"swim southeast"},{"to":231,"exit":"southwest","move":"swim southwest"},{"to":229,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":229,"x":840,"y":-340,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A strange stone monument rises to the east, stretching far to the south.  From this vantage, it appears to be the hindquarters of what has been chiseled to resemble a jackal-like beast.  A strange obelisk of stone juts up where its tail would be, breaking the form of what would otherwise appear to be a quite realistic rendition of the animal."],"exits":[{"to":228,"exit":"east","move":"swim east"},{"to":230,"exit":"southwest","move":"swim southwest"},{"to":224,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":230,"x":800,"y":-320,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Chisel marks cover the stone wall to the east, somewhat obscured by draping vines and clingy brambles.  The etchings are quite crude, but it is apparent that this is the hindquarters of some sort of beast -- perhaps a hound or even a jackal."],"exits":[{"to":229,"exit":"northeast","move":"swim northeast"},{"to":316,"exit":"south","move":"swim south"},{"to":221,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":231,"x":820,"y":-300,"z":0,"title":"Zaulfung, Urrem'tier's Spire","descriptions":["A cloak of dusky darkness shrouds a giant, segmented obsidian tail that arcs out of the foliage behind the southern structure, curving upward to a tall spire far up in the inky midnight sky.  The tail appears remarkably similar to a creature that is more insect in nature, rather than the mammalian jackal depicted in the rest of the ancient stone."],"exits":[{"to":228,"exit":"northeast","move":"swim northeast"}],"aliases":["Spire"]},
  {"id":232,"x":880,"y":-320,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A dense cloak of sickly vegetation lurks over the surface of a stone structure, rendering it impossible to climb without gaining a host of nasty (and possibly poisonous) laceration wounds.  A tall, shadowy spire is visible a short distance to the west, jutting out of the back of the mammalian stone figure."],"exits":[{"to":241,"exit":"southeast","move":"swim southeast"},{"to":233,"exit":"southwest","move":"swim southwest"},{"to":228,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":233,"x":860,"y":-300,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The unforgiving mire grapples with every moving thing, ever-vigilant in its quest to devour all within its reach.  An eerie sense of purpose looms over the swamp, as if its very presence on Elanthia is not just simply a foul die cast upon Berengaria's golden plains."],"exits":[{"to":232,"exit":"northeast","move":"swim northeast"},{"to":234,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":234,"x":880,"y":-280,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A deep gash mars the side of the monument half-sunken into the marsh, a reminder of the horrors that must have befallen this area to send it so far down the spiral, shattered from the equilibrium of nature's cyclical balance."],"exits":[{"to":235,"exit":"south","move":"swim south"},{"to":233,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":235,"x":880,"y":-260,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A large skeleton of unknown origin lies half-sunken into marsh, tangled within the wicked clutches of the thorny brambles.  Its stature lends to the belief that it may have once been a Gor'Tog, but time and decomposition have mangled it so badly that it may simply be the remnants of one of the foul sluagh."],"exits":[{"to":234,"exit":"north","move":"swim north"},{"to":236,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":236,"x":900,"y":-240,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The sludge underfoot yawns open from time to time, releasing bubbles of noxious fumes into the air.  The pall of decay lingers heavily throughout the swamp, permeating everything with the sights, smells, and eerie silence of death."],"exits":[{"to":237,"exit":"northeast","move":"swim northeast"},{"to":257,"exit":"southwest","move":"swim southwest"},{"to":235,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":237,"x":920,"y":-260,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The bleak surroundings grow even more dismal, viewing the expanse of murky swamp laid out in all directions.  Twisted marsh-dwelling trees reach up like primitive claws, vying for respite in the clean air that exists far above the noxious gasses burbling up from the watery slime underfoot."],"exits":[{"to":238,"exit":"north","move":"swim north"},{"to":244,"exit":"northeast","move":"swim northeast"},{"to":246,"exit":"southeast","move":"swim southeast"},{"to":236,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":238,"x":920,"y":-280,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A Gor'Tog-sized bubble of brownish-green expands and contracts in the middle of the swamp here, breathing with a life of its own.  Vicious claws loom from the trees overhead, shielding the enigmatic bubble from the elements and incubating the foul stew."],"exits":[{"to":239,"exit":"northeast","move":"swim northeast"},{"to":237,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":239,"x":940,"y":-300,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Brackish water rises roughly knee-high on a Human throughout this swamp, making it quite laborious to trudge through the slime.  It is unknown what lurks beneath its depths due to the sickly greenish-brown color the mud has taken on."],"exits":[{"to":238,"exit":"southwest","move":"swim southwest"},{"to":240,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":240,"x":920,"y":-320,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single violet flower blooms from a creeper vine draped between the wretched, clawlike trees above, a faint semblance of unperverted life amidst a garden of death and gloom."],"exits":[{"to":243,"exit":"north","move":"swim north"},{"to":239,"exit":"southeast","move":"swim southeast"},{"to":241,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":241,"x":900,"y":-300,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The faint scent of fresh air teases you, stirring from a gap in the thick canopy above the swamp.  The respite offered by the pale breeze is quite welcome, its worth to your lungs like a single diamond chip amidst a pile of coal."],"exits":[{"to":240,"exit":"northeast","move":"swim northeast"},{"to":242,"exit":"south","move":"swim south"},{"to":232,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":242,"x":900,"y":-280,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single violet flower blooms from a creeper vine draped between the wretched, clawlike trees above, a faint semblance of unperverted life amidst a garden of death and gloom."],"exits":[{"to":241,"exit":"north","move":"swim north"}],"color":"#0000FF"},
  {"id":243,"x":920,"y":-340,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Tendrils of brackish mist sweep errantly through the area, carried upon wretched zephyrs tainted by the noxious fumes drifting up from the swamp.  It's a wonder that any life can exist here, and that which does seems fouled beyond all hope of salvation."],"exits":[{"to":240,"exit":"south","move":"swim south"},{"to":227,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":244,"x":940,"y":-280,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Murky slime burbles below, seeming to grow deeper and thicker the more one stands still.  Wild foliage climbs in every direction, the wicked and unintended children of the Zaulfung's inadvertent nourishment."],"exits":[{"to":245,"exit":"east","move":"swim east"},{"to":237,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":245,"x":980,"y":-280,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick, tangled brush flourishes over this murky swamp, obscured by a lazy black mist that constantly rolls up from the sludge underfoot.  The sickly gas tendrils writhe through the air, incorporating themselves with the sky above like a thick shawl of shadow."],"exits":[{"to":247,"exit":"southeast","move":"swim southeast"},{"to":246,"exit":"southwest","move":"swim southwest"},{"to":244,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":246,"x":940,"y":-240,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The air is stagnant, laden with the brackish vapor seeping from the festering greenish-black waters of the Zaulfung.  It is unlikely that even a fresh coastal breeze buoyed upon Lemicus' wings could rid the swamp of the stench, the war of time already lost in saving this befouled wetland."],"exits":[{"to":245,"exit":"northeast","move":"swim northeast"},{"to":249,"exit":"east","move":"swim east"},{"to":256,"exit":"southwest","move":"swim southwest"},{"to":237,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":247,"x":1000,"y":-260,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The squawk of a vulture echoes above the canopy of tainted trees, a sign of Aldauth's eternal grip on the tilted balance of life in this swamp."],"exits":[{"to":248,"exit":"south","move":"swim south"},{"to":245,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":248,"x":1000,"y":-200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The faint scent of fresh air teases you, stirring from a gap in the thick canopy above the swamp.  The respite offered by the pale breeze is quite welcome, its worth to your lungs like a single diamond chip amidst a pile of coal."],"exits":[{"to":247,"exit":"north","move":"swim north"},{"to":250,"exit":"southwest","move":"swim southwest"},{"to":249,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":249,"x":980,"y":-240,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A choking pall of putrid vapor drifts through the swamp, held prisoner by the canopy of tormented foliage above.  The gas weaves a monstrous miasma of death and destruction, one that no living creature should be subjected to.  It is a ghastly wonder what morbid fate could have created a place as horrid as this."],"exits":[{"to":248,"exit":"southeast","move":"swim southeast"},{"to":252,"exit":"south","move":"swim south"},{"to":246,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":250,"x":980,"y":-180,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The air is stagnant, laden with the brackish vapor seeping from the festering greenish-black waters of the Zaulfung.  It is unlikely that even a fresh coastal breeze buoyed upon Lemicus' wings could rid the swamp of the stench, the war of time already lost in saving this befouled wetland."],"exits":[{"to":248,"exit":"northeast","move":"swim northeast"},{"to":251,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":251,"x":960,"y":-180,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single branch has splintered off a nearby tree, now slowly sinking into the murky quagmire below.  It reaches up like a wretched claw, grasping for what futile semblance of life it had attained in this foul garden."],"exits":[{"to":252,"exit":"northeast","move":"swim northeast"},{"to":250,"exit":"east","move":"swim east"},{"to":265,"exit":"south","move":"swim south"},{"to":263,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":252,"x":980,"y":-200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick tangles of thorny brambles cover what little land is elevated enough not to be drowned by the brackish mud, blocking the path on the easiest of routes and making it necessary to trudge through the muck and mire."],"exits":[{"to":249,"exit":"north","move":"swim north"},{"to":251,"exit":"southwest","move":"swim southwest"},{"to":253,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":253,"x":940,"y":-200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The squawk of a vulture echoes above the canopy of tainted trees, a sign of Aldauth's eternal grip on the tilted balance of life in this swamp."],"exits":[{"to":252,"exit":"east","move":"swim east"},{"to":254,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":254,"x":920,"y":-180,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Murky slime burbles below, seeming to grow deeper and thicker the more one stands still.  Wild foliage climbs in every direction, the wicked and unintended children of the Zaulfung's inadvertent nourishment."],"exits":[{"to":253,"exit":"northeast","move":"swim northeast"},{"to":263,"exit":"south","move":"swim south"},{"to":255,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":255,"x":900,"y":-200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single branch has splintered off a nearby tree, now slowly sinking into the murky quagmire below.  It reaches up like a wretched claw, grasping for what futile semblance of life it had attained in this foul garden."],"exits":[{"to":256,"exit":"east","move":"swim east"},{"to":254,"exit":"southeast","move":"swim southeast"},{"to":257,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":256,"x":920,"y":-200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The brush grows denser here, thick tangles of foliage rising right out of the muddy waters, flourishing despite the deathly fumes that coil and swath over every semblance of the living, threatening to wring life's breath from every last pore."],"exits":[{"to":246,"exit":"northeast","move":"swim northeast"},{"to":255,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":257,"x":880,"y":-220,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A massive stone structure stretches to the north and south here, half-sunken into the swamp itself.  Irregular patterns of brambles twist and grapple over its surface, looking a great deal like thousands of scraggly clawed hands attempting to drag the grotto beneath the muddy sludge to devour it whole."],"exits":[{"to":236,"exit":"northeast","move":"swim northeast"},{"to":255,"exit":"southeast","move":"swim southeast"},{"to":258,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":258,"x":880,"y":-200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The eastern wall of brambles curves sharply to the south, widening the swampy path to make it passable around the front leg of the stone structure that blocks the direct southern route.  The carving is detailed even on this back side of the leg, its elbow jabbed deep down into the murky waters."],"exits":[{"to":257,"exit":"north","move":"swim north"},{"to":259,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":259,"x":900,"y":-180,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The massive arm of the stone jackal monument rises from the northern mire, stretching far out to the southwest.  Following the line of sight with the paw, a massive bird-like head is visible, looming above the brackish mist like some sort of twisted guardian."],"exits":[{"to":260,"exit":"west","move":"swim west"},{"to":258,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":260,"x":880,"y":-180,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A dense layer of brackish green fog is buoyed upon the air, constantly stagnating at eye-level.  The noxious stench emanating from the gasses is nearly too much to bear, and pockets of fresh air are slim and infrequent.  Stretching from the northeast to the southwest, a large stone structure serves as a landmark to this uncharted path, beckoning loiterers onward."],"exits":[{"to":259,"exit":"east","move":"swim east"},{"to":261,"exit":"south","move":"swim south"},{"to":277,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":261,"x":880,"y":-160,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Brackish water lurks roughly knee-high on a Human throughout this swamp, making it quite laborious to trudge through the slime.  It is unknown what lurks beneath its depths due to the sickly greenish-brown color the mud has taken on."],"exits":[{"to":260,"exit":"north","move":"swim north"},{"to":262,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":262,"x":900,"y":-140,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A disgusting slurping noise constantly plagues your ears as bubbles rise to the surface of the swamp only to burst and release their noxious fumes into the air.  The looming foliage seems to draw in closer, the canopy above growing more confining as the gasses begin to take their toll."],"exits":[{"to":263,"exit":"northeast","move":"swim northeast"},{"to":269,"exit":"south","move":"swim south"},{"to":261,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":263,"x":920,"y":-160,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick, tangled brush flourishes over this murky swamp, obscured by a lazy black mist that constantly rolls up from the sludge underfoot.  The sickly gas tendrils writhe through the air, incorporating themselves with the sky above like a thick shawl of shadow."],"exits":[{"to":254,"exit":"north","move":"swim north"},{"to":251,"exit":"northeast","move":"swim northeast"},{"to":264,"exit":"southeast","move":"swim southeast"},{"to":262,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":264,"x":940,"y":-140,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A large, clawed footprint has been preserved in a raised portion of the mud here, a foreboding sign to travelers who dare disturb the eerie sense of peace that pervades this sickly wilderness."],"exits":[{"to":265,"exit":"northeast","move":"swim northeast"},{"to":270,"exit":"southwest","move":"swim southwest"},{"to":263,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":265,"x":960,"y":-160,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A choking pall of putrid vapor drifts through the swamp, held prisoner by the canopy of tormented foliage above.  The gas weaves a monstrous miasma of death and destruction, one that no living creature should be subjected to.  It is a ghastly wonder what morbid fate could have created a place as horrid as this."],"exits":[{"to":251,"exit":"north","move":"swim north"},{"to":266,"exit":"southeast","move":"swim southeast"},{"to":264,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":266,"x":1000,"y":-120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The brush grows denser here, thick tangles of foliage rising right out of the muddy waters, flourishing despite the deathly fumes that coil and swath every semblance of the living, threatening to wring the life from every last pore."],"exits":[{"to":267,"exit":"west","move":"swim west"},{"to":265,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":267,"x":960,"y":-120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick tangles of thorny brambles cover what little land is elevated enough not to be drowned by the brackish mud, blocking the path on the easiest of routes and making it necessary to trudge through the muck and mire."],"exits":[{"to":266,"exit":"east","move":"swim east"},{"to":268,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":268,"x":920,"y":-80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick reeds jut upward from the murky waters, forming a small burrow for the harmless creatures of the region.  The omnipresent canopy surrounding most of the swamp breaks here, allowing the fumes to drift upward into the sky, escaping the festering quagmire."],"exits":[{"to":270,"exit":"north","move":"swim north"},{"to":267,"exit":"northeast","move":"swim northeast"},{"to":269,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":269,"x":900,"y":-100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The miasma grows thicker, the noxious stench becoming almost too much to bear.  Each step is laborious and fatiguing, the knee-high muddy water making movement much slower than on dry land."],"exits":[{"to":262,"exit":"north","move":"swim north"},{"to":268,"exit":"southeast","move":"swim southeast"},{"to":271,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":270,"x":920,"y":-120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single branch has splintered off a nearby tree, now slowly sinking into the murky quagmire below.  It reaches up like a wretched claw, grasping for what futile semblance of life it had attained in this foul garden."],"exits":[{"to":264,"exit":"northeast","move":"swim northeast"},{"to":268,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":271,"x":860,"y":-100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Putrid fumes rising from the swamp coalesce into a heavy blanket of black fog that flows all through the surrounding air, held in by the ceiling of twisted branches and vines above."],"exits":[{"to":269,"exit":"east","move":"swim east"},{"to":272,"exit":"southeast","move":"swim southeast"},{"to":277,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":272,"x":880,"y":-80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Withered and sickly-looking creeper vines dangle from the canopy of claw-like branches above, resembling lifeless snakes that have met the somber touch of Eylhaar, asphyxiated by the noxious fumes burbling from the murky waters below."],"exits":[{"to":273,"exit":"south","move":"swim south"},{"to":271,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":273,"x":880,"y":-20,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A looming blanket of black fog drifts lazily through the surrounding air, obscuring the sky and incubating the swamp's noxious gasses in the cramped space beneath the canopy of twisted trees above."],"exits":[{"to":272,"exit":"north","move":"swim north"},{"to":274,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":274,"x":840,"y":-60,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A large, clawed footprint has been preserved in a raised portion of the mud here, a foreboding sign to travelers who dare disturb the eerie sense of peace that pervades this sickly wilderness."],"exits":[{"to":273,"exit":"southeast","move":"swim southeast"},{"to":275,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":275,"x":820,"y":-80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A disgusting slurping noise constantly plagues your ears as bubbles rise to the surface of the swamp only to burst and release their noxious fumes into the air.  The looming foliage seems to draw in closer, the canopy above growing more confining as the gasses begin to take their toll."],"exits":[{"to":276,"exit":"north","move":"swim north"},{"to":274,"exit":"southeast","move":"swim southeast"},{"to":294,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":276,"x":820,"y":-100,"z":0,"title":"Zaulfung, Aldauth's Maw","descriptions":["A massive structure looms out of the mists at the north edge of the clearing, the only semblance of civilization amidst this wasteland of gaseous swamp.  Stylized and almost primitive, it appears to be a statue consisting of portions of three different animals that concoct a chimaera of great age and mystery.  Directly above, a giant stone vulture's head protrudes from a body much resembling a jackal's, with paws outstretched to either side."],"exits":[{"to":277,"exit":"northeast","move":"swim northeast"},{"to":275,"exit":"south","move":"swim south"},{"to":298,"exit":"northwest","move":"swim northwest"},{"to":278,"exit":"climb","move":"climb vulture beak"}],"color":"#0000FF"},
  {"id":277,"x":840,"y":-120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A giant paw sculpture of carved stone lies half-sunken into the marsh, still standing the height of two Gnomes.  Carefully-detailed claws clutch the muddy earth, as if afraid to let loose their grip and allow the entire structure to be devoured by the swamp."],"exits":[{"to":260,"exit":"northeast","move":"swim northeast"},{"to":271,"exit":"southeast","move":"swim southeast"},{"to":276,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":278,"x":820,"y":-120,"z":0,"title":"Kweld Gelvdael, Vulture's Maw","descriptions":["Grotesque depictions of horrific beasts are etched over the dark stone walls like cobwebs, each unique and intricate in its own right.  The entrance to this dark grotto gapes open, carved by the hands of the ancients to pay homage to Aldauth's vulture.  Beyond the edge of the massive beak structure you perch upon, the rancid swamp stretches out below."],"exits":[{"to":279,"exit":"down","move":"down"},{"to":276,"exit":"none","move":"jump swamp"}],"color":"#A6A3D9","aliases":["Shrine2-04","Aldauth","Vulture's Maw","Tongue"]},
  {"id":279,"x":820,"y":-140,"z":0,"title":"Kweld Gelvdael, Vulture's Gullet","descriptions":["The dark stone walls have been carved with strange ridges, evoking the image of vertebrae and other bones protruding into the vulture's gullet."],"exits":[{"to":278,"exit":"up","move":"up"},{"to":280,"exit":"down","move":"down"}]},
  {"id":280,"x":820,"y":-160,"z":0,"title":"Kweld Gelvdael, Vulture's Gullet","descriptions":["This strange circular crawlspace offers little room to maneuver around.  The gullet yawns open into a larger cavern to the north, while carved steps in the stone floor to the west curve upward, further into the throat of this giant beast.  A rough black basalt slab is leaned up against the wall flanking the steps, covered in strange glyphs of a forgotten language."],"exits":[{"to":281,"exit":"north","move":"north"},{"to":279,"exit":"up","move":"up"}]},
  {"id":281,"x":820,"y":-180,"z":0,"title":"Kweld Gelvdael, Jackal's Belly","descriptions":["The grotto opens into a quaint, yet cold living space to the north.  The stone floor is smooth and polished, with not a speck of dust apparent to the naked eye.  It seems strange, given the state of the swamp, that this cavern would be so well looked after."],"exits":[{"to":285,"exit":"north","move":"north"},{"to":284,"exit":"northeast","move":"northeast"},{"to":280,"exit":"south","move":"south"},{"to":282,"exit":"northwest","move":"northwest"}]},
  {"id":282,"x":800,"y":-200,"z":0,"title":"Kweld Gelvdael, Jackal's Belly","descriptions":["The smooth stone of the cavern floor curves gently upward to create the western wall.  A deep niche in the wall has been hollowed out and filled with fertile soil, creating a flourishing garden filled with various herbs and small plants.  Off to the north, a dimly-lit tunnel winds into the floor, curving down into the depths of the grotto."],"exits":[{"to":283,"exit":"northeast","move":"northeast"},{"to":285,"exit":"east","move":"east"},{"to":281,"exit":"southeast","move":"southeast"},{"to":286,"exit":"go","move":"go dark tunnel"}]},
  {"id":283,"x":820,"y":-220,"z":0,"title":"Kweld Gelvdael, Jackal's Belly","descriptions":["A jagged crevice has been rended open high up in the northern wall.  The climb looks treacherous, but several carved hand and foot holds make it less foreboding.  The stone is smooth and shines with a freshly-polished luster, so care must still be taken to keep from slipping."],"exits":[{"to":284,"exit":"southeast","move":"southeast"},{"to":285,"exit":"south","move":"south"},{"to":282,"exit":"southwest","move":"southwest"},{"to":291,"exit":"climb","move":"climb jagged crevice"}]},
  {"id":284,"x":840,"y":-200,"z":0,"title":"Kweld Gelvdael, Jackal's Belly","descriptions":["A small niche yawns open in the eastern wall, its surface carved into the shape of a gaping jackal's maw.  Great attention to detail has been paid to the stone carving.  Despite its ancient appearance, it has been polished and taken care of with stringent devotion."],"exits":[{"to":281,"exit":"southwest","move":"southwest"},{"to":285,"exit":"west","move":"west"},{"to":283,"exit":"northwest","move":"northwest"}]},
  {"id":285,"x":820,"y":-200,"z":0,"title":"Kweld Gelvdael, Jackal's Heart","descriptions":["The center of the cavern is dominated by a large pool filled with inky black water.  Its surface is smooth like a single pane of glass, and not a ripple disturbs the serene shrine.  A cylindrical obsidian altar flanks the entrance to the pool, a sign of reverence to the holy waters within."],"exits":[{"to":283,"exit":"north","move":"north"},{"to":284,"exit":"east","move":"east"},{"to":281,"exit":"south","move":"south"},{"to":282,"exit":"west","move":"west"},{"to":290,"exit":"go","move":"go black pool"}],"color":"#A6A3D9","aliases":["Eylhaar","Jackal's Heart"]},
  {"id":286,"x":800,"y":-180,"z":0,"title":"Kweld Gelvdael, Dark Tunnel","descriptions":["The smooth walls twist and curve, as if naturally hollowed out by erosion over time.  The tunnel is dim, yet the illumination of torchlight reveals it to be well looked after, and cleanly swept.  A wide opening in the southern wall leads back into the main cavern."],"exits":[{"to":287,"exit":"east","move":"east"},{"to":282,"exit":"go","move":"go wide opening"}],"color":"#00FFFF"},
  {"id":287,"x":810,"y":-180,"z":0,"title":"Kweld Gelvdael, Dark Tunnel","descriptions":["The tunnel curves downward smoothly and naturally in a serpentine fashion, leading deeper into the ancient cavern.  Spidery etchings cover the eastern wall, depicting a strange scene of a scorpion, jackal, and vulture all convened around a glassy pool of water."],"exits":[{"to":286,"exit":"west","move":"west"},{"to":288,"exit":"down","move":"down"}],"color":"#00FFFF"},
  {"id":288,"x":810,"y":-170,"z":0,"title":"Kweld Gelvdael, Dark Tunnel","descriptions":["A roaring reed torch has been nestled into a bronze sconce in the stone wall, illuminating the serpentine hallway brightly.  Freshly-swept stone steps rise upward into the cavern above, yet the tunnel snakes on to the west."],"exits":[{"to":289,"exit":"west","move":"west"},{"to":287,"exit":"up","move":"up"}],"color":"#00FFFF"},
  {"id":289,"x":800,"y":-170,"z":0,"title":"Kweld Gelvdael, Dark Tunnel","descriptions":["The tunnel comes to an abrupt halt as the western floor rises slowly up into the ceiling.  A giant stone scorpion sculpture adorns the cul-de-sac, its stinger poised as if to strike out at anything that dares draw near it.  Shadows dance and flicker over its surface as a lit torch set in a bronze wall sconce shines brightly, lending to the unease of the scene of the readied creature."],"exits":[{"to":288,"exit":"east","move":"east"},{"to":322,"exit":"go","move":"go amorphous spirits"}],"color":"#00FFFF"},
  {"id":290,"x":840,"y":-220,"z":0,"title":"Kweld Gelvdael, Jackal's Spirit","descriptions":["A sense of serenity saturates the aquatic shrine, as if guarded by an otherworldly presence.  The glassy black water is so frigid that it numbs your flesh immediately upon first contact, beckoning you to lie back and drift down into the deathly grasp of the jackal's spirit."],"exits":[{"to":285,"exit":"out","move":"out"}],"aliases":["Jackal's Spirit"]},
  {"id":291,"x":820,"y":-240,"z":0,"title":"Kweld Gelvdael, Scorpion's Tail","descriptions":["A massive stone tail arcs upward, towering over the wretched marsh.  The canopy of the swamp stretches out infinitely below, a withered green carpet that holds the foulness below its deathly shroud."],"exits":[{"to":292,"exit":"up","move":"up"},{"to":283,"exit":"climb","move":"climb jagged crevice"}]},
  {"id":292,"x":820,"y":-260,"z":0,"title":"Kweld Gelvdael, Scorpion's Tail","descriptions":["Smooth stone steps have been carved into the segmented tail, arcing upward into the sky.  One wrong move could prove devastating, sending you hurtling down through the blighted canopy into the waters below."],"exits":[{"to":293,"exit":"up","move":"up"},{"to":291,"exit":"down","move":"down"}]},
  {"id":293,"x":820,"y":-280,"z":0,"title":"Kweld Gelvdael, Scorpion's Stinger","descriptions":["The precarious steps come to an end at last, at the end of the scorpion's tail.  The swamp stretches out far below, the city of Riverhaven nestled beyond its wretched grasp far to the west."],"exits":[{"to":292,"exit":"down","move":"down"},{"to":231,"exit":"none","move":"jump swamp"}],"color":"#A6A3D9","aliases":["Scorpion's Stinger","shrine"]},
  {"id":294,"x":780,"y":-40,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A nearby tree lies half sunken into the marsh, severed from a trunk that has been splintered beyond recognition by some unknown act of nature -- or perhaps the unnatural forces that laid waste to this region."],"exits":[{"to":295,"exit":"north","move":"swim north"},{"to":275,"exit":"northeast","move":"swim northeast"}],"color":"#0000FF"},
  {"id":295,"x":780,"y":-80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Tendrils of brackish mist sweep errantly through the area, carried upon wretched zephyrs tainted by the noxious fumes drifting up from the swamp.  It's a wonder that any life can exist here, and that which does seems fouled beyond all hope of salvation."],"exits":[{"to":294,"exit":"south","move":"swim south"},{"to":296,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":296,"x":760,"y":-80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single violet flower blooms from a creeper vine draped between the wretched, clawlike trees above, a faint semblance of unperverted life amidst a garden of death and gloom."],"exits":[{"to":307,"exit":"north","move":"swim north"},{"to":297,"exit":"northeast","move":"swim northeast"},{"to":295,"exit":"east","move":"swim east"},{"to":299,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":297,"x":780,"y":-100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Thick, tangled vines with a dusky green tint clutch and strangle a lone berry bush, as if trying to slowly wring the life from it and draw it under the swamp to add to the collective decay of this region."],"exits":[{"to":306,"exit":"north","move":"swim north"},{"to":298,"exit":"northeast","move":"swim northeast"},{"to":296,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":298,"x":800,"y":-120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["To the northeast, a massive stone structure rises from the murky depths of the Zaulfung.  Even to the untrained eye it is more than apparent that this was a primitive temple of sorts, a gathering place of those who lived in this region before it was wracked with whatever blight corrupted it so."],"exits":[{"to":276,"exit":"southeast","move":"swim southeast"},{"to":297,"exit":"southwest","move":"swim southwest"},{"to":306,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":299,"x":740,"y":-60,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Brackish water rises roughly knee-high on a Human throughout this swamp, making it quite laborious to trudge through the slime.  It is unknown what lurks beneath its depths due to the sickly greenish-brown color the mud has taken on."],"exits":[{"to":296,"exit":"northeast","move":"swim northeast"},{"to":300,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":300,"x":700,"y":-60,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A Gor'Tog-sized bubble of brownish-green expands and contracts in the middle of the swamp here, breathing with a life of its own.  Vicious claws loom from the trees overhead, shielding the enigmatic bubble from the elements and incubating the foul stew."],"exits":[{"to":301,"exit":"northeast","move":"swim northeast"},{"to":299,"exit":"east","move":"swim east"}],"color":"#0000FF"},
  {"id":301,"x":720,"y":-80,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The bleak surroundings grow even more dismal, viewing the expanse of murky swamp laid out in all directions.  Twisted marsh-dwelling trees reach up like primitive claws, vying for respite in the clean air that exists far above the noxious gasses burbling up from the watery slime underfoot."],"exits":[{"to":300,"exit":"southwest","move":"swim southwest"},{"to":302,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":302,"x":700,"y":-100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Murky slime burbles below, seeming to grow deeper and thicker the more one stands still.  Wild foliage climbs in every direction, the wicked and unintended children of the Zaulfung's inadvertent nourishment."],"exits":[{"to":208,"exit":"north","move":"swim north"},{"to":303,"exit":"northeast","move":"swim northeast"},{"to":301,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":303,"x":740,"y":-140,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Tendrils of brackish mist sweep errantly through the area, carried upon wretched zephyrs tainted by the noxious fumes drifting up from the swamp.  It's a wonder that any life can exist here, and that which does seems fouled beyond all hope of salvation."],"exits":[{"to":304,"exit":"east","move":"swim east"},{"to":302,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":304,"x":760,"y":-140,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A single violet flower blooms from a creeper vine draped between the wretched, clawlike trees above, a faint semblance of unperverted life amidst a garden of death and gloom."],"exits":[{"to":305,"exit":"northeast","move":"swim northeast"},{"to":303,"exit":"west","move":"swim west"},{"to":310,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":305,"x":780,"y":-180,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A dense shawl of thorny brush all but completely covers a stone wall that looms to the east.  The brush grows even thicker to the north, diverting the path westward.  Underfoot, the squishy slurp of the swamp is ever-present, unyielding despite the thickness of the foliage here."],"exits":[{"to":306,"exit":"south","move":"swim south"},{"to":304,"exit":"southwest","move":"swim southwest"},{"to":312,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":306,"x":780,"y":-140,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Creeping foliage has laid claim to the bizarre structure that skirts the eastern side of this murky path, draping it in a shroud of thorny brambles and withered vines.  Further to the south, a large stone paw stretches out, curving southeast toward the front of the structure."],"exits":[{"to":305,"exit":"north","move":"swim north"},{"to":298,"exit":"southeast","move":"swim southeast"},{"to":297,"exit":"south","move":"swim south"},{"to":307,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":307,"x":760,"y":-120,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A Gor'Tog-sized bubble of brownish-green expands and contracts in the middle of the swamp here, breathing with a life of its own.  Vicious claws loom from the trees overhead, shielding the enigmatic bubble from the elements and incubating the foul stew."],"exits":[{"to":306,"exit":"northeast","move":"swim northeast"},{"to":296,"exit":"south","move":"swim south"},{"to":308,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":308,"x":740,"y":-100,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The bleak surroundings grow even more dismal, viewing the expanse of murky swamp laid out in all directions.  Twisted marsh-dwelling trees reach up like primitive claws, vying for respite in the clean air that exists far above the noxious gasses burbling up from the watery slime underfoot."],"exits":[{"to":309,"exit":"north","move":"swim north"},{"to":307,"exit":"northeast","move":"swim northeast"}],"color":"#0000FF"},
  {"id":309,"x":740,"y":-120,"z":0,"title":"Zaulfung, Ruined Shrine","descriptions":["Shattered and broken, a large wooden altar lies desecrated and befouled here, partially sunken into the thick mud.  Deep gouges and claw scratches mar the surface of the sacrilegious monument, likely torn asunder by the wicked hand of a sluagh."],"exits":[{"to":308,"exit":"south","move":"swim south"},{"to":317,"exit":"none","move":"touch alt;-pray"}],"aliases":["ruined shrine","wooden altar","sacrilegious monument"]},
  {"id":310,"x":740,"y":-180,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Brackish water rises roughly knee-high on a Human throughout this swamp, making it quite laborious to trudge through the slime.  It is unknown what lurks beneath its depths due to the sickly greenish-brown color the mud has taken on."],"exits":[{"to":304,"exit":"southeast","move":"swim southeast"},{"to":207,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":311,"x":740,"y":-200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A looming blanket of black fog drifts lazily through the air, obscuring the sky and incubating the swamp's noxious gasses in the cramped space beneath the canopy of twisted trees above."],"exits":[{"to":315,"exit":"north","move":"swim north"},{"to":312,"exit":"east","move":"swim east"},{"to":207,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":312,"x":760,"y":-200,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A raised portion of muddy soil to the east forks the path here.  Beyond the squishy mound, a wall of solid stone is visible, rising up into a primitive, almost animalistic form.  Thick tangles of shrubbery cling to its side, leaving very little to discern about its origin from this vantage."],"exits":[{"to":313,"exit":"northeast","move":"swim northeast"},{"to":305,"exit":"southeast","move":"swim southeast"},{"to":311,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":313,"x":780,"y":-260,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["A narrow passage exists here, sandwiched between a great stone wall to the east and a tangled mass of thorny brambles to the west.  Working through the strange tunnel is difficult, the vapors rising from the muddy waters below threatening to overcome even the most hardy of Dwarven noses."],"exits":[{"to":314,"exit":"north","move":"swim north"},{"to":312,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":314,"x":780,"y":-280,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Clouds of gnats flitter about with erratic purpose, inadvertently ending up in hair, nostrils, and open mouths.  Decaying foliage stagnates, half submerged in the stinking mire underfoot, and the likely attraction for the unwelcome swarm of pests.  It is all one can think of to get away from this place, or end up with a meal's worth of gnats rumbling about in their belly."],"exits":[{"to":316,"exit":"northeast","move":"swim northeast"},{"to":313,"exit":"south","move":"swim south"},{"to":315,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":315,"x":740,"y":-260,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["Putrid fumes rising from the swamp coalesce into a heavy blanket of black fog that flows all through the surrounding air, held in by the ceiling of twisted branches and vines above."],"exits":[{"to":215,"exit":"north","move":"swim north"},{"to":314,"exit":"northeast","move":"swim northeast"},{"to":311,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":316,"x":800,"y":-300,"z":0,"title":"Zaulfung, Dense Swamp","descriptions":["The structure to the east tapers, its surface curving smoothly to the northeast.  The stylized form of a hind leg is visible directly north, chiseled into the wall with some manner of primitive instruments that is far surpassed by more modern architectural feats."],"exits":[{"to":230,"exit":"north","move":"swim north"},{"to":314,"exit":"southwest","move":"swim southwest"},{"to":222,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":317,"x":720,"y":-100,"z":0,"title":"Zaulfung, Underwater","descriptions":["The murky waters end amongst a thick layer of decomposing sludge, heaped atop the uneven earth below.  Shadows rule here, allowing only a pale glimpse of the surroundings."],"exits":[{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"up","move":"up","hidden":true}],"linksTo":"Map31b_Maelshyve's_Fortress.xml"},
  {"id":318,"x":560,"y":-180,"z":0,"title":"Zaulfung, Swamp","descriptions":[],"exits":[{"to":319,"exit":"southeast","move":"southeast"},{"to":320,"exit":"south","move":"south"},{"to":0,"exit":"southwest","move":"southwest"},{"to":0,"exit":"north","move":"north"},{"to":0,"exit":"northeast","move":"northeast"},{"to":0,"exit":"west","move":"west"},{"to":321,"exit":"east","move":"east"},{"to":0,"exit":"go","move":"go curving path"}]},
  {"id":319,"x":580,"y":-160,"z":0,"title":"Zaulfung, Swamp","descriptions":[],"exits":[{"to":320,"exit":"west","move":"west"},{"to":321,"exit":"north","move":"north"},{"to":318,"exit":"northwest","move":"northwest"},{"to":0,"exit":"northeast","move":"northeast"},{"to":0,"exit":"south","move":"south"},{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"southwest","move":"southwest"}]},
  {"id":320,"x":560,"y":-160,"z":0,"title":"Zaulfung, Swamp","descriptions":[],"exits":[{"to":318,"exit":"north","move":"north"},{"to":319,"exit":"east","move":"east"},{"to":321,"exit":"northeast","move":"northeast"},{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"south","move":"south"},{"to":0,"exit":"southwest","move":"southwest"},{"to":0,"exit":"west","move":"west"},{"to":0,"exit":"northwest","move":"northwest"}]},
  {"id":321,"x":580,"y":-180,"z":0,"title":"Zaulfung, Swamp","descriptions":[],"exits":[{"to":320,"exit":"southwest","move":"southwest"},{"to":319,"exit":"south","move":"south"},{"to":318,"exit":"west","move":"west"},{"to":201,"exit":"climb","move":"climb sickly tree"},{"to":0,"exit":"northeast","move":"northeast"},{"to":0,"exit":"east","move":"east"},{"to":0,"exit":"southeast","move":"southeast"},{"to":0,"exit":"northwest","move":"northwest"}]},
  {"id":322,"x":800,"y":-150,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Dark basalt walls flecked with unidentifiable minerals glisten in the damp atmosphere.  Sharp rocks underfoot are slick with slimy lichen, slowing travel through this treacherous area."],"exits":[{"to":0,"exit":"south","move":"south"},{"to":0,"exit":"northwest","move":"northwest"},{"to":289,"exit":"go","move":"go amorphous spirits"}],"aliases":["Cleric Passage"],"linksTo":"Map31b_Maelshyve's_Fortress.xml"}
 ],
