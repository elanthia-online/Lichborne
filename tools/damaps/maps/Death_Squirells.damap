{
 "format": "damap",
 "version": 1,
 "id": "141",
 "name": "Death Squirells",
 "file": "Map141_deathsquirell.xml",
 "rooms": [
  {"id":1,"x":0,"y":0,"z":0,"title":"Marja Tee, Tula Veraja","descriptions":["Berry bushes and green shrubs grow between the trunks of elm and birch trees.  Sparrows flutter out of the high branches to light gracefully on a twig, grab a ripe berry, and wing back to their perches.  In the distant northwest a small village can be seen."],"exits":[{"to":2,"exit":"go","move":""},{"to":20,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":2,"x":20,"y":20,"z":0,"title":"Marja Tee, Musikaz Masi","descriptions":["Tracks left by wagons laden with heavy cargo mar the road with deep ruts.  A multitude of blackberry bushes, full of plump berries, mingle with a few scattered trees that line each side of this wide byway."],"exits":[{"to":3,"exit":"go","move":""},{"to":1,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":3,"x":40,"y":40,"z":0,"title":"Marja Tee, Musikaz Masi","descriptions":["The road crests a small hill covered with ripe blackberry bushes.  Dozens of squashed berries have been imbedded into the packed earth by the wheels of overloaded wagons.  Occasionally a bird swoops down to greedily grab a tiny black treasure from a mature bush."],"exits":[{"to":4,"exit":"go","move":""},{"to":2,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":4,"x":60,"y":40,"z":0,"title":"Marja Tee, Orjamakaz Niitto","descriptions":["Small shrubs growing in tight clumps line the road on both sides.  Nestled in the brush are dense clusters of briarberry bushes with tiny berries hanging from woody stems."],"exits":[{"to":5,"exit":"go","move":""},{"to":3,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":5,"x":80,"y":40,"z":0,"title":"Marja Tee, Orjamakaz Niitto","descriptions":["Meandering gently through a dense meadow, the road is evenly covered in tiny stones laid to smooth the rough terrain.  Endless rows of briarberry bushes, cultivated and harvested for their woody roots, border each side of the wide road."],"exits":[{"to":6,"exit":"go","move":""},{"to":4,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":6,"x":100,"y":20,"z":0,"title":"Marja Tee, Orjamakaz Niitto","descriptions":["The road continues its trek through the lush meadow.  Flowers of all kinds grow haphazardly among dense groupings of briarberry bushes filled with bright red berries.  Irrigation ditches filled with rainwater line both sides of the road."],"exits":[{"to":7,"exit":"go","move":""},{"to":5,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":7,"x":120,"y":0,"z":0,"title":"Marja Tee, Orjamakaz Niitto","descriptions":["A wooden cart filled with freshly dug briarberry bushes is parked on the side of the roadway.  Coveted for their woody roots in the making of tobacco pipes, briarberry bushes are carefully harvested annually by the local Olvi families of the area.  Deep in the meadow, you can see a small group of Olvi thinning the denser clumps."],"exits":[{"to":8,"exit":"go","move":""},{"to":6,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":8,"x":140,"y":20,"z":0,"title":"Marja Tee, Orjamakaz Niitto","descriptions":["The road narrows a little here, as briarberry bushes laden with heavy plump berries mingle with wild cinnamon shrubs that fight to reclaim this well traveled byway.  Scattered amidst the dense brush are a few birch and elm trees, with occasional clumps of pink clover peeking through the heavy brambles."],"exits":[{"to":9,"exit":"go","move":""},{"to":7,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":9,"x":160,"y":20,"z":0,"title":"Marja Tee, Girio Masi","descriptions":["Hardy, wild cinnamon shrubs grace both sides of the road as the path widens.  Their leathery leaves offer an open invitation to a mass influx of butterflies that migrate to this area in the spring.  Occasionally, the sound of small wildlife can be heard scurrying beneath the compact bushes."],"exits":[{"to":10,"exit":"go","move":""},{"to":8,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":10,"x":180,"y":20,"z":0,"title":"Marja Tee, Girio Masi","descriptions":["The road crests a small hill flanked by dense clumps of wild cinnamon shrubs.  A multitude of migrating butterflies can be seen fluttering amidst the bushes, their beautifully colored wings complimenting the deep green of the leathery leafed shrubs."],"exits":[{"to":11,"exit":"go","move":""},{"to":9,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":11,"x":200,"y":20,"z":0,"title":"Marja Tee, Marja Poosa Sappa","descriptions":["A shallow gully runs across the road at the bottom of a small hill.  Thick walls of bushes grow wildly like untamed hedgerows bordering the road."],"exits":[{"to":12,"exit":"go","move":""},{"to":10,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":12,"x":220,"y":0,"z":0,"title":"Marja Tee, Marja Poosa Sappa","descriptions":["The road here snakes through some of the thickest bushes and brambles.  Fragrant cinnamon mixes with sweet raspberry in a panoply of earthy, spiced scents."],"exits":[{"to":13,"exit":"go","move":""},{"to":11,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":13,"x":240,"y":20,"z":0,"title":"Marja Tee, Marja Poosa Sappa","descriptions":["Bushes and vines grow wildly, high enough to block out most of the sky.  The road dips and weaves through high bushes and snarls of vicious brambles."],"exits":[{"to":14,"exit":"go","move":""},{"to":12,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":14,"x":260,"y":0,"z":0,"title":"Marja Tee, Marja Poosa Sappa","descriptions":["The narrow road rises up to the peak of a small hill, rife with tangled bushes.  A broken, berry-stained wooden pail lies shattered on the side of the road."],"exits":[{"to":15,"exit":"go","move":""},{"to":13,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":15,"x":280,"y":0,"z":0,"title":"Marja Tee, Marja Poosa Sappa","descriptions":["The path glides gently down a low rise toward the open ocean.  A small step ladder stands to one side of the road, overcome by creeping vines of bramble and raspberry."],"exits":[{"to":16,"exit":"go","move":""},{"to":14,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":16,"x":300,"y":0,"z":0,"title":"Marja Tee, Kaber Jise","descriptions":["A soft breeze carries the faint scent of the sea from the east.  The road begins to widen as if to hasten travelers towards the shore.  Interspersed with bramble and berry bushes are wild sirese flowers, their bright blooms swaying gently in the wind."],"exits":[{"to":17,"exit":"go","move":""},{"to":15,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":17,"x":320,"y":0,"z":0,"title":"Marja Tee, Babukaz Masi","descriptions":["Dozens of wild raspberry bushes intermingled with clumps of sweet woodruff attempt to encroach upon the widening road.  Small woodland critters scamper beneath the brush, knocking ripe berries to the ground."],"exits":[{"to":18,"exit":"go","move":""},{"to":16,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":18,"x":340,"y":0,"z":0,"title":"Marja Tee, Babukaz Masi","descriptions":["Atop a small hill, the road crests just high enough to see a bay to the east.  The fresh smell from the sea is strong and mingles with the scent of ripe raspberries that hang from the many bushes attempting to trespass upon the widening road."],"exits":[{"to":19,"exit":"go","move":""},{"to":17,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":19,"x":360,"y":0,"z":0,"title":"Arthe Dale, Busar Saaf","descriptions":["A small harbor with several brightly painted docks cheerfully greets seafaring visitors to the small community of Arthe Dale.  A few seagulls can be seen greedily pecking at ripe berries pilfered from the many bushes that flank a road leading westward."],"exits":[{"to":18,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":20,"x":-20,"y":-20,"z":0,"title":"Marja Tee, Tula Veraja","descriptions":["A well-worn road winds its way through the valley, between a small town and the adjoining farmlands.  A proliferation of berry bushes crowds the edges as if trying to reclaim the portion of land heavily rutted by wagon and cart wheels.  To the north a village gate beckons weary travelers."],"exits":[{"to":21,"exit":"go","move":""},{"to":1,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":21,"x":-20,"y":-40,"z":0,"title":"Valley, Village Gate","descriptions":["A large gate stands here, usually open to welcome travelers -- but wisely capable of closing to defend the residents within.  Traders, adventurers and farmers from the surrounding valley mingle here, moving in or out of the village at a leisurely pace, many of them Halflings.  A wooden wagon, carrying racks of freshly-baked meat pies, trundles into the gates, followed by several yapping dogs.  A neatly painted wooden sign is displayed in a prominent place."],"exits":[{"to":0,"exit":"go","move":""}],"color":"#FFFFFF","linksTo":"Map7_NTR.xml"}
 ],
 "labels": []
}
