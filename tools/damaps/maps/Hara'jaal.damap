{
 "format": "damap",
 "version": 1,
 "id": "106",
 "name": "Hara'jaal",
 "file": "Map106_Hara'jaal.xml",
 "rooms": [
  {"id":1,"x":-40,"y":-100,"z":0,"title":"Beach, Hara'jaal","descriptions":["The black sand beach stretches to either side of a makeshift stone quay.  Piles of wood stand off to one side of a jerry-rigged hut.  A short distance from the shanty, a large dug out pit, encircled by black stones, is lined with the remains of many fires."],"exits":[{"to":2,"exit":"east","move":"east"},{"to":5,"exit":"south","move":"south"},{"to":6,"exit":"west","move":"west"}],"aliases":["Beach Dock"]},
  {"id":2,"x":-20,"y":-100,"z":0,"title":"Hara'jaal, Beach","descriptions":["The beach is extremely rocky through here.  Stiff sage grass grows in tight clumps in the black sands.  A sheer cliff closes off the shore from the rest of the island."],"exits":[{"to":3,"exit":"southeast","move":"southeast"},{"to":5,"exit":"southwest","move":"southwest"},{"to":1,"exit":"west","move":"west"}]},
  {"id":3,"x":0,"y":-80,"z":0,"title":"Hara'jaal, Beach","descriptions":["Wind-blasted shrubs edge the base of a sheer cliff that looms over the beach.  Very little coastline stands between the ocean and the tall precipice.  A number of bleached wooden skeletons, remnants of wrecked ships, lie broken amidst the tangles of surrounding brush."],"exits":[{"to":4,"exit":"southeast","move":"southeast"},{"to":2,"exit":"northwest","move":"northwest"}]},
  {"id":4,"x":20,"y":-60,"z":0,"title":"Hara'jaal, Beach","descriptions":["The beach ends at a sheer rock wall.  Withered roots and vines cover the cliff like a network of brown capillaries.  Cadaverous bushes hold a tenuous grip on the small amount of beach left by the ocean."],"exits":[{"to":3,"exit":"northwest","move":"northwest"},{"to":15,"exit":"climb","move":"climb up"}]},
  {"id":5,"x":-40,"y":-80,"z":0,"title":"Hara'jaal, Beach","descriptions":["An extremely steep mass of slick obsidian rises up and out of view.  Deep shadows pervade the area.  Very little of the beach is visible from here."],"exits":[{"to":1,"exit":"north","move":"north"},{"to":2,"exit":"northeast","move":"northeast"},{"to":6,"exit":"northwest","move":"northwest"},{"to":9,"exit":"go","move":"search;#send 4 go shadowed opening"}]},
  {"id":6,"x":-60,"y":-100,"z":0,"title":"Hara'jaal, Beach","descriptions":["Thick bushes, sun-scorched a dark brown, edge a steep cliff hiding the foot of the stone barrier.  The surf beats hard against the obsidian grit beach."],"exits":[{"to":1,"exit":"east","move":"east"},{"to":5,"exit":"southeast","move":"southeast"},{"to":7,"exit":"southwest","move":"southwest"}]},
  {"id":7,"x":-80,"y":-80,"z":0,"title":"Hara'jaal, Beach","descriptions":["The black sands of the beach stretch around thirty feet from the surf to a tall cliff.  Shrubs edge the steepness, blocking the view of the cliff's base."],"exits":[{"to":6,"exit":"northeast","move":"northeast"},{"to":8,"exit":"southwest","move":"southwest"}]},
  {"id":8,"x":-100,"y":-60,"z":0,"title":"Hara'jaal, Beach","descriptions":["The beach ends abruptly at a tall escarpment.  Thorny brush grows around the base of the steep rock wall.  Brown vines climb the wall along with a number of creepers that grip the steepness precariously."],"exits":[{"to":7,"exit":"northeast","move":"northeast"},{"to":26,"exit":"climb","move":"climb up"}]},
  {"id":9,"x":-40,"y":-60,"z":0,"title":"Hara'jaal, Old Lava Tube","descriptions":["A small beam of light streams down from high above, illuminating the ridged obsidian walls of the tunnel.  The damp air in this shaft smells vaguely of sulfur and strongly of mildew."],"exits":[{"to":5,"exit":"out","move":"out"},{"to":10,"exit":"climb","move":"climb shaft"}]},
  {"id":10,"x":-40,"y":-40,"z":0,"title":"Hara'jaal, Old Lava Tube","descriptions":["The walls of the tunnel fold outward to form a small platform with just enough room to stand on.  A muted light fills the shaft, coloring everything in shades of grey."],"exits":[{"to":11,"exit":"climb","move":"climb shaft"},{"to":9,"exit":"climb","move":"climb tube"}]},
  {"id":11,"x":-40,"y":-20,"z":0,"title":"Hara'jaal, Old Lava Tube","descriptions":["Sharp protrusions along the obsidian walls of the tunnel create precarious handholds, while the sulfurous residue underfoot causes the shadowy ledge jutting out from the shaft to be anything but a comfortable resting spot."],"exits":[{"to":12,"exit":"climb","move":"climb shaft"},{"to":10,"exit":"climb","move":"climb tube"}]},
  {"id":12,"x":-40,"y":0,"z":0,"title":"Hara'jaal, Old Lava Tube","descriptions":["Small pebbles shift and slide down the walls of the lava tube, quickly vanishing into the darkened abyss below.  Jagged chips of obsidian crunch underfoot, mute testament to the effort and determination needed to scale the shaft's heights."],"exits":[{"to":13,"exit":"climb","move":"climb shaft"},{"to":11,"exit":"climb","move":"climb tube"}]},
  {"id":13,"x":-40,"y":20,"z":0,"title":"Hara'jaal, Old Lava Tube","descriptions":["The shaft comes to an end at a small outcrop opposite a hole in the wall.  Fresh air and light pours in from the opening."],"exits":[{"to":14,"exit":"out","move":"out"},{"to":12,"exit":"climb","move":"climb tube"}]},
  {"id":14,"x":-40,"y":40,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The sandy beach is visible below at the foot of this tall cliff.  A steep slope leads down into a deep wooded thicket.  In the distance is the island's mother, an ancient mist-covered volcano, rising high above the forest's canopy.  The top of an old lava tube is barely discernible."],"exits":[{"to":13,"exit":"go","move":"go lava tube"},{"to":21,"exit":"climb","move":"climb slope"}]},
  {"id":15,"x":20,"y":-40,"z":0,"title":"A Steep Cliff","descriptions":["A narrow ledge offers a brief respite from the climb.  A fall from this height, unlikely to be fatal, would definitely be detrimental to a person's health and well-being."],"exits":[{"to":16,"exit":"climb","move":"script autoclimbup"},{"to":4,"exit":"climb","move":"script autoclimbdown"}]},
  {"id":16,"x":20,"y":-20,"z":0,"title":"A Steep Cliff","descriptions":["Sparse handholds provide a moment to catch a quick breath.  It is a sheer drop to the ground from here.  A network of brown and partially withered vines cover the rock face."],"exits":[{"to":17,"exit":"climb","move":"script autoclimbup"},{"to":15,"exit":"climb","move":"script autoclimbdown"}]},
  {"id":17,"x":20,"y":0,"z":0,"title":"A Steep Cliff","descriptions":["This slight perch is a dizzying height from the beach at the foot of the rocky precipice.  A puny black conifer hangs grimly by its feeble looking roots from the sheer overhang."],"exits":[{"to":18,"exit":"climb","move":"script autoclimbup"},{"to":16,"exit":"climb","move":"script autoclimbdown"}]},
  {"id":18,"x":20,"y":20,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The black sands of the beach are visible below at the foot of this obsidian and granite cliff.  A slight slope leads down into a deep wooded thicket.  In the distance is the island's mother, an ancient mist-covered volcano, rising high above the forest's canopy."],"exits":[{"to":19,"exit":"southwest","move":"southwest"},{"to":17,"exit":"climb","move":"script autoclimbdown"}]},
  {"id":19,"x":0,"y":40,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["A faint path opens up here from the south.  The ground slopes away from a tangled thicket heading up a steady but gradual incline to the northeast."],"exits":[{"to":18,"exit":"northeast","move":"northeast"},{"to":20,"exit":"go","move":"go faint path"}]},
  {"id":20,"x":-40,"y":80,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["Thick-growing brush closes around the barely visible path, throwing all into deep shadows.  Black branches, like cadaverous fingers, block the skies above."],"exits":[{"to":21,"exit":"north","move":"rt north"},{"to":19,"exit":"northeast","move":"rt northeast"},{"to":27,"exit":"south","move":"rt south"},{"to":22,"exit":"northwest","move":"rt northwest"},{"to":28,"exit":"go","move":"go thick-growing brush"}],"color":"#FFBF00"},
  {"id":21,"x":-40,"y":60,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["A faint path opens up into this clearing and leads into the tangled thicket in the south.  The ground slopes steeply to the north."],"exits":[{"to":20,"exit":"go","move":"go faint path"},{"to":14,"exit":"climb","move":"climb slope"}]},
  {"id":22,"x":-80,"y":40,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["A faint path opens up into this clearing on the edge of a tangled thicket.  The ground slopes to the northwest in a steady but gradual incline."],"exits":[{"to":23,"exit":"northwest","move":"northwest"},{"to":20,"exit":"go","move":"go faint path"}]},
  {"id":23,"x":-100,"y":20,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The beach and ocean are visible below at the foot of this tall cliff.  A slight slope leads down into a deep wooded thicket.  In the distance is the island's mother, an ancient mist-covered volcano, rising high above the forest's canopy."],"exits":[{"to":22,"exit":"southeast","move":"southeast"},{"to":24,"exit":"climb","move":"climb down"}]},
  {"id":24,"x":-100,"y":0,"z":0,"title":"A Steep Cliff","descriptions":["This slight perch is a dizzying height from the beach at the foot of the rocky precipice.  A spider web of vines covers the sheer surface of the overhang."],"exits":[{"to":25,"exit":"climb","move":"script autoclimbdown"},{"to":23,"exit":"climb","move":"script autoclimbup"}]},
  {"id":25,"x":-100,"y":-20,"z":0,"title":"A Steep Cliff","descriptions":["Sparse handholds provide a moment to catch a quick breath.  It is a sheer drop to the ground from here.  Small trees have a precarious hold on the rock face but still seem to squeak out a meager life."],"exits":[{"to":26,"exit":"climb","move":"script autoclimbdown"},{"to":24,"exit":"climb","move":"script autoclimbup"}]},
  {"id":26,"x":-100,"y":-40,"z":0,"title":"A Steep Cliff","descriptions":["A narrow ledge offers a brief respite from the climb.  A fall from this height, unlikely to be fatal, would definitely be detrimental to a person's health and well-being."],"exits":[{"to":8,"exit":"climb","move":"script autoclimbdown"},{"to":25,"exit":"climb","move":"script autoclimbup"}]},
  {"id":27,"x":-40,"y":100,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The pitch-black dirt of the ground is covered in dark green moss.  Thorny bushes along the faint trail give off a powerful stench of rot and mold."],"exits":[{"to":20,"exit":"north","move":"rt north"},{"to":29,"exit":"south","move":"rt south"}],"color":"#FFBF00"},
  {"id":28,"x":-60,"y":80,"z":0,"title":"A Hidden Grotto","descriptions":["Thick brush surrounds this bowl-shaped depression, hiding the outside world from view.  Tall stones, pockmarked with age, encircle an obsidian altar.  The air seems eerily still and empty of noise from the surrounding forest."],"exits":[{"to":20,"exit":"climb","move":"climb overgrown slope"}],"color":"#4080FF","aliases":["Shrine","Trothfang"]},
  {"id":29,"x":-40,"y":120,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["Brush closes in on every side of the trail like stout walls.  Large roots break through the black soil, causing the trail to fade in and out."],"exits":[{"to":27,"exit":"north","move":"rt north"},{"to":30,"exit":"south","move":"rt south"}],"color":"#FFBF00"},
  {"id":30,"x":-40,"y":140,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["Darkness shrouds the already faint trail as the surrounding trees' leafy boughs block the sky overhead.  Thorny vines, covering everything nearby, give off an acrid scent."],"exits":[{"to":29,"exit":"north","move":"rt north"},{"to":31,"exit":"southeast","move":"rt southeast"}],"color":"#FFBF00"},
  {"id":31,"x":-20,"y":160,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The trail opens up into a grassy glade.  A giant oak tree growing in the center of the clearing rises high above the forest canopy.  Black vines hang down from the foliage like dark curtains."],"exits":[{"to":34,"exit":"southeast","move":"southeast"},{"to":30,"exit":"northwest","move":"northwest"},{"to":32,"exit":"climb","move":"climb oak tree"}]},
  {"id":32,"x":0,"y":160,"z":0,"title":"Amo Potha Telga, A Tree","descriptions":["Thick limbs come together at the trunk, creating a natural cup-shaped platform.  Some of the branches stretch upward into the upper portion of the tree."],"exits":[{"to":33,"exit":"climb","move":"climb thick branch"},{"to":31,"exit":"climb","move":"climb tree trunk"}]},
  {"id":33,"x":20,"y":160,"z":0,"title":"Amo Potha Telga, A Tree","descriptions":["From atop the tree one can see over top of the forest's canopy which stretches in all directions like a great green carpet.  To the south the ancient volcano that gave birth to the island is seen rising over the woods."],"exits":[{"to":32,"exit":"climb","move":"climb thick branch"}]},
  {"id":34,"x":0,"y":180,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["Thick walls of vegetation surround the faint trail on every side.  The trees grow straight and tall, their dense foliage blocking out the sky."],"exits":[{"to":35,"exit":"south","move":"rt south"},{"to":31,"exit":"northwest","move":"rt northwest"}],"color":"#FFBF00"},
  {"id":35,"x":0,"y":200,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["Dense detritus covers the rough path, leaving only the protruding tree roots visible.  A number of sharp-thorned bushes line the barely visible trail."],"exits":[{"to":34,"exit":"north","move":"rt north"},{"to":36,"exit":"south","move":"rt south"}],"color":"#FFBF00"},
  {"id":36,"x":0,"y":220,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The thicket becomes impassable to the south, while clearing further to the east.  A dry wind blows through the dark foliage, carrying with it a sweet scent."],"exits":[{"to":35,"exit":"north","move":"rt north"},{"to":37,"exit":"east","move":"rt east"}],"color":"#FFBF00"},
  {"id":37,"x":20,"y":220,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The brush is thin through this area, making the trail much easier to navigate.  To the west, the forest phases into dense thickets filled with murky shadows."],"exits":[{"to":38,"exit":"east","move":"east"},{"to":36,"exit":"west","move":"west"}]},
  {"id":38,"x":40,"y":220,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["Large fingers of igneous rock, worn down by many years of erosion, border the trail as it makes it way eastward."],"exits":[{"to":39,"exit":"east","move":"east"},{"to":37,"exit":"west","move":"west"}]},
  {"id":39,"x":60,"y":220,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["Scrubby grasses grow in the cracks of the rocky trail.  A great mountain rises to the south, blocking out the sky with its impressive height."],"exits":[{"to":40,"exit":"south","move":"south"},{"to":38,"exit":"west","move":"west"}]},
  {"id":40,"x":60,"y":240,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The rough terrain makes the trail harder to navigate as it draws close to the foot of the island's volcanic mother.  Scrawny trees cover the mountain's craggy heights."],"exits":[{"to":39,"exit":"north","move":"north"},{"to":41,"exit":"south","move":"south"}]},
  {"id":41,"x":60,"y":260,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The trail is blocked to the south by the mountain's steep walls, forcing it to skirt the ancient volcano.  Massive protrusions and wafer-thin ledges of obsidian extend from the volcano's surface, overhanging the path like branches from a tree of smoked glass."],"exits":[{"to":40,"exit":"north","move":"north"},{"to":42,"exit":"southwest","move":"southwest"}]},
  {"id":42,"x":40,"y":280,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["A wide grassland is the only thing visible to the south and west from here.  The trail continues to circle around the mountain that takes up the whole of the eastern horizon."],"exits":[{"to":41,"exit":"northeast","move":"northeast"},{"to":43,"exit":"southwest","move":"southwest"}]},
  {"id":43,"x":20,"y":300,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["Black ridges of stone cross the trail, making it difficult to continue onward in places.  Sharp-leafed weeds grow up out of the cracks in the path."],"exits":[{"to":42,"exit":"northeast","move":"northeast"},{"to":44,"exit":"south","move":"south"}]},
  {"id":44,"x":20,"y":320,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The air smells vaguely of sulfur gasses through this area.  Withered trees seem to scavenge a meager existence on the slopes of the mountain, though how the scrawny things hold purchase on the craggy rocks is difficult to see."],"exits":[{"to":43,"exit":"north","move":"north"},{"to":45,"exit":"south","move":"south"}]},
  {"id":45,"x":20,"y":340,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["Following along the foot of the mountain to the north, the trail turns to the southeast here, away from the volcano.  A vast grassland can be seen further to the west and south, though there seems to be no clear way to reach it as of yet."],"exits":[{"to":44,"exit":"north","move":"north"},{"to":46,"exit":"southeast","move":"southeast"}]},
  {"id":46,"x":40,"y":360,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["Though still stunted, the vegetation seems to be finding greater purchase along the trail as it moves southeast.  The north is full of the majestic glory of the volcano that gave birth to the black sands of the island."],"exits":[{"to":47,"exit":"southeast","move":"southeast"},{"to":45,"exit":"northwest","move":"northwest"}]},
  {"id":47,"x":60,"y":380,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The trail turns east here, beginning a descent into a grass-filled valley.  To the north, the steep walls of the island's volcanic mother cause the path to turn westerly, skirting the mountain as it continues onward."],"exits":[{"to":48,"exit":"east","move":"east"},{"to":46,"exit":"northwest","move":"northwest"}]},
  {"id":48,"x":80,"y":380,"z":0,"title":"Hara'jaal, Amo Potha Telga","descriptions":["The trail pauses for a moment on top of this low hill.  To the north, one can still see the massive expanse of the volcano that gave rise to this island.  The south holds nothing but a vast grassland.  Close by, the thunder of a waterfall can barely be heard, echoing from some unseen valley."],"exits":[{"to":49,"exit":"south","move":"south"},{"to":47,"exit":"west","move":"west"}]},
  {"id":49,"x":80,"y":400,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["A slope leads down into a plain of tall blue-black grasses.  The grassland stretches far into the distance like a living sea, waving with the tiniest breeze.  To the north are the slopes of the island's mother, an ancient volcano."],"exits":[{"to":48,"exit":"north","move":"north"},{"to":197,"exit":"none","move":"climb slope"}]},
  {"id":50,"x":260,"y":540,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["Running water can be heard through the thick foliage to the east, though no clear trail leads in that direction.  The trees are thin and tall, competing for every bit of sunlight."],"exits":[{"to":52,"exit":"north","move":"north"},{"to":51,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":51,"x":260,"y":560,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The land slopes gently to the southwest, leading into a small valley.  Marshy patches of ground make the trail a bit difficult to negotiate at points."],"exits":[{"to":50,"exit":"north","move":"north"},{"to":53,"exit":"southwest","move":"southwest"}]},
  {"id":52,"x":260,"y":520,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["A grassland stretches far into the north while a vast river plain is visible to the south.  Sparse shrubbery lines a barely recognizable trail that leads towards the river.  To the north, the summit of the island's volcano is still visible."],"exits":[{"to":196,"exit":"north","move":"north"},{"to":50,"exit":"go","move":"go trail"}]},
  {"id":53,"x":240,"y":580,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["Small pools of stagnant water pervade this grass-covered depression.  Gnats swarm around the puddles of black sludge.  Squat, leafy trees encircle the dell, throwing the area into deep shadows."],"exits":[{"to":51,"exit":"northeast","move":"northeast"},{"to":54,"exit":"southwest","move":"southwest"}]},
  {"id":54,"x":220,"y":600,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The ground here begins to bank down into a small valley to the northeast.  A strong smell of rotting detritus drifts up from the shadowed glen.  Scattered shrubs close the gaps around the tall trees in the area, blocking most of the surroundings from view."],"exits":[{"to":53,"exit":"northeast","move":"northeast"},{"to":55,"exit":"south","move":"south"}]},
  {"id":55,"x":220,"y":620,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["To the southeast, a tree-covered hillock rises up, crowned with a finger of rock that is visible over the treetops.  A tall thicket runs along the trail that continues south."],"exits":[{"to":54,"exit":"north","move":"north"},{"to":56,"exit":"south","move":"south"}],"color":"#008000"},
  {"id":56,"x":220,"y":640,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The trail cuts a tunnel through the rugged copse, bypassing a dense thicket of thorny vines that blocks the way south and skirts a hillock to the northeast.  Some black sap, dripping from the vines, is giving off a pungent aroma."],"exits":[{"to":55,"exit":"north","move":"north"},{"to":57,"exit":"east","move":"east"}],"color":"#008000"},
  {"id":57,"x":240,"y":640,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["Sounds of running water are coming out of the east.  A dark thicket rises up in the west, the vague trail disappearing within it."],"exits":[{"to":58,"exit":"east","move":"east"},{"to":56,"exit":"west","move":"west"}],"color":"#008000"},
  {"id":58,"x":260,"y":640,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The path opens up into a sandy clearing, with the black waters of the Seord Fal visible through the bushes that line the riverbank.  Gaunt cypress knees covered in grey-green algae surround a large moss-covered cypress tree growing on the edge of the glade."],"exits":[{"to":59,"exit":"southwest","move":"southwest"},{"to":57,"exit":"west","move":"west"},{"to":116,"exit":"climb","move":"climb cypress tree"}]},
  {"id":59,"x":240,"y":660,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The track runs along a steep cliff that borders a dark river.  Lush bushes grow along the top of the rocky overhang.  A large cypress tree can be seen over the other treetops to the northeast."],"exits":[{"to":58,"exit":"northeast","move":"northeast"},{"to":60,"exit":"south","move":"south"},{"to":71,"exit":"climb","move":"climb steep cliff"}]},
  {"id":60,"x":240,"y":680,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The land slopes to the southeast towards the river, which burbles loudly in the distance.  Black boulders, overgrown with thick vines, stick up out of the ground, merging into a tall cliff to the north."],"exits":[{"to":59,"exit":"north","move":"north"},{"to":61,"exit":"southeast","move":"southeast"}]},
  {"id":61,"x":260,"y":700,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["A sheer cliff sweeps up to the west, blocking the view.  The trail runs along the muddy riverside here, with tall sedge grass blocking the view of the black waters."],"exits":[{"to":62,"exit":"south","move":"south"},{"to":60,"exit":"northwest","move":"northwest"},{"to":122,"exit":"climb","move":"climb sedge grass"}]},
  {"id":62,"x":260,"y":720,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["Tall banks of sedge grass border the swift waters of the Seord Fal as its runs along the trail here.  The rumbling of the water's currents fill the area with its noise."],"exits":[{"to":61,"exit":"north","move":"north"},{"to":63,"exit":"south","move":"south"},{"to":123,"exit":"climb","move":"climb sedge grass"}]},
  {"id":63,"x":260,"y":740,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The black waters of the Seord Fal can be seen through the tall banks of sedge grass that grow along the river's edge.  Marshy ground makes the trail slippery as it continues to the north and south."],"exits":[{"to":62,"exit":"north","move":"north"},{"to":64,"exit":"south","move":"south"},{"to":124,"exit":"climb","move":"climb sedge grass"}]},
  {"id":64,"x":260,"y":760,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["Sedge grass borders the riverbank, blocking all but glimpses of the river's murky water.  The trail rises to the southwest, climbing to the top of a wooded hillock."],"exits":[{"to":63,"exit":"north","move":"north"},{"to":65,"exit":"southwest","move":"southwest"},{"to":125,"exit":"climb","move":"climb sedge grass"}]},
  {"id":65,"x":240,"y":780,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The path opens into a grassy clearing atop this hill.  One can see the ocean in the far distance to the south and the Seord Fal just over the cliff to the east."],"exits":[{"to":64,"exit":"northeast","move":"northeast"},{"to":66,"exit":"southwest","move":"southwest"},{"to":126,"exit":"climb","move":"climb steep cliff"}]},
  {"id":66,"x":220,"y":800,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The trail becomes more defined as it heads south while the forest becomes denser to the north.  Dark verdant bushes, with prickly leaves, grow on both sides of the path.  The burble of running water can be heard coming from the east."],"exits":[{"to":65,"exit":"northeast","move":"northeast"},{"to":67,"exit":"south","move":"south"},{"to":133,"exit":"go","move":"go slippery slope"}]},
  {"id":67,"x":220,"y":820,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["A black ridge fills the horizon to the south with the signs of civilization.  A partially destroyed hut on the side of the road is visible in that direction."],"exits":[{"to":66,"exit":"north","move":"north"},{"to":68,"exit":"south","move":"south"}]},
  {"id":68,"x":220,"y":840,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["A tall ridge cuts across the landscape, forcing the path to circle around it to the southeast.  Sharp-edged grasses border the trail along with a number of thick-leafed, thorny bushes."],"exits":[{"to":67,"exit":"north","move":"north"},{"to":69,"exit":"southeast","move":"southeast"},{"to":168,"exit":"go","move":"go faint path"}]},
  {"id":69,"x":240,"y":860,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The swift currents of the Seord Fal are visible to the east while a huge wall of obsidian and granite rises high to the west.  The path passes between these two natural obstructions.  A walled town is visible to the south beyond the ridgeline."],"exits":[{"to":70,"exit":"southwest","move":"southwest"},{"to":68,"exit":"northwest","move":"northwest"}]},
  {"id":70,"x":220,"y":880,"z":0,"title":"Hara'jaal, Fal Daelfa","descriptions":["The trail runs right up to a wood and iron palisade gate.  All the foliage has been cleared around the wall's perimeter.  The town, huddled tight against the side of a cliff, uses the area's natural fortifications to create a strong defensive position.  A mountainous ridge rises to the north and continues over the horizon to the west."],"exits":[{"to":69,"exit":"northeast","move":"northeast"},{"to":79,"exit":"go","move":"go palisade gate"}]},
  {"id":71,"x":200,"y":660,"z":0,"title":"Hara'jaal, Nardel Aesker","descriptions":["Weathered expanses of light grey ignimbrite create a wide ledge atop a massive escarpment.  On clear days, the immense dome of sky meeting sea creates the illusion that the shore hundreds of feet below is farther away.  Faint glints and glimmers of sunlight reflected off the raging black waters of the Seord Fal filter through the heavy brush lining its banks, while the dormant peak of Nardel Aesker looms overhead.","Weathered expanses of light grey ignimbrite create a wide ledge atop a massive escarpment.  On cloudless nights, the glittering expanse of stars overhead cause the shadowed outlines of the land far below to seem even farther away than merely hundreds of feet straight down.  The stillness of the night makes it possible to hear a faint echo from the raging black waters of the Seord Fal, while the dormant peak of Nardel Aesker looms overhead."],"exits":[{"to":72,"exit":"west","move":"west"},{"to":59,"exit":"climb","move":"climb massive escarpment"}]},
  {"id":72,"x":180,"y":660,"z":0,"title":"Hara'jaal, Nardel Aesker","descriptions":["A thick ledge of heavily textured ignimbrite curves toward the west, creating a treacherous path that angles up the sloping sides of the volcano.  Greyish-green tufts of scraggly bushes struggle to gain secure footing amidst the rifts left behind as silent testimonies of ancient eruptions, creating homes for the hardy wildlife attempting to make the rocky crevices their home.","A thick ledge of heavily textured ignimbrite curves toward the west, creating a treacherous path that angles up the sloping sides of the volcano.  Dark shadows obscure the shapes of scraggly bushes struggling to gain secure footing amidst the rifts left behind as silent testimonies of ancient eruptions."],"exits":[{"to":71,"exit":"east","move":"east"},{"to":73,"exit":"northwest","move":"northwest"}]},
  {"id":73,"x":160,"y":640,"z":0,"title":"Hara'jaal, Nardel Aesker","descriptions":["Small pebbles and glistening fragments of basalt crunch underfoot.  Stark grey remnants of petrified trees partially hide a deep fissure in the cliff side, its shadowed depths creating a natural chimney up the side of the volcano.","Small pebbles and glistening fragments of basalt echo softly in the dark night as they crunch underfoot.  Stark grey remnants of petrified trees partially hide a deep fissure in the cliff, its shadowed depths creating a natural chimney up the side of the volcano."],"exits":[{"to":72,"exit":"southeast","move":"southeast"},{"to":74,"exit":"northwest","move":"northwest"}]},
  {"id":74,"x":140,"y":620,"z":0,"title":"Hara'jaal, Nardel Aesker","descriptions":["Scraggly bushes cling to crevices in the dark glassy volcanic rock, creating a tenuous habitat for the hardy wildlife struggling to make this barren land its home.  Tiny scrapings of sharp claws digging into the rock can be heard skittering from hiding places in ledges above to havens in the fissures below.","Pale streams of light filtering down from the nighttime sky outline scraggly bushes clinging to crevices in the dark glassy volcanic rock that create a tenuous habitat for the hardy wildlife struggling to make this barren land its home.  Tiny scrapings of sharp claws digging into the rock can be heard skittering from hiding places in the ledges above to havens in the fissures below."],"exits":[{"to":73,"exit":"southeast","move":"southeast"},{"to":75,"exit":"northwest","move":"northwest"}]},
  {"id":75,"x":120,"y":600,"z":0,"title":"Hara'jaal, Nardel Aesker","descriptions":["A lone stand of trees prevails amidst vast swaths of destruction.  Towering above the rifts left behind by the hardening rhyolite of ancient volcanic landslides, the verdant tops of the stately evergreens create a dramatic contrast to the grey ignimbrite and black basalt of the surrounding landscape.","A lone stand of trees prevails amidst vast swaths of destruction.  Soft starlight turns the tops of the stately evergreens towering above the rifts left behind by the hardening rhyolite of an ancient volcanic landslide into ghostly giants."],"exits":[{"to":74,"exit":"southeast","move":"southeast"},{"to":76,"exit":"northwest","move":"northwest"}]},
  {"id":76,"x":100,"y":580,"z":0,"title":"Hara'jaal, Nardel Aesker","descriptions":["Dead brown pine needles cover the ground, and dry twigs buried in the thick carpet of fallen needles snap loudly underfoot.  Overhead, the sunlight filters through thick branches, causing the jutting granite rifts to be covered in a greyish-green lichen.  A path winding between the towering evergreens leads north up the sloping side of the dormant volcano.","Dead brown pine needles cover the ground, and dry twigs buried in the thick carpet of fallen needles snap loudly underfoot.  Overhead, thick branches cast shadows against the jutting granite rifts covered in a greyish-green lichen.  A path winding between the towering evergreens leads north up the sloping side of the dormant volcano."],"exits":[{"to":77,"exit":"north","move":"north"},{"to":75,"exit":"southeast","move":"southeast"}]},
  {"id":77,"x":100,"y":560,"z":0,"title":"Hara'jaal, Nardel Aesker","descriptions":["Sharp bits of lapilli shift underfoot, making the steep slope of the trail winding ever upward along the volcano's side even more treacherous.  The ground trembles slightly causing the nearby stand of trees to lurch and sway as if marking the passage of giant footsteps.","Sharp bits of lapilli shift underfoot, making the steep slope of the trail winding ever upward along the volcano's side even more treacherous.  Shadowy outlines of the trees below stretch across the basalt surface of the cliff creating monstrous images that lurch and sway with each brush of a passing breeze."],"exits":[{"to":78,"exit":"north","move":"north"},{"to":76,"exit":"south","move":"south"}]},
  {"id":78,"x":100,"y":540,"z":0,"title":"Hara'jaal, Nardel Aesker","descriptions":["A massive rock slide blocks all attempts at ascending the volcano from this point.  A thick ledge lies just out of reach to the east, but the glassy sheen of quartz glinting in the mirrored inky black surface of the basalt that separates this ledge from that one discourages any thought of accessing it from here.","A massive rock slide blocks all attempts at ascending the volcano from this point.  The shadowy presence of a thick ledge just out of reach to the east seems to continue higher up the side of the volcano.  However, the glassy sheen of moonlight glinting against the quartz in the mirrored inky black surface of the basalt that separates this ledge from that one discourages any thought of accessing it from here."],"exits":[{"to":77,"exit":"south","move":"south"}]},
  {"id":79,"x":20,"y":620,"z":0,"title":"The Enclave, Dinshek Sango","descriptions":["The palisade gate, a sturdy construction of wood and iron, stands open to allow for traffic in and out of the town.  A couple of shabbily dressed guards keep a sharp eye on people that approach the gate."],"exits":[{"to":80,"exit":"southwest","move":"southwest"},{"to":70,"exit":"go","move":"go palisade gate"}]},
  {"id":80,"x":0,"y":640,"z":0,"title":"The Enclave, Bonfa Jegu","descriptions":["The road here is very muddy, slowing progress for those who follow it under the wall's parapet towards the town gate.  Slits along the walls and overhead have been strategically placed to fire missiles at any unwanted visitors."],"exits":[{"to":79,"exit":"northeast","move":"northeast"},{"to":85,"exit":"south","move":"south"},{"to":84,"exit":"southwest","move":"southwest"},{"to":81,"exit":"west","move":"west"},{"to":195,"exit":"go","move":"go iron door"}]},
  {"id":81,"x":-20,"y":640,"z":0,"title":"The Enclave, Athor Boren","descriptions":["All of the buildings along this cobblestone street have been built flush to the town's wall to provide better protection.  The structures are in a much better state of repair then others in the town."],"exits":[{"to":80,"exit":"east","move":"east"},{"to":84,"exit":"south","move":"south"},{"to":82,"exit":"west","move":"west"},{"to":193,"exit":"go","move":"go trimmed door"}]},
  {"id":82,"x":-40,"y":640,"z":0,"title":"The Enclave, Athor Boren","descriptions":["This stretch of road is clear of buildings, giving the area an almost run-down appearance.  The parapet that runs along the top of the town's wall is wider here, overhanging the street."],"exits":[{"to":81,"exit":"east","move":"east"},{"to":83,"exit":"southwest","move":"southwest"},{"to":115,"exit":"climb","move":"climb wooden ladder"}]},
  {"id":83,"x":-60,"y":660,"z":0,"title":"The Enclave, Raenaden Jegu","descriptions":["A brick manor, fenced round with a monstrosity of iron, fills up the entire side of this section of street.  Shabbily dressed guards loiter around the stoop of the house.  Lamps, mounted along the length of the manor's fence, illuminate the estate with bright pools of light."],"exits":[{"to":82,"exit":"northeast","move":"northeast"},{"to":91,"exit":"southeast","move":"southeast"},{"to":92,"exit":"southwest","move":"southwest"},{"to":189,"exit":"go","move":"go brick manor"}]},
  {"id":84,"x":-20,"y":660,"z":0,"title":"The Enclave, Bonfa Jegu","descriptions":["A house built from mismatched planks of wood stands along this section of road.  Colorful cloth of all sorts hang on a whitewashed slat fence that surrounds the building."],"exits":[{"to":81,"exit":"north","move":"north"},{"to":80,"exit":"northeast","move":"northeast"},{"to":85,"exit":"east","move":"east"},{"to":91,"exit":"southwest","move":"southwest"},{"to":194,"exit":"go","move":"go driftwood door"}]},
  {"id":85,"x":0,"y":660,"z":0,"title":"The Enclave, Naen Boren","descriptions":["The dark cobblestone road runs parallel to the town's tall defensive wall.  Whether the wall has been built to keep the wilderness out or the Baron's minions in is a matter of opinion."],"exits":[{"to":80,"exit":"north","move":"north"},{"to":86,"exit":"south","move":"south"},{"to":84,"exit":"west","move":"west"}]},
  {"id":86,"x":0,"y":680,"z":0,"title":"The Enclave, Naen Boren","descriptions":["The muddy road here runs between the town's wall and the back of some ramshackle buildings.  Streaks of black pitch stain the walls and the few intact cobblestones of the street."],"exits":[{"to":85,"exit":"north","move":"north"},{"to":87,"exit":"south","move":"south"},{"to":110,"exit":"climb","move":"climb wooden ladder"}]},
  {"id":87,"x":0,"y":700,"z":0,"title":"The Enclave, Naen Boren","descriptions":["Large chunks are missing from the cobblestone street, creating dangerous potholes in the road.  Part of the wood platform that runs along the top of the wall sags dangerously overhead."],"exits":[{"to":86,"exit":"north","move":"north"},{"to":89,"exit":"south","move":"south"},{"to":88,"exit":"west","move":"west"},{"to":186,"exit":"go","move":"go building"}]},
  {"id":88,"x":-20,"y":700,"z":0,"title":"The Enclave, Raenaden Jegu","descriptions":["A few rough looking warehouses line the road along this area.  The buildings are surrounded with a tall wooden fence, topped with sharp spikes."],"exits":[{"to":87,"exit":"east","move":"east"},{"to":89,"exit":"southeast","move":"southeast"},{"to":90,"exit":"south","move":"south"},{"to":91,"exit":"northwest","move":"northwest"},{"to":181,"exit":"go","move":"go wooden door"}]},
  {"id":89,"x":0,"y":720,"z":0,"title":"The Enclave, Raenaden Jegu","descriptions":["The wharfs are visible to the southeast from this cobblestone crossroad.  A suspension bridge hangs over the street connecting walkways that line the town's walls.  Steady streams of traffic move in and out of a small tavern located on one of the corners."],"exits":[{"to":87,"exit":"north","move":"north"},{"to":98,"exit":"southeast","move":"southeast"},{"to":90,"exit":"west","move":"west"},{"to":88,"exit":"northwest","move":"northwest"},{"to":182,"exit":"go","move":"go small tavern"}]},
  {"id":90,"x":-20,"y":720,"z":0,"title":"The Enclave, Jaalfilt Jegu","descriptions":["Everything along this part of town is soot covered.  Smoke, pouring from the chimneys of a shop on this street, seems to be the culprit.  Even the cobblestones of the roadway are stained a much darker color."],"exits":[{"to":88,"exit":"north","move":"north"},{"to":89,"exit":"east","move":"east"},{"to":97,"exit":"west","move":"west"},{"to":179,"exit":"go","move":"go shop"}]},
  {"id":91,"x":-40,"y":680,"z":0,"title":"The Enclave, Raenaden Jegu","descriptions":["A small building, rising in the center of this dusty intersection, is surrounded by shabbily dressed guards.  The building has iron bars on the windows and a fence of sharp wooden stakes."],"exits":[{"to":84,"exit":"northeast","move":"northeast"},{"to":88,"exit":"southeast","move":"southeast"},{"to":94,"exit":"southwest","move":"southwest"},{"to":83,"exit":"northwest","move":"northwest"},{"to":173,"exit":"go","move":"go small building"}]},
  {"id":92,"x":-80,"y":680,"z":0,"title":"The Enclave, Athor Boren","descriptions":["A quaint cottage has been constructed against the sheer rock cliff that serves as the town's back wall.  Well-kept flower beds line both the street in front of the small house and the brick walkway that leads to the dwelling's white painted door."],"exits":[{"to":83,"exit":"northeast","move":"northeast"},{"to":93,"exit":"south","move":"south"},{"to":188,"exit":"go","move":"go quaint cottage"}]},
  {"id":93,"x":-80,"y":700,"z":0,"title":"The Enclave, Athor Boren","descriptions":["A steep cliff rises along this edge of the town, acting as a back wall.  Little rivulets of water flow briskly down the overhanging face of rock, providing moisture for the tufts of grass growing up through the cracks in the cobblestones."],"exits":[{"to":92,"exit":"north","move":"north"},{"to":94,"exit":"east","move":"east"},{"to":95,"exit":"south","move":"south"},{"to":175,"exit":"go","move":"go wood shack"}]},
  {"id":94,"x":-60,"y":700,"z":0,"title":"The Enclave, Bonfa Jegu","descriptions":["A few rough looking warehouses line the road along this area.  The buildings are surrounded with a tall metal fence, topped with sharp spikes."],"exits":[{"to":91,"exit":"northeast","move":"northeast"},{"to":96,"exit":"south","move":"south"},{"to":95,"exit":"southwest","move":"southwest"},{"to":93,"exit":"west","move":"west"}]},
  {"id":95,"x":-80,"y":720,"z":0,"title":"The Enclave, Jaalfilt Jegu","descriptions":["Stacks of barrels and crates fill this corner of town.  A massive heap of trash is piled up outside of a large building.  Thick black smoke billows out of a huge brick smokestack built against the structure."],"exits":[{"to":93,"exit":"north","move":"north"},{"to":94,"exit":"northeast","move":"northeast"},{"to":96,"exit":"east","move":"east"},{"to":103,"exit":"climb","move":"climb wooden ladder"}]},
  {"id":96,"x":-60,"y":720,"z":0,"title":"The Enclave, Jaalfilt Jegu","descriptions":["A sickly yellow building built on this intersection has a rough chimney spewing unhealthy looking brown smoke that stinks of rotten flesh.  The cobblestones of the road are stained with sallow patches."],"exits":[{"to":94,"exit":"north","move":"north"},{"to":97,"exit":"east","move":"east"},{"to":95,"exit":"west","move":"west"},{"to":176,"exit":"go","move":"go building"}]},
  {"id":97,"x":-40,"y":720,"z":0,"title":"The Enclave, Jaalfilt Jegu","descriptions":["Dark blotches and oily stains cover the street, the town wall, and the backs of the buildings.  The whole area smells rank with the fumes coming from nearby businesses."],"exits":[{"to":90,"exit":"east","move":"east"},{"to":96,"exit":"west","move":"west"}]},
  {"id":98,"x":20,"y":740,"z":0,"title":"The Enclave, Smuggler's Wharf","descriptions":["Ships of all sizes are tied up to these docks that extend well into the protected bay.  Shabbily dressed guards keep a sharp eye on the pier entrances.  Shipment crates are stacked up under tattered canvas shelters that line the wharf area."],"exits":[{"to":89,"exit":"northwest","move":"northwest"},{"to":99,"exit":"go","move":"go shimmering archway"},{"to":100,"exit":"go","move":"go wharf"}]},
  {"id":99,"x":60,"y":760,"z":0,"title":"Droughtman's Maze, The Opal Lounge","descriptions":["The lighting here is dim, but not enough to obscure the opalescent wallpaper.  Couches and upholstered chairs in every shade of the rainbow are scattered around the room in groups, surrounding tables set with food.  A bar occupies one wall, which is hung with a mirror that only magnifies the maelstrom of color in the room.  One has to wonder, is the decor an attempt at opulence, or is it intended to induce patrons to drink more, just to blunt their senses?"],"exits":[{"to":0,"exit":"east","move":"east"},{"to":0,"exit":"west","move":"west"},{"to":98,"exit":"go","move":"go d-shaped door"}],"aliases":["Arch"],"linksTo":"MapTF1_The_Arch.xml"},
  {"id":100,"x":20,"y":760,"z":0,"title":"Smuggler's Wharf","descriptions":["The dock is strongly constructed of long planks that have been stained with a tar mixture to provide some weather protection.  Crates, stacked up along the length of the wharf, are covered with heavy canvas tarps."],"exits":[{"to":101,"exit":"south","move":"south"},{"to":102,"exit":"west","move":"west"},{"to":98,"exit":"go","move":"go ramp"}]},
  {"id":101,"x":20,"y":780,"z":0,"title":"Sumilo Dock","descriptions":["The platform of the dock is wrapped around with a thick, spongy material that protects it from being damaged when ships pull up.  The dock planks are deeply scarred from the loading and unloading of cargo."],"exits":[{"to":100,"exit":"north","move":"north"}],"aliases":["Sumilo Dock"]},
  {"id":102,"x":0,"y":760,"z":0,"title":"Smuggler's Wharf","descriptions":["Huge pilings that support the dock are reinforced with bands of iron.  Thick cables run between posts set along the edge of the dock, guarding against accidental falls."],"exits":[{"to":100,"exit":"east","move":"east"}]},
  {"id":103,"x":-80,"y":740,"z":0,"title":"The Enclave, South Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the ocean and any approaching ships.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":104,"exit":"east","move":"east"},{"to":95,"exit":"climb","move":"climb wooden ladder"}],"color":"#FF0000","aliases":["Tail Tattoos"]},
  {"id":104,"x":-60,"y":740,"z":0,"title":"The Enclave, South Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the ocean and any approaching ships.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":105,"exit":"east","move":"east"},{"to":103,"exit":"west","move":"west"}]},
  {"id":105,"x":-40,"y":740,"z":0,"title":"The Enclave, South Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the ocean and any approaching ships.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":106,"exit":"east","move":"east"},{"to":104,"exit":"west","move":"west"}]},
  {"id":106,"x":-20,"y":740,"z":0,"title":"The Enclave, South Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the ocean and any approaching ships.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":107,"exit":"east","move":"east"},{"to":105,"exit":"west","move":"west"}]},
  {"id":107,"x":0,"y":740,"z":0,"title":"The Enclave, South Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the city's dock area.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":106,"exit":"west","move":"west"},{"to":108,"exit":"go","move":"go hanging bridge"}]},
  {"id":108,"x":20,"y":720,"z":0,"title":"The Enclave, East Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the city's dock area.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":109,"exit":"north","move":"north"},{"to":107,"exit":"go","move":"go hanging bridge"}]},
  {"id":109,"x":20,"y":700,"z":0,"title":"The Enclave, East Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the eastern cliffs that enclose the island.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":110,"exit":"north","move":"north"},{"to":108,"exit":"south","move":"south"}]},
  {"id":110,"x":20,"y":680,"z":0,"title":"The Enclave, East Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the eastern cliffs that enclose the island.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":111,"exit":"north","move":"north"},{"to":109,"exit":"south","move":"south"},{"to":86,"exit":"climb","move":"climb wooden ladder"}]},
  {"id":111,"x":20,"y":640,"z":0,"title":"The Enclave, East Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the main gate that leads out to the island's interior.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":110,"exit":"south","move":"south"},{"to":112,"exit":"go","move":"go hanging bridge"}]},
  {"id":112,"x":0,"y":620,"z":0,"title":"The Enclave, North Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the main gate that leads out to the island's interior.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":113,"exit":"west","move":"west"},{"to":111,"exit":"go","move":"go hanging bridge"}]},
  {"id":113,"x":-20,"y":620,"z":0,"title":"The Enclave, North Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the surrounding wilderness.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":112,"exit":"east","move":"east"},{"to":114,"exit":"west","move":"west"}]},
  {"id":114,"x":-40,"y":620,"z":0,"title":"The Enclave, North Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the surrounding wilderness.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":113,"exit":"east","move":"east"},{"to":115,"exit":"west","move":"west"}]},
  {"id":115,"x":-60,"y":620,"z":0,"title":"The Enclave, North Wall","descriptions":["This wooden platform runs along the top of the wall, giving the city's guard a good view of the surrounding wilderness.  A metal railing on the interior edge guards against accidental falls from this height."],"exits":[{"to":114,"exit":"east","move":"east"},{"to":82,"exit":"climb","move":"climb wooden ladder"}]},
  {"id":116,"x":280,"y":640,"z":0,"title":"Hara'jaal, Cypress Tree","descriptions":["The deep gouges time and weather have left in the trunk of this tree create an inviting perch for surveying the glade below.  The splintered remains of one hefty branch lean precariously against the tree while the dark waters of the river swirl around its algae covered end."],"exits":[{"to":58,"exit":"climb","move":"climb tree trunk"},{"to":117,"exit":"climb","move":"climb large branch"}]},
  {"id":117,"x":300,"y":640,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The water becomes somewhat shallower through here as it sweeps southward, increasing speed as the river narrows.  The clamor of a nearby waterfall can be easily distinguished as coming from upstream.","The water becomes somewhat shallower through here as it sweeps southward, increasing speed as the river narrows before plunging over a steep barricade of jammed logs and other debris.  The clamor of a nearby waterfall can be easily distinguished as coming from upstream."],"exits":[{"to":118,"exit":"north","move":"swim north"},{"to":148,"exit":"northeast","move":"swim northeast"},{"to":149,"exit":"east","move":"swim east"},{"to":116,"exit":"climb","move":"climb cypress branch"}],"color":"#0000FF"},
  {"id":118,"x":300,"y":620,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["A dark slab of stone hangs over the water where the river has relentlessly worn away at the bank.  The churning of the currents has a musical, almost hypnotic rhythm."],"exits":[{"to":119,"exit":"north","move":"swim north"},{"to":147,"exit":"northeast","move":"swim northeast"},{"to":148,"exit":"east","move":"swim east"},{"to":149,"exit":"southeast","move":"swim southeast"},{"to":117,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":119,"x":300,"y":600,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["A small but steep waterfall empties across the breadth of the river, churning the black waters.  The muddy bank provides no way to reach the shore along here.  Sharp rocks poke through the river's surface, making the swift currents even more dangerous."],"exits":[{"to":147,"exit":"east","move":"swim east"},{"to":148,"exit":"southeast","move":"swim southeast"},{"to":118,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":120,"x":300,"y":660,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The racing stream thunders against the riverbank, throwing up sheets of white-capped water.  Trees, growing along the river's edge, seem to lean away from the ongoing chaos of the rapids.","The racing stream thunders against the riverbank, throwing up sheets of white-capped water.  Trees, growing along the river's edge, seem to lean away from the ongoing chaos of the rapids formed as the torrents pour over a barricade to the north."],"exits":[{"to":150,"exit":"east","move":"swim east"},{"to":151,"exit":"southeast","move":"swim southeast"},{"to":121,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":121,"x":300,"y":680,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The river rages, spinning out small whirlpools and dangerous eddies.  Mud and water spray up out of the crashing waves."],"exits":[{"to":120,"exit":"north","move":"swim north"},{"to":150,"exit":"northeast","move":"swim northeast"},{"to":151,"exit":"east","move":"swim east"},{"to":152,"exit":"southeast","move":"swim southeast"},{"to":122,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":122,"x":300,"y":700,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The black river beats roughly against tall patches of sedge grass that is growing along the riverbank.  Rocks, jutting out of the water, make the currents quite choppy in places.","The black river beats roughly against tall patches of sedge grass growing along the riverbank.  Rocks, jutting out of the water, make the currents quite choppy and provide a foundation for an enormous logjam to grow, which blocks further passage downstream."],"exits":[{"to":121,"exit":"north","move":"swim north"},{"to":151,"exit":"northeast","move":"swim northeast"},{"to":152,"exit":"east","move":"swim east"},{"to":123,"exit":"south","move":"swim south"},{"to":61,"exit":"climb","move":"climb sedge grass"}],"color":"#0000FF"},
  {"id":123,"x":300,"y":720,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Sedge grass grows tall along the riverbank, blocking most of the muddy shore from view.  The sound of the swift-moving water fills the area with its loud rumbling."],"exits":[{"to":122,"exit":"north","move":"swim north"},{"to":152,"exit":"northeast","move":"swim northeast"},{"to":62,"exit":"climb","move":"climb sedge grass"}],"color":"#0000FF"},
  {"id":124,"x":300,"y":740,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The black waters of the Seord Fal run swiftly on its course.  Trees, overhanging the riverbanks, send their branches down to brush against the water's surface.","The black waters of the Seord Fal run swiftly on its course.  Trees overhanging the riverbanks send their branches down to brush against the water's surface."],"exits":[{"to":153,"exit":"northeast","move":"swim northeast"},{"to":154,"exit":"east","move":"swim east"},{"to":145,"exit":"southeast","move":"swim southeast"},{"to":125,"exit":"south","move":"swim south"},{"to":63,"exit":"climb","move":"climb sedge grass"}],"color":"#0000FF"},
  {"id":125,"x":300,"y":760,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Beyond some sedge grass, growing along the riverbank, is a muddy trail which leads away from the river.  Slippery rocks make the footing treacherous all along the river's boundaries.","Beyond some sedge grass growing along the riverbank is a muddy trail which leads away from the river.  Slippery rocks make the footing treacherous all along the river's boundaries."],"exits":[{"to":124,"exit":"north","move":"swim north"},{"to":154,"exit":"northeast","move":"swim northeast"},{"to":145,"exit":"east","move":"swim east"},{"to":127,"exit":"southeast","move":"swim southeast"},{"to":126,"exit":"south","move":"swim south"},{"to":64,"exit":"climb","move":"climb sedge grass"}],"color":"#0000FF"},
  {"id":126,"x":300,"y":780,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The river turns sharply to the east here, making the riverbank almost unreachable in the mighty currents.  The waters pound against the cliffs to the south."],"exits":[{"to":125,"exit":"north","move":"swim north"},{"to":145,"exit":"northeast","move":"swim northeast"},{"to":127,"exit":"east","move":"swim east"},{"to":65,"exit":"climb","move":"climb steep cliff"}],"color":"#0000FF"},
  {"id":127,"x":320,"y":780,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The thunderous watercourse continues on speedily as it makes its way south.  Slippery rocks make up the streambed, making the river even more hazardous.","The thunderous watercourse flows on speedily as it makes its way south.  Slippery rocks make up the streambed, making the river even more hazardous.  The waters pour through a gap in the logjam to the south, funneled into a mighty torrent."],"exits":[{"to":145,"exit":"north","move":"swim north"},{"to":146,"exit":"northeast","move":"swim northeast"},{"to":144,"exit":"east","move":"swim east"},{"to":128,"exit":"south","move":"swim south"},{"to":126,"exit":"west","move":"swim west"},{"to":125,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":128,"x":320,"y":800,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The black river cuts a deep channel, creating steep stone cliffs that are unreachable due to the swiftly moving water.  Wisps of fog hang over the cold stream.","The black river cuts a deep channel, creating steep stone cliffs that are unreachable due to the swiftly moving water.  Wisps of fog hang over the cold rapids."],"exits":[{"to":127,"exit":"north","move":"swim north"},{"to":129,"exit":"east","move":"swim east"},{"to":130,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":129,"x":340,"y":800,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Though the river is not quite as wide through here, the riverbank is increasingly steep.  The currents shift and dance wildy as the stream speeds southward."],"exits":[{"to":143,"exit":"southeast","move":"swim southeast"},{"to":130,"exit":"south","move":"swim south"},{"to":128,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":130,"x":340,"y":820,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Large fingers of rock cut through the surface of the river, chopping the water into waves of white foam.  Trees atop the stream's sheer edge send roots down the bank."],"exits":[{"to":129,"exit":"north","move":"swim north"},{"to":143,"exit":"east","move":"swim east"},{"to":142,"exit":"southeast","move":"swim southeast"},{"to":131,"exit":"south","move":"swim south"},{"to":128,"exit":"northwest","move":"swim northwest"},{"to":164,"exit":"climb","move":"climb tree roots"}],"color":"#0000FF"},
  {"id":131,"x":340,"y":840,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Black waters boil over the rocks in the river.  The swift currents pull everything southward towards the open sea."],"exits":[{"to":130,"exit":"north","move":"swim north"},{"to":143,"exit":"northeast","move":"swim northeast"},{"to":142,"exit":"east","move":"swim east"},{"to":132,"exit":"southeast","move":"swim southeast"}],"color":"#0000FF"},
  {"id":132,"x":360,"y":860,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Sandy deltas, covered with thorny brush, split up the river into smaller branches as it makes its final approach to the open sea.  Sprays of cold mist shoot up from the choppy currents as they beat up against the tongues of land."],"exits":[{"to":137,"exit":"east","move":"swim east"},{"to":135,"exit":"south","move":"swim south"},{"to":133,"exit":"southwest","move":"swim southwest"},{"to":131,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":133,"x":340,"y":880,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Deep channels hold the swift black waters in a tight embrace.  Wisps of fog enwreathe fingers of rock that poke through the river's surface.","Deep channels hold the swift, black waters in a tight embrace.  Wisps of fog enwreathe fingers of rock that poke through the river's surface."],"exits":[{"to":132,"exit":"northeast","move":"swim northeast"},{"to":134,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":134,"x":320,"y":900,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The black river dumps out into the wide open sea, creating strong crosscurrents and eddies.  A sandbar disappears amongst the thick vegetation along the shore.","The black river dumps out into the wide-open sea, creating strong crosscurrents and eddies.  A sandbar disappears amongst the thick vegetation along the shore."],"exits":[{"to":133,"exit":"northeast","move":"swim northeast"},{"to":164,"exit":"climb","move":"climb shore"}],"color":"#0000FF"},
  {"id":135,"x":360,"y":880,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Swirling currents eat away at the tongues of rock and sand that cut into the river.  Cold air blows off the black water, giving birth to little curls of haze."],"exits":[{"to":132,"exit":"north","move":"swim north"},{"to":136,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":136,"x":360,"y":900,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The black river dumps out into the wide open sea, creating strong crosscurrents and eddies.  A sandbar near the mouth of the river creates a natural bridge towards the shore."],"exits":[{"to":135,"exit":"north","move":"swim north"},{"to":134,"exit":"climb","move":"climb sandbar"}],"color":"#0000FF"},
  {"id":137,"x":380,"y":860,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Sandy deltas, covered with thorny brush, split up the river into smaller branches as it makes its final approach to the open sea.  Sprays of cold mist shoot up from the choppy currents as they beat up against the tongues of land."],"exits":[{"to":140,"exit":"southeast","move":"swim southeast"},{"to":138,"exit":"south","move":"swim south"},{"to":132,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":138,"x":380,"y":880,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Sharp rocks cut through the surface of the speeding river.  The black water thunders against the edges of the sandy deltas that wall in the stream."],"exits":[{"to":137,"exit":"north","move":"swim north"},{"to":139,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":139,"x":380,"y":900,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The black river dumps out into the wide open sea, creating strong crosscurrents and eddies.  A sandbar near the mouth of the river creates a natural bridge towards the shore.","The black river dumps out into the wide-open sea, creating strong crosscurrents and eddies.  A sandbar near the mouth of the river creates a natural bridge towards the shore."],"exits":[{"to":138,"exit":"north","move":"swim north"},{"to":136,"exit":"climb","move":"climb sandbar"}],"color":"#0000FF"},
  {"id":140,"x":400,"y":880,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Dark thorny brush lines the riverbanks like tall walls.  The rough currents roar loudly as they fling themselves against the rocks in the stream.","Dark, thorny brush lines the riverbanks like tall walls.  The rough currents roar loudly as they fling themselves against the rocks in the stream."],"exits":[{"to":141,"exit":"southeast","move":"swim southeast"},{"to":137,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":141,"x":420,"y":900,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The black river dumps out into the wide open sea, creating strong crosscurrents and eddies.  A sandbar near the mouth of the river creates a natural bridge towards the shore.","The black river dumps out into the wide-open sea, creating strong crosscurrents and eddies.  A sandbar near the mouth of the river creates a natural bridge towards the shore."],"exits":[{"to":140,"exit":"northwest","move":"swim northwest"},{"to":139,"exit":"climb","move":"climb sandbar"}],"color":"#0000FF"},
  {"id":142,"x":360,"y":840,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The river seethes violently, throwing up sprays of mist that cool the air.  Sharp rocks cut through the surface of the stream, providing the racing water with something to slam against.","The river seethes violently, throwing up sprays of mist that cool the air.  Sharp rocks cut through the surface of the stream, providing little obstacle to the racing waters before they slam against the wall of logs to the south."],"exits":[{"to":143,"exit":"north","move":"swim north"},{"to":131,"exit":"west","move":"swim west"},{"to":130,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":143,"x":360,"y":820,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Swirling eddies beat against the shore and the rocks visible standing in the stream.  A light fog overhangs the river, churned up from the cold waters.","Swirling eddies beat against the shore and the rocks visible standing in the cascade.  A light fog overhangs the river, churned up from the cold waters."],"exits":[{"to":142,"exit":"south","move":"swim south"},{"to":131,"exit":"southwest","move":"swim southwest"},{"to":130,"exit":"west","move":"swim west"},{"to":129,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":144,"x":340,"y":780,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The stream has grown much wider here, making the riverbank unreachable in the mighty currents.  Skeletal trees, swallowed by flooding waters, emerge from the river's surface.","The torrent moves swiftly and treacherously over large rocks to create rapids, making the riverbank unreachable in the mighty currents.  Skeletal trees, swallowed by flooding waters, emerge from the river's surface.  Downed trees have piled up here, creating an barrier preventing passage downstream."],"exits":[{"to":146,"exit":"north","move":"swim north"},{"to":127,"exit":"west","move":"swim west"},{"to":145,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":145,"x":320,"y":760,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The thunderous watercourse crashes onward as it makes its way south.  Rocks and rushing water make the river extremely hazardous to traverse."],"exits":[{"to":154,"exit":"north","move":"swim north"},{"to":155,"exit":"northeast","move":"swim northeast"},{"to":146,"exit":"east","move":"swim east"},{"to":144,"exit":"southeast","move":"swim southeast"},{"to":127,"exit":"south","move":"swim south"},{"to":126,"exit":"southwest","move":"swim southwest"},{"to":125,"exit":"west","move":"swim west"},{"to":124,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":146,"x":340,"y":760,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The river widens here and the riverbank climbs steeply from the mighty currents.  Skeletal trees, swallowed by flooding waters, emerge from the river's surface."],"exits":[{"to":155,"exit":"north","move":"swim north"},{"to":144,"exit":"south","move":"swim south"},{"to":127,"exit":"southwest","move":"swim southwest"},{"to":145,"exit":"west","move":"swim west"},{"to":154,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":147,"x":320,"y":600,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The thunder of cascading water fills the area, originating from the steep falls that empty into the river here.  Dark, murky depths hide the sharp stones of the riverbed."],"exits":[{"to":159,"exit":"east","move":"swim east"},{"to":158,"exit":"southeast","move":"swim southeast"},{"to":148,"exit":"south","move":"swim south"},{"to":118,"exit":"southwest","move":"swim southwest"},{"to":119,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":148,"x":320,"y":620,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["A large boulder, protruding up from the river's bottom, blocks the swift current, making a still place in the midst of the rushing stream.  Thin-legged insects dance along the surface of the black water, searching for food or becoming food themselves.","A large boulder protruding up from the river's bottom blocks the swift current, making a still place in the midst of the rushing stream.  Thin-legged insects dance along the surface of the black water, searching for food or becoming food themselves."],"exits":[{"to":147,"exit":"north","move":"swim north"},{"to":159,"exit":"northeast","move":"swim northeast"},{"to":158,"exit":"east","move":"swim east"},{"to":157,"exit":"southeast","move":"swim southeast"},{"to":149,"exit":"south","move":"swim south"},{"to":117,"exit":"southwest","move":"swim southwest"},{"to":118,"exit":"west","move":"swim west"},{"to":119,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":149,"x":320,"y":640,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The water deepens here as it sweeps southward, the currents swirling as the river narrows.  The clamor of a nearby waterfall can be easily distinguished as coming from upstream.","The water becomes somewhat shallower through here as it sweeps southward, increasing speed as the river narrows before plunging over a steep barricade of jammed logs and other debris.  The clamor of a nearby waterfall can be easily distinguished as coming from upstream."],"exits":[{"to":148,"exit":"north","move":"swim north"},{"to":158,"exit":"northeast","move":"swim northeast"},{"to":157,"exit":"east","move":"swim east"},{"to":117,"exit":"west","move":"swim west"},{"to":118,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":150,"x":320,"y":660,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Though the current is quite strong along here, the river is a bit more shallow.  A beach of scoured white sand lines the east riverbank.","Though the current is quite strong along here, the river is a bit more shallow after plunging over a barricade of logs and debris.  A beach of scoured white sand lines the east riverbank."],"exits":[{"to":157,"exit":"northeast","move":"swim northeast"},{"to":151,"exit":"south","move":"swim south"},{"to":121,"exit":"southwest","move":"swim southwest"},{"to":120,"exit":"west","move":"swim west"},{"to":161,"exit":"go","move":"go sand beach"}],"color":"#0000FF"},
  {"id":151,"x":320,"y":680,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Black waters beat up against treacherous banks.  The river crashes against the rocks that protrude through the stream's surface, hurdling over them in bursts of spray."],"exits":[{"to":150,"exit":"north","move":"swim north"},{"to":152,"exit":"south","move":"swim south"},{"to":122,"exit":"southwest","move":"swim southwest"},{"to":121,"exit":"west","move":"swim west"},{"to":120,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":152,"x":320,"y":700,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["A white sand beach extends outward into the racing currents.  Sharp rocks cut through the river's surface like knife blades.","A white sand beach extends outward into the racing currents.  Sharp rocks cut through the river's surface like knife blades, providing a surface logs to pile up in a tremendous logjam.  The only outlet for the raging waters is through a small channel to the southeast."],"exits":[{"to":151,"exit":"north","move":"swim north"},{"to":156,"exit":"southeast","move":"swim southeast"},{"to":123,"exit":"southwest","move":"swim southwest"},{"to":122,"exit":"west","move":"swim west"},{"to":121,"exit":"northwest","move":"swim northwest"},{"to":160,"exit":"go","move":"go sand beach"}],"color":"#0000FF"},
  {"id":153,"x":320,"y":720,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The thunderous watercourse continues on speedily as it makes its way south.  Rocks blocking the water make the river even more hazardous to traverse."],"exits":[{"to":156,"exit":"east","move":"swim east"},{"to":155,"exit":"southeast","move":"swim southeast"},{"to":154,"exit":"south","move":"swim south"},{"to":124,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":154,"x":320,"y":740,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The thunderous watercourse crashes onward as it makes its way south.  Rocks blocking the water make the river even more hazardous to traverse."],"exits":[{"to":153,"exit":"north","move":"swim north"},{"to":156,"exit":"northeast","move":"swim northeast"},{"to":155,"exit":"east","move":"swim east"},{"to":146,"exit":"southeast","move":"swim southeast"},{"to":145,"exit":"south","move":"swim south"},{"to":125,"exit":"southwest","move":"swim southwest"},{"to":124,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":155,"x":340,"y":740,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The stream has grown much wider here, making the riverbank unreachable in the mighty currents.  Skeletal trees, swallowed by flooding waters, emerge from the river's surface."],"exits":[{"to":156,"exit":"north","move":"swim north"},{"to":146,"exit":"south","move":"swim south"},{"to":145,"exit":"southwest","move":"swim southwest"},{"to":154,"exit":"west","move":"swim west"},{"to":153,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":156,"x":340,"y":720,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Fierce rapids tear at the white sand beach that stretches out into the inky river.  A cool mist, spraying up from the crashing currents, fills the air."],"exits":[{"to":155,"exit":"south","move":"swim south"},{"to":154,"exit":"southwest","move":"swim southwest"},{"to":153,"exit":"west","move":"swim west"},{"to":152,"exit":"northwest","move":"swim northwest"},{"to":163,"exit":"go","move":"go sand beach"}],"color":"#0000FF"},
  {"id":157,"x":340,"y":640,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["The river narrows here, speeding away faster as it flows to the southwest.  A bar of white sand stretches out into the stream, channeling the water away from the east bank."],"exits":[{"to":158,"exit":"north","move":"swim north"},{"to":150,"exit":"southwest","move":"swim southwest"},{"to":149,"exit":"west","move":"swim west"},{"to":148,"exit":"northwest","move":"swim northwest"},{"to":162,"exit":"go","move":"go white sandbar"}],"color":"#0000FF"},
  {"id":158,"x":340,"y":620,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Giant trees and thick brush line the bank of the river like a massive wall.  Slime-covered branches stick up out of the water, adding to the danger of the speeding currents."],"exits":[{"to":159,"exit":"north","move":"swim north"},{"to":157,"exit":"south","move":"swim south"},{"to":149,"exit":"southwest","move":"swim southwest"},{"to":148,"exit":"west","move":"swim west"},{"to":147,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":159,"x":340,"y":600,"z":0,"title":"Hara'jaal, Seord Fal","descriptions":["Swift currents slap hard against the rocky riverbank.  Water, black as a squid's ink, spills over a steep cliff into the river's swirling currents."],"exits":[{"to":158,"exit":"south","move":"swim south"},{"to":148,"exit":"southwest","move":"swim southwest"},{"to":147,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":160,"x":360,"y":700,"z":0,"title":"Hara'jaal, Sandy Bank","descriptions":["A black boulder, scoured almost to a polish by water, protrudes up from the sun-bleached sands.  The hedge that guards the east side of the beach grows tall and dense like the wall of a fortress."],"exits":[{"to":161,"exit":"north","move":"north"},{"to":163,"exit":"southeast","move":"southeast"},{"to":152,"exit":"go","move":"go river"}]},
  {"id":161,"x":360,"y":660,"z":0,"title":"Hara'jaal, Sandy Bank","descriptions":["A pungent odor seems to originate from the thorny bushes that line the eastern edge of the beach.  Piles of deadwood and rocks, washed up from the river, cover a large portion of the sandy ground."],"exits":[{"to":162,"exit":"northeast","move":"northeast"},{"to":160,"exit":"south","move":"south"},{"to":150,"exit":"go","move":"go river"}]},
  {"id":162,"x":380,"y":640,"z":0,"title":"Hara'jaal, Sandy Bank","descriptions":["The water brushes hard against the white sands of the beach.  A thick hedge of thorny brush blocks the beach off from all but the rushing river."],"exits":[{"to":161,"exit":"southwest","move":"southwest"},{"to":157,"exit":"go","move":"go river"}]},
  {"id":163,"x":380,"y":720,"z":0,"title":"Hara'jaal, Sandy Bank","descriptions":["Thorny bushes and the swift flowing river seem to be fighting a titanic battle over this small scrap of beach.  The roots of the thick hedges has been exposed in many places where rushing water has taken its toll and eroded the soil.","Thorny bushes and the swift flowing river seem to be fighting a titanic battle over this small scrap of beach.  The roots of the thick hedges have been exposed in many places where rushing water has taken its toll and eroded the soil."],"exits":[{"to":160,"exit":"northwest","move":"northwest"},{"to":156,"exit":"go","move":"go river"}]},
  {"id":164,"x":300,"y":880,"z":0,"title":"A Black Sand Path","descriptions":["A thicket of dense thorns surround the path, forming a dark tunnel.  The air is thick and oppressive, with the scent of decomposition pervading everything."],"exits":[{"to":165,"exit":"north","move":"north"}]},
  {"id":165,"x":300,"y":860,"z":0,"title":"A Black Sand Path","descriptions":["A thicket of dense thorns surround the path, forming a dark tunnel.  The air is thick and oppressive, with the scent of decomposition pervading everything."],"exits":[{"to":166,"exit":"north","move":"north"}]},
  {"id":166,"x":300,"y":840,"z":0,"title":"A Black Sand Path","descriptions":["A thicket of dense thorns surround the path, forming a dark tunnel.  The air is thick and oppressive, with the scent of decomposition pervading everything."],"exits":[{"to":167,"exit":"north","move":"north"}]},
  {"id":167,"x":300,"y":820,"z":0,"title":"A Black Sand Path","descriptions":["A thicket of dense thorns surround the path, forming a dark tunnel.  The air is thick and oppressive, with the scent of decomposition pervading everything."],"exits":[{"to":64,"exit":"north","move":"north","hidden":true}]},
  {"id":168,"x":260,"y":840,"z":0,"title":"Hara'jaal, Faint Path","descriptions":["The hum and whine of insects blend with the sound of trickling water and squishing mud.  Barbed branches reach out to tug at any loose clothing while thick mud puddles create deep sink holes along the way.  A broken gate is silhouetted against the light shining from the doorway of a small mud hovel.","Dense brush makes it difficult to follow the path.  Barbed branches reach out to snag at any loose clothing while water trickles across the ground, making it a muddy mess.  The path ends in front of a broken down gate that leads into a yard scattered with debris.  A number of chickens peck and scratch at the ground next to a mud-packed, straw hovel."],"exits":[{"to":68,"exit":"go","move":"go faint path"},{"to":169,"exit":"go","move":"go broken gate"},{"to":171,"exit":"go","move":"go faint trail"}]},
  {"id":169,"x":260,"y":820,"z":0,"title":"Hara'jaal, Muddy Courtyard","descriptions":["Stillness weighs heavily in the yard, not a bird twitters nor insect hums.  A yellow shaft of light streams out the broken door of a small mud hovel and bathes charred bits of crudely made furniture, lying about the muddy yard, in an eerie light.","A stillness weighs heavily in the yard, not a bird twitters nor insect hums.  There is no respite from the sucking mud that pulls at anything on its surface.  Charred remains of crudely made furniture along with broken bits of pottery are evidence that the hovel has recently been vandalized."],"exits":[{"to":168,"exit":"go","move":"go gate"},{"to":170,"exit":"go","move":"go driftwood door"}]},
  {"id":170,"x":280,"y":820,"z":0,"title":"Hara'jaal, Mud Hovel","descriptions":["A firepit holds a meager fire at the center of the tiny, one room hovel and is the only light in this windowless place.  A mat of palm fronds and a ratty blanket lies in one corner of the earth-packed floor.  The only proof that someone resides here is a pot at the center of the fire that gives off the noxious aroma of some foul porridge.  A small altar has been constructed from an old ship's door that sits on two large pieces of driftwood.","The hovel has been ransacked many times over, leaving nothing but the bare essentials.  A mat of palm fronds lies in one corner of the earth-packed floors along with a ratty blanket and serves as a bed.  A small firepit is centered in the room with a dented pot, filled with some odoriferous type of porridge, resting on a flat rock in the middle of the fire.  In one corner an altar has been created from an old ship's door and sits on two large pieces of driftwood."],"exits":[{"to":169,"exit":"go","move":"go driftwood door"}],"color":"#400040","aliases":["Drogor","Depart","shrine"]},
  {"id":171,"x":260,"y":860,"z":0,"title":"A Muddy Trail","descriptions":["The steady drone of insects is punctuated by the harsher and more guttural sounds of the larger nocturnal creatures roaming the surrounding vegetation.  Thin rivulets of water snake eastwards down the trail, and a small opening in the brush to the west is nearly covered by a massive web whose architect, a huge orange spider, sways silently among the upper strands.","Dense brush and barbed, low-hanging branches press in from all sides of the trail, which is little more than a tunnel carved through the living strata.  Rivulets of water snake across the muddy ground, and tiny droplets glisten among the strands of a spider's web which stretches across the upper portion of the path.  Its architect, a massive orange spider the size of a Tog's fist, is perched along the upper edge, surveying the dark opening leading further west."],"exits":[{"to":168,"exit":"go","move":"go muddy trail"},{"to":172,"exit":"go","move":"go massive web"}]},
  {"id":172,"x":260,"y":880,"z":0,"title":"Hara'Jaal, A Small Clearing","descriptions":["The dense brush and towering trees recede to form a small, almost circular glade.  Illuminated by a shaft of light shining through a gap in the entwined branches overhead, a solitary cypress stump stands lonely vigil over a collapsed excavation.  A few beads of moisture glisten among the strands of a massive web nearly covering the entrance to a small trail.","The dense brush and towering trees have receded to form a small glade bathed in perpetual twilight.  At the western edge, just inside the impenetrable ring of vegetation, a solitary cypress stump stands lonely vigil over a collapsed excavation.  Towards the east, a massive web nearly covers the entrance to a small trail."],"exits":[{"to":171,"exit":"go","move":"go massive web"}],"color":"#00FFFF"},
  {"id":173,"x":-50,"y":680,"z":0,"title":"Baron's Forset, Teller","descriptions":["The wattle-and-daub walls and grimy floors of this cramped, single-room building disguise the fact that this is the financial hub of the outlaw empire set up by the Baron and his minions.  Locked behind a sturdy steel cage, the bank clerks transact the day's business.  Off to the side of the room, a murky corner holds the moneychanger's cubicle."],"exits":[{"to":91,"exit":"out","move":"out"},{"to":174,"exit":"go","move":"go shadow-filled corner"}],"color":"#00FF00","aliases":["Teller","Bank"]},
  {"id":174,"x":-60,"y":680,"z":0,"title":"Baron's Forset, Moneychanger","descriptions":["This tiny cubicle is the work area for the clerk who handles money exchanges.  Thin, makeshift walls provide an illusory sense of separation from the main room of the bank."],"exits":[{"to":173,"exit":"east","move":"east"}],"color":"#00FF00","aliases":["Exchanger"]},
  {"id":175,"x":-90,"y":700,"z":0,"title":"Solvajelt Lasa'Zindu","descriptions":["The wood walls are splashed with a rainbow assortment of colors.  Pots of dyes and paints are piled high on shelves and stacked in corners, alongside wooden racks holding rows of the slender bone needles used to create designs on living skin or scales.  A number of assistants stand ready to aid the master skin artists as they work with their customers."],"exits":[{"to":93,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Tattoo"]},
  {"id":176,"x":-40,"y":710,"z":0,"title":"Oblichek's Fine Furs","descriptions":["The air is full of unpleasant odors, coming from other parts of the building.  Stacks of bundled skins and furs are piled up against the walls.  A number of assistants hang about in the shadows, awaiting the chance to buy hides and other trophies for their master."],"exits":[{"to":177,"exit":"west","move":"west"},{"to":96,"exit":"out","move":"out"}],"color":"#00FF00","aliases":["Bundles"]},
  {"id":177,"x":-50,"y":710,"z":0,"title":"Oblichek's Fine Furs","descriptions":["The walls in this room are hung with skins stretched out on drying racks.  A large counter constructed from a variety of different bones sits in the middle of the floor."],"exits":[{"to":178,"exit":"north","move":"north"},{"to":176,"exit":"east","move":"east"}]},
  {"id":178,"x":-50,"y":700,"z":0,"title":"Oblichek's Fine Furs","descriptions":["Large vats fill the entire room.  Clouds of obnoxious fumes spew out of the chemical soup contained within the tubs.  A shallow trench runs the length of the floor to drain away spills.  Dark stains cover the walls."],"exits":[{"to":177,"exit":"south","move":"south"}],"aliases":["Oblichek"]},
  {"id":179,"x":-20,"y":730,"z":0,"title":"Calorak's Weapons and Armor","descriptions":["Large oil lamps, emitting more oily smoke than light, illuminate the shop and its wares.  The sharp scent of smelted iron hangs heavy in the air.  The soot-stained black walls are bare, except for a spike from which hangs a heavy leather apron.  A thick leather curtain, leading to another area of the shop, is tacked to a doorframe."],"exits":[{"to":180,"exit":"east","move":"east"},{"to":90,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Weapons"]},
  {"id":180,"x":-10,"y":730,"z":0,"title":"Calorak's Weapons and Armor","descriptions":["Lamps, mounted to the walls, light the shop's smoke stained walls and displays.  The flagstone floor is deeply gouged in many places where heavy objects have been dragged across it."],"exits":[{"to":179,"exit":"west","move":"west"}],"color":"#FF0000","aliases":["Armor"]},
  {"id":181,"x":-30,"y":700,"z":0,"title":"The Enclave, Sh'aar's Trove","descriptions":["Mismatched paintings cover the walls, while long shelves bolted between them hold a medley of questionable treasures, presided over by the pawnbroker Dumi Sh'aar.  Engraved boxes compete for space with musical instruments, tools, books, and other oddments.  A glass-topped counter in front of the room holds an assortment of trinkets and jewelry -- some tawdry, some so regal in design that distant journeys must have brought them to this place."],"exits":[{"to":88,"exit":"go","move":"go wooden door"}],"color":"#00FF00","aliases":["Pawnshop","Sh'aar's Trove"]},
  {"id":182,"x":60,"y":700,"z":0,"title":"Driftwood Tavern, Common Room","descriptions":["The floor of the tavern is covered with sawdust.  Fish-oil lamps, burning dimly throughout the building, give off a rank scent that is only a smidge better than the lingering smells of puke and spilt ale.  The bar, with plenty of stools lined up beside it, takes up a majority of one wall.  A large booth, opposite the bar, provides a small bit of privacy for those in need of some."],"exits":[{"to":89,"exit":"out","move":"out"},{"to":183,"exit":"climb","move":"climb narrow staircase"},{"to":185,"exit":"go","move":"go large booth"}],"color":"#FF0000","aliases":["Driftwood Tavern"]},
  {"id":183,"x":60,"y":690,"z":0,"title":"Driftwood Tavern, Below the Eaves","descriptions":["Here at the top of the stairs, the tavern's sloping roof meets the outside wall at an abrupt angle, creating a rather tricky hazard for the tavern's taller or more inebriated guests to navigate.  Several doors can be seen at the western end of the hallway, faintly illuminated by a sputtering brass ship's lantern.","Here at the top of the stairs, the tavern's sloping roof meets the outside wall at an abrupt angle, creating a rather tricky hazard for the tavern's taller or more inebriated guests to navigate.  Several doors can be seen at the western end of the hallway, faintly illuminated by a sputtering brass ship's lantern.  A small storage area lurks under the roof just north of the landing."],"exits":[{"to":184,"exit":"west","move":"west"},{"to":182,"exit":"climb","move":"climb narrow staircase"},{"to":225,"exit":"north","move":"north"}]},
  {"id":184,"x":50,"y":690,"z":0,"title":"Driftwood Tavern, Upstairs Hallway","descriptions":["A pitted brass ship's lantern hangs from one wall, its sputtering flame barely illuminating the cramped hallway.  An old barstool, liberated from downstairs, sits below the lantern.  The wooden floorboards are gapped and scarred yet the noise from below is curiously muffled."],"exits":[{"to":183,"exit":"east","move":"east"}],"color":"#00FFFF"},
  {"id":185,"x":50,"y":700,"z":0,"title":"Driftwood Tavern, Booth","descriptions":["High-backed benches and thick tapestries hanging from the ceiling dampen the clamor from the common room.  A dark-stained menu is tacked roughly to the wall."],"exits":[{"to":182,"exit":"east","move":"east"}]},
  {"id":186,"x":-10,"y":690,"z":0,"title":"Anli Delban Reste, Bar","descriptions":["Wide cracks in the roof and walls let the night air in, but the reek of sweat and stale air still fills the room.  Oil lamps hanging on the walls shed dim illumination on the grime-choked reed mats covering the floor.  The center of the room is dominated by a large, crudely gouged-out pit which appears to be filled with mud.  In one corner, a thick-waisted bartender hovers, surrounded by his ale barrels."],"exits":[{"to":87,"exit":"out","move":"out"},{"to":187,"exit":"go","move":"go mud pit"}],"aliases":["Bar"]},
  {"id":187,"x":-20,"y":680,"z":0,"title":"Anli Delban Reste, A Mud Pit","descriptions":["This area is walled off from the rest of the tavern with rough wood timbers.  Thick, brown mud fills the pit and bubbles messily from trapped air in its depths."],"exits":[{"to":186,"exit":"out","move":"out"}]},
  {"id":188,"x":-90,"y":680,"z":0,"title":"A Cottage","descriptions":["The interior of this single-room home is bright and serene, with every inch organized to be both tidy and functional.  Curtains the color of morning sunshine, tied back with cords of emerald cotton, frame the windows, and lush houseplants are set on neat shelves lining the walls.  A marble slab covered with an immaculate white sheet provides a spot for the Empath's customers to rest.  Near the window, a little rack is filled with drying herbs, and their scent fills the air with a refreshing tang."],"exits":[{"to":92,"exit":"out","move":"out"}],"color":"#00FF00","aliases":["Kersharin","Empath","Autopath","Healer","Hospital"]},
  {"id":189,"x":-80,"y":640,"z":0,"title":"Var'Quel Manor, Hallway","descriptions":["Luxurious carpets line the floor of this corridor.  The clean whitewashed walls fill the air of the hall with a strong scent of lime.  Lamps, hanging from the lobby's ceiling, illuminate the hallway."],"exits":[{"to":191,"exit":"north","move":"north"},{"to":192,"exit":"east","move":"east"},{"to":190,"exit":"west","move":"west"},{"to":83,"exit":"out","move":"out"}],"aliases":["Var'Quel Manor","Manor"]},
  {"id":190,"x":-90,"y":640,"z":0,"title":"Var'Quel Manor, Captain's Office","descriptions":["Weapons and shields of all types are mounted on the walls of this office.  The captain of the Baron's guard sits behind his desk, a monstrous creation of wood and iron.  Banners, taken from pirated ships, hang from the ceiling."],"exits":[{"to":189,"exit":"out","move":"out"}]},
  {"id":191,"x":-80,"y":630,"z":0,"title":"Var'Quel Manor, Hallway","descriptions":["Shabbily dressed guards stand to the sides of a marble arch.  A spiral staircase leads to an upper balcony and the top floor of the manor.  Dark tapestries hang on the walls, and lamps illuminate the corridor."],"exits":[{"to":189,"exit":"south","move":"south"},{"to":221,"exit":"climb","move":"climb spiral staircase"}]},
  {"id":192,"x":-70,"y":640,"z":0,"title":"Var'Quel Manor, Clerk's Office","descriptions":["This room is filled with a disarray of ledgers and loose parchments.  Behind an ink-stained wooden desk, stacked high with books, sits the Baron's clerk who handles the day to day business of the town.  The office smells of old leather bindings and moldy rag paper."],"exits":[{"to":189,"exit":"out","move":"out"}]},
  {"id":193,"x":-20,"y":630,"z":0,"title":"The Enclave, Sohrac's Gembuyers","descriptions":["Evening's soft light filters through a ruby-hued glass skylight and gives the room a warm glow.  Shadows cast from barred windows flicker across the locked cabinets protecting gemstones glittering in velvet-lined trays, their brilliance rivalling the stars themselves.  Gem buyer Abira Sohrac sips a cup of tea and smiles a welcome as she reaches for an empty sorting-tray in preparation for her next customer."],"exits":[{"to":81,"exit":"go","move":"go trimmed door"}],"color":"#FF0000","aliases":["Gem Shop","Gembuyers"]},
  {"id":194,"x":-30,"y":660,"z":0,"title":"The Enclave, Tehya's Stitchery","descriptions":["No exclusive urban clothier, this shop is devoted to the taste of buccaneers and renegades both male and female.  Bolts of bright cotton, patterned batiks, and exotic silks are piled in a glorious profusion in heavy oak cabinets lining the pale turquoise walls.  The seamstress Tehya Garlane strides about the room, a length of scarlet homespun flung over one shoulder, flashing her brilliant smile and bantering with customers while adjusting the garments hung neatly on display."],"exits":[{"to":84,"exit":"go","move":"go driftwood door"}],"color":"#FF0000","aliases":["Clothing","Tehya's Stitchery"]},
  {"id":195,"x":0,"y":630,"z":0,"title":"The Enclave, Jewelry Shop","descriptions":["Whale oil lanterns cast a hazy glow over the cluttered shop and coat the display cases with a thin film of soot.  Two long, narrow windows are grimy and barred shut, holding in the fetid odor of unwashed bodies and cheap cologne.  Betina, the shop's owner, shares lewd comments and bawdy laughter with the burly Gor 'Tog guards milling about."],"exits":[{"to":80,"exit":"go","move":"go iron door"}],"color":"#FF0000","aliases":["Jewelry"]},
  {"id":196,"x":260,"y":500,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":197,"exit":"north","move":"north"},{"to":197,"exit":"northeast","move":"northeast"},{"to":197,"exit":"east","move":"east"},{"to":220,"exit":"southeast","move":"southeast","hidden":true},{"to":52,"exit":"south","move":"south"},{"to":220,"exit":"southwest","move":"southwest","hidden":true},{"to":220,"exit":"west","move":"west","hidden":true},{"to":197,"exit":"northwest","move":"northwest"}],"aliases":["Rock Room"]},
  {"id":197,"x":260,"y":460,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":198,"exit":"north","move":"north"},{"to":198,"exit":"northeast","move":"northeast"},{"to":198,"exit":"east","move":"east"},{"to":198,"exit":"southeast","move":"southeast"},{"to":198,"exit":"south","move":"south"},{"to":198,"exit":"southwest","move":"southwest"},{"to":198,"exit":"west","move":"west"},{"to":198,"exit":"northwest","move":"northwest"},{"to":49,"exit":"climb","move":"climb slope"}],"color":"#FFFF00"},
  {"id":198,"x":260,"y":440,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":199,"exit":"north","move":"north"},{"to":199,"exit":"northeast","move":"northeast"},{"to":199,"exit":"east","move":"east"},{"to":197,"exit":"southeast","move":"southeast"},{"to":197,"exit":"south","move":"south"},{"to":197,"exit":"southwest","move":"southwest"},{"to":197,"exit":"west","move":"west"},{"to":199,"exit":"northwest","move":"northwest"}],"color":"#FFFF00"},
  {"id":199,"x":260,"y":420,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":200,"exit":"north","move":"north"},{"to":200,"exit":"northeast","move":"northeast"},{"to":200,"exit":"east","move":"east"},{"to":198,"exit":"southeast","move":"southeast"},{"to":198,"exit":"south","move":"south"},{"to":198,"exit":"southwest","move":"southwest"},{"to":197,"exit":"west","move":"west"},{"to":200,"exit":"northwest","move":"northwest"}],"color":"#FFFF00"},
  {"id":200,"x":260,"y":400,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":201,"exit":"north","move":"north"},{"to":201,"exit":"northeast","move":"northeast"},{"to":201,"exit":"east","move":"east"},{"to":199,"exit":"southeast","move":"southeast"},{"to":199,"exit":"south","move":"south"},{"to":199,"exit":"southwest","move":"southwest"},{"to":199,"exit":"west","move":"west"},{"to":201,"exit":"northwest","move":"northwest"}],"color":"#FFFF00"},
  {"id":201,"x":260,"y":380,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":202,"exit":"north","move":"north","hidden":true},{"to":202,"exit":"northeast","move":"northeast","hidden":true},{"to":202,"exit":"east","move":"east","hidden":true},{"to":200,"exit":"southeast","move":"southeast"},{"to":200,"exit":"south","move":"south"},{"to":200,"exit":"southwest","move":"southwest"},{"to":200,"exit":"west","move":"west"},{"to":202,"exit":"northwest","move":"northwest","hidden":true}],"color":"#FFFF00"},
  {"id":202,"x":340,"y":480,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":203,"exit":"north","move":"north"},{"to":203,"exit":"northeast","move":"northeast"},{"to":203,"exit":"east","move":"east"},{"to":201,"exit":"southeast","move":"southeast","hidden":true},{"to":201,"exit":"south","move":"south","hidden":true},{"to":201,"exit":"southwest","move":"southwest","hidden":true},{"to":201,"exit":"west","move":"west","hidden":true},{"to":203,"exit":"northwest","move":"northwest"}]},
  {"id":203,"x":340,"y":460,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":204,"exit":"north","move":"north"},{"to":204,"exit":"northeast","move":"northeast"},{"to":204,"exit":"east","move":"east"},{"to":202,"exit":"southeast","move":"southeast"},{"to":202,"exit":"south","move":"south"},{"to":202,"exit":"southwest","move":"southwest"},{"to":202,"exit":"west","move":"west"},{"to":204,"exit":"northwest","move":"northwest"}]},
