  {"id":207,"x":340,"y":380,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":208,"exit":"north","move":"north"},{"to":208,"exit":"northeast","move":"northeast"},{"to":208,"exit":"east","move":"east"},{"to":206,"exit":"southeast","move":"southeast"},{"to":206,"exit":"south","move":"south"},{"to":206,"exit":"southwest","move":"southwest"},{"to":206,"exit":"west","move":"west"},{"to":208,"exit":"northwest","move":"northwest"}]},
  {"id":208,"x":340,"y":360,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":209,"exit":"north","move":"north"},{"to":209,"exit":"northeast","move":"northeast"},{"to":209,"exit":"east","move":"east"},{"to":207,"exit":"southeast","move":"southeast"},{"to":207,"exit":"south","move":"south"},{"to":207,"exit":"southwest","move":"southwest"},{"to":207,"exit":"west","move":"west"},{"to":209,"exit":"northwest","move":"northwest"}]},
  {"id":209,"x":340,"y":340,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":210,"exit":"north","move":"north"},{"to":210,"exit":"northeast","move":"northeast"},{"to":210,"exit":"east","move":"east"},{"to":208,"exit":"southeast","move":"southeast"},{"to":208,"exit":"south","move":"south"},{"to":208,"exit":"southwest","move":"southwest"},{"to":208,"exit":"west","move":"west"},{"to":210,"exit":"northwest","move":"northwest"}]},
  {"id":210,"x":340,"y":320,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":211,"exit":"north","move":"north"},{"to":211,"exit":"northeast","move":"northeast"},{"to":211,"exit":"east","move":"east"},{"to":209,"exit":"southeast","move":"southeast"},{"to":209,"exit":"south","move":"south"},{"to":209,"exit":"southwest","move":"southwest"},{"to":209,"exit":"west","move":"west"},{"to":211,"exit":"northwest","move":"northwest"}]},
