  {"id":205,"x":340,"y":420,"z":0,"title":"Hara'jaal, Glaren Kweld","descriptions":["Ropy grass presses in on every side, hiding all but the vaguest impression of pathways.  The ground is covered with a dense loam which cushions footfalls.  Rotting detritus fills the air with a heavy scent."],"exits":[{"to":206,"exit":"north","move":"north"},{"to":206,"exit":"northeast","move":"northeast"},{"to":206,"exit":"east","move":"east"},{"to":204,"exit":"southeast","move":"southeast"},{"to":204,"exit":"south","move":"south"},{"to":204,"exit":"southwest","move":"southwest"},{"to":204,"exit":"west","move":"west"},{"to":206,"exit":"northwest","move":"northwest"}]},
