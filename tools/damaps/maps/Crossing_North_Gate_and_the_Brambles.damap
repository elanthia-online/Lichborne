  {"id":132,"x":180,"y":-140,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["Brambly bushes create a close thicket criss-crossed by paths littered with fallen blueberries.  The smell of over-ripe fruit lingers in the air like drying honey.  Scraps of loosely woven netting -- an attempt to foil birds -- cling to the shrubs."],"exits":[{"to":131,"exit":"north","move":"north"},{"to":128,"exit":"northeast","move":"northeast"},{"to":127,"exit":"east","move":"east"},{"to":125,"exit":"southeast","move":"southeast"},{"to":133,"exit":"south","move":"south"},{"to":136,"exit":"southwest","move":"southwest"},{"to":137,"exit":"west","move":"west"},{"to":138,"exit":"northwest","move":"northwest"}]},
  {"id":133,"x":180,"y":-120,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["Brambly bushes create a close thicket criss-crossed by paths littered with fallen blueberries.  The smell of over-ripe fruit lingers in the air like drying honey.  Scraps of loosely woven netting -- an attempt to foil birds -- cling to the shrubs."],"exits":[{"to":132,"exit":"north","move":"north"},{"to":127,"exit":"northeast","move":"northeast"},{"to":125,"exit":"east","move":"east"},{"to":126,"exit":"southeast","move":"southeast"},{"to":134,"exit":"south","move":"south"},{"to":135,"exit":"southwest","move":"southwest"},{"to":136,"exit":"west","move":"west"},{"to":137,"exit":"northwest","move":"northwest"}]},
  {"id":134,"x":180,"y":-100,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["Dark green moss dapples the high stone wall skirting one side of the path, and fronds from the bushes overhang the narrow trail in places.  A group of tiny black ants contest possession of a plump blueberry with an army of red ants."],"exits":[{"to":133,"exit":"north","move":"north"},{"to":125,"exit":"northeast","move":"northeast"},{"to":126,"exit":"east","move":"east"},{"to":135,"exit":"west","move":"west"},{"to":136,"exit":"northwest","move":"northwest"}]},
  {"id":135,"x":160,"y":-100,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["Dark green moss dapples the high stone wall skirting one side of the path, and fronds from the bushes overhang the narrow trail in places.  Tiny red ants have built several mounds near the base of one bush.  One struggles with a plump blueberry, straining to haul it back to the nest."],"exits":[{"to":136,"exit":"north","move":"north"},{"to":133,"exit":"northeast","move":"northeast"},{"to":134,"exit":"east","move":"east"}]},
  {"id":136,"x":160,"y":-120,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["Brambly bushes create a close thicket criss-crossed by paths littered with fallen blueberries.  The smell of over-ripe fruit lingers in the air like drying honey.  Scraps of loosely woven netting -- an attempt to foil birds -- cling to the shrubs."],"exits":[{"to":137,"exit":"north","move":"north"},{"to":132,"exit":"northeast","move":"northeast"},{"to":133,"exit":"east","move":"east"},{"to":134,"exit":"southeast","move":"southeast"},{"to":135,"exit":"south","move":"south"}]},
  {"id":137,"x":160,"y":-140,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["Brambly bushes create a close thicket criss-crossed by paths littered with fallen blueberries.  The smell of over-ripe fruit lingers in the air like drying honey.  Scraps of loosely woven netting -- an attempt to foil birds -- cling to the shrubs."],"exits":[{"to":138,"exit":"north","move":"north"},{"to":131,"exit":"northeast","move":"northeast"},{"to":132,"exit":"east","move":"east"},{"to":133,"exit":"southeast","move":"southeast"},{"to":136,"exit":"south","move":"south"}]},
  {"id":138,"x":160,"y":-160,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["Brambly bushes create a close thicket criss-crossed by paths littered with fallen blueberries.  The smell of over-ripe fruit lingers in the air like drying honey.  Scraps of loosely woven netting -- an attempt to foil birds -- cling to the shrubs."],"exits":[{"to":139,"exit":"north","move":"north"},{"to":130,"exit":"northeast","move":"northeast"},{"to":131,"exit":"east","move":"east"},{"to":132,"exit":"southeast","move":"southeast"},{"to":137,"exit":"south","move":"south"}]},
  {"id":139,"x":160,"y":-180,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["Dark green moss dapples the high stone wall skirting one side of the path, and fronds from the bushes overhang the narrow trail in places.  Tiny red ants have built several mounds near the base of one bush.  One struggles with a plump blueberry, straining to haul it back to the nest."],"exits":[{"to":130,"exit":"east","move":"east"},{"to":131,"exit":"southeast","move":"southeast"},{"to":138,"exit":"south","move":"south"},{"to":140,"exit":"go","move":"go path"}]},
  {"id":140,"x":140,"y":-180,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["Gnarled and blackened from a lightning strike, this stunted little shrub at the far northwest corner of the thicket yields no fruit, yet some green shoots thrusting from new growth promise renewal.  The path curves to the southwest towards the cornfield and eastwards deeper into the blueberry grove."],"exits":[{"to":142,"exit":"south","move":"south"},{"to":138,"exit":"go","move":"go blueberry grove"},{"to":141,"exit":"southwest","move":"southwest"}]},
  {"id":141,"x":120,"y":-160,"z":0,"title":"Monastery, Field Path","descriptions":["Turning abruptly to the northeast from the main path, the stone wall plunges into a dense patch of blueberry bushes.  The soil is packed hard from the passage of people, equipment and creatures between the field, blueberry patch and path to the monastery."],"exits":[{"to":140,"exit":"northeast","move":"northeast"},{"to":142,"exit":"southeast","move":"southeast"},{"to":155,"exit":"go","move":"go narrow track"},{"to":147,"exit":"northwest","move":"northwest"}]},
  {"id":142,"x":140,"y":-140,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["The field path wends into a grove of blueberry bushes.  Unharvested by the monks, fat berries hang in luscious profusion from the slender branches, providing a feast for the creatures living here."],"exits":[{"to":140,"exit":"north","move":"north"},{"to":143,"exit":"south","move":"south"},{"to":141,"exit":"northwest","move":"northwest"}]},
  {"id":143,"x":140,"y":-120,"z":0,"title":"Monastery, Blueberry Bushes","descriptions":["The thicket of blueberries thins to the southwest, exposing a view of a cornfield.  The leaves of a nearby shrub shake violently as something hidden by the greenery scurries among the limbs."],"exits":[{"to":142,"exit":"north","move":"north"},{"to":144,"exit":"go","move":"go dirt path"}]},
  {"id":144,"x":120,"y":-100,"z":0,"title":"Monastery, Drained Field","descriptions":["Brown and dried out, stunted stalks of corn lie trampled in the dirt.  Even the grubs disdain the hard ears of corn abandoned in furrows.  Once straight rows of corn continue to the west, and a drainage ditch skirts one side of the field.  Some blueberry bushes are visible to the northeast, just beyond a dirt path."],"exits":[{"to":143,"exit":"go","move":"go dirt path"},{"to":145,"exit":"west","move":"west"},{"to":168,"exit":"down","move":"down"}]},
  {"id":145,"x":100,"y":-100,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":144,"exit":"east","move":"east"},{"to":146,"exit":"west","move":"west"}]},
  {"id":146,"x":80,"y":-100,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":145,"exit":"east","move":"east"},{"to":160,"exit":"west","move":"west"}]},
  {"id":147,"x":100,"y":-180,"z":0,"title":"Monastery, Field Path","descriptions":["Hardly noticeable as a break in the wall, vine covered rubble and debris blocks an ancient entrance gate to the monastery.  Peering over the crumbling stone, the outer buildings of the monastery can be seen to the northeast.  Southeast, the path continues, cutting between the drained fields and blueberry bushes."],"exits":[{"to":141,"exit":"southeast","move":"southeast"},{"to":148,"exit":"northwest","move":"northwest"}]},
  {"id":148,"x":80,"y":-200,"z":0,"title":"Monastery, Field Path","descriptions":["Impressions left by the hooves of dray beasts and footprints left by the monks mix with those of ...something else... in the rich black soil.  Clumps of tough grass grow against the weathered stone wall which lines one side of the path, preventing entry onto the monastery grounds."],"exits":[{"to":147,"exit":"southeast","move":"southeast"},{"to":149,"exit":"go","move":"go narrow track"}]},
  {"id":149,"x":60,"y":-180,"z":0,"title":"Monastery, Drained Field","descriptions":["A raccoon's beady black eyes peer from behind a clump of stalks still standing, as it gnaws hopefully at a dried out ear of corn.  The furrow of stricken plants continues to the west and a dirt path leads off to the northeast.  A chirring sound comes from the drainage ditch lining the field."],"exits":[{"to":148,"exit":"go","move":"go narrow track"},{"to":150,"exit":"west","move":"west"}]},
  {"id":150,"x":40,"y":-180,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":149,"exit":"east","move":"east"},{"to":151,"exit":"west","move":"west"}]},
  {"id":151,"x":20,"y":-180,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":150,"exit":"east","move":"east"},{"to":152,"exit":"west","move":"west"},{"to":166,"exit":"down","move":"down","hidden":true}]},
  {"id":152,"x":0,"y":-180,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  Thick wooden planks bridge the drainage ditch separating the north from the middle field.  Eastward, the ravaged furrows continue, only a few tracks of small animals giving evidence that there is still life in the field."],"exits":[{"to":151,"exit":"east","move":"east"},{"to":153,"exit":"south","move":"south"}]},
  {"id":153,"x":0,"y":-140,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  Thick wooden planks bridge the drainage ditches separating the fields.  Eastward, the ravaged furrows continue, only a few tracks of small animals giving evidence that there is still life in the field."],"exits":[{"to":152,"exit":"north","move":"north"},{"to":159,"exit":"east","move":"east"},{"to":154,"exit":"south","move":"south"},{"to":166,"exit":"down","move":"down","hidden":true}]},
  {"id":154,"x":0,"y":-100,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  Thick wooden planks bridge the drainage ditches separating the fields.  Eastward, the ravaged furrows continue, only a few tracks of small animals giving evidence that there is still life in the field."],"exits":[{"to":153,"exit":"north","move":"north"},{"to":162,"exit":"east","move":"east"},{"to":163,"exit":"down","move":"down","hidden":true}]},
  {"id":155,"x":100,"y":-140,"z":0,"title":"Monastery, Drained Field","descriptions":["Several forlorn stalks of corn still stand, seemingly huddled together for protection against whatever creatures roam the fields.  A fetid smell of stale water rises from the drainage ditch that skirts one side of the field.  Some blueberry bushes are visible to the northeast, just beyond a dirt path."],"exits":[{"to":141,"exit":"go","move":"go narrow track"},{"to":156,"exit":"west","move":"west"},{"to":163,"exit":"down","move":"down","hidden":true}]},
  {"id":156,"x":80,"y":-140,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":155,"exit":"east","move":"east"},{"to":157,"exit":"west","move":"west"},{"to":166,"exit":"down","move":"down","hidden":true}]},
  {"id":157,"x":60,"y":-140,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":156,"exit":"east","move":"east"},{"to":158,"exit":"west","move":"west"}]},
  {"id":158,"x":40,"y":-140,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":157,"exit":"east","move":"east"},{"to":159,"exit":"west","move":"west"}]},
  {"id":159,"x":20,"y":-140,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":158,"exit":"east","move":"east"},{"to":153,"exit":"west","move":"west"}]},
  {"id":160,"x":60,"y":-100,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":146,"exit":"east","move":"east"},{"to":161,"exit":"west","move":"west"}]},
  {"id":161,"x":40,"y":-100,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":160,"exit":"east","move":"east"},{"to":162,"exit":"west","move":"west"},{"to":163,"exit":"down","move":"down","hidden":true}]},
  {"id":162,"x":20,"y":-100,"z":0,"title":"Monastery, Drained Field","descriptions":["Ruined stalks of corn lie crushed in the dirt, the ears torn from the stem and cast haphazardly about.  The furrow of stricken plants continues to the east and west.  From within the drainage ditch edging the field can be heard the sounds of insects buzzing and something rustling in the vegetation."],"exits":[{"to":154,"exit":"west","move":"west"}]},
  {"id":163,"x":20,"y":-120,"z":0,"title":"Monastery, Drainage Ditch","descriptions":["Water pools at the bottom of the ditch, just deep enough to soak feet and breed mosquitos.  Weeds sprout from the mud, and tufts of grass cling to the ditch walls.  An unseen frog croaks in the vegetation.  Small, nearly invisible insects buzz near your ears and nose."],"exits":[{"to":164,"exit":"east","move":"east"},{"to":167,"exit":"west","move":"west","hidden":true},{"to":155,"exit":"out","move":"out","hidden":true},{"to":154,"exit":"up","move":"up","hidden":true}]},
  {"id":164,"x":40,"y":-120,"z":0,"title":"Monastery, Drainage Ditch","descriptions":["Water pools at the bottom of the ditch, just deep enough to soak feet and breed mosquitos.  Weeds sprout from the mud, and tufts of grass cling to the ditch walls.  An unseen frog croaks in the vegetation.  Small, almost invisible insects buzz near your ears and nose."],"exits":[{"to":165,"exit":"east","move":"east"},{"to":163,"exit":"west","move":"west"},{"to":153,"exit":"up","move":"up","hidden":true},{"to":155,"exit":"out","move":"out","hidden":true}]},
  {"id":165,"x":60,"y":-120,"z":0,"title":"Monastery, Drainage Ditch","descriptions":["Water pools at the bottom of the ditch, just deep enough to soak feet and breed mosquitos.  Weeds sprout from the mud, and tufts of grass cling to the ditch walls.  An unseen frog croaks in the vegetation.  Small, nearly invisible bugs buzz near your ears and nose."],"exits":[{"to":166,"exit":"east","move":"east"},{"to":164,"exit":"west","move":"west"},{"to":146,"exit":"up","move":"up","hidden":true},{"to":155,"exit":"out","move":"out","hidden":true}]},
  {"id":166,"x":80,"y":-120,"z":0,"title":"Monastery, Drainage Ditch","descriptions":["Water pools at the bottom of the ditch, just deep enough to soak feet and breed mosquitos.  Weeds sprout from the mud, and tufts of grass cling to the ditch walls.  An unseen frog croaks in the vegetation.  Small, nearly invisible insects buzz near your ears."],"exits":[{"to":167,"exit":"east","move":"east"},{"to":165,"exit":"west","move":"west"},{"to":149,"exit":"up","move":"up","hidden":true},{"to":155,"exit":"out","move":"out","hidden":true}]},
  {"id":167,"x":100,"y":-120,"z":0,"title":"Monastery, Drainage Ditch","descriptions":["Water pools at the bottom of the ditch, just deep enough to soak feet and breed mosquitos.  Weeds sprout from the mud, and tufts of grass cling to the ditch walls.  An unseen frog croaks in the vegetation.  Small, almost invisible insects buzz near your ears."],"exits":[{"to":163,"exit":"east","move":"east","hidden":true},{"to":166,"exit":"west","move":"west"},{"to":152,"exit":"up","move":"up","hidden":true},{"to":155,"exit":"out","move":"out","hidden":true}]},
  {"id":168,"x":140,"y":-80,"z":0,"title":"Monastery, Gully","descriptions":["High as a most men's heads, the soft soil of one wall is pocked with gouges, as if someone had tried to climb it.  Insects buzz around weeds sprouting from the shallow water covering the gully floor.  An unseen cricket chirps in the vegetation."],"exits":[{"to":167,"exit":"west","move":"west","hidden":true},{"to":166,"exit":"east","move":"east","hidden":true},{"to":144,"exit":"up","move":"up"},{"to":169,"exit":"southeast","move":"southeast"}]},
  {"id":169,"x":160,"y":-60,"z":0,"title":"Monastery, Gully","descriptions":["Although dry now, loose rocks moved by flowing water and careless feet litter the bottom of the gully slope.  The trench is close to waist deep on a Gor'tog and mounds of dirt mixed among the brambles on the wall rim indicate nature has had help digging.  From somewhere within the brambles, a wren warbles."],"exits":[{"to":170,"exit":"east","move":"east"},{"to":168,"exit":"northwest","move":"northwest"}]},
  {"id":170,"x":180,"y":-60,"z":0,"title":"Monastery, Gully","descriptions":["Seasonal rains have cut a channel leading away from the road in the soft soil.  Only about knee-deep, it might be possible to climb over the sides were it not for the thorny spikeplants that grow along the flanks of the gully.  A few hardy weeds hold tenaciously to the sides of the channel as it cuts deeper into the earth."],"exits":[{"to":169,"exit":"west","move":"west"},{"to":3,"exit":"go","move":"go rutted road"}]},
  {"id":171,"x":340,"y":-100,"z":1,"title":"Deep Forest, Winding Path","descriptions":["Apple trees grow tall in this part of the forest, spread out between the maple and occasionally a willow tree.  Large knotholes in several of them appear to house nests for forest creatures, although many seem to have gone unused for quite some time.  Barely visible through the thick trees to the east is a small pond."],"exits":[{"to":173,"exit":"northeast","move":"northeast"},{"to":172,"exit":"south","move":"south"}]},
  {"id":172,"x":340,"y":-80,"z":1,"title":"Deep Forest, Winding Path","descriptions":["Large huckleberry shrubs somewhat obscure the beginning of this small trail, which winds its way between several tall maple and poplar trees.  Their branches tangle together overhead, forming a dense canopy.  In contrast, the forest floor is sparsely covered, with only a few small wildflowers poking through the cover of decaying leaves."],"exits":[{"to":171,"exit":"north","move":"north"}],"aliases":["Path"]},
  {"id":173,"x":360,"y":-120,"z":1,"title":"Deep Forest, Winding Path","descriptions":["A crumbled piece of white marble is set in a wide spot between two half-dead trees, the chunk of stone looking to be the broken remnants of a monument or statue.  No longer recognizable at all, the marble's surface is covered in the forest's climbing vines, making it their home.  Overhead, the branches are quite thick, the apple trees flourishing in this area."],"exits":[{"to":171,"exit":"southwest","move":"southwest"},{"to":174,"exit":"west","move":"west"}]},
  {"id":174,"x":340,"y":-120,"z":1,"title":"Deep Forest, Winding Path","descriptions":["The path here splits in two different directions, each one branching off sharply.  Set at the center of the junction is a large sana'ati tree, much taller than any of the others in the forest.  Small white mushrooms dot the dirt around the tree's roots, although the area is otherwise quite clear of debris or undergrowth."],"exits":[{"to":176,"exit":"north","move":"north"},{"to":173,"exit":"east","move":"east"},{"to":175,"exit":"southwest","move":"southwest"}],"aliases":["Firewood"]},
  {"id":175,"x":320,"y":-100,"z":1,"title":"Deep Forest, Winding Path","descriptions":["The forest path sharply ends here at a fallen tree trunk, although the trail looks like it once continued further.  Shining clubmoss covers the ground and some of the trees, and the area feels somewhat damp.  Tangles of vine, shrubs and other undergrowth cover the felled trunk and the space around it, making passage completely impossible."],"exits":[{"to":174,"exit":"northeast","move":"northeast"}],"aliases":["Tynick"]},
  {"id":176,"x":340,"y":-140,"z":1,"title":"Deep Forest, Monastery Wall","descriptions":["Stopping the trees abruptly, a tall stone wall rises above the forest canopy.  Set into the wall's outward face is a small iron gate, and the courtyard of a monastery can be seen through it.  Far too small to be a main entrance, it appears to be a back way into the grounds and is a little rusted from years of weathering."],"exits":[{"to":174,"exit":"south","move":"south"},{"to":177,"exit":"go","move":"go iron gate"}],"aliases":["Adano"]},
  {"id":177,"x":420,"y":-180,"z":1,"title":"Monastery Grounds, Gate","descriptions":["A well-kept cobblestone path runs through the center of a large green lawn, which appears to be very freshly cut.  Although a tall iron fence runs parallel to the pathway and cuts off passage, it's still easy to see several buildings through it, each of them made of mortared stone.  Standing next to the walkway is a single lamppost, also made of cast iron."],"exits":[{"to":178,"exit":"east","move":"east"},{"to":181,"exit":"west","move":"west"},{"to":176,"exit":"go","move":"go gate"},{"to":176,"exit":"go","move":"go iron gate"}]},
  {"id":178,"x":440,"y":-180,"z":1,"title":"Monastery Grounds, Courtyard Path","descriptions":["The expansive lawn is meticulously kept free of any weeds, creating a completely uniform sea of green on either side of the cobblestone path.  The view through a wrought iron fence shows several buildings, and each one appears to be set aside for a specific purpose.  Directly to the north is a modestly sized chapel, its stained glass windows and wooden doors a bit marred by the accumulation of dust and dirt."],"exits":[{"to":179,"exit":"east","move":"east"},{"to":177,"exit":"west","move":"west"}]},
  {"id":179,"x":460,"y":-180,"z":1,"title":"Monastery Grounds, Side Entrance","descriptions":["The cobblestone pathway passes between two buildings, turning the space briefly into an alleyway.  Each structure is several stories tall, although it's hard to judge exactly because of the flat roofing.  Though the southern building has a small window facing the alley, the interior is fully obscured by heavy grey curtains.  A small wooden door leads into the northern building, apparently a side entrance."],"exits":[{"to":180,"exit":"east","move":"east"},{"to":178,"exit":"west","move":"west"},{"to":185,"exit":"go","move":"open door"}],"aliases":["Side Entrance"]},
  {"id":180,"x":480,"y":-180,"z":1,"title":"Monastery Grounds, Iron Gate","descriptions":["The cobblestone pathway stops at a tall stone fence, which seems to be more for appearance than to keep out intruders.  A sign hangs above the entrance, marking it as the monastery's private cemetery.  Growing near the entrance is a small poplar tree, looking like it's not much older than a sapling."],"exits":[{"to":179,"exit":"west","move":"west"},{"to":183,"exit":"go","move":"open iron gate"}],"aliases":["Iron Gate"]},
  {"id":181,"x":400,"y":-180,"z":1,"title":"Monastery Grounds, Greenhouse Entrance","descriptions":["The narrow cobblestone path continues east and west, looking as if its surface was washed recently.  Visible through a wrought iron fence is a large covered greenhouse, rows of ripening grapes and other plants visible within.  A small wooden gate leads into the carefully crafted structure, and next to it sits a large washtub full of monk's clothes."],"exits":[{"to":177,"exit":"east","move":"east"},{"to":182,"exit":"west","move":"west"},{"to":184,"exit":"go","move":"open wooden gate"}]},
  {"id":182,"x":380,"y":-180,"z":1,"title":"Monastery Grounds, Abandoned Tower","descriptions":["A tall tower stands at the end of the cobblestone path, made from the same stone as the other buildings dotting the grounds of the complex.  With a sturdy iron door that looks solidly locked, the structure's function seems to be a mystery, though the occasional window is visible a few stories up.  Lush vineyards can be seen through the wrought iron fence to the north, growing in neat rows on white trellises."],"exits":[{"to":181,"exit":"east","move":"east"},{"to":302,"exit":"go","move":"knock tower"}]},
  {"id":183,"x":480,"y":-200,"z":1,"title":"Monastery Grounds, Graveyard","descriptions":["Neat rows of headstones fill three quarters of this small cemetery, which looks to be kept clean and regularly maintained.  Set into the stone at the front of each grave marker is a simple medallion bearing the names of the monks entombed in the area.  Small poplar trees planted in each corner of the cemetery give a bit of shade."],"exits":[{"to":180,"exit":"none","move":"open iron gate"}],"aliases":["Graveyard"]},
  {"id":184,"x":400,"y":-200,"z":1,"title":"Monastery Grounds, Greenhouse","descriptions":["Rows upon rows of flourishing plants grow inside this greenhouse, protected no matter the weather or season.  Clusters of fat grapes hang on carefully spaced vines, clearly labeled to show when they will ripen.  Other fresh fruits and vegetables are planted in rows near the back, providing fresh food for the winter months."],"exits":[{"to":181,"exit":"go","move":"open wooden gate"}],"aliases":["Greenhouse"]},
  {"id":185,"x":460,"y":-200,"z":1,"title":"Monastery, Narrow Passage","descriptions":["The stone walls contrast somewhat with the polished white marble floor, which has a narrow strip of dark red carpeting running down the center.  Although careful work has gone into detailing and carving the architecture, the walls are completely bare and seem almost sterile.  Set into the eastern wall is a steepled window featuring plain glass in an iron frame, which looks out into a small graveyard."],"exits":[{"to":186,"exit":"northeast","move":"northeast"},{"to":179,"exit":"go","move":"open door"}]},
  {"id":186,"x":480,"y":-220,"z":1,"title":"Monastery, Narrow Passage","descriptions":["Large portions of the hallway's walls are very smooth, divided by columns that break up the pattern of the flagstone.  Though these sections are almost completely bare, flecks of paint at the very edges imply that images once decorated the walls but have long since been scrubbed away.  Gaethzen orbs hang from the ceiling high above, illuminating the narrow hall in a somewhat dim light."],"exits":[{"to":187,"exit":"north","move":"north"},{"to":185,"exit":"southwest","move":"southwest"},{"to":243,"exit":"go","move":"knock iron doors"}]},
  {"id":187,"x":480,"y":-240,"z":1,"title":"Monastery, Winding Passage","descriptions":["The hallway here bends slightly, a single raised step in the center of the floor.  Though the walls are made of bare mortar stone, elaborate borderwork near the ceiling and floor give it just a touch of elegance.  Placed upon a white stone pedestal at the slight corner is a small sword of polished silver, resting atop a dark red pillow."],"exits":[{"to":188,"exit":"northeast","move":"northeast"},{"to":186,"exit":"south","move":"south"},{"to":198,"exit":"go","move":"open narrow door"}]},
  {"id":188,"x":500,"y":-260,"z":1,"title":"Monastery, Winding Passage","descriptions":["A single raised step in the center of the hallway marks a slight bend in the passage.  Gold leaf adorns the top and bottom borders of the rough stone walls, which are spaced every so often with carved marble columns.  Securely bolted to the northern wall is a large lead sheet, which looks somewhat scuffed in various places."],"exits":[{"to":189,"exit":"east","move":"east"},{"to":187,"exit":"southwest","move":"southwest"}],"color":"#00FF00","aliases":["Markat","Spell Preps"]},
  {"id":189,"x":520,"y":-260,"z":1,"title":"Monastery, Winding Passage","descriptions":["Torches are set at periodic intervals on each wall of this wide passageway, flickering and sending tongues of orange light to play over the grey stone.  Crafted from polished steel, a small medallion hangs around the base of one of dark iron sconces.  The hallway ends to the east at an elegantly arched door, its surface covered with ornate carvings."],"exits":[{"to":188,"exit":"west","move":"west"},{"to":190,"exit":"go","move":"knock on arched door;knock on arched door"}]},
  {"id":190,"x":540,"y":-260,"z":1,"title":"Monastery Commons Room, Southwest Corner","descriptions":["The ceiling rises upward and toward the northeast to form a dramatic arched dome, a large marble obelisk centered exactly underneath it.  Puffy white clouds are painted onto the dome, giving it a very open feeling.  Several granite benches line the southern wall, providing a convenient place for a brief respite."],"exits":[{"to":191,"exit":"north","move":"north"},{"to":192,"exit":"east","move":"east"},{"to":189,"exit":"go","move":"open arched door"}]},
  {"id":191,"x":540,"y":-280,"z":1,"title":"Monastery Commons Room, Northwest Corner","descriptions":["Overshadowing everything else in the room is a massive set of double doors in the northern wall, marking the main entrance to the building.  Although it appears to have been carved with many deities, all of the work is very abstract, making it impossible to recognize any individual one.  The rest of this corner of the commons room is quite bare, with no furnishings at all except a tall marble obelisk standing in the center of the room."],"exits":[{"to":194,"exit":"east","move":"east"},{"to":190,"exit":"south","move":"south"},{"to":258,"exit":"go","move":"go narrow archway"}]},
  {"id":192,"x":560,"y":-260,"z":1,"title":"Monastery Commons Room, Southeast Corner","descriptions":["A curious arrangement graces the southern wall of the common room.  Three arched windows rise high in the stonework, two of them filled with clear, textured glass.  The third is crafted from elaborate stained glass, seeming a little out of place next to the others.  To the east is a small entryway, and a large marble obelisk stands in the center of the common room."],"exits":[{"to":194,"exit":"north","move":"north"},{"to":193,"exit":"east","move":"east"},{"to":190,"exit":"west","move":"west"}],"aliases":["bucket"]},
  {"id":193,"x":580,"y":-260,"z":1,"title":"Monastery, Narrow Entryway","descriptions":["Apparently a side entrance leading into the building, the door is rather plain, although it apparently sees frequent use.  Twin torches frame the entryway, set into metallic sconces bolted to rising columns in the corners of this short hallway.  A large common area opens up to the west, with a white obelisk standing in the center of it."],"exits":[{"to":192,"exit":"west","move":"west"},{"to":195,"exit":"go","move":"go plain door"}]},
  {"id":194,"x":560,"y":-280,"z":1,"title":"Monastery Commons Room, Northeast Corner","descriptions":["A dramatic arched dome rises in the center of the common room, a large marble obelisk positioned underneath it and standing quite tall.  Muted wisps of cloud are painted onto the dome, mimicking the noontime sky.  Several prayer mats are lined against the north and eastern walls, providing a convenient place for worship."],"exits":[{"to":192,"exit":"south","move":"south"},{"to":191,"exit":"west","move":"west"}]},
  {"id":195,"x":600,"y":-260,"z":1,"title":"Monastery, Cloister","descriptions":["Two shade-filled arcades flanked by an array of plaster columns meet at the corner of this plain cloister, which ends to the south and west at grey stone walls.  The curving tops of the columns give way to stylized ogee arches that look out into a secret garden.  A small window is set in the northern wall, offering a glimpse into the monastery grounds."],"exits":[{"to":196,"exit":"east","move":"east"},{"to":193,"exit":"go","move":"go narrow door"}],"color":"#00FF00","aliases":["Tea"]},
  {"id":196,"x":620,"y":-260,"z":1,"title":"Monastery, Cloister","descriptions":["The bright colors of the gardens beyond the massive arched opening are a vibrant contrast to the dull grey of the stone walls surrounding the meditation area.  A trio of thick reed mats lines the floor, each arranged in a circle surrounding a small fountain.  From outside, the peaceful cloister garden contributes its own natural perfume to the combination of fragrances wafting from the stalks of burning incense."],"exits":[{"to":197,"exit":"east","move":"east"},{"to":195,"exit":"west","move":"west"}]},
  {"id":197,"x":640,"y":-260,"z":1,"title":"Monastery, Cloister","descriptions":["A light breeze drifts in from the open ogee arches to the south, bringing with it the scent of fresh flowers.  In sharp contrast to the color in the garden, the greyish stone walls are rather plain and completely unadorned.  Set in the eastern wall is a solid door made from cast iron, its top slightly arched."],"exits":[{"to":196,"exit":"west","move":"west"},{"to":233,"exit":"go","move":"go solid door"},{"to":268,"exit":"go","move":"go marble archway"}],"color":"#FF0000","aliases":["Cloister","Belt Knives"]},
  {"id":198,"x":480,"y":-260,"z":1,"title":"Monastery, Side Passage","descriptions":["Very narrow and rather claustrophobic, the interior of this hallway is quite plain and unadorned, the walls crafted from mortared stones.  Thick red carpeting covers the entire floor, perhaps placed to mute the sound of footsteps.  The only light in the area is somewhat dim torchlight, filtering in from the passage to the north."],"exits":[{"to":199,"exit":"north","move":"north"},{"to":187,"exit":"go","move":"open iron door"}]},
  {"id":199,"x":480,"y":-280,"z":1,"title":"Monastery, Stairwell","descriptions":["The cramped, curving hallway is difficult to see down, its southern end washed out by torchlight.  A narrow strip of red carpeting runs down the center of the stone floor, both kept very clean.  Twin torches burn on the walls, their red and orange light flickering and playing off the mortared stone."],"exits":[{"to":198,"exit":"south","move":"south"},{"to":200,"exit":"climb","move":"climb winding stairwell"}]},
  {"id":200,"x":480,"y":-300,"z":1,"title":"Monastery, Shaded Balcony","descriptions":["Though the rest of the hallway is almost sterile in appearance, the northern wall opens completely out into a balcony, providing a view just over the treetops.  The resulting view extends for miles, offering a distant glimpse of the Greater Fist on the horizon.  Somehow the area is kept completely clean, even while exposed to the elements and inclement weather.","Though the rest of the hallway is almost sterile in appearance, the northern wall opens completely out into a balcony, providing a view just over the treetops.  The nighttime sky is clearly visible, extending over the forest like a dark blanket.  Dim torches line the railing, burning with an orange glow."],"exits":[{"to":201,"exit":"west","move":"west"},{"to":199,"exit":"climb","move":"climb winding stairwell"}]},
  {"id":201,"x":460,"y":-300,"z":1,"title":"Monastery, Shaded Balcony","descriptions":["The northern wall of this narrow hallway fans out into a covered balcony, providing a sharp view of the forest below.  Endless trees form a rough canopy that hides anything below them, extending to the mountains to the distant north.  Occasionally a small bird passes in front of the stone railing, fluttering its wings and keeping a fair distance away.","Brightly burning torches set on the southern wall nearly obscure the view from a balcony to the north.  The sky appears pitch black, and the trees below look like little more than the vague outline of shadows.  A waist-high stone railing blocks off the balcony, preventing any serious falls."],"exits":[{"to":200,"exit":"east","move":"east"},{"to":202,"exit":"southwest","move":"southwest"}]},
  {"id":202,"x":440,"y":-280,"z":1,"title":"Monastery, Narrow Passage","descriptions":["Both walls are very smooth and completely bare, contrasting sharply with the arching ceiling overhead and its elaborate design.  A deep red carpet runs down the center of the marble floor, muting footsteps and adding just a hint of warmth to the room.  Blazing torches frame both sides of an ornately carved wooden door set in the northern wall."],"exits":[{"to":201,"exit":"northeast","move":"northeast"},{"to":203,"exit":"southwest","move":"southwest"},{"to":204,"exit":"go","move":"open wooden door"}]},
  {"id":203,"x":420,"y":-260,"z":1,"title":"Monastery, Alcove","descriptions":["Standing in the circular end of the hallway is an elegant statue crafted from white marble which depicts a woman in a long robe.  Coated in elegant gold leaf, the alcove's interior is designed to reflect a shower of light onto the figure, giving it a surreal feeling.  A small window on the southern wall looks out onto the monastery grounds."],"exits":[{"to":202,"exit":"northeast","move":"northeast"}]},
  {"id":204,"x":420,"y":-300,"z":1,"title":"Book's Private Study","descriptions":["Row upon row of volumes and tomes line several darkly stained cedar shelves, taking up the entire eastern wall of the room.  A dark mahogany desk stands in the center of the room, a large and comfortable-looking chair behind it.  Two narrow strips of deep red carpeting run along each side of the desk, simply accenting the black marble floor."],"exits":[{"to":202,"exit":"none","move":"open wooden door"}],"color":"#FF8000","aliases":["Guildleader","GL Necromancer"]},
  {"id":205,"x":520,"y":-20,"z":0,"title":"Zoluren Royal Mews, Courtyard","descriptions":["Swaths of grass cover the interior courtyard, broken only by a rectangular reflecting pool that doubles as a trough and bath for the horses.  The field is hemmed by brick buildings on three sides, with the facade wall and gated archway forming the fourth enclosing structure."],"exits":[{"to":207,"exit":"north","move":"north"},{"to":206,"exit":"west","move":"west"},{"to":18,"exit":"go","move":"go wrought gates"},{"to":215,"exit":"go","move":"go brick building"}]},
  {"id":206,"x":500,"y":-20,"z":0,"title":"Zoluren Royal Mews, Courtyard","descriptions":["Hungry -- or bored -- horses have ignored the stacks of baled hay nearby in favor of cropping several bare patches into the grass.  A low set of fieldstone steps leads up to a red door.  A plaque next to the door reads, Stablemaster."],"exits":[{"to":208,"exit":"north","move":"north"},{"to":205,"exit":"east","move":"east"},{"to":210,"exit":"go","move":"go red door"}]},
  {"id":207,"x":520,"y":-40,"z":0,"title":"Zoluren Royal Mews, Courtyard","descriptions":["A large brick stable stands here with its dark wooden doors thrown wide open.  A nearby well is festooned with buckets and rope, with young children often seen sprinting from the stable to the well, enhancing their daily chores with a race.  Some slightly trampled climbing rose bushes grow up against one side of the stable."],"exits":[{"to":205,"exit":"south","move":"south"},{"to":208,"exit":"west","move":"west"},{"to":211,"exit":"go","move":"go narrow pathway"},{"to":214,"exit":"go","move":"go wooden doors"}],"aliases":["Zoluren Royal Mews"]},
  {"id":208,"x":500,"y":-40,"z":0,"title":"Zoluren Royal Mews, Courtyard","descriptions":["Just off the courtyard stands a red brick building with a profusion of roses guarding its entrance.  Stone steps that lead to its dark doors bear the print of horses' hoofs, giving them a faintly whimsical look.  A wooden sign peeks out from behind one of the thorny rose bushes."],"exits":[{"to":207,"exit":"east","move":"east"},{"to":206,"exit":"south","move":"south"},{"to":209,"exit":"go","move":"go dark doors"}]},
  {"id":209,"x":480,"y":-40,"z":0,"title":"Zoluren Royal Mews, Brokerage Offices","descriptions":["Crisp, clean smells emanate from the freshly polished chestnut floor.  An archway to one side of the entryway leads to a cozy sitting room while on the other is a mahogany door."],"exits":[{"to":208,"exit":"out","move":"out"},{"to":317,"exit":"go","move":"go archway"},{"to":318,"exit":"go","move":"go mahogany door"}],"aliases":["Brokerage Offices"]},
  {"id":210,"x":480,"y":-20,"z":0,"title":"Zoluren Royal Mews, Stablemaster","descriptions":["Shelves filled with tastefully arranged trophies and ribbons line one wall of the Stablemaster's office, and the wall opposite is taken up with books describing all aspects of horse care and instruction in equestrian skills.  An ornate desk, set upon wood carved horse-hoof feet is pushed against a window overlooking the stableyard."],"exits":[{"to":206,"exit":"go","move":"go red door"}],"color":"#00FF00","aliases":["Stablemaster Kenefick"]},
  {"id":211,"x":540,"y":-60,"z":0,"title":"Zoluren Royal Mews, Training Field","descriptions":["The air is filled with the scent of fresh grass and the smell of horses.  A narrow pathway opens into a practice field for trainers and their spirited horses.  High fences covered in ivy and moss offer jumpers a challenging course.  The field also features a row of barrels and a low brick wall that gives the horses variety of tasks as their handlers put them through their paces."],"exits":[{"to":212,"exit":"northeast","move":"northeast"},{"to":207,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":212,"x":560,"y":-80,"z":0,"title":"Zoluren Royal Mews, Training Field","descriptions":["Another practice area opens up, with the scent of fresh grass and the smell of horses in sharp contrast to the fragrant roses planted against a nearby brick wall.  Wooden barrels and fences provide the perfect opportunity for practicing jumps and turns."],"exits":[{"to":213,"exit":"northeast","move":"northeast"},{"to":211,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":213,"x":580,"y":-100,"z":0,"title":"Zoluren Royal Mews, Jousting Field","descriptions":["Sectioned off for more strenuous training, this jousting field offers benches for watchers to be comfortably seated.  A ring of tall oak trees forms a natural stadium for horses and their riders to showcase their jousting abilities.  Not a day goes by that some poor soul isn't led off the field by helpful spectators."],"exits":[{"to":212,"exit":"southwest","move":"southwest"}],"color":"#FF0000","aliases":["Jousting Field"]},
  {"id":214,"x":540,"y":-40,"z":0,"title":"Zoluren Royal Mews, Stables","descriptions":["The pungent smell of horses is kept at bay by a wreath of dried herbs and flowers hung on the stall doors of this huge stable.  Made of the finest of maple and oak, each uniform stall is pristinely kept, with nary a straw out of place.  Various instruments of the trade are hung upon one wall, all in neat order.  A trough of fresh water is kept full by young boys, often seen carrying buckets from a nearby well."],"exits":[{"to":207,"exit":"out","move":"out"}],"color":"#00FF00","aliases":["Stables"]},
  {"id":215,"x":520,"y":0,"z":0,"title":"A Bit For Horses, Entrance","descriptions":["Dark oak-paneled walls adorned with oval mirrors and lace-covered shelves enclose this room.  Wide arches on each side of the room lead to more merchandise.  Burgundy velvet settees and chairs are comfortably situated to offer customers a place to rest while contemplating their purchases."],"exits":[{"to":216,"exit":"east","move":"east"},{"to":217,"exit":"west","move":"west"},{"to":205,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Bit For Horses"]},
  {"id":216,"x":540,"y":0,"z":0,"title":"A Bit For Horses, Feed","descriptions":["Eager young clerks stand behind a dark oak counter ready to take orders and handle the horse's feed that is being sold.  From stacks of hay to bags of oats, they lift and haul them from the nearby loading dock and neatly place them along the wooden paneled walls."],"exits":[{"to":215,"exit":"west","move":"west"}],"color":"#FF0000","aliases":["Feed"]},
  {"id":217,"x":500,"y":0,"z":0,"title":"A Bit For Horses, Barding","descriptions":["The fresh smell of leather permeates the air adrift from the newly made saddles and gear that reside in this room.  Sturdy racks and shelves hold various items, from simple horse's brushes to elaborate flanchards polished to perfection."],"exits":[{"to":215,"exit":"east","move":"east"},{"to":218,"exit":"go","move":"go small archway"}],"color":"#FF0000","aliases":["Barding"]},
  {"id":218,"x":500,"y":20,"z":0,"title":"A Bit For Horses, Backroom","descriptions":["A cheerful fire blazes from a brick fireplace along the far wall, a cast-iron teakettle warming inside it.  Brown leather armchairs standing before the fireplace offer a perfect spot for a break.  A narrow stairway at one end leads up into the second story."],"exits":[{"to":217,"exit":"go","move":"go small archway"},{"to":219,"exit":"climb","move":"climb narrow stairway"}]},
  {"id":219,"x":520,"y":20,"z":0,"title":"A Bit For Horses, Top Of Stairs","descriptions":["A narrow stairwell leading back down to the main floor is covered with a well-worn carpet.  Set between a green door and a blue door is a painting of a stunning black stallion."],"exits":[{"to":218,"exit":"climb","move":"climb narrow stairwell"},{"to":220,"exit":"go","move":"go green door"},{"to":221,"exit":"go","move":"go blue door"}],"color":"#00FFFF"},
  {"id":220,"x":520,"y":40,"z":0,"title":"A Bit For Horses, Clerk's Room","descriptions":["Neat and tidy describes this room with its small quilt-covered bed and oak wardrobe.  Green throw rugs cover the floor and carvings of horses line a couple of narrow shelves.  A bouquet of dried daisies tied with leather cord hang upside down from the top of an arched window."],"exits":[{"to":219,"exit":"go","move":"go green door"}]},
  {"id":221,"x":540,"y":40,"z":0,"title":"A Bit For Horses, Workroom","descriptions":["Tables line one wall of this workroom, covered with neatly folded cloth and rough carvings.  A dark green couch sits opposite with a maple table placed beside it.  Candlelight flickers making shadows against the walls of this quiet area.","Tables line one wall of this workroom, covered with cloth and rough carvings.  A dark green couch sits opposite with a maple table placed beside it.  Arched windows offer light to those working on various projects, from mending caparisons to making handcrafted brushes."],"exits":[{"to":219,"exit":"go","move":"go blue door"}]},
  {"id":222,"x":280,"y":-200,"z":0,"title":"North Turnpike, Farmland","descriptions":["Northwest of the road, a burnt-out farmhouse stands, or perhaps lies is a better word, since all that time or war has left is a stone chimney, cold among the meadow grasses.  Bright splashes of color -- wild red roses, orange butterfly weed, yellow day-lilies -- surround the ruins, like nature's funeral wreath."],"exits":[{"to":10,"exit":"south","move":"south"},{"to":11,"exit":"northwest","move":"northwest"},{"to":247,"exit":"go","move":"go marble tower"}]},
  {"id":223,"x":320,"y":-180,"z":0,"title":"Rugglestone Close, Glennview Lane","descriptions":["Whitewash and dark oak beams mix on the tiny half-timbered cottages which line the cobblestoned lane.  Granite-topped brick walls surround the houses, their hard outlines softened by deep green moss which clings to the mortar.  Kitchen gardens grow within the shelter of the walls -- herbs, fruit trees and vegetables all within easy reach of the door."],"exits":[{"to":226,"exit":"north","move":"north"},{"to":225,"exit":"east","move":"east"},{"to":8,"exit":"southwest","move":"southwest"},{"to":224,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":224,"x":300,"y":-180,"z":0,"title":"Rugglestone Close, Glennview Lane","descriptions":["The tile roofs of the cottages along the lane are carefully laid out to channel rainwater away from the plaster walls and into barrels, where it may be collected for use in cooking and laundry.  A tangled mass of ivy sends winding tendrils out to wrap around the brick chimneys and walls of one cottage, leaving little to see but the diamond-shaped panes of glass in its windows."],"exits":[{"to":228,"exit":"north","move":"north"},{"to":226,"exit":"northeast","move":"northeast"},{"to":223,"exit":"east","move":"east"}],"color":"#00FFFF"},
  {"id":225,"x":340,"y":-180,"z":0,"title":"Rugglestone Close, Glennview Lane","descriptions":["A rishyarla bush grows close to the wall surrounding a nearby home, its pale yellow blossoms filling the air with an intense, sweet fragrance.  Like the other cottages which line the street, the half-timbered structure shows signs of careful upkeep.  The shrubs surrounding the house are carefully pruned, and cheesecloth netting protects the fruit trees from the ravages of the local birds."],"exits":[{"to":231,"exit":"north","move":"north"},{"to":223,"exit":"west","move":"west"},{"to":226,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":226,"x":320,"y":-200,"z":0,"title":"Rugglestone Close, The Common","descriptions":["At the center of the close, a grassy square provides an open area where cattle graze during the day.  The hoarse bray of a mule mingles with the sharp noise of a chisel as a stonemason works on the other side of the square, shaping the stones for a new fence.  A gravel-lined path leads to a small rose-covered gazebo.","At night, young people gather beneath a rose-covered gazebo in the center of the square.  Lively strains of music float through the air to set toes tapping and tempt even the most conservative matron to remember the carefree days of her youth."],"exits":[{"to":227,"exit":"north","move":"north"},{"to":230,"exit":"northeast","move":"northeast"},{"to":231,"exit":"east","move":"east"},{"to":225,"exit":"southeast","move":"southeast"},{"to":223,"exit":"south","move":"south"},{"to":224,"exit":"southwest","move":"southwest"},{"to":228,"exit":"west","move":"west"},{"to":229,"exit":"northwest","move":"northwest"},{"to":232,"exit":"go","move":"go gazebo"}],"color":"#00FFFF","aliases":["Rugglestone Close"]},
  {"id":227,"x":320,"y":-220,"z":0,"title":"Rugglestone Close, Poltrefanli Road","descriptions":["Painted wooden planters filled with herbs or colorful flowers grow outside the windows of cottages lining the street.  Within the brick walls surrounding each house, tiny gardens grow in the limited space.  At one home, a row of pies cools on the window ledge sending a tantalizing aroma wafting across the cobblestone street."],"exits":[{"to":230,"exit":"east","move":"east"},{"to":226,"exit":"south","move":"south"},{"to":229,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":228,"x":300,"y":-200,"z":0,"title":"Rugglestone Close, Shar'hen Way","descriptions":["Diamond-shaped panes of thick, wavy glass attest to the age of the homes which line the cobblestoned streets.  Impurities in the glass have resulted in a faint violet tint to the glazing, an attractive contrast to the blackened solder which holds the windows together."],"exits":[{"to":229,"exit":"north","move":"north"},{"to":226,"exit":"east","move":"east"},{"to":224,"exit":"south","move":"south"}],"color":"#00FFFF"},
  {"id":229,"x":300,"y":-220,"z":0,"title":"Rugglestone Close, Poltrefanli Road","descriptions":["The dark oak beams of the cottages have been carved with fanciful figures of gargoyles and fae, or with intricate knotwork patterns which run along the front of the homes.  Other homes have stark white plaster walls broken by a decorative arrangement of the exposed oak beams."],"exits":[{"to":227,"exit":"east","move":"east"},{"to":226,"exit":"southeast","move":"southeast"},{"to":228,"exit":"south","move":"south"}],"color":"#00FFFF"},
  {"id":230,"x":340,"y":-220,"z":0,"title":"Rugglestone Close, Poltrefanli Road","descriptions":["Nestled amidst the homes of the close, a tiny shop displays an assortment of carpets and other floor coverings hanging from its wall.  Imported from distant lands like Aesry Surlaenis'a and Mer'Kresh, the rugs feature wool dyed in vibrant shades of scarlet, blue and golden, and woven into intricate floral or geometric designs."],"exits":[{"to":231,"exit":"south","move":"south"},{"to":226,"exit":"southwest","move":"southwest"},{"to":227,"exit":"west","move":"west"},{"to":252,"exit":"go","move":"go tiny shop"}],"color":"#00FFFF"},
  {"id":231,"x":340,"y":-200,"z":0,"title":"Rugglestone Close, Du'hen Way","descriptions":["Housewives gather to gossip over the brick walls which divide the half-timbered cottages around the square.  Their sharp glances measure the probable worth of passersby, or take in the poorly mended sleeve of a neighbor's gown, all of which is discussed in low tones as they fold laundry or work in their tiny garden plots.","The streets are quiet in the evening, the shadows partially dispelled by the warm glow of candle light which streams through the windows of nearby cottages.  The stillness is broken only by the faint clatter of footsteps against the cobblestones, or the occasional barking of a neighbor's dog."],"exits":[{"to":230,"exit":"north","move":"north"},{"to":225,"exit":"south","move":"south"},{"to":226,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":232,"x":340,"y":-160,"z":0,"title":"Rugglestone Close, Gazebo on the Common","descriptions":["The soft pine floorboards of the gazebo have been polished to a warm, golden glow by the footsteps of dancers who gather here during the evening.  In one corner, a semicircle of music stands holds sheet music for a lively medley of songs to be played by musicians while laughing couples perform the steps of a traditional country dance."],"exits":[{"to":226,"exit":"out","move":"out"}],"aliases":["Gazebo on the Common"]},
  {"id":233,"x":660,"y":-260,"z":1,"title":"Monastery, Side Yard","descriptions":["This small yard is rather enclosed but is maintained very well.  Covering the entire lawn is a bed of healthy-looking green grass, and a narrow fence connects to a small wooden building nearby, surrounding the peaceful area.  The walls of the structure look very freshly painted in a plain grey color."],"exits":[{"to":197,"exit":"go","move":"go cloister"},{"to":234,"exit":"go","move":"go archway"}]},
  {"id":234,"x":680,"y":-260,"z":1,"title":"Monastery, Monks' Quarters","descriptions":["Plain white walls interspersed with pillars rise to meet a low ceiling.  Each plaster wall is lined with burning oil lamps set on small shelves in even intervals.  Light streams in through a single stained glass window set high above the entrance, creating a perfect circle of blue-tinged light on the cold marble floor.","Plain white walls interspersed with pillars rise to meet a low ceiling.  Each plaster wall is lined with burning oil lamps set on small shelves in even intervals, casting flickers of shadow across the cold stone marble.  Noise from crickets outside echoes quietly through the wide hallway, punctuated occasionally by the distant hoot of an owl."],"exits":[{"to":235,"exit":"east","move":"east"},{"to":237,"exit":"south","move":"south"},{"to":233,"exit":"go","move":"go archway"}],"color":"#00FFFF"},
  {"id":235,"x":700,"y":-260,"z":1,"title":"Monastery, Monks' Quarters","descriptions":["White marble columns flecked with veins of silver and jade stand at regular intervals of this wide hallway, with doors to individual sleeping areas spaced between them.  The cool marble floor is bare, although polished and very clean.  Standing in one corner is a small vase that holds a delicate fern, the small plant thriving in the cool indoors."],"exits":[{"to":236,"exit":"south","move":"south"},{"to":234,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":236,"x":700,"y":-240,"z":1,"title":"Monastery, Monks' Quarters","descriptions":["Light streams unhindered through an arched window on the eastern wall, illuminating small motes drifting through the hall.  Doors on either side of the hall lead to the monks' living quarters.  A lone wooden bench pushed against the wall gives a place for brief respite for the weary.","Burning hot in the corner of the room, an iron brazier illuminates the wide hallway, staining the ceiling above it with circles of dark smoke.  Doors on either side of the hall lead to the monks' living quarters.  A lone wooden bench pushed against the wall gives a place for brief respite for the weary."],"exits":[{"to":235,"exit":"north","move":"north"},{"to":237,"exit":"west","move":"west"},{"to":238,"exit":"climb","move":"climb iron stairs"}],"color":"#00FFFF"},
  {"id":237,"x":680,"y":-240,"z":1,"title":"Monastery, Monks' Quarters","descriptions":["A single small painting hangs on the northern wall of this wide hallway, placed on one of the columns between the doors to the individual monks' quarters.  A bright spot of color in an otherwise monotone area, the artwork depicts an elaborate forest scene that contrasts sharply with the sterile hall."],"exits":[{"to":234,"exit":"north","move":"north"},{"to":236,"exit":"east","move":"east"}],"color":"#00FFFF"},
  {"id":238,"x":740,"y":-260,"z":1,"title":"Monastery, Narrow Hallway","descriptions":["Barely wide enough for two people to walk side by side, this cramped hallway has been left undecorated, designed more for function than show.  The ceiling slopes sharply and shows the underside of the roof overhead, while the plain wooden floor is softened somewhat by a runner of deep red carpet."],"exits":[{"to":239,"exit":"north","move":"north"},{"to":241,"exit":"west","move":"west"},{"to":236,"exit":"climb","move":"climb iron stairs"}],"color":"#00FFFF"},
  {"id":239,"x":740,"y":-280,"z":1,"title":"Monastery, Narrow Hallway","descriptions":["Bare ends of nails are still visible in the wooden walls, making this hallway seem almost like an afterthought.  Although the beginnings of paint and plaster are visible, the project appears to have been abandoned halfway through.  Only the deep red carpeting is fully in place.  The cramped hall is very poorly lit, with deep shadows lurking in every corner."],"exits":[{"to":238,"exit":"south","move":"south"},{"to":240,"exit":"west","move":"west"}],"color":"#00FFFF"},
  {"id":240,"x":720,"y":-280,"z":1,"title":"Monastery, Narrow Hallway","descriptions":["The wooden walls in this portion of the monks' quarters are left unpainted, the area seeming unfinished.  Deep red carpeting softens the floor, although the fabric is marred with a little dust.  A lone oil lamp burns on a table in the corner of the windowless hall, carefully isolated from the walls."],"exits":[{"to":239,"exit":"east","move":"east"},{"to":241,"exit":"south","move":"south"}],"color":"#00FFFF"},
  {"id":241,"x":720,"y":-260,"z":1,"title":"Monastery, Narrow Hallway","descriptions":["The ceiling rises sharply to disappear into darkness in a point, marking this location as just underneath the building's watchtower.  Suspended by support beams high overhead is a platform made of wood, the walls rising past it in all directions."],"exits":[{"to":240,"exit":"north","move":"north"},{"to":238,"exit":"east","move":"east"},{"to":242,"exit":"climb","move":"climb iron ladder"}],"color":"#00FFFF"},
  {"id":242,"x":700,"y":-280,"z":1,"title":"Monastery, Watch Tower","descriptions":["Built on support beams in the center of the tower and ringed by a waist-high railing, the platform is surrounded on all sides by open-air windows, offering a panoramic view of the monastery below.  Grapevines to the northwest spread out next to the common area, while several still-ruined portions litter the southeastern grounds."],"exits":[{"to":241,"exit":"climb","move":"climb iron ladder"}]},
  {"id":243,"x":460,"y":-220,"z":1,"title":"Monastery, Dining Hall","descriptions":["A large, ornate table covered with a white cloth shows that this expansive room may have once served as a dining hall.  However, the furniture stands disused and has been pushed far to one side to make way for a large obelisk in the center of the room.  Several arches thinly edged in silver cross high overhead in a sunburst pattern, displaying masterfully carved architecture."],"exits":[{"to":186,"exit":"go","move":"open iron doors"},{"to":244,"exit":"north","move":"north"},{"to":246,"exit":"west","move":"west"}]},
  {"id":244,"x":460,"y":-240,"z":1,"title":"Monastery, Dining Hall","descriptions":["Hanging on the eastern wall is a tapestry painting with a nearly blank canvas, the few splashes of paint vaguely resembling the dawn sun rising over a calm blue ocean.  It gives a bit of color to the otherwise large, spartan dining hall, which is dominated by a tall obelisk in the center of the room."],"exits":[{"to":243,"exit":"south","move":"south"},{"to":245,"exit":"west","move":"west"}]},
  {"id":245,"x":440,"y":-240,"z":1,"title":"Monastery, Dining Hall","descriptions":["A series of towering glass windows rises to the west, letting light filter in from outside.  Standing in the center of the expansive room is a tall marble obelisk, made of chiseled marble but quite plain.  Pushed up against the northern wall is a plain-looking bench, lightly padded across the top with a light red cushion."],"exits":[{"to":244,"exit":"east","move":"east"},{"to":246,"exit":"south","move":"south"}]},
  {"id":246,"x":440,"y":-220,"z":1,"title":"Monastery, Dining Hall","descriptions":["Light streams in through towering glass windows on the western wall rising in elaborate arches, hints of colored glass marring their edges slightly.  The rays illuminate a tall obelisk standing in the center of the expansive room.  An ornate cloth-covered dining table fills the area just under the windows, shoved aside to leave most of the room bare."],"exits":[{"to":245,"exit":"north","move":"north"},{"to":243,"exit":"east","move":"east"}]},
  {"id":247,"x":280,"y":-260,"z":0,"title":"North Tower, Air Floor","descriptions":["A dark grey carpet decorated with a pattern of crossing black lightning bolts covers the floor, matching the decoration on the grey-painted walls.  A constant, low thrum hangs just inside the range of hearing, its source nearby but not readily apparent.  Doors spaced in an even circle around the perimeter lead to initiates' private cells."],"exits":[{"to":249,"exit":"up","move":"up"},{"to":222,"exit":"out","move":"out"},{"to":248,"exit":"climb","move":"climb marble staircase"}],"color":"#00FFFF","aliases":["N Tower","Tower North","Air Floor"]},
  {"id":248,"x":270,"y":-260,"z":0,"title":"North Tower, Earth Floor","descriptions":["Bare, dark soil forms the floor underfoot.  The stony walls surrounding this circular room are similarly devoid of decoration, keeping instead the plain, natural look preferred by those mages who favor the element of Earth.  Doors leading to the initiates' private cells line the walls."],"exits":[{"to":247,"exit":"climb","move":"climb marble staircase"}],"color":"#00FFFF","aliases":["Earth Floor"]},
  {"id":249,"x":280,"y":-270,"z":0,"title":"North Tower, Water Floor","descriptions":["Deep blue carpeting covers the floor, its surface cut in a manner that suggests the rippling of waves upon the surface of a lake.  Bright blue spirals, representing the element of water, fill the walls between a series of doors leading to initiates' private cells.  The air here is moist and cool upon the skin."],"exits":[{"to":250,"exit":"up","move":"up"},{"to":247,"exit":"down","move":"down"}],"color":"#00FFFF","aliases":["Water Floor"]},
  {"id":250,"x":280,"y":-280,"z":0,"title":"North Tower, Fire Floor","descriptions":["Lush, red carpeting covers the floor, muffling any ambient noise into oblivion.  Images of bloated red suns, representing the element of fire, fill the walls between a series of doors leading to initiates' private cells.  The air here is significantly warmer than on the tower's other floors, although the reason is not readily apparent."],"exits":[{"to":251,"exit":"up","move":"up"},{"to":249,"exit":"down","move":"down"}],"color":"#00FFFF","aliases":["Fire Floor"]},
  {"id":251,"x":280,"y":-290,"z":0,"title":"North Tower, Aether Floor","descriptions":["Carpeting the color of a death shroud covers the floor, devouring the light as hungrily as Aldauth consumes souls.  The walls are devoid of decoration, instead painted a uniform black to match the floor.  Only the doors leading to initiates' cells betray any hint of color in this otherwise cold, bleak room."],"exits":[{"to":250,"exit":"down","move":"down"}],"color":"#00FFFF","aliases":["Aether Floor"]},
  {"id":252,"x":360,"y":-200,"z":0,"title":"Rakshalla's Carpets","descriptions":["Brightly colored carpets lie in stacks upon the floor of the shop, with narrow aisles between them to allow customers to browse through the goods offered for sale.  In the far corner of the shop, a young merchant stands behind the counter, ready to take your order (and your money) with a cheerful smile."],"exits":[{"to":253,"exit":"north","move":"north"},{"to":230,"exit":"out","move":"out"}],"color":"#FF0000","aliases":["Rakshalla's Carpets"]},
  {"id":253,"x":360,"y":-210,"z":0,"title":"Rakshalla's Carpets, Prayer Rugs","descriptions":["Incense burns in carved ivory holders shaped like scowling gargoyles or dainty nymphs.  The heady scent clings to clothing as well as the prayer rugs stacked in neat piles around the room.  Behind the counter, Rakshalla's daughter Imfini stands ready to take an order."],"exits":[{"to":252,"exit":"south","move":"south"}],"color":"#FF0000","aliases":["Prayer Rugs"]},
  {"id":254,"x":100,"y":-40,"z":0,"title":"North Turnpike, Meadow Trail","descriptions":["Buffered by forest to the north, this meandering trail is shaded by towering deobar trees high overhead.  Sparsely laid out, the trees provide an attractive shelter to the homes nestled amidst the foliage, while a large meadow opens up away from the forest."],"exits":[{"to":257,"exit":"northeast","move":"northeast"},{"to":109,"exit":"south","move":"south"},{"to":255,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":255,"x":90,"y":-50,"z":0,"title":"North Turnpike, Meadow Trail","descriptions":["The sporadic chiming of the nearby monastery bell rests, blanketing the area in silence.  Wildflowers twinkle in the light shed by nearby homes, giving their colorful tones an eerie cast."],"exits":[{"to":256,"exit":"northeast","move":"northeast"},{"to":254,"exit":"southeast","move":"southeast"}],"color":"#00FFFF"},
  {"id":256,"x":100,"y":-60,"z":0,"title":"North Turnpike, Meadow Trail","descriptions":["Wooden pallets form an uneven trail through the thicker woods.  Massive blueberry bushes dot the area creating a dense canopy for small skittering woodland animals.  Tucked into the overgrowth, thatched cottages melt into their surroundings, creating harmony between habitation and the natural world."],"exits":[{"to":257,"exit":"southeast","move":"southeast"},{"to":255,"exit":"southwest","move":"southwest"}],"color":"#00FFFF"},
  {"id":257,"x":110,"y":-50,"z":0,"title":"North Turnpike, Meadow Trail","descriptions":["The soft babbling sounds of a nearby brook mingle with the occasional scuffling of small creatures and the ever present chirrups of local birds.  A pair of benches line the cobbled brick pathway that encircles a massive pagoda tree surrounded by tall grasses bent to either side from the traffic of local residents."],"exits":[{"to":254,"exit":"southwest","move":"southwest"},{"to":256,"exit":"northwest","move":"northwest"}],"color":"#00FFFF"},
  {"id":258,"x":540,"y":-320,"z":1,"title":"Monastery, Marble Hallway","descriptions":["The long stretch of corridor bears windows on the right side and a set of doors on the left, and is sparkling clean as if washed and dusted very recently.  Sloping stone ceilings arch upward, supported by marble pillars that stand at even intervals.  The dark marble floor is covered with a rich mahogany carpet that runs the center of the room where the most traffic tends to tread."],"exits":[{"to":259,"exit":"west","move":"west"},{"to":191,"exit":"go","move":"go narrow archway"}]},
  {"id":259,"x":520,"y":-320,"z":1,"title":"Monastery, Marble Hallway","descriptions":["The long stretch of corridor bears windows on the right side and a set of doors on the left, and is sparkling clean as if washed and dusted very recently.  Sloping stone ceilings arch upward, supported by marble pillars that stand at even intervals.  The dark marble floor is covered with a rich mahogany carpet that runs the center of the room where the most traffic tends to tread."],"exits":[{"to":258,"exit":"east","move":"east"},{"to":260,"exit":"west","move":"west"},{"to":261,"exit":"go","move":"go classroom door"},{"to":262,"exit":"go","move":"go elaborate archway"}]},
  {"id":260,"x":500,"y":-320,"z":1,"title":"Monastery, Marble Hallway","descriptions":["The long stretch of corridor bears windows on the right side and a set of doors on the left, and is sparkling clean as if washed and dusted very recently.  Sloping stone ceilings arch upward, supported by marble pillars that stand at even intervals.  The dark marble floor is covered with a rich mahogany carpet that runs the center of the room where the most traffic tends to tread."],"exits":[{"to":259,"exit":"east","move":"east"},{"to":263,"exit":"go","move":"go cathedral door"}]},
  {"id":261,"x":520,"y":-340,"z":1,"title":"Monastery, Classroom","descriptions":["Numerous small chairs with desks attached to them form neat rows on the hard wood floor, leading up to a teacher's desk at the front of the room.  A massive chalkboard graces the front wall, although it looks too old and cracked to be of much use in teaching now.  Several fresh potted plants stand in the corners of the room, bringing a hint of life to the old classroom."],"exits":[{"to":259,"exit":"go","move":"go classroom door"}],"aliases":["Classroom"]},
  {"id":262,"x":540,"y":-340,"z":1,"title":"Monastery, Small Lounge","descriptions":["With an unusually low ceiling for the monastery, the wide room appears to be a converted wine cellar.  Long couches and tables line the walls of the room, and a few free standing clusters make ideal areas for small meetings.  Numerous silver and red banners drape the walls of the room, covered with abstract patterns that defy a clear meaning."],"exits":[{"to":259,"exit":"go","move":"go elaborate archway"}],"aliases":["Small Lounge","Lounge"]},
  {"id":263,"x":500,"y":-340,"z":1,"title":"Monastery, Dusty Cathedral","descriptions":["The arching ceiling of the cathedral rises high and comes to numerous points, with gothic spires and elaborate decorations carved directly into the marble.  Long pews line the sides of the long and narrow room, and high, narrow windows filled with plain glass cover both sides of the offset building.  Candles burn in the marble pillars that line the walls, filling the chapel with a soft ambiance."],"exits":[{"to":264,"exit":"north","move":"north"},{"to":260,"exit":"go","move":"go cathedral door"}],"aliases":["Cathedral"]},
  {"id":264,"x":500,"y":-360,"z":1,"title":"Monastery, Cathedral Altar","descriptions":["Though it is clear that the area was once used as the cathedral altar, any and all holy icons and symbols are missing.  In their place, a few chairs and a plain table rest on the small dais, and a few small gaethzen lanterns light up the area well.  A fresh coat of off-white paint covers the back wall, expertly covering up yet more religious paraphernalia."],"exits":[{"to":263,"exit":"south","move":"south"},{"to":265,"exit":"go","move":"go side door"}],"aliases":["Altar"]},
  {"id":265,"x":480,"y":-360,"z":1,"title":"Monastery, Stone Wall","descriptions":["Blueberry bushes crowd the sides of the monastery wall, their scraggly appearance contrasting the lush green vines that cover its surface.  Though old and unrepaired, the wall stands high and sturdy, obviously built to last.  Nearly invisible among the bushes is a small side door, which looks rather disused and forgotten among the timeless stones."],"exits":[{"to":264,"exit":"go","move":"go side door"}]},
  {"id":266,"x":280,"y":-80,"z":0,"title":"Birch Copse, Aevren Mod","descriptions":["Towering above the shorter birch, the twisted limbs of the willow tree offer a breathtaking view of the landscape.  The leafless branches clatter and scrape against each other in the wind."],"exits":[{"to":106,"exit":"climb","move":"climb willow tree"}],"aliases":["Birch Copse","Aevren Mod","willow tree"]},
  {"id":268,"x":640,"y":-280,"z":1,"title":"Monastery, Quiet Library","descriptions":["Plain white marble walls surround the rather large room, which is quite clean and free of dust.  Large bookcases stand in neatly spaced rows, while a ring of shelves line the walls, neatly packed with books from top to bottom.  Several wooden benches provide a place to read, and a simple return desk stands at the front of the library."],"exits":[{"to":197,"exit":"go","move":"go marble archway"}],"aliases":["Necromancer Library","Necro Library"]},
  {"id":269,"x":300,"y":-460,"z":0,"title":"Brambles","descriptions":["The bramble bushes aren't quite as dense in this spot, and there are a number of gaps big enough to slide through without doing too much damage to one's person.  This seems to be the intersection of a number of small trails, and judging by how churned and dug up the ground is, it sees a lot of use."],"exits":[{"to":35,"exit":"northeast","move":"northeast"},{"to":270,"exit":"go","move":"go narrow trail"},{"to":0,"exit":"go","move":"go wide gap"}]},
  {"id":270,"x":300,"y":-440,"z":0,"title":"Brambles","descriptions":["A few stray sunbeams shine through the branches of the trees scattered about the thicket, illuminating the grey-green leaves of the brambles, and gleaming on the needle-sharp points of their thorns.  Here and there a clump of tough grass manages to grow around the base of the bushes, but most of the dirt is trampled and dug up, making it impossible for less hardy plants to survive."],"exits":[{"to":40,"exit":"southwest","move":"southwest"},{"to":272,"exit":"west","move":"west"},{"to":269,"exit":"go","move":"go narrow trail"}]},
  {"id":272,"x":240,"y":-440,"z":0,"title":"Brambles","descriptions":["The trail curves through the bramble thicket, past some bushes of a different variety.  Foliage presses close all around, spreading both out and up in the competition for resources.  Birds rustle in the bushes, hunting for berries and small insects.  Something else that sounds much larger than a bird rustles through the brambles somewhere close by."],"exits":[{"to":270,"exit":"east","move":"east"},{"to":38,"exit":"south","move":"south"}]},
  {"id":274,"x":240,"y":-460,"z":0,"title":"Brambles","descriptions":["Something large tore a gap in the brambles to the northwest.  Broken branches and oozing sap define the edges of a hole nearly an armlength across.  Broken and missing thorns testify to the toughness of whatever came crashing through -- the long, sharp spines weren't much of a deterrent."],"exits":[{"to":291,"exit":"east","move":"east"},{"to":275,"exit":"northwest","move":"northwest"}]},
  {"id":275,"x":220,"y":-480,"z":0,"title":"Brambles","descriptions":["Signs of a scuffle are everywhere.  The dirt underfoot is streaked and spotted with dried blood.  Patches of hide and broken spines lie scattered about, and there's a huge hole in the brambles to the southeast where something large went crashing through in a hurry.  The bark of a large tree is scarred by deep grooves the width of a finger or better, and drying sap streaks the wood in long, viscous dribbles."],"exits":[{"to":44,"exit":"north","move":"north"},{"to":274,"exit":"southeast","move":"southeast"},{"to":279,"exit":"west","move":"west"},{"to":290,"exit":"northwest","move":"northwest"}]},
  {"id":276,"x":240,"y":-480,"z":0,"title":"Brambles","descriptions":["Thick leaf litter covers the ground, making it both spongy and crunchy.  Shriveled berries and little round leaves from the brambles combine with long pointed leaves from the trees to form a dense insulating mulch.  Here and there in the mulch a few mushrooms show their pale heads, thriving in the moist decay."],"exits":[{"to":277,"exit":"east","move":"east"},{"to":44,"exit":"northwest","move":"northwest"}]},
  {"id":277,"x":260,"y":-480,"z":0,"title":"Brambles","descriptions":["Dense bushes grow in irregular mounds, throwing grotesque shapes across what little bare ground there is.  Bright orange berries nestle in the shadows among thorns as long as a finger.  Picking them would probably be painful, and would likely result in a certain amount of bloodletting, but they're not edible anyway, so it doesn't really matter."],"exits":[{"to":276,"exit":"west","move":"west"},{"to":278,"exit":"go","move":"go tall trees"}]},
  {"id":278,"x":280,"y":-500,"z":0,"title":"Brambles","descriptions":["A few tall trees grow in the midst of the thorny brambles, rising high above the bushes.  Long, pointed leaves filter out much of the sun, but the tough thorn bushes do fine all the same.  The soil is rich and loamy, and there's plenty of water, so the bushes and the trees manage to coexist quite well."],"exits":[{"to":48,"exit":"north","move":"north"},{"to":277,"exit":"go","move":"go thorny bushes"}]},
  {"id":279,"x":200,"y":-480,"z":0,"title":"Brambles","descriptions":["Palm-sized tracks pressed deeply into the ground stand out against the lighter colored leaf litter.  Broken branches and bruised foliage up to the height of a large Human's shoulder tell a tale of violence, as do the darkened spots and streaks of blood spattered about."],"exits":[{"to":275,"exit":"east","move":"east"},{"to":280,"exit":"go","move":"go web-choked trees"}]},
  {"id":280,"x":140,"y":-520,"z":0,"title":"Brambles","descriptions":["Spiderwebs festoon the branches of the trees up overhead, draped and swagged like festival bunting.  The brambles below the trees are bare of webbing, although well-trimmed with long, sharp thorns.  Grey-green leaves spiral up the branches, large and round closer to the roots, small and oval at the tips."],"exits":[{"to":286,"exit":"south","move":"south"},{"to":279,"exit":"go","move":"go broken branches"},{"to":281,"exit":"go","move":"go rising slope"}]},
  {"id":281,"x":120,"y":-500,"z":0,"title":"Brambles","descriptions":["There must be something good in the soil of the low rise to the northwest, because the brambles and other plants growing up there are lush and thick, forming an impenetrable barrier.  The thorn bushes spread across the slope in grey-green mounds, having penetrated into every available span of ground until they stand silhouetted against the sky at the top of the rise."],"exits":[{"to":282,"exit":"southwest","move":"southwest"},{"to":280,"exit":"go","move":"go downard slope"}]},
  {"id":282,"x":100,"y":-480,"z":0,"title":"Brambles","descriptions":["Signs of a mighty conflagration are everywhere.  Scarred furrows in the ground make footing uncertain.  Blackened thorn branches wave like spiny skeletons, stripped of leaves and hardened by fire.  Heat-fused lumps of something unidentifiable lie scattered about -- driven into the ground, entangled in the brambles, flattened across the backs of raw wounds in the bark of trees.  Something unimaginably hot has burned a huge gap in the undergrowth to the south, like a white-hot poker sizzling through flesh."],"exits":[{"to":281,"exit":"northeast","move":"northeast"},{"to":284,"exit":"south","move":"south"},{"to":283,"exit":"southwest","move":"southwest"}]},
  {"id":283,"x":80,"y":-460,"z":0,"title":"Brambles","descriptions":["Dense brambles grow on the slope to the northwest, protecting the low rise with a wall of finger-length thorns.  The track underfoot has been churned up by passing feet, the leaf litter thrown about to reveal the rich dirt beneath."],"exits":[{"to":282,"exit":"northeast","move":"northeast"},{"to":285,"exit":"go","move":"go downard slope"}]},
  {"id":284,"x":100,"y":-460,"z":0,"title":"Brambles","descriptions":["A huge burned clearing, half a dozen long strides across, lies bare and blackened.  Even the tough brambles gave way before the heat of whatever came into this place, incinerated by the fire and now doubtless lying unidentifiable among the charred rubble and blackened dust crunching underfoot.  In the center of the consumed circle is a pit, a dark hole burrowed deep into the ground at a steep angle.  An acrid smell fills the air, sharp and sour, penetrating everything."],"exits":[{"to":282,"exit":"north","move":"north"}]},
  {"id":285,"x":80,"y":-400,"z":0,"title":"Brambles","descriptions":["The sound of calling birds blends with the rustles and crackles coming from all around the bramble thicket.  Thorny branches tremble in the breeze, dense living walls forming painful barriers in all but a very few directions.  Some scuffled tracks in the moist ground lead away to the north."],"exits":[{"to":58,"exit":"east","move":"east"},{"to":283,"exit":"go","move":"go rising slope"}]},
  {"id":286,"x":140,"y":-440,"z":0,"title":"Brambles, Clearing","descriptions":["Dense, thorny bushes press in from all sides, grabbing at hair and clothing and dangling straps.  A single tree spreads its branches overhead, filtering out the sunlight and casting dancing shadows on the foliage below."],"exits":[{"to":280,"exit":"north","move":"north"},{"to":287,"exit":"northeast","move":"northeast"},{"to":59,"exit":"south","move":"south"}]},
  {"id":287,"x":160,"y":-460,"z":0,"title":"Brambles, Clearing","descriptions":["A huge oak tree stands sentinel in the center of a large clearing.  The bramble bushes stop suddenly around the edges, as though someone had drawn a wavering line across which they're forbidden to pass.  Short green grass grows here, although it's torn up in places, and a few flowers manage to bloom in spots and crannies."],"exits":[{"to":288,"exit":"east","move":"east"},{"to":286,"exit":"southwest","move":"southwest"}]},
  {"id":288,"x":180,"y":-460,"z":0,"title":"Brambles, Clearing","descriptions":["The oak tree in the center of the clearing casts a large patch of shade here on its north side.  A few ferns grow at the base of the trunk, providing a feathery border to the expanse of green grass that covers the ground between the tree and the brambles.  Off on the eastern side of the clearing the brambles give way to dense, mounding berry bushes."],"exits":[{"to":289,"exit":"south","move":"south"},{"to":287,"exit":"west","move":"west"}]},
  {"id":289,"x":180,"y":-440,"z":0,"title":"Brambles, Clearing","descriptions":["Bright green berry bushes grow in rounded piles to the east of the oak tree, only gradually giving way to the brambles on the southern curve of the clearing.  Patches of bare dirt show dark against the lighter green of the grass, places where the ground has been torn up and smoothed over.  A few grey-green sprouts grow here and there in the grass, but none more than a couple of inches tall."],"exits":[{"to":288,"exit":"north","move":"north"},{"to":64,"exit":"southwest","move":"southwest"}]},
  {"id":290,"x":200,"y":-500,"z":0,"title":"Brambles","descriptions":["Crackles and rustles betray the presence of... something... moving in the brambles up the slope to the northwest.  The thorny bushes are so dense in that direction, however, that not even a Halfling child could manage to penetrate them.  Interspersed among the brambles are a few trees, spotted here and there, spreading their green canopies over the harsher undergrowth."],"exits":[{"to":275,"exit":"southeast","move":"southeast"}]},
  {"id":291,"x":280,"y":-460,"z":0,"title":"Brambles","descriptions":["Tracks about the size of a large palm show clearly in the firmly packed dirt.  Grey-green leaves, liberally spiked with long, sharp thorns, spread out from either side.  The foliage casts deep shadows across the tracks, emphasizing their size and depth."],"exits":[{"to":274,"exit":"west","move":"west"},{"to":269,"exit":"go","move":"go wide gap"}]},
  {"id":292,"x":140,"y":-280,"z":0,"title":"Brambles","descriptions":["The narrow game trail runs from the northwest to the southeast, winding round and about the bramble bushes.  A smaller track pushes into the undergrowth to the northeast.  Cracked and splintered branches and scarred ground make it look like the northeastern track is of recent creation.  Broken thorns suggest that whatever made the new trail probably didn't have a good time doing it."],"exits":[{"to":79,"exit":"northwest","move":"northwest"},{"to":299,"exit":"go","move":"go winding track"},{"to":294,"exit":"go","move":"go brambles"}]},
  {"id":294,"x":180,"y":-280,"z":0,"title":"Brambles","descriptions":["A flowering vine twines through the tangle of brambles, winding its tendrils around the woody branches, uncaring of their sharp thorns.  Large green leaves shaped like arrowheads decorate the vines, swaying in the breeze.  Here and there a flower lifts its head, trumpet shaped, striped in pink and white.  The blossoms show a delicate contrast to the tough bramble bushes with their small leathery leaves."],"exits":[{"to":85,"exit":"east","move":"east"},{"to":87,"exit":"southwest","move":"southwest"},{"to":292,"exit":"go","move":"go game trail"}]},
  {"id":296,"x":320,"y":-420,"z":0,"title":"Brambles","descriptions":["Small round leaves, grey-green with a white streak down the middle, cover the branches of the brambles which form this thicket.  Although the leaves grow in dense masses, they're unable to hide the sharp thorns which protect the bushes.  A pleasant, spicy scent emanates from the leaves, and when the breeze dies down and the air is still, the smell is sharp enough to sting one's sinuses."],"exits":[{"to":26,"exit":"north","move":"north"},{"to":297,"exit":"southwest","move":"southwest"}]},
  {"id":297,"x":260,"y":-360,"z":0,"title":"Brambles","descriptions":["Dense brambles press in on all sides, giving this place a claustrophobic feel.  The few narrow gaps in the bushes are barely navigable, and from each branch and twig long, sharp spines threaten scratches and punctures."],"exits":[{"to":296,"exit":"northeast","move":"northeast"},{"to":17,"exit":"go","move":"go wooden bridge"},{"to":298,"exit":"go","move":"go narrow gap"}]},
  {"id":298,"x":220,"y":-400,"z":0,"title":"Brambles","descriptions":["Tiny grey-green leaves grow in dense spirals around the branches of the brambles which surround the trail.  In actuality it's hardly a trail -- more a gap in the foliage, beyond which is another gap, and perhaps another.  The gaps are narrow, and look like they were made by animals rather than people.  This place belongs to its four-footed inhabitants, and the clinging, snagging thorns are a warning to all others who come here."],"exits":[{"to":65,"exit":"west","move":"west"},{"to":297,"exit":"go","move":"go narrow gap"}]},
  {"id":299,"x":160,"y":-300,"z":0,"title":"Brambles","descriptions":["Something made its hurried way along this winding track, traveling northward as though driven by anger or fear.  The track has been forced through the brambles, and is none too wide.  Damaged bushes and blobs of hardened sap mark the passage of whatever did this."],"exits":[{"to":300,"exit":"north","move":"north"},{"to":292,"exit":"go","move":"go winding track"}]},
  {"id":300,"x":160,"y":-320,"z":0,"title":"Brambles","descriptions":["A deep gouge in the tough bark of a tree, about four feet above the ground, marks the place where the track makes an abrupt change in direction.  The gouge, a furrow the length of a Human's hand marked with a deep hole the length and width of a finger, is on the south side of the tree, indicating that whatever hit it was traveling north at some speed when it hit.  It seems to have wrenched itself free and then thundered on to the northeast."],"exits":[{"to":301,"exit":"northeast","move":"northeast"},{"to":299,"exit":"south","move":"south"}]},
  {"id":301,"x":180,"y":-340,"z":0,"title":"Brambles","descriptions":["The trail, already narrow, comes to a stop here.  The bramble bushes grow more densely to the north, and although they show signs of splintering in places, they stand stout and firm.  There is little else here but a few bones, large enough to have survived the ministrations of temperature and weather and ants.  The ground has been churned up recently, so much so that no tracks are evident."],"exits":[{"to":300,"exit":"southwest","move":"southwest"}]},
  {"id":302,"x":320,"y":-180,"z":1,"title":"Cold Laboratory, Hallway","descriptions":["Built into a former clock tower, the monastery's laboratories are set at regular intervals in a perpetual stairway that winds upward in a clockwise direction.  Freezing cold air wafts through the hallways, and bits of frost collect at the edges and corners of the walls and floor.  Very faint chanting and murmuring sounds drift upwards from the tower's basement, though the area is quite silent otherwise."],"exits":[{"to":182,"exit":"out","move":"out"},{"to":303,"exit":"northeast","move":"northeast"},{"to":307,"exit":"go","move":"open steel door"},{"to":308,"exit":"go","move":"open iron door"}],"color":"#FF0000","aliases":["Daragrym","Risen Supplies"]},
  {"id":303,"x":340,"y":-220,"z":1,"title":"Cold Laboratory, Hallway","descriptions":["Built into a former clock tower, the monastery's laboratories are set at regular intervals in a perpetual stairway that winds upward in a clockwise direction.  Freezing cold air wafts through the hallways, and bits of frost collect at the edges and corners of the walls and floor.  A steady 'drip, drip, drip' noise comes from one wall, as tiny runnels of a pale reddish substance trickle down it."],"exits":[{"to":302,"exit":"southwest","move":"southwest"},{"to":304,"exit":"northwest","move":"northwest"},{"to":309,"exit":"go","move":"open steel door"},{"to":310,"exit":"go","move":"open iron door"}],"color":"#00FF00","aliases":["Kelasune"]},
  {"id":304,"x":320,"y":-240,"z":1,"title":"Cold Laboratory, Hallway","descriptions":["Built into a former clock tower, the monastery's laboratories are set at regular intervals in a perpetual stairway that winds upward in a clockwise direction.  Freezing cold air wafts through the hallways, and bits of frost collect at the edges and corners of the walls and floor.  A small, frosty window looks out onto the monastery's northern courtyard, though sealed off with iron bars."],"exits":[{"to":303,"exit":"southeast","move":"southeast"},{"to":305,"exit":"southwest","move":"southwest"},{"to":311,"exit":"go","move":"open steel door"},{"to":312,"exit":"go","move":"open iron door"}]},
  {"id":305,"x":300,"y":-220,"z":1,"title":"Cold Laboratory, Hallway","descriptions":["Built into a former clock tower, the monastery's laboratories are set at regular intervals in a perpetual stairway that winds upward in a clockwise direction.  Freezing cold air wafts through the hallways, and bits of frost collect at the edges and corners of the walls and floor.  The steps narrow a bit, following the corners of the square-shaped tower."],"exits":[{"to":304,"exit":"northeast","move":"northeast"},{"to":306,"exit":"southeast","move":"southeast"},{"to":313,"exit":"go","move":"open steel door"},{"to":314,"exit":"go","move":"open iron door"}]},
  {"id":306,"x":320,"y":-200,"z":1,"title":"Cold Laboratory, Hallway","descriptions":["The top floor of the tower is colder than the rest, and a large device at the top of the stairs blocks off access to the top of the former clock tower.  Freezing cold air drifts downward from the device in even waves, spilling frost onto the carpeted stairs and down the hallway.  The area is very quiet, the only noise coming from the soft whirring of the strange magical device that seems to be generating the cold."],"exits":[{"to":305,"exit":"northwest","move":"northwest"},{"to":315,"exit":"go","move":"open steel door"},{"to":316,"exit":"go","move":"open iron door"}]},
  {"id":307,"x":310,"y":-170,"z":1,"title":"Cold Laboratory, Work Station","descriptions":["The air is quite chilly, cold enough to leave ice crystals with every breath.  A medium-sized and rather functional laboratory is set up, with a central marble table as the main feature.  Nearby, a row of cold lockers is designed to store specimens for later use, and a tray of very clean tools is set up near the table."],"exits":[{"to":302,"exit":"go","move":"open door"}]},
  {"id":308,"x":310,"y":-190,"z":1,"title":"Cold Laboratory, Work Station","descriptions":["The air is quite chilly, cold enough to leave ice crystals with every breath.  A medium-sized and rather functional laboratory is set up, with a central marble table as the main feature.  Nearby, a row of cold lockers is designed to store specimens for later use, and a tray of very clean tools is set up near the table."],"exits":[{"to":302,"exit":"go","move":"open door"}]},
  {"id":309,"x":350,"y":-210,"z":1,"title":"Cold Laboratory, Work Station","descriptions":["The air is quite chilly, cold enough to leave ice crystals with every breath.  A medium-sized and rather functional laboratory is set up, with a central marble table as the main feature.  Nearby, a row of cold lockers is designed to store specimens for later use, and a tray of very clean tools is set up near the table."],"exits":[{"to":303,"exit":"go","move":"open door"}]},
  {"id":310,"x":350,"y":-230,"z":1,"title":"Cold Laboratory, Work Station","descriptions":["The air is quite chilly, cold enough to leave ice crystals with every breath.  A medium-sized and rather functional laboratory is set up, with a central marble table as the main feature.  Nearby, a row of cold lockers is designed to store specimens for later use, and a tray of very clean tools is set up near the table."],"exits":[{"to":303,"exit":"go","move":"open door"}]},
  {"id":311,"x":330,"y":-250,"z":1,"title":"Cold Laboratory, Work Station","descriptions":["The air is quite chilly, cold enough to leave ice crystals with every breath.  A medium-sized and rather functional laboratory is set up, with a central marble table as the main feature.  Nearby, a row of cold lockers is designed to store specimens for later use, and a tray of very clean tools is set up near the table."],"exits":[{"to":304,"exit":"go","move":"open door"}]},
  {"id":312,"x":310,"y":-250,"z":1,"title":"Cold Laboratory, Work Station","descriptions":["The air is quite chilly, cold enough to leave ice crystals with every breath.  A medium-sized and rather functional laboratory is set up, with a central marble table as the main feature.  Nearby, a row of cold lockers is designed to store specimens for later use, and a tray of very clean tools is set up near the table."],"exits":[{"to":304,"exit":"go","move":"open door"}]},
  {"id":313,"x":290,"y":-230,"z":1,"title":"Cold Laboratory, Work Station","descriptions":["The air is quite chilly, cold enough to leave ice crystals with every breath.  A medium-sized and rather functional laboratory is set up, with a central marble table as the main feature.  Nearby, a row of cold lockers is designed to store specimens for later use, and a tray of very clean tools is set up near the table."],"exits":[{"to":305,"exit":"go","move":"open door"}]},
  {"id":314,"x":290,"y":-210,"z":1,"title":"Cold Laboratory, Work Station","descriptions":["The air is quite chilly, cold enough to leave ice crystals with every breath.  A medium-sized and rather functional laboratory is set up, with a central marble table as the main feature.  Nearby, a row of cold lockers is designed to store specimens for later use, and a tray of very clean tools is set up near the table."],"exits":[{"to":305,"exit":"go","move":"open door"}]},
  {"id":315,"x":315,"y":-220,"z":1,"title":"Cold Laboratory, Work Station","descriptions":["The air is quite chilly, cold enough to leave ice crystals with every breath.  A medium-sized and rather functional laboratory is set up, with a central marble table as the main feature.  Nearby, a row of cold lockers is designed to store specimens for later use, and a tray of very clean tools is set up near the table."],"exits":[{"to":306,"exit":"go","move":"open door"}]},
  {"id":316,"x":325,"y":-220,"z":1,"title":"Cold Laboratory, Work Station","descriptions":["The air is quite chilly, cold enough to leave ice crystals with every breath.  A medium-sized and rather functional laboratory is set up, with a central marble table as the main feature.  Nearby, a row of cold lockers is designed to store specimens for later use, and a tray of very clean tools is set up near the table."],"exits":[{"to":306,"exit":"go","move":"open door"}]},
  {"id":317,"x":460,"y":-40,"z":0,"title":"Zoluren Royal Mews, Brokerage Offices","descriptions":["Heavy mahogany panels encase the walls of this small room.  The fireplace's curved brick opening reflects the arc of the arched brick entry directly opposite.  A rose velvet settee draped with a delicate white shawl sits below the front window.  Several tall-backed chairs are positioned near the settee, and a narrow refreshment table rests against one wall."],"exits":[{"to":209,"exit":"go","move":"go entry"}]},
  {"id":318,"x":480,"y":-60,"z":0,"title":"Zoluren Royal Mews, Brokerage Offices","descriptions":["This quiet, sparse office holds a simple desk and a couple of cushioned chairs.  Book-lined shelves cover one wall completely, with titles ranging from horse care to adventure stories relating to them.  A single window is covered by long emerald drapes embroidered with brown thread."],"exits":[{"to":209,"exit":"go","move":"go mahogany door"}]}
 ],
