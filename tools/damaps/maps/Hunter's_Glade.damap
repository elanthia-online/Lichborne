{
 "format": "damap",
 "version": 1,
 "id": "128",
 "name": "Hunter's Glade",
 "file": "Map128_Hunters_Glade.xml",
 "rooms": [
  {"id":2,"x":140,"y":220,"z":0,"title":"Hawstkaal Road, Terminus","descriptions":["A sense of quiet and peace dominates the area, though birdsongs filter in from all directions.  The narrow dirt road that began as a thriving thoroughfare far to the south meets a wall of foliage and dwindles off further into the woods as a faint trail."],"exits":[{"to":0,"exit":"go","move":""},{"to":0,"exit":"go","move":""}],"color":"#FFFFFF","linksTo":"Map127_Boar_Clan.xml"},
  {"id":92,"x":140,"y":200,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["The trees of the forest grow tall and thin with branches that begin several stories overhead.  Most trees have had their bark rubbed and gouged off about a Dwarf's height from the ground.  Stuck into a thick thorn-covered fir is a long yellowed splinter of boar tusk."],"exits":[{"to":127,"exit":"go","move":""},{"to":123,"exit":"go","move":""},{"to":2,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":93,"x":0,"y":400,"z":1,"title":"Ranger Guild, Canteen","descriptions":["Brass hooks, small shelves, and niches filled with merchandise honeycomb the curved stone wall of the alcove.  In the center, neatly stacked crates and baskets surround a tall stool surmounted by an elderly Dwarf, who conducts transactions with a kind, gravelly voice."],"exits":[{"to":0,"exit":"go","move":""}],"color":"#FF0000"},
  {"id":94,"x":40,"y":420,"z":1,"title":"Ranger Guild, Book Nook","descriptions":["A stone ledge encircling the small cavern holds colorful leather-bound volumes with gilded titles that glint in the lamplight.  Thick piles of pelts and high-backed wooden chairs carved with scenes of the hunt offer comfortable seating for readers.  A stoneware boar crouches in the center of the room, with curls of pleasantly musky incense smoke curling from its wide grin."],"exits":[{"to":0,"exit":"go","move":""}],"color":"#00FF00","aliases":["Library"]},
  {"id":95,"x":80,"y":400,"z":1,"title":"Ranger Guild, Carousel","descriptions":["The rumblings of carousel machinery hidden behind the stone walls echo through the cavern and calls a beast growling from deep within the earth.  The vibrations shake a large oil lamp that hangs from the center of the vaulted ceiling, causing the light to flitter erratically around the room."],"exits":[{"to":0,"exit":"go","move":""}],"color":"#00FF00","aliases":["Alcove"]},
  {"id":96,"x":80,"y":420,"z":1,"title":"Ranger Guild, Bank","descriptions":["A one-legged Gor'Tog bank clerk attends to the needs of patrons at a wooden counter from behind thin steel bars that terminate at the ceiling.  Along the counter sit various scales and ledgers and other implements of finance."],"exits":[{"to":97,"exit":"go","move":""},{"to":0,"exit":"go","move":""}],"color":"#00FF00","aliases":["Teller","Bank"]},
  {"id":97,"x":60,"y":420,"z":1,"title":"Ranger Guild, Coin Exchange","descriptions":["Separating the coin exchange from the bank counter is a heavy leather curtain that muffles the sound of transactions that would otherwise echo in the stone chamber.  The unmistakable glints of copper, bronze, gold, silver and platinum flash in the dim light."],"exits":[{"to":96,"exit":"go","move":""}],"color":"#00FF00","aliases":["Exchanger"]},
  {"id":98,"x":40,"y":340,"z":1,"title":"Ranger Guild, Small Cavern","descriptions":["A bathing pool glistens like liquid gold in the light of many lanterns suspended from the ceiling.  The soothing sound of water steadily running down the rock face echoes gently, punctuated by the occasional *plop!* in varied, musical tones.  Amid blankets and pelts on the floor sits a small table."],"exits":[{"to":0,"exit":"go","move":""},{"to":99,"exit":"go","move":""},{"to":100,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":99,"x":40,"y":320,"z":1,"title":"Ranger Guild, A Stony Ledge","descriptions":["Amid the lanterns hung high above a glistening bathing pool, the stony ledge offers a panoramic view of the cavern hollowed from the earth by the spring water dissolving minerals.  Arches, stalagmites and stalactites contribute to an oblique landscape with dramatic curves and folds of stone.  A natural rock slide funnels down to the pool below."],"exits":[{"to":98,"exit":"go","move":""},{"to":100,"exit":"go","move":""},{"to":100,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":100,"x":60,"y":320,"z":1,"title":"Ranger Guild, Bathing Pool","descriptions":["Golden shimmers of lamplight ripple across the surface of the pool.  Fed from a source below, the warm water swirls softly against the bank of the stony basin with a gentle shushing sound."],"exits":[{"to":101,"exit":"go","move":""},{"to":98,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":101,"x":60,"y":300,"z":1,"title":"Ranger Guild, Underground Spring","descriptions":["The turbulent current churns rhythmically with pockets of warmer water constantly bubbling to the surface.  Small pebbles whirled with the force of the river become dangerous projectiles, capable of scarring the smooth stone walls as well as soft flesh."],"exits":[{"to":102,"exit":"go","move":""},{"to":100,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":102,"x":40,"y":280,"z":1,"title":"Ranger Guild, Underground Spring","descriptions":["Hot spring water bubbles up from cracks in the stone and mingles with the chilly currents of the Liirewsag River flowing in through a narrow crevice.  The turbulent water roils and whirls steadily against the smooth rock walls."],"exits":[{"to":101,"exit":"go","move":""},{"to":103,"exit":"go","move":""},{"to":0,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":103,"x":40,"y":260,"z":1,"title":"Ranger Guild, Underground Spring","descriptions":["The water churns rhythmically with pockets of warmer water constantly bubbling to the surface.  Flecks of mica in the stone walls glimmer in the lamplight that easily penetrates the crystal clear water."],"exits":[{"to":104,"exit":"go","move":""},{"to":102,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":104,"x":40,"y":240,"z":1,"title":"Ranger Guild, Hot Spring","descriptions":["A pale veil of mist hangs at the surface of the bubbling hot spring, washing everything in dreamlike clouds that drift slowly away.  On the bank of the pool cling thick pillows of moss, providing a soft cushion against the stone.  The sweet smell of jasmine scents the air."],"exits":[{"to":103,"exit":"go","move":""},{"to":105,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":105,"x":40,"y":220,"z":1,"title":"Ranger Guild, Greenhouse","descriptions":["A steamy, bubbling pool sits in the center of the glass greenhouse surrounded by feathery ferns.  The warm, humid air rises and condenses on everything, fogging the panes of glass and making the leaves of the tropical plants glisten with moisture in the diffused daylight.  Thin tendrils of smoky green maiden's tress moss hang from beams and host plants."],"exits":[{"to":107,"exit":"go","move":""},{"to":106,"exit":"go","move":""},{"to":104,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":106,"x":20,"y":220,"z":1,"title":"Ranger Guild, Greenhouse","descriptions":["A bench swing nestles in a lush green corner filled with temperate plants, including a variety of ivy and roses in a wide array of colors, scents and sizes, from giant golden sun roses and delicate pink Hodierna's blush roses to petite DiSilveron black rosettes.  Rare watermist roses surround a small pool into which splashes a waterfall built from piles of riverstone.  The rich smells of damp earth underscore the heady, sweet aroma of the flowers."],"exits":[{"to":105,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":107,"x":60,"y":220,"z":1,"title":"Ranger Guild, Greenhouse","descriptions":["The long glass greenhouse is home to most of the realms' many varieties of plants and flowering shrubs.  Nearest the door, open vents keep the environment cooler and drier than further in, where more exotic plant collections are housed.  Native flora thrives year-round here and provides valuable specimens for study."],"exits":[{"to":105,"exit":"go","move":""},{"to":108,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":108,"x":80,"y":220,"z":1,"title":"Ranger Guild, Garden","descriptions":["A long glass greenhouse sits in the center of a manicured lawn dotted with seasonal flowerbeds and a wide variety of small gardens.  Woody shrubs surrounding the clearing create a gentle transition into the tall trees of the forest.  Centered in a grassy circle in front of the greenhouse door is a granite sundial with a vine-carved border and a bronze plaque."],"exits":[{"to":109,"exit":"go","move":""},{"to":107,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":109,"x":80,"y":200,"z":1,"title":"Ranger Guild, Garden","descriptions":["A sun-dappled lawn patched with clover and wood anemones spreads beneath fine native specimen trees.  Lofty hardwoods surround a soaring peregan tree whose branches shelter an ivy-clad garden shed with a rough plank door."],"exits":[{"to":108,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":123,"x":120,"y":220,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["The glade is a young and open pine forest brightened with sunlight and the sound of the river.  Birds call from their perches and occasionally swoop down from the boughs, either seeking a meal or in a game of chase with one another.  The crisp, clean scent of fir and spruce sharpens the cool air.","The glade is a young, open pine forest.  A crisp, clean scent fills the cool air and the river's burbling is soothing, like a lullaby."],"exits":[{"to":92,"exit":"go","move":""},{"to":124,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":124,"x":100,"y":200,"z":0,"title":"Hunter's Glade, Cragside","descriptions":["Stone outcroppings lining the steep descent into the river to the west echo the sound of the water playing merrily below.  The crags here are too unstable to climb and too wide to dive over, but father north, the forest edges closer to the river."],"exits":[{"to":125,"exit":"go","move":""},{"to":123,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":125,"x":100,"y":180,"z":0,"title":"Hunter's Glade, Cragside","descriptions":["Saplings grow from slivers of earth caught in the crevices of the stony crags.  They cling tenaciously to the steep wall of shattered stone and arc gently over the water.  Their roots never grow very deep, and evidence of a hard rain's power to dislodge them lies cracked and broken on the rocks below."],"exits":[{"to":126,"exit":"go","move":""},{"to":124,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":126,"x":120,"y":160,"z":0,"title":"Hunter's Glade, Cragside","descriptions":["Thick clusters of blueberry bushes amble along the edge of the crags and quiver with the movements of birds perched within.  At dawn and twilight, when the sun's light is thinnest, small grey conies hop out from the shrubs in search of grasses and roots to augment their diet of berries.  The river is barely visible as it wends through the banks far beyond the bushes and the stony descent."],"exits":[{"to":130,"exit":"go","move":""},{"to":127,"exit":"go","move":""},{"to":125,"exit":"go","move":""},{"to":131,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":127,"x":140,"y":180,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["The thick, scaly bark of a nearby sikka tree secretes golden sap that wells in the cracks and crevices.  Unlucky insects become entombed in the gooey traps."],"exits":[{"to":128,"exit":"go","move":""},{"to":92,"exit":"go","move":""},{"to":126,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":128,"x":160,"y":160,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["A weeping hemlock droops over a weathered lunat log to shelter a patch of spindly puffball mushrooms that grow tall and top-heavy so that they bend over slightly beneath the weight of their pale caps.  From somewhere close comes the sound of grunting and something trundling through the underbrush."],"exits":[{"to":129,"exit":"go","move":""},{"to":127,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":129,"x":160,"y":140,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["A stand of pale slender-trunked paper birches grows along a ridge to the northeast.  Their bark is thin, white and smooth, separating into diaphanous strips that curl back from the trunk.  Skinny saplings growing amid the taller elders are reddish-brown but share the same delicate pointed-oval leaves that turn golden in autumn."],"exits":[{"to":171,"exit":"go","move":""},{"to":128,"exit":"go","move":""},{"to":130,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":130,"x":140,"y":140,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["The needle-strewn forest floor spreads out beneath a sky framed by spruce and pine boughs.  Seasonal flowers sprawl in sunlit clearings while juniper and laurel shrubs enjoy the shade where patches of snow linger throughout the year.","The needle-strewn forest floor spreads out beneath a dark night sky framed by spruce and pine boughs.  Juniper and laurel shrubs huddle around the trees, while seasonal flowers and bright-berried hollies sprawl in clearings between.  Patches of snow that linger throughout the year in the cool shade of the forest glisten beneath the pale celestial light."],"exits":[{"to":165,"exit":"go","move":""},{"to":129,"exit":"go","move":""},{"to":126,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":131,"x":100,"y":140,"z":0,"title":"Hunter's Glade, Cragside","descriptions":["The land drops off to the west alongside the burbling Liirewsag.  The plunk of pinecones falling into the river from overhanging boughs punctuates the water's steady song.  Cones and splintered branches that fell short of the water lie strewn across the treacherous crags below.  Bloated and half-eaten by scavenger birds, the carcass of an unfortunate boar also lies broken across the rocks."],"exits":[{"to":132,"exit":"go","move":""},{"to":163,"exit":"go","move":""},{"to":126,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":132,"x":100,"y":120,"z":0,"title":"Hunter's Glade, Cragside","descriptions":["Piles of stone and heavy boulders cap the craggy shore, blocking access to the river.  From between the stones grow woody plants that produce hardy orange blooms in late autumn.  Rather than wilt, they become straw-like and preserved into the winter months until blown away by a storm.  To the northwest, the earth slips down to the water's level."],"exits":[{"to":164,"exit":"go","move":""},{"to":163,"exit":"go","move":""},{"to":131,"exit":"go","move":""},{"to":133,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":133,"x":80,"y":100,"z":0,"title":"Hunter's Glade, Riverside","descriptions":["The earth falls sharply downward from this perfect diving spot to dip its peaty edge in the river.  The bank leading to the river below is moist and fertile, making it an ideal home to a wide variety of hostas.  Most have variegated leaves of green streaked with yellow or gold, while others are nearly blue with blotchy patterns of white.  In spring, the leafy, low-growing plants send up tall spindly stalks that bloom in purple, white and orange."],"exits":[{"to":134,"exit":"go","move":""},{"to":132,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":134,"x":100,"y":80,"z":0,"title":"Hunter's Glade, Riverside","descriptions":["Here, the land is level with the water.  A permanent-looking puddle drenches the soil around the base of some tall cedar trees that cluster in a small depression.  Rain and snow feed the river that swells and ebbs with the seasons, changing the landscape and renewing the bank's fertile richness.  To the north and east, the earth rises again, pulling away from the sodden bank of the river."],"exits":[{"to":135,"exit":"go","move":""},{"to":164,"exit":"go","move":""},{"to":133,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":135,"x":120,"y":60,"z":0,"title":"Hunter's Glade, Riverside","descriptions":["The long, thick roots of a quaking aspen grow through the loamy soil and dangle down the steep bank to the cold waters of the river below.  The tree's broad, spreading crown sports leaves that are deep shiny green with silver undersides, and shiver in the wind, giving the tree its name.  In autumn, its foliage takes on brilliant hues of red, orange and yellow."],"exits":[{"to":162,"exit":"go","move":""},{"to":167,"exit":"go","move":""},{"to":166,"exit":"go","move":""},{"to":134,"exit":"go","move":""},{"to":136,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":136,"x":100,"y":40,"z":0,"title":"Hunter's Glade, Riverside","descriptions":["The river burbles playfully along the base of the steep and muddy bank, like a shimmering silver ribbon against brunette curls.  Birds perch on overhanging tree limbs to watch for potential meals swimming below and without warning, quickly swoop down to grab a struggling fish in their talons, then fly off with their catch.","The river burbles playfully along the base of the steep, muddy bank with a song that is steady and meditative, like a Cleric's chant.  Bright-winged moths flutter by, shimmering in borrowed light from the heavens."],"exits":[{"to":137,"exit":"go","move":""},{"to":161,"exit":"go","move":""},{"to":162,"exit":"go","move":""},{"to":135,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":137,"x":100,"y":20,"z":0,"title":"Hunter's Glade, Riverside","descriptions":["Ferns grow down the slope beside the river, softening the stony bank with their long, filigree fronds.  The water's swift current gambols along below, swirling around bends in the landscape and skipping over stones or fallen branches with a glad splashing sound."],"exits":[{"to":138,"exit":"go","move":""},{"to":155,"exit":"go","move":""},{"to":161,"exit":"go","move":""},{"to":136,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":138,"x":100,"y":0,"z":0,"title":"Hunter's Glade, Riverside","descriptions":["A viny heap of small leaf ivy cascades down the bank to the river below.  Caught in the tangled tendrils are twigs, dried leaves and slender longleaf pine needles bundled together like tiny whiskbrooms.  Small brown chipmunks occasionally peek out from the ivy's leafy cover to scout the area for predators before venturing out."],"exits":[{"to":139,"exit":"go","move":""},{"to":155,"exit":"go","move":""},{"to":137,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":139,"x":100,"y":-20,"z":0,"title":"Hunter's Glade, Riverside","descriptions":["A ragged trench carved through the thick carpet of pine needles by flowing rainwater and melted snow follows the slope from the northeast down to the river's edge.  The bank is muddy and clotted with clumps of decaying debris, but climbable by an able soul to gain access to the chill river below."],"exits":[{"to":140,"exit":"go","move":""},{"to":155,"exit":"go","move":""},{"to":138,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":140,"x":120,"y":-40,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["The sloped riverbank yields again to steep, stony crags that climb away from the swiftly moving river.  To the southwest, the land dips its peaty fringe in the water, but to the northeast, it sits high on the rocky steppes."],"exits":[{"to":141,"exit":"go","move":""},{"to":154,"exit":"go","move":""},{"to":139,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":141,"x":140,"y":-60,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["The glade's omnivorous boars voraciously root in the pine litter for grubs, nuts, fungi, small animals and carrion, leaving upturned tufts of needles, soil and twigs.  Their furrowing is essential to both their survival and that of the forest, as they mix nutrients in the soil and speed the process of decomposition that is slowed by the cool climate."],"exits":[{"to":142,"exit":"go","move":""},{"to":154,"exit":"go","move":""},{"to":140,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":142,"x":160,"y":-60,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["Squat bristlecone pines scatter along the steep rocky outcrops to the northeast.  Each pine, from young seedling to ancient relic, has an individual character.  Young trees are densely clad with glistening needle-covered branches that sway like foxtails in the wind.  Their bristled cones drip pine-scented resin and exude all the freshness of youth.  As centuries pass and the elements batter the trees, they become sculpted into astonishingly beautiful shapes."],"exits":[{"to":143,"exit":"go","move":""},{"to":151,"exit":"go","move":""},{"to":154,"exit":"go","move":""},{"to":141,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":143,"x":180,"y":-80,"z":0,"title":"Hunter's Glade, Dark Trees Path","descriptions":["Patches of grass and moss cling to craggy outcrops that crowd stands of spruce and modwir.  Ivy and large shrubs tangle around the trees, further constricting the pathway leading upslope."],"exits":[{"to":144,"exit":"go","move":""},{"to":142,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":144,"x":200,"y":-60,"z":0,"title":"Hunter's Glade, Dark Trees Path","descriptions":["Moss drapes from the sap-sugared pine branches above in wispy grey-blue tendrils.  They embrangle tall shrubs and fill in gaps in the tree canopy to block out almost all of the sky."],"exits":[{"to":145,"exit":"go","move":""},{"to":151,"exit":"go","move":""},{"to":143,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":145,"x":200,"y":-80,"z":0,"title":"Hunter's Glade, Dark Trees Path","descriptions":["The tree branches twine overhead, covering the glade with cool shadow that chases the sunlight away.  Strange animal cries and sounds of movement that rustle in the thickening underbrush add to a sense of foreboding that fills the pathway.  It's little wonder the locals seldom tread this route.","The tree branches twine overhead, covering the glade with cool shadow that shuts out moonlight.  Mist rises from the ground and is trapped beneath the canopy.  It washes the landscape with ashen shades, lending a sense of foreboding to the pathway that is heightened by strange animal cries and sounds of movement in the brush.  It's little wonder the locals seldom tread this route."],"exits":[{"to":146,"exit":"go","move":""},{"to":144,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":146,"x":200,"y":-100,"z":0,"title":"Hunter's Glade, Dark Trees Path","descriptions":["The trees bend in over the slim pathway, casting it deep in shade.  Gnarled knotholes peering down through the bristly canopy of a fat spruce tree seem to watch every movement.  Shrill cries, unlike those heard farther south, pierce the dusky veil and seem to resonate in one's bones."],"exits":[{"to":145,"exit":"go","move":""},{"to":147,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":147,"x":180,"y":-120,"z":0,"title":"Hunter's Glade, Dark Trees Path","descriptions":["Thick shrubs push in toward the path and grab at passers-by like the small hands of a child tugging at one's cloak hem.  The sound of birdsong is strangely absent despite the thick mesh of branches above."],"exits":[{"to":146,"exit":"go","move":""},{"to":148,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":148,"x":160,"y":-140,"z":0,"title":"Hunter's Glade, Dark Trees Path","descriptions":["Cascades of ivy and other viny plants pour over each outcrop, concealing the stone-clotted earth and making the sharply rising landscape look more like a solid wall of dark foliage.  Fir and cedar trees lean into one another as they stagger up the slope, like old men walking home from a bar."],"exits":[{"to":149,"exit":"go","move":""},{"to":147,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":149,"x":160,"y":-160,"z":0,"title":"Hunter's Glade, Dark Trees Path","descriptions":["Leathery brown tripe lichen grows on many of the exposed rocks and looks like vaguely circular patches torn from a tanned hide.  The slightly upturned edges catch and store rainwater that keeps the plant supple.  Those with tears or insect-munched holes quickly dry up and become brittle."],"exits":[{"to":148,"exit":"go","move":""},{"to":150,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":150,"x":140,"y":-180,"z":0,"title":"Hunter's Glade, Dark Trees Path","descriptions":["Hardwoods gradually mingle with the conifers, giving the wind a slightly raspier voice when rustling through the branches.  In winter, the bare tree limbs whisper hoarsely as they rub against each other and sometimes sound like the grunting of boars."],"exits":[{"to":149,"exit":"go","move":""},{"to":180,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":151,"x":180,"y":-40,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["The trees become older, taller and closer as the glade wends up the broken landscape toward a dark line of towering trees to the north.  The underbrush also thickens noticeably as viny plants and scrubby bushes tangle amid the tree roots and timeworn stones protruding from the earth."],"exits":[{"to":144,"exit":"go","move":""},{"to":157,"exit":"go","move":""},{"to":152,"exit":"go","move":""},{"to":142,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":152,"x":160,"y":-20,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["Birdsongs filter in from all directions, blending into a sweet arboreal symphony.  Some twitter staccato soprano parts and others caw contralto backbeats.  The owls and mourning doves add their long, slow tenor nearest twilight and dawn, when the sky's colors demand a bit more drama."],"exits":[{"to":151,"exit":"go","move":""},{"to":158,"exit":"go","move":""},{"to":156,"exit":"go","move":""},{"to":153,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":153,"x":140,"y":-20,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["The land rises sharply to the north and east, stepping up in plateaus that seem supported by smooth chunks of granite mortared together with damp earth and moss.  At the base of each rise lies a line of trees washed away with the thin soil by rain or meltwater.  Twittering birds flit in and out of a gap in the lacy trim of deadfall.","The land rises sharply to the north and east, stepping up in plateaus that seem supported by smooth chunks of granite mortared together with damp earth and moss.  At the base of each rise lies a line of trees washed away with the thin soil by rain or meltwater.  Large moths flutter in and out of a gap in the lacy trim of deadfall."],"exits":[{"to":154,"exit":"go","move":""},{"to":152,"exit":"go","move":""},{"to":156,"exit":"go","move":""},{"to":155,"exit":"go","move":""},{"to":177,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":154,"x":140,"y":-40,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["The sunlit forest floor reclaims the remains of a fallen pine.  Blankets of heavy moss appear to drag it physically back into the earth.  The tree's cloak of bark has almost completely sloughed off, and the exposed wood is dark with rot.  In the cool climate of the forest steppe, decay is slow and deliberate.","The forest floor reclaims the remains of a fallen pine.  Heavy blankets of moss appear to drag it physically back into the earth.  The tree's thick cloak of bark has almost completely sloughed off and the exposed wood is pitted with rot.  In the cool climate of the forest steppe, decay is slow and deliberate."],"exits":[{"to":141,"exit":"go","move":""},{"to":142,"exit":"go","move":""},{"to":153,"exit":"go","move":""},{"to":140,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":155,"x":120,"y":0,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["The lunat's lowest, more or less horizontal branches typically die but remain on the tree for a few years afterward, giving it a scraggly look before they fall off.  These dead lower branches are generally encrusted with brittle splotches of grey-green lichen and pale shelves of fungus."],"exits":[{"to":153,"exit":"go","move":""},{"to":160,"exit":"go","move":""},{"to":137,"exit":"go","move":""},{"to":138,"exit":"go","move":""},{"to":139,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":156,"x":160,"y":0,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["Ivy envelops all but the skyward-reaching splinter of a broken stump.  It smothers the rocky outcroppings and covers the ground in deep green filigree throughout the seasons.  The sunlight plays hide-and-seek with shadows over the leafy blanket as it shivers in the brisk wind.","Ivy envelops all but the skyward-reaching splinter of a broken stump.  It smothers the rocky outcroppings and covers the ground in deep green filigree throughout the seasons.  Even the darkest night skies have a glimmer of light that plays gaily over the shiny ivy leaves."],"exits":[{"to":152,"exit":"go","move":""},{"to":159,"exit":"go","move":""},{"to":160,"exit":"go","move":""},{"to":153,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":157,"x":180,"y":-20,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["To the north, the landscape fractures into a jumble of progressively larger outcrops and low cliffs.  Tall conifers crowd each other and cling with gnarled roots to the unyielding, stony soil.  On slopes too steep for trees grow azaleas that bloom red and pink in the early spring.  Several varieties of holly mingle with the lower-growing plants and adorn the glade's winter season with berries ranging from red and orange to golden yellow."],"exits":[{"to":151,"exit":"go","move":""},{"to":176,"exit":"go","move":""},{"to":158,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":158,"x":180,"y":0,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["A scarlet-coifed woodpecker perched high in a nearby pine chips off loose flakes of tree bark with a staccato rat-a-tat-a-tat.  The bark bits fall to the ground with a soft pattering sound, like a dry rain.  The litter of pine needles and leaves in the area is turned up from the recent furrowing of wild boars in search of something good to eat.","The litter of pine needles and leaves in the area is turned up from the recent furrowing of wild boars in search of something good to eat.  Hoarse grunting and chirruping surrounds nighttime travelers in the boars' domain.  Occasionally, an alarmed squeal tears through the darkness."],"exits":[{"to":157,"exit":"go","move":""},{"to":159,"exit":"go","move":""},{"to":152,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":159,"x":180,"y":20,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["Twin maple seedlings grow in a depression atop a very large basalt boulder.  A passing bird must have deposited the seeds, as there are no other maple trees in the glade.  Birds enjoy the rock because the shallow wells in its surface hold water high enough from the ground that they can drink and bathe here without being menaced by the glade's larger inhabitants."],"exits":[{"to":158,"exit":"go","move":""},{"to":176,"exit":"go","move":""},{"to":174,"exit":"go","move":""},{"to":175,"exit":"go","move":""},{"to":156,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":160,"x":140,"y":20,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["A grey and tattered bit of rope dangles from an overhanging tree limb, swinging back and forth in the wind.  Judging from the slipknots tied around the branch, the rope appears to be the remains of a trap.  The locals have long used this glade for hunting and trapping with such productive results that the only reason they've found to venture farther north into the dark, looming Paasvadh is foolhardy adventure-seeking."],"exits":[{"to":156,"exit":"go","move":""},{"to":167,"exit":"go","move":""},{"to":155,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":161,"x":120,"y":20,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["Beneath the tall conifers, the glade is open and park-like, relatively free of underbrush but for patches of shrubs that usually huddle close to the trees' shade.  Stretches of grass and sedge grow in small clearings, where older trees have fallen and the progression of the forest begins again with the smallest plants."],"exits":[{"to":167,"exit":"go","move":""},{"to":162,"exit":"go","move":""},{"to":136,"exit":"go","move":""},{"to":137,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":162,"x":120,"y":40,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["Sunlight speckles the forest floor and wind sighs among the pine boughs, creating a sense of quiet solitude broken only by the sound of the boars that inhabit the forest.  A loud grunting sound usually precedes their barreling heedlessly through the area, snapping thin saplings and turning up the smooth brown carpet of pine needles.  Frequently, they stop to sharpen their tusks or just scratch themselves on the pines' rough bark, flaking chunks off and leaving the pale wood exposed.","Cooler night winds sigh among the pine boughs, creating a sense of quiet solitude broken only by the sound of the boars that inhabit the forest.  A loud grunting sound usually precedes their barreling heedlessly through the area, snapping thin saplings and turning up the smooth brown carpet of pine needles.  Frequently, they stop to sharpen their tusks or just scratch themselves on the pines' rough bark, flaking chunks off and leaving the pale wood exposed."],"exits":[{"to":161,"exit":"go","move":""},{"to":135,"exit":"go","move":""},{"to":136,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":163,"x":120,"y":120,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["Slender evergreens grow tall and straight, with high, narrow crowns of branches.  The lowest limbs in this area belong to the longleaf pine, whose feathery boughs wave in the breezes about one story overhead.  Once their long dark green needles fall, they turn deep amber brown.  Frosty white wads of sap drip from their needles and cover the ground with globs of sticky goop that resemble hailstones."],"exits":[{"to":164,"exit":"go","move":""},{"to":165,"exit":"go","move":""},{"to":131,"exit":"go","move":""},{"to":132,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":164,"x":120,"y":100,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["Curious dark, rounded mammoth-sized boulders of basalt lie atop and project from the forest floor here.  They look as if they had been dropped in place, as they do not match the granite outcroppings or craggy shoreline.  Some have deep valleys filled with windblown soil and decaying matter in which weeds and small saplings grow, as though recreating the glade in miniature."],"exits":[{"to":166,"exit":"go","move":""},{"to":165,"exit":"go","move":""},{"to":163,"exit":"go","move":""},{"to":132,"exit":"go","move":""},{"to":134,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":165,"x":140,"y":120,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["A patch of green grows in this wide clearing amid the trees and pine needle-covered earth.  Tiny yellow waiku flowers huddle in the grasses and clover, their petals closed tightly against the sunlight.  The flora surrounding the clearing is as varied as a patchwork shawl.","A patch of green grows in this wide clearing amid the trees and pine needle-covered earth.  Tiny yellow waiku flowers scatter in the grasses and clover, their petals spread wide to catch light from the heavens.  The flora surrounding the clearing is as varied as a patchwork shawl."],"exits":[{"to":168,"exit":"go","move":""},{"to":130,"exit":"go","move":""},{"to":163,"exit":"go","move":""},{"to":164,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":166,"x":140,"y":80,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["Slender needles from a stand of longleaf pine trees cover the ground here, making a crunchy matting that springs slightly underfoot.  Clusters of the tree's small cones lie scattered about, most having been pried open by squirrels for the seeds within.  A few undoubtedly opened before they fell, allowing their seeds to disperse and begin the forest's next generation."],"exits":[{"to":169,"exit":"go","move":""},{"to":168,"exit":"go","move":""},{"to":164,"exit":"go","move":""},{"to":135,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":167,"x":140,"y":40,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["A charred and shattered spruce lies in a broken heap surrounded by several other fire-blackened trees, evidence of a lightning strike.  Periodic small wildfires help maintain the openness of the wood by clearing underbrush and encouraging growth of grasses and sedge.  Already life is returning to the scorched area as a few tender new seedlings sprout from a mound of blackened earth."],"exits":[{"to":160,"exit":"go","move":""},{"to":175,"exit":"go","move":""},{"to":172,"exit":"go","move":""},{"to":135,"exit":"go","move":""},{"to":161,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":168,"x":160,"y":100,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["Beneath many of the shrubs and low tree branches are large saucer-shaped depressions.  The leaf-lined hollows evidence the forest's boar population.  In the day, the nests are filled with several boars piled together in sleep, but in the evening, all the nests are empty as entire drifts of boars roam the glade."],"exits":[{"to":170,"exit":"go","move":""},{"to":171,"exit":"go","move":""},{"to":165,"exit":"go","move":""},{"to":166,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":169,"x":160,"y":80,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["Cold winds blow energetically down the northward slope and through the glade.  They cut through the strong smell of pine needles and dry, musty leaf mold that hangs heavily beneath the trees.  Each breeze renews the air with icy freshness."],"exits":[{"to":170,"exit":"go","move":""},{"to":166,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":170,"x":180,"y":80,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["A dead pine's skeletal branches knock together in the wind, and the dry rapping noises travel down the limbs into the trunk, sounding like a heart beating somewhere deep within.  The coarse, black bark clings to the weather-silvered tree only in ragged patches that crumble off easily, and in the crook of a low branch, the wood bears the lacy scars of a termite infestation."],"exits":[{"to":173,"exit":"go","move":""},{"to":168,"exit":"go","move":""},{"to":169,"exit":"go","move":""},{"to":172,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":171,"x":180,"y":120,"z":0,"title":"Hunter's Glade, Southern Tract","descriptions":["A line of ashen birches looks ghostly pale against the darker pines that surround them, like the spirits of fallen trees floating amid the living.  Their leafy limbs sway gracefully with each breath of wind and rustle a soft accompaniment to the river's song."],"exits":[{"to":129,"exit":"go","move":""},{"to":168,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":172,"x":160,"y":60,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["A white-breasted nuthatch sitting in an overhead bough aggressively calls its mate with a nasal ank-ank-ank sound.  After a few calls, an answer comes in a shrill kee-kee from another limb.  Several other avian conversations begin, each with its own pitch, rhythm and emotion.  Rarely is there a moment of complete silence.","Only the occasional night bird breaks the quiet of the evening.  Most of the year in the glade, the nighttime stage belongs to the song of the crickets, but during the winter months, the snow owl enjoys a solo."],"exits":[{"to":175,"exit":"go","move":""},{"to":170,"exit":"go","move":""},{"to":167,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":173,"x":200,"y":60,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["Bristly spruce limbs cast filigree shadows that frolic over the ground as the trees sway in breezes scented with the clean smell of heather and pine.  The trees stand far enough apart that their branches do not overlap, and scrubby bunches of grass peek through the thin layer of pine needles covering the ground between the trees' canopy."],"exits":[{"to":174,"exit":"go","move":""},{"to":170,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":174,"x":200,"y":40,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["Heather grows in wispy clumps between the widely spaced trees.  Its feathery texture contrasts with the stiff and dark-leafed boxwood growing nearby, and it celebrates each thaw with blooming sprays of purple and lavender."],"exits":[{"to":173,"exit":"go","move":""},{"to":159,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":175,"x":160,"y":40,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["Soft pillows of bright green moss cling to the gnarled roots of some yews grouped on a low rise.  Between the trees, small piles of snow held in hollows formed by the roots melt slowly, providing a constant trickle to moisten the bark on which the moss thrives."],"exits":[{"to":159,"exit":"go","move":""},{"to":172,"exit":"go","move":""},{"to":167,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":176,"x":200,"y":0,"z":0,"title":"Hunter's Glade, Northern Tract","descriptions":["A mature felenok pine reaches majestically skyward and seems to grasp the sun in its outstretched limbs.  Large, golden cones burden the ends of each branch, making them arc slightly downward.  Few felenok seeds survive to fulfill their purpose, as they are sweet to the palate of local squirrels that eagerly pry them from their cones before they drop to the ground.","A mature felenok pine reaches majestically skyward and seems to hold the heavens in its outstretched limbs.  Large cones burden the ends of each branch, making them arc slightly downward.  Few felenok seeds survive to fulfill their purpose, as they are sweet to the palate of local squirrels that eagerly pry them from their cones before they drop to the ground."],"exits":[{"to":159,"exit":"go","move":""},{"to":157,"exit":"go","move":""},{"to":179,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":177,"x":80,"y":-60,"z":0,"title":"Hunter's Glade, Beneath the Deadfall","descriptions":["Covered with climbing vines, a latticework of branches twines just overhead, spanning a shallow gully at the base of an outcrop and creating a snug bower for those seeking shelter.  Birds perched amid the boughs twitter softly."],"exits":[{"to":178,"exit":"go","move":""},{"to":153,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":178,"x":100,"y":-60,"z":0,"title":"Hunter's Glade, Beneath the Deadfall","descriptions":["Covered with climbing vines, a latticework of branches twines just overhead, spanning a shallow gully at the base of an outcrop and creating a snug bower for those seeking shelter.  Birds perched amid the boughs twitter softly."],"exits":[{"to":177,"exit":"go","move":""}],"color":"#FFFFFF"},
  {"id":179,"x":220,"y":0,"z":0,"title":"Pilgrimage Trail, Forest","descriptions":["Partially obscured by fallen pine needles, the soft earth holds the small paw prints of a fox.  Matted tufts of grey fur, the remains of some rodent, are strewn before a hollow between gnarled tree roots.  The faint scent of decay mingles with the sharp smell of pine sap."],"exits":[{"to":0,"exit":"go","move":""}],"color":"#FFFFFF","linksTo":"Map129_Pilgramage_Trail.xml"},
  {"id":180,"x":140,"y":-200,"z":0,"title":"Hunter's Glade, Dark Trees Path","descriptions":["Shrubs and vines smother the slope and make getting a solid foothold a challenge in the dim light permitted in by the thick forest canopy.  A deeper darkness looms only a short climb upslope, where the old trees of the Paasvadh have stood for eons."],"exits":[{"to":0,"exit":"go","move":""}],"color":"#FFFFFF"}
 ],
 "labels": [
  {"text":"Black Goblins","x":20,"y":0,"z":0},
  {"text":"Damaska Boar","x":10,"y":10,"z":0}
 ]
}
