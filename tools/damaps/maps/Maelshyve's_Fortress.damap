{
 "format": "damap",
 "version": 1,
 "id": "31b",
 "name": "Maelshyve's Fortress",
 "file": "Map31b_Maelshyve's_Fortress.xml",
 "rooms": [
  {"id":1,"x":0,"y":280,"z":0,"title":"Zaulfung, Underwater","descriptions":["The murky waters end amongst a thick layer of decomposing sludge, heaped atop the uneven earth below.  Shadows rule here, allowing only a pale glimpse of the surroundings."],"exits":[{"to":2,"exit":"southeast","move":"swim southeast"},{"to":3,"exit":"up","move":"swim up"}],"color":"#0000FF"},
  {"id":2,"x":20,"y":300,"z":0,"title":"Zaulfung, Underwater","descriptions":["Very little light filters down this far through the muck, choking off your vision.  The outline of a rough massive slab of rock is barely visible to the east.  A jagged crack has crumbled in its side, seeming to lead into an underwater cavern of some sort."],"exits":[{"to":1,"exit":"northwest","move":"swim northwest"},{"to":6,"exit":"go","move":"go jagged crack"}],"color":"#0000FF"},
  {"id":3,"x":0,"y":260,"z":0,"title":"Zaulfung, Underwater","descriptions":["Tangles of decomposing weeds and vines threaten to grasp the unwary and hold them prisoner here.  A faint amount of light filters through the muck from above, while below it only grows darker."],"exits":[{"to":4,"exit":"up","move":"swim up"},{"to":1,"exit":"down","move":"swim down"}],"color":"#0000FF"},
  {"id":4,"x":0,"y":240,"z":0,"title":"Zaulfung, Underwater","descriptions":["The surface of the swamp is just overhead, and solid forms are visible above the murky waters.  Below, the swamp descends into tangles of shadow and decaying plants."],"exits":[{"to":5,"exit":"up","move":"swim up"},{"to":3,"exit":"down","move":"swim down"}],"color":"#0000FF"},
  {"id":5,"x":0,"y":220,"z":0,"title":"Zaulfung, Ruined Shrine","descriptions":["Shattered and broken, a large wooden altar lies desecrated and befouled here, partially sunken into the thick mud.  Deep gouges and claw scratches mar the surface of the sacrilegious monument, likely torn asunder by the wicked hand of a sluagh."],"exits":[{"to":0,"exit":"south","move":"south"}],"linksTo":"Map31a_Zaulfung.xml"},
  {"id":6,"x":40,"y":300,"z":0,"title":"Zaulfung, Underwater Cave","descriptions":["Dark, murky waters weigh heavily on all who venture into the confines of this narrow basalt cavern.  Shafts of feeble light stream through a jagged crack in the western wall."],"exits":[{"to":7,"exit":"up","move":"swim up"},{"to":2,"exit":"go","move":"go jagged crack"}],"color":"#0000FF"},
  {"id":7,"x":40,"y":280,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Dark basalt walls covered in slime encompass the chamber, lending a claustrophobic feeling to the area.  Ominous ripples swirl in the fetid sludge covering the cavern floor, their cause unknown."],"exits":[{"to":8,"exit":"north","move":"swim north"},{"to":6,"exit":"go","move":"go underwater tunnel"}],"color":"#0000FF"},
  {"id":8,"x":60,"y":260,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["A huge cavern, its ceiling obscured by a foul mist, opens ominously before you.  Droplets of cloudy liquid trickle down the dark basalt walls into the putrid muck that covers the slippery floor."],"exits":[{"to":22,"exit":"east","move":"swim east"},{"to":9,"exit":"south","move":"swim south"},{"to":7,"exit":"southwest","move":"swim southwest"},{"to":18,"exit":"west","move":"swim west"},{"to":19,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":9,"x":80,"y":280,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["The walls are jagged and sharp.  Several pointed outcrops, discolored with a reddish hue, have remnants of what appears to be clumps of matted hair."],"exits":[{"to":22,"exit":"northeast","move":"swim northeast"},{"to":11,"exit":"east","move":"swim east"},{"to":10,"exit":"southwest","move":"swim southwest"},{"to":8,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":10,"x":60,"y":300,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Oozing matter seeps from the dark basalt walls and dribbles down to the murky sludge covering the cavern floor.  Walking becomes more treacherous -- a single misstep might be cause for a slimy bath."],"exits":[{"to":9,"exit":"northeast","move":"swim northeast"},{"to":11,"exit":"west","move":"swim west"},{"to":12,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":11,"x":60,"y":320,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["The cavern walls glisten with an unnatural light, seemingly undulating with a life of their own.  Sloshing through the thick, foul-smelling muck becomes more difficult."],"exits":[{"to":10,"exit":"northeast","move":"swim northeast"},{"to":9,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":12,"x":120,"y":300,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["A small, unidentifiable drowned animal floats face down in the putrid sludge.  It slaps up against the cavern wall with a sickly smacking sound as the slightest movement causes small waves in the thick muck."],"exits":[{"to":23,"exit":"northeast","move":"swim northeast"},{"to":10,"exit":"south","move":"swim south"},{"to":12,"exit":"southwest","move":"swim southwest"},{"to":13,"exit":"west","move":"swim west"},{"to":15,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":13,"x":140,"y":240,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Dark basalt walls covered in black slime reach upwards to a high vaulted ceiling.  Thick alluvium covers the slippery cavern floor, splashing stagnant gunk on the legs of any who dare to trudge through the fetid sludge."],"exits":[{"to":14,"exit":"north","move":"swim north"},{"to":12,"exit":"east","move":"swim east"}],"color":"#0000FF"},
  {"id":14,"x":140,"y":220,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Small mud banks encroach on the cavern sides where the slippery floor is raised slightly.  The flow of water echoes dully as it laps upon the small muddy shore."],"exits":[{"to":15,"exit":"north","move":"swim north"},{"to":13,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":15,"x":140,"y":180,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["A long ledge covered with moldy bat droppings mars the smooth cavern wall.  Traveling the length of this passage, the basalt stone is notched with deep gouges, as if it had been struck by a heavy, blunt instrument."],"exits":[{"to":20,"exit":"north","move":"swim north"},{"to":45,"exit":"northeast","move":"swim northeast"},{"to":24,"exit":"east","move":"swim east"},{"to":12,"exit":"southeast","move":"swim southeast"},{"to":14,"exit":"south","move":"swim south"},{"to":16,"exit":"southwest","move":"swim southwest"},{"to":25,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":16,"x":80,"y":200,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["About halfway along the dark passage are boulders wedged in a rift near the waterline.  Dark brown moss completely covers the protruding stone, giving the semblance of a deformed badger peeking from its den."],"exits":[{"to":26,"exit":"north","move":"swim north"},{"to":20,"exit":"northeast","move":"swim northeast"},{"to":15,"exit":"east","move":"swim east"},{"to":19,"exit":"south","move":"swim south"},{"to":17,"exit":"southwest","move":"swim southwest"},{"to":27,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":17,"x":40,"y":220,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Thick black sludge laps up against dark basalt walls covered in a slippery mucous substance.  The complete silence of the cave is broken only by the monotonous plop of water dripping from an unseen ledge overhead."],"exits":[{"to":16,"exit":"northeast","move":"swim northeast"},{"to":18,"exit":"south","move":"swim south"},{"to":21,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":18,"x":20,"y":260,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Movement through the thick sludge raises the waterline that marks the sides of the cave walls.  Small pieces of debris slap against the hard stone and echo dully throughout the cavern."],"exits":[{"to":19,"exit":"north","move":"swim north"},{"to":8,"exit":"east","move":"swim east"},{"to":17,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":19,"x":60,"y":240,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Thick black sludge laps up against dark basalt walls covered in a slippery mucous substance.  The complete silence of the cave is broken only by the monotonous plop of water dripping from an unseen ledge overhead."],"exits":[{"to":16,"exit":"northeast","move":"swim northeast"},{"to":8,"exit":"south","move":"swim south"},{"to":18,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":20,"x":160,"y":140,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Small, scattered stalagmites jut above the waterline in the darkness, making travel treacherous.  Dark veins of greenish black basalt are embedded deeply in the cavern walls."],"exits":[{"to":43,"exit":"north","move":"swim north"},{"to":15,"exit":"south","move":"swim south"},{"to":16,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":21,"x":20,"y":200,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Several deep scratches mar one of the cavern walls, as if someone or something had attempted to dig minerals out of the hard rock.  Rivulets of moisture from above trickle down and fill the indentations like a thick pus."],"exits":[{"to":17,"exit":"east","move":"swim east"}],"color":"#0000FF"},
  {"id":22,"x":100,"y":260,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Swirling eddies of brackish water, laden with unidentifiable refuse, appear haphazardly on the filthy sludge covering the cavern floor.  Occasionally a loose rock will fall from above, spattering black slime on the dark basalt walls."],"exits":[{"to":12,"exit":"northeast","move":"go reeds"},{"to":9,"exit":"south","move":"swim south"},{"to":8,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":23,"x":200,"y":260,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Relatively clean of the wet sludge covering the cavern floor, basalt boulders give evidence of a recent cave-in.  Overhead the din from a cluster of noisy bats echoes dully against the cavern walls."],"exits":[{"to":12,"exit":"southwest","move":"swim southwest"},{"to":24,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":24,"x":160,"y":220,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Strange lichen covers one of the dark basalt walls of this underground cave.  The peculiar-looking fungus seems to be thriving in the fetid atmosphere and scant light."],"exits":[{"to":23,"exit":"east","move":"swim east"},{"to":15,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":25,"x":80,"y":140,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Dark basalt walls covered in slime encompass the chamber, lending a claustrophobic feeling to the area.  Ominous ripples swirl in the fetid sludge covering the cavern floor, their cause unknown."],"exits":[{"to":42,"exit":"north","move":"swim north"},{"to":15,"exit":"southeast","move":"swim southeast"},{"to":26,"exit":"south","move":"swim south"},{"to":27,"exit":"southwest","move":"swim southwest"},{"to":30,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":26,"x":80,"y":180,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["A thin layer of silt covers heavy stalactites hanging from the vaulted ceiling.  A steady plopping sound can be heard as moisture drips down from the long icicle-shaped forms and hits the putrid sludge covering the cavern floor."],"exits":[{"to":25,"exit":"north","move":"swim north"},{"to":16,"exit":"south","move":"swim south"},{"to":27,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":27,"x":60,"y":180,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Two huge slime-covered boulders partially block the passage, leaving only a small opening to squeeze through.  The basalt-veined walls are covered with a thin deposit of black silt."],"exits":[{"to":28,"exit":"north","move":"swim north"},{"to":25,"exit":"northeast","move":"swim northeast"},{"to":26,"exit":"east","move":"swim east"},{"to":16,"exit":"southeast","move":"swim southeast"},{"to":29,"exit":"southwest","move":"swim southwest"},{"to":27,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":28,"x":60,"y":160,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["The slippery floor pitches dangerously downwards before tapering off to resume a slight incline.  The sludge is deeper here and the mire beneath the surface is soft, slowing travel considerably."],"exits":[{"to":42,"exit":"northeast","move":"swim northeast"},{"to":27,"exit":"south","move":"swim south"},{"to":30,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":29,"x":40,"y":200,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["A small alcove in the cavern wall has become a dumping ground for rotted debris.  The still water in the small fetid grotto is foul and reeks of mold and decay."],"exits":[{"to":27,"exit":"northeast","move":"swim northeast"}],"color":"#0000FF"},
  {"id":30,"x":0,"y":120,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["A small, unidentifiable drowned animal floats face down in the putrid sludge.  It slaps up against the cavern wall with a sickly smacking sound as the slightest movement causes small waves in the thick muck."],"exits":[{"to":32,"exit":"north","move":"swim north"},{"to":39,"exit":"northeast","move":"swim northeast"},{"to":42,"exit":"east","move":"swim east"},{"to":25,"exit":"southeast","move":"swim southeast"},{"to":31,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":31,"x":-20,"y":140,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Relatively clean of the wet sludge covering the cavern floor, basalt boulders give evidence of a recent cave-in.  Overhead the din from a cluster of noisy bats echoes dully against the cavern walls."],"exits":[{"to":30,"exit":"northeast","move":"swim northeast"}],"color":"#0000FF"},
  {"id":32,"x":20,"y":60,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Small, scattered stalagmites jut above the waterline in the darkness, making travel treacherous.  Dark veins of greenish black basalt are embedded deeply in the cavern walls."],"exits":[{"to":36,"exit":"north","move":"swim north"},{"to":34,"exit":"east","move":"swim east"},{"to":33,"exit":"south","move":"swim south"},{"to":30,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":33,"x":20,"y":80,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Several deep scratches mar one of the cavern walls, as if someone or something had tried to dig something out of the hard rock.  Rivulets of moisture from above trickle down and fill the indentations like a thick pus."],"exits":[{"to":32,"exit":"north","move":"swim north"},{"to":49,"exit":"climb","move":"climb thick stalagmite"}],"color":"#00FF00"},
  {"id":34,"x":80,"y":60,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Small mud banks encroach on the cavern sides where the slippery floor is raised slightly.  The flow of water echoes dully as it laps upon the small muddy shore."],"exits":[{"to":35,"exit":"east","move":"swim east"},{"to":37,"exit":"southeast","move":"swim southeast"},{"to":32,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":35,"x":100,"y":20,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Two huge slime-covered boulders partially block the passage, leaving only a small opening to squeeze through.  The basalt-veined walls are covered with a thin deposit of black silt."],"exits":[{"to":41,"exit":"southeast","move":"swim southeast"},{"to":34,"exit":"southwest","move":"swim southwest"},{"to":36,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":36,"x":20,"y":20,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["The slippery floor pitches dangerously downwards before tapering off to resume a slight incline.  The sludge is deeper here and the mire beneath the surface is soft, slowing travel considerably."],"exits":[{"to":35,"exit":"east","move":"swim east"},{"to":32,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":37,"x":100,"y":80,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["A long ledge covered with moldy bat droppings mars the smooth cavern wall.  Traveling the length of this passage, the basalt stone is notched with deep gouges, as if it had been struck by a heavy, blunt instrument."],"exits":[{"to":40,"exit":"north","move":"swim north"},{"to":41,"exit":"northeast","move":"swim northeast"},{"to":38,"exit":"west","move":"swim west"},{"to":34,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":38,"x":60,"y":80,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["About halfway along the dark passage are boulders wedged in a rift near the waterline.  Dark brown moss completely covers the protruding stone, giving the semblance of a deformed badger peeking from its den."],"exits":[{"to":37,"exit":"east","move":"swim east"},{"to":39,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":39,"x":40,"y":80,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Dark basalt walls covered in black slime reach upwards to a high vaulted ceiling.  Thick alluvium covers the slippery cavern floor, splashing stagnant gunk on the legs of any who dare to trudge through the fetid sludge."],"exits":[{"to":38,"exit":"east","move":"swim east"},{"to":43,"exit":"southeast","move":"swim southeast"},{"to":30,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":40,"x":100,"y":60,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["A small alcove in the cavern wall has become a dumping ground for rotted debris.  The still water in the small fetid grotto is foul and reeks of mold and decay."],"exits":[{"to":37,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":41,"x":120,"y":60,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["A thin layer of silt covers heavy stalactites hanging from the vaulted ceiling.  A steady plopping sound can be heard as moisture drips down from the long icicle-shaped forms and hits the putrid sludge covering the cavern floor."],"exits":[{"to":37,"exit":"southwest","move":"swim southwest"},{"to":35,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":42,"x":80,"y":120,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["A huge cavern, its ceiling obscured by a foul mist, opens ominously before you.  Droplets of cloudy liquid trickle down the dark basalt walls into the putrid muck that covers the slippery floor."],"exits":[{"to":43,"exit":"east","move":"swim east"},{"to":25,"exit":"southeast","move":"swim southeast"},{"to":28,"exit":"south","move":"swim south"},{"to":30,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":43,"x":120,"y":120,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Strange lichen covers one of the dark basalt walls of this underground cave.  The peculiar-looking fungus seems to be thriving in the fetid atmosphere and scant light."],"exits":[{"to":39,"exit":"north","move":"swim north"},{"to":44,"exit":"northeast","move":"swim northeast"},{"to":45,"exit":"southeast","move":"swim southeast"},{"to":20,"exit":"south","move":"swim south"},{"to":42,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":44,"x":140,"y":80,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Several deep scratches mar one of the cavern walls, as if someone or something had attempted to dig minerals out of the hard rock.  Rivulets of moisture from above trickle down and fill the indentations like a thick pus."],"exits":[{"to":47,"exit":"southeast","move":"swim southeast"},{"to":43,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":45,"x":140,"y":140,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Swirling eddies of brackish water, laden with unidentifiable refuse, appear haphazardly on the filthy sludge covering the cavern floor.  Occasionally a loose rock will fall from above, spattering black slime on the dark basalt walls."],"exits":[{"to":43,"exit":"north","move":"swim north"},{"to":46,"exit":"northeast","move":"swim northeast"},{"to":15,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":46,"x":140,"y":100,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Oozing matter seeps from the dark basalt walls and dribbles down to the murky sludge covering the cavern floor.  Walking has become treacherous -- a single misstep will be cause for a slimy bath."],"exits":[{"to":48,"exit":"northeast","move":"swim northeast"},{"to":45,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":47,"x":160,"y":100,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["Movement through the thick sludge raises the waterline that marks the sides of the cave walls.  Small pieces of debris slap against the hard stone and echo dully throughout the cavern."],"exits":[{"to":48,"exit":"north","move":"north"},{"to":44,"exit":"northwest","move":"northwest"}],"color":"#0000FF"},
  {"id":48,"x":160,"y":80,"z":0,"title":"Beneath The Zaulfung, Murky Caverns","descriptions":["The walls are jagged and sharp.  Several pointed outcrops, discolored with a reddish hue, have remnants of what appears to be clumps of matted hair."],"exits":[{"to":47,"exit":"south","move":"swim south"},{"to":46,"exit":"southwest","move":"swim southwest"}],"color":"#0000FF"},
  {"id":49,"x":260,"y":160,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["A small shelf just below the low ceiling juts out over a massive cavern below.  A thick stalactite descends from the ceiling, offering something to shimmy down on to the lower level.  The shelf opens into a cavern of its own to the southeast, whose charred basalt walls are nearly everywhere you look."],"exits":[{"to":50,"exit":"southeast","move":"southeast"},{"to":33,"exit":"climb","move":"climb thick stalactite"}],"color":"#00FF00"},
  {"id":50,"x":280,"y":180,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Dark basalt walls flecked with unidentifiable minerals glisten in the damp atmosphere.  Sharp rocks underfoot are slick with slimy lichen, slowing travel through this treacherous area."],"exits":[{"to":51,"exit":"south","move":"south"},{"to":49,"exit":"northwest","move":"northwest"},{"to":122,"exit":"go","move":"go amorphous spirits"}]},
  {"id":51,"x":280,"y":200,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Ominously shaped stalagmites protruding haphazardly from the cavern floor hinder movement and cast eerie shadows.  Navigating through these natural obstacles slows the vigilant traveler."],"exits":[{"to":50,"exit":"north","move":"north"},{"to":52,"exit":"southeast","move":"southeast"}]},
  {"id":52,"x":300,"y":220,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Dull echoes reverberate throughout the vast cavern as overhead the faint fluttering of unseen bats breaks the silence of the cave.  Layers of fetid droppings cover the walls and floor like splatters from a malformed brush on a painter's canvas."],"exits":[{"to":55,"exit":"east","move":"east"},{"to":53,"exit":"northwest","move":"northwest"}]},
  {"id":53,"x":300,"y":240,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["A recent cave-in partially obstructs travel here, and one must slow the pace to traverse the fallen boulders and crushed rock.  Rare minerals extended in chaotic lines on the surface of the walls resemble the weavings of a deranged spider."],"exits":[{"to":55,"exit":"northeast","move":"northeast"},{"to":54,"exit":"southeast","move":"southeast"}]},
  {"id":54,"x":320,"y":260,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["The passage opens up to a three-way intersection as if to befuddle the unwary traveler.  Jagged outcroppings dusted with shiny specks of rich minerals glisten like minute diamonds, almost begging for a pickaxe to mar the studded surface."],"exits":[{"to":59,"exit":"northeast","move":"northeast"},{"to":56,"exit":"southeast","move":"southeast"},{"to":53,"exit":"northwest","move":"northwest"}]},
  {"id":55,"x":320,"y":220,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Crumbled stone litters the dry floor and the basalt walls are scorched and pitted, as if a constant heat or fire has been applied.  Random scratches and gouges are deeply imbedded in one wall, the indentations filled with blackened soot."],"exits":[{"to":53,"exit":"southwest","move":"southwest"},{"to":52,"exit":"west","move":"west"}]},
  {"id":56,"x":340,"y":280,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["A huge rock, besmeared with fetid animal droppings and remnants of scorched bone and scraps of tattered cloth, partially obstructs the passageway.  At the base are deep scratches and irregular notches filled with packed dirt."],"exits":[{"to":57,"exit":"south","move":"south"},{"to":54,"exit":"northwest","move":"northwest"}]},
  {"id":57,"x":340,"y":300,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["The passageway widens slightly and is large enough for three Gor'Togs to walk abreast.  The cold walls are jagged, with razor sharp outcroppings that glisten with minerals."],"exits":[{"to":56,"exit":"north","move":"north"},{"to":58,"exit":"southwest","move":"southwest"}]},
  {"id":58,"x":320,"y":320,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Unidentifiable minerals snake randomly on the surface of the stone walls, leaving sinuous trails in the hard rock.  A pile of scorched rubble lies abandoned in one corner, a remnant from a past battle."],"exits":[{"to":57,"exit":"northeast","move":"northeast"},{"to":53,"exit":"northwest","move":"northwest"}]},
  {"id":59,"x":340,"y":240,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Several icicle-shaped stalactites hang from the cavern ceiling.  Their damaged tips are blackened and scorched, making them look like the rotting fangs of some huge carnivore."],"exits":[{"to":60,"exit":"northeast","move":"northeast"},{"to":54,"exit":"southwest","move":"southwest"}]},
  {"id":60,"x":360,"y":220,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["The cavern opens into a room with a high vaulted ceiling and several passageways, with no clues in which direction to traverse.  Occasionally a stray rock falls to the floor with a dull thud, but otherwise a traveler is met with only an ominous silence."],"exits":[{"to":69,"exit":"northeast","move":"northeast"},{"to":59,"exit":"southwest","move":"southwest"},{"to":61,"exit":"west","move":"west"}]},
  {"id":61,"x":340,"y":220,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["The stone riddled floor slopes slightly and the passageway narrows.  The dark walls seem to bulge outwards, creating an almost claustrophobic feeling in this area."],"exits":[{"to":60,"exit":"east","move":"east"},{"to":62,"exit":"northwest","move":"northwest"}]},
  {"id":62,"x":320,"y":200,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Three darkly ominous passageways greet the unsuspecting traveler in this cavernous chamber.  Blackened and scorched walls guard a floor littered with animal droppings and crushed rocks."],"exits":[{"to":65,"exit":"east","move":"east"},{"to":61,"exit":"southeast","move":"southeast"},{"to":63,"exit":"northwest","move":"northwest"}]},
  {"id":63,"x":300,"y":180,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Oddly shaped rocks, singed black from an unexplained flame, protrude erratically from the walls and ceiling of this narrow passageway.  To the north the passage leads deeper into the recesses of the earth, the floor pitching slightly, impeding travel with its treacherous surface."],"exits":[{"to":64,"exit":"north","move":"north"},{"to":62,"exit":"southeast","move":"southeast"}]},
  {"id":64,"x":300,"y":160,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["The rugged passage leads into a larger chamber filled with jagged rocks and small scabrous boulders haphazardly scattered.  The whisper of a draft whistles ominously and echoes hollowly through three open entryways."],"exits":[{"to":66,"exit":"northeast","move":"northeast"},{"to":63,"exit":"south","move":"south"},{"to":49,"exit":"northwest","move":"northwest"}]},
  {"id":65,"x":340,"y":200,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["A large crack has caused a jagged rift in one of the basalt walls, exposing a variety of minerals embedded deep within the hard stone.  The cavern's floor is uneven and treacherous to walk on, with serrated rocks emerging helter-skelter along the rough surface."],"exits":[{"to":66,"exit":"northeast","move":"northeast"},{"to":62,"exit":"west","move":"west"}]},
  {"id":66,"x":360,"y":180,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Craggy basalt walls stretch upwards toward a natural domed ceiling.  The hard floor is tamped down and smooth, almost as if an invisible broom has swept miscellaneous debris into one of the three passageways that open into this area."],"exits":[{"to":68,"exit":"northeast","move":"northeast"},{"to":67,"exit":"east","move":"east"},{"to":65,"exit":"southwest","move":"southwest"}]},
  {"id":67,"x":380,"y":180,"z":0,"title":"Charred Caverns, Chasm's Edge","descriptions":["The passageway ends abruptly at the edge of a wide chasm.  The surrounding walls are blackened with fiery marks seared deeply into the hard rock.  The floor is littered with the charred remains of small animals that were trapped, perhaps as they waged a final battle.  A rope bridge, frayed but otherwise unmarked, spans the deep abyss before you."],"exits":[{"to":66,"exit":"west","move":"west"},{"to":71,"exit":"go","move":"rt go rope bridge"}]},
  {"id":68,"x":360,"y":160,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Craggy walls pitted and filled with grime and soot line the passageway.  Irregularly notched indentations hold the remains of tiny bits of debris that are blackened and charred beyond recognition."],"exits":[{"to":55,"exit":"northeast","move":"northeast"},{"to":66,"exit":"southwest","move":"southwest"}]},
  {"id":69,"x":380,"y":200,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Denticulated walls with tiny formations of serrated rock provide an unusual nesting place for mysterious fungi, whose foul, pungent odor permeates the stale air.  Unidentifiable mushrooms are strewed along the cavern floor, smashed into a slippery pulp by previous visitors."],"exits":[{"to":70,"exit":"east","move":"east"},{"to":60,"exit":"southwest","move":"southwest"}]},
  {"id":70,"x":400,"y":200,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Deep claw marks are slashed irregularly along the craggy walls and floor, as if something had attacked the rock with great anger or frustration.  The porous floor is saturated with varying degrees of rust-colored stains, having soaked up and absorbed all manner of unidentifiable secretions."],"exits":[{"to":59,"exit":"southwest","move":"southwest"},{"to":69,"exit":"west","move":"west"}]},
  {"id":71,"x":440,"y":180,"z":0,"title":"Charred Caverns, Rope Bridge","descriptions":["A fraying rope has been anchored on each side of a wide chasm, allowing one to shuffle hand-to-hand while hanging above the unknown darkness.  The western edge of the chasm is just within reach here."],"exits":[{"to":72,"exit":"none","move":"rt shuffle east"},{"to":67,"exit":"none","move":"rt shuffle west"}]},
  {"id":72,"x":460,"y":180,"z":0,"title":"Charred Caverns, Rope Bridge","descriptions":["A fraying rope has been anchored on each side of a wide chasm, allowing one to shuffle hand-to-hand while hanging above the unknown darkness.  Strange noises stir in the surrounding shadows, like swarms of malignant specters waiting for the right moment to snatch you off the line."],"exits":[{"to":73,"exit":"none","move":"rt shuffle east"},{"to":71,"exit":"none","move":"rt shuffle west"}]},
  {"id":73,"x":480,"y":180,"z":0,"title":"Charred Caverns, Rope Bridge","descriptions":["A fraying rope has been anchored on each side of a wide chasm, allowing one to shuffle hand-to-hand while hanging above the unknown darkness.  The eastern edge of the chasm is just within reach here."],"exits":[{"to":74,"exit":"none","move":"rt shuffle east"},{"to":72,"exit":"none","move":"rt shuffle west"}]},
  {"id":74,"x":480,"y":380,"z":0,"title":"Charred Caverns, Chasm's Edge","descriptions":["The stony ground ends in a jagged ledge to the west overlooking a great chasm.  An enormous flat boulder nearby anchors a fraying rope bridge."],"exits":[{"to":75,"exit":"east","move":"east"},{"to":73,"exit":"go","move":"rt go rope bridge"}]},
  {"id":75,"x":500,"y":380,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["Skulls and other indistinct skeletal remnants lie strewn in a disorderly pile near the path's edge.  The acrid odor of charred human flesh obtrusively invades the palate."],"exits":[{"to":76,"exit":"northeast","move":"northeast"},{"to":74,"exit":"west","move":"west"}]},
  {"id":76,"x":520,"y":360,"z":0,"title":"Beneath The Zaulfung, Charred Caverns","descriptions":["The cavern snakes onward, the walls uneven and jagged.  Whatever force, natural or otherwise, gave birth to these tunnels clearly valued haste over beauty or safety."],"exits":[{"to":77,"exit":"east","move":"east"},{"to":75,"exit":"southwest","move":"southwest"}]},
  {"id":77,"x":540,"y":360,"z":0,"title":"Charred Caverns, Maelshyve's Threshold","descriptions":["A stout obsidian obelisk stands prominently in the center of the circular chamber.  Its four faces are pristine and unmarred by etching or carving.  An ornate black crystal archway molded from the rock leads north into an eerily lit shrine."],"exits":[{"to":76,"exit":"west","move":"west"},{"to":78,"exit":"go","move":"go black archway"}],"color":"#00FF00","aliases":["Depart","Obelisk"]},
  {"id":78,"x":560,"y":360,"z":0,"title":"Maelshyve's Threshold, Antechamber","descriptions":["Contorted skulls affixed to thick iron spikes flank a black crystal archway that leads to the southern caverns.  The orifices of the morbid effigies burn with intense flame, casting a flickering glow upon three great statues carved into the northern walls of the shrine."],"exits":[{"to":80,"exit":"north","move":"north"},{"to":79,"exit":"northeast","move":"northeast"},{"to":81,"exit":"northwest","move":"northwest"},{"to":77,"exit":"go","move":"go black archway"}]},
  {"id":79,"x":580,"y":340,"z":0,"title":"Maelshyve's Threshold, Antechamber","descriptions":["A small pile of coarse bone meal lies in tribute at the foot of a grotesque statue carved into the face of the northeastern wall.  Shadows hang in the corner, obscuring the rightmost half of the stillborn creature."],"exits":[{"to":78,"exit":"southwest","move":"southwest"},{"to":80,"exit":"west","move":"west"}],"color":"#00FF00","aliases":["Blue","Ice"]},
  {"id":80,"x":560,"y":340,"z":0,"title":"Maelshyve's Threshold, Antechamber","descriptions":["A sickly, fluttering glow from the south illuminates a carving in the northern wall depicting a contorted reptilian woman.  A cold stillness hangs in the air, a foreboding harbinger of what may lie beyond this chamber.","A pile of rubble is strewn upon the ground beneath a large hole that has crumbled in the northern wall of the chamber.  A cold stillness hangs in the air, a foreboding harbinger of what may lie beyond this chamber."],"exits":[{"to":79,"exit":"east","move":"east"},{"to":78,"exit":"south","move":"south"},{"to":81,"exit":"west","move":"west"},{"to":82,"exit":"north","move":"north","hidden":true}],"color":"#00FF00","aliases":["Black","Shadows"]},
  {"id":81,"x":540,"y":340,"z":0,"title":"Maelshyve's Threshold, Antechamber","descriptions":["Carved into the face of the northwestern wall is a hideous statue bearing vaguely reptilian yet humanoid features.  Its grand musculature and cruel, claw-tipped appendages unmistakably shatter any remote resemblance to a S'Kra Mur."],"exits":[{"to":80,"exit":"east","move":"east"},{"to":78,"exit":"southeast","move":"southeast"}],"color":"#00FF00","aliases":["Red","Fire"]},
  {"id":82,"x":560,"y":320,"z":0,"title":"Maelshyve's Fortress, Grand Hall","descriptions":["The stone walls of the preceding caverns end abruptly, giving way to a crystalline hall of inky purple-black obsidian.  Murky shadows gestate within the cool glassy sea, shifting languidly in the dim, unstable light.  Two hallways fork off from the entryway, slithering deeper into the depths of the foul temple.  The southern stone wall has crumbled, leaving a pile of rubble on the ground.  A jagged hole allows passage into a large chamber beyond.","The stone walls of the preceding caverns end abruptly, giving way to a crystalline hall of inky purple-black obsidian.  Murky shadows gestate  within the cool glassy sea, shifting languidly in the dim, unstable light.  Three  hallways fork off from the entryway, slithering deeper into the depths of the foul temple.  The southern stone wall has crumbled, leaving a pile of rubble on the ground.  A jagged hole allows passage into a large chamber beyond."],"exits":[{"to":83,"exit":"northeast","move":"northeast"},{"to":80,"exit":"south","move":"south","hidden":true},{"to":88,"exit":"northwest","move":"northwest"},{"to":93,"exit":"north","move":"north"}]},
  {"id":83,"x":580,"y":300,"z":0,"title":"Maelshyve's Fortress, Hall of Terror","descriptions":["Sleek obsidian walls extend into darkness to the north.  The ceiling vaults high above, thick shadows concealing what may perch overhead."],"exits":[{"to":84,"exit":"north","move":"north"},{"to":82,"exit":"southwest","move":"southwest"}]},
  {"id":84,"x":580,"y":280,"z":0,"title":"Maelshyve's Fortress, Hall of Terror","descriptions":["Masses of insects flood the floor of the narrow, dank hallway, producing moist crackling noises as carapaces are crushed with every step.  The choking stench of decomposing flesh invades the room and the nostrils."],"exits":[{"to":85,"exit":"north","move":"north"},{"to":83,"exit":"south","move":"south"}]},
  {"id":85,"x":580,"y":260,"z":0,"title":"Maelshyve's Fortress, Hall of Terror","descriptions":["The incessant hissing resounding through the close quarters reveals the shadow-shrouded presence of what must be thousands of cockroaches crawling along the slimy ground."],"exits":[{"to":86,"exit":"north","move":"north"},{"to":84,"exit":"south","move":"south"}]},
  {"id":86,"x":580,"y":240,"z":0,"title":"Maelshyve's Fortress, Hall of Terror","descriptions":["Rusty iron cages are affixed to the highly polished obsidian walls, their surfaces covered in an ever-flowing wave of insects.  Several of the restraints appear particularly brutal, bearing spikes to spear into flesh and bone at the slightest protest of a captive's predicament."],"exits":[{"to":87,"exit":"north","move":"north"},{"to":85,"exit":"south","move":"south"}]},
  {"id":87,"x":580,"y":220,"z":0,"title":"Maelshyve's Fortress, Hall of Terror","descriptions":["Luminous red lichen on the low ceiling casts a bloody sheen over the smooth, glassy northern wall.  Illuminated just under the obsidian's surface is the twisted skeleton of a hulking reptilian creature.  A head above the average Gor'Tog, the fanged skull protrudes from the solid rock.  Just below it, the skeletal tail is also exposed to the open air."],"exits":[{"to":86,"exit":"south","move":"south"}],"color":"#00FF00"},
  {"id":88,"x":540,"y":300,"z":0,"title":"Maelshyve's Fortress, Hall of Anguish","descriptions":["The ceiling of the dark obsidian hall hangs low, lending an element of confinement to the stale musty air often found in enclosed spaces.  A dark pool of viscous liquid lies near the eastern wall."],"exits":[{"to":89,"exit":"north","move":"north"},{"to":82,"exit":"southeast","move":"southeast"}]},
  {"id":89,"x":540,"y":280,"z":0,"title":"Maelshyve's Fortress, Hall of Anguish","descriptions":["The overwhelming stench of bile rises from the ground, bringing with it a bitter taste.  The ceiling seems to slope lower further to the north."],"exits":[{"to":90,"exit":"north","move":"north"},{"to":88,"exit":"south","move":"south"}]},
  {"id":90,"x":540,"y":260,"z":0,"title":"Maelshyve's Fortress, Hall of Anguish","descriptions":["Rusty iron implements protrude awkwardly from the icy obsidian walls, stained with a thick crust of dried blood.  Nearby, the wall is notched with crude hashmarks, likely a calendar kept to catalog prolonged suffering."],"exits":[{"to":91,"exit":"north","move":"north"},{"to":89,"exit":"south","move":"south"}]},
  {"id":91,"x":540,"y":240,"z":0,"title":"Maelshyve's Fortress, Hall of Anguish","descriptions":["Corroded shackles anchored deep into the walls imprison weathered skeletons of victims long deceased.  Discolored bone fragments litter the floor as the restrained corpses give way to the siege of time, crumbling ever so slowly into the dust of which they were conceived."],"exits":[{"to":92,"exit":"north","move":"north"},{"to":90,"exit":"south","move":"south"}]},
  {"id":92,"x":540,"y":220,"z":0,"title":"Maelshyve's Fortress, Hall of Anguish","descriptions":["The low obsidian hallway meets an abrupt end at a small alcove.  A morbid effigy lies in the northern wall, a full skeleton mostly submerged within the dusky obsidian.  Protruding from the glassy prison is a Human skull and a single skeletal arm."],"exits":[{"to":91,"exit":"south","move":"south"}],"color":"#00FF00"},
  {"id":93,"x":560,"y":300,"z":0,"title":"Maelshyve's Fortress, Hall of Malice","descriptions":["Deep blue velvet tapestries drape down from the vaulted ceiling, framing the wide obsidian hall that extends northward.  To the south, the hallway ends in a grand antechamber.","Deep blue velvet tapestries drape down from the vaulted ceiling, framing the  wide obsidian hall that extends northward.  A strange etching has been carved into the glassy southern wall."],"exits":[{"to":94,"exit":"north","move":"north"},{"to":82,"exit":"south","move":"south"},{"to":82,"exit":"none","move":"touch etching"}]},
  {"id":94,"x":560,"y":280,"z":0,"title":"Maelshyve's Fortress, Hall of Malice","descriptions":["The obsidian walls here are highly polished to a mirrored sheen, duskily reflecting whatever passes.  The hallway is broad, but the hanging velvet tapestries swallow the space within their shadowed folds, narrowing the passage to a sliver."],"exits":[{"to":95,"exit":"north","move":"north"},{"to":93,"exit":"south","move":"south"}]},
  {"id":95,"x":560,"y":260,"z":0,"title":"Maelshyve's Fortress, Hall of Malice","descriptions":["Veins of a red crystalline stone course through the obsidian ceiling, slathering a bloodshot sheen across the polished walls.  The velvet drapes cast long clawlike shadows across the smooth ebon floor."],"exits":[{"to":96,"exit":"north","move":"north"},{"to":94,"exit":"south","move":"south"}]},
  {"id":96,"x":560,"y":240,"z":0,"title":"Maelshyve's Fortress, Hall of Malice","descriptions":["Twin statues carved of a rich midnight blue crystal flank either side of the hallway.  Each bears the likeness of a Human woman disfigured with reptilian features -- claws, wings, and fangs.  Both faces are alluring, a siren's call beckoning the unwary.  The figure to the west stands proudly, her arm raised and her fanged lips curled into a battle roar.  The eastern figure is solemn, her claws clasped demurely before her, both shoulders slumped under the weight of two enormous outstretched wings."],"exits":[{"to":97,"exit":"north","move":"north"},{"to":95,"exit":"south","move":"south"}]},
  {"id":97,"x":560,"y":220,"z":0,"title":"Maelshyve's Fortress, Hall of Malice","descriptions":["The sleek walls crumble to the north, giving way to an open cavern that booms with the sound of rushing water.  Glistening in the darkness, an underground river flows to the east, threatening to sweep any who descend the jagged bank deep into the bowels of the cavern."],"exits":[{"to":96,"exit":"south","move":"south"},{"to":98,"exit":"climb","move":"climb jagged bank"}]},
  {"id":98,"x":560,"y":200,"z":0,"title":"Cavern, Underground River","descriptions":["Water crashes strongly against you, threatening to drag you with it on its eastward journey into unknown depths.  A jagged bank of rocky earth littered with crumbling obsidian shards ascends to the south, leading into a narrow hallway."],"exits":[{"to":99,"exit":"north","move":"swim north"},{"to":102,"exit":"northeast","move":"swim northeast"},{"to":101,"exit":"east","move":"swim east"},{"to":97,"exit":"climb","move":"climb jagged bank"}],"color":"#0000FF"},
  {"id":99,"x":560,"y":180,"z":0,"title":"Cavern, Underground River","descriptions":["Water crashes strongly against you, threatening to drag you with it on its eastward journey into unknown depths."],"exits":[{"to":100,"exit":"north","move":"swim north"},{"to":103,"exit":"northeast","move":"swim northeast"},{"to":102,"exit":"east","move":"swim east"},{"to":101,"exit":"southeast","move":"swim southeast"},{"to":98,"exit":"south","move":"swim south"}],"color":"#0000FF"},
  {"id":100,"x":560,"y":160,"z":0,"title":"Cavern, Underground River","descriptions":["Water crashes strongly against you, threatening to drag you with it on its eastward journey into unknown depths.  A jagged bank of rocky earth littered with crumbling obsidian shards ascends to the north, leading into a narrow hallway."],"exits":[{"to":103,"exit":"east","move":"swim east"},{"to":102,"exit":"southeast","move":"swim southeast"},{"to":99,"exit":"south","move":"swim south"},{"to":106,"exit":"climb","move":"climb jagged bank"}],"color":"#0000FF"},
  {"id":101,"x":580,"y":200,"z":0,"title":"Cavern, Underground River","descriptions":["The violent current crashes through the twisting caverns, snaking downward to the east."],"exits":[{"to":102,"exit":"north","move":"swim north"},{"to":104,"exit":"northeast","move":"swim northeast"},{"to":98,"exit":"west","move":"swim west"},{"to":99,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":102,"x":580,"y":180,"z":0,"title":"Cavern, Underground River","descriptions":["Water crashes strongly against you, threatening to drag you with it on its eastward journey into unknown depths."],"exits":[{"to":103,"exit":"north","move":"swim north"},{"to":104,"exit":"east","move":"swim east"},{"to":101,"exit":"south","move":"swim south"},{"to":98,"exit":"southwest","move":"swim southwest"},{"to":99,"exit":"west","move":"swim west"},{"to":100,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":103,"x":580,"y":160,"z":0,"title":"Cavern, Underground River","descriptions":["The violent current crashes through the twisting caverns, snaking downward to the east."],"exits":[{"to":104,"exit":"southeast","move":"swim southeast"},{"to":102,"exit":"south","move":"swim south"},{"to":99,"exit":"southwest","move":"swim southwest"},{"to":100,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":104,"x":600,"y":180,"z":0,"title":"Cavern, Underground River","descriptions":["The violent current crashes through the twisting caverns, snaking downward to the east."],"exits":[{"to":105,"exit":"east","move":"swim east"},{"to":101,"exit":"southwest","move":"swim southwest"},{"to":102,"exit":"west","move":"swim west"},{"to":103,"exit":"northwest","move":"swim northwest"}],"color":"#0000FF"},
  {"id":105,"x":660,"y":180,"z":0,"title":"Cavern, Underground River","descriptions":["The violent current crashes through the twisting caverns, snaking downward to the east.  A steep drop-off appears just up ahead, the waters cascading brutally into the roaring darkness below."],"exits":[{"to":0,"exit":"east","move":"east"},{"to":104,"exit":"west","move":"swim west"}],"color":"#0000FF"},
  {"id":106,"x":560,"y":140,"z":0,"title":"Maelshyve's Fortress, Hall of Malice","descriptions":["The sleek walls crumble to the south, giving way to an open cavern that booms with the sound of rushing water.  Glistening in the darkness, an underground river flows to the east, threatening to sweep any who descend the jagged bank deep into the bowels of the cavern."],"exits":[{"to":107,"exit":"north","move":"north"},{"to":100,"exit":"climb","move":"climb jagged bank"}]},
  {"id":107,"x":560,"y":120,"z":0,"title":"Maelshyve's Fortress, Hall of Malice","descriptions":["Claw-shaped sconces protruding seamlessly from the obsidian walls grasp feeble flames that faintly illuminate the hall.  A large circle has been outlined in the glassy floor, its borders etched in indecipherable runes."],"exits":[{"to":108,"exit":"north","move":"north"},{"to":106,"exit":"south","move":"south"}]},
  {"id":108,"x":560,"y":100,"z":0,"title":"Maelshyve's Fortress, Hall of Malice","descriptions":["Tapestries bearing the prominent image of a skyward-turned claw in blood red adorn the walls to either side, embroidered upon dark blue velvet.  Etched into the floor is a curiously placed circle of intricate runes.","Tapestries bearing the prominent image of a skyward-turned claw in blood red adorn the walls to either side, embroidered upon dark blue velvet.  Etched into the floor is a curiously placed circle of intricate runes."],"exits":[{"to":107,"exit":"south","move":"south"}],"color":"#00FF00"},
  {"id":109,"x":600,"y":100,"z":0,"title":"Maelshyve's Fortress, Inner Sanctum","descriptions":["A twisted onyx sculpture sits at the intersection of the two northern hallways, its claw-like shape grasping a polished silver bowl.  Above it, a tapestry hangs, bearing the likeness of a Human man dressed in priestly garb.  The bottom edges of the tapestry are stained a ruddy brown.","A twisted onyx sculpture sits at the intersection of the two northern hallways, its claw-like shape grasping a polished silver bowl.  Above it, a tapestry hangs, bearing the likeness of a Human man dressed in priestly garb.  The bottom edges of the tapestry are stained a ruddy brown.  You also see an etched circle of curious runes."],"exits":[{"to":110,"exit":"northeast","move":"northeast"},{"to":121,"exit":"south","move":"south"},{"to":115,"exit":"northwest","move":"northwest"}]},
  {"id":110,"x":620,"y":80,"z":0,"title":"Maelshyve's Fortress, Inner Sanctum","descriptions":["The empty hall's air is sour and musty, yet there is no trace of dust or cobweb.  The environment is eerily sterile, devoid of anything remotely natural or bearing a trace of life."],"exits":[{"to":111,"exit":"northeast","move":"northeast"},{"to":109,"exit":"southwest","move":"southwest"}]},
  {"id":111,"x":640,"y":60,"z":0,"title":"Maelshyve's Fortress, Inner Sanctum","descriptions":["A wave of mysterious silver liquid flows sluggishly like streaming teardrops from a crack in the ceiling, painting the eastern wall in its luminescence.  The liquid disappears into another crack in the ground, presumably to an unknown reservoir.  Strange shapes manifest in the mirrored liquid every so often, only to smooth out moments later.","A wave of mysterious silver liquid flows sluggishly like streaming teardrops from a crack in the ceiling, painting the eastern wall in its luminescence."],"exits":[{"to":110,"exit":"southwest","move":"southwest"},{"to":112,"exit":"northwest","move":"northwest"},{"to":123,"exit":"go","move":"go silver liquid"}]},
  {"id":112,"x":620,"y":40,"z":0,"title":"Maelshyve's Fortress, Inner Sanctum","descriptions":["The faint sound of rustling robes swishes through the hallway intermittently, coinciding with the flickering of feeble torchlight that emanates down the hall.  There seems to be no tangible source of the disturbance."],"exits":[{"to":111,"exit":"southeast","move":"southeast"},{"to":120,"exit":"northwest","move":"northwest"}]},
  {"id":113,"x":580,"y":40,"z":0,"title":"Maelshyve's Fortress, Inner Sanctum","descriptions":["A jagged gash wounds the wall here, seemingly collateral damage of a recent battle.  Tiny shards of obsidian are strewn about the smooth floor, glittering in the sparse light."],"exits":[{"to":120,"exit":"northeast","move":"northeast"},{"to":114,"exit":"southwest","move":"southwest"}]},
  {"id":114,"x":560,"y":60,"z":0,"title":"Maelshyve's Fortress, Inner Sanctum","descriptions":["Set against the eastern wall is a sturdy iron weapon rack adorned at each side with contorted kobold skulls.  Several violent implements grace it, freshly polished with the loving care of one who must relish their employment."],"exits":[{"to":113,"exit":"northeast","move":"northeast"},{"to":115,"exit":"southeast","move":"southeast"}],"color":"#00FF00","aliases":["Weapons","Spineripper","Mortal's Folly","Blight Fist"]},
  {"id":115,"x":580,"y":80,"z":0,"title":"Maelshyve's Fortress, Inner Sanctum","descriptions":["Intricate ornamentation is placed strategically throughout the austere halls, yet there is little comfort to be had.  The glassy obsidian walls reflect light harshly, and the cold floors of the same hard volcanic rock are slick and unforgiving to the hasty step."],"exits":[{"to":109,"exit":"southeast","move":"southeast"},{"to":114,"exit":"northwest","move":"northwest"}],"color":"#00FF00"},
  {"id":116,"x":640,"y":20,"z":0,"title":"Maelshyve's Fortress, Inner Sanctum","descriptions":["Grand ironwood bookcases line each wall of the hallway, the sturdy constructs tottering under the burden of what must be thousands of tomes.  Panes of glass locked shut and sealed with a strange platinum rune prevent closer perusal of what knowledge may be held here."],"exits":[{"to":120,"exit":"north","move":"north","hidden":true},{"to":117,"exit":"south","move":"south"}]},
  {"id":117,"x":640,"y":40,"z":0,"title":"Maelshyve's Fortress, Inner Sanctum","descriptions":["The long hall of ironwood bookcases ends at the base of a grand obsidian staircase that leads up to a raised platform shrouded in darkness."],"exits":[{"to":116,"exit":"north","move":"north"},{"to":118,"exit":"climb","move":"climb obsidian staircase"}]},
  {"id":118,"x":660,"y":40,"z":0,"title":"Maelshyve's Fortress, Great Dais","descriptions":["Hidden from the halls below, a great dais of obsidian rises like a silent specter that looms menacingly over all movements in the fortress.  Bordering the platform are totems of stacked skulls, each lit from within by a sickly flame, which dimly light the way towards a grand altar near its northern edge."],"exits":[{"to":119,"exit":"north","move":"north"},{"to":117,"exit":"climb","move":"climb obsidian staircase"}]},
  {"id":119,"x":660,"y":20,"z":0,"title":"Maelshyve's Fortress, Fallen Altar","descriptions":["The stacked skull totems form a ring around the edge of the great dais, their feeble collective glow struggling to fight the shadows encroaching upon this corrupt shrine.  A large altar of black marble stands prominently near the northern edge of the dais, its broad flat surface reflecting the sickly glow with a lustrous sheen.  Behind the altar a black marble statue stands, framing the altar with its massive wingspan."],"exits":[{"to":118,"exit":"south","move":"south"}],"color":"#A6A3D9","aliases":["Shrine2-05","Fallen Altar"]},
  {"id":120,"x":600,"y":20,"z":0,"title":"Maelshyve's Fortress, Glutton's Rest","descriptions":["A morbid shrine built of bones tied together with leathery straps of hide has been erected against the northern wall.  Prominently displayed impaled on a silver pike striking up from the center of the construct is a cracked kobold skull, the bones twisted into a violent scream of unnatural anguish.  A small silver plaque is affixed to the pike just below the terrible visage."],"exits":[{"to":112,"exit":"southeast","move":"southeast"},{"to":113,"exit":"southwest","move":"southwest"}],"color":"#00FF00","aliases":["Archrost"]},
  {"id":121,"x":600,"y":120,"z":0,"title":"Maelshyve's Fortress, Hall of Malice","descriptions":["Tapestries bearing the prominent image of a skyward-turned claw in blood red adorn the walls to either side, embroidered upon dark blue velvet.  Etched into the floor is a curiously placed circle of intricate runes."],"exits":[{"to":109,"exit":"north","move":"north"}]},
  {"id":122,"x":290,"y":190,"z":0,"title":"Kweld Gelvdael, Dark Tunnel","descriptions":["The tunnel comes to an abrupt halt as the western floor rises slowly up into the ceiling.  A giant stone scorpion sculpture adorns the cul-de-sac, its stinger poised as if to strike out at anything that dares draw near it.  Shadows dance and flicker over its surface as a lit torch set in a bronze wall sconce shines brightly, lending to the unease of the scene of the readied creature."],"exits":[{"to":0,"exit":"east","move":"east"},{"to":50,"exit":"go","move":"go amorphous spirits"}],"aliases":["Cleric Passage"],"linksTo":"Map31a_Zaulfung.xml"},
  {"id":123,"x":640,"y":80,"z":0,"title":"Soul of Maelshyve, The Involution","descriptions":["The path stretches to the northeast, hanging in space, extending from a wall of silver liquid.  Though the path is wide and solid, it flows like melted wax, and the sides end abruptly, with strange forms shifting in the endless distance.  A flickering image of Maelshyve's Fortress stretches and contracts in the sky, where the heights billow with the jagged drip-drip-drip of screaming sunbursts, accosting your senses with the incomprehensible.  The air seems to be made of murky smoke, stirred by a weak breeze and rhythmically congealing into vaguely familiar shapes.","The path stretches to the northeast, hanging in space, extending from a wall of silver liquid.  Flowing like melted wax, the sides of the path end abruptly, and strange forms shift in the endless distance.  High above, a flickering image of Maelshyve's Fortress hangs in the sky, where screaming sunbursts accost your senses.  The air is thick and murky, gently stirred by the breeze."],"exits":[{"to":0,"exit":"northeast","move":"northeast"},{"to":111,"exit":"go","move":"go silver liquid"}],"aliases":["Soul of Maelshyve","Involution"],"linksTo":"Map501_Soul_of_Maelshyve.xml"}
 ],
