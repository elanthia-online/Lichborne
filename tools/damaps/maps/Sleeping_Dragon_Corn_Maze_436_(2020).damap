 "name": "Sleeping Dragon Corn Maze 436 (2020)",
 "file": "Corn_Maze.xml",
 "rooms": [
  {"id":1,"x":-10,"y":40,"z":0,"title":"Sleeping Dragon Corn Maze, Entrance","descriptions":["The entrance to the corn maze sits on a small hill, surrounded by a two-plank wooden fence.  Songbirds regularly perch upon it, lending song to the air with their calls.  The ripening harvest stretches as far as the eye can see, a labrynthine path carved through it that resembles the shape of an enormous dragon curled up to rest.","The entrance to the corn maze sits on a small hill, surrounded by a two-plank wooden fence.  Songbirds regularly perch upon it, lending song to the air with their calls.  The ripening harvest stretches out into the darkness, a labrynthine path carved through it that quickly disappears into the night.","The entrance to the corn maze sits on a small hill, surrounded by a two-plank wooden fence."],"exits":[{"to":426,"exit":"go","move":"go wide trail","hidden":true},{"to":441,"exit":"go","move":"go meandering path"}],"color":"#FF00FF"},
  {"id":2,"x":10,"y":40,"z":0,"title":"Corn Maze, Entrance","descriptions":["Tall stalks of ripe corn tower high on either side of the thoroughfare that winds through the field, forming a thick, dense maze.  The leaves and branches bend inward and almost meet overhead, giving the maze an almost claustrophobic feel.  Dry, almost dusty dirt lies bare in neat, even spaces between the ripening rows, which have changed from a green to a nearly golden color.","Tall stalks of corn tower high on either side of the thoroughfare, forming a thick, dense maze.","The silhouettes of tall stalks of ripe corn tower high on either side of the thoroughfare that winds through the field, forming a thick, dense maze.  The leaves and branches bend inward and almost meet overhead, nearly blotting out the night sky.  Dry, almost dusty dirt lies bare in neat, even spaces between the ripening rows, which form a thick wall in the nighttime darkness.","The silhouettes of tall stalks of corn tower high on either side of the thoroughfare, forming a thick, dense maze."],"exits":[{"to":3,"exit":"east","move":"east"}],"aliases":["Entrance"]},
  {"id":3,"x":30,"y":40,"z":0,"title":"Corn Maze, Labyrinth","descriptions":["Tall stalks of ripe corn tower high on either side of the thoroughfare that winds through the field, forming a thick, dense maze.  The leaves and branches bend inward and almost meet overhead, giving the maze an almost claustrophobic feel.  Dry, almost dusty dirt lies bare in neat, even spaces between the ripening rows, which have changed from a green to a nearly golden color.","Tall stalks of corn tower high on either side of the thoroughfare, forming a thick, dense maze.","The silhouettes of tall stalks of ripe corn tower high on either side of the thoroughfare that winds through the field, forming a thick, dense maze.  The leaves and branches bend inward and almost meet overhead, nearly blotting out the night sky.  Dry, almost dusty dirt lies bare in neat, even spaces between the ripening rows, which form a thick wall in the nighttime darkness.","The silhouettes of tall stalks of corn tower high on either side of the thoroughfare, forming a thick, dense maze."],"exits":[{"to":4,"exit":"east","move":"east"},{"to":2,"exit":"west","move":"west"}],"aliases":["Labyrinth","cheerful Halfling"]},
