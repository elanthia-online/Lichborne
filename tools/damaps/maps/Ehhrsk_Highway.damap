  {"id":50,"x":300,"y":60,"z":0,"title":"The Sewers, Beneath the Grating","descriptions":["A faint light from the grating above shows this small, tile-lined room, hardly more than a wide connection in the system of pipes that regulates the flow of water that cleanses and refreshes Ratha.  A big bronze valve is the only noteworthy feature in the place."],"exits":[],"color":"#FFFFFF","linksTo":"Map90b_Ratha_Sewers.xml"},
  {"id":51,"x":140,"y":160,"z":0,"title":"The Sewers, Beneath the Drain","descriptions":["Beneath the drain is a small, tile-lined room, part of the main sewer and water supply system, from the look of the big bronze valve that takes up most of one wall of the room."],"exits":[],"color":"#FFFFFF","linksTo":"Map90b_Ratha_Sewers.xml"}
 ],
 "labels": [
  {"text":"Kra'hei","x":210,"y":100,"z":0}
 ]
}
