  {"text":"Manor House","x":60,"y":390,"z":0},
  {"text":"West Gate Hunting Area","x":180,"y":0,"z":0},
  {"text":"Segoltha River","x":100,"y":320,"z":0},
  {"text":"Weapons","x":168,"y":60,"z":0},
  {"text":"Leather Dyer","x":262,"y":140,"z":0},
  {"text":"Peddler's Wagon","x":233,"y":191,"z":0},
  {"text":"Herbs","x":143,"y":180,"z":0}
 ]
}
